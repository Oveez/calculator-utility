# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# CORS Allowed Origins (JSON array of strings)
ALLOWED_ORIGINS=["https://toolcastle.app","https://www.toolcastle.app","http://localhost:4321"]

# Security & Shared Secret (Required if REQUIRE_API_KEY is true)
REQUIRE_API_KEY=false
API_SECRET_KEY=replace_with_strong_random_secret_in_production

# Rate Limiting (SlowAPI)
RATE_LIMIT_PER_MINUTE=60

# Engine Configuration
DEFAULT_TAX_YEAR=2026
MAX_HOUSEHOLD_MEMBERS=10

