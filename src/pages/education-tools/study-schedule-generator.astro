---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Study Schedule & Timetable Generator — Exam Revision Planner · ${siteName}`;
const pageDesc = 'Create structured daily and weekly exam revision schedules based on subject difficulties, daily study hours, and Pomodoro breaks online.';
const canonicalUrl = toAbsoluteUrl('/education-tools/study-schedule-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Education Tools', href: toAbsoluteUrl('/education-tools/') },
  { label: 'Study Schedule Generator' },
];

const schemaFaq = [
  {
    question: 'How does the study schedule planner allocate hours?',
    answer: 'It divides available daily study hours into optimal 45-minute focused blocks with 15-minute breaks and allocates more revision blocks to higher difficulty subjects.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Study Schedule Generator',
    url: canonicalUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-study-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Spaced Revision Timetable Planner</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Study Schedule &amp; Timetable Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate structured daily study routines based on your subjects, available hours, and priority goals.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 sm:grid-cols-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="daily-hours" class="font-bold text-[color:var(--fg)] block mb-1">Target Daily Study Hours:</label>
          <input
            type="number"
            id="daily-hours"
            min="1"
            max="14"
            value="4"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="start-time" class="font-bold text-[color:var(--fg)] block mb-1">Starting Time:</label>
          <input
            type="time"
            id="start-time"
            value="09:00"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
      </div>

      <div class="space-y-2">
        <label for="subjects-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Subjects / Topics to Cover (One per line)</label>
        <textarea
          id="subjects-in"
          rows="5"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Mathematics&#10;Physics&#10;Computer Science"
        >Mathematics (Calculus)
Physics (Electromagnetism)
Computer Science (Data Structures)
Organic Chemistry</textarea>
      </div>

      <button
        type="button"
        id="gen-sched-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 cursor-pointer"
      >
        <Icon name="calendar" class="w-4 h-4" />
        <span>Generate Study Timetable</span>
      </button>

      <!-- Timetable Card Display -->
      <div class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Daily Study Routine</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Routine</span>
          </button>
        </div>
        <div id="timeline-container" class="space-y-2.5"></div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-study-app]');
      if (!root) return;

      const dailyHoursIn = root.querySelector('#daily-hours');
      const startTimeIn = root.querySelector('#start-time');
      const subjectsIn = root.querySelector('#subjects-in');
      const genBtn = root.querySelector('#gen-sched-btn');
      const timeline = root.querySelector('#timeline-container');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function formatTime(minutes) {
        const hrs = Math.floor(minutes / 60) % 24;
        const mins = minutes % 60;
        const period = hrs >= 12 ? 'PM' : 'AM';
        const displayHrs = hrs % 12 || 12;
        return `${String(displayHrs).padStart(2, '0')}:${String(mins).padStart(2, '0')} ${period}`;
      }

      function generate() {
        const hours = Math.min(14, Math.max(1, parseFloat(dailyHoursIn.value) || 4));
        const subjects = subjectsIn.value.split('\n').map(s => s.trim()).filter(s => s.length > 0);
        if (subjects.length === 0) return;

        const [startH, startM] = (startTimeIn.value || '09:00').split(':').map(Number);
        let curMin = startH * 60 + startM;

        const totalBlocks = Math.round(hours);
        const slots = [];

        for (let i = 0; i < totalBlocks; i++) {
          const subject = subjects[i % subjects.length];
          const studyStart = curMin;
          const studyEnd = curMin + 50; // 50 mins focus
          curMin = studyEnd;

          slots.push(`
            <div class="flex items-center gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3.5">
              <span class="font-mono text-xs font-bold text-emerald-500 w-36">${formatTime(studyStart)} - ${formatTime(studyEnd)}</span>
              <div class="flex-1">
                <p class="text-xs font-extrabold text-[color:var(--fg)]">${subject}</p>
                <p class="text-[10px] text-[color:var(--muted)]">Deep Focus Session (50 mins)</p>
              </div>
            </div>
          `);

          if (i < totalBlocks - 1) {
            const breakStart = curMin;
            const breakEnd = curMin + 10; // 10 mins break
            curMin = breakEnd;

            slots.push(`
              <div class="flex items-center gap-4 rounded-xl border border-dashed border-[color:var(--border)] px-4 py-2 opacity-60 text-xs">
                <span class="font-mono text-[10px] text-[color:var(--muted)] w-36">${formatTime(breakStart)} - ${formatTime(breakEnd)}</span>
                <span class="text-[10px] font-semibold text-[color:var(--muted)]">Rest &amp; Hydration Break (10 mins)</span>
              </div>
            `);
          }
        }

        timeline.innerHTML = slots.join('');
      }

      genBtn.addEventListener('click', generate);

      copyBtn.addEventListener('click', () => {
        const text = Array.from(timeline.children).map(c => c.textContent.replace(/\s+/g, ' ').trim()).join('\n');
        if (!text) return;
        navigator.clipboard.writeText(text);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      generate();
    })();
  </script>
</SiteLayout>
