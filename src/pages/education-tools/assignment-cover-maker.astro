          }

          if (stuY < botBoxY) {
            botBoxY = stuY - 5;
          }

          page.drawLine({ start: { x: boxLeft, y: topBoxY }, end: { x: boxRight, y: topBoxY }, thickness: 0.5, color: colBorder });
          page.drawLine({ start: { x: boxLeft, y: botBoxY }, end: { x: boxRight, y: botBoxY }, thickness: 0.5, color: colBorder });
          page.drawLine({ start: { x: midDividerX, y: topBoxY - 5 }, end: { x: midDividerX, y: botBoxY + 5 }, thickness: 0.5, color: colBorder });

          const footerY = Math.min(70, botBoxY - 35);
          const footerText = termText ? `${s.date || ''}   •   ${termText}` : (s.date || '');
          drawCenteredText(page, fontSerif, footerText, footerY, 9, colMuted);

        } else if (template === 'bold') {
          // 5. BOLD ACADEMIC BANNER TEMPLATE
