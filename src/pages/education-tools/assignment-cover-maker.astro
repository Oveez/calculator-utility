            if (st.section) {
              page.drawText(st.section, { x: 55, y: prepY, size: 9, font: fontSans, color: colMuted });
              prepY -= 13;
            }
            prepY -= 4;
          }

          const supX = W / 2 + 25;
          let supY = botLineY - 22;
          page.drawText('SUPERVISED BY', { x: supX, y: supY, size: 9, font: fontSansBold, color: colPrimary });
          supY -= 18;
          page.drawText(teacherNameText, { x: supX, y: supY, size: 11, font: fontSansBold, color: colDark });
          supY -= 14;
          page.drawText(teacherTitleText, { x: supX, y: supY, size: 9.5, font: fontSans, color: colMuted });
          supY -= 13;
          if (deptText) {
            page.drawText(deptText, { x: supX, y: supY, size: 9, font: fontSans, color: colMuted });
          }

          page.drawLine({ start: { x: 55, y: 70 }, end: { x: W - 55, y: 70 }, thickness: 0.5, color: colBorder });
          page.drawText(s.date || '', { x: 55, y: 55, size: 9, font: fontSans, color: colMuted });
          if (termText) {
            drawRightText(page, fontSans, termText, W - 55, 55, 9, colMuted);
          }

        } else if (template === 'professional') {
          // 3. PROFESSIONAL CARD GRID TEMPLATE
          page.drawRectangle({
            x: 50,
            y: H - 125,
            width: W - 100,
            height: 75,
