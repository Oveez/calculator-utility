          page.drawText(instText, { x: 70, y: H - 82, size: 13, font: fontSansBold, color: colPrimary });
          page.drawText(deptText, { x: 70, y: H - 102, size: 10, font: fontSans, color: colMuted });

          if (embeddedLogo) {
            const maxLogoW = 90;
            const maxLogoH = 50;
