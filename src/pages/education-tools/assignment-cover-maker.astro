          page.drawRectangle({ x: 0, y: H - bannerH, width: W, height: bannerH, color: colPrimary });

          page.drawText('OFFICIAL ACADEMIC SUBMISSION', { x: 50, y: H - 35, size: 8, font: fontSansBold, color: PDFLib.rgb(0.8, 0.85, 0.95) });
          page.drawText(instText, { x: 50, y: H - 56, size: 16, font: fontSansBold, color: colWhite });
          page.drawText(deptText, { x: 50, y: H - 74, size: 10, font: fontSans, color: PDFLib.rgb(0.9, 0.92, 0.96) });

          if (embeddedLogo) {
            const logoBoxW = 75;
            const logoBoxH = 65;
            page.drawRectangle({ x: W - 50 - logoBoxW, y: H - bannerH + 15, width: logoBoxW, height: logoBoxH, color: colWhite });
            const aspect = embeddedLogo.width / embeddedLogo.height;
            let logoW = logoBoxW - 16;
            let logoH = (logoBoxW - 16) / aspect;
            if (logoH > logoBoxH - 16) {
              logoH = logoBoxH - 16;
              logoW = (logoBoxH - 16) * aspect;
            }
            page.drawImage(embeddedLogo, {
              x: W - 50 - logoBoxW + (logoBoxW - logoW) / 2,
