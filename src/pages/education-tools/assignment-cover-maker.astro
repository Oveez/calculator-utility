      // ==========================================
      // INSTITUTION SEARCH & AUTOCOMPLETE
      // ==========================================
      async function fetchInstitutionsDb() {
        if (institutionsDb || isFetchingDb) return;
        isFetchingDb = true;
        try {
          const res = await fetch('/data/institutions.json?v=' + LOGO_VERSION);
          institutionsDb = await res.json();
        } catch (err) {
          console.error('Failed to load institutions DB', err);
        }
      }

      instInput.addEventListener('focus', fetchInstitutionsDb);

      function updateLogoStatusText(overrideText, overrideColor) {
        if (!logoStatusIndicator || !logoStatusText) return;
        const dot = logoStatusIndicator.querySelector('span:first-child');
        if (!dot) return;

        if (overrideText) {
          logoStatusText.textContent = overrideText;
          dot.className = `w-2 h-2 rounded-full ${overrideColor === 'emerald' ? 'bg-emerald-500' : overrideColor === 'slate' ? 'bg-slate-400' : 'bg-amber-400'}`;
          return;
        }

        if (state.logoMode === 'none') {
          dot.className = 'w-2 h-2 rounded-full bg-slate-400';
          logoStatusText.textContent = 'No logo will appear on the cover';
        } else if (state.logoMode === 'emblem') {
          dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
          logoStatusText.textContent = 'Default academic crest emblem active';
        } else if (state.logoMode === 'custom') {
          if (state.customLogoBase64) {
            dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
            logoStatusText.textContent = 'Custom logo active';
          } else {
            dot.className = 'w-2 h-2 rounded-full bg-amber-400';
            logoStatusText.textContent = 'No file chosen yet (using default emblem)';
          }
        } else {
          // 'stored'
          if (state.logoBase64 || state.logoUrl) {
            dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
            logoStatusText.textContent = `Official seal loaded (${state.activeStoredName || state.institution})`;
          } else {
            dot.className = 'w-2 h-2 rounded-full bg-amber-400';
            logoStatusText.textContent = state.institution ? 'University logo not found in database; using default emblem' : 'Default academic crest emblem active';
          }
        }
      }

      function syncLogoModeButtons() {
        document.querySelectorAll('#logo-mode-selector .logo-mode-btn').forEach(btn => {
          const mode = btn.getAttribute('data-logo-mode');
          const icon = btn.querySelector('svg');
          if (mode === state.logoMode) {
            btn.classList.remove('border-[color:var(--border-strong)]', 'bg-[color:var(--surface)]');
            btn.classList.add('border-2', 'border-[color:var(--accent)]', 'bg-[color:var(--surface-strong)]');
            if (icon) {
              icon.classList.remove('text-[color:var(--muted)]');
              icon.classList.add('text-[color:var(--accent)]');
            }
          } else {
            btn.classList.remove('border-2', 'border-[color:var(--accent)]', 'bg-[color:var(--surface-strong)]');
            btn.classList.add('border-[color:var(--border-strong)]', 'bg-[color:var(--surface)]');
            if (icon) {
              icon.classList.remove('text-[color:var(--accent)]');
              icon.classList.add('text-[color:var(--muted)]');
            }
          }
        });

        if (customLogoPrompt) {
          if (state.logoMode === 'custom') {
            customLogoPrompt.classList.remove('hidden');
          } else {
            customLogoPrompt.classList.add('hidden');
          }
        }

        updateLogoStatusText();
      }

      // Logo Mode Selector Click Listeners
      document.querySelectorAll('#logo-mode-selector .logo-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-logo-mode');
          state.logoMode = mode;
          syncLogoModeButtons();
          if (mode === 'custom' && !state.customLogoBase64) {
            customLogoInput.click();
          }
          renderPreview();
        });
      });

      // Custom Logo File Upload Listener
      customLogoInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (evt) => {
          state.customLogoBase64 = evt.target.result;
          state.logoMode = 'custom';
          if (customLogoFilename) {
            customLogoFilename.textContent = `Selected: ${file.name.slice(0, 24)}`;
          }
          syncLogoModeButtons();
          renderPreview();
        };
        reader.readAsDataURL(file);
      });

      // ==========================================
      // INSTITUTION SEARCH & AUTOCOMPLETE
      // ==========================================
      async function fetchInstitutionsDb() {
        if (institutionsDb || isFetchingDb) return;
        isFetchingDb = true;
        try {
          const res = await fetch('/data/institutions.json?v=' + LOGO_VERSION);
          institutionsDb = await res.json();
        } catch (err) {
          console.error('Failed to load institutions DB', err);
        }
      }

      instInput.addEventListener('focus', fetchInstitutionsDb);

      instInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        instResults.innerHTML = '';

        if (query.length > 0) {
          btnClearInst.classList.remove('hidden');
        } else {
          btnClearInst.classList.add('hidden');
        }

        state.institution = e.target.value;

        // CRITICAL BUG FIX: If user edits or types a university name that does NOT match
        // the currently active stored university, immediately invalidate the old logo!
        if (state.slug || state.logoUrl || state.logoBase64) {
          const activeName = (state.activeStoredName || '').toLowerCase().trim();
          if (query !== activeName) {
            state.slug = '';
            state.logoUrl = '';
            state.logoBase64 = null;
            state.activeStoredName = '';
            updateLogoStatusText();
          }
        }

        if (!institutionsDb || query.length < 2) {
          instResults.classList.add('hidden');
          renderPreview();
          return;
        }

        // Smart search matches with exact acronym and prefix priority
        const matches = institutionsDb.filter(item => {
          const name = item[0].toLowerCase();
          const slug = item[1] ? item[1].toLowerCase() : '';
          const acros = item[3] ? item[3].toLowerCase().split(/\s+/) : [];
          return name.includes(query) || slug.includes(query) || acros.some(a => a === query || a.startsWith(query));
        }).sort((a, b) => {
          const aExactAcro = a[3] && a[3].toLowerCase().split(/\s+/).includes(query);
          const bExactAcro = b[3] && b[3].toLowerCase().split(/\s+/).includes(query);
          if (aExactAcro && !bExactAcro) return -1;
          if (!aExactAcro && bExactAcro) return 1;
          if (aExactAcro && bExactAcro) {
            if ((b[4] || 0) !== (a[4] || 0)) return (b[4] || 0) - (a[4] || 0);
            if (a[2] === 'BD' && b[2] !== 'BD') return -1;
            if (a[2] !== 'BD' && b[2] === 'BD') return 1;
          }

          const aStarts = a[0].toLowerCase().startsWith(query);
          const bStarts = b[0].toLowerCase().startsWith(query);
          if (aStarts && !bStarts) return -1;
          if (!aStarts && bStarts) return 1;

          if ((b[4] || 0) !== (a[4] || 0)) return (b[4] || 0) - (a[4] || 0);

          const aIsBd = a[2] === 'BD';
          const bIsBd = b[2] === 'BD';
          if (aIsBd && !bIsBd) return -1;
          if (!aIsBd && bIsBd) return 1;

          return a[0].localeCompare(b[0]);
        }).slice(0, 14);

        if (matches.length > 0) {
          matches.forEach(match => {
            const [name, slug, country, acronym, hasLogo] = match;
            const primaryAcro = acronym ? acronym.split(' ')[0] : null;
            const li = document.createElement('li');
            li.className = 'px-4 py-2.5 hover:bg-[color:var(--surface-active)] cursor-pointer text-xs text-[color:var(--fg)] flex justify-between items-center transition border-b border-[color:var(--border)] last:border-none';
            li.innerHTML = `
              <div class="flex items-center gap-2 overflow-hidden">
                ${primaryAcro ? `<span class="text-[10px] font-bold font-mono px-1.5 py-0.5 rounded bg-[color:var(--accent-soft)] text-[color:var(--accent)] dark:text-blue-300 border border-[color:var(--accent)]/30 shrink-0">${escapeHtml(primaryAcro)}</span>` : ''}
                <span class="font-medium truncate">${escapeHtml(name)}</span>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                ${hasLogo === 1 ? `<span class="inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"><svg class="w-3 h-3 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Logo</span>` : ''}
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[color:var(--surface-strong)] text-[color:var(--fg)]/80 border border-[color:var(--border-strong)]">${escapeHtml(country || 'GL')}</span>
              </div>
            `;

            li.addEventListener('click', async () => {
              instInput.value = name;
              state.institution = name;
              state.activeStoredName = name;
              state.slug = slug;
              state.logoMode = 'stored';
              syncLogoModeButtons();

              if (hasLogo === 1) {
                state.logoBase64 = null;
                state.logoUrl = `${CDN_URL}/${slug}.webp?v=${LOGO_VERSION}`;
                updateLogoStatusText(`Official seal loaded (${name})`, 'emerald');
                renderPreview();

                const b64 = await cacheLogoAsBase64(state.logoUrl);
                if (b64 && state.slug === slug && state.logoMode === 'stored') {
                  state.logoBase64 = b64;
                  renderPreview();
                }
              } else {
                state.logoUrl = '';
                state.logoBase64 = null;
                updateLogoStatusText(`University logo not found in database; using default emblem`, 'amber');
                renderPreview();
              }

              instResults.classList.add('hidden');
            });

            instResults.appendChild(li);
          });
          instResults.classList.remove('hidden');
        } else {
          instResults.classList.add('hidden');
        }

        renderPreview();
      });

      btnClearInst.addEventListener('click', () => {
        instInput.value = '';
        state.institution = '';
        state.activeStoredName = '';
        state.slug = '';
        state.logoUrl = '';
        state.logoBase64 = null;
        btnClearInst.classList.add('hidden');
        instResults.classList.add('hidden');
        updateLogoStatusText();
        renderPreview();
      });

      // Close dropdown on outside click
      document.addEventListener('click', (e) => {
        if (!instInput.contains(e.target) && !instResults.contains(e.target)) {
          instResults.classList.add('hidden');
        }
      });

      // Other Form Field Listeners
      deptInput.addEventListener('input', (e) => { state.department = e.target.value; renderPreview(); });
      titleInput.addEventListener('input', (e) => { state.title = e.target.value; renderPreview(); });
      subtitleInput.addEventListener('input', (e) => { state.subtitle = e.target.value; renderPreview(); });
      courseNameInput.addEventListener('input', (e) => { state.courseName = e.target.value; renderPreview(); });
      courseCodeInput.addEventListener('input', (e) => { state.courseCode = e.target.value; renderPreview(); });
      teacherNameInput.addEventListener('input', (e) => { state.teacherName = e.target.value; renderPreview(); });
      teacherTitleInput.addEventListener('input', (e) => { state.teacherTitle = e.target.value; renderPreview(); });
      dateInput.addEventListener('input', (e) => { state.date = e.target.value; renderPreview(); });
      termInput.addEventListener('input', (e) => { state.term = e.target.value; renderPreview(); });

      // Auto-convert fields to Academic Title Case on blur
      const academicTitleCaseInputs = [
        { el: titleInput, key: 'title' },
        { el: subtitleInput, key: 'subtitle' },
        { el: courseNameInput, key: 'courseName' },
        { el: deptInput, key: 'department' },
        { el: teacherNameInput, key: 'teacherName' },
        { el: teacherTitleInput, key: 'teacherTitle' },
        { el: termInput, key: 'term' },
        { el: instInput, key: 'institution' }
      ];

      academicTitleCaseInputs.forEach(({ el, key }) => {
        if (!el) return;
        el.addEventListener('blur', () => {
          if (el.value && el.value.trim()) {
            const formatted = toAcademicTitleCase(el.value.trim());
            el.value = formatted;
            state[key] = formatted;
            renderPreview();
          }
        });
      });

      document.getElementById('btn-today-date').addEventListener('click', () => {
        state.date = formatDate(new Date());
        dateInput.value = state.date;
        renderPreview();
      });

      // Add Student Button
      btnAddStudent.addEventListener('click', () => {
        if (state.students.length >= 6) {
          alert('Maximum 6 students supported for assignment cover.');
          return;
        }
        state.students.push({ name: '', id: '', section: '' });
        renderStudentsInput();
        renderPreview();
      });

      // Use Sample Data Button (University of Dhaka Demo)
      if (btnSampleData) {
        btnSampleData.addEventListener('click', async () => {
          state.institution = 'University of Dhaka';
          state.activeStoredName = 'University of Dhaka';
          state.slug = 'university-of-dhaka';
          state.logoMode = 'stored';
          state.logoUrl = `${CDN_URL}/university-of-dhaka.webp?v=${LOGO_VERSION}`;
          state.logoBase64 = null;
          state.department = 'Department of Management Information Systems';
          state.title = 'Supply Chain Management & Enterprise Logistics';
          state.subtitle = 'A Strategic Analysis of Global Operations';
          state.courseName = 'Management Information Systems';
          state.courseCode = 'MIS 301';
          state.teacherName = 'Dr. Rahman';
          state.teacherTitle = 'Professor & Chairman';
          state.date = formatDate(new Date());
          state.term = 'Fall Semester 2026';
          state.students = [
            { name: 'Tanvir Islam', id: '2022515229', section: 'Section A' }
          ];

          syncStateToInputs();
          syncLogoModeButtons();
          renderPreview();

          const b64 = await cacheLogoAsBase64(state.logoUrl);
          if (b64 && state.slug === 'university-of-dhaka' && state.logoMode === 'stored') {
            state.logoBase64 = b64;
            renderPreview();
          }
        });
      }

      // Reset Button (Returns to Clean Blank State)
      document.getElementById('btn-reset-form').addEventListener('click', () => {
        if (!confirm('Clear all form fields?')) return;
        try {
          localStorage.removeItem(STORAGE_KEY);
        } catch (e) {}
        state.template = 'classic';
        state.theme = 'classic';
        state.institution = '';
        state.activeStoredName = '';
        state.slug = '';
        state.logoUrl = '';
        state.logoBase64 = null;
        state.customLogoBase64 = null;
        state.logoMode = 'stored';
        state.department = '';
        state.title = '';
        state.subtitle = '';
        state.courseName = '';
        state.courseCode = '';
        state.teacherName = '';
        state.teacherTitle = '';
        state.date = '';
        state.term = '';
        state.students = [{ name: '', id: '', section: '' }];
        if (customLogoFilename) customLogoFilename.textContent = '';
        if (customLogoInput) customLogoInput.value = '';
        syncStateToInputs();
        syncLogoModeButtons();
        syncTemplateAndThemeButtons();
        renderPreview();
      });

      // Direct Print Button
      document.getElementById('btn-print-cover').addEventListener('click', () => {
        window.print();
      });

      // Quick Download Button (in header bar)
      const btnQuickDownload = document.getElementById('btn-quick-download');
      if (btnQuickDownload) {
        btnQuickDownload.addEventListener('click', () => {
          document.getElementById('generate-pdf-btn').click();
        });
      }

      // ==========================================
      // VECTOR PDF COMPILER & EXPORT ENGINE
      // Real Selectable Text & Zoom Sharpness
      // ==========================================
      const genPdfBtn = document.getElementById('generate-pdf-btn');
      const btnPdfText = document.getElementById('btn-pdf-text');

      async function compileVectorCoverPdf() {
        const PDFLib = await getPDFLib();
        const activeTheme = THEMES[state.theme] || THEMES.classic;
        let logoPngBytes = null;

        if (state.logoMode === 'none') {
          logoPngBytes = null;
        } else if (state.logoMode === 'emblem') {
          const svgDataUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(getEmblemSvg(activeTheme.primary));
          logoPngBytes = await getLogoPngBytes(svgDataUrl);
        } else if (state.logoMode === 'custom') {
          if (state.customLogoBase64) {
            logoPngBytes = await getLogoPngBytes(state.customLogoBase64);
          } else {
            const svgDataUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(getEmblemSvg(activeTheme.primary));
            logoPngBytes = await getLogoPngBytes(svgDataUrl);
          }
        } else {
          // 'stored' mode
          const effectiveSrc = state.logoBase64 || state.logoUrl;
          if (effectiveSrc) {
            logoPngBytes = await getLogoPngBytes(effectiveSrc);
          }
          if (!logoPngBytes) {
            const svgDataUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(getEmblemSvg(activeTheme.primary));
            logoPngBytes = await getLogoPngBytes(svgDataUrl);
          }
        }

        return await renderVectorCoverPdf(PDFLib, state, activeTheme, logoPngBytes);
      }

      genPdfBtn.addEventListener('click', async () => {
        const originalText = btnPdfText.textContent;
        btnPdfText.textContent = 'Generating Crisp Vector PDF...';
        genPdfBtn.style.opacity = '0.75';
        genPdfBtn.disabled = true;

        try {
          const pdfBytes = await compileVectorCoverPdf();
          const blob = new Blob([pdfBytes], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);
          const safeFilename = `${(toAcademicTitleCase(state.title) || 'Assignment_Cover').slice(0, 32).replace(/[^a-zA-Z0-9_-]/g, '_')}_Cover.pdf`;

          const a = document.createElement('a');
          a.href = url;
          a.download = safeFilename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error('PDF generation error:', err);
          alert('Could not generate PDF: ' + (err.message || 'Unknown error') + '\n\nYou can also click the "Print" button in the top bar to print or save as PDF.');
        } finally {
          btnPdfText.textContent = originalText;
          genPdfBtn.style.opacity = '1';
          genPdfBtn.disabled = false;
        }
      });

      // Merge with Assignment Handler (preloads cover into PDF Merger)
      function resetMergeButton() {
        if (btnMergeAssignment && btnMergeText) {
          btnMergeText.textContent = 'Merge with Assignment';
          btnMergeText.style.color = '#ffffff';
          btnMergeAssignment.style.color = '#ffffff';
          btnMergeAssignment.style.opacity = '1';
          btnMergeAssignment.disabled = false;
        }
      }

      // Reset merge button when navigating back via browser back button (bfcache restoration)
      window.addEventListener('pageshow', () => {
        resetMergeButton();
      });

      if (btnMergeAssignment) {
        btnMergeAssignment.addEventListener('click', async () => {
          btnMergeText.textContent = 'Preparing Cover...';
          btnMergeText.style.color = '#ffffff';
          btnMergeAssignment.style.color = '#ffffff';
          btnMergeAssignment.style.opacity = '0.9';
          btnMergeAssignment.disabled = true;

          try {
            const pdfBytes = await compileVectorCoverPdf();
            const safeFilename = `${(toAcademicTitleCase(state.title) || 'Assignment_Cover').slice(0, 32).replace(/[^a-zA-Z0-9_-]/g, '_')}_Cover.pdf`;

            let binary = '';
            const len = pdfBytes.byteLength;
            for (let i = 0; i < len; i++) {
              binary += String.fromCharCode(pdfBytes[i]);
            }
            const base64Data = btoa(binary);

            sessionStorage.setItem('pending_merge_cover', JSON.stringify({
              name: safeFilename,
              data: base64Data
            }));

            setTimeout(() => {
              resetMergeButton();
            }, 400);

            window.location.href = '/pdf-tools/pdf-merger/';
          } catch (err) {
            console.error('Merge preparation error:', err);
            alert('Could not prepare cover for PDF merger: ' + (err.message || 'Unknown error'));
            resetMergeButton();
          }
        });
      }

      // Initial Viewport & Preview Mount
      loadStateFromStorage();
      syncStateToInputs();
      syncLogoModeButtons();
      syncTemplateAndThemeButtons();
      renderPreview();
      updateViewportScale();

      // Flush latest state before page refresh
      window.addEventListener('beforeunload', () => {
        saveStateToStorage();
      });
    })();
  </script>
</SiteLayout>
