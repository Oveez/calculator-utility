            page.drawImage(embeddedLogo, { x: (W - logoW) / 2, y: curY - logoH, width: logoW, height: logoH });
            curY -= (logoH + 20);
          } else {
            curY -= 15;
          }

          curY = drawCenteredText(page, fontSerifBold, instText, curY, 17, colPrimary, 440);
          curY -= 4;
          curY = drawCenteredText(page, fontSerifItalic, deptText, curY, 11, colSecondary, 400);

          drawCenteredText(page, fontSerif, '+   *   +', 490, 14, colBorder);
          let titleY = drawCenteredText(page, fontSerifBold, titleText, 450, 24, colDark, 420);
          if (subtitleText) {
            titleY -= 4;
            titleY = drawCenteredText(page, fontSerifItalic, subtitleText, titleY, 11, colMuted, 380);
          }

          drawCenteredText(page, fontSerif, 'In Fulfillment of the Course', titleY - 25, 9.5, colMuted);
          const fullCourse = courseCodeText ? `${courseCodeText} — ${courseNameText}` : courseNameText;
          drawCenteredText(page, fontSerifBold, fullCourse, titleY - 42, 13, colPrimary);

          const boxLeft = 110;
          const boxRight = W - 110;
          const midDividerX = W / 2;
          const leftColCenter = (boxLeft + midDividerX) / 2;
          const rightColCenter = (midDividerX + boxRight) / 2;

          const topBoxY = 210;
          let botBoxY = 115;

          // Left Column: SUBMITTED TO (Instructor)
          drawCenteredTextAt(page, fontSerifBold, 'SUBMITTED TO', leftColCenter, topBoxY - 15, 8.5, colSecondary, 150);
          let insY = drawCenteredTextAt(page, fontSerifBold, teacherNameText, leftColCenter, topBoxY - 35, 11, colDark, 150);
          drawCenteredTextAt(page, fontSerif, teacherTitleText, leftColCenter, insY - 4, 9.5, colMuted, 150);

          // Right Column: SUBMITTED BY (Student / Team)
          drawCenteredTextAt(page, fontSerifBold, 'SUBMITTED BY', rightColCenter, topBoxY - 15, 8.5, colSecondary, 150);
          let stuY = topBoxY - 35;
          const numStudents = Math.min(s.students.length, 4);
