          drawCenteredText(page, fontSansBold, 'ASSIGNMENT REPORT', midBoxY + 32, 9, colSecondary);

          let titleY = drawCenteredText(page, fontSerifBold, titleText, midBoxY + 12, 22, colDark, 420);
          if (subtitleText) {
            titleY -= 4;
            titleY = drawCenteredText(page, fontSerifItalic, subtitleText, titleY, 11, colMuted, 400);
          }

          page.drawLine({ start: { x: 75, y: midBoxY - 55 }, end: { x: W - 75, y: midBoxY - 55 }, thickness: 2, color: colPrimary });

          const courseY = midBoxY - 85;
          drawCenteredText(page, fontSansBold, 'COURSE DETAILS', courseY, 8, colMuted);
          const fullCourseText = courseCodeText ? `${courseCodeText}: ${courseNameText}` : courseNameText;
          drawCenteredText(page, fontSerifBold, fullCourseText, courseY - 16, 14, colPrimary, 460);

          const metaTopY = 220;
          page.drawLine({ start: { x: 75, y: metaTopY }, end: { x: W - 75, y: metaTopY }, thickness: 1, color: colBorder });

          const leftX = 75;
          let leftY = metaTopY - 20;
          page.drawText('SUBMITTED TO', { x: leftX, y: leftY, size: 9, font: fontSansBold, color: colSecondary });
          page.drawLine({ start: { x: leftX, y: leftY - 4 }, end: { x: leftX + 180, y: leftY - 4 }, thickness: 0.5, color: colBorder });
          leftY -= 20;
          leftY = drawLeftText(page, fontSerifBold, teacherNameText, leftX, leftY, 12, colDark);
          leftY -= 2;
          leftY = drawLeftText(page, fontSerif, teacherTitleText, leftX, leftY, 10, colSecondary);
          if (deptText) {
            leftY -= 2;
            drawLeftText(page, fontSerif, deptText, leftX, leftY, 9, colMuted, 200);
          }

          const rightX = W - 75;
          let rightY = metaTopY - 20;
          drawRightText(page, fontSansBold, 'SUBMITTED BY', rightX, rightY, 9, colSecondary);
          page.drawLine({ start: { x: rightX - 180, y: rightY - 4 }, end: { x: rightX, y: rightY - 4 }, thickness: 0.5, color: colBorder });
          rightY -= 20;

          for (const st of s.students) {
            const sName = st.name || 'Student Name';
            const sId = st.id ? `ID: ${st.id}` : '';
            const sSec = st.section ? st.section : '';
            drawRightText(page, fontSerifBold, sName, rightX, rightY, 11, colDark);
            rightY -= 14;
            if (sId) {
              drawRightText(page, fontSerif, sId, rightX, rightY, 9.5, colSecondary);
              rightY -= 13;
            }
            if (sSec) {
              drawRightText(page, fontSerif, sSec, rightX, rightY, 9, colMuted);
              rightY -= 13;
            }
            rightY -= 4;
          }

          const footerText = termText ? `${dateText}   •   ${termText}` : dateText;
          drawCenteredText(page, fontSerif, footerText, 60, 9.5, colMuted);
        }

        return await pdfDoc.save();
      }

      async function getLogoPngBytes(source) {
        if (!source) return null;
        return new Promise((resolve) => {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => {
            try {
              const canvas = document.createElement('canvas');
              canvas.width = img.naturalWidth || img.width || 200;
              canvas.height = img.naturalHeight || img.height || 200;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0);
              canvas.toBlob((blob) => {
                if (!blob) { resolve(null); return; }
                const reader = new FileReader();
                reader.onloadend = () => {
                  const arr = new Uint8Array(reader.result);
                  resolve(arr);
                };
                reader.onerror = () => resolve(null);
                reader.readAsArrayBuffer(blob);
              }, 'image/png');
            } catch (e) {
              resolve(null);
            }
          };
          img.onerror = () => resolve(null);
          img.src = source;
        });
      }

