            page.drawRectangle({ x: 68, y: midY + 40, width: codeWidth + 16, height: 20, color: colDark });
            page.drawText(courseCodeText, { x: 76, y: midY + 46, size: 9.5, font: fontSansBold, color: colWhite });
          }

          let tY = midY + 15;
          tY = drawLeftText(page, fontSansBold, titleText, 68, tY, 26, colDark, 460);
          if (subtitleText) {
            tY -= 4;
            tY = drawLeftText(page, fontSans, subtitleText, 68, tY, 12, colMuted, 440);
          }
          page.drawText(courseNameText, { x: 68, y: tY - 20, size: 13, font: fontSansBold, color: colSecondary });

          const botLineY = 200;
          page.drawLine({ start: { x: 50, y: botLineY }, end: { x: W - 50, y: botLineY }, thickness: 2, color: colDark });

          page.drawText('PRESENTED BY', { x: 50, y: botLineY - 20, size: 9, font: fontSansBold, color: colPrimary });
          let stY = botLineY - 38;
          for (const st of s.students) {
