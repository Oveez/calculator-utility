      // Responsive A4 Viewport Scaling Engine
      function updateViewportScale() {
        if (!coverViewport || !previewPage) return;
        const availableWidth = coverViewport.clientWidth;
        if (availableWidth <= 0) return;

        // 794px is the native unscaled A4 page width
        const scale = Math.min(availableWidth / 794, 1);
        previewPage.style.transform = `scale(${scale})`;
        coverViewport.style.height = `${Math.round(1123 * scale)}px`;
      }

      window.addEventListener('resize', updateViewportScale);

      // Convert remote image to base64 data URL for zero-CORS safety
      async function cacheLogoAsBase64(url) {
        if (!url) return null;
        if (url.startsWith('data:')) return url;
        try {
          const response = await fetch(url, { mode: 'cors' });
          if (!response.ok) return null;
          const blob = await response.blob();
          return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result);
            reader.onerror = () => resolve(null);
            reader.readAsDataURL(blob);
          });
        } catch {
          return null;
        }
      }

