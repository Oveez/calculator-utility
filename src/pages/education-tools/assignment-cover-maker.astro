            date: state.date,
            term: state.term,
            students: state.students
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(toSave));
        } catch (e) {
          console.warn('Could not save cover state to localStorage:', e);
        }
      }

      function loadStateFromStorage() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return false;
          const saved = JSON.parse(raw);
          if (saved && typeof saved === 'object') {
            Object.assign(state, saved);
            if (!Array.isArray(state.students) || state.students.length === 0) {
              state.students = [{ name: '', id: '', section: '' }];
            }
            return true;
          }
        } catch (e) {
          console.warn('Could not load cover state from localStorage:', e);
        }
        return false;
      }

