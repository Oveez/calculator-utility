          page.drawText(badgeText, { x: (W - bWidth) / 2, y: 527, size: 8.5, font: fontSansBold, color: colWhite });

          let tY = drawCenteredText(page, fontSansBold, titleText, 480, 24, colDark, 440);
          if (subtitleText) {
            tY -= 4;
