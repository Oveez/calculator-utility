        }

        if (state.logoMode === 'custom') {
          if (state.customLogoBase64) {
            return `
              <div class="cover-logo-box flex items-center justify-center ${extraClass}">
                <img
                  src="${escapeHtml(state.customLogoBase64)}"
                  alt="Custom Logo"
                  class="${sizeClass} object-contain"
                  onerror="this.parentElement.innerHTML = '${escapeHtml(getEmblemSvg(activeTheme.primary)).replace(/"/g, "'")}'"
