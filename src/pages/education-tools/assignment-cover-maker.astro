      // Master Preview Renderer
      function renderPreview() {
        const activeTheme = THEMES[state.theme] || THEMES.classic;

        // Apply Theme CSS variables to preview container
        previewPage.style.setProperty('--cov-primary', activeTheme.primary);
        previewPage.style.setProperty('--cov-secondary', activeTheme.secondary);
        previewPage.style.setProperty('--cov-soft', activeTheme.soft);
        previewPage.style.setProperty('--cov-border', activeTheme.border);
        previewPage.style.setProperty('--cov-text', activeTheme.text);
        previewPage.style.setProperty('--cov-accent', activeTheme.accent);
        previewPage.style.setProperty('--cov-badge', activeTheme.badge);

        // Render appropriate template
        let html = '';
        switch (state.template) {
          case 'modern':
            html = renderTemplateModern();
            break;
          case 'professional':
            html = renderTemplateProfessional();
            break;
          case 'elegant':
            html = renderTemplateElegant();
            break;
          case 'bold':
            html = renderTemplateBold();
            break;
          case 'classic':
          default:
            html = renderTemplateClassic();
            break;
        }

        previewContent.innerHTML = html;
        previewModeTag.textContent = `${getTemplateDisplayName(state.template)} • ${activeTheme.name}`;

        // Re-calculate responsive viewport scale
        updateViewportScale();
      }

      function getTemplateDisplayName(key) {
        const map = {
          classic: 'Classic Academic',
          modern: 'Modern Minimal',
          professional: 'Professional',
          elegant: 'Elegant',
          bold: 'Bold Academic'
        };
        return map[key] || 'Classic Academic';
      }

      // ==========================================
      // TEMPLATE & THEME SWITCHING LISTENERS
      // ==========================================
      document.querySelectorAll('#template-selector-grid .template-card').forEach(btn => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-template');
          if (!selected) return;
          state.template = selected;

          // Update active styling
          document.querySelectorAll('#template-selector-grid .template-card').forEach(card => {
            card.classList.remove('border-[color:var(--accent)]', 'border-2', 'bg-[color:var(--surface-strong)]');
            card.classList.add('border-[color:var(--border)]', 'bg-[color:var(--surface)]');
            const badge = card.querySelector('.active-badge');
            if (badge) badge.classList.add('hidden');
          });

          btn.classList.remove('border-[color:var(--border)]', 'bg-[color:var(--surface)]');
          btn.classList.add('border-[color:var(--accent)]', 'border-2', 'bg-[color:var(--surface-strong)]');
          const activeBadge = btn.querySelector('.active-badge');
          if (activeBadge) activeBadge.classList.remove('hidden');

          templateLabel.textContent = getTemplateDisplayName(selected);
          renderPreview();
        });
      });

      document.querySelectorAll('#theme-selector-grid .theme-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-theme');
          if (!selected || !THEMES[selected]) return;
          state.theme = selected;

          // Update active styling
          document.querySelectorAll('#theme-selector-grid .theme-pill').forEach(pill => {
            pill.classList.remove('border-[color:var(--accent)]', 'border-2', 'bg-[color:var(--surface-strong)]');
            pill.classList.add('border-[color:var(--border)]', 'bg-[color:var(--surface)]');
          });

          btn.classList.remove('border-[color:var(--border)]', 'bg-[color:var(--surface)]');
          btn.classList.add('border-[color:var(--accent)]', 'border-2', 'bg-[color:var(--surface-strong)]');

          themeLabel.textContent = THEMES[selected].name;
          renderPreview();
        });
      });

      // ==========================================
      // INSTITUTION SEARCH & AUTOCOMPLETE
      // ==========================================
      async function fetchInstitutionsDb() {
        if (institutionsDb || isFetchingDb) return;
        isFetchingDb = true;
        try {
          const res = await fetch('/data/institutions.json?v=' + LOGO_VERSION);
          institutionsDb = await res.json();
        } catch (err) {
          console.error('Failed to load institutions DB', err);
        }
      }

      instInput.addEventListener('focus', fetchInstitutionsDb);

      instInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        instResults.innerHTML = '';

        if (query.length > 0) {
          btnClearInst.classList.remove('hidden');
        } else {
          btnClearInst.classList.add('hidden');
        }

        state.institution = e.target.value.trim() || 'Institution Name';

        if (!institutionsDb || query.length < 2) {
          instResults.classList.add('hidden');
          renderPreview();
          return;
        }

        // Smart search matches with exact acronym and prefix priority
        const matches = institutionsDb.filter(item => {
          const name = item[0].toLowerCase();
          const slug = item[1] ? item[1].toLowerCase() : '';
          const acros = item[3] ? item[3].toLowerCase().split(/\s+/) : [];
          return name.includes(query) || slug.includes(query) || acros.some(a => a === query || a.startsWith(query));
        }).sort((a, b) => {
          // 1. Exact acronym match (e.g. 'DU', 'KU', 'BUET', 'NU')
          const aExactAcro = a[3] && a[3].toLowerCase().split(/\s+/).includes(query);
          const bExactAcro = b[3] && b[3].toLowerCase().split(/\s+/).includes(query);
          if (aExactAcro && !bExactAcro) return -1;
          if (!aExactAcro && bExactAcro) return 1;
          if (aExactAcro && bExactAcro) {
            if ((b[4] || 0) !== (a[4] || 0)) return (b[4] || 0) - (a[4] || 0);
            if (a[2] === 'BD' && b[2] !== 'BD') return -1;
            if (a[2] !== 'BD' && b[2] === 'BD') return 1;
          }

          // 2. Name starts with query (prefix match)
          const aStarts = a[0].toLowerCase().startsWith(query);
          const bStarts = b[0].toLowerCase().startsWith(query);
          if (aStarts && !bStarts) return -1;
          if (!aStarts && bStarts) return 1;

          // 3. Priority for universities with verified logos
          if ((b[4] || 0) !== (a[4] || 0)) return (b[4] || 0) - (a[4] || 0);

          // 4. Priority for Bangladeshi institutions to avoid foreign name collisions
          const aIsBd = a[2] === 'BD';
          const bIsBd = b[2] === 'BD';
          if (aIsBd && !bIsBd) return -1;
          if (!aIsBd && bIsBd) return 1;

          return a[0].localeCompare(b[0]);
        }).slice(0, 14);

        if (matches.length > 0) {
          matches.forEach(match => {
            const [name, slug, country, acronym, hasLogo] = match;
            const primaryAcro = acronym ? acronym.split(' ')[0] : null;
            const li = document.createElement('li');
            li.className = 'px-4 py-2.5 hover:bg-[color:var(--surface-active)] cursor-pointer text-xs text-[color:var(--fg)] flex justify-between items-center transition border-b border-[color:var(--border)] last:border-none';
            li.innerHTML = `
              <div class="flex items-center gap-2 overflow-hidden">
                ${primaryAcro ? `<span class="text-[10px] font-bold font-mono px-1.5 py-0.5 rounded bg-[color:var(--accent-soft)] text-[color:var(--accent)] shrink-0">${escapeHtml(primaryAcro)}</span>` : ''}
                <span class="font-medium truncate">${escapeHtml(name)}</span>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                ${hasLogo === 1 ? `<span class="inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"><svg class="w-3 h-3 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Logo</span>` : ''}
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[color:var(--surface-strong)] text-[color:var(--muted)] border border-[color:var(--border)]">${escapeHtml(country || 'GL')}</span>
              </div>
            `;

            li.addEventListener('click', async () => {
              instInput.value = name;
              state.institution = name;
              state.slug = slug;
              state.hasCustomLogo = false;

              if (hasLogo === 1) {
                // Instantly clear old cached base64 so previous university logo is not kept
                state.logoBase64 = null;
                state.logoUrl = `${CDN_URL}/${slug}.webp?v=${LOGO_VERSION}`;
                logoStatusIndicator.innerHTML = `
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Official R2 Seal Loaded (${escapeHtml(name)})</span>
                `;
                renderPreview();

                // Pre-cache as Base64 for instant zero-CORS PDF export
                const b64 = await cacheLogoAsBase64(state.logoUrl);
                if (b64 && state.slug === slug) {
                  state.logoBase64 = b64;
                  renderPreview();
                }
              } else {
                state.logoUrl = '';
                state.logoBase64 = null;
                logoStatusIndicator.innerHTML = `
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                  <span>Academic Crest Active (Upload custom logo if desired)</span>
                `;
                renderPreview();
              }

              instResults.classList.add('hidden');
            });

            instResults.appendChild(li);
          });
          instResults.classList.remove('hidden');
        } else {
          instResults.classList.add('hidden');
        }

        renderPreview();
      });

      btnClearInst.addEventListener('click', () => {
        instInput.value = '';
        state.institution = '';
        state.slug = '';
        state.logoUrl = '';
        state.logoBase64 = null;
        state.hasCustomLogo = false;
        btnClearInst.classList.add('hidden');
        instResults.classList.add('hidden');
        logoStatusIndicator.innerHTML = `
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span>Default academic emblem</span>
        `;
        renderPreview();
      });

      // Close dropdown on outside click
      document.addEventListener('click', (e) => {
        if (!instInput.contains(e.target) && !instResults.contains(e.target)) {
          instResults.classList.add('hidden');
        }
      });

      // Custom Logo File Upload
      customLogoInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (evt) => {
          state.logoUrl = evt.target.result;
          state.logoBase64 = evt.target.result;
          state.hasCustomLogo = true;
          logoStatusIndicator.innerHTML = `
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Custom logo uploaded: ${escapeHtml(file.name.slice(0, 20))}</span>
          `;
          renderPreview();
        };
        reader.readAsDataURL(file);
      });

      // Other Form Field Listeners
      deptInput.addEventListener('input', (e) => { state.department = e.target.value; renderPreview(); });
      titleInput.addEventListener('input', (e) => { state.title = e.target.value; renderPreview(); });
      subtitleInput.addEventListener('input', (e) => { state.subtitle = e.target.value; renderPreview(); });
      courseNameInput.addEventListener('input', (e) => { state.courseName = e.target.value; renderPreview(); });
      courseCodeInput.addEventListener('input', (e) => { state.courseCode = e.target.value; renderPreview(); });
      teacherNameInput.addEventListener('input', (e) => { state.teacherName = e.target.value; renderPreview(); });
      teacherTitleInput.addEventListener('input', (e) => { state.teacherTitle = e.target.value; renderPreview(); });
      dateInput.addEventListener('input', (e) => { state.date = e.target.value; renderPreview(); });
      termInput.addEventListener('input', (e) => { state.term = e.target.value; renderPreview(); });

      document.getElementById('btn-today-date').addEventListener('click', () => {
        state.date = formatDate(new Date());
        dateInput.value = state.date;
        renderPreview();
      });

      // Add Student Button
      btnAddStudent.addEventListener('click', () => {
        if (state.students.length >= 6) {
          alert('Maximum 6 students supported for assignment cover.');
          return;
        }
        state.students.push({ name: '', id: '', section: '' });
        renderStudentsInput();
        renderPreview();
      });

      // Reset Button
      document.getElementById('btn-reset-form').addEventListener('click', () => {
        if (!confirm('Reset all fields to default?')) return;
        state.institution = 'University of Dhaka';
        state.slug = 'university-of-dhaka';
        state.logoUrl = `${CDN_URL}/university-of-dhaka.webp?v=${LOGO_VERSION}`;
        state.logoBase64 = null;
        state.hasCustomLogo = false;
        state.department = 'Department of Computer Science & Engineering';
        state.title = 'Design and Analysis of Scalable Cloud Microservices';
        state.subtitle = 'Final Term Comprehensive Project Report';
        state.courseName = 'Distributed Systems & Cloud Computing';
        state.courseCode = 'CSE-4101';
        state.teacherName = 'Dr. Sarah Rahman';
        state.teacherTitle = 'Professor & Head of Department';
        state.date = formatDate(new Date());
        state.term = 'Fall Semester 2026';
        state.students = [{ name: 'Tanvir Ahmed', id: '2026-08149', section: 'Section A' }];
        syncStateToInputs();
        renderPreview();
      });

      // Direct Print Button
      document.getElementById('btn-print-cover').addEventListener('click', () => {
        window.print();
      });

      // Quick Download Button (in header bar)
      const btnQuickDownload = document.getElementById('btn-quick-download');
      if (btnQuickDownload) {
        btnQuickDownload.addEventListener('click', () => {
          document.getElementById('generate-pdf-btn').click();
        });
      }

      // ==========================================
      // ROCK-SOLID HIGH-DPI A4 PDF EXPORT
      // 100% Visual Parity with Live Preview
      // ==========================================
      const genPdfBtn = document.getElementById('generate-pdf-btn');
      const btnPdfText = document.getElementById('btn-pdf-text');

      // Convert modern CSS oklch(...) colors to standard sRGB for html2canvas compatibility
      function oklchToRgb(oklchStr) {
        const match = oklchStr.match(/oklch\(\s*([\d\.]+%?)\s+([\d\.]+)\s+([\d\.]+)(?:\s*\/\s*([\d\.]+%?))?\s*\)/i);
        if (!match) return oklchStr;
        let L = parseFloat(match[1]);
        if (match[1].endsWith('%')) L /= 100;
        let C = parseFloat(match[2]);
        let H = parseFloat(match[3]);
        const alpha = match[4] ? (match[4].endsWith('%') ? parseFloat(match[4]) / 100 : parseFloat(match[4])) : 1;

        const hRad = (H * Math.PI) / 180;
        const a_ = C * Math.cos(hRad);
        const b_ = C * Math.sin(hRad);

        const l_ = L + 0.3963377774 * a_ + 0.2158037573 * b_;
        const m_ = L - 0.1055613458 * a_ - 0.0638541728 * b_;
        const s_ = L - 0.0894841775 * a_ - 1.2914855480 * b_;

        const l = l_ * l_ * l_;
        const m = m_ * m_ * m_;
        const s = s_ * s_ * s_;

        const rLin = +4.0767434770 * l - 3.3077115913 * m + 0.2309699292 * s;
        const gLin = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
        const bLin = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s;

        const toGamma = (x) => {
          const clamped = Math.max(0, Math.min(1, x));
          return clamped <= 0.0031308 ? 12.92 * clamped : 1.055 * Math.pow(clamped, 1 / 2.4) - 0.055;
        };

        const r = Math.round(toGamma(rLin) * 255);
        const g = Math.round(toGamma(gLin) * 255);
        const b = Math.round(toGamma(bLin) * 255);

        if (alpha < 1) return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        return `rgb(${r}, ${g}, ${b})`;
      }

      function sanitizeOklchColors(container, win = window) {
        if (!container) return;
        const COLOR_PROPS = [
          'color',
          'backgroundColor',
          'borderColor',
          'borderTopColor',
          'borderBottomColor',
          'borderLeftColor',
          'borderRightColor',
          'outlineColor'
        ];

        const elements = [container, ...container.querySelectorAll('*')];
        for (const el of elements) {
          const computed = win.getComputedStyle(el);
          for (const prop of COLOR_PROPS) {
            const val = computed[prop];
            if (val && val.includes('oklch')) {
              const converted = val.replace(/oklch\([^)]+\)/gi, match => oklchToRgb(match));
              el.style[prop] = converted;
            }
          }
        }
      }

      genPdfBtn.addEventListener('click', async () => {
        const originalText = btnPdfText.textContent;
        btnPdfText.textContent = 'Generating Crisp A4 PDF...';
        genPdfBtn.style.opacity = '0.75';
        genPdfBtn.disabled = true;

        const origTransform = previewPage.style.transform;
        const origHeight = previewPage.style.height;
        const origMinHeight = previewPage.style.minHeight;
        const origViewportWidth = coverViewport.style.width;
        const origViewportOverflow = coverViewport.style.overflow;

        try {
          // Pre-cache logo as Base64 if not already cached to prevent CORS canvas tainting
          if (state.logoUrl && !state.logoBase64) {
            state.logoBase64 = await cacheLogoAsBase64(state.logoUrl);
            renderPreview();
          }

          // Lock viewport dimensions during capture to prevent any screen jump
          coverViewport.style.width = `${coverViewport.clientWidth}px`;
          coverViewport.style.overflow = 'hidden';

          // Set preview page to native unscaled A4 dimensions (794px × 1120px)
          // 1120px ensures 100% exact 1-page fit inside standard 297mm A4 with 0 overflow
          previewPage.style.transform = 'none';
          previewPage.style.height = '1120px';
          previewPage.style.minHeight = '1120px';

          // Ensure any image tags have crossorigin set
          previewPage.querySelectorAll('img').forEach(img => {
            img.crossOrigin = 'anonymous';
          });

          // Sanitize any computed oklch colors on the preview elements
          sanitizeOklchColors(previewPage, window);

          // Wait a tick for layout and image paint
          await new Promise(r => setTimeout(r, 100));

          const safeFilename = `${(state.title || 'Assignment_Cover').slice(0, 32).replace(/[^a-zA-Z0-9_-]/g, '_')}_Cover.pdf`;

          const opt = {
            margin: 0,
            filename: safeFilename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
              scale: 2, // 2x scale = 300+ DPI vector sharpness
              useCORS: true,
              allowTaint: true,
              logging: false,
              scrollX: 0,
              scrollY: 0
            },
            jsPDF: {
              unit: 'mm',
              format: 'a4',
              orientation: 'portrait'
            },
            pagebreak: { mode: 'avoid-all' }
          };

          const html2pdfLib = await getHtml2Pdf();
          await html2pdfLib().set(opt).from(previewPage).save();
        } catch (err) {
          console.error('PDF generation error:', err);
          alert('Could not generate PDF: ' + (err.message || 'Unknown error') + '\n\nYou can also click the "Print Cover" button in the top bar to print or save as PDF directly.');
        } finally {
          // Restore live preview responsive scaling and layout instantly
          previewPage.style.transform = origTransform;
          previewPage.style.height = origHeight;
          previewPage.style.minHeight = origMinHeight;
          coverViewport.style.width = origViewportWidth;
          coverViewport.style.overflow = origViewportOverflow;
          updateViewportScale();

          btnPdfText.textContent = originalText;
          genPdfBtn.style.opacity = '1';
          genPdfBtn.disabled = false;
        }
      });

      // Initial Viewport & Preview Mount
      syncStateToInputs();
      renderPreview();
      updateViewportScale();

      // Pre-cache default logo for zero-CORS instant PDF export
      if (state.logoUrl) {
        cacheLogoAsBase64(state.logoUrl).then(b64 => {
          if (b64) {
            state.logoBase64 = b64;
            renderPreview();
          }
        });
      }
    })();
  </script>
</SiteLayout>
