  <!-- Load local self-hosted html2pdf bundle for instant zero-latency client-side PDF export -->
  <script is:inline src="/js/html2pdf.bundle.min.js"></script>

  <!-- Assignment Cover Maker Client Logic & Template Engine -->
  <script is:inline>
    (function () {
      const appRoot = document.querySelector('[data-cover-maker-app]');
      if (!appRoot) return;

      // Resilient PDF library getter (handles cached, local, and CDN fallback)
      function getHtml2Pdf() {
        if (typeof window.html2pdf === 'function') {
          return Promise.resolve(window.html2pdf);
        }
        return new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = '/js/html2pdf.bundle.min.js';
          s.onload = () => {
            if (typeof window.html2pdf === 'function') resolve(window.html2pdf);
            else reject(new Error('html2pdf object not available after load'));
          };
          s.onerror = () => {
            // Secondary fallback to CDN
            const cdn = document.createElement('script');
            cdn.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
            cdn.onload = () => {
              if (typeof window.html2pdf === 'function') resolve(window.html2pdf);
              else reject(new Error('html2pdf object not available after CDN load'));
            };
            cdn.onerror = () => reject(new Error('Failed to load PDF export engine. Please check internet connection.'));
            document.head.appendChild(cdn);
          };
          document.head.appendChild(s);
        });
      }

      const CDN_URL = 'https://logos.calculatorutility.tech';
      const LOGO_VERSION = 'v20260911';

      // 6 Curated Themes
      const THEMES = {
        classic: {
          name: 'Classic Slate',
          primary: '#0f172a',
          secondary: '#334155',
          soft: '#f8fafc',
          border: '#cbd5e1',
          text: '#0f172a',
          accent: '#475569',
          badge: '#f1f5f9'
        },
        blue: {
          name: 'Blue Academic (Oxford)',
          primary: '#1e3a8a',
          secondary: '#1d4ed8',
          soft: '#eff6ff',
          border: '#bfdbfe',
          text: '#172554',
          accent: '#2563eb',
          badge: '#dbeafe'
        },
        green: {
          name: 'Green Academic (Dartmouth)',
          primary: '#065f46',
          secondary: '#047857',
          soft: '#ecfdf5',
          border: '#a7f3d0',
          text: '#064e3b',
          accent: '#059669',
          badge: '#d1fae5'
        },
        burgundy: {
          name: 'Burgundy (Harvard)',
          primary: '#881337',
          secondary: '#9f1239',
          soft: '#fff1f2',
          border: '#fecdd3',
          text: '#4c0519',
          accent: '#be123c',
          badge: '#ffe4e6'
        },
        dark: {
          name: 'Dark Modern (Midnight)',
          primary: '#18181b',
          secondary: '#3f3f46',
          soft: '#f4f4f5',
          border: '#d4d4d8',
          text: '#09090b',
          accent: '#27272a',
          badge: '#e4e4e7'
        },
        neutral: {
          name: 'Warm Amber (Parchment)',
          primary: '#78350f',
          secondary: '#b45309',
          soft: '#fffbeb',
          border: '#fde68a',
          text: '#451a03',
          accent: '#d97706',
          badge: '#fef3c7'
        }
      };

      // Application State
      const state = {
        template: 'classic', // classic | modern | professional | elegant | bold
        theme: 'classic',
        institution: 'University of Dhaka',
        slug: 'university-of-dhaka',
        logoUrl: `${CDN_URL}/university-of-dhaka.webp?v=${LOGO_VERSION}`,
        logoBase64: null,
        hasCustomLogo: false,
        department: 'Department of Computer Science & Engineering',
        title: 'Design and Analysis of Scalable Cloud Microservices',
        subtitle: 'Final Term Comprehensive Project Report',
        courseName: 'Distributed Systems & Cloud Computing',
        courseCode: 'CSE-4101',
        teacherName: 'Dr. Sarah Rahman',
        teacherTitle: 'Professor & Head of Department',
        date: formatDate(new Date()),
        term: 'Fall Semester 2026',
        students: [
          { name: 'Tanvir Ahmed', id: '2026-08149', section: 'Section A' }
        ]
      };

      // DOM Elements
      const instInput = document.getElementById('inst-search');
      const btnClearInst = document.getElementById('btn-clear-inst');
      const instResults = document.getElementById('inst-results');
      const customLogoInput = document.getElementById('custom-logo-file');
      const logoStatusIndicator = document.getElementById('logo-status-indicator');
      const deptInput = document.getElementById('dept-input');
      const titleInput = document.getElementById('title-input');
      const subtitleInput = document.getElementById('subtitle-input');
      const courseNameInput = document.getElementById('course-name-input');
      const courseCodeInput = document.getElementById('course-code-input');
      const teacherNameInput = document.getElementById('teacher-name-input');
      const teacherTitleInput = document.getElementById('teacher-title-input');
      const dateInput = document.getElementById('date-input');
      const termInput = document.getElementById('term-input');
      const studentsContainer = document.getElementById('students-container');
      const btnAddStudent = document.getElementById('btn-add-student');
      const coverViewport = document.getElementById('cover-viewport');
      const previewPage = document.getElementById('cover-preview-page');
      const previewContent = document.getElementById('cover-preview-content');
      const previewModeTag = document.getElementById('preview-mode-tag');
      const templateLabel = document.getElementById('current-template-label');
      const themeLabel = document.getElementById('current-theme-label');

      let institutionsDb = null;
      let isFetchingDb = false;

      function formatDate(d) {
        const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        return `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
      }

      // Responsive A4 Viewport Scaling Engine
      function updateViewportScale() {
        if (!coverViewport || !previewPage) return;
        const availableWidth = coverViewport.clientWidth;
        if (availableWidth <= 0) return;

        // 794px is the native unscaled A4 page width
        const scale = Math.min(availableWidth / 794, 1);
        previewPage.style.transform = `scale(${scale})`;
        coverViewport.style.height = `${Math.round(1123 * scale)}px`;
      }

      window.addEventListener('resize', updateViewportScale);

      // Convert remote image to base64 data URL for zero-CORS canvas safety
      async function cacheLogoAsBase64(url) {
        if (!url) return null;
        if (url.startsWith('data:')) return url;
        try {
          const response = await fetch(url, { mode: 'cors' });
          if (!response.ok) return null;
          const blob = await response.blob();
          return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result);
            reader.onerror = () => resolve(null);
            reader.readAsDataURL(blob);
          });
        } catch {
          return null;
        }
      }

      // Initial Sync of form fields
      function syncStateToInputs() {
        instInput.value = state.institution;
        deptInput.value = state.department;
        titleInput.value = state.title;
        subtitleInput.value = state.subtitle;
        courseNameInput.value = state.courseName;
        courseCodeInput.value = state.courseCode;
        teacherNameInput.value = state.teacherName;
        teacherTitleInput.value = state.teacherTitle;
        dateInput.value = state.date;
        termInput.value = state.term;
        renderStudentsInput();
      }

      function renderStudentsInput() {
        studentsContainer.innerHTML = '';
        state.students.forEach((student, index) => {
          const row = document.createElement('div');
          row.className = 'student-entry grid grid-cols-1 sm:grid-cols-12 gap-2 p-3 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] relative';
          row.innerHTML = `
            <div class="sm:col-span-5 space-y-1">
              <label class="block text-[10px] font-bold text-[color:var(--muted)] uppercase tracking-wider">Student ${index + 1} Name</label>
              <input type="text" data-idx="${index}" data-field="name" class="w-full rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs text-[color:var(--fg)] focus:outline-none" placeholder="Student Name" value="${escapeHtml(student.name)}" />
            </div>
            <div class="sm:col-span-4 space-y-1">
              <label class="block text-[10px] font-bold text-[color:var(--muted)] uppercase tracking-wider">Student ID</label>
              <input type="text" data-idx="${index}" data-field="id" class="w-full rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs text-[color:var(--fg)] focus:outline-none" placeholder="ID / Roll" value="${escapeHtml(student.id)}" />
            </div>
            <div class="sm:col-span-3 space-y-1 flex items-end gap-1">
              <div class="w-full">
                <label class="block text-[10px] font-bold text-[color:var(--muted)] uppercase tracking-wider">Section / Batch</label>
                <input type="text" data-idx="${index}" data-field="section" class="w-full rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs text-[color:var(--fg)] focus:outline-none" placeholder="Sec / Batch" value="${escapeHtml(student.section)}" />
              </div>
              ${state.students.length > 1 ? `
                <button type="button" data-remove-idx="${index}" class="p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg cursor-pointer transition mb-0.5" title="Remove member">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              ` : ''}
            </div>
          `;
          studentsContainer.appendChild(row);
        });

        // Attach listeners for student input updates
        studentsContainer.querySelectorAll('input').forEach(inp => {
          inp.addEventListener('input', (e) => {
            const idx = parseInt(e.target.getAttribute('data-idx'));
            const field = e.target.getAttribute('data-field');
            if (state.students[idx]) {
              state.students[idx][field] = e.target.value;
              renderPreview();
            }
          });
        });

        // Attach listeners for student removal
        studentsContainer.querySelectorAll('[data-remove-idx]').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.getAttribute('data-remove-idx'));
            state.students.splice(idx, 1);
            renderStudentsInput();
            renderPreview();
          });
        });
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // Default Stylized Academic Crest SVG for fallback
      function getEmblemSvg(color, sizeClass = 'w-24 h-24') {
        return `
          <svg class="${sizeClass}" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="50" cy="50" r="46" stroke="${color}" stroke-width="2.5" stroke-dasharray="5 2.5"/>
            <circle cx="50" cy="50" r="38" stroke="${color}" stroke-width="1.5"/>
            <path d="M50 18L76 31V53C76 70 50 81 50 81C50 81 24 70 24 53V31L50 18Z" fill="${color}" fill-opacity="0.08" stroke="${color}" stroke-width="2"/>
            <path d="M50 33L63 40V53C63 62 50 68 50 68C50 68 37 62 37 53V40L50 33Z" stroke="${color}" stroke-width="1.5"/>
            <path d="M42 48L50 43L58 48L50 53L42 48Z" fill="${color}"/>
            <path d="M50 53V61M45 50V59M55 50V59" stroke="${color}" stroke-width="1.5"/>
          </svg>
        `;
      }

      // Render Logo Component with zero-CORS DataURL preference
      function renderLogoHtml(extraClass = '', sizeClass = 'max-h-24 max-w-[200px]') {
        const activeTheme = THEMES[state.theme] || THEMES.classic;
        const effectiveSrc = state.logoBase64 || state.logoUrl;

        if (effectiveSrc) {
          return `
            <div class="cover-logo-box flex items-center justify-center ${extraClass}">
              <img
                src="${escapeHtml(effectiveSrc)}"
                alt="${escapeHtml(state.institution)} Logo"
                crossorigin="anonymous"
                class="${sizeClass} object-contain"
                onerror="this.parentElement.innerHTML = '${escapeHtml(getEmblemSvg(activeTheme.primary)).replace(/"/g, "'")}'"
              />
            </div>
          `;
        }
        return `
          <div class="cover-logo-box flex items-center justify-center ${extraClass}">
            ${getEmblemSvg(activeTheme.primary)}
          </div>
        `;
      }

