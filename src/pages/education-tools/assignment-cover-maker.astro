      // Render Logo Component with 4 Explicit Modes
      function renderLogoHtml(extraClass = '', sizeClass = 'max-h-24 max-w-[200px]') {
        const activeTheme = THEMES[state.theme] || THEMES.classic;

        if (state.logoMode === 'none') {
          return '';
