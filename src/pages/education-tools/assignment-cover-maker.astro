---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Assignment Cover Maker (Free PDF Generator) · ${siteName}`;
const pageDesc = 'Create professional university assignment covers instantly. Choose from 5 academic templates, custom color themes, search thousands of institutions, and generate a print-ready A4 PDF.';
const canonicalUrl = toAbsoluteUrl('/education-tools/assignment-cover-maker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Education Tools', href: toAbsoluteUrl('/education-tools/') },
  { label: 'Assignment Cover Maker' },
];

const schemaFaq = [
  {
    question: 'Are university assignment covers free to download?',
    answer: 'Yes, 100% free. You can generate and download unlimited high-resolution A4 PDFs without watermarks, registration, or hidden fees.',
  },
  {
    question: 'How do I add my university logo to the cover page?',
    answer: 'Simply type your university name or acronym (e.g., DU, BUET, KU, NSU, Harvard) in the institution search box to load its verified emblem automatically, or upload your own custom image file using the Upload Custom Logo option.',
  },
  {
    question: 'Is my student data and assignment information secure?',
    answer: 'Yes. All data processing and PDF compilation occur 100% locally in your web browser. Your names, roll numbers, assignment titles, and grades are never uploaded to any remote server.',
  },
  {
    question: 'Can I add multiple group members to a group assignment cover?',
    answer: 'Yes. Click the "+ Add Team Member" button to add as many group students as needed, with individual names, student IDs, and section codes.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Assignment Cover Maker',
    url: canonicalUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout heroCompact={true} title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <style is:inline>
    /* Dedicated Print Styles for Direct Native Browser Printing */
    @media print {
      @page {
        size: 210mm 297mm;
        margin: 0mm;
      }
      *, *::before, *::after {
        box-sizing: border-box !important;
      }
      html, body {
        width: 210mm !important;
        height: 297mm !important;
        max-width: 210mm !important;
        max-height: 297mm !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        overflow: hidden !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      /* Hide all website chrome, navbars, sidebars, headers, footers */
      body * {
        visibility: hidden !important;
      }
      /* Reveal only the cover preview page and all its descendants */
      #cover-preview-page,
      #cover-preview-page * {
        visibility: visible !important;
      }
      #cover-preview-page {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: 210mm !important;
        height: 297mm !important;
        min-width: 210mm !important;
        min-height: 297mm !important;
        max-width: 210mm !important;
        max-height: 297mm !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important;
        transform: none !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
        page-break-inside: avoid !important;
        page-break-before: avoid !important;
        page-break-after: avoid !important;
        break-inside: avoid !important;
        break-before: avoid !important;
        break-after: avoid !important;
        background: #ffffff !important;
        z-index: 9999999 !important;
      }
      #cover-preview-content {
        width: 100% !important;
        height: 100% !important;
        box-sizing: border-box !important;
      }
    }
  </style>

  
  <div slot="hero" class="site-hero-header">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header Section -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-[color:var(--border)] pb-5">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[color:var(--accent-soft)] text-[color:var(--accent)]">
            <Icon name="sparkles" class="w-3.5 h-3.5" />
            Academic Tool
          </span>
          <span class="text-xs text-[color:var(--muted)] font-medium">Standard A4 Format (210 × 297 mm)</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-[color:var(--fg)] sm:text-3xl">
          Assignment Cover Maker
        </h1>
        <p class="text-sm text-[color:var(--muted)] mt-1 max-w-2xl leading-relaxed">
          Create publication-quality university cover pages in seconds. Choose from 5 distinct academic templates, customize color palettes, load institution logos, and export print-ready A4 PDFs.
        </p>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
        <button
          type="button"
          id="btn-sample-data"
          class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] hover:border-[color:var(--accent)] transition cursor-pointer shadow-xs"
          title="Populate form with University of Dhaka sample data"
        >
          <Icon name="sparkles" class="w-3.5 h-3.5 text-[color:var(--accent)]" />
          <span>Use Sample Data</span>
        </button>
        <button
          type="button"
          id="btn-reset-form"
          class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:text-rose-600 dark:hover:text-rose-400 hover:border-rose-500/50 hover:bg-[color:var(--surface-strong)] transition cursor-pointer shadow-xs"
          title="Reset all form fields"
        >
          <Icon name="refresh" class="w-3.5 h-3.5 text-[color:var(--muted)]" />
          <span>Reset</span>
        </button>
        <button
          type="button"
          id="btn-print-cover"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] hover:border-[color:var(--accent)] transition cursor-pointer shadow-xs"
        >
          <Icon name="document" class="w-3.5 h-3.5 text-[color:var(--muted)]" />
          <span>Print</span>
        </button>
        <button
          type="button"
          id="btn-quick-download"
          class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold rounded-xl bg-[color:var(--accent)] hover:bg-[color:var(--accent-hover)] text-white transition cursor-pointer shadow-xs focus:ring-2 focus:ring-[color:var(--accent-glow)]"
        >
          <Icon name="download" class="w-3.5 h-3.5" />
          <span>Download PDF</span>
        </button>
      </div>
    </header>
  </div>

  <article class="space-y-6 py-2" data-cover-maker-app>

    <!-- Main Workspace: Split Editor & Preview -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start">
      
      <!-- LEFT COLUMN: Controls & Form Editor (6 cols) -->
      <section id="editor-controls-column" class="lg:col-span-6 xl:col-span-6 space-y-6">
        
        <!-- 1. TEMPLATE SELECTION -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 shadow-xs space-y-3.5">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-[color:var(--fg)] flex items-center gap-2">
              <Icon name="dice" class="w-4 h-4 text-[color:var(--accent)]" />
              <span>1. Choose Cover Template</span>
            </h2>
            <span class="text-xs text-[color:var(--muted)] font-medium" id="current-template-label">Classic Academic</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="template-selector-grid">
            <!-- Template 1: Classic Academic -->
            <button
              type="button"
              data-template="classic"
              class="template-card relative flex flex-col items-start p-3 rounded-xl border-2 border-[color:var(--accent)] bg-[color:var(--surface-strong)] text-left transition hover:border-[color:var(--accent)] cursor-pointer group"
            >
              <div class="w-full aspect-[4/3] rounded-lg bg-white border border-slate-200 p-2 flex flex-col items-center justify-between mb-2 shadow-xs group-hover:scale-[1.02] transition">
                <div class="w-4 h-4 rounded-full border border-slate-400 bg-slate-100 flex items-center justify-center text-slate-600">
                  <svg class="w-2.5 h-2.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="22" x2="21" y2="22"></line><line x1="6" y1="18" x2="6" y2="11"></line><line x1="10" y1="18" x2="10" y2="11"></line><line x1="14" y1="18" x2="14" y2="11"></line><line x1="18" y1="18" x2="18" y2="11"></line><polygon points="12 2 20 7 4 7"></polygon></svg>
                </div>
                <div class="w-12 h-1 bg-slate-800 rounded-full"></div>
                <div class="w-16 h-0.5 bg-slate-300 rounded-full"></div>
                <div class="w-full flex justify-between px-1 text-[5px] text-slate-400"><span>•</span><span>•</span></div>
              </div>
              <span class="text-xs font-bold text-[color:var(--fg)] leading-tight">Classic</span>
              <span class="text-[10px] text-[color:var(--muted)] mt-0.5">Formal & Traditional</span>
              <span class="active-badge absolute top-2 right-2 w-2 h-2 rounded-full bg-[color:var(--accent)]"></span>
            </button>

            <!-- Template 2: Modern Minimal -->
            <button
              type="button"
              data-template="modern"
              class="template-card relative flex flex-col items-start p-3 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-left transition hover:border-[color:var(--accent)] cursor-pointer group"
            >
              <div class="w-full aspect-[4/3] rounded-lg bg-white border border-slate-200 p-2 flex flex-col justify-between mb-2 shadow-xs group-hover:scale-[1.02] transition">
                <div class="flex justify-between items-center w-full">
                  <div class="w-8 h-1 bg-blue-600 rounded-full"></div>
                  <div class="w-3 h-3 rounded-xs bg-slate-200"></div>
                </div>
                <div class="space-y-1 my-auto">
                  <div class="w-14 h-1.5 bg-slate-900 rounded-full"></div>
                  <div class="w-10 h-0.5 bg-slate-400 rounded-full"></div>
                </div>
                <div class="w-12 h-0.5 bg-slate-300 rounded-full"></div>
              </div>
              <span class="text-xs font-bold text-[color:var(--fg)] leading-tight">Modern Minimal</span>
              <span class="text-[10px] text-[color:var(--muted)] group-hover:text-[color:var(--fg)] mt-0.5 font-medium">Clean & Contemporary</span>
              <span class="active-badge absolute top-2 right-2 w-2 h-2 rounded-full bg-[color:var(--accent)] hidden"></span>
            </button>

            <!-- Template 3: Professional -->
            <button
              type="button"
              data-template="professional"
              class="template-card relative flex flex-col items-start p-3 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-left transition hover:border-[color:var(--accent)] cursor-pointer group"
            >
              <div class="w-full aspect-[4/3] rounded-lg bg-white border border-slate-200 p-1.5 flex flex-col justify-between mb-2 shadow-xs group-hover:scale-[1.02] transition">
                <div class="w-full h-2 bg-slate-100 rounded-xs flex items-center px-1">
                  <div class="w-10 h-0.5 bg-slate-600 rounded-full"></div>
                </div>
                <div class="w-12 h-1 bg-slate-800 rounded-full mx-auto"></div>
                <div class="grid grid-cols-2 gap-1 w-full">
                  <div class="h-3.5 rounded-xs bg-slate-50 border border-slate-200"></div>
                  <div class="h-3.5 rounded-xs bg-slate-50 border border-slate-200"></div>
                </div>
              </div>
              <span class="text-xs font-bold text-[color:var(--fg)] leading-tight">Professional</span>
              <span class="text-[10px] text-[color:var(--muted)] group-hover:text-[color:var(--fg)] mt-0.5 font-medium">Structured Card Grid</span>
              <span class="active-badge absolute top-2 right-2 w-2 h-2 rounded-full bg-[color:var(--accent)] hidden"></span>
            </button>

            <!-- Template 4: Elegant -->
            <button
              type="button"
              data-template="elegant"
              class="template-card relative flex flex-col items-start p-3 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-left transition hover:border-[color:var(--accent)] cursor-pointer group"
            >
              <div class="w-full aspect-[4/3] rounded-lg bg-white border border-slate-200 p-1.5 flex flex-col justify-between mb-2 shadow-xs group-hover:scale-[1.02] transition">
                <div class="w-full h-full border border-slate-300 rounded-xs p-1 flex flex-col items-center justify-between">
                  <div class="w-3 h-3 rounded-full border border-slate-400"></div>
                  <div class="w-10 h-1 bg-slate-900 rounded-full"></div>
                  <div class="w-8 h-0.5 bg-slate-400 rounded-full"></div>
                  <div class="w-6 h-0.5 bg-slate-300 rounded-full"></div>
                </div>
              </div>
              <span class="text-xs font-bold text-[color:var(--fg)] leading-tight">Elegant</span>
              <span class="text-[10px] text-[color:var(--muted)] group-hover:text-[color:var(--fg)] mt-0.5 font-medium">Ornamental Border</span>
              <span class="active-badge absolute top-2 right-2 w-2 h-2 rounded-full bg-[color:var(--accent)] hidden"></span>
            </button>

            <!-- Template 5: Bold Academic -->
            <button
              type="button"
              data-template="bold"
              class="template-card relative flex flex-col items-start p-3 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-left transition hover:border-[color:var(--accent)] cursor-pointer group"
            >
              <div class="w-full aspect-[4/3] rounded-lg bg-white border border-slate-200 overflow-hidden flex flex-col justify-between mb-2 shadow-xs group-hover:scale-[1.02] transition">
                <div class="w-full h-3 bg-blue-700 flex items-center px-1">
                  <div class="w-10 h-0.5 bg-white rounded-full"></div>
                </div>
                <div class="px-2 space-y-1">
                  <div class="w-14 h-1.5 bg-slate-900 rounded-full"></div>
                  <div class="w-8 h-0.5 bg-slate-400 rounded-full"></div>
                </div>
                <div class="w-full h-1.5 bg-slate-200"></div>
              </div>
              <span class="text-xs font-bold text-[color:var(--fg)] leading-tight">Bold Academic</span>
              <span class="text-[10px] text-[color:var(--muted)] group-hover:text-[color:var(--fg)] mt-0.5 font-medium">High Impact Banner</span>
              <span class="active-badge absolute top-2 right-2 w-2 h-2 rounded-full bg-[color:var(--accent)] hidden"></span>
            </button>
          </div>
        </div>

        <!-- 2. THEME COLOR SELECTION -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-[color:var(--fg)] flex items-center gap-2">
              <Icon name="color" class="w-4 h-4 text-[color:var(--accent)]" />
              <span>2. Color Palette</span>
            </h2>
            <span class="text-xs text-[color:var(--muted)] font-medium" id="current-theme-label">Classic Slate</span>
          </div>

          <div class="grid grid-cols-3 sm:grid-cols-6 gap-2" id="theme-selector-grid">
            <button
              type="button"
              data-theme="classic"
              class="theme-pill flex flex-col items-center gap-1.5 p-2 rounded-xl border-2 border-[color:var(--accent)] bg-[color:var(--surface-strong)] transition cursor-pointer hover:scale-105"
            >
              <span class="w-6 h-6 rounded-full bg-slate-900 shadow-xs border border-white"></span>
              <span class="text-[11px] font-semibold text-[color:var(--fg)]">Classic</span>
            </button>

            <button
              type="button"
              data-theme="blue"
              class="theme-pill flex flex-col items-center gap-1.5 p-2 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] transition cursor-pointer hover:scale-105 hover:border-[color:var(--accent)]"
            >
              <span class="w-6 h-6 rounded-full bg-blue-700 shadow-xs border border-white"></span>
              <span class="text-[11px] font-semibold text-[color:var(--fg)]">Navy</span>
            </button>

            <button
              type="button"
              data-theme="green"
              class="theme-pill flex flex-col items-center gap-1.5 p-2 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] transition cursor-pointer hover:scale-105 hover:border-[color:var(--accent)]"
            >
              <span class="w-6 h-6 rounded-full bg-emerald-800 shadow-xs border border-white"></span>
              <span class="text-[11px] font-semibold text-[color:var(--fg)]">Forest</span>
            </button>

            <button
              type="button"
              data-theme="burgundy"
              class="theme-pill flex flex-col items-center gap-1.5 p-2 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] transition cursor-pointer hover:scale-105 hover:border-[color:var(--accent)]"
            >
              <span class="w-6 h-6 rounded-full bg-rose-900 shadow-xs border border-white"></span>
              <span class="text-[11px] font-semibold text-[color:var(--fg)]">Crimson</span>
            </button>

            <button
              type="button"
              data-theme="dark"
              class="theme-pill flex flex-col items-center gap-1.5 p-2 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] transition cursor-pointer hover:scale-105 hover:border-[color:var(--accent)]"
            >
              <span class="w-6 h-6 rounded-full bg-indigo-950 shadow-xs border border-white"></span>
              <span class="text-[11px] font-semibold text-[color:var(--fg)]">Midnight</span>
            </button>

            <button
              type="button"
              data-theme="neutral"
              class="theme-pill flex flex-col items-center gap-1.5 p-2 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] transition cursor-pointer hover:scale-105 hover:border-[color:var(--accent)]"
            >
              <span class="w-6 h-6 rounded-full bg-amber-800 shadow-xs border border-white"></span>
              <span class="text-[11px] font-semibold text-[color:var(--fg)]">Amber</span>
            </button>
          </div>
        </div>

        <!-- 3. INSTITUTION & LOGO DETAILS -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 shadow-xs space-y-4">
          <h2 class="text-sm font-bold text-[color:var(--fg)] flex items-center gap-2">
            <Icon name="education" class="w-4 h-4 text-[color:var(--accent)]" />
            <span>3. Institution & Department</span>
          </h2>

          <!-- Institution Search Input with Dropdown -->
          <div class="relative space-y-1.5">
            <label for="inst-search" class="block text-xs font-semibold text-[color:var(--fg)]">
              University / College / School <span class="text-[color:var(--accent)]">*</span>
            </label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-[color:var(--muted)] pointer-events-none">
                <Icon name="search" class="w-4 h-4" />
              </span>
              <input
                type="text"
                id="inst-search"
                placeholder="e.g. University of Dhaka"
                autocomplete="off"
                class="w-full rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--bg)] pl-10 pr-10 py-2.5 text-sm text-[color:var(--fg)] placeholder-[color:var(--muted)] transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-glow)] focus:outline-none"
              />
              <button
                type="button"
                id="btn-clear-inst"
                class="absolute right-3 text-[color:var(--fg)]/60 hover:text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] rounded-lg p-1 hidden cursor-pointer transition"
                title="Clear input"
              >
                <Icon name="close" class="w-3.5 h-3.5" />
              </button>
            </div>

            <!-- Autocomplete Results Container -->
            <ul
              id="inst-results"
              class="absolute left-0 right-0 top-[100%] mt-1 max-h-64 overflow-y-auto rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] shadow-xl hidden z-50 divide-y divide-[color:var(--border)]"
            >
              <!-- Populated dynamically via JS -->
            </ul>
          </div>

          <!-- Logo Mode Selection (4 Explicit Choices) -->
          <div class="space-y-2 pt-1">
            <label class="block text-xs font-semibold text-[color:var(--fg)]">Logo Option</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="logo-mode-selector">
              <button
                type="button"
                data-logo-mode="stored"
                class="logo-mode-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 border-[color:var(--accent)] bg-[color:var(--surface-strong)] text-[color:var(--fg)] transition cursor-pointer text-center"
              >
                <Icon name="search" class="w-4 h-4 text-[color:var(--accent)] mb-1" />
                <span class="text-[11px] font-bold leading-tight">University Logo</span>
              </button>
              <button
                type="button"
                data-logo-mode="custom"
                class="logo-mode-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:border-[color:var(--accent)] transition cursor-pointer text-center group"
              >
                <Icon name="image" class="w-4 h-4 text-[color:var(--muted)] group-hover:text-[color:var(--fg)] mb-1" />
                <span class="text-[11px] font-semibold leading-tight">Custom Logo</span>
              </button>
              <button
                type="button"
                data-logo-mode="emblem"
                class="logo-mode-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-[color:var(--border-strong)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:border-[color:var(--accent)] transition cursor-pointer text-center group"
              >
                <Icon name="landmark" class="w-4 h-4 text-[color:var(--muted)] group-hover:text-[color:var(--fg)] mb-1" />
