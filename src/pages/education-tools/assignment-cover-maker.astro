          }

          const coursePill = courseCodeText ? `${courseCodeText}   •   ${courseNameText}` : courseNameText;
          const cpWidth = fontSans.widthOfTextAtSize(coursePill, 10.5);
          page.drawRectangle({
            x: (W - cpWidth - 32) / 2,
            y: tY - 30,
            width: cpWidth + 32,
            height: 26,
            color: PDFLib.rgb(0.95, 0.96, 0.98),
            borderColor: colBorder,
            borderWidth: 1
          });
          page.drawText(coursePill, { x: (W - cpWidth) / 2, y: tY - 22, size: 10.5, font: fontSansBold, color: colPrimary });

          const boxW = (W - 120) / 2;
          const boxH = 140;
          const boxY = 150;

          // Student Box
          page.drawRectangle({ x: 50, y: boxY, width: boxW, height: boxH, color: colWhite, borderColor: colBorder, borderWidth: 1 });
          page.drawText('STUDENT DETAILS', { x: 65, y: boxY + boxH - 22, size: 9, font: fontSansBold, color: colPrimary });
          page.drawLine({ start: { x: 65, y: boxY + boxH - 28 }, end: { x: 50 + boxW - 15, y: boxY + boxH - 28 }, thickness: 0.5, color: colBorder });
          let sY = boxY + boxH - 46;
          for (const st of s.students.slice(0, 4)) {
            page.drawText(st.name || 'Student Name', { x: 65, y: sY, size: 10.5, font: fontSansBold, color: colDark });
            if (st.id) {
              drawRightText(page, fontSans, st.id, 50 + boxW - 15, sY, 9.5, colSecondary);
            }
            sY -= 18;
          }

          // Instructor Box
          const insX = 50 + boxW + 20;
          page.drawRectangle({ x: insX, y: boxY, width: boxW, height: boxH, color: colWhite, borderColor: colBorder, borderWidth: 1 });
          page.drawText('EVALUATED BY', { x: insX + 15, y: boxY + boxH - 22, size: 9, font: fontSansBold, color: colPrimary });
          page.drawLine({ start: { x: insX + 15, y: boxY + boxH - 28 }, end: { x: insX + boxW - 15, y: boxY + boxH - 28 }, thickness: 0.5, color: colBorder });
          page.drawText(teacherNameText, { x: insX + 15, y: boxY + boxH - 46, size: 11, font: fontSansBold, color: colDark });
          page.drawText(teacherTitleText, { x: insX + 15, y: boxY + boxH - 62, size: 9.5, font: fontSans, color: colSecondary });
          if (deptText) {
            page.drawText(deptText, { x: insX + 15, y: boxY + boxH - 77, size: 9, font: fontSans, color: colMuted });
          }

          // Bottom Date Card
          page.drawRectangle({ x: 50, y: 90, width: W - 100, height: 35, color: colSoft, borderColor: colBorder, borderWidth: 1 });
          page.drawText(`Date: ${s.date || ''}`, { x: 70, y: 103, size: 9.5, font: fontSansBold, color: colDark });
          if (termText) {
            drawRightText(page, fontSans, termText, W - 70, 103, 9.5, colSecondary);
          }

        } else if (template === 'elegant') {
          // 4. ELEGANT ORNAMENTAL FRAME TEMPLATE
          page.drawRectangle({ x: 28, y: 28, width: W - 56, height: H - 56, borderColor: colPrimary, borderWidth: 2 });
          page.drawRectangle({ x: 36, y: 36, width: W - 72, height: H - 72, borderColor: colBorder, borderWidth: 0.75 });

          let curY = H - 85;
          if (embeddedLogo) {
