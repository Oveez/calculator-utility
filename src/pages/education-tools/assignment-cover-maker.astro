  <!-- Load local self-hosted pdf-lib bundle for instant zero-latency client-side vector PDF compilation -->
  <script is:inline src="/js/pdf-lib.min.js"></script>

  <!-- Assignment Cover Maker Client Logic & Template Engine -->
  <script is:inline>
    (function () {
      const appRoot = document.querySelector('[data-cover-maker-app]');
      if (!appRoot) return;

      // Resilient PDFLib getter
      function getPDFLib() {
        if (typeof window.PDFLib !== 'undefined') {
          return Promise.resolve(window.PDFLib);
        }
        return new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = '/js/pdf-lib.min.js';
          s.onload = () => {
            if (typeof window.PDFLib !== 'undefined') resolve(window.PDFLib);
            else reject(new Error('PDFLib object not available after script load'));
          };
          s.onerror = () => {
            const cdn = document.createElement('script');
            cdn.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js';
            cdn.onload = () => {
              if (typeof window.PDFLib !== 'undefined') resolve(window.PDFLib);
              else reject(new Error('PDFLib object not available after CDN load'));
            };
            cdn.onerror = () => reject(new Error('Failed to load vector PDF library. Please check your internet connection.'));
            document.head.appendChild(cdn);
          };
          document.head.appendChild(s);
        });
      }

      // ==========================================
      // VECTOR PDF COMPILER (A4 595.28 x 841.89 pt)
      // Real Selectable Text & Sharp Vector Primitives
      // ==========================================
      function hexToRgbColor(PDFLib, hex, fallback = { r: 0.1, g: 0.1, b: 0.1 }) {
        if (!hex || typeof hex !== 'string') return PDFLib.rgb(fallback.r, fallback.g, fallback.b);
        const cleaned = hex.replace('#', '');
        if (cleaned.length === 6) {
          const r = parseInt(cleaned.substring(0, 2), 16) / 255;
          const g = parseInt(cleaned.substring(2, 4), 16) / 255;
          const b = parseInt(cleaned.substring(4, 6), 16) / 255;
          return PDFLib.rgb(r, g, b);
        }
        return PDFLib.rgb(fallback.r, fallback.g, fallback.b);
      }

      // Academic Title Case Engine (preserves prepositions/articles in lowercase)
      const LOWERCASE_TITLE_WORDS = new Set([
        // Articles
        'a', 'an', 'the',
        // Coordinating Conjunctions
        'and', 'but', 'or', 'nor', 'for', 'yet', 'so',
        // Prepositions
        'about', 'above', 'across', 'after', 'against', 'along', 'among', 'around', 'at',
        'before', 'behind', 'below', 'beneath', 'beside', 'between', 'beyond', 'by',
        'down', 'during', 'except', 'for', 'from', 'in', 'inside', 'into', 'like',
        'near', 'of', 'off', 'on', 'onto', 'out', 'outside', 'over', 'past', 'round',
        'since', 'through', 'throughout', 'till', 'to', 'toward', 'towards', 'under',
        'underneath', 'until', 'unto', 'up', 'upon', 'with', 'within', 'without',
        'as', 'per', 'via'
      ]);

      function toAcademicTitleCase(str) {
        if (!str || typeof str !== 'string') return '';
        return str.replace(/([^\s:—–-]+)/g, (match, word, offset) => {
          const lower = word.toLowerCase();
          const prevSub = str.slice(0, offset).trim();
          const prevChar = prevSub.length > 0 ? prevSub.charAt(prevSub.length - 1) : '';
          const isFirstWord = offset === 0 || prevChar === ':' || prevChar === '—' || prevChar === '–';
          const remaining = str.slice(offset + word.length).trim();
          const isLastWord = remaining.length === 0;

          // Preserve uppercase acronyms (e.g. MIS, CSE, BBA, AI, IT, II, III, IV) or internal caps (e.g. PhD, B.Sc.)
          if (word.length > 1 && !LOWERCASE_TITLE_WORDS.has(lower)) {
            if (word === word.toUpperCase() || /[a-z][A-Z]/.test(word) || /\.[A-Z]/.test(word)) {
              return word;
            }
          }

          // Do not capitalize prepositions, articles, conjunctions unless first or last word
          if (!isFirstWord && !isLastWord && LOWERCASE_TITLE_WORDS.has(lower)) {
            return lower;
          }

          // Capitalize first character
          let capitalized = lower.charAt(0).toUpperCase() + lower.slice(1);

          // Handle special name prefixes: O'Connor, D'Angelo, McDonald
          if (/^[OD]['’][a-z]/i.test(capitalized)) {
            capitalized = capitalized.slice(0, 2) + capitalized.charAt(2).toUpperCase() + capitalized.slice(3);
          } else if (/^Mc[a-z]/i.test(capitalized)) {
            capitalized = capitalized.slice(0, 2) + capitalized.charAt(2).toUpperCase() + capitalized.slice(3);
          }

          return capitalized;
        });
      }

      function getFormattedData(s = state) {
        if (!s) return s;
        return {
          ...s,
          institution: toAcademicTitleCase(s.institution),
          department: toAcademicTitleCase(s.department),
          title: toAcademicTitleCase(s.title),
          subtitle: toAcademicTitleCase(s.subtitle),
          courseName: toAcademicTitleCase(s.courseName),
          teacherName: toAcademicTitleCase(s.teacherName),
          teacherTitle: toAcademicTitleCase(s.teacherTitle),
          term: toAcademicTitleCase(s.term),
          students: (s.students || []).map(st => ({
            ...st,
            name: toAcademicTitleCase(st.name),
            section: toAcademicTitleCase(st.section)
          }))
        };
      }

      function wrapText(font, text, size, maxWidth) {
        if (!text) return [];
        const words = text.split(' ');
        const lines = [];
        let currentLine = words[0] || '';
        for (let i = 1; i < words.length; i++) {
          const testLine = currentLine + ' ' + words[i];
          const width = font.widthOfTextAtSize(testLine, size);
          if (width <= maxWidth) {
            currentLine = testLine;
          } else {
            lines.push(currentLine);
            currentLine = words[i];
          }
        }
        if (currentLine) lines.push(currentLine);
        return lines;
      }

      function drawCenteredTextAt(page, font, text, centerX, y, size, color, maxWidth = 500) {
        if (!text) return y;
        const lines = wrapText(font, text, size, maxWidth);
        const lineHeight = size * 1.35;
        let currentY = y;
        for (const line of lines) {
          const width = font.widthOfTextAtSize(line, size);
          page.drawText(line, {
            x: centerX - (width / 2),
            y: currentY,
            size,
            font,
            color
          });
          currentY -= lineHeight;
        }
        return currentY;
      }

      function drawCenteredText(page, font, text, y, size, color, maxWidth = 500) {
        return drawCenteredTextAt(page, font, text, 595.28 / 2, y, size, color, maxWidth);
      }

      function drawLeftText(page, font, text, x, y, size, color, maxWidth = 400) {
        if (!text) return y;
        const lines = wrapText(font, text, size, maxWidth);
        const lineHeight = size * 1.35;
        let currentY = y;
        for (const line of lines) {
          page.drawText(line, {
            x,
            y: currentY,
            size,
            font,
            color
          });
          currentY -= lineHeight;
        }
        return currentY;
      }

      function drawRightText(page, font, text, rightX, y, size, color) {
        if (!text) return;
        const width = font.widthOfTextAtSize(text, size);
        page.drawText(text, {
          x: rightX - width,
          y,
          size,
          font,
          color
        });
      }

      async function renderVectorCoverPdf(PDFLib, state, theme, logoPngBytes = null) {
        const pdfDoc = await PDFLib.PDFDocument.create();
        const page = pdfDoc.addPage([595.28, 841.89]); // Standard A4 in points
        const W = 595.28;
        const H = 841.89;

        const fontSerif = await pdfDoc.embedFont(PDFLib.StandardFonts.TimesRoman);
        const fontSerifBold = await pdfDoc.embedFont(PDFLib.StandardFonts.TimesRomanBold);
        const fontSerifItalic = await pdfDoc.embedFont(PDFLib.StandardFonts.TimesRomanItalic);
        const fontSans = await pdfDoc.embedFont(PDFLib.StandardFonts.Helvetica);
        const fontSansBold = await pdfDoc.embedFont(PDFLib.StandardFonts.HelveticaBold);

        const colPrimary = hexToRgbColor(PDFLib, theme.primary, { r: 0.06, g: 0.09, b: 0.16 });
        const colSecondary = hexToRgbColor(PDFLib, theme.secondary, { r: 0.2, g: 0.25, b: 0.35 });
        const colSoft = hexToRgbColor(PDFLib, theme.soft, { r: 0.97, g: 0.98, b: 0.99 });
        const colBorder = hexToRgbColor(PDFLib, theme.border, { r: 0.8, g: 0.83, b: 0.88 });
        const colMuted = PDFLib.rgb(0.4, 0.45, 0.5);
        const colDark = PDFLib.rgb(0.06, 0.09, 0.16);
        const colWhite = PDFLib.rgb(1, 1, 1);

        let embeddedLogo = null;
        if (logoPngBytes && state.logoMode !== 'none') {
          try {
            embeddedLogo = await pdfDoc.embedPng(logoPngBytes);
          } catch (e) {
            console.warn('Could not embed PNG logo:', e);
          }
        }

        const s = getFormattedData(state);
        const instText = (s.institution || 'INSTITUTION NAME').toUpperCase();
        const deptText = s.department || 'Department / Faculty';
        const titleText = s.title || 'Assignment Title';
        const subtitleText = s.subtitle || '';
        const courseCodeText = s.courseCode || '';
        const courseNameText = s.courseName || 'Course Name';
        const teacherNameText = s.teacherName || 'Instructor Name';
        const teacherTitleText = s.teacherTitle || 'Designation';
        const dateText = s.date ? `Date of Submission: ${s.date}` : '';
        const termText = s.term || '';

        const template = s.template || 'classic';

        if (template === 'modern') {
          // 2. MODERN MINIMAL TEMPLATE
          const topY = H - 55;
          const maxLogoW = 110;
          const maxLogoH = 50;

          if (embeddedLogo) {
            const aspect = embeddedLogo.width / embeddedLogo.height;
            let actualLogoW = maxLogoW;
            let actualLogoH = maxLogoW / aspect;
            if (actualLogoH > maxLogoH) {
              actualLogoH = maxLogoH;
              actualLogoW = maxLogoH * aspect;
            }
            page.drawImage(embeddedLogo, {
              x: W - 55 - actualLogoW,
              y: topY - actualLogoH,
              width: actualLogoW,
              height: actualLogoH
            });
          }

          page.drawText(instText, { x: 55, y: topY - 14, size: 14, font: fontSansBold, color: colPrimary });
          page.drawText(deptText, { x: 55, y: topY - 30, size: 10, font: fontSans, color: colMuted });

          const lineY = topY - 62;
          page.drawLine({ start: { x: 55, y: lineY }, end: { x: W - 55, y: lineY }, thickness: 2, color: colPrimary });

          const titleStartY = lineY - 80;
          if (courseCodeText) {
            const codeWidth = fontSansBold.widthOfTextAtSize(courseCodeText, 9.5);
            page.drawRectangle({
              x: 55,
              y: titleStartY,
              width: codeWidth + 18,
              height: 20,
              color: colSoft,
              borderColor: colBorder,
              borderWidth: 1
            });
            page.drawText(courseCodeText, { x: 64, y: titleStartY + 6, size: 9.5, font: fontSansBold, color: colPrimary });
          }

          let tY = titleStartY - 28;
          tY = drawLeftText(page, fontSansBold, titleText, 55, tY, 26, colDark, 480);
          if (subtitleText) {
            tY -= 4;
            tY = drawLeftText(page, fontSans, subtitleText, 55, tY, 12, colMuted, 480);
          }

          const courseBlockY = tY - 35;
          page.drawLine({ start: { x: 55, y: courseBlockY + 28 }, end: { x: 55, y: courseBlockY - 8 }, thickness: 3.5, color: colPrimary });
          page.drawText('COURSE', { x: 68, y: courseBlockY + 16, size: 8, font: fontSansBold, color: colMuted });
          page.drawText(courseNameText, { x: 68, y: courseBlockY, size: 13, font: fontSansBold, color: colDark });

          const botLineY = 210;
          page.drawLine({ start: { x: 55, y: botLineY }, end: { x: W - 55, y: botLineY }, thickness: 1, color: colBorder });

          let prepY = botLineY - 22;
          page.drawText('PREPARED BY', { x: 55, y: prepY, size: 9, font: fontSansBold, color: colPrimary });
          prepY -= 18;
          for (const st of s.students) {
