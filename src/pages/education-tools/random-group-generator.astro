---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Random Group Generator — Divide Class into Teams & Groups · ${siteName}`;
const pageDesc = 'Divide students, workshop participants, and teams into balanced random groups online by number of groups or members per group. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/education-tools/random-group-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Education Tools', href: toAbsoluteUrl('/education-tools/') },
  { label: 'Random Group Generator' },
];

const schemaFaq = [
  {
    question: 'How are participants partitioned into equal groups?',
    answer: 'It applies an unbiased Fisher-Yates shuffle across the participant array using Web Cryptography (`crypto.getRandomValues`) and distributes members evenly across target groups.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Random Group Generator',
    url: canonicalUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-group-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Fisher-Yates Roster Partitioner</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Random Group Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Split student rosters and workshop attendees into balanced groups by group count or group size.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 sm:grid-cols-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="split-by" class="font-bold text-[color:var(--fg)] block mb-1">Group By:</label>
          <select id="split-by" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="groups">Number of Groups</option>
            <option value="size">Members per Group</option>
          </select>
        </div>
        <div>
          <label for="target-num" class="font-bold text-[color:var(--fg)] block mb-1">Target Quantity:</label>
          <input
            type="number"
            id="target-num"
            min="2"
            max="50"
            value="3"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="roster-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Participants Roster (One per line)</label>
          <button type="button" data-sample-btn class="text-xs font-semibold text-[color:var(--primary)] hover:underline">Load Sample</button>
        </div>
        <textarea
          id="roster-in"
          rows="8"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Alice&#10;Bob&#10;Charlie&#10;David"
        >Alexander
Charlotte
Daniel
Harper
James
Isabella
Lucas
Mia
Ethan
Amelia
Benjamin
Evelyn</textarea>
      </div>

      <button
        type="button"
        id="gen-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[color:var(--accent)] py-2.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90 cursor-pointer"
      >
        <Icon name="dice" class="w-4 h-4" />
        <span>Generate Groups</span>
      </button>

      <!-- Groups Grid Display -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated Groups</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Groups</span>
          </button>
        </div>
        <div id="groups-container" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-group-app]');
      if (!root) return;

      const splitBy = root.querySelector('#split-by');
      const targetNum = root.querySelector('#target-num');
      const rosterIn = root.querySelector('#roster-in');
      const genBtn = root.querySelector('#gen-btn');
      const container = root.querySelector('#groups-container');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');

      function shuffle(array) {
        for (let i = array.length - 1; i > 0; i--) {
          const randArr = new Uint32Array(1);
          crypto.getRandomValues(randArr);
          const j = randArr[0] % (i + 1);
          [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
      }

      function generate() {
        const list = rosterIn.value.split('\n').map(s => s.trim()).filter(s => s.length > 0);
        if (list.length === 0) return;

        const shuffled = shuffle([...list]);
        const mode = splitBy.value;
        const target = Math.max(1, parseInt(targetNum.value, 10) || 2);

        let groupCount = mode === 'groups' ? target : Math.ceil(shuffled.length / target);
        groupCount = Math.min(groupCount, shuffled.length);

        const groups = Array.from({ length: groupCount }, () => []);
        shuffled.forEach((person, idx) => {
          groups[idx % groupCount].push(person);
        });

        container.innerHTML = groups.map((grp, idx) => `
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-3">
            <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-2">
              <span class="font-bold text-sm text-[color:var(--fg)]">Group ${idx + 1}</span>
              <span class="text-[10px] rounded-md bg-[color:var(--surface-strong)] px-2 py-0.5 font-mono text-[color:var(--muted)]">${grp.length} members</span>
            </div>
            <ul class="space-y-1 text-xs text-[color:var(--fg)] font-medium">
              ${grp.map(p => `<li>• ${p}</li>`).join('')}
            </ul>
          </div>
        `).join('');
      }

      genBtn.addEventListener('click', generate);

      sampleBtn.addEventListener('click', () => {
        rosterIn.value = `Alice\nBob\nCharlie\nDavid\nEmma\nFrank\nGrace\nHenry\nIsabella\nJack`;
        generate();
      });

      copyBtn.addEventListener('click', () => {
        const text = Array.from(container.children).map(c => {
          const title = c.querySelector('span').textContent;
          const members = Array.from(c.querySelectorAll('li')).map(l => l.textContent).join('\n');
          return `${title}\n${members}`;
        }).join('\n\n');

        if (!text) return;
        navigator.clipboard.writeText(text);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      generate();
    })();
  </script>
</SiteLayout>
