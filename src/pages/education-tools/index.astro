---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHero from '../../components/SiteHero.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Education & Classroom Tools | Group Generator, Student Picker, Seating Charts · ${siteName}`;
const pageDesc = 'Free classroom and study productivity tools for teachers and students. Pick random students, generate balanced groups and teams, build classroom seating charts, and create study timetables.';
const canonicalUrl = toAbsoluteUrl('/education-tools/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Education Tools' },
];

const eduToolsList = [
  {
    slug: 'assignment-cover-maker',
    title: 'Assignment Cover Page Maker',
    badge: 'Featured • PDF',
    metaDescription: 'Create professional university assignment covers instantly. Choose from 5 academic templates, custom color themes, search thousands of institutions, and generate a print-ready A4 PDF.',
    href: withBasePath('/education-tools/assignment-cover-maker/'),
    icon: 'education',
  },
  {
    slug: 'random-student-picker',
    title: 'Random Student Picker',
    badge: 'Popular',
    metaDescription: 'Pick a random student name fairly with animated selection, sound toggle, and remove-after-drawn mode.',
    href: withBasePath('/education-tools/random-student-picker/'),
    icon: 'education',
  },
  {
    slug: 'random-group-generator',
    title: 'Random Group Generator',
    badge: 'Classroom',
    metaDescription: 'Divide class rosters and student lists into balanced small groups by group count or group size.',
    href: withBasePath('/education-tools/random-group-generator/'),
    icon: 'education',
  },
  {
    slug: 'random-team-generator',
    title: 'Random Team Generator',
    badge: 'Sports / Projects',
    metaDescription: 'Split participants into 2, 3, 4 or more balanced teams with custom team names and exportable rosters.',
    href: withBasePath('/education-tools/random-team-generator/'),
    icon: 'education',
  },
  {
    slug: 'seating-chart-generator',
    title: 'Classroom Seating Chart Generator',
    badge: 'Layout',
    metaDescription: 'Create interactive grid-based classroom seating charts with randomized student desk assignments.',
    href: withBasePath('/education-tools/seating-chart-generator/'),
    icon: 'education',
  },
  {
    slug: 'exam-seating-generator',
    title: 'Exam Hall Seating Generator',
    badge: 'Exams',
    metaDescription: 'Generate randomized examination hall desk layouts with alternating empty desks to prevent cheating.',
    href: withBasePath('/education-tools/exam-seating-generator/'),
    icon: 'education',
  },
  {
    slug: 'study-schedule-generator',
    title: 'Study Schedule & Timetable Generator',
    badge: 'Productivity',
    metaDescription: 'Build structured daily and weekly revision timetables based on subject priorities and available study hours.',
    href: withBasePath('/education-tools/study-schedule-generator/'),
    icon: 'education',
  },
];

const schemaFaq = [
  {
    question: 'Are student names or classroom rosters stored anywhere?',
    answer: 'No. All roster shuffling, student picking, and seating chart generation run 100% locally in your browser memory. Student data is never uploaded to any server or database.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl} heroCompact={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <SiteHero
    slot="hero"
    breadcrumbs={breadcrumbItems}
    badge="Teacher &amp; Student Productivity Suite"
    title="Education &amp; Classroom Tools"
    description="Pick random students fairly, divide classrooms into balanced groups, design desk seating charts, and organize study schedules."
  />

  <article class="space-y-10 py-2">

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Directory</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">6 In-Browser Classroom Engines</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          6 Tools
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {eduToolsList.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
            data-calculator-card
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon slug={tool.slug} category="Education" size="md" />
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2.5 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center justify-between pt-2.5 border-t border-[color:var(--border)]/60">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                <span>Open Tool</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
              </span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--muted)] group-hover:text-[color:var(--fg)] transition-colors">Instant</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
