---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Exam Seating Arrangement Generator — Anti-Cheating Layout Maker · ${siteName}`;
const pageDesc = 'Generate examination hall seating arrangements with alternating empty spacing, randomized student roll numbers, and anti-cheating patterns.';
const canonicalUrl = toAbsoluteUrl('/education-tools/exam-seating-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Education Tools', href: toAbsoluteUrl('/education-tools/') },
  { label: 'Exam Seating Generator' },
];

const schemaFaq = [
  {
    question: 'How does alternating exam seating prevent cheating?',
    answer: 'It assigns students to every other desk in a checkerboard or spaced column pattern, maximizing physical separation between adjacent examinees.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Exam Seating Arrangement Generator',
    url: canonicalUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-exam-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Anti-Cheating Examination Hall Designer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Exam Seating Arrangement Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate randomized exam hall seating layouts with alternating gap spacing to prevent cheating.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 sm:grid-cols-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="exam-rows" class="font-bold text-[color:var(--fg)] block mb-1">Hall Rows:</label>
          <input
            type="number"
            id="exam-rows"
            min="2"
            max="12"
            value="5"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="exam-cols" class="font-bold text-[color:var(--fg)] block mb-1">Hall Columns:</label>
          <input
            type="number"
            id="exam-cols"
            min="2"
            max="12"
            value="6"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="spacing-mode" class="font-bold text-[color:var(--fg)] block mb-1">Spacing Mode:</label>
          <select id="spacing-mode" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="checkerboard">Checkerboard (Every Other Seat)</option>
            <option value="sequential">Sequential (Fill Every Desk)</option>
          </select>
        </div>
      </div>

      <div class="space-y-2">
        <label for="students-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Candidate Roll Numbers / Names (One per line)</label>
        <textarea
          id="students-in"
          rows="6"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Roll No 101&#10;Roll No 102"
        >ROLL-101
ROLL-102
ROLL-103
ROLL-104
ROLL-105
ROLL-106
ROLL-107
ROLL-108
ROLL-109
ROLL-110
ROLL-111
ROLL-112
ROLL-113
ROLL-114
ROLL-115</textarea>
      </div>

      <button
        type="button"
        id="gen-exam-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 cursor-pointer"
      >
        <Icon name="education" class="w-4 h-4" />
        <span>Generate Exam Hall Layout</span>
      </button>

      <!-- Grid Visualizer -->
      <div class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8">
        <div class="rounded-xl bg-[color:var(--surface-strong)] py-2 text-center text-xs font-bold text-[color:var(--muted)] uppercase tracking-wider">
          Invigilator Stage / Board
        </div>

        <div id="grid-container" class="grid gap-2.5 pt-4"></div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-exam-app]');
      if (!root) return;

      const rowsIn = root.querySelector('#exam-rows');
      const colsIn = root.querySelector('#exam-cols');
      const spacing = root.querySelector('#spacing-mode');
      const studentsIn = root.querySelector('#students-in');
      const genBtn = root.querySelector('#gen-exam-btn');
      const grid = root.querySelector('#grid-container');

      function shuffle(array) {
        for (let i = array.length - 1; i > 0; i--) {
          const randArr = new Uint32Array(1);
          crypto.getRandomValues(randArr);
          const j = randArr[0] % (i + 1);
          [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
      }

      function generate() {
        const rows = Math.min(12, Math.max(2, parseInt(rowsIn.value, 10) || 5));
        const cols = Math.min(12, Math.max(2, parseInt(colsIn.value, 10) || 6));
        const isChecker = spacing.value === 'checkerboard';
        const candidates = shuffle(studentsIn.value.split('\n').map(s => s.trim()).filter(s => s.length > 0));

        grid.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`;

        let studentIdx = 0;
        const cells = [];

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const isSeatAllowed = isChecker ? (r + c) % 2 === 0 : true;

            if (isSeatAllowed && studentIdx < candidates.length) {
              const name = candidates[studentIdx++];
              cells.push(`
                <div class="flex flex-col items-center justify-center rounded-xl border border-emerald-500/40 bg-cyan-500/10 p-2.5 text-center">
                  <span class="text-[9px] font-mono text-cyan-600 dark:text-cyan-400 dark:text-cyan-400 font-bold">Desk R${r+1}C${c+1}</span>
                  <span class="text-xs font-extrabold text-[color:var(--fg)] truncate w-full mt-0.5">${name}</span>
                </div>
              `);
            } else {
              cells.push(`
                <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-[color:var(--border)] bg-[color:var(--surface-strong)]/40 p-2.5 text-center opacity-30">
                  <span class="text-[9px] font-mono text-[color:var(--muted)]">R${r+1}C${c+1}</span>
                  <span class="text-[10px] italic text-[color:var(--muted)]">Empty</span>
                </div>
              `);
            }
          }
        }

        grid.innerHTML = cells.join('');
      }

      genBtn.addEventListener('click', generate);
      generate();
    })();
  </script>
</SiteLayout>
