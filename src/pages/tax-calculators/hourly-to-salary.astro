---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AdSlot from '../../components/tax/AdSlot.astro';
import TaxDisclaimer from '../../components/tax/TaxDisclaimer.astro';
import CountryTaxSelector from '../../components/tax/CountryTaxSelector.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import Icon from '../../components/Icon.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';

const parameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'hourlyRate',
    name: 'Hourly Pay Rate ($/hr)',
    description: 'Contracted or statutory wage earned per hour of standard regular employment.',
    whyItMatters: 'The base pricing rate from which all straight-time and overtime earnings are calculated.',
    typicalRange: '$15.00 – $150.00+/hr',
    unit: '$/hr',
  },
  {
    id: 'regHours',
    name: 'Regular Weekly Hours',
    description: 'Number of standard, non-overtime working hours scheduled per week (standard full-time is 40 hours).',
    whyItMatters: 'Determines the straight-time annual wage foundation before premium rates apply.',
    typicalRange: '20 – 40 hrs/wk',
    unit: 'hours',
  },
  {
    id: 'otHours',
    name: 'Overtime (1.5x) Weekly Hours',
    description: 'Hours worked in excess of standard regular hours, compensated at time-and-a-half (1.5x pay rate).',
    whyItMatters: 'Generates premium overtime earnings under the US Fair Labor Standards Act (FLSA) and employment statutes.',
    typicalRange: '0 – 20 hrs/wk',
    unit: 'hours',
  },
  {
    id: 'workWeeks',
    name: 'Paid Weeks Per Year',
    description: 'Total number of paid working weeks per calendar year (52 weeks for standard salaried full-year roles).',
    whyItMatters: 'Accounts for unpaid time off, seasonal contracts, or academic schedules.',
    typicalRange: '48 – 52 weeks',
    unit: 'weeks',
  },
  {
    id: 'annualTotal',
    name: 'Total Annual Gross Salary',
    description: 'Sum of all straight-time regular wages plus overtime compensation earned across the year.',
    whyItMatters: 'The top-line gross income figure needed for tax filings, loan applications, and employment negotiations.',
    typicalRange: 'Base Pay + OT Pay',
    unit: '$',
  },
];
---

<SiteLayout
  title="Hourly to Salary Calculator with Overtime Pay | Free Wage Tool"
  description="Calculate your annual salary from your hourly wage, including overtime hours (1.5x time-and-a-half) and double time (2.0x)."
>
  <div class="mx-auto max-w-4xl space-y-10">
    <nav class="flex items-center gap-2 text-xs font-medium text-[color:var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <a href="/tax-calculators/" class="hover:text-[color:var(--accent)]">Tax Calculators</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Hourly to Salary</span>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Hourly Wage &amp; Overtime Tool</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Hourly to Salary Calculator
      </h1>
      <p class="text-base text-[color:var(--muted)]">
        Compute your total annual earnings, regular wages, and overtime compensation based on your hourly pay rate.
      </p>
    </header>

    <AdSlot slotId="hourly-salary-top" position="top" />

    <div class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10" data-hourly-app>
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="space-y-4">
          <div>
            <label for="hourly-rate-input" class="block text-sm font-bold text-[color:var(--fg)]">
              Hourly Pay Rate ($/hr)
            </label>
            <div class="relative mt-2">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-base font-bold text-[color:var(--muted)]">$</span>
              <input
                id="hourly-rate-input"
                type="number"
                min="0"
                step="0.5"
                placeholder="e.g. 35"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-3.5 pl-10 pr-4 text-xl font-extrabold text-[color:var(--fg)] shadow-inner outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                data-hourly-rate />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="reg-hours-input" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Regular Hours / Week
              </label>
              <input
                id="reg-hours-input"
                type="number"
                min="1"
                max="80"
                value="40"
                class="mt-1.5 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 text-sm font-bold text-[color:var(--fg)] outline-none"
                data-reg-hours />
            </div>
            <div>
              <label for="ot-hours-input" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Overtime (1.5x) Hrs / Week
              </label>
              <input
                id="ot-hours-input"
                type="number"
                min="0"
                max="40"
                value="0"
                class="mt-1.5 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 text-sm font-bold text-[color:var(--fg)] outline-none"
                data-ot-hours />
            </div>
          </div>

          <div>
            <label for="work-weeks-input" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Paid Weeks / Year
            </label>
            <input
              id="work-weeks-input"
              type="number"
              min="1"
              max="52"
              value="52"
              class="mt-1.5 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 text-sm font-bold text-[color:var(--fg)] outline-none"
              data-work-weeks />
          </div>
        </div>

        <!-- Output Card -->
        <div class="rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] to-transparent p-6 shadow-sm sm:p-8 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--accent)]">Total Annual Gross Salary</p>
              <p class="mt-1 text-4xl font-extrabold text-[color:var(--fg)] sm:text-5xl" data-total-salary>$0.00</p>
              <p class="text-xs text-[color:var(--muted)]">Including overtime compensation</p>
            </div>
            <button
              type="button"
              data-copy-btn
              class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
            >
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy Summary</span>
            </button>
          </div>

          <div class="space-y-2.5 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
            <div class="flex items-center justify-between text-[color:var(--muted)]">
              <span>Base Regular Pay / Year:</span>
              <span class="font-bold text-[color:var(--fg)]" data-base-pay>$0.00</span>
            </div>
            <div class="flex items-center justify-between text-amber-500 font-bold">
              <span>Overtime Earnings / Year:</span>
              <span data-ot-pay>+$0.00</span>
            </div>
            <div class="flex items-center justify-between text-[color:var(--muted)] border-t border-[color:var(--border)] pt-2">
              <span>Monthly Gross Pay:</span>
              <span class="font-bold text-[color:var(--fg)]" data-monthly-gross>$0.00</span>
            </div>
            <div class="flex items-center justify-between text-[color:var(--muted)]">
              <span>Weekly Gross Pay:</span>
              <span class="font-bold text-[color:var(--fg)]" data-weekly-gross>$0.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formulas Reference Card -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4">
      <h2 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Mathematical Wage Formulas</span>
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm text-[color:var(--muted)]">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-subtle)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Straight-Time &amp; Overtime Wage Calculations</p>
          <p class="font-mono text-xs text-cyan-500 dark:text-cyan-400">Regular Annual = Hourly Rate × Regular Hours/Week × Weeks</p>
          <p class="font-mono text-xs text-amber-500">Overtime Annual = Hourly Rate × 1.5 × OT Hours/Week × Weeks</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Total Annual Salary = Regular Annual + Overtime Annual</p>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-subtle)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Periodic Pay Breakdown</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Monthly Gross = Total Annual Salary ÷ 12</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Bi-Weekly Gross = Total Annual Salary ÷ 26</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Weekly Gross = Total Annual Salary ÷ Weeks</p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4">
      <h2 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Step-by-Step Worked Example</span>
      </h2>
      <div class="space-y-3 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        <p>
          Consider an employee earning <strong class="text-[color:var(--fg)]">$35.00 per hour</strong> with 40 regular hours and 5 overtime hours per week across 52 working weeks:
        </p>
        <ol class="list-decimal pl-5 space-y-2">
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Straight-Time Regular Pay:</strong><br />
            Weekly Regular = $35.00 × 40 hrs = $1,400.00/wk.<br />
            Annual Regular Pay = $1,400.00 × 52 weeks = <strong class="text-[color:var(--fg)] font-mono">$72,800.00</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Overtime (Time-and-a-Half) Pay:</strong><br />
            OT Hourly Rate = $35.00 × 1.5 = $52.50/hr.<br />
            Weekly OT = $52.50 × 5 hrs = $262.50/wk.<br />
            Annual Overtime Pay = $262.50 × 52 weeks = <strong class="text-amber-500 font-bold font-mono">+$13,650.00</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Total Annual Gross Earnings:</strong><br />
            $72,800.00 + $13,650.00 = <strong class="text-cyan-500 dark:text-cyan-400 font-bold text-base">$86,450.00</strong> ($7,204.17/month or $1,662.50/week).
          </li>
        </ol>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <CountryTaxSelector compact={true} title="Calculate Taxes on this Salary" />
    <TaxDisclaimer />
  </div>
</SiteLayout>

<script>
  (function () {
    const app = document.querySelector('[data-hourly-app]');
    if (!app) return;

    const rateInput = app.querySelector('[data-hourly-rate]') as HTMLInputElement | null;
    const regInput = app.querySelector('[data-reg-hours]') as HTMLInputElement | null;
    const otInput = app.querySelector('[data-ot-hours]') as HTMLInputElement | null;
    const weeksInput = app.querySelector('[data-work-weeks]') as HTMLInputElement | null;

    const totalSalaryEl = app.querySelector('[data-total-salary]');
    const basePayEl = app.querySelector('[data-base-pay]');
    const otPayEl = app.querySelector('[data-ot-pay]');
    const monthlyGrossEl = app.querySelector('[data-monthly-gross]');
    const weeklyGrossEl = app.querySelector('[data-weekly-gross]');
    const copyBtn = app.querySelector('[data-copy-btn]');

    function fmt(val: number) {
      return '$' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function calculate() {
      const rate = Math.max(0, parseFloat(rateInput?.value || '0') || 0);
      const regHours = Math.max(0, parseFloat(regInput?.value || '0') || 0);
      const otHours = Math.max(0, parseFloat(otInput?.value || '0') || 0);
      const weeks = Math.max(1, parseFloat(weeksInput?.value || '52') || 52);

      const weeklyBase = rate * regHours;
      const weeklyOT = rate * 1.5 * otHours;
      const totalWeekly = weeklyBase + weeklyOT;

      const annualBase = weeklyBase * weeks;
      const annualOT = weeklyOT * weeks;
      const annualTotal = totalWeekly * weeks;

      if (totalSalaryEl) totalSalaryEl.textContent = fmt(annualTotal);
      if (basePayEl) basePayEl.textContent = fmt(annualBase);
      if (otPayEl) otPayEl.textContent = '+' + fmt(annualOT);
      if (monthlyGrossEl) monthlyGrossEl.textContent = fmt(annualTotal / 12);
      if (weeklyGrossEl) weeklyGrossEl.textContent = fmt(totalWeekly);
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = [
          'Hourly to Salary Wage Summary',
          '--------------------------------',
          `Hourly Rate: $${rateInput?.value || '0'}/hr`,
          `Regular Hours/Week: ${regInput?.value || '0'} hrs`,
          `Overtime Hours/Week: ${otInput?.value || '0'} hrs`,
          `Paid Weeks/Year: ${weeksInput?.value || '0'} wks`,
          '--------------------------------',
          `Base Regular Pay: ${basePayEl?.textContent}`,
          `Overtime Earnings: ${otPayEl?.textContent}`,
          `Total Annual Gross Salary: ${totalSalaryEl?.textContent}`,
          `Monthly Gross Pay: ${monthlyGrossEl?.textContent}`,
          `Weekly Gross Pay: ${weeklyGrossEl?.textContent}`,
        ].join('\n');

        navigator.clipboard.writeText(text).then(() => {
          const orig = copyBtn.textContent;
          copyBtn.textContent = '✓ Copied!';
          setTimeout(() => { copyBtn.textContent = orig; }, 2000);
        });
      });
    }

    rateInput?.addEventListener('input', calculate);
    regInput?.addEventListener('input', calculate);
    otInput?.addEventListener('input', calculate);
    weeksInput?.addEventListener('input', calculate);

    calculate();
  })();
</script>

