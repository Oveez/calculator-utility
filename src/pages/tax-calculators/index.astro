---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CountryTaxSelector from '../../components/tax/CountryTaxSelector.astro';
import AdSlot from '../../components/tax/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
---

<SiteLayout
  title="International Tax & Salary Calculators 2026/2027 | 24 Countries"
  description="Comprehensive international tax and salary calculators for 24 priority countries. Accurate progressive tax brackets, social contributions, take-home pay, and VAT/GST tools."
>
  <div class="mx-auto max-w-5xl space-y-8">
    <!-- Breadcrumb & Header -->
    <nav class="flex items-center gap-2 text-xs font-medium text-[color:var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--fg)]">Home</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Tax Calculators Hub</span>
    </nav>

    <!-- Header Banner -->
    <header class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1 text-xs font-bold text-[color:var(--fg)]">
        <span>Verified Official Data • 24 Countries • 2026/2027 Tax Years</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-[color:var(--fg)] sm:text-3xl lg:text-4xl">
        International Tax &amp; Financial Calculators
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
        Accurate, high-precision salary, income tax, and consumption tax calculators. Powered by verified official data from national revenue authorities (IRS, CRA, HMRC, ATO, BZSt, DGFiP, and more).
      </p>
    </header>

    <AdSlot slotId="tax-hub-top" position="top" />

    <!-- Feature Categories Grid -->
    <section class="space-y-4">
      <div class="space-y-0.5">
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Specialized Tax Engines</p>
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-[color:var(--fg)]">Global Tax &amp; Payroll Suites</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- VAT / GST Tool -->
        <a
          href="/tax-calculators/vat-calculator/"
          class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
        >
          <div class="space-y-2.5">
            <ToolIcon slug="vat-calculator" category="Tax & Finance" size="md" />
            <h3 class="text-base font-bold text-[color:var(--fg)]">
              Global VAT &amp; GST Calculator
            </h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">
              Calculate price before/after tax, add or remove VAT/GST with preset rates for 24+ countries.
            </p>
          </div>
          <div class="mt-5 flex items-center gap-1 text-xs font-bold text-[color:var(--fg)]">
            <span>Open Tool</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
          </div>
        </a>

        <!-- Salary to Hourly -->
        <a
          href="/tax-calculators/salary-to-hourly/"
          class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
        >
          <div class="space-y-2.5">
            <ToolIcon slug="salary-to-hourly" category="Tax & Finance" size="md" />
            <h3 class="text-base font-bold text-[color:var(--fg)]">
              Salary to Hourly Converter
            </h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">
              Break down annual salary into monthly, bi-weekly, weekly, daily, and hourly wage rates.
            </p>
          </div>
          <div class="mt-5 flex items-center gap-1 text-xs font-bold text-[color:var(--fg)]">
            <span>Open Tool</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
          </div>
        </a>

        <!-- Hourly to Salary -->
        <a
          href="/tax-calculators/hourly-to-salary/"
          class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
        >
          <div class="space-y-2.5">
            <ToolIcon slug="hourly-to-salary" category="Tax & Finance" size="md" />
            <h3 class="text-base font-bold text-[color:var(--fg)]">
              Hourly to Salary &amp; Overtime
            </h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">
              Convert hourly wage to annual income with overtime pay (1.5x time-and-a-half &amp; 2.0x double time).
            </p>
          </div>
          <div class="mt-5 flex items-center gap-1 text-xs font-bold text-[color:var(--fg)]">
            <span>Open Tool</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
          </div>
        </a>
      </div>
    </section>

    <!-- 24 Country Tax Calculators Grid -->
    <CountryTaxSelector
      title="All 24 Supported Country Tax Engines"
      subtitle="Select any country below to compute progressive income tax, social security contributions, and net take-home salary."
    />

    <AdSlot slotId="tax-hub-bottom" position="bottom" />
  </div>
</SiteLayout>
