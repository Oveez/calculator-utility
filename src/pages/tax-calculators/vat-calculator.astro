---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AdSlot from '../../components/tax/AdSlot.astro';
import TaxDisclaimer from '../../components/tax/TaxDisclaimer.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import Icon from '../../components/Icon.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';
import { allCountryTaxProfiles } from '../../data/tax/countries';

const countryVatOptions = allCountryTaxProfiles.map((c) => {
  const defaultYr = c.years[c.defaultTaxYear];
  return {
    id: c.id,
    name: c.name,
    flag: c.flagEmoji,
    currency: c.defaultCurrency,
    symbol: c.defaultCurrencySymbol,
    vatName: defaultYr.vatConfig.name,
    standardRate: Math.round(defaultYr.vatConfig.standardRate * 1000) / 10,
  };
});

const parameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'calcMode',
    name: 'Calculation Mode (Add vs Remove Tax)',
    description: 'Toggle between adding tax to a net base price (Net → Gross) or extracting built-in tax from an inclusive invoice total (Gross → Net).',
    whyItMatters: 'Essential for retail consumers checking pre-tax costs vs business accountants reconciling invoice totals and sales tax filings.',
    typicalRange: 'Add Tax or Remove Tax',
    unit: 'mode',
  },
  {
    id: 'netPrice',
    name: 'Price Excluding Tax (Net Amount)',
    description: 'The baseline price of a product or service before applicable sales tax, VAT, or GST is applied.',
    whyItMatters: 'The vendor’s actual earned revenue before collecting consumption taxes for the tax authority.',
    typicalRange: 'Any positive price',
    unit: 'currency',
  },
  {
    id: 'vatRate',
    name: 'Tax Rate (%)',
    description: 'Statutory percentage of Value Added Tax (VAT), Goods and Services Tax (GST), or Sales Tax imposed by the jurisdiction.',
    whyItMatters: 'Varies by country and category (e.g., UK 20%, EU 19%–25.5%, Australia 10%, Canada 5% federal, Singapore 9%).',
    typicalRange: '0% – 30%',
    unit: '%',
  },
  {
    id: 'taxAmount',
    name: 'Calculated Tax Amount',
    description: 'The exact currency value of tax added or extracted from the transaction.',
    whyItMatters: 'The exact amount that must be remitted to the revenue authority or claimed as an input tax credit.',
    typicalRange: 'Net × Rate',
    unit: 'currency',
  },
  {
    id: 'grossPrice',
    name: 'Total Price Including Tax (Gross Amount)',
    description: 'The final retail price paid by the consumer at checkout, inclusive of all consumption taxes.',
    whyItMatters: 'The out-of-pocket customer cost displayed on retail receipts and invoices.',
    typicalRange: 'Net + Tax',
    unit: 'currency',
  },
];
---

<SiteLayout
  title="Global VAT / GST / Sales Tax Calculator | Add or Remove Tax Online"
  description="Free online VAT, GST, and Sales Tax Calculator. Calculate price before tax, price including tax, and net/gross amounts for 24+ countries with official standard tax rates."
>
  <div class="mx-auto max-w-4xl space-y-10">
    <nav class="flex items-center gap-2 text-xs font-medium text-[color:var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <a href="/tax-calculators/" class="hover:text-[color:var(--accent)]">Tax Calculators</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">VAT &amp; GST Calculator</span>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Multi-Country Consumption Tax Tool</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Global VAT / GST / Sales Tax Calculator
      </h1>
      <p class="text-base text-[color:var(--muted)]">
        Quickly add tax to a net price or remove tax from a gross price. Supports standard rates for UK (20%), EU (19%-25.5%), Australia (10%), Canada (5%), Singapore (9%), and custom tax rates.
      </p>
    </header>

    <AdSlot slotId="vat-top" position="top" />

    <!-- VAT Calculator App Card -->
    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-vat-app
      data-countries-json={JSON.stringify(countryVatOptions)}
    >
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="space-y-6">
          <!-- Calculation Mode Switcher -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Calculation Mode</label>
            <div class="mt-2 grid grid-cols-2 gap-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-1 text-xs font-semibold">
              <button
                type="button"
                class="cursor-pointer rounded-xl bg-[color:var(--accent)] px-3 py-2 text-white shadow-sm transition"
                data-vat-mode="add_tax"
              >
                + Add Tax (Net → Gross)
              </button>
              <button
                type="button"
                class="cursor-pointer rounded-xl px-3 py-2 text-[color:var(--muted)] transition hover:text-[color:var(--fg)]"
                data-vat-mode="remove_tax"
              >
                - Remove Tax (Gross → Net)
              </button>
            </div>
          </div>

          <!-- Country / Preset Rate Selector -->
          <div>
            <label for="vat-country-select" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Select Country Preset Rate
            </label>
            <select
              id="vat-country-select"
              class="mt-2 w-full cursor-pointer rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-sm font-semibold text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
              data-vat-country
            >
              <option value="custom">Custom Tax Rate</option>
              {countryVatOptions.map((opt) => (
                <option value={opt.id} data-rate={opt.standardRate} data-symbol={opt.symbol} data-currency={opt.currency} selected={opt.id === 'uk'}>
                  {opt.flag} {opt.name} ({opt.vatName} {opt.standardRate}%)
                </option>
              ))}
            </select>
          </div>

          <!-- Amount Input -->
          <div>
            <label for="vat-amount-input" class="block text-sm font-bold text-[color:var(--fg)]" data-amount-label>
              Price Excluding Tax (Net Amount)
            </label>
            <div class="relative mt-2">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-base font-bold text-[color:var(--muted)]" data-vat-symbol>
                £
              </span>
              <input
                id="vat-amount-input"
                type="number"
                min="0"
                step="0.01"
                placeholder="e.g. 100"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-3.5 pl-10 pr-4 text-xl font-extrabold text-[color:var(--fg)] shadow-inner outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                data-vat-amount />
            </div>
          </div>

          <!-- Tax Rate % Input -->
          <div>
            <label for="vat-rate-input" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Tax Rate (%)
            </label>
            <div class="relative mt-2">
              <input
                id="vat-rate-input"
                type="number"
                min="0"
                max="100"
                step="0.1"
                value="20"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-3 pl-4 pr-10 text-base font-bold text-[color:var(--fg)] shadow-inner outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                data-vat-rate />
              <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-sm font-bold text-[color:var(--muted)]">
                %
              </span>
            </div>
          </div>
        </div>

        <!-- VAT Result Output Card -->
        <div class="flex flex-col justify-between rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] to-transparent p-6 shadow-sm sm:p-8">
          <div class="space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--accent)]" data-main-result-label>
                  Total Price (Including Tax)
                </p>
                <p class="mt-2 text-4xl font-extrabold text-[color:var(--fg)] sm:text-5xl" data-vat-gross-result>
                  £0.00
                </p>
              </div>
              <button
                type="button"
                data-copy-btn
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </button>
            </div>

            <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-sm">
              <div class="flex items-center justify-between text-[color:var(--muted)]">
                <span>Net Amount (Excl. Tax):</span>
                <span class="font-bold text-[color:var(--fg)]" data-vat-net-result>£0.00</span>
              </div>
              <div class="flex items-center justify-between text-[color:var(--muted)]">
                <span>Tax Rate:</span>
                <span class="font-bold text-[color:var(--fg)]" data-vat-rate-result>20.0%</span>
              </div>
              <div class="border-t border-[color:var(--border)] pt-2 flex items-center justify-between text-rose-500 font-bold">
                <span>Tax Amount:</span>
                <span data-vat-tax-result>+£0.00</span>
              </div>
            </div>
          </div>

          <div class="mt-6 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center text-xs text-[color:var(--muted)]">
            Accurate round-trip arithmetic for accounting, invoicing, and receipts.
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formulas Reference Card -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4">
      <h2 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Mathematical VAT &amp; GST Formulas</span>
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm text-[color:var(--muted)]">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-subtle)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Adding Tax (Net → Gross)</p>
          <p class="font-mono text-xs text-cyan-500 dark:text-cyan-400">Tax Amount = Net Price × (Rate ÷ 100)</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Gross Price = Net Price × (1 + Rate ÷ 100)</p>
          <p class="text-xs">Used when pricing products for retail sale to add mandatory consumption tax.</p>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-subtle)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Extracting Tax (Gross → Net)</p>
          <p class="font-mono text-xs text-amber-500">Net Price = Gross Price ÷ (1 + Rate ÷ 100)</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Tax Amount = Gross Price - Net Price</p>
          <p class="text-xs">Used when reconciling receipts to determine pre-tax base cost and reclaimable tax.</p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Examples -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4">
      <h2 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Step-by-Step Worked Examples</span>
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Example 1: Adding 20% VAT to £100.00 Net</p>
          <ol class="list-decimal pl-4 space-y-1">
            <li>Rate in decimal: 20% ÷ 100 = 0.20.</li>
            <li>Tax Amount: £100.00 × 0.20 = <strong class="text-rose-500">£20.00</strong>.</li>
            <li>Total Gross Price: £100.00 + £20.00 = <strong class="text-cyan-500 dark:text-cyan-400 font-bold">£120.00</strong>.</li>
          </ol>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Example 2: Extracting 20% VAT from £120.00 Gross</p>
          <ol class="list-decimal pl-4 space-y-1">
            <li>Divisor factor: 1 + 0.20 = 1.20.</li>
            <li>Net Base Price: £120.00 ÷ 1.20 = <strong class="text-cyan-500 dark:text-cyan-400 font-bold">£100.00</strong>.</li>
            <li>Tax Extracted: £120.00 - £100.00 = <strong class="text-rose-500 font-bold">£20.00</strong>.</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <TaxDisclaimer />
  </div>
</SiteLayout>

<script>
  (function () {
    const app = document.querySelector('[data-vat-app]');
    if (!app) return;

    const amountInput = app.querySelector('[data-vat-amount]') as HTMLInputElement | null;
    const rateInput = app.querySelector('[data-vat-rate]') as HTMLInputElement | null;
    const countrySelect = app.querySelector('[data-vat-country]') as HTMLSelectElement | null;
    const modeButtons = Array.from(app.querySelectorAll('[data-vat-mode]')) as HTMLElement[];
    const amountLabel = app.querySelector('[data-amount-label]');
    const mainResultLabel = app.querySelector('[data-main-result-label]');
    const symbolEl = app.querySelector('[data-vat-symbol]');

    const grossResultEl = app.querySelector('[data-vat-gross-result]');
    const netResultEl = app.querySelector('[data-vat-net-result]');
    const rateResultEl = app.querySelector('[data-vat-rate-result]');
    const taxResultEl = app.querySelector('[data-vat-tax-result]');
    const copyBtn = app.querySelector('[data-copy-btn]');

    let mode = 'add_tax'; // 'add_tax' or 'remove_tax'
    let currentSymbol = '£';

    function formatVal(val: number) {
      return currentSymbol + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function calculate() {
      const amt = parseFloat(amountInput?.value || '0') || 0;
      const rate = parseFloat(rateInput?.value || '0') || 0;
      const rateDecimal = rate / 100;

      let net = 0;
      let gross = 0;
      let tax = 0;

      if (mode === 'add_tax') {
        net = amt;
        tax = net * rateDecimal;
        gross = net + tax;
      } else {
        gross = amt;
        net = rateDecimal > 0 ? gross / (1 + rateDecimal) : gross;
        tax = gross - net;
      }

      if (grossResultEl) grossResultEl.textContent = formatVal(mode === 'add_tax' ? gross : net);
      if (netResultEl) netResultEl.textContent = formatVal(net);
      if (rateResultEl) rateResultEl.textContent = rate.toFixed(1) + '%';
      if (taxResultEl) taxResultEl.textContent = (mode === 'add_tax' ? '+' : '') + formatVal(tax);
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = [
          'VAT / GST Tax Calculation Summary',
          '---------------------------------',
          `Calculation Mode: ${mode === 'add_tax' ? 'Add Tax (Net → Gross)' : 'Remove Tax (Gross → Net)'}`,
          `Input Amount: ${currentSymbol}${amountInput?.value || '0'}`,
          `Tax Rate: ${rateResultEl?.textContent || '0%'}`,
          '---------------------------------',
          `Net Amount (Excl. Tax): ${netResultEl?.textContent || ''}`,
          `Tax Amount: ${taxResultEl?.textContent || ''}`,
          `Gross Total (Incl. Tax): ${grossResultEl?.textContent || ''}`,
        ].join('\n');

        navigator.clipboard.writeText(text).then(() => {
          const orig = copyBtn.textContent;
          copyBtn.textContent = '✓ Copied!';
          setTimeout(() => { copyBtn.textContent = orig; }, 2000);
        });
      });
    }

    countrySelect?.addEventListener('change', () => {
      const selected = countrySelect.options[countrySelect.selectedIndex];
      if (countrySelect.value !== 'custom') {
        const rate = selected.getAttribute('data-rate');
        const sym = selected.getAttribute('data-symbol') || '$';
        if (rate && rateInput) rateInput.value = rate;
        currentSymbol = sym;
        if (symbolEl) symbolEl.textContent = sym;
      }
      calculate();
    });

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetMode = btn.dataset.vatMode;
        if (targetMode) {
          mode = targetMode;
          modeButtons.forEach((b) => {
            const isActive = b.dataset.vatMode === mode;
            if (isActive) {
              b.className = 'cursor-pointer rounded-xl bg-[color:var(--accent)] px-3 py-2 text-white shadow-sm transition';
            } else {
              b.className = 'cursor-pointer rounded-xl px-3 py-2 text-[color:var(--muted)] transition hover:text-[color:var(--fg)]';
            }
          });

          if (amountLabel) {
            amountLabel.textContent =
              mode === 'add_tax'
                ? 'Price Excluding Tax (Net Amount)'
                : 'Price Including Tax (Gross Amount)';
          }
          if (mainResultLabel) {
            mainResultLabel.textContent =
              mode === 'add_tax'
                ? 'Total Price (Including Tax)'
                : 'Net Price (Excluding Tax)';
          }
          calculate();
        }
      });
    });

    amountInput?.addEventListener('input', calculate);
    rateInput?.addEventListener('input', calculate);

    calculate();
  })();
</script>

