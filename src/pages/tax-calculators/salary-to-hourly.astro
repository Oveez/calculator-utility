---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AdSlot from '../../components/tax/AdSlot.astro';
import TaxDisclaimer from '../../components/tax/TaxDisclaimer.astro';
import CountryTaxSelector from '../../components/tax/CountryTaxSelector.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import Icon from '../../components/Icon.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';

const parameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'annualSalary',
    name: 'Annual Salary ($)',
    description: 'Contracted base annual salary before taxes and deductions.',
    whyItMatters: 'The fixed gross annual earnings figure agreed upon with an employer.',
    typicalRange: '$30,000 – $300,000+',
    unit: '$',
  },
  {
    id: 'hoursPerWeek',
    name: 'Hours Per Week',
    description: 'Number of regular working hours scheduled per calendar week.',
    whyItMatters: 'Directly impacts the effective hourly rate of your labor (standard full-time is 40 hours).',
    typicalRange: '20 – 50 hrs/wk',
    unit: 'hours',
  },
  {
    id: 'weeksPerYear',
    name: 'Weeks Per Year',
    description: 'Total number of paid work weeks in the calendar year.',
    whyItMatters: 'Standard employment is 52 paid weeks (including paid annual leave and public holidays).',
    typicalRange: '48 – 52 weeks',
    unit: 'weeks',
  },
  {
    id: 'hourlyRate',
    name: 'Equivalent Hourly Wage',
    description: 'The exact amount of money you earn for each hour of scheduled work.',
    whyItMatters: 'Essential for evaluating freelance rates, consulting fees, side hustles, or comparing salaried vs hourly job offers.',
    typicalRange: 'Salary ÷ (Hours × Weeks)',
    unit: '$/hr',
  },
  {
    id: 'monthlyPay',
    name: 'Monthly Paycheck (Gross)',
    description: 'Average gross earnings received per calendar month (Annual Salary ÷ 12).',
    whyItMatters: 'Used for monthly budget planning, rent/mortgage approvals, and recurring expenses.',
    typicalRange: 'Salary ÷ 12',
    unit: '$',
  },
];
---

<SiteLayout
  title="Salary to Hourly Converter & Paycheck Calculator | Free Online Wage Tool"
  description="Convert your annual salary to an hourly wage, daily pay, weekly rate, and monthly paycheck. Customize working hours per week and weeks per year."
>
  <div class="mx-auto max-w-4xl space-y-10">
    <nav class="flex items-center gap-2 text-xs font-medium text-[color:var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <a href="/tax-calculators/" class="hover:text-[color:var(--accent)]">Tax Calculators</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Salary to Hourly</span>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--accent)]">
        <span>Employment &amp; Paycheck Tool</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Salary to Hourly Converter
      </h1>
      <p class="text-base text-[color:var(--muted)]">
        Convert your annual salary into equivalent hourly, daily, weekly, and monthly rates based on customizable work schedules.
      </p>
    </header>

    <AdSlot slotId="salary-hourly-top" position="top" />

    <!-- Salary Converter Component -->
    <div class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10" data-salary-app>
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="space-y-5">
          <div>
            <label for="annual-salary-input" class="block text-sm font-bold text-[color:var(--fg)]">
              Annual Salary
            </label>
            <div class="relative mt-2">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-base font-bold text-[color:var(--muted)]">$</span>
              <input
                id="annual-salary-input"
                type="number"
                min="0"
                step="1000"
                placeholder="e.g. 75,000"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-3.5 pl-10 pr-4 text-xl font-extrabold text-[color:var(--fg)] shadow-inner outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                data-salary-val />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="hours-per-week" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Hours Per Week
              </label>
              <input
                id="hours-per-week"
                type="number"
                min="1"
                max="168"
                value="40"
                class="mt-1.5 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 text-sm font-bold text-[color:var(--fg)] outline-none"
                data-hours-week />
            </div>
            <div>
              <label for="weeks-per-year" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Weeks Per Year
              </label>
              <input
                id="weeks-per-year"
                type="number"
                min="1"
                max="52"
                value="52"
                class="mt-1.5 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 text-sm font-bold text-[color:var(--fg)] outline-none"
                data-weeks-year />
            </div>
          </div>
        </div>

        <!-- Equivalent Wage Rates Output -->
        <div class="rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] to-transparent p-6 shadow-sm sm:p-8 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--accent)]">Equivalent Hourly Rate</p>
              <p class="mt-1 text-4xl font-extrabold text-[color:var(--fg)] sm:text-5xl" data-out-hourly>$0.00</p>
              <p class="text-xs text-[color:var(--muted)]">Based on 2,080 working hours/year</p>
            </div>
            <button
              type="button"
              data-copy-btn
              class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
            >
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy Summary</span>
            </button>
          </div>

          <div class="space-y-2.5 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
            <div class="flex items-center justify-between text-[color:var(--muted)]">
              <span>Daily Pay (8 hrs):</span>
              <span class="font-bold text-[color:var(--fg)]" data-out-daily>$0.00</span>
            </div>
            <div class="flex items-center justify-between text-[color:var(--muted)]">
              <span>Weekly Pay:</span>
              <span class="font-bold text-[color:var(--fg)]" data-out-weekly>$0.00</span>
            </div>
            <div class="flex items-center justify-between text-[color:var(--muted)]">
              <span>Bi-Weekly Pay:</span>
              <span class="font-bold text-[color:var(--fg)]" data-out-biweekly>$0.00</span>
            </div>
            <div class="flex items-center justify-between text-[color:var(--muted)]">
              <span>Monthly Pay:</span>
              <span class="font-bold text-[color:var(--fg)]" data-out-monthly>$0.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formulas Reference Card -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4">
      <h2 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Mathematical Conversion Formulas</span>
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm text-[color:var(--muted)]">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-subtle)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Hourly &amp; Daily Wage Equations</p>
          <p class="font-mono text-xs text-cyan-500 dark:text-cyan-400">Total Annual Hours = Hours/Week × Weeks/Year</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Hourly Rate = Annual Salary ÷ Total Annual Hours</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Daily Pay = Hourly Rate × 8</p>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-subtle)] p-4 space-y-2">
          <p class="font-bold text-[color:var(--fg)]">Periodic Salary Breakdown</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Weekly Pay = Annual Salary ÷ Weeks/Year</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Bi-Weekly Pay = Weekly Pay × 2</p>
          <p class="font-mono text-xs text-[color:var(--fg)]">Monthly Pay = Annual Salary ÷ 12</p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4">
      <h2 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Step-by-Step Worked Example</span>
      </h2>
      <div class="space-y-3 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        <p>
          Suppose an employee accepts an annual salary of <strong class="text-[color:var(--fg)]">$75,000.00</strong> with a standard schedule of 40 hours per week across 52 paid weeks:
        </p>
        <ol class="list-decimal pl-5 space-y-2">
          <li>
            <strong class="text-[color:var(--fg)]">Compute Total Annual Hours:</strong><br />
            40 hours/week × 52 weeks = <strong class="text-[color:var(--fg)] font-mono">2,080 working hours</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Equivalent Hourly Wage:</strong><br />
            $75,000.00 ÷ 2,080 hours = <strong class="text-cyan-500 dark:text-cyan-400 font-bold font-mono">$36.06 per hour</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Daily Compensation (8 hours):</strong><br />
            $36.06 × 8 hours = <strong class="text-[color:var(--fg)] font-mono">$288.46 per day</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Weekly &amp; Monthly Paychecks:</strong><br />
            Weekly: $75,000 ÷ 52 = <strong class="text-[color:var(--fg)] font-mono">$1,442.31 per week</strong>.<br />
            Monthly: $75,000 ÷ 12 = <strong class="text-[color:var(--fg)] font-mono">$6,250.00 per month</strong>.
          </li>
        </ol>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <CountryTaxSelector compact={true} title="Calculate Taxes on this Salary" />
    <TaxDisclaimer />
  </div>
</SiteLayout>

<script>
  (function () {
    const app = document.querySelector('[data-salary-app]');
    if (!app) return;

    const salaryInput = app.querySelector('[data-salary-val]') as HTMLInputElement | null;
    const hoursInput = app.querySelector('[data-hours-week]') as HTMLInputElement | null;
    const weeksInput = app.querySelector('[data-weeks-year]') as HTMLInputElement | null;

    const outHourly = app.querySelector('[data-out-hourly]');
    const outDaily = app.querySelector('[data-out-daily]');
    const outWeekly = app.querySelector('[data-out-weekly]');
    const outBiweekly = app.querySelector('[data-out-biweekly]');
    const outMonthly = app.querySelector('[data-out-monthly]');
    const copyBtn = app.querySelector('[data-copy-btn]');

    function fmt(num: number) {
      return '$' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function update() {
      const salary = Math.max(0, parseFloat(salaryInput?.value || '0') || 0);
      const hours = Math.max(1, parseFloat(hoursInput?.value || '40') || 40);
      const weeks = Math.max(1, parseFloat(weeksInput?.value || '52') || 52);

      const totalHours = hours * weeks;
      const hourly = totalHours > 0 ? salary / totalHours : 0;
      const daily = (hours / 5) * hourly;
      const weekly = salary / weeks;
      const biweekly = weekly * 2;
      const monthly = salary / 12;

      if (outHourly) outHourly.textContent = fmt(hourly);
      if (outDaily) outDaily.textContent = fmt(daily);
      if (outWeekly) outWeekly.textContent = fmt(weekly);
      if (outBiweekly) outBiweekly.textContent = fmt(biweekly);
      if (outMonthly) outMonthly.textContent = fmt(monthly);
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = [
          'Salary to Hourly Wage Conversion Summary',
          '---------------------------------------',
          `Annual Salary: $${salaryInput?.value || '0'}`,
          `Weekly Hours: ${hoursInput?.value || '40'} hrs/wk`,
          `Paid Weeks: ${weeksInput?.value || '52'} wks/yr`,
          '---------------------------------------',
          `Equivalent Hourly Wage: ${outHourly?.textContent}`,
          `Daily Pay (8 hrs): ${outDaily?.textContent}`,
          `Weekly Pay: ${outWeekly?.textContent}`,
          `Bi-Weekly Pay: ${outBiweekly?.textContent}`,
          `Monthly Pay: ${outMonthly?.textContent}`,
        ].join('\n');

        navigator.clipboard.writeText(text).then(() => {
          const orig = copyBtn.textContent;
          copyBtn.textContent = '✓ Copied!';
          setTimeout(() => { copyBtn.textContent = orig; }, 2000);
        });
      });
    }

    salaryInput?.addEventListener('input', update);
    hoursInput?.addEventListener('input', update);
    weeksInput?.addEventListener('input', update);

    update();
  })();
</script>

