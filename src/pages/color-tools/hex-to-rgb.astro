---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `HEX to RGB / RGBA Color Converter — Free Online Tool · ${siteName}`;
const pageDesc = 'Convert Hexadecimal color codes (#RRGGBB / #RGB) into standard RGB and RGBA CSS functions with live color preview and alpha opacity slider.';
const canonicalUrl = toAbsoluteUrl('/color-tools/hex-to-rgb/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Color Tools', href: toAbsoluteUrl('/color-tools/') },
  { label: 'HEX to RGB' },
];

const schemaFaq = [
  {
    question: 'How do you convert HEX to RGB in mathematics?',
    answer: 'A 6-digit hex code splits into pairs: R (first 2 hex digits), G (middle 2), and B (last 2). Each 2-digit hex pair is converted to base 10 (0-255). For example, `#FF8000` -> R: 255, G: 128, B: 0.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'HEX to RGB Converter',
    url: canonicalUrl,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-hex-rgb-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Real-time Color Converter</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        HEX to RGB / RGBA Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert hexadecimal web colors into standard RGB and RGBA CSS values with live swatch preview.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Input & Picker -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
          <div>
            <label for="hex-in" class="font-bold text-[color:var(--fg)] block mb-1">HEX Color Code:</label>
            <div class="flex items-center gap-2">
              <input type="color" id="hex-picker" value="#3B82F6" class="h-9 w-12 rounded-xl border border-[color:var(--border)] cursor-pointer bg-transparent" />
              <input type="text" id="hex-in" value="#3B82F6" class="flex-1 rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-sm text-[color:var(--fg)] uppercase" />
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Alpha Opacity (for RGBA):</span>
              <span id="alpha-val" class="font-mono text-cyan-500 dark:text-cyan-400">1.00</span>
            </div>
            <input type="range" id="alpha-slider" min="0" max="1" step="0.01" value="1" class="w-full accent-[color:var(--fg)] cursor-pointer" />
          </div>
        </div>

        <!-- Color Preview & Converted Results -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
          <div class="flex items-center gap-4">
            <div id="swatch" class="h-16 w-16 rounded-2xl border border-[color:var(--border)] shadow-xs bg-[#3B82F6]"></div>
            <div>
              <p id="res-rgb" class="font-mono text-lg font-extrabold text-[color:var(--fg)]">rgb(59, 130, 246)</p>
              <p id="res-rgba" class="font-mono text-xs text-[color:var(--muted)]">rgba(59, 130, 246, 1)</p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 text-center text-xs">
            <div class="rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-[10px] text-[color:var(--muted)]">Red (R)</span>
              <p id="r-val" class="font-mono font-bold text-[color:var(--fg)]">59</p>
            </div>
            <div class="rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-[10px] text-[color:var(--muted)]">Green (G)</span>
              <p id="g-val" class="font-mono font-bold text-[color:var(--fg)]">130</p>
            </div>
            <div class="rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-[10px] text-[color:var(--muted)]">Blue (B)</span>
              <p id="b-val" class="font-mono font-bold text-[color:var(--fg)]">246</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-hex-rgb-app]');
      if (!root) return;

      const hexIn = root.querySelector('#hex-in');
      const hexPicker = root.querySelector('#hex-picker');
      const alphaSlider = root.querySelector('#alpha-slider');
      const alphaVal = root.querySelector('#alpha-val');
      const swatch = root.querySelector('#swatch');
      const resRgb = root.querySelector('#res-rgb');
      const resRgba = root.querySelector('#res-rgba');
      const rVal = root.querySelector('#r-val');
      const gVal = root.querySelector('#g-val');
      const bVal = root.querySelector('#b-val');

      function update() {
        let hex = hexIn.value.trim().replace(/^#/, '');
        if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');

        if (!/^[0-9A-F]{6}$/i.test(hex)) return;

        const num = parseInt(hex, 16);
        const r = (num >> 16) & 255;
        const g = (num >> 8) & 255;
        const b = num & 255;
        const a = parseFloat(alphaSlider.value);

        alphaVal.textContent = a.toFixed(2);
        rVal.textContent = r;
        gVal.textContent = g;
        bVal.textContent = b;

        resRgb.textContent = `rgb(${r}, ${g}, ${b})`;
        resRgba.textContent = `rgba(${r}, ${g}, ${b}, ${a})`;
        swatch.style.backgroundColor = `rgba(${r}, ${g}, ${b}, ${a})`;
      }

      hexIn.addEventListener('input', () => {
        if (/^#[0-9A-F]{6}$/i.test(hexIn.value)) hexPicker.value = hexIn.value;
        update();
      });

      hexPicker.addEventListener('input', (e) => {
        hexIn.value = e.target.value.toUpperCase();
        update();
      });

      alphaSlider.addEventListener('input', update);
      update();
    })();
  </script>
</SiteLayout>
