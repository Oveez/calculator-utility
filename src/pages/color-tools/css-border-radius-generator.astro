---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSS Border Radius Generator — 8-Point Organic Shape Builder · ${siteName}`;
const pageDesc = 'Create modern asymmetric border radii and organic blob shapes with an 8-point interactive slider generator. Live shape preview and instant CSS code export.';
const canonicalUrl = toAbsoluteUrl('/color-tools/css-border-radius-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Color Tools', href: toAbsoluteUrl('/color-tools/') },
  { label: 'CSS Border Radius Generator' },
];

const schemaFaq = [
  {
    question: 'How does 8-point CSS border-radius syntax work?',
    answer: 'The 8-point syntax separates horizontal radii from vertical radii with a slash: `border-radius: top-left top-right bottom-right bottom-left / v-top-left v-top-right v-bottom-right v-bottom-left;`, enabling organic rounded shapes and fluid blobs.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSS Border Radius Generator',
    url: canonicalUrl,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-radius-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Organic Blob &amp; Shape Builder</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSS Border Radius Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Design asymmetric container corners and organic fluid blobs with visual corner sliders.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Shape Preview Hero -->
      <div class="flex items-center justify-center rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-12 sm:p-20">
        <div id="shape-preview" class="h-48 w-48 sm:h-64 sm:w-64 bg-gradient-to-tr from-emerald-500 to-teal-400 shadow-xl transition-all flex items-center justify-center text-white font-bold text-xs">
          Organic Shape
        </div>
      </div>

      <!-- 4 Corner Controls Grid -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Top Left:</span>
            <span id="tl-txt" class="font-mono text-cyan-500 dark:text-cyan-400">30%</span>
          </div>
          <input type="range" id="tl-slider" min="0" max="100" value="30" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Top Right:</span>
            <span id="tr-txt" class="font-mono text-cyan-500 dark:text-cyan-400">70%</span>
          </div>
          <input type="range" id="tr-slider" min="0" max="100" value="70" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Bottom Right:</span>
            <span id="br-txt" class="font-mono text-cyan-500 dark:text-cyan-400">70%</span>
          </div>
          <input type="range" id="br-slider" min="0" max="100" value="70" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Bottom Left:</span>
            <span id="bl-txt" class="font-mono text-cyan-500 dark:text-cyan-400">30%</span>
          </div>
          <input type="range" id="bl-slider" min="0" max="100" value="30" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>
      </div>

      <!-- Generated CSS Output Card -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated CSS Code</span>
          <button type="button" data-copy-css class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy CSS</span>
          </button>
        </div>
        <pre id="css-out" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 font-mono text-xs font-bold text-cyan-500 dark:text-cyan-400 overflow-x-auto select-all">-</pre>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-radius-app]');
      if (!root) return;

      const preview = root.querySelector('#shape-preview');
      const tl = root.querySelector('#tl-slider');
      const tr = root.querySelector('#tr-slider');
      const br = root.querySelector('#br-slider');
      const bl = root.querySelector('#bl-slider');

      const tlTxt = root.querySelector('#tl-txt');
      const trTxt = root.querySelector('#tr-txt');
      const brTxt = root.querySelector('#br-txt');
      const blTxt = root.querySelector('#bl-txt');
      const cssOut = root.querySelector('#css-out');
      const copyBtn = root.querySelector('[data-copy-css]');

      function update() {
        const vTl = tl.value;
        const vTr = tr.value;
        const vBr = br.value;
        const vBl = bl.value;

        tlTxt.textContent = `${vTl}%`;
        trTxt.textContent = `${vTr}%`;
        brTxt.textContent = `${vBr}%`;
        blTxt.textContent = `${vBl}%`;

        const radiusStr = `${vTl}% ${100 - vTl}% ${vBr}% ${100 - vBr}% / ${100 - vTr}% ${vTr}% ${100 - vBl}% ${vBl}%`;

        preview.style.borderRadius = radiusStr;
        cssOut.textContent = `border-radius: ${radiusStr};`;
      }

      [tl, tr, br, bl].forEach(s => s.addEventListener('input', update));

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(cssOut.textContent);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      update();
    })();
  </script>
</SiteLayout>
