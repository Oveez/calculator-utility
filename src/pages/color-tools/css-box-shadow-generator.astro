---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSS Box Shadow Generator — Soft Shadows & Elevation Tool · ${siteName}`;
const pageDesc = 'Create modern soft box shadows, multi-layer elevation effects, and inset glows online. Live interactive visual canvas and copy-ready CSS.';
const canonicalUrl = toAbsoluteUrl('/color-tools/css-box-shadow-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Color Tools', href: toAbsoluteUrl('/color-tools/') },
  { label: 'CSS Box Shadow Generator' },
];

const schemaFaq = [
  {
    question: 'What are the parameters in CSS box-shadow?',
    answer: 'The CSS `box-shadow` property accepts: `horizontal-offset`, `vertical-offset`, `blur-radius`, `spread-radius`, `color` (with alpha transparency), and an optional `inset` keyword for inner shadows.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSS Box Shadow Generator',
    url: canonicalUrl,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-shadow-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Interactive CSS Elevation Designer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSS Box Shadow Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Design soft UI cards, layered elevations, and inset glow effects with instant CSS code.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Live Preview Area -->
      <div class="flex items-center justify-center rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-12 sm:p-20">
        <div id="preview-box" class="h-40 w-56 rounded-3xl bg-[color:var(--surface)] flex items-center justify-center font-bold text-xs text-[color:var(--fg)] transition-all">
          Box Shadow Preview
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>X Offset:</span>
            <span id="x-txt" class="font-mono text-cyan-500 dark:text-cyan-400">0px</span>
          </div>
          <input type="range" id="x-slider" min="-50" max="50" value="0" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Y Offset:</span>
            <span id="y-txt" class="font-mono text-cyan-500 dark:text-cyan-400">10px</span>
          </div>
          <input type="range" id="y-slider" min="-50" max="50" value="10" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Blur Radius:</span>
            <span id="blur-txt" class="font-mono text-cyan-500 dark:text-cyan-400">25px</span>
          </div>
          <input type="range" id="blur-slider" min="0" max="100" value="25" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Spread Radius:</span>
            <span id="spread-txt" class="font-mono text-cyan-500 dark:text-cyan-400">-5px</span>
          </div>
          <input type="range" id="spread-slider" min="-30" max="50" value="-5" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>
      </div>

      <div class="flex items-center gap-4 text-xs text-[color:var(--muted)]">
        <label class="flex items-center gap-2 cursor-pointer font-semibold text-[color:var(--fg)]">
          <input type="checkbox" id="inset-check" class="rounded accent-[color:var(--fg)]" />
          <span>Inset Shadow (Inner Glow)</span>
        </label>
      </div>

      <!-- Generated CSS Output -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated CSS Code</span>
          <button type="button" data-copy-css class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy CSS</span>
          </button>
        </div>
        <pre id="css-out" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 font-mono text-xs font-bold text-cyan-500 dark:text-cyan-400 overflow-x-auto select-all">-</pre>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-shadow-app]');
      if (!root) return;

      const preview = root.querySelector('#preview-box');
      const xSlider = root.querySelector('#x-slider');
      const ySlider = root.querySelector('#y-slider');
      const blurSlider = root.querySelector('#blur-slider');
      const spreadSlider = root.querySelector('#spread-slider');
      const insetCheck = root.querySelector('#inset-check');

      const xTxt = root.querySelector('#x-txt');
      const yTxt = root.querySelector('#y-txt');
      const blurTxt = root.querySelector('#blur-txt');
      const spreadTxt = root.querySelector('#spread-txt');
      const cssOut = root.querySelector('#css-out');
      const copyBtn = root.querySelector('[data-copy-css]');

      function update() {
        const x = xSlider.value;
        const y = ySlider.value;
        const blur = blurSlider.value;
        const spread = spreadSlider.value;
        const isInset = insetCheck.checked;

        xTxt.textContent = `${x}px`;
        yTxt.textContent = `${y}px`;
        blurTxt.textContent = `${blur}px`;
        spreadTxt.textContent = `${spread}px`;

        const insetStr = isInset ? 'inset ' : '';
        const shadow = `${insetStr}${x}px ${y}px ${blur}px ${spread}px rgba(0, 0, 0, 0.15)`;

        preview.style.boxShadow = shadow;
        cssOut.textContent = `box-shadow: ${shadow};`;
      }

      [xSlider, ySlider, blurSlider, spreadSlider].forEach(s => s.addEventListener('input', update));
      insetCheck.addEventListener('change', update);

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(cssOut.textContent);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      update();
    })();
  </script>
</SiteLayout>
