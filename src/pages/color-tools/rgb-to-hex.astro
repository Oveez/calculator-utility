---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `RGB to HEX Color Converter — Online Red Green Blue to Hex · ${siteName}`;
const pageDesc = 'Convert RGB (Red, Green, Blue) integer values (0-255) into standard Hexadecimal (#RRGGBB) color codes online with live color preview and copy.';
const canonicalUrl = toAbsoluteUrl('/color-tools/rgb-to-hex/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Color Tools', href: toAbsoluteUrl('/color-tools/') },
  { label: 'RGB to HEX' },
];

const schemaFaq = [
  {
    question: 'How do you convert RGB (0-255) to a Hex code?',
    answer: 'Each RGB channel (0 to 255) is converted to a two-digit base-16 hexadecimal representation. For instance, RGB(16, 185, 129) becomes `#10B981`.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'RGB to HEX Converter',
    url: canonicalUrl,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-rgb-hex-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>RGB Channel Transcoder</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        RGB to HEX Color Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert Red, Green, and Blue component values into clean Hexadecimal web colors.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- RGB Channel Sliders -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Red (R):</span>
              <span id="r-val-txt" class="font-mono text-red-500">16</span>
            </div>
            <input type="range" id="r-slider" min="0" max="255" class="w-full accent-red-500 cursor-pointer" value="16" />
          </div>

          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Green (G):</span>
              <span id="g-val-txt" class="font-mono text-cyan-500 dark:text-cyan-400">185</span>
            </div>
            <input type="range" id="g-slider" min="0" max="255" class="w-full accent-emerald-500 cursor-pointer" value="185" />
          </div>

          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Blue (B):</span>
              <span id="b-val-txt" class="font-mono text-blue-500">129</span>
            </div>
            <input type="range" id="b-slider" min="0" max="255" class="w-full accent-blue-500 cursor-pointer" value="129" />
          </div>
        </div>

        <!-- Result Card -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
          <div class="flex items-center gap-4">
            <div id="swatch" class="h-20 w-20 rounded-2xl border border-[color:var(--border)] shadow-xs bg-[#10B981]"></div>
            <div>
              <p id="hex-out" class="font-mono text-2xl font-extrabold text-[color:var(--fg)]">#10B981</p>
              <button type="button" data-copy-hex class="mt-1 inline-flex items-center gap-1 text-xs font-bold text-cyan-500 dark:text-cyan-400 hover:underline">
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy HEX</span>
              </button>
            </div>
          </div>

          <div class="space-y-1.5 pt-2 text-xs border-t border-[color:var(--border)]">
            <div class="flex justify-between">
              <span class="text-[color:var(--muted)]">CSS RGB:</span>
              <span id="css-rgb" class="font-mono font-bold text-[color:var(--fg)]">rgb(16, 185, 129)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-rgb-hex-app]');
      if (!root) return;

      const rSlider = root.querySelector('#r-slider');
      const gSlider = root.querySelector('#g-slider');
      const bSlider = root.querySelector('#b-slider');

      const rValTxt = root.querySelector('#r-val-txt');
      const gValTxt = root.querySelector('#g-val-txt');
      const bValTxt = root.querySelector('#b-val-txt');

      const swatch = root.querySelector('#swatch');
      const hexOut = root.querySelector('#hex-out');
      const cssRgb = root.querySelector('#css-rgb');
      const copyBtn = root.querySelector('[data-copy-hex]');

      function toHex(n) {
        return n.toString(16).padStart(2, '0').toUpperCase();
      }

      function update() {
        const r = (rSlider.value !== '' && !isNaN(parseInt(rSlider.value, 10)) ? parseInt(rSlider.value, 10) : 0);
        const g = (gSlider.value !== '' && !isNaN(parseInt(gSlider.value, 10)) ? parseInt(gSlider.value, 10) : 0);
        const b = (bSlider.value !== '' && !isNaN(parseInt(bSlider.value, 10)) ? parseInt(bSlider.value, 10) : 0);

        rValTxt.textContent = r;
        gValTxt.textContent = g;
        bValTxt.textContent = b;

        const hex = `#${toHex(r)}${toHex(g)}${toHex(b)}`;
        hexOut.textContent = hex;
        cssRgb.textContent = `rgb(${r}, ${g}, ${b})`;
        swatch.style.backgroundColor = hex;
      }

      [rSlider, gSlider, bSlider].forEach(s => s.addEventListener('input', update));

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(hexOut.textContent);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      update();
    })();
  </script>
</SiteLayout>
