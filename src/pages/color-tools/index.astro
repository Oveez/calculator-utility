---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Color & Accessibility Tools | Contrast Checker, Converters & CSS Generators · ${siteName}`;
const pageDesc = 'Free client-side color and accessibility utilities. Test WCAG 2.1 AA/AAA contrast ratios, convert HEX, RGB, HSL, and CMYK color spaces, and visually build CSS gradients, box shadows, and border radii.';
const canonicalUrl = toAbsoluteUrl('/color-tools/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Color Tools' },
];

const colorToolsList = [
  {
    slug: 'color-contrast-checker',
    title: 'WCAG Color Contrast Checker',
    badge: 'Popular',
    metaDescription: 'Test foreground text and background color combinations against WCAG 2.1 AA and AAA standards.',
    href: withBasePath('/color-tools/color-contrast-checker/'),
    icon: 'color',
  },
  {
    slug: 'hex-to-rgb',
    title: 'HEX to RGB / RGBA Converter',
    badge: 'Converter',
    metaDescription: 'Convert 3-digit, 6-digit, and 8-digit hexadecimal color codes into standard RGB and RGBA values.',
    href: withBasePath('/color-tools/hex-to-rgb/'),
    icon: 'color',
  },
  {
    slug: 'rgb-to-hex',
    title: 'RGB to HEX Color Converter',
    badge: 'Converter',
    metaDescription: 'Convert RGB and RGBA integer values (0-255) into standard CSS hexadecimal color strings.',
    href: withBasePath('/color-tools/rgb-to-hex/'),
    icon: 'color',
  },
  {
    slug: 'rgb-to-hsl',
    title: 'RGB to HSL Color Converter',
    badge: 'Converter',
    metaDescription: 'Convert RGB channels to Hue (0-360°), Saturation (%), and Lightness (%) color coordinates.',
    href: withBasePath('/color-tools/rgb-to-hsl/'),
    icon: 'color',
  },
  {
    slug: 'cmyk-to-rgb',
    title: 'CMYK to RGB Print Converter',
    badge: 'Print',
    metaDescription: 'Convert Cyan, Magenta, Yellow, and Key (Black) print ink percentages into digital RGB values.',
    href: withBasePath('/color-tools/cmyk-to-rgb/'),
    icon: 'color',
  },
  {
    slug: 'css-gradient-generator',
    title: 'CSS Gradient Generator',
    badge: 'CSS Generator',
    metaDescription: 'Build smooth linear and radial CSS gradients with multi-stop color pickers and live visual preview.',
    href: withBasePath('/color-tools/css-gradient-generator/'),
    icon: 'color',
  },
  {
    slug: 'css-box-shadow-generator',
    title: 'CSS Box Shadow Generator',
    badge: 'CSS Generator',
    metaDescription: 'Create modern elevation shadows, inset glows, and soft glassmorphic box shadows with copy-ready CSS.',
    href: withBasePath('/color-tools/css-box-shadow-generator/'),
    icon: 'color',
  },
  {
    slug: 'css-border-radius-generator',
    title: 'CSS Border Radius Generator',
    badge: 'CSS Generator',
    metaDescription: 'Generate asymmetric and 8-point organic organic blob border-radius curves with instant CSS code export.',
    href: withBasePath('/color-tools/css-border-radius-generator/'),
    icon: 'color',
  },
];

const schemaFaq = [
  {
    question: 'How is WCAG 2.1 color contrast calculated?',
    answer: 'It computes relative luminance `L = 0.2126 * R + 0.7152 * G + 0.0722 * B` for each color and determines the contrast ratio `(L1 + 0.05) / (L2 + 0.05)`, verifying compliance against 4.5:1 (AA) and 7:1 (AAA) thresholds.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-bold text-[color:var(--fg)]">
        <span>Accessibility &amp; Design Tools</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Color &amp; Accessibility Utilities
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Verify WCAG accessibility compliance, convert between color spaces, and design modern CSS gradients, shadows, and radii in real time.
      </p>
    </header>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Directory</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">8 In-Browser Color Engines</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          8 Tools
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {colorToolsList.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
          >
            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold text-[color:var(--fg)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)]">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[color:var(--fg)]">
              <span>Open Tool</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
