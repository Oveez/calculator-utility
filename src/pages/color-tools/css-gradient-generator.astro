---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSS Gradient Generator — Linear & Radial CSS Gradient Maker · ${siteName}`;
const pageDesc = 'Design smooth Linear and Radial CSS background gradients online with color stops, angle rotation, presets, and instant CSS code export.';
const canonicalUrl = toAbsoluteUrl('/color-tools/css-gradient-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Color Tools', href: toAbsoluteUrl('/color-tools/') },
  { label: 'CSS Gradient Generator' },
];

const schemaFaq = [
  {
    question: 'How do CSS linear gradients work?',
    answer: 'A CSS `linear-gradient(angle, color1 stop1, color2 stop2, ...)` transitions smoothly between multiple color stops along a straight axis oriented by an angle in degrees.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSS Gradient Generator',
    url: canonicalUrl,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-grad-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Interactive CSS Background Builder</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSS Gradient Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Design modern linear and radial CSS gradients with live preview, color stops, and copy-ready code.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Live Preview Hero -->
      <div id="gradient-hero" class="h-64 sm:h-80 w-full rounded-3xl border border-[color:var(--border)] shadow-md transition-all flex items-center justify-center">
        <div class="rounded-2xl bg-black/40 backdrop-blur-md px-6 py-3 text-white text-sm font-bold shadow-lg">
          Live CSS Gradient Preview
        </div>
      </div>

      <!-- Controls -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="grad-type" class="font-bold text-[color:var(--fg)] block mb-1">Gradient Type:</label>
          <select id="grad-type" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="linear">Linear Gradient</option>
            <option value="radial">Radial (Circle)</option>
          </select>
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Angle:</span>
            <span id="angle-txt" class="font-mono text-cyan-500 dark:text-cyan-400">135°</span>
          </div>
          <input type="range" id="angle-slider" min="0" max="360" value="135" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div>
          <label for="col-1" class="font-bold text-[color:var(--fg)] block mb-1">Color 1:</label>
          <div class="flex items-center gap-2">
            <input type="color" id="col-1-picker" value="#3B82F6" class="h-8 w-10 rounded-lg cursor-pointer bg-transparent border border-[color:var(--border)]" />
            <input type="text" id="col-1" value="#3B82F6" class="flex-1 rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 font-mono text-[color:var(--fg)] uppercase" />
          </div>
        </div>

        <div>
          <label for="col-2" class="font-bold text-[color:var(--fg)] block mb-1">Color 2:</label>
          <div class="flex items-center gap-2">
            <input type="color" id="col-2-picker" value="#9333EA" class="h-8 w-10 rounded-lg cursor-pointer bg-transparent border border-[color:var(--border)]" />
            <input type="text" id="col-2" value="#9333EA" class="flex-1 rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 font-mono text-[color:var(--fg)] uppercase" />
          </div>
        </div>
      </div>

      <!-- Copy CSS Code Card -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated CSS Code</span>
          <button type="button" data-copy-css class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy CSS</span>
          </button>
        </div>
        <pre id="css-out" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 font-mono text-xs font-bold text-cyan-500 dark:text-cyan-400 overflow-x-auto select-all">-</pre>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-grad-app]');
      if (!root) return;

      const hero = root.querySelector('#gradient-hero');
      const gradType = root.querySelector('#grad-type');
      const angleSlider = root.querySelector('#angle-slider');
      const angleTxt = root.querySelector('#angle-txt');
      const col1 = root.querySelector('#col-1');
      const col1Picker = root.querySelector('#col-1-picker');
      const col2 = root.querySelector('#col-2');
      const col2Picker = root.querySelector('#col-2-picker');
      const cssOut = root.querySelector('#css-out');
      const copyBtn = root.querySelector('[data-copy-css]');

      function update() {
        const type = gradType.value;
        const angle = angleSlider.value;
        angleTxt.textContent = `${angle}°`;

        const c1 = col1.value.trim();
        const c2 = col2.value.trim();

        let gradientStr = '';
        if (type === 'linear') {
          gradientStr = `linear-gradient(${angle}deg, ${c1} 0%, ${c2} 100%)`;
        } else {
          gradientStr = `radial-gradient(circle, ${c1} 0%, ${c2} 100%)`;
        }

        hero.style.background = gradientStr;
        cssOut.textContent = `background: ${c1};\nbackground: ${gradientStr};`;
      }

      col1Picker.addEventListener('input', (e) => { col1.value = e.target.value.toUpperCase(); update(); });
      col2Picker.addEventListener('input', (e) => { col2.value = e.target.value.toUpperCase(); update(); });
      col1.addEventListener('input', () => { col1Picker.value = col1.value; update(); });
      col2.addEventListener('input', () => { col2Picker.value = col2.value; update(); });

      gradType.addEventListener('change', update);
      angleSlider.addEventListener('input', update);

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(cssOut.textContent);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      update();
    })();
  </script>
</SiteLayout>
