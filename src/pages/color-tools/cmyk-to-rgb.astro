---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CMYK to RGB Converter — Convert Print CMYK to Digital RGB · ${siteName}`;
const pageDesc = 'Convert Cyan, Magenta, Yellow, and Key (Black) print ink percentages (0-100%) into screen RGB and Hexadecimal color codes online with live preview.';
const canonicalUrl = toAbsoluteUrl('/color-tools/cmyk-to-rgb/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Color Tools', href: toAbsoluteUrl('/color-tools/') },
  { label: 'CMYK to RGB' },
];

const schemaFaq = [
  {
    question: 'How do you convert CMYK percentages into RGB in formula?',
    answer: 'R = 255 * (1 - C / 100) * (1 - K / 100), G = 255 * (1 - M / 100) * (1 - K / 100), B = 255 * (1 - Y / 100) * (1 - K / 100).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CMYK to RGB Converter',
    url: canonicalUrl,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-cmyk-rgb-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Subtractive to Additive Color Transcoder</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CMYK to RGB Color Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Translate print ink CMYK percentages into digital screen RGB and HEX colors with live visual swatch.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- CMYK Sliders -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Cyan (C):</span>
              <span id="c-txt" class="font-mono text-cyan-500">0%</span>
            </div>
            <input type="range" id="c-slider" min="0" max="100" value="0" class="w-full accent-cyan-500 cursor-pointer" />
          </div>

          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Magenta (M):</span>
              <span id="m-txt" class="font-mono text-pink-500">80%</span>
            </div>
            <input type="range" id="m-slider" min="0" max="100" value="80" class="w-full accent-pink-500 cursor-pointer" />
          </div>

          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Yellow (Y):</span>
              <span id="y-txt" class="font-mono text-amber-500">95%</span>
            </div>
            <input type="range" id="y-slider" min="0" max="100" value="95" class="w-full accent-amber-500 cursor-pointer" />
          </div>

          <div>
            <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
              <span>Key / Black (K):</span>
              <span id="k-txt" class="font-mono text-zinc-500">0%</span>
            </div>
            <input type="range" id="k-slider" min="0" max="100" value="0" class="w-full accent-zinc-700 cursor-pointer" />
          </div>
        </div>

        <!-- Converted Output Card -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
          <div class="flex items-center gap-4">
            <div id="swatch" class="h-20 w-20 rounded-2xl border border-[color:var(--border)] shadow-xs bg-[#FF330D]"></div>
            <div>
              <p id="res-hex" class="font-mono text-2xl font-extrabold text-[color:var(--fg)]">#FF330D</p>
              <p id="res-rgb" class="font-mono text-xs text-[color:var(--muted)]">rgb(255, 51, 13)</p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 text-center text-xs">
            <div class="rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-[10px] text-[color:var(--muted)]">Red (R)</span>
              <p id="r-val" class="font-mono font-bold text-[color:var(--fg)]">255</p>
            </div>
            <div class="rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-[10px] text-[color:var(--muted)]">Green (G)</span>
              <p id="g-val" class="font-mono font-bold text-[color:var(--fg)]">51</p>
            </div>
            <div class="rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-[10px] text-[color:var(--muted)]">Blue (B)</span>
              <p id="b-val" class="font-mono font-bold text-[color:var(--fg)]">13</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-cmyk-rgb-app]');
      if (!root) return;

      const cSlider = root.querySelector('#c-slider');
      const mSlider = root.querySelector('#m-slider');
      const ySlider = root.querySelector('#y-slider');
      const kSlider = root.querySelector('#k-slider');

      const cTxt = root.querySelector('#c-txt');
      const mTxt = root.querySelector('#m-txt');
      const yTxt = root.querySelector('#y-txt');
      const kTxt = root.querySelector('#k-txt');

      const swatch = root.querySelector('#swatch');
      const resHex = root.querySelector('#res-hex');
      const resRgb = root.querySelector('#res-rgb');
      const rVal = root.querySelector('#r-val');
      const gVal = root.querySelector('#g-val');
      const bVal = root.querySelector('#b-val');

      function toHex(n) {
        return n.toString(16).padStart(2, '0').toUpperCase();
      }

      function update() {
        const c = parseInt(cSlider.value, 10);
        const m = parseInt(mSlider.value, 10);
        const y = parseInt(ySlider.value, 10);
        const k = parseInt(kSlider.value, 10);

        cTxt.textContent = `${c}%`;
        mTxt.textContent = `${m}%`;
        yTxt.textContent = `${y}%`;
        kTxt.textContent = `${k}%`;

        const r = Math.round(255 * (1 - c / 100) * (1 - k / 100));
        const g = Math.round(255 * (1 - m / 100) * (1 - k / 100));
        const b = Math.round(255 * (1 - y / 100) * (1 - k / 100));

        rVal.textContent = r;
        gVal.textContent = g;
        bVal.textContent = b;

        const hex = `#${toHex(r)}${toHex(g)}${toHex(b)}`;
        resHex.textContent = hex;
        resRgb.textContent = `rgb(${r}, ${g}, ${b})`;
        swatch.style.backgroundColor = hex;
      }

      [cSlider, mSlider, ySlider, kSlider].forEach(s => s.addEventListener('input', update));
      update();
    })();
  </script>
</SiteLayout>
