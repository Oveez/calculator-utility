---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Job Description Keyword Extractor — Extract Skills & Requirements · ${siteName}`;
const pageDesc = 'Extract high-frequency technical skills, tools, frameworks, and job requirements from job postings online. 100% private in-browser text analysis.';
const canonicalUrl = toAbsoluteUrl('/career-tools/job-description-keyword-extractor/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Career Tools', href: toAbsoluteUrl('/career-tools/') },
  { label: 'Job Description Keyword Extractor' },
];

const schemaFaq = [
  {
    question: 'How does keyword extraction help in job applications?',
    answer: 'Extracting key terms helps candidates tailor their resume and cover letter to match the specific skills, technologies, and phrasing required by the hiring manager and ATS filters.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Job Description Keyword Extractor',
    url: canonicalUrl,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-jd-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Job Posting Intelligence Scanner</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Job Description Keyword Extractor
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Extract essential technical tools, frameworks, and job requirements from job postings.
      </p>
    </header>

    <div class="space-y-6">
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="jd-text" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Paste Job Description</label>
          <button type="button" data-sample-btn class="text-xs font-semibold text-[color:var(--primary)] hover:underline">Load Sample Job</button>
        </div>
        <textarea
          id="jd-text"
          rows="8"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste job posting text here..."
        >We are seeking a Senior Full-Stack Engineer with 4+ years of experience in React, TypeScript, and Node.js. The ideal candidate has deep expertise with PostgreSQL, Redis, Docker, and AWS infrastructure (ECS, Lambda, S3). Strong understanding of REST APIs, GraphQL, automated testing (Jest, Cypress), and CI/CD pipelines is required. Experience with agile methodologies, Git, and Kubernetes is a plus.</textarea>
      </div>

      <!-- Extracted Keywords Grid -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">High-Frequency Keywords &amp; Tech Stack</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Keywords</span>
          </button>
        </div>
        <div id="kw-tags" class="flex flex-wrap gap-2 font-mono text-xs"></div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-jd-app]');
      if (!root) return;

      const jdIn = root.querySelector('#jd-text');
      const kwTags = root.querySelector('#kw-tags');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');

      const STOP_WORDS = new Set([
        'the', 'and', 'for', 'with', 'that', 'this', 'from', 'have', 'are', 'was', 'were',
        'will', 'our', 'you', 'your', 'about', 'must', 'has', 'can', 'not', 'but', 'all',
        'any', 'job', 'work', 'years', 'experience', 'team', 'role', 'looking', 'candidate'
      ]);

      function analyze() {
        const text = jdIn.value;
        const rawWords = text.toLowerCase().match(/\b[a-z0-9+#.-]{2,}\b/g) || [];

        const freq = new Map();
        rawWords.forEach(w => {
          if (!STOP_WORDS.has(w) && isNaN(Number(w))) {
            freq.set(w, (freq.get(w) || 0) + 1);
          }
        });

        const sorted = Array.from(freq.entries())
          .sort((a, b) => b[1] - a[1])
          .slice(0, 30);

        if (sorted.length === 0) {
          kwTags.innerHTML = '<span class="text-xs text-[color:var(--muted)] italic">No keywords detected yet.</span>';
          return;
        }

        kwTags.innerHTML = sorted.map(([kw, count]) => `
          <span class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 font-semibold text-[color:var(--fg)] flex items-center gap-1.5">
            <span>${kw}</span>
            <span class="rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] px-1.5 py-0.2 font-mono">${count}x</span>
          </span>
        `).join('');
      }

      jdIn.addEventListener('input', analyze);

      sampleBtn.addEventListener('click', () => {
        jdIn.value = `Seeking Senior DevOps Engineer with Docker, Kubernetes, Terraform, AWS, Python, CI/CD, Linux, Prometheus, Grafana, and Ansible expertise.`;
        analyze();
      });

      copyBtn.addEventListener('click', () => {
        const tags = Array.from(kwTags.querySelectorAll('span span:first-child')).map(s => s.textContent);
        if (tags.length === 0) return;
        navigator.clipboard.writeText(tags.join(', '));
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      analyze();
    })();
  </script>
</SiteLayout>
