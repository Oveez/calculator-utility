---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CvMakerApp from '../../components/career/CvMakerApp.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Free Student CV Maker · Internship & University Resume Builder · ${siteName}`;
const pageDesc = 'Create a winning student CV for university internships, summer jobs, and first entry-level applications. ATS-compliant, pre-configured student template, free vector PDF download.';
const canonicalUrl = toAbsoluteUrl('/career-tools/student-cv-maker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Career Tools', href: toAbsoluteUrl('/career-tools/') },
  { label: 'Student CV Maker' },
];

const faqs = [
  {
    question: 'How should a student format a CV with no work experience?',
    answer: 'Place your Education section right beneath your contact details and summary. Highlight relevant university coursework, academic honors, capstone projects, coding repositories, club leadership, and volunteer activities. Use bullet points with action verbs to demonstrate problem-solving and teamwork.',
  },
  {
    question: 'Should I include my GPA on a student CV?',
    answer: 'Include your GPA if it is 3.5 or higher (out of 4.0), or if the internship application explicitly requests it. If your major GPA is higher than your cumulative GPA, you can list your "Major GPA: 3.8 / 4.0".',
  },
  {
    question: 'How long should a student resume or CV be?',
    answer: 'A student CV or resume should almost always be strictly 1 page. Recruiters reviewing student and internship applications prioritize conciseness and relevant project highlights.',
  },
  {
    question: 'Can I include high school achievements on a college CV?',
    answer: 'Freshmen and sophomore students may include notable high school honors (e.g. Valedictorian, AP Scholar, state championships). By your junior and senior year of university, replace high school details with collegiate coursework, research, and campus leadership.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Student CV Maker & Internship Resume Builder',
    description: pageDesc,
    url: canonicalUrl,
    applicationCategory: 'CareerApplication',
    operatingSystem: 'Web Browser',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    publisher: {
      '@type': 'Organization',
      name: siteName,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href ?? canonicalUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 sm:space-y-12 w-full max-w-full min-w-0 overflow-hidden">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="w-full min-w-0 overflow-x-auto">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-medium text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="space-y-4 w-full min-w-0">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
        <span>University &amp; Internship Toolkit</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-[color:var(--fg)] sm:text-3xl lg:text-4xl">
        Free Student CV Maker — Build Internship Resumes
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Tailored for college, high school, and university students. Showcase your coursework, academic projects, GPA, and extracurricular leadership with an ATS-compliant template.
      </p>
    </header>

    <!-- The Interactive CV Maker App pre-configured for Student template -->
    <section aria-label="Student CV Maker Application" class="w-full max-w-full min-w-0">
      <CvMakerApp initialTemplate="student" />
    </section>

    <!-- In-Depth Student SEO Content -->
    <section class="space-y-10 border-t border-[color:var(--border)] pt-10">
      
      <!-- Student Strategy Grid -->
      <article class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-8 space-y-6 shadow-sm">
        <h2 class="text-2xl font-bold tracking-tight text-[color:var(--fg)]">Essential Sections for a Student CV</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 space-y-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-500/10 text-xs font-bold text-emerald-600 dark:text-emerald-400">1</span>
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Education &amp; Degree</h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">State your expected graduation date (e.g. <em>Expected May 2026</em>), current degree program, and GPA if above 3.5.</p>
          </div>
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 space-y-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-500/10 text-xs font-bold text-emerald-600 dark:text-emerald-400">2</span>
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Academic Projects</h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">Include course capstones, lab experiments, or term papers. Detail the tools, methodology, and outcome.</p>
          </div>
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 space-y-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-500/10 text-xs font-bold text-emerald-600 dark:text-emerald-400">3</span>
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Campus &amp; Club Leadership</h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">Leadership positions in university societies demonstrate initiative, communication, and event organization.</p>
          </div>
        </div>
      </article>

      <!-- Student Advice -->
      <article class="rounded-3xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8 space-y-4">
        <h2 class="text-xl font-bold text-[color:var(--fg)]">How to Turn Coursework into Impactful Resume Bullets</h2>
        <p class="text-xs leading-relaxed text-[color:var(--muted)]">
          When applying for internships, employers know you may not have extensive professional history. What they look for is your ability to apply classroom theory to practical problems. Use the <strong>Action Verb + Task + Result</strong> formula:
        </p>
        <div class="space-y-2 pt-2 text-xs text-[color:var(--muted)]">
          <div class="rounded-xl bg-[color:var(--surface)] p-3 border border-[color:var(--border)]">
            <span class="text-rose-500 font-bold">Weak:</span> <em>"Did a group project on machine learning algorithms in Python."</em>
          </div>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 border border-emerald-500/30">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">Strong:</span> <em>"Collaborated in a 4-person team to build a predictive pricing model in Python &amp; Scikit-Learn, achieving 91% classification accuracy across 10,000 dataset samples."</em>
          </div>
        </div>
      </article>

      <!-- FAQs -->
      <article class="space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">Student CV Frequently Asked Questions</h2>
        <div class="grid gap-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 shadow-sm">
              <summary class="cursor-pointer list-none text-sm font-bold text-[color:var(--fg)] flex items-center justify-between">
                <span>{faq.question}</span>
                <span class="text-xs text-[color:var(--accent)] group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-3 text-xs leading-relaxed text-[color:var(--muted)]">{faq.answer}</p>
            </details>
          ))}
        </div>
      </article>

      <!-- Internal Link Box -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-sm font-bold text-[color:var(--fg)]">Need to calculate your semester GPA?</h3>
          <p class="text-xs text-[color:var(--muted)]">Use our instant college GPA calculator to determine your cumulative grade point average accurately.</p>
        </div>
        <a
          href={withBasePath('/calculators/gpa-calculator/')}
          class="shrink-0 rounded-full bg-[color:var(--accent)] px-5 py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-sm hover:bg-[color:var(--accent-strong)]"
        >
          Open GPA Calculator →
        </a>
      </div>
    </section>
  </article>
</SiteLayout>
