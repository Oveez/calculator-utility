---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CvMakerApp from '../../components/career/CvMakerApp.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Fresher Resume Maker — Free Resume Builder for Freshers · ${siteName}`;
const pageDesc = 'Free fresher resume maker and resume builder for freshers online. Create an ATS friendly resume for fresh graduates and first-time job seekers with free vector PDF download.';
const canonicalUrl = toAbsoluteUrl('/career-tools/fresher-resume-maker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Career Tools', href: toAbsoluteUrl('/career-tools/') },
  { label: 'Fresher Resume Maker' },
];

const faqs = [
  {
    question: 'How do I write a fresher resume with no work experience?',
    answer: 'Focus on a Functional or Hybrid resume format. Emphasize your technical skills, capstone projects, coding repositories, certifications, volunteer contributions, and relevant degree coursework. Frame your academic and personal projects as tangible problem-solving achievements.',
  },
  {
    question: 'What should be the career objective for a fresh graduate?',
    answer: 'A concise 2-3 sentence statement explaining your degree background, core technical skills, and how you aim to contribute value to the specific company. For example: "Enthusiastic Computer Science graduate skilled in TypeScript, React, and Python seeking an Associate Software Engineer role at [Company Name] to build scalable web applications."',
  },
  {
    question: 'Should a fresher resume be 1 or 2 pages?',
    answer: 'A fresher resume should strictly be 1 page. Hiring managers value clarity and concise presentation of your strongest foundational skills.',
  },
  {
    question: 'Are online certifications (Coursera, Udemy, AWS) valuable for freshers?',
    answer: 'Yes! Relevant industry certifications (such as AWS Cloud Practitioner, Meta Frontend Developer, or Google Data Analytics) provide third-party validation of your skills and demonstrate initiative beyond university curricula.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Fresher Resume Maker & Entry Level Builder',
    description: pageDesc,
    url: canonicalUrl,
    applicationCategory: 'CareerApplication',
    operatingSystem: 'Web Browser',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    publisher: {
      '@type': 'Organization',
      name: siteName,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href ?? canonicalUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  
  <article class="space-y-10 sm:space-y-12 w-full max-w-full min-w-0 overflow-hidden">
    <!-- Breadcrumb / compact page context -->
    <nav class="site-tool-breadcrumb mb-4 pt-1" aria-label="Breadcrumb" class="w-full min-w-0 overflow-x-auto">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-medium text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>


    <!-- The Interactive CV Maker App -->
    <section aria-label="Fresher Resume Builder Application" class="w-full max-w-full min-w-0">
      <CvMakerApp initialTemplate="student" />
    </section>

    <!-- Detailed Fresher Guide -->
    <section class="space-y-12 border-t border-[color:var(--border)] pt-12">
      
      <article class="space-y-6">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Entry-Level Strategy</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[color:var(--fg)] mt-2">How Fresh Graduates Can Beat Experience Requirements</h2>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="space-y-2">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-blue-600 text-sm font-bold text-white shadow-xs">1</span>
            <h3 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Technical Stack</h3>
            <p class="text-base leading-relaxed text-[color:var(--muted)]">List specific tools, libraries, and frameworks you know (e.g. Git, SQL, Figma, Python).</p>
          </div>
          <div class="space-y-2">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-blue-600 text-sm font-bold text-white shadow-xs">2</span>
            <h3 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Live Project Links</h3>
            <p class="text-base leading-relaxed text-[color:var(--muted)]">Include links to your live websites, GitHub repositories, or design portfolios.</p>
          </div>
          <div class="space-y-2">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-blue-600 text-sm font-bold text-white shadow-xs">3</span>
            <h3 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Verified Certificates</h3>
            <p class="text-base leading-relaxed text-[color:var(--muted)]">Showcase industry certifications that validate your technical credentials.</p>
          </div>
          <div class="space-y-2">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-blue-600 text-sm font-bold text-white shadow-xs">4</span>
            <h3 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Soft Skills in Action</h3>
            <p class="text-base leading-relaxed text-[color:var(--muted)]">Demonstrate teamwork, fast learning, and clear documentation in your project summaries.</p>
          </div>
        </div>
      </article>

      <!-- Existing full SEO hero/banner -->
    <div class="site-hero-banner site-hero-banner--compact my-10">
      <div class="site-hero-banner-dots" aria-hidden="true" />
      <div class="site-hero-inner">
        <header class="space-y-4 w-full min-w-0">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-1.5 text-xs font-semibold text-[color:var(--primary)] dark:text-blue-400">
        <span>First-Job &amp; Graduate Resume Builder</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-[color:var(--fg)] sm:text-3xl lg:text-4xl">
        Fresher Resume Maker — Free Resume Builder for Freshers &amp; First Jobs
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Designed specifically for fresh university graduates and career starters. Use our free fresher resume maker to turn academic coursework, coding projects, and transferable skills into an ATS friendly resume with instant vector PDF download.
      </p>
    </header>
      </div>
    </div>

    <!-- FAQs -->
      <article class="space-y-6 border-t border-[color:var(--border)] pt-12">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Frequently Asked Questions</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[color:var(--fg)] mt-2">Fresher Resume FAQs</h2>
        </div>

        <div class="divide-y divide-[color:var(--border)]">
          {faqs.map((faq) => (
            <details class="group py-4.5 transition cursor-pointer">
              <summary class="list-none text-base sm:text-lg font-bold text-[color:var(--fg)] flex items-center justify-between gap-4">
                <span>{faq.question}</span>
                <span class="text-sm text-[color:var(--accent)] group-open:rotate-180 transition-transform shrink-0">▼</span>
              </summary>
              <p class="mt-3 text-base leading-relaxed text-[color:var(--muted)] pr-6">{faq.answer}</p>
            </details>
          ))}
        </div>
      </article>

      <!-- Related Navigation -->
      <div class="border-t border-[color:var(--border)] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Preparing for Entry-Level Salary Negotiations?</h3>
          <p class="text-sm sm:text-base text-[color:var(--muted)] mt-1">Use our Salary Calculator to compare hourly wages and annual compensation before accepting your offer.</p>
        </div>
        <a
          href={withBasePath('/calculators/salary-calculator/')}
          class="shrink-0 rounded-xl bg-[color:var(--accent)] px-5 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-[color:var(--accent-strong)] transition"
        >
          Check Salary Breakdown →
        </a>
      </div>
    </section>
  </article>
</SiteLayout>
