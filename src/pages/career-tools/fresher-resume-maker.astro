---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CvMakerApp from '../../components/career/CvMakerApp.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Fresher Resume Maker · Free First Job Resume Builder · ${siteName}`;
const pageDesc = 'Build an ATS-friendly resume for fresh graduates and entry-level job seekers. Showcase your skills, capstone projects, and certifications with zero corporate experience.';
const canonicalUrl = toAbsoluteUrl('/career-tools/fresher-resume-maker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Career Tools', href: toAbsoluteUrl('/career-tools/') },
  { label: 'Fresher Resume Maker' },
];

const faqs = [
  {
    question: 'How do I write a fresher resume with no work experience?',
    answer: 'Focus on a Functional or Hybrid resume format. Emphasize your technical skills, capstone projects, coding repositories, certifications, volunteer contributions, and relevant degree coursework. Frame your academic and personal projects as tangible problem-solving achievements.',
  },
  {
    question: 'What should be the career objective for a fresh graduate?',
    answer: 'A concise 2-3 sentence statement explaining your degree background, core technical skills, and how you aim to contribute value to the specific company. For example: "Enthusiastic Computer Science graduate skilled in TypeScript, React, and Python seeking an Associate Software Engineer role at [Company Name] to build scalable web applications."',
  },
  {
    question: 'Should a fresher resume be 1 or 2 pages?',
    answer: 'A fresher resume should strictly be 1 page. Hiring managers value clarity and concise presentation of your strongest foundational skills.',
  },
  {
    question: 'Are online certifications (Coursera, Udemy, AWS) valuable for freshers?',
    answer: 'Yes! Relevant industry certifications (such as AWS Cloud Practitioner, Meta Frontend Developer, or Google Data Analytics) provide third-party validation of your skills and demonstrate initiative beyond university curricula.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Fresher Resume Maker & Entry Level Builder',
    description: pageDesc,
    url: canonicalUrl,
    applicationCategory: 'CareerApplication',
    operatingSystem: 'Web Browser',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    publisher: {
      '@type': 'Organization',
      name: siteName,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href ?? canonicalUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 sm:space-y-12 w-full max-w-full min-w-0 overflow-hidden">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="w-full min-w-0 overflow-x-auto">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-medium text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="space-y-4 w-full min-w-0">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400">
        <span>First-Job &amp; Graduate Resume Builder</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-[color:var(--fg)] sm:text-3xl lg:text-4xl">
        Fresher Resume Maker — Land Your First Job
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Designed specifically for fresh university graduates and career starters. Transform your academic knowledge, practical coding projects, and transferable skills into an interview-winning resume.
      </p>
    </header>

    <!-- The Interactive CV Maker App -->
    <section aria-label="Fresher Resume Builder Application" class="w-full max-w-full min-w-0">
      <CvMakerApp initialTemplate="student" />
    </section>

    <!-- Detailed Fresher Guide -->
    <section class="space-y-10 border-t border-[color:var(--border)] pt-10">
      
      <article class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-8 space-y-6 shadow-sm">
        <h2 class="text-2xl font-bold tracking-tight text-[color:var(--fg)]">How Fresh Graduates Can Beat Experience Requirements</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 space-y-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-blue-500/10 text-xs font-bold text-blue-600 dark:text-blue-400">1</span>
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Technical Stack</h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">List specific tools, libraries, and frameworks you know (e.g. Git, SQL, Figma, Python).</p>
          </div>
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 space-y-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-blue-500/10 text-xs font-bold text-blue-600 dark:text-blue-400">2</span>
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Live Project Links</h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">Include links to your live websites, GitHub repositories, or design portfolios.</p>
          </div>
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 space-y-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-blue-500/10 text-xs font-bold text-blue-600 dark:text-blue-400">3</span>
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Verified Certificates</h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">Showcase industry certifications that validate your technical credentials.</p>
          </div>
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 space-y-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-blue-500/10 text-xs font-bold text-blue-600 dark:text-blue-400">4</span>
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Soft Skills in Action</h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">Demonstrate teamwork, fast learning, and clear documentation in your project summaries.</p>
          </div>
        </div>
      </article>

      <!-- FAQs -->
      <article class="space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">Fresher Resume FAQs</h2>
        <div class="grid gap-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 shadow-sm">
              <summary class="cursor-pointer list-none text-sm font-bold text-[color:var(--fg)] flex items-center justify-between">
                <span>{faq.question}</span>
                <span class="text-xs text-[color:var(--accent)] group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-3 text-xs leading-relaxed text-[color:var(--muted)]">{faq.answer}</p>
            </details>
          ))}
        </div>
      </article>

      <!-- Related Navigation -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-sm font-bold text-[color:var(--fg)]">Preparing for Entry-Level Salary Negotiations?</h3>
          <p class="text-xs text-[color:var(--muted)]">Use our Salary Calculator to compare hourly wages and annual compensation before accepting your offer.</p>
        </div>
        <a
          href={withBasePath('/calculators/salary-calculator/')}
          class="shrink-0 rounded-full bg-[color:var(--accent)] px-5 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-[color:var(--accent-strong)]"
        >
          Check Salary Breakdown →
        </a>
      </div>
    </section>
  </article>
</SiteLayout>
