---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Resume Length Checker — Word Count & Page Length Optimizer · ${siteName}`;
const pageDesc = 'Check resume word count, character count, estimated page count (1-page vs 2-page sweet spot), and bullet point density online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/career-tools/resume-length-checker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Career Tools', href: toAbsoluteUrl('/career-tools/') },
  { label: 'Resume Length Checker' },
];

const schemaFaq = [
  {
    question: 'What is the ideal resume word count?',
    answer: 'For a 1-page resume (0-5 years of experience), the ideal word count is 400 to 600 words. For a 2-page senior resume (5-10+ years), the recommended target is 750 to 1,200 words.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Resume Length Checker',
    url: canonicalUrl,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-len-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Resume Density &amp; Page Count Analyzer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Resume Length &amp; Word Count Checker
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Analyze your resume word count, character density, and estimated printed page count in real time.
      </p>
    </header>

    <div class="space-y-6">
      <div class="space-y-2">
        <label for="resume-text" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Paste Resume Text</label>
        <textarea
          id="resume-text"
          rows="10"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste your resume here to check length..."
        >SUMMARY
Senior Full-Stack Engineer with 6+ years designing high-throughput web applications and cloud architectures.

EXPERIENCE
Lead Software Engineer | TechCorp Inc. (2021 - Present)
• Architected Node.js and Go microservices handling 25M daily requests with 99.99% uptime.
• Reduced AWS infrastructure costs by 32% by transitioning monolithic workloads to serverless ECS containers.
• Mentored a high-performing engineering squad of 6 engineers across sprint planning and code reviews.

Software Engineer | StartUp Labs (2018 - 2021)
• Built responsive user interfaces with React, TypeScript, and Tailwind CSS.
• Optimized PostgreSQL query indexes, improving page load speeds by 450ms.

SKILLS
JavaScript, TypeScript, React, Node.js, Go, PostgreSQL, Redis, Docker, Kubernetes, AWS.</textarea>
      </div>

      <!-- Stats Grid -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 text-center">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Word Count</span>
          <p id="words-num" class="text-3xl font-extrabold text-emerald-500">0</p>
          <p id="target-eval" class="text-[10px] font-semibold text-[color:var(--fg)]">-</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Estimated Pages</span>
          <p id="pages-num" class="text-3xl font-extrabold text-[color:var(--fg)]">~1 Page</p>
          <p class="text-[10px] text-[color:var(--muted)]">Standard 10-11pt Font</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Bullet Points</span>
          <p id="bullets-num" class="text-3xl font-extrabold text-blue-500">0</p>
          <p class="text-[10px] text-[color:var(--muted)]">Action Bullets</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Reading Time</span>
          <p id="read-time" class="text-3xl font-extrabold text-purple-500">0s</p>
          <p class="text-[10px] text-[color:var(--muted)]">Recruiter Scan Time (~7s)</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-len-app]');
      if (!root) return;

      const textIn = root.querySelector('#resume-text');
      const wordsNum = root.querySelector('#words-num');
      const targetEval = root.querySelector('#target-eval');
      const pagesNum = root.querySelector('#pages-num');
      const bulletsNum = root.querySelector('#bullets-num');
      const readTime = root.querySelector('#read-time');

      function analyze() {
        const text = textIn.value;
        const words = (text.match(/\S+/g) || []).length;
        const bullets = (text.match(/^[•\-\*]\s+/gm) || []).length;

        wordsNum.textContent = words;
        bulletsNum.textContent = bullets;

        // Page calculation (~450-500 words per formatted resume page)
        if (words === 0) {
          pagesNum.textContent = '0 Pages';
          targetEval.textContent = 'Enter text';
          readTime.textContent = '0s';
          return;
        }

        const estPages = Math.max(1, Math.round((words / 480) * 10) / 10);
        pagesNum.textContent = `~${estPages} ${estPages === 1 ? 'Page' : 'Pages'}`;

        if (words < 350) targetEval.textContent = 'Too short (<350 words)';
        else if (words <= 650) targetEval.textContent = 'Ideal 1-Page Resume';
        else if (words <= 1100) targetEval.textContent = 'Ideal 2-Page Resume';
        else targetEval.textContent = 'Long (>1,100 words)';

        const seconds = Math.round((words / 200) * 60);
        readTime.textContent = seconds > 60 ? `${Math.round(seconds / 60)}m` : `${seconds}s`;
      }

      textIn.addEventListener('input', analyze);
      analyze();
    })();
  </script>
</SiteLayout>
