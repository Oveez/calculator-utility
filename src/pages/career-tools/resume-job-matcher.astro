---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Resume & Job Matcher — ATS Match Score & Keyword Gap Analyzer · ${siteName}`;
const pageDesc = 'Compare your resume against a job description to calculate match score %, identify missing keywords, and optimize for ATS scans. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/career-tools/resume-job-matcher/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Career Tools', href: toAbsoluteUrl('/career-tools/') },
  { label: 'Resume & Job Matcher' },
];

const schemaFaq = [
  {
    question: 'How is the resume match score calculated?',
    answer: 'It tokenizes both texts, removes common stopwords, and calculates the Jaccard and frequency-weighted keyword overlap ratio between the job description and your resume.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Resume & Job Matcher',
    url: canonicalUrl,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-match-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>ATS Keyword Gap Analyzer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Resume &amp; Job Description Matcher
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Compare your resume against a target job description to pinpoint match score and missing keywords.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="space-y-2">
          <label for="resume-text" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Your Resume Text</label>
          <textarea
            id="resume-text"
            rows="8"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste your resume here..."
          >Software engineer with 4 years building React, TypeScript, and Node.js web apps. Familiar with PostgreSQL and Git.</textarea>
        </div>

        <div class="space-y-2">
          <label for="jd-text" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Target Job Description</label>
          <textarea
            id="jd-text"
            rows="8"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste job description here..."
          >Seeking engineer with React, TypeScript, Node.js, Docker, Kubernetes, AWS, and GraphQL experience.</textarea>
        </div>
      </div>

      <!-- Match Score Hero -->
      <div class="grid gap-4 sm:grid-cols-3 text-center">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">ATS Match Score</span>
          <p id="match-pct" class="text-4xl font-black text-emerald-500">0%</p>
          <p id="match-grade" class="text-[10px] font-semibold text-[color:var(--fg)]">-</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Matched Keywords</span>
          <p id="matched-count" class="text-4xl font-black text-blue-500">0</p>
          <p class="text-[10px] text-[color:var(--muted)]">Found in Both</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Missing Skills</span>
          <p id="missing-count" class="text-4xl font-black text-amber-500">0</p>
          <p class="text-[10px] text-[color:var(--muted)]">Needs Adding</p>
        </div>
      </div>

      <!-- Missing Keywords Breakdown -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-500">Missing Keywords from Job Posting</span>
        <div id="missing-tags" class="flex flex-wrap gap-2 pt-1 font-mono text-xs"></div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-match-app]');
      if (!root) return;

      const resumeIn = root.querySelector('#resume-text');
      const jdIn = root.querySelector('#jd-text');
      const matchPct = root.querySelector('#match-pct');
      const matchGrade = root.querySelector('#match-grade');
      const matchedCount = root.querySelector('#matched-count');
      const missingCount = root.querySelector('#missing-count');
      const missingTags = root.querySelector('#missing-tags');

      const STOP_WORDS = new Set([
        'the', 'and', 'for', 'with', 'that', 'this', 'from', 'have', 'are', 'was', 'were',
        'will', 'our', 'you', 'your', 'about', 'must', 'has', 'can', 'not', 'but', 'all',
        'any', 'job', 'work', 'years', 'experience', 'team', 'role', 'looking', 'candidate'
      ]);

      function getKeywords(text) {
        const words = text.toLowerCase().match(/\b[a-z0-9+#.-]{2,}\b/g) || [];
        return new Set(words.filter(w => !STOP_WORDS.has(w) && isNaN(Number(w))));
      }

      function compare() {
        const resumeKws = getKeywords(resumeIn.value);
        const jdKws = getKeywords(jdIn.value);

        if (jdKws.size === 0) {
          matchPct.textContent = '0%';
          matchGrade.textContent = 'Paste job description';
          matchedCount.textContent = '0';
          missingCount.textContent = '0';
          missingTags.innerHTML = '';
          return;
        }

        let matched = 0;
        const missing = [];

        jdKws.forEach(kw => {
          if (resumeKws.has(kw)) {
            matched++;
          } else {
            missing.push(kw);
          }
        });

        const pct = Math.round((matched / jdKws.size) * 100);
        matchPct.textContent = `${pct}%`;
        matchedCount.textContent = matched;
        missingCount.textContent = missing.length;

        if (pct >= 80) matchGrade.textContent = 'Excellent ATS Match';
        else if (pct >= 60) matchGrade.textContent = 'Good Alignment';
        else if (pct >= 40) matchGrade.textContent = 'Moderate Match';
        else matchGrade.textContent = 'Low Keyword Match';

        if (missing.length === 0) {
          missingTags.innerHTML = '<span class="text-xs text-emerald-500 font-bold">All key skills from job posting found in resume!</span>';
        } else {
          missingTags.innerHTML = missing.map(kw => `
            <span class="rounded-xl border border-amber-500/30 bg-amber-500/10 px-3 py-1 font-semibold text-amber-600 dark:text-amber-400">
              ${kw}
            </span>
          `).join('');
        }
      }

      resumeIn.addEventListener('input', compare);
      jdIn.addEventListener('input', compare);
      compare();
    })();
  </script>
</SiteLayout>
