---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const parameterGuide = [
  { id: 'shopPrice', name: 'Retail Selling Price', description: 'Product list price paid by online shoppers at your Shopify storefront checkout.', whyItMatters: 'The gross transaction revenue earned on each fulfilled customer order.', typicalRange: '$15.00 to $300.00+', unit: '$' },
  { id: 'shopCogs', name: 'Product COGS (Landed Cost)', description: 'Direct unit manufacturing cost plus sea or air freight forwarding and customs import tariffs.', whyItMatters: 'Defines your gross margin before paid digital advertising and fulfillment expenses.', typicalRange: '$3.00 to $80.00', unit: '$' },
  { id: 'shopAd', name: 'Ad Spend Per Order (CAC)', description: 'Customer Acquisition Cost: blended paid ad spend (Meta, Google Search, TikTok) needed to generate one sale.', whyItMatters: 'Usually the single largest expense line item for modern direct-to-consumer (DTC) brands.', typicalRange: '$5.00 to $60.00+', unit: '$' },
  { id: 'shopShip', name: 'Net Shipping & Box Cost', description: 'Third-party logistics (3PL) pick-and-pack fee, custom box, and carrier postage minus any shipping charged to buyer.', whyItMatters: 'Unrecovered shipping subsidies directly subtract dollar-for-dollar from net margins.', typicalRange: '$3.00 to $15.00', unit: '$' },
  { id: 'shopPlan', name: 'Shopify Payments Plan Tier', description: 'Payment processing percentage fee charged on credit card checkouts (Basic: 2.9%, Shopify: 2.7%, Advanced: 2.5% + $0.30).', whyItMatters: 'Higher monthly tier plans yield lower gateway fees, saving substantial money at high order volumes.', typicalRange: '2.5% to 2.9% + $0.30', unit: 'rate' },
  { id: 'shopOrders', name: 'Monthly Order Volume', description: 'Total monthly orders shipped through your online storefront.', whyItMatters: 'Multiplies per-order unit economics into aggregate monthly store take-home profit.', typicalRange: '50 to 5,000+ orders', unit: 'orders' },
  { id: 'breakevenPrice', name: 'Break-Even Sale Price', description: 'The absolute lowest retail price required to cover COGS, CAC ad spend, shipping, and credit card gateway fees.', whyItMatters: 'Sets the baseline floor for discounting, flash sales, and wholesale pricing.', typicalRange: 'Calculated dynamically', unit: '$' },
];

const pageTitle = `Shopify Profit Calculator | Ecommerce Margins & Ad Spend (CAC) · ${siteName}`;
const pageDesc = 'Calculate your true net profit margin on Shopify factoring in payment gateway fees, Customer Acquisition Cost (ad spend), shipping, and return allowances.';
const canonicalUrl = toAbsoluteUrl('/business-tools/shopify-profit-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Business Tools', href: toAbsoluteUrl('/business-tools/') },
  { label: 'Shopify Profit Calculator' },
];

const faqs = [
  {
    question: 'How do Shopify payment gateway fees work?',
    answer: 'Standard Shopify Payments rates depend on your plan: Basic Shopify charges 2.9% + $0.30 per online transaction, Shopify Plan charges 2.7% + $0.30, and Advanced Shopify charges 2.5% + $0.30. Using external gateways incurs additional transaction fees.',
  },
  {
    question: 'Why must Customer Acquisition Cost (CAC) be factored into profit calculations?',
    answer: 'In modern direct-to-consumer (DTC) ecommerce, paid advertising (Meta, Google, TikTok Ads) often represents 25% to 45% of total revenue. Failing to account for per-order ad spend turns apparently profitable products into loss-making ventures.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Shopify Profit Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Direct-To-Consumer Ecommerce Analytics</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Shopify Profit Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Calculate your real DTC profit margins per order and monthly store earnings after accounting for COGS, shipping, ad spend (CAC), payment gateway cuts, and refund reserves.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-shopify-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Order Economics</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="shop-price" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Retail Price ($)</label>
              <input id="shop-price" type="number" min="0" step="0.5" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-shop-price placeholder="e.g. 48.00" />
            </div>
            <div>
              <label for="shop-cogs" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Product COGS ($)</label>
              <input id="shop-cogs" type="number" min="0" step="0.5" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-shop-cogs placeholder="e.g. 12.50" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="shop-ad" class="block text-xs font-medium text-[color:var(--muted)]">Ad Spend Per Order (CAC $)</label>
              <input id="shop-ad" type="number" min="0" step="0.5" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-shop-ad placeholder="e.g. 15.00" />
            </div>
            <div>
              <label for="shop-ship" class="block text-xs font-medium text-[color:var(--muted)]">Net Shipping &amp; Box ($)</label>
              <input id="shop-ship" type="number" min="0" step="0.5" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-shop-ship placeholder="e.g. 5.50" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label for="shop-plan" class="block text-xs font-medium text-[color:var(--muted)]">Shopify Plan Rate</label>
              <select id="shop-plan" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-shop-plan>
                <option value="2.9" selected>Basic Plan (2.9% + $0.30)</option>
                <option value="2.7">Shopify Plan (2.7% + $0.30)</option>
                <option value="2.5">Advanced Plan (2.5% + $0.30)</option>
              </select>
            </div>
            <div>
              <label for="shop-orders" class="block text-xs font-medium text-[color:var(--muted)]">Monthly Order Volume</label>
              <input id="shop-orders" type="number" min="1" step="25" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-shop-orders placeholder="e.g. 250" />
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Net Profitability</span>
              <button
                type="button"
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition cursor-pointer"
                data-copy-btn
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </button>
            </div>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Net Profit Per Order</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-cyan-600 dark:text-cyan-400 dark:text-cyan-400" data-net-order>
                $13.31
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-margin-label>
                Net Margin: 27.7%
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Monthly Net Store Profit:</span>
                <span class="font-bold text-[color:var(--fg)]" data-monthly-net>$3,327.50 / mo</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Gateway Fees Per Order:</span>
                <span class="font-bold text-red-500" data-gateway-order>-$1.69</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="text-[color:var(--muted)]">Break-Even Sale Price:</span>
                <span class="font-mono font-bold text-[color:var(--accent)]" data-breakeven-price>$34.69</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formula & DTC Unit Economics -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">DTC Unit Economics</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" /><span>How Shopify Store Margins Are Calculated</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">1. Net Profit Per Order</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Profit = Retail Price - [COGS + CAC + Net Shipping + Gateway Fee]
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Where Gateway Fee = (Retail Price × Plan Rate) + $0.30. Fully deducts customer acquisition ad spend.
          </p>
        </div>

        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">2. Break-Even Retail Price</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Break-Even = [COGS + CAC + Net Shipping + $0.30] ÷ (1 - Plan Rate)
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Accounts for the variable gateway percentage so every fixed unit cost is completely recovered.
          </p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Step-By-Step Walkthrough</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" /><span>Worked Example: $48.00 DTC Product on Basic Plan</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">1. Unit Economics</p>
          <p class="text-[color:var(--muted)]">Retail Price: $48.00.</p>
          <p class="text-[color:var(--muted)]">Product COGS: $12.50.</p>
          <p class="text-[color:var(--muted)]">CAC (Ad Spend): $15.00.</p>
          <p class="text-[color:var(--muted)]">Net Shipping &amp; Box: $5.50.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">2. Gateway &amp; Deductions</p>
          <p class="text-[color:var(--muted)]">Basic Rate: 2.9% + $0.30.</p>
          <p class="text-[color:var(--muted)]">Gateway = ($48 × 0.029) + $0.30 = <strong>$1.69</strong>.</p>
          <p class="text-[color:var(--muted)]">Total Costs = $12.50 + $15.00 + $5.50 + $1.69 = <strong>$34.69</strong>.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">3. Net Profit &amp; Volume</p>
          <p class="text-[color:var(--muted)]">Profit/Order: $48 - $34.69 = <strong>$13.31</strong> (27.7%).</p>
          <p class="text-[color:var(--muted)]">Monthly (250 orders) = 250 × $13.31 = <strong>$3,327.50/mo</strong>.</p>
          <p class="text-[color:var(--muted)]">Break-Even Price: <strong>$34.69</strong>.</p>
        </div>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-shopify-app]');
      if (!root) return;

      const inPrice = root.querySelector('[data-shop-price]');
      const inCogs = root.querySelector('[data-shop-cogs]');
      const inAd = root.querySelector('[data-shop-ad]');
      const inShip = root.querySelector('[data-shop-ship]');
      const inPlan = root.querySelector('[data-shop-plan]');
      const inOrders = root.querySelector('[data-shop-orders]');
      const outNet = root.querySelector('[data-net-order]');
      const outMargin = root.querySelector('[data-margin-label]');
      const outMoNet = root.querySelector('[data-monthly-net]');
      const outGateway = root.querySelector('[data-gateway-order]');
      const outBreak = root.querySelector('[data-breakeven-price]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      function update() {
        const price = Math.max(0, (inPrice.value !== '' && !isNaN(parseFloat(inPrice.value)) ? parseFloat(inPrice.value) : 0));
        const cogs = Math.max(0, (inCogs.value !== '' && !isNaN(parseFloat(inCogs.value)) ? parseFloat(inCogs.value) : 0));
        const ad = Math.max(0, (inAd.value !== '' && !isNaN(parseFloat(inAd.value)) ? parseFloat(inAd.value) : 0));
        const ship = Math.max(0, (inShip.value !== '' && !isNaN(parseFloat(inShip.value)) ? parseFloat(inShip.value) : 0));
        const orders = Math.max(1, (inOrders.value !== '' && !isNaN(parseInt(inOrders.value, 10)) ? parseInt(inOrders.value, 10) : 0));
        const rate = (inPlan.value !== '' && !isNaN(parseFloat(inPlan.value)) ? parseFloat(inPlan.value) : 0) / 100;

        const gateway = (price * rate) + 0.30;
        const totalCosts = cogs + ad + ship + gateway;
        const profit = price - totalCosts;
        const margin = price > 0 ? (profit / price) * 100 : 0;
        const monthly = profit * orders;

        const breakEven = 1 - rate > 0 ? (cogs + ad + ship + 0.30) / (1 - rate) : 0;

        if (outNet) outNet.textContent = `$${profit.toFixed(2)}`;
        if (outMargin) outMargin.textContent = `Net Margin: ${margin.toFixed(1)}%`;
        if (outMoNet) outMoNet.textContent = `$${monthly.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} / mo`;
        if (outGateway) outGateway.textContent = `-$${gateway.toFixed(2)}`;
        if (outBreak) outBreak.textContent = `$${breakEven.toFixed(2)}`;
      }

      inPrice.addEventListener('input', update);
      inCogs.addEventListener('input', update);
      inAd.addEventListener('input', update);
      inShip.addEventListener('input', update);
      inPlan.addEventListener('change', update);
      inOrders.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inPrice.value = '';
          inCogs.value = '';
          inAd.value = '';
          inShip.value = '';
          inPlan.value = '';
          inOrders.value = '';
          update();
        });
      }

      const copyBtn = root.querySelector('[data-copy-btn]');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = `Shopify Economics Summary:\n• Net Profit/Order: ${outNet?.textContent || ''}\n• ${outMargin?.textContent || ''}\n• Monthly Net Store Profit: ${outMoNet?.textContent || ''}\n• Gateway Fee/Order: ${outGateway?.textContent || ''}\n• Break-Even Price: ${outBreak?.textContent || ''}`;
          try {
            await navigator.clipboard.writeText(text);
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>Copied!</span>';
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          } catch (e) {
            console.error('Clipboard copy failed', e);
          }
        });
      }

      update();
    })();
  </script>
</SiteLayout>
