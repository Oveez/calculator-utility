---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const parameterGuide = [
  { id: 'itemPrice', name: 'Item Sale Price', description: 'The retail listing price the buyer pays for your handmade or vintage item.', whyItMatters: 'Primary revenue driver that sets the baseline for percentage transaction and payment fees.', typicalRange: '$5.00 to $200.00+', unit: '$' },
  { id: 'buyerShip', name: 'Shipping Charged to Buyer', description: 'Postage amount billed to the customer at checkout.', whyItMatters: 'Etsy subjects buyer-paid shipping to both the 6.5% transaction fee and payment processing fee.', typicalRange: '$0.00 (free) to $25.00', unit: '$' },
  { id: 'itemCogs', name: 'Material / COGS', description: 'Direct out-of-pocket cost for raw materials, blanks, vinyl, packaging liners, or manufacturing.', whyItMatters: 'Forms the direct product cost that must be recovered on every single order.', typicalRange: '$1.00 to $75.00', unit: '$' },
  { id: 'sellerShip', name: 'Actual Postage Paid', description: 'Real carrier postage rate paid to USPS, UPS, or Royal Mail.', whyItMatters: 'If your actual postage exceeds what the buyer was charged, the shortfall cuts into your profit.', typicalRange: '$3.50 to $25.00', unit: '$' },
  { id: 'packCost', name: 'Packaging & Mailer Cost', description: 'Cost of padded mailers, rigid boxes, branded thank-you cards, tissue, and thermal shipping labels.', whyItMatters: 'Often overlooked, packaging expenses can cost $1.00 to $3.00+ per shipment.', typicalRange: '$0.50 to $4.00', unit: '$' },
  { id: 'offsiteAds', name: 'Etsy Offsite Ads', description: 'Etsy’s external search and social advertising program (12% for shops over $10k/yr, 15% optional for smaller shops).', whyItMatters: 'Only deducted when a sale directly originates from an offsite ad click, taking a sizable cut.', typicalRange: '0%, 12%, or 15%', unit: '%' },
  { id: 'breakevenPrice', name: 'Break-Even Selling Price', description: 'The exact minimum price you must charge to make $0 net profit after all platform fees and costs.', whyItMatters: 'Guarantees you never sell at a financial loss during sales or promotions.', typicalRange: 'Calculated dynamically', unit: '$' },
];

const pageTitle = `Etsy Fee & Profit Calculator | Seller Pricing & Margins · ${siteName}`;
const pageDesc = 'Calculate your real Etsy net profit margins, listing fees, 6.5% transaction fees, payment processing, and return on investment (ROI) before setting prices.';
const canonicalUrl = toAbsoluteUrl('/business-tools/etsy-profit-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Business Tools', href: toAbsoluteUrl('/business-tools/') },
  { label: 'Etsy Profit Calculator' },
];

const faqs = [
  {
    question: 'What fees does Etsy deduct from each sale in 2026?',
    answer: 'Etsy deducts: (1) $0.20 listing fee per item, (2) 6.5% transaction fee on total price + buyer shipping, (3) Payment processing fee (US default: 3.0% + $0.25), and (4) Optional Offsite Ads fee (12% to 15% if customer arrives via Etsy ads).',
  },
  {
    question: 'How do I calculate my break-even sale price on Etsy?',
    answer: 'Break-even price is: Break-Even = [Product Cost + Packaging + Shipping Diff + Listing Fee + Flat Payment Fee] ÷ [1 - (Transaction Rate + Payment Rate + Ad Rate)]. Our calculator computes this automatically.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Etsy Profit Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Handmade &amp; Marketplace Commerce</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Etsy Fee &amp; Profit Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Never undercharge on Etsy again. Input your product COGS, shipping charges, and packaging costs to view your net take-home profit, total marketplace deductions, and break-even selling price.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-etsy-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Listing &amp; Cost Inputs</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="item-price" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Item Sale Price ($)</label>
              <input id="item-price" type="number" min="0" step="0.5" value="28.00" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-item-price />
            </div>
            <div>
              <label for="buyer-ship" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Shipping Charged ($)</label>
              <input id="buyer-ship" type="number" min="0" step="0.5" value="4.50" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-buyer-ship />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="item-cogs" class="block text-xs font-medium text-[color:var(--muted)]">Item Material/COGS ($)</label>
              <input id="item-cogs" type="number" min="0" step="0.5" value="6.50" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-cogs />
            </div>
            <div>
              <label for="seller-ship" class="block text-xs font-medium text-[color:var(--muted)]">Actual Postage Paid ($)</label>
              <input id="seller-ship" type="number" min="0" step="0.5" value="4.25" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-seller-ship />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label for="pack-cost" class="block text-xs font-medium text-[color:var(--muted)]">Packaging &amp; Mailer ($)</label>
              <input id="pack-cost" type="number" min="0" step="0.1" value="1.00" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-pack-cost />
            </div>
            <div>
              <label for="offsite-ads" class="block text-xs font-medium text-[color:var(--muted)]">Etsy Offsite Ads</label>
              <select id="offsite-ads" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-offsite-ads>
                <option value="0" selected>Disabled (0%)</option>
                <option value="12">Standard Rate (12%)</option>
                <option value="15">Required Tier (15%)</option>
              </select>
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Profitability Summary</span>
              <button
                type="button"
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition cursor-pointer"
                data-copy-btn
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </button>
            </div>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Net Profit Per Order</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-cyan-600 dark:text-cyan-400 dark:text-cyan-400" data-net-profit>
                $17.27
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-margin-pct>
                Profit Margin: 53.1% (ROI: 147%)
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Total Etsy Deductions:</span>
                <span class="font-bold text-red-500" data-total-fees>-$3.48</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Total Production &amp; Postage:</span>
                <span class="font-bold text-[color:var(--fg)]" data-base-costs>$11.75</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="text-[color:var(--muted)]">Break-Even Selling Price:</span>
                <span class="font-mono font-bold text-[color:var(--accent)]" data-breakeven-price>$13.31</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formula & Platform Deductions -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Etsy Fee Architecture</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)]">How Marketplace Fees &amp; Profit Margins Are Computed</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">1. Total Marketplace Deductions</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Fees = $0.20 + (Rev × 6.5%) + (Rev × 3.0% + $0.25) + (Rev × Ads%)
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Where Revenue = Item Price + Buyer Shipping Charged. Both transaction and payment fees apply to shipping charges.
          </p>
        </div>

        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">2. Net Profit &amp; Break-Even Price</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Break-Even = [COGS + Mailer + Shipping Shortfall + $0.45] ÷ [1 - Fee Rates]
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Solves for the exact selling price at which Total Revenue minus direct costs and percentage deductions equals zero.
          </p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Step-By-Step Walkthrough</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" /><span>Worked Example: $28.00 Handmade Item with $4.50 Shipping</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">1. Transaction Revenue</p>
          <p class="text-[color:var(--muted)]">Item price = $28.00.</p>
          <p class="text-[color:var(--muted)]">Buyer shipping = $4.50.</p>
          <p class="text-[color:var(--muted)]">Total Revenue = <strong>$32.50</strong>.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">2. Direct Costs &amp; Fees</p>
          <p class="text-[color:var(--muted)]">COGS ($6.50) + Postage ($4.25) + Mailer ($1.00) = $11.75.</p>
          <p class="text-[color:var(--muted)]">Etsy listing: $0.20.</p>
          <p class="text-[color:var(--muted)]">Transaction (6.5% of $32.50): $2.11.</p>
          <p class="text-[color:var(--muted)]">Processing (3% + $0.25): $1.23.</p>
          <p class="text-[color:var(--muted)]">Total Etsy Deductions = <strong>-$3.54</strong>.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">3. Net Profit &amp; Margin</p>
          <p class="text-[color:var(--muted)]">Net Profit: $32.50 - $11.75 - $3.54 = <strong>$17.21</strong>.</p>
          <p class="text-[color:var(--muted)]">Margin: ($17.21 ÷ $32.50) = <strong>53.0%</strong>.</p>
          <p class="text-[color:var(--muted)]">Break-Even Price: <strong>$13.31</strong>.</p>
        </div>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-etsy-app]');
      if (!root) return;

      const inPrice = root.querySelector('[data-item-price]');
      const inBuyerShip = root.querySelector('[data-buyer-ship]');
      const inCogs = root.querySelector('[data-item-cogs]');
      const inSellerShip = root.querySelector('[data-seller-ship]');
      const inPack = root.querySelector('[data-pack-cost]');
      const inAds = root.querySelector('[data-offsite-ads]');
      const outNet = root.querySelector('[data-net-profit]');
      const outMargin = root.querySelector('[data-margin-pct]');
      const outFees = root.querySelector('[data-total-fees]');
      const outBase = root.querySelector('[data-base-costs]');
      const outBreak = root.querySelector('[data-breakeven-price]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      function update() {
        const price = Math.max(0, parseFloat(inPrice.value || '0'));
        const buyerShip = Math.max(0, parseFloat(inBuyerShip.value || '0'));
        const totalRev = price + buyerShip;

        const cogs = Math.max(0, parseFloat(inCogs.value || '0'));
        const sellerShip = Math.max(0, parseFloat(inSellerShip.value || '0'));
        const pack = Math.max(0, parseFloat(inPack.value || '0'));
        const baseCost = cogs + sellerShip + pack;

        const adRate = parseFloat(inAds.value || '0') / 100;
        const lFee = 0.20;
        const tFee = totalRev * 0.065;
        const pFee = (totalRev * 0.03) + 0.25;
        const aFee = totalRev * adRate;
        const totalFees = lFee + tFee + pFee + aFee;

        const totalCost = baseCost + totalFees;
        const profit = totalRev - totalCost;
        const margin = totalRev > 0 ? (profit / totalRev) * 100 : 0;
        const roi = totalCost > 0 ? (profit / totalCost) * 100 : 0;

        const feeComb = 0.065 + 0.03 + adRate;
        const fixed = cogs + pack + lFee + 0.25 + Math.max(0, sellerShip - buyerShip);
        const breakEven = 1 - feeComb > 0 ? fixed / (1 - feeComb) : 0;

        if (outNet) outNet.textContent = `$${profit.toFixed(2)}`;
        if (outMargin) outMargin.textContent = `Profit Margin: ${margin.toFixed(1)}% (ROI: ${roi.toFixed(0)}%)`;
        if (outFees) outFees.textContent = `-$${totalFees.toFixed(2)}`;
        if (outBase) outBase.textContent = `$${baseCost.toFixed(2)}`;
        if (outBreak) outBreak.textContent = `$${breakEven.toFixed(2)}`;
      }

      inPrice.addEventListener('input', update);
      inBuyerShip.addEventListener('input', update);
      inCogs.addEventListener('input', update);
      inSellerShip.addEventListener('input', update);
      inPack.addEventListener('input', update);
      inAds.addEventListener('change', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inPrice.value = '28.00';
          inBuyerShip.value = '4.50';
          inCogs.value = '6.50';
          inSellerShip.value = '4.25';
          inPack.value = '1.00';
          inAds.value = '0';
          update();
        });
      }

      const copyBtn = root.querySelector('[data-copy-btn]');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = `Etsy Profit Breakdown:\n• Net Profit: ${outNet?.textContent || ''}\n• ${outMargin?.textContent || ''}\n• Total Etsy Fees: ${outFees?.textContent || ''}\n• Production & Postage: ${outBase?.textContent || ''}\n• Break-Even Price: ${outBreak?.textContent || ''}`;
          try {
            await navigator.clipboard.writeText(text);
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>Copied!</span>';
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          } catch (e) {
            console.error('Clipboard copy failed', e);
          }
        });
      }

      update();
    })();
  </script>
</SiteLayout>
