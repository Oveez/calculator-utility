---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const parameterGuide = [
  { id: 'totalSales', name: 'Total Closed Sales Revenue', description: 'Gross revenue, contract value, or closed deals generated during the commission payout period.', whyItMatters: 'The underlying volume foundation upon which commission percentages and accelerators are calculated.', typicalRange: '$5,000 to $500,000+', unit: '$' },
  { id: 'commStructure', name: 'Commission Plan Structure', description: 'Flat percentage rate vs graduated quota accelerators (5% on first $10k, 8% on next $15k, 12% over $25k).', whyItMatters: 'Tiered accelerators dramatically incentivize sales reps to surpass quotas and close enterprise deals.', typicalRange: 'Flat or Tiered Accelerators', unit: 'model' },
  { id: 'flatRate', name: 'Flat Commission Rate', description: 'Fixed percentage paid out across all eligible revenue generated from the first dollar.', whyItMatters: 'Standard in direct sales, independent broker agencies, and simple B2B product sales.', typicalRange: '3.0% to 20.0%', unit: '%' },
  { id: 'basePay', name: 'Monthly Base Salary', description: 'Guaranteed base pay received regardless of sales quotas achieved in that billing month.', whyItMatters: 'Provides essential living security, creating an On-Target Earnings (OTE) compensation structure.', typicalRange: '$0 to $12,000+', unit: '$' },
  { id: 'effectiveRate', name: 'Effective Commission Rate', description: 'The true blended percentage of commission earned across all tier brackets (Commission ÷ Sales × 100).', whyItMatters: 'Reveals the real yield per dollar sold under multi-tier graduated compensation plans.', typicalRange: '5.0% to 15.0%', unit: '%' },
];

const pageTitle = `Commission Calculator | Sales Percentages & Tiered Accelerators · ${siteName}`;
const pageDesc = 'Calculate sales rep commission earnings across flat percentage rates, tiered performance accelerator brackets, and base salary plus commission.';
const canonicalUrl = toAbsoluteUrl('/business-tools/commission-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Business Tools', href: toAbsoluteUrl('/business-tools/') },
  { label: 'Commission Calculator' },
];

const faqs = [
  {
    question: 'How do tiered commission structures work?',
    answer: 'In a tiered or graduated commission plan, different portions of your sales volume are paid at increasing percentage rates (e.g. 5% on the first $10,000, 8% between $10,000 and $25,000, and 12% on everything above $25,000).',
  },
  {
    question: 'How is total sales compensation calculated?',
    answer: 'Total Compensation = Base Salary + (Total Sales Volume × Effective Commission Rate).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Sales Commission Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Sales &amp; Compensation Analytics</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Sales Commission Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Calculate sales compensation accurately. Model flat percentage payouts, base salary packages, and tiered quota accelerator brackets.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-comm-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Sales &amp; Rate Structure</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="total-sales" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Total Closed Sales Revenue ($)
            </label>
            <input
              id="total-sales"
              type="number"
              min="0"
              step="1000"
              value="65000"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none"
              data-total-sales
            />
          </div>

          <div class="space-y-1.5">
            <label for="comm-structure" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Commission Plan Structure
            </label>
            <select
              id="comm-structure"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-sm font-semibold text-[color:var(--fg)] outline-none"
              data-comm-structure
            >
              <option value="flat" selected>Flat Percentage Rate</option>
              <option value="tiered">Tiered Accelerator (5% / 8% / 12%)</option>
            </select>
          </div>

          <div class="space-y-1.5" data-flat-rate-wrap>
            <label for="flat-rate" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Commission Rate (%)
            </label>
            <input
              id="flat-rate"
              type="number"
              min="0"
              max="50"
              step="0.5"
              value="8.5"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none"
              data-flat-rate
            />
          </div>

          <div class="space-y-1.5 pt-1">
            <label for="base-pay" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Monthly Base Salary ($ Optional)
            </label>
            <input
              id="base-pay"
              type="number"
              min="0"
              step="500"
              value="3000"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-sm font-semibold text-[color:var(--fg)] outline-none"
              data-base-pay
            />
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Earnings Breakdown</span>
              <button
                type="button"
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition cursor-pointer"
                data-copy-btn
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </button>
            </div>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Total Commission Earned</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-commission>
                $5,525.00
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-effective-rate>
                Effective Rate: 8.50% on $65,000 sales
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Base Salary:</span>
                <span class="font-bold text-[color:var(--fg)]" data-disp-base>$3,000.00</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="font-bold text-[color:var(--fg)]">Total Payout (Base + Commission):</span>
                <span class="font-bold text-[color:var(--accent)] text-sm" data-res-total-pay>$8,525.00</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formula & Compensation Mechanics -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Sales Compensation Math</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)]">How Commission &amp; Accelerators Are Computed</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">1. Flat Rate Model</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Commission = Closed Sales × (Rate ÷ 100)
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Applies a uniform percentage from dollar one across all generated revenue.
          </p>
        </div>

        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">2. Tiered Accelerator Model</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Commission = (Tier 1 × 5%) + (Tier 2 × 8%) + (Tier 3 × 12%)
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Graduated bracket structure (Tier 1: $0–$10k, Tier 2: $10k–$25k, Tier 3: &gt;$25k) rewarding top performance.
          </p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Step-By-Step Walkthrough</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" /><span>Worked Example: $65,000 Sales with $3,000 Base Salary</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">1. Flat Rate (8.5%)</p>
          <p class="text-[color:var(--muted)]">Closed sales = $65,000.</p>
          <p class="text-[color:var(--muted)]">Commission = $65,000 × 0.085 = <strong>$5,525.00</strong>.</p>
          <p class="text-[color:var(--muted)]">Total Pay = $3,000 + $5,525 = <strong>$8,525.00</strong>.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">2. Tiered Accelerator</p>
          <p class="text-[color:var(--muted)]">Tier 1 ($10k @ 5%) = $500.</p>
          <p class="text-[color:var(--muted)]">Tier 2 ($15k @ 8%) = $1,200.</p>
          <p class="text-[color:var(--muted)]">Tier 3 ($40k @ 12%) = $4,800.</p>
          <p class="text-[color:var(--muted)]">Tiered Commission = <strong>$6,500.00</strong>.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">3. Comparison &amp; Yield</p>
          <p class="text-[color:var(--muted)]">Flat Effective Rate = 8.50%.</p>
          <p class="text-[color:var(--muted)]">Tiered Effective Rate = 10.00%.</p>
          <p class="text-[color:var(--muted)]">Tiered Accelerator adds <strong>+$975.00</strong> in incentive pay.</p>
        </div>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-comm-app]');
      if (!root) return;

      const inSales = root.querySelector('[data-total-sales]');
      const inStruct = root.querySelector('[data-comm-structure]');
      const inRate = root.querySelector('[data-flat-rate]');
      const inBase = root.querySelector('[data-base-pay]');
      const flatWrap = root.querySelector('[data-flat-rate-wrap]');
      const outComm = root.querySelector('[data-res-commission]');
      const outEff = root.querySelector('[data-effective-rate]');
      const outBase = root.querySelector('[data-disp-base]');
      const outTotal = root.querySelector('[data-res-total-pay]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      function update() {
        const sales = Math.max(0, parseFloat(inSales.value || '0'));
        const structure = inStruct.value;
        const rate = Math.max(0, parseFloat(inRate.value || '0'));
        const base = Math.max(0, parseFloat(inBase.value || '0'));

        let commission = 0;
        if (structure === 'flat') {
          flatWrap?.removeAttribute('hidden');
          commission = sales * (rate / 100);
        } else {
          flatWrap?.setAttribute('hidden', '');
          // Tiered: Up to 10k @ 5%, 10k-25k @ 8%, >25k @ 12%
          const t1 = Math.min(sales, 10000) * 0.05;
          const t2 = Math.min(Math.max(0, sales - 10000), 15000) * 0.08;
          const t3 = Math.max(0, sales - 25000) * 0.12;
          commission = t1 + t2 + t3;
        }

        const effRate = sales > 0 ? (commission / sales) * 100 : 0;
        const totalPay = base + commission;

        if (outComm) outComm.textContent = `$${commission.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (outEff) outEff.textContent = `Effective Rate: ${effRate.toFixed(2)}% on $${sales.toLocaleString()} sales`;
        if (outBase) outBase.textContent = `$${base.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (outTotal) outTotal.textContent = `$${totalPay.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }

      inSales.addEventListener('input', update);
      inStruct.addEventListener('change', update);
      inRate.addEventListener('input', update);
      inBase.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inSales.value = '65000';
          inStruct.value = 'flat';
          inRate.value = '8.5';
          inBase.value = '3000';
          update();
        });
      }

      const copyBtn = root.querySelector('[data-copy-btn]');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = `Commission Earnings Breakdown:\n• Commission: ${outComm?.textContent || ''}\n• ${outEff?.textContent || ''}\n• Base Salary: ${outBase?.textContent || ''}\n• Total Payout: ${outTotal?.textContent || ''}`;
          try {
            await navigator.clipboard.writeText(text);
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>Copied!</span>';
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          } catch (e) {
            console.error('Clipboard copy failed', e);
          }
        });
      }

      update();
    })();
  </script>
</SiteLayout>
