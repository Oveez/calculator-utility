---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSV Column Extractor — Select & Extract CSV Columns · ${siteName}`;
const pageDesc = 'Select, reorder, and extract specific columns from CSV datasets online. Upload or paste CSV, check desired columns, and export a clean filtered CSV. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/data-tools/csv-column-extractor/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Data Tools', href: toAbsoluteUrl('/data-tools/') },
  { label: 'CSV Column Extractor' },
];

const schemaFaq = [
  {
    question: 'How does CSV column extraction work?',
    answer: 'The tool parses the header row to detect all available columns. You check the columns you want to keep, and it filters each row to include only those selected fields in your new CSV export.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSV Column Extractor',
    url: canonicalUrl,
    applicationCategory: 'DataApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-col-extract-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Tabular Slicing</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSV Column Extractor &amp; Slicer
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Upload or paste large CSV files, select the specific columns you need, and export a streamlined CSV file instantly.
      </p>
    </header>

    <div class="space-y-6">
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="csv-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Source CSV Data</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="csv-in"
          rows="7"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="id,first_name,last_name,email,gender,ip_address,city,country&#10;1,Alice,Smith,alice@example.com,Female,192.168.1.1,New York,US"
        ></textarea>
      </div>

      <!-- Detected Columns Checkbox Selector -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Select Columns to Keep</span>
          <div class="flex items-center gap-3 text-xs">
            <button type="button" data-select-all class="text-[color:var(--primary)] hover:underline font-semibold">Select All</button>
            <button type="button" data-deselect-all class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Deselect All</button>
          </div>
        </div>
        <div id="col-checkboxes" class="flex flex-wrap gap-2 text-xs">
          <p class="text-[color:var(--muted)] italic">Enter CSV data above to detect columns.</p>
        </div>
        <button
          type="button"
          data-extract-btn
          class="rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Extract Selected Columns
        </button>
      </div>

      <!-- Output -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Extracted CSV Table</span>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">Download CSV</button>
          </div>
        </div>
        <textarea
          id="csv-out"
          rows="10"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Extracted CSV table will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-col-extract-app]');
      if (!root) return;

      const input = root.querySelector('#csv-in');
      const output = root.querySelector('#csv-out');
      const colCheckboxes = root.querySelector('#col-checkboxes');
      const extractBtn = root.querySelector('[data-extract-btn]');
      const selectAllBtn = root.querySelector('[data-select-all]');
      const deselectAllBtn = root.querySelector('[data-deselect-all]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      let parsedRows = [];

      function parseCsvLines(text) {
        return text.split('\n').filter(l => l.trim().length > 0).map(l => l.split(',').map(c => c.trim()));
      }

      function updateCols() {
        const text = input.value.trim();
        if (!text) {
          colCheckboxes.innerHTML = '<p class="text-[color:var(--muted)] italic">Enter CSV data above to detect columns.</p>';
          parsedRows = [];
          output.value = '';
          return;
        }

        parsedRows = parseCsvLines(text);
        if (parsedRows.length === 0) return;

        const headers = parsedRows[0];
        colCheckboxes.innerHTML = headers.map((h, i) => `
          <label class="flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 cursor-pointer hover:border-[color:var(--border-strong)]">
            <input type="checkbox" value="${i}" checked class="rounded accent-[color:var(--fg)] col-cb" />
            <span class="font-bold text-[color:var(--fg)]">${h}</span>
          </label>
        `).join('');

        extract();
      }

      function extract() {
        if (parsedRows.length === 0) return;
        const selectedIndices = Array.from(colCheckboxes.querySelectorAll('.col-cb:checked')).map(cb => parseInt(cb.value, 10));

        if (selectedIndices.length === 0) {
          output.value = 'Please select at least 1 column to extract.';
          return;
        }

        const filtered = parsedRows.map(row => {
          return selectedIndices.map(idx => row[idx] !== undefined ? row[idx] : '').join(',');
        });

        output.value = filtered.join('\n');
      }

      input.addEventListener('input', updateCols);
      extractBtn.addEventListener('click', extract);

      selectAllBtn.addEventListener('click', () => {
        colCheckboxes.querySelectorAll('.col-cb').forEach(cb => cb.checked = true);
        extract();
      });

      deselectAllBtn.addEventListener('click', () => {
        colCheckboxes.querySelectorAll('.col-cb').forEach(cb => cb.checked = false);
        extract();
      });

      sampleBtn.addEventListener('click', () => {
        input.value = `id,first_name,last_name,email,department,salary,city\n1,Alice,Smith,alice@company.com,Engineering,115000,Seattle\n2,Bob,Johnson,bob@company.com,Design,95000,San Francisco\n3,Carol,Davis,carol@company.com,Marketing,88000,Austin\n4,David,Brown,david@company.com,Sales,102000,Chicago`;
        updateCols();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
        updateCols();
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'extracted_columns.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
