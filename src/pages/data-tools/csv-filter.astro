---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSV Filter & Query Tool — Filter CSV Rows by Conditions · ${siteName}`;
const pageDesc = 'Filter CSV datasets by specific column conditions (contains, equals, numeric comparisons, regex, AND/OR logic) online. Preview matching records and export clean CSVs. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/data-tools/csv-filter/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Data Tools', href: toAbsoluteUrl('/data-tools/') },
  { label: 'CSV Filter' },
];

const schemaFaq = [
  {
    question: 'How do filter rules work on CSV files?',
    answer: 'You select a target column, choose a conditional operator (e.g. contains, equals, numeric greater-than, or regex), and enter your search query. The engine evaluates each row, outputting only records that meet your criteria.',
  },
  {
    question: 'Can I apply multiple filter rules simultaneously?',
    answer: 'Yes. You can create multiple rules combined with either "Match ALL (AND)" or "Match ANY (OR)" logic to query complex datasets.',
  },
  {
    question: 'Are regular expressions supported for advanced pattern matching?',
    answer: 'Yes. Select the "matches regex" operator to filter by patterns such as email domains, phone formats, or alphanumeric codes.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSV Filter',
    url: canonicalUrl,
    applicationCategory: 'DataApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuide = [
  {
    id: 'filter_logic',
    name: 'Combination Logic (AND / OR)',
    description: 'Dictates whether a row must satisfy every condition (AND) or at least one condition (OR).',
    whyItMatters: 'AND narrows down records (e.g., Department = "Engineering" AND Salary > 100000), while OR broadens queries (e.g., Country = "US" OR Country = "CA").',
    typicalRange: 'Match ALL (AND) vs Match ANY (OR)',
  },
  {
    id: 'operators',
    name: 'Conditional Operators',
    description: 'Comparison operators including text matching (contains, equals, starts with), numeric comparisons (>, <, >=, <=), and regex.',
    whyItMatters: 'Numeric operators automatically convert cell strings to numbers, enabling accurate price or inventory threshold filtering.',
    typicalRange: 'Text, Numeric (>, <), Empty checks, Regular Expression',
  },
  {
    id: 'case_matching',
    name: 'Case Sensitivity',
    description: 'Toggle whether uppercase and lowercase letters must match exactly.',
    whyItMatters: 'Case-insensitive searches ensure "pro", "Pro", and "PRO" all match when querying customer plans.',
    typicalRange: 'Case-Insensitive / Case-Sensitive',
  },
  {
    id: 'regex_support',
    name: 'Regular Expressions (Regex)',
    description: 'Advanced pattern matching syntax for validating phone formats, email domains, or specific ID codes.',
    whyItMatters: 'Allows matching complex patterns like "^\\d{3}-\\d{2}-\\d{4}$" or "@(gmail|outlook)\\.com$".',
    typicalRange: 'Valid JavaScript RegExp syntax',
  },
  {
    id: 'rfc4180_parsing',
    name: 'RFC 4180 Multi-Delimiter Support',
    description: 'Properly parses quoted cells with internal commas, quotes, and newlines across comma, tab, semicolon, and pipe formats.',
    whyItMatters: 'Ensures multi-word descriptions or address fields are never accidentally split into incorrect columns.',
    typicalRange: 'Standard compliant',
  },
  {
    id: 'client_privacy',
    name: '100% In-Browser Privacy',
    description: 'All filtering calculations run client-side in browser memory with zero network uploads.',
    whyItMatters: 'Confidential client spreadsheets and sensitive financial data never leave your computer.',
    typicalRange: 'Local Memory Only',
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-filter-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>100% Client-Side In-Memory Query Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSV Row Filter &amp; Query Tool
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Query and filter large CSV tables using multi-condition rules, text matching, numeric thresholds, and regular expressions. Preview matching records and export clean CSV files in seconds.
      </p>
    </header>

    <!-- Metrics Bar -->
    <div id="stats-bar" class="grid grid-cols-2 gap-3 sm:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center">
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Total Rows</span>
        <span id="stat-total" class="font-mono text-lg font-bold text-[color:var(--fg)]">0</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Matching Rows</span>
        <span id="stat-match" class="font-mono text-lg font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">0</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Filtered Out</span>
        <span id="stat-filtered" class="font-mono text-lg font-bold text-[color:var(--muted)]">0</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Match Rate</span>
        <span id="stat-rate" class="font-mono text-lg font-bold text-[color:var(--fg)]">0%</span>
      </div>
    </div>

    <!-- Main Workspace -->
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Input Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <label for="csv-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Source CSV Data</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="font-semibold text-[color:var(--primary)] hover:underline cursor-pointer">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">Clear</button>
          </div>
        </div>

        <div class="space-y-2">
          <input
            type="file"
            id="csv-file-in"
            accept=".csv,.tsv,.txt"
            class="w-full text-xs text-[color:var(--muted)] file:mr-3 file:rounded-xl file:border file:border-[color:var(--border)] file:bg-[color:var(--surface)] file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-[color:var(--fg)] hover:file:bg-[color:var(--surface-strong)]"
          />
          <textarea
            id="csv-in"
            rows="12"
            class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="id,product,category,price,inventory,status&#10;1,Wireless Mouse,Electronics,29.99,150,In Stock&#10;2,Desk Pad,Office,14.50,0,Out of Stock"
          ></textarea>
        </div>

        <!-- Filter Rules Builder -->
        <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
          <div class="flex items-center justify-between">
            <span class="font-bold uppercase tracking-wider text-[color:var(--fg)]">Filter Conditions</span>
            <div class="flex items-center gap-2">
              <label for="logic-select" class="text-[11px] font-medium text-[color:var(--muted)]">Combine:</label>
              <select id="logic-select" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-2 py-1 text-[11px] text-[color:var(--fg)]">
                <option value="and">Match ALL (AND)</option>
                <option value="or">Match ANY (OR)</option>
              </select>
            </div>
          </div>

          <div id="rules-container" class="space-y-2">
            <!-- Dynamic Rule Rows -->
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-[color:var(--border)]">
            <button
              type="button"
              id="add-rule-btn"
              class="inline-flex items-center gap-1 rounded-lg border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-2.5 py-1 text-xs font-semibold text-[color:var(--fg)] hover:bg-[color:var(--bg)] cursor-pointer"
            >
              + Add Condition
            </button>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" id="case-sensitive" class="rounded border-[color:var(--border)] accent-[color:var(--fg)]" />
              <span class="text-[11px] text-[color:var(--muted)]">Case-Sensitive</span>
            </label>
          </div>

          <button
            type="button"
            data-filter-btn
            class="w-full mt-2 rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 cursor-pointer"
          >
            🔍 Apply Filter Rules
          </button>
        </div>
      </div>

      <!-- Output Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Filtered CSV Rows</span>
            <span id="output-badge" class="rounded-md bg-cyan-500/15 px-2 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">Ready</span>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span>Copy CSV</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">Download .csv</button>
          </div>
        </div>

        <textarea
          id="csv-out"
          rows="18"
          readonly
          class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Matching CSV records will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- Live Table Preview Section -->
    <section class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)]">
          📊 Filtered Table Preview (First 8 Rows)
        </h2>
        <span id="preview-badge" class="text-xs text-[color:var(--muted)]">Live Data View</span>
      </div>
      <div class="overflow-x-auto rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)]">
        <table id="preview-table" class="min-w-full divide-y divide-[color:var(--border)] text-left text-xs font-mono">
          <thead id="preview-thead" class="bg-[color:var(--surface)] text-[color:var(--fg)]">
            <tr><th class="p-3 font-semibold text-[color:var(--muted)]">No data loaded yet</th></tr>
          </thead>
          <tbody id="preview-tbody" class="divide-y divide-[color:var(--border)] text-[color:var(--muted)]">
          </tbody>
        </table>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-[color:var(--accent)]/15 px-2.5 py-1 text-xs font-bold text-[color:var(--accent)]">Worked Example</span>
        <h2 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Filtering High-Value Available Inventory</h2>
      </div>
      <p>
        An e-commerce manager wants to find all electronics products priced above $50 with available stock:
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 font-mono text-xs">
          <span class="text-[color:var(--muted)] block mb-1 font-bold font-sans">Source Inventory (4 Rows):</span>
          sku,name,category,price,stock<br/>
          101,"Wireless Mouse",Electronics,29.99,150<br/>
          102,"Mechanical Keyboard",Electronics,119.50,85<br/>
          103,"Desk Mat",Office,22.00,40<br/>
          104,"Monitor 27in 4K",Electronics,349.00,0
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 font-mono text-xs">
          <span class="text-[color:var(--muted)] block mb-1 font-bold font-sans">Filtered (Category = "Electronics" AND price &gt; 50 AND stock &gt; 0):</span>
          sku,name,category,price,stock<br/>
          102,"Mechanical Keyboard",Electronics,119.50,85
        </div>
      </div>
      <p class="text-xs text-[color:var(--muted)]">
        The numeric operators automatically parse <code>price</code> and <code>stock</code> as numerical values, correctly filtering out SKU 101 ($29.99 &lt; 50) and SKU 104 (stock = 0).
      </p>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-filter-app]');
      if (!root) return;

      const input = root.querySelector('#csv-in');
      const fileIn = root.querySelector('#csv-file-in');
      const output = root.querySelector('#csv-out');
      const logicSelect = root.querySelector('#logic-select');
      const rulesContainer = root.querySelector('#rules-container');
      const addRuleBtn = root.querySelector('#add-rule-btn');
      const caseSensitiveCb = root.querySelector('#case-sensitive');
      const filterBtn = root.querySelector('[data-filter-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      const statTotal = root.querySelector('#stat-total');
      const statMatch = root.querySelector('#stat-match');
      const statFiltered = root.querySelector('#stat-filtered');
      const statRate = root.querySelector('#stat-rate');

      const thead = root.querySelector('#preview-thead');
      const tbody = root.querySelector('#preview-tbody');
      const previewBadge = root.querySelector('#preview-badge');

      let parsedHeaders = [];
      let parsedDataRows = [];
      let detectedDelim = ',';

      function autoDetect(text) {
        const firstLines = text.split('\n').slice(0, 5).join('\n');
        const c = (firstLines.match(/,/g) || []).length;
        const s = (firstLines.match(/;/g) || []).length;
        const t = (firstLines.match(/\t/g) || []).length;
        const p = (firstLines.match(/\|/g) || []).length;
        if (s > c && s > t && s > p) return ';';
        if (t > c && t > s && t > p) return '\t';
        if (p > c && p > s && p > t) return '|';
        return ',';
      }

      function parseCsv(text, delim) {
        const rows = [];
        let cur = [];
        let val = '';
        let inQuotes = false;

        for (let i = 0; i < text.length; i++) {
          const ch = text[i];
          const nxt = text[i + 1];

          if (ch === '"') {
            if (inQuotes && nxt === '"') {
              val += '"';
              i++;
            } else {
              inQuotes = !inQuotes;
            }
          } else if (ch === delim && !inQuotes) {
            cur.push(val.trim());
            val = '';
          } else if ((ch === '\r' || ch === '\n') && !inQuotes) {
            if (ch === '\r' && nxt === '\n') i++;
            cur.push(val.trim());
            if (cur.some(x => x.length > 0)) rows.push(cur);
            cur = [];
            val = '';
          } else {
            val += ch;
          }
        }
        if (val.length > 0 || cur.length > 0) {
          cur.push(val.trim());
          if (cur.some(x => x.length > 0)) rows.push(cur);
        }
        return rows;
      }

      function escapeCsvCell(cell, delim) {
        const s = String(cell ?? '');
        if (s.includes('"') || s.includes(delim) || s.includes('\n') || s.includes('\r')) {
          return `"${s.replace(/"/g, '""')}"`;
        }
        return s;
      }

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function createRuleRow(colIdx = 0, op = 'contains', val = '') {
        const row = document.createElement('div');
        row.className = 'grid grid-cols-12 gap-1.5 items-center rule-row';

        const colOptions = parsedHeaders.map((h, idx) => `<option value="${idx}" ${idx === colIdx ? 'selected' : ''}>${escapeHtml(h || `Column ${idx + 1}`)}</option>`).join('');

        row.innerHTML = `
          <select class="col-span-4 rounded-lg border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-2 py-1.5 text-xs text-[color:var(--fg)] rule-col">
            ${colOptions || '<option value="0">Column 1</option>'}
          </select>
          <select class="col-span-3 rounded-lg border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-1.5 py-1.5 text-xs text-[color:var(--fg)] rule-op">
            <option value="contains" ${op === 'contains' ? 'selected' : ''}>contains</option>
            <option value="not_contains" ${op === 'not_contains' ? 'selected' : ''}>not contains</option>
            <option value="equals" ${op === 'equals' ? 'selected' : ''}>equals (=)</option>
            <option value="not_equals" ${op === 'not_equals' ? 'selected' : ''}>not equals (!=)</option>
            <option value="starts_with" ${op === 'starts_with' ? 'selected' : ''}>starts with</option>
            <option value="ends_with" ${op === 'ends_with' ? 'selected' : ''}>ends with</option>
            <option value="gt" ${op === 'gt' ? 'selected' : ''}>&gt; greater than</option>
            <option value="gte" ${op === 'gte' ? 'selected' : ''}>&gt;= greater/equal</option>
            <option value="lt" ${op === 'lt' ? 'selected' : ''}>&lt; less than</option>
            <option value="lte" ${op === 'lte' ? 'selected' : ''}>&lt;= less/equal</option>
            <option value="empty" ${op === 'empty' ? 'selected' : ''}>is empty</option>
            <option value="not_empty" ${op === 'not_empty' ? 'selected' : ''}>not empty</option>
            <option value="regex" ${op === 'regex' ? 'selected' : ''}>matches regex</option>
          </select>
          <input
            type="text"
            placeholder="Search value..."
            value="${escapeHtml(val)}"
            class="col-span-4 rounded-lg border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-2 py-1.5 text-xs text-[color:var(--fg)] rule-val"
          />
          <button type="button" class="col-span-1 text-center font-bold text-[color:var(--muted)] hover:text-rose-500 rule-remove-btn cursor-pointer" title="Remove condition">✕</button>
        `;

        row.querySelector('.rule-remove-btn').addEventListener('click', () => {
          if (rulesContainer.querySelectorAll('.rule-row').length > 1) {
            row.remove();
            applyFilter();
          }
        });

        row.querySelector('.rule-op').addEventListener('change', (e) => {
          const vInput = row.querySelector('.rule-val');
          if (e.target.value === 'empty' || e.target.value === 'not_empty') {
            vInput.disabled = true;
            vInput.placeholder = '(no value needed)';
          } else {
            vInput.disabled = false;
            vInput.placeholder = 'Search value...';
          }
          applyFilter();
        });

        row.querySelectorAll('select, input').forEach(el => {
          el.addEventListener('input', applyFilter);
        });

        rulesContainer.appendChild(row);
      }

      function updateColsFromInput() {
        const text = input.value.trim();
        if (!text) {
          parsedHeaders = [];
          parsedDataRows = [];
          output.value = '';
          statTotal.textContent = '0';
          statMatch.textContent = '0';
          statFiltered.textContent = '0';
          statRate.textContent = '0%';
          updatePreview([], []);
          return;
        }

        detectedDelim = autoDetect(text);
        const rows = parseCsv(text, detectedDelim);
        if (rows.length < 2) return;

        parsedHeaders = rows[0];
        parsedDataRows = rows.slice(1);

        // Update all existing rule col dropdowns
        const existingRules = rulesContainer.querySelectorAll('.rule-row');
        if (existingRules.length === 0) {
          createRuleRow(0, 'contains', '');
        } else {
          existingRules.forEach(r => {
            const select = r.querySelector('.rule-col');
            const curVal = select.value;
            select.innerHTML = parsedHeaders.map((h, i) => `<option value="${i}" ${i == curVal ? 'selected' : ''}>${escapeHtml(h || `Column ${i + 1}`)}</option>`).join('');
          });
        }

        applyFilter();
      }

      function evaluateCondition(cellValue, op, targetValue, isCaseSensitive) {
        let cellStr = String(cellValue ?? '');
        let targetStr = String(targetValue ?? '');

        if (!isCaseSensitive) {
          cellStr = cellStr.toLowerCase();
          targetStr = targetStr.toLowerCase();
        }

        switch (op) {
          case 'contains':
            return cellStr.includes(targetStr);
          case 'not_contains':
            return !cellStr.includes(targetStr);
          case 'equals':
            return cellStr === targetStr;
          case 'not_equals':
            return cellStr !== targetStr;
          case 'starts_with':
            return cellStr.startsWith(targetStr);
          case 'ends_with':
            return cellStr.endsWith(targetStr);
          case 'empty':
            return cellStr.trim() === '';
          case 'not_empty':
            return cellStr.trim() !== '';
          case 'gt':
            return parseFloat(cellStr) > parseFloat(targetStr);
          case 'gte':
            return parseFloat(cellStr) >= parseFloat(targetStr);
          case 'lt':
            return parseFloat(cellStr) < parseFloat(targetStr);
          case 'lte':
            return parseFloat(cellStr) <= parseFloat(targetStr);
          case 'regex':
            try {
              const re = new RegExp(targetValue, isCaseSensitive ? '' : 'i');
              return re.test(cellValue ?? '');
            } catch (e) {
              return false;
            }
          default:
            return true;
        }
      }

      function updatePreview(headers, dataRows) {
        if (!headers || headers.length === 0) {
          thead.innerHTML = '<tr><th class="p-3 font-semibold text-[color:var(--muted)]">No data loaded yet</th></tr>';
          tbody.innerHTML = '';
          previewBadge.textContent = 'Empty';
          return;
        }

        previewBadge.textContent = `Showing 1–${Math.min(8, dataRows.length)} of ${dataRows.length} matching rows`;
        thead.innerHTML = `<tr>${headers.map(h => `<th class="p-2.5 font-bold uppercase tracking-wider text-[color:var(--fg)] border-b border-[color:var(--border)]">${escapeHtml(h)}</th>`).join('')}</tr>`;

        const sample = dataRows.slice(0, 8);
        tbody.innerHTML = sample.map((row, rIdx) => {
          const cells = headers.map((_, cIdx) => `<td class="p-2.5 border-b border-[color:var(--border)]">${escapeHtml(String(row[cIdx] ?? ''))}</td>`).join('');
          return `<tr class="${rIdx % 2 === 0 ? 'bg-[color:var(--surface)]/30' : ''}">${cells}</tr>`;
        }).join('');
      }

      function applyFilter() {
        if (parsedDataRows.length === 0) return;

        const isAnd = logicSelect.value === 'and';
        const isCaseSensitive = caseSensitiveCb.checked;

        const ruleElements = Array.from(rulesContainer.querySelectorAll('.rule-row'));
        const rules = ruleElements.map(el => ({
          colIdx: parseInt(el.querySelector('.rule-col').value, 10) || 0,
          op: el.querySelector('.rule-op').value,
          val: el.querySelector('.rule-val').value,
        }));

        const matchingRows = parsedDataRows.filter(row => {
          if (rules.length === 0) return true;

          if (isAnd) {
            return rules.every(r => evaluateCondition(row[r.colIdx], r.op, r.val, isCaseSensitive));
          } else {
            return rules.some(r => evaluateCondition(row[r.colIdx], r.op, r.val, isCaseSensitive));
          }
        });

        const outText = [parsedHeaders, ...matchingRows].map(r => r.map(c => escapeCsvCell(c, detectedDelim)).join(detectedDelim)).join('\n');
        output.value = outText;

        const total = parsedDataRows.length;
        const matched = matchingRows.length;
        const filtered = total - matched;
        const rate = total > 0 ? Math.round((matched / total) * 100) : 0;

        statTotal.textContent = total.toLocaleString();
        statMatch.textContent = matched.toLocaleString();
        statFiltered.textContent = filtered.toLocaleString();
        statRate.textContent = `${rate}%`;

        updatePreview(parsedHeaders, matchingRows);
      }

      addRuleBtn.addEventListener('click', () => {
        createRuleRow(0, 'contains', '');
        applyFilter();
      });

      logicSelect.addEventListener('change', applyFilter);
      caseSensitiveCb.addEventListener('change', applyFilter);
      filterBtn.addEventListener('click', applyFilter);

      input.addEventListener('input', () => {
        clearTimeout(input._timer);
        input._timer = setTimeout(updateColsFromInput, 250);
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (evt) => {
          input.value = evt.target.result;
          updateColsFromInput();
        };
        reader.readAsText(file);
      });

      sampleBtn.addEventListener('click', () => {
        input.value = `sku,product_name,category,unit_price,inventory,status\nSKU-101,"Wireless Mouse, 2.4G",Electronics,29.99,150,In Stock\nSKU-102,"Mechanical Keyboard",Electronics,119.50,85,In Stock\nSKU-103,"Desk Mat XXL",Office,22.00,0,Out of Stock\nSKU-104,"USB-C Docking Station",Electronics,89.90,12,In Stock\nSKU-105,"Gel Wrist Rest",Office,15.00,45,In Stock\nSKU-106,"Curved Monitor 34in",Electronics,499.00,4,In Stock`;
        updateColsFromInput();
        rulesContainer.innerHTML = '';
        createRuleRow(2, 'equals', 'Electronics');
        createRuleRow(3, 'gt', '50');
        applyFilter();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
        fileIn.value = '';
        rulesContainer.innerHTML = '';
        createRuleRow(0, 'contains', '');
        statTotal.textContent = '0';
        statMatch.textContent = '0';
        statFiltered.textContent = '0';
        statRate.textContent = '0%';
        updatePreview([], []);
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'filtered_records.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      // Init with sample
      sampleBtn.click();
    })();
  </script>
</SiteLayout>
