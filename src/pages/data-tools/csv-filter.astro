---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSV Filter & Query Tool — Filter CSV Rows by Column · ${siteName}`;
const pageDesc = 'Filter CSV datasets by specific column conditions (contains, equals, starts with, greater than, less than) online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/data-tools/csv-filter/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Data Tools', href: toAbsoluteUrl('/data-tools/') },
  { label: 'CSV Filter' },
];

const schemaFaq = [
  {
    question: 'How do filter rules work on CSV files?',
    answer: 'You select a target column, choose a conditional operator (e.g. contains, equals, numeric greater-than), and enter your search query. The tool iterates through data rows, preserving only records that satisfy your rule.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSV Filter',
    url: canonicalUrl,
    applicationCategory: 'DataApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-filter-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Dataset Query Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSV Row Filter &amp; Query Tool
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Filter tabular rows by text matching or numeric thresholds. Export matching records instantly.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Input -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <label for="csv-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Source CSV Data</label>
            <div class="flex items-center gap-2 text-xs">
              <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
              <span class="text-[color:var(--border)]">|</span>
              <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
            </div>
          </div>
          <textarea
            id="csv-in"
            rows="12"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste CSV here..."
          ></textarea>

          <!-- Filter Rules -->
          <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
            <span class="font-bold text-[color:var(--fg)] block">Filter Criteria:</span>
            <div class="grid grid-cols-3 gap-2">
              <select id="filter-col" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2 py-1.5 text-[color:var(--fg)]">
                <option value="0">Column 1</option>
              </select>
              <select id="filter-op" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2 py-1.5 text-[color:var(--fg)]">
                <option value="contains">contains</option>
                <option value="equals">equals</option>
                <option value="starts_with">starts with</option>
                <option value="gt">greater than (&gt;)</option>
                <option value="lt">less than (&lt;)</option>
                <option value="not_empty">is not empty</option>
              </select>
              <input
                type="text"
                id="filter-val"
                placeholder="Value..."
                class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2 py-1.5 text-[color:var(--fg)]"
              />
            </div>
          </div>
        </div>

        <!-- Output -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Filtered CSV Rows</span>
            <div class="flex items-center gap-2">
              <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy</span>
              </button>
              <span class="text-[color:var(--border)]">|</span>
              <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">Download CSV</button>
            </div>
          </div>
          <textarea
            id="csv-out"
            rows="16"
            readonly
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
            placeholder="Matching CSV records will appear here..."
          ></textarea>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-filter-app]');
      if (!root) return;

      const input = root.querySelector('#csv-in');
      const output = root.querySelector('#csv-out');
      const filterCol = root.querySelector('#filter-col');
      const filterOp = root.querySelector('#filter-op');
      const filterVal = root.querySelector('#filter-val');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      let parsedRows = [];

      function parseCsvLines(text) {
        return text.split('\n').filter(l => l.trim().length > 0).map(l => l.split(',').map(c => c.trim()));
      }

      function updateColsAndFilter() {
        const text = input.value.trim();
        if (!text) {
          filterCol.innerHTML = '<option value="0">Column 1</option>';
          parsedRows = [];
          output.value = '';
          return;
        }

        parsedRows = parseCsvLines(text);
        if (parsedRows.length === 0) return;

        const headers = parsedRows[0];
        const currentSelected = filterCol.value;
        filterCol.innerHTML = headers.map((h, i) => `<option value="${i}">${h}</option>`).join('');
        if (currentSelected < headers.length) filterCol.value = currentSelected;

        applyFilter();
      }

      function applyFilter() {
        if (parsedRows.length < 2) return;
        const colIdx = parseInt(filterCol.value, 10) || 0;
        const op = filterOp.value;
        const query = filterVal.value.trim().toLowerCase();

        const header = parsedRows[0];
        const dataRows = parsedRows.slice(1);

        const filtered = dataRows.filter(row => {
          const val = (row[colIdx] || '').toLowerCase();
          const numVal = parseFloat(val);
          const numQuery = parseFloat(query);

          switch (op) {
            case 'contains': return val.includes(query);
            case 'equals': return val === query;
            case 'starts_with': return val.startsWith(query);
            case 'gt': return !isNaN(numVal) && !isNaN(numQuery) && numVal > numQuery;
            case 'lt': return !isNaN(numVal) && !isNaN(numQuery) && numVal < numQuery;
            case 'not_empty': return val.length > 0;
            default: return true;
          }
        });

        output.value = [header.join(','), ...filtered.map(r => r.join(','))].join('\n');
      }

      input.addEventListener('input', updateColsAndFilter);
      filterCol.addEventListener('change', applyFilter);
      filterOp.addEventListener('change', applyFilter);
      filterVal.addEventListener('input', applyFilter);

      sampleBtn.addEventListener('click', () => {
        input.value = `id,name,category,price,country\n101,iPhone 15,Smartphone,899,USA\n102,Galaxy S24,Smartphone,799,South Korea\n103,MacBook Air,Laptop,1099,USA\n104,ThinkPad X1,Laptop,1299,China\n105,Pixel 8,Smartphone,699,USA`;
        filterVal.value = 'USA';
        updateColsAndFilter();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
        filterVal.value = '';
        updateColsAndFilter();
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'filtered.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
