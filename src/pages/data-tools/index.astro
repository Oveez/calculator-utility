---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Data & CSV Utilities | CSV to JSON, Sorter, Extractor & Filter · ${siteName}`;
const pageDesc = 'Free client-side CSV and dataset manipulation utilities. Convert CSV to JSON, extract columns, deduplicate rows, sort, filter, and convert CSV to Markdown tables locally.';
const canonicalUrl = toAbsoluteUrl('/data-tools/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Data Tools' },
];

const dataTools = [
  {
    slug: 'csv-to-json',
    title: 'CSV to JSON Converter',
    badge: 'Popular',
    metaDescription: 'Convert CSV files and tables to JSON arrays. Auto-detects delimiters (comma, tab, semicolon) and handles quoted values.',
    href: withBasePath('/data-tools/csv-to-json/'),
    icon: 'converter',
  },
  {
    slug: 'csv-column-extractor',
    title: 'CSV Column Extractor',
    badge: 'Transform',
    metaDescription: 'Select, reorder, and extract specific columns from large CSV datasets and export clean filtered tables.',
    href: withBasePath('/data-tools/csv-column-extractor/'),
    icon: 'converter',
  },
  {
    slug: 'csv-deduplicator',
    title: 'CSV Deduplicator & Unique Rows',
    badge: 'Cleaning',
    metaDescription: 'Remove duplicate rows from CSV files based on entire records or specific unique identifier columns.',
    href: withBasePath('/data-tools/csv-deduplicator/'),
    icon: 'converter',
  },
  {
    slug: 'csv-sorter',
    title: 'CSV Sorter',
    badge: 'Sorting',
    metaDescription: 'Sort CSV datasets alphabetically, numerically, ascending, or descending by any selected column.',
    href: withBasePath('/data-tools/csv-sorter/'),
    icon: 'converter',
  },
  {
    slug: 'csv-filter',
    title: 'CSV Row Filter',
    badge: 'Analysis',
    metaDescription: 'Filter tabular records by custom column rules (contains, equals, starts with, numeric thresholds).',
    href: withBasePath('/data-tools/csv-filter/'),
    icon: 'converter',
  },
  {
    slug: 'csv-to-markdown',
    title: 'CSV to Markdown Table Converter',
    badge: 'Documentation',
    metaDescription: 'Convert CSV tables into GitHub-flavored Markdown tables for READMEs, issues, and tech docs.',
    href: withBasePath('/data-tools/csv-to-markdown/'),
    icon: 'converter',
  },
];

const schemaFaq = [
  {
    question: 'Are my CSV files uploaded to a remote server for processing?',
    answer: 'No. All CSV parsing, column extraction, sorting, and deduplication run 100% locally in your web browser memory using HTML5 FileReader and client-side JavaScript.',
  },
  {
    question: 'Can this tool process large CSV files with thousands of rows?',
    answer: 'Yes. Because data is processed directly inside your browser memory with zero network latency, file manipulation is virtually instantaneous for typical spreadsheet exports.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-bold text-[color:var(--fg)]">
        <span>Client-Side Data &amp; CSV Suite</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Data &amp; CSV Utilities
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Transform, clean, filter, and convert CSV datasets entirely in your browser. Fast, private, and compatible with Excel, Google Sheets, and SQL databases.
      </p>
    </header>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Directory</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">6 In-Browser Data Engines</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          6 Tools
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {dataTools.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon slug={tool.slug} category="Data" size="md" />
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold text-[color:var(--fg)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)]">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[color:var(--fg)]">
              <span>Open Tool</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
