---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSV Deduplicator — Remove Duplicate Rows & Clean Datasets · ${siteName}`;
const pageDesc = 'Remove duplicate records and redundant rows from CSV files online. Deduplicate based on whole rows or specific primary key columns (email, ID). 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/data-tools/csv-deduplicator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Data Tools', href: toAbsoluteUrl('/data-tools/') },
  { label: 'CSV Deduplicator' },
];

const schemaFaq = [
  {
    question: 'How does CSV deduplication work?',
    answer: 'The deduplicator parses your CSV rows and tracks unique keys using an in-memory hash set. You can choose whether to check the entire row or deduplicate based on a single unique column (like email address or customer ID).',
  },
  {
    question: 'Can I deduplicate by a specific column like Email or ID?',
    answer: 'Yes. Select "Specific Column" under Deduplication Scope, choose the key column from the dropdown, and redundant rows with matching keys will be automatically purged.',
  },
  {
    question: 'What is the difference between Keep First and Keep Last occurrence?',
    answer: '"Keep First" retains the earliest record in the file and discards later duplicates. "Keep Last" overwrites with the latest entry, which is useful for audit logs or updated contact records.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSV Deduplicator',
    url: canonicalUrl,
    applicationCategory: 'DataApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuide = [
  {
    id: 'dedup_scope',
    name: 'Deduplication Scope',
    description: 'Determines whether rows are compared by their entire contents or by a single key column.',
    whyItMatters: 'If two rows have the same email address but different timestamps, "Specific Column (Email)" removes the duplicate, while "All Columns" would keep both.',
    typicalRange: 'Entire Row vs Key Column (e.g. Email, ID, SKU)',
  },
  {
    id: 'retention_policy',
    name: 'Retention Policy',
    description: 'Dictates whether the first seen occurrence or the latest seen occurrence is preserved.',
    whyItMatters: 'In customer lists, "Keep Last" preserves the most recent update; in event logs, "Keep First" preserves the origin record.',
    typicalRange: 'Keep First vs Keep Last',
  },
  {
    id: 'case_sensitivity',
    name: 'Case Sensitivity',
    description: 'Treats uppercase and lowercase letters as identical ("Alice@work.com" == "alice@work.com").',
    whyItMatters: 'Emails and usernames are typically case-insensitive in reality. Disabling case sensitivity prevents duplicate emails with mixed casing.',
    typicalRange: 'Case-Insensitive (Recommended) / Case-Sensitive',
  },
  {
    id: 'trim_whitespace',
    name: 'Trim Whitespace',
    description: 'Strips accidental leading and trailing spaces before comparing values.',
    whyItMatters: 'Spreadsheet copy-pastes often introduce hidden spaces like " John " vs "John", creating phantom duplicates.',
    typicalRange: 'Enabled / Disabled',
  },
  {
    id: 'empty_rows',
    name: 'Strip Blank Rows',
    description: 'Automatically ignores empty lines and rows with only delimiters.',
    whyItMatters: 'Prevents empty records from inflating duplicate counts or corrupting downstream imports.',
    typicalRange: 'Enabled (Standard)',
  },
  {
    id: 'privacy',
    name: '100% Client Privacy',
    description: 'All string hashing and deduplication execute strictly in local browser memory.',
    whyItMatters: 'Guarantees customer mailing lists and internal databases are never leaked to cloud APIs.',
    typicalRange: 'In-Browser Memory',
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-dedup-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>100% Client-Side In-Memory Cleansing</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSV Deduplicator &amp; Row Cleaner
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Strip duplicate entries from email lists, CRM records, and transaction spreadsheets. Filter by whole rows or targeted key columns with customizable case-matching and retention policies.
      </p>
    </header>

    <!-- Metrics Bar -->
    <div id="stats-bar" class="grid grid-cols-2 gap-3 sm:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center">
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Total Source Rows</span>
        <span id="stat-orig" class="font-mono text-lg font-bold text-[color:var(--fg)]">0</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Unique Retained</span>
        <span id="stat-uniq" class="font-mono text-lg font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">0</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Duplicates Purged</span>
        <span id="stat-dup" class="font-mono text-lg font-bold text-rose-600 dark:text-rose-400">0</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Purge Rate</span>
        <span id="stat-rate" class="font-mono text-lg font-bold text-[color:var(--fg)]">0%</span>
      </div>
    </div>

    <!-- Main Workspace -->
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Input Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <label for="csv-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Source CSV</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="font-semibold text-[color:var(--primary)] hover:underline cursor-pointer">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">Clear</button>
          </div>
        </div>

        <div class="space-y-2">
          <input
            type="file"
            id="csv-file-in"
            accept=".csv,.tsv,.txt"
            class="w-full text-xs text-[color:var(--muted)] file:mr-3 file:rounded-xl file:border file:border-[color:var(--border)] file:bg-[color:var(--surface)] file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-[color:var(--fg)] hover:file:bg-[color:var(--surface-strong)]" />
          <textarea
            id="csv-in"
            rows="14"
            class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="id,name,email,plan&#10;1,Alice,alice@example.com,Pro&#10;2,Bob,bob@example.com,Basic&#10;3,Alice,alice@example.com,Pro"
          ></textarea>
        </div>

        <!-- Controls -->
        <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="scope-select" class="block font-medium text-[color:var(--muted)] mb-1">Deduplication Scope:</label>
              <select id="scope-select" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1.5 text-xs text-[color:var(--fg)]">
                <option value="all">Match All Columns (Exact Row)</option>
                <option value="col">Match Specific Key Column</option>
              </select>
            </div>
            <div id="key-col-wrapper" class="hidden">
              <label for="key-col-select" class="block font-medium text-[color:var(--muted)] mb-1">Key Column:</label>
              <select id="key-col-select" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1.5 text-xs text-[color:var(--fg)]">
                <option value="0">Column 1</option>
              </select>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2 pt-1">
            <div>
              <label for="policy-select" class="block font-medium text-[color:var(--muted)] mb-1">Retention Policy:</label>
              <select id="policy-select" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1.5 text-xs text-[color:var(--fg)]">
                <option value="first">Keep First Occurrence</option>
                <option value="last">Keep Last Occurrence</option>
              </select>
            </div>
            <div class="space-y-1 pt-3">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="case-ins" checked class="rounded border-[color:var(--border)] accent-[color:var(--fg)]" />
                <span class="text-xs text-[color:var(--fg)]">Case-Insensitive Match</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="trim-spaces" checked class="rounded border-[color:var(--border)] accent-[color:var(--fg)]" />
                <span class="text-xs text-[color:var(--fg)]">Trim Whitespace</span>
              </label>
            </div>
          </div>

          <button
            type="button"
            data-dedup-btn
            class="w-full mt-2 rounded-xl bg-[color:var(--accent)] py-2.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90 cursor-pointer"
          >
            🧹 Clean &amp; Deduplicate CSV
          </button>
        </div>
      </div>

      <!-- Output Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Deduplicated Output</span>
            <span id="status-badge" class="rounded-md bg-cyan-500/15 px-2 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">Ready</span>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span>Copy CSV</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">Download .csv</button>
          </div>
        </div>
        <textarea
          id="csv-out"
          rows="18"
          readonly
          class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Unique CSV records will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- Live Table Preview Section -->
    <section class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)]">
          📊 Deduplicated Records Preview (First 8 Rows)
        </h2>
        <span id="preview-badge" class="text-xs text-[color:var(--muted)]">Live Clean View</span>
      </div>
      <div class="overflow-x-auto rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)]">
        <table id="preview-table" class="min-w-full divide-y divide-[color:var(--border)] text-left text-xs font-mono">
          <thead id="preview-thead" class="bg-[color:var(--surface)] text-[color:var(--fg)]">
            <tr><th class="p-3 font-semibold text-[color:var(--muted)]">No data loaded yet</th></tr>
          </thead>
          <tbody id="preview-tbody" class="divide-y divide-[color:var(--border)] text-[color:var(--muted)]">
          </tbody>
        </table>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-[color:var(--accent)]/15 px-2.5 py-1 text-xs font-bold text-[color:var(--accent)]">Worked Example</span>
        <h2 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Deduplicating a Customer Newsletter List by Email</h2>
      </div>
      <p>
        A marketing spreadsheet contains multiple signups with different capitalization and trailing spaces. Selecting <code>Match Specific Key Column (email)</code> purges repeated subscribers:
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 font-mono text-xs">
          <span class="text-[color:var(--muted)] block mb-1 font-bold font-sans">Input CSV (5 Rows):</span>
          id,name,email,tier<br/>
          101,Alice,alice@work.com,Pro<br/>
          102,Bob,bob@corp.org,Basic<br/>
          103,Alice M,ALICE@WORK.COM,Enterprise<br/>
          104,Charlie,charlie@lab.io,Pro<br/>
          105,Bob B,"bob@corp.org ",Basic
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 font-mono text-xs">
          <span class="text-[color:var(--muted)] block mb-1 font-bold font-sans">Clean Output (3 Unique Subscribers):</span>
          id,name,email,tier<br/>
          101,Alice,alice@work.com,Pro<br/>
          102,Bob,bob@corp.org,Basic<br/>
          104,Charlie,charlie@lab.io,Pro
        </div>
      </div>
      <p class="text-xs text-[color:var(--muted)]">
        Both duplicate signups for Alice (row 103) and Bob (row 105) are identified and purged based on normalized email matching, achieving a 40% reduction in list bloat.
      </p>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-dedup-app]');
      if (!root) return;

      const input = root.querySelector('#csv-in');
      const fileIn = root.querySelector('#csv-file-in');
      const output = root.querySelector('#csv-out');
      const scopeSelect = root.querySelector('#scope-select');
      const keyColWrapper = root.querySelector('#key-col-wrapper');
      const keyColSelect = root.querySelector('#key-col-select');
      const policySelect = root.querySelector('#policy-select');
      const caseIns = root.querySelector('#case-ins');
      const trimSpaces = root.querySelector('#trim-spaces');
      const dedupBtn = root.querySelector('[data-dedup-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      const statOrig = root.querySelector('#stat-orig');
      const statUniq = root.querySelector('#stat-uniq');
      const statDup = root.querySelector('#stat-dup');
      const statRate = root.querySelector('#stat-rate');

      const thead = root.querySelector('#preview-thead');
      const tbody = root.querySelector('#preview-tbody');
      const previewBadge = root.querySelector('#preview-badge');

      function autoDetect(text) {
        const firstLines = text.split('\n').slice(0, 5).join('\n');
        const c = (firstLines.match(/,/g) || []).length;
        const s = (firstLines.match(/;/g) || []).length;
        const t = (firstLines.match(/\t/g) || []).length;
        const p = (firstLines.match(/\|/g) || []).length;
        if (s > c && s > t && s > p) return ';';
        if (t > c && t > s && t > p) return '\t';
        if (p > c && p > s && p > t) return '|';
        return ',';
      }

      function parseCsv(text, delim) {
        const rows = [];
        let cur = [];
        let val = '';
        let inQuotes = false;

        for (let i = 0; i < text.length; i++) {
          const ch = text[i];
          const nxt = text[i + 1];

          if (ch === '"') {
            if (inQuotes && nxt === '"') {
              val += '"';
              i++;
            } else {
              inQuotes = !inQuotes;
            }
          } else if (ch === delim && !inQuotes) {
            cur.push(val.trim());
            val = '';
          } else if ((ch === '\r' || ch === '\n') && !inQuotes) {
            if (ch === '\r' && nxt === '\n') i++;
            cur.push(val.trim());
            if (cur.some(x => x.length > 0)) rows.push(cur);
            cur = [];
            val = '';
          } else {
            val += ch;
          }
        }
        if (val.length > 0 || cur.length > 0) {
          cur.push(val.trim());
          if (cur.some(x => x.length > 0)) rows.push(cur);
        }
        return rows;
      }

      function escapeCsvCell(cell, delim) {
        const s = String(cell ?? '');
        if (s.includes('"') || s.includes(delim) || s.includes('\n') || s.includes('\r')) {
          return `"${s.replace(/"/g, '""')}"`;
        }
        return s;
      }

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function updateKeyColumns(headers) {
        if (!headers || headers.length === 0) return;
        const currentVal = keyColSelect.value;
        keyColSelect.innerHTML = headers.map((h, i) => `<option value="${i}">${escapeHtml(h || `Column ${i + 1}`)}</option>`).join('');
        if (currentVal && headers[parseInt(currentVal, 10)]) {
          keyColSelect.value = currentVal;
        }
      }

      function updatePreview(headers, dataRows) {
        if (!headers || headers.length === 0) {
          thead.innerHTML = '<tr><th class="p-3 font-semibold text-[color:var(--muted)]">No data loaded yet</th></tr>';
          tbody.innerHTML = '';
          previewBadge.textContent = 'Empty';
          return;
        }

        previewBadge.textContent = `Showing 1–${Math.min(8, dataRows.length)} of ${dataRows.length} unique rows`;
        thead.innerHTML = `<tr>${headers.map(h => `<th class="p-2.5 font-bold uppercase tracking-wider text-[color:var(--fg)] border-b border-[color:var(--border)]">${escapeHtml(h)}</th>`).join('')}</tr>`;

        const sample = dataRows.slice(0, 8);
        tbody.innerHTML = sample.map((row, rIdx) => {
          const cells = headers.map((_, cIdx) => `<td class="p-2.5 border-b border-[color:var(--border)]">${escapeHtml(String(row[cIdx] ?? ''))}</td>`).join('');
          return `<tr class="${rIdx % 2 === 0 ? 'bg-[color:var(--surface)]/30' : ''}">${cells}</tr>`;
        }).join('');
      }

      function dedup() {
        const text = input.value.trim();
        if (!text) {
          output.value = '';
          statOrig.textContent = '0';
          statUniq.textContent = '0';
          statDup.textContent = '0';
          statRate.textContent = '0%';
          updatePreview([], []);
          return;
        }

        const delim = autoDetect(text);
        const rows = parseCsv(text, delim);
        if (rows.length < 2) return;

        const headers = rows[0];
        const dataRows = rows.slice(1);
        updateKeyColumns(headers);

        const scope = scopeSelect.value;
        const keyIdx = (keyColSelect.value !== '' && !isNaN(parseInt(keyColSelect.value, 10)) ? parseInt(keyColSelect.value, 10) : 0);
        const isCaseInsensitive = caseIns.checked;
        const shouldTrim = trimSpaces.checked;
        const policy = policySelect.value;

        function normalize(val) {
          let s = String(val ?? '');
          if (shouldTrim) s = s.trim();
          if (isCaseInsensitive) s = s.toLowerCase();
          return s;
        }

        let uniqueRows = [];
        const seen = new Set();

        if (policy === 'first') {
          for (let i = 0; i < dataRows.length; i++) {
            const row = dataRows[i];
            const key = scope === 'col' ? normalize(row[keyIdx]) : row.map(normalize).join('|#|');
            if (!seen.has(key)) {
              seen.add(key);
              uniqueRows.push(row);
            }
          }
        } else {
          // Keep last
          const map = new Map();
          for (let i = 0; i < dataRows.length; i++) {
            const row = dataRows[i];
            const key = scope === 'col' ? normalize(row[keyIdx]) : row.map(normalize).join('|#|');
            map.set(key, row);
          }
          uniqueRows = Array.from(map.values());
        }

        const outText = [headers, ...uniqueRows].map(r => r.map(c => escapeCsvCell(c, delim)).join(delim)).join('\n');
        output.value = outText;

        const origTotal = dataRows.length;
        const uniqTotal = uniqueRows.length;
        const dupTotal = Math.max(0, origTotal - uniqTotal);
        const purgePercent = origTotal > 0 ? Math.round((dupTotal / origTotal) * 100) : 0;

        statOrig.textContent = origTotal.toLocaleString();
        statUniq.textContent = uniqTotal.toLocaleString();
        statDup.textContent = dupTotal.toLocaleString();
        statRate.textContent = `${purgePercent}%`;

        updatePreview(headers, uniqueRows);
      }

      scopeSelect.addEventListener('change', () => {
        if (scopeSelect.value === 'col') {
          keyColWrapper.classList.remove('hidden');
        } else {
          keyColWrapper.classList.add('hidden');
        }
        dedup();
      });

      keyColSelect.addEventListener('change', dedup);
      policySelect.addEventListener('change', dedup);
      caseIns.addEventListener('change', dedup);
      trimSpaces.addEventListener('change', dedup);
      dedupBtn.addEventListener('click', dedup);

      input.addEventListener('input', () => {
        clearTimeout(input._timer);
        input._timer = setTimeout(dedup, 250);
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (evt) => {
          input.value = evt.target.result;
          dedup();
        };
        reader.readAsText(file);
      });

      sampleBtn.addEventListener('click', () => {
        input.value = `id,name,email,plan,joined_date\n101,Alice,alice@example.com,Pro,2025-01-10\n102,Bob,bob@example.com,Basic,2025-02-14\n103,Alice Smith,ALICE@EXAMPLE.COM,Enterprise,2025-03-01\n104,Charlie,charlie@example.com,Pro,2025-03-12\n105,Bob Jones,"bob@example.com ",Basic,2025-04-05\n106,Diana,diana@example.com,Pro,2025-04-20`;
        dedup();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
        fileIn.value = '';
        statOrig.textContent = '0';
        statUniq.textContent = '0';
        statDup.textContent = '0';
        statRate.textContent = '0%';
        updatePreview([], []);
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'deduplicated_dataset.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
