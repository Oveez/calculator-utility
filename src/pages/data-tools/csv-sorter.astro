---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CSV Sorter — Sort CSV by Column Online · ${siteName}`;
const pageDesc = 'Sort CSV datasets alphabetically, numerically, ascending (A-Z, 0-9) or descending (Z-A, 9-0) by any column online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/data-tools/csv-sorter/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Data Tools', href: toAbsoluteUrl('/data-tools/') },
  { label: 'CSV Sorter' },
];

const schemaFaq = [
  {
    question: 'Does this tool preserve the header row when sorting?',
    answer: 'Yes. The first row is treated as the column header and stays locked at the top, while all subsequent data rows are sorted according to your chosen column and order.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CSV Sorter',
    url: canonicalUrl,
    applicationCategory: 'DataApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-sorter-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Alphabetical &amp; Numerical Sorting</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        CSV Sorter &amp; Order Tool
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Sort CSV tables by any column in ascending (A-Z, 0-9) or descending (Z-A, 9-0) order with type-aware numeric handling.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Input -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <label for="csv-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Source CSV Data</label>
            <div class="flex items-center gap-2 text-xs">
              <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
              <span class="text-[color:var(--border)]">|</span>
              <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
            </div>
          </div>
          <textarea
            id="csv-in"
            rows="14"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste CSV here..."
          ></textarea>

          <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2 flex-1">
              <label for="sort-col" class="text-xs font-medium text-[color:var(--muted)]">Sort By:</label>
              <select id="sort-col" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1.5 text-xs text-[color:var(--fg)]">
                <option value="0">Column 1</option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <label for="sort-dir" class="text-xs font-medium text-[color:var(--muted)]">Order:</label>
              <select id="sort-dir" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1.5 text-xs text-[color:var(--fg)]">
                <option value="asc">Ascending (A-Z, 0-9)</option>
                <option value="desc">Descending (Z-A, 9-0)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Output -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Sorted CSV Output</span>
            <div class="flex items-center gap-2">
              <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy</span>
              </button>
              <span class="text-[color:var(--border)]">|</span>
              <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">Download CSV</button>
            </div>
          </div>
          <textarea
            id="csv-out"
            rows="16"
            readonly
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
            placeholder="Sorted CSV table will appear here..."
          ></textarea>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-sorter-app]');
      if (!root) return;

      const input = root.querySelector('#csv-in');
      const output = root.querySelector('#csv-out');
      const sortCol = root.querySelector('#sort-col');
      const sortDir = root.querySelector('#sort-dir');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      let parsedRows = [];

      function parseCsvLines(text) {
        return text.split('\n').filter(l => l.trim().length > 0).map(l => l.split(',').map(c => c.trim()));
      }

      function updateColsAndSort() {
        const text = input.value.trim();
        if (!text) {
          sortCol.innerHTML = '<option value="0">Column 1</option>';
          parsedRows = [];
          output.value = '';
          return;
        }

        parsedRows = parseCsvLines(text);
        if (parsedRows.length === 0) return;

        const headers = parsedRows[0];
        const currentSelected = sortCol.value;
        sortCol.innerHTML = headers.map((h, i) => `<option value="${i}">${h} (Col ${i + 1})</option>`).join('');
        if (currentSelected < headers.length) sortCol.value = currentSelected;

        sortData();
      }

      function sortData() {
        if (parsedRows.length < 2) return;
        const colIdx = parseInt(sortCol.value, 10) || 0;
        const isDesc = sortDir.value === 'desc';

        const header = parsedRows[0];
        const dataRows = [...parsedRows.slice(1)];

        dataRows.sort((a, b) => {
          const vA = a[colIdx] || '';
          const vB = b[colIdx] || '';
          const nA = parseFloat(vA);
          const nB = parseFloat(vB);

          let cmp = 0;
          if (!isNaN(nA) && !isNaN(nB)) {
            cmp = nA - nB;
          } else {
            cmp = vA.localeCompare(vB);
          }
          return isDesc ? -cmp : cmp;
        });

        output.value = [header.join(','), ...dataRows.map(r => r.join(','))].join('\n');
      }

      input.addEventListener('input', updateColsAndSort);
      sortCol.addEventListener('change', sortData);
      sortDir.addEventListener('change', sortData);

      sampleBtn.addEventListener('click', () => {
        input.value = `product,price,rating,sales\nWireless Headphones,89.99,4.8,1450\nBluetooth Speaker,45.50,4.2,2800\nGaming Keyboard,119.00,4.9,920\nUSB-C Cable,9.99,4.5,5400\n4K Monitor,299.99,4.7,410`;
        updateColsAndSort();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
        updateColsAndSort();
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'sorted.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
