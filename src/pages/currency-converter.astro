---
import SiteLayout from '../layouts/SiteLayout.astro';
import CurrencyConverterApp from '../components/CurrencyConverterApp.astro';
import { siteName, withBasePath } from '../utils/site';

const pageTitle = `Currency Converter Calculator & FX Rates · ${siteName}`;
const pageDesc = 'Free currency converter calculator with live FX exchange rate calculator data. Convert 160+ world currencies instantly with real-time foreign market rates.';
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={withBasePath('/currency-converter/')}>
  <div class="mx-auto max-w-5xl space-y-10">
    <!-- Breadcrumb / compact page context -->
    <nav class="site-tool-breadcrumb flex items-center gap-2 text-xs font-medium text-[color:var(--muted)] mb-4 pt-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Currency Converter</span>
    </nav>

    <!-- ACTUAL TOOL UI -->
    <CurrencyConverterApp />

    <!-- Description Section -->
    <header class="space-y-3">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--fg)]">
        Currency Converter Calculator &amp; FX Exchange Rate Calculator
      </h1>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
        Convert 160+ world currencies with our free currency converter calculator and live FX exchange rate calculator. Check real-time foreign exchange market values instantly.
      </p>
    </header>
  </div>
</SiteLayout>
