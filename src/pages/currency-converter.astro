---
import SiteLayout from '../layouts/SiteLayout.astro';
import CurrencyConverterApp from '../components/CurrencyConverterApp.astro';
import { withBasePath } from '../utils/site';

const pageTitle = "Currency Converter — Live Currency Exchange Rates & Forex Calculator";
const pageDesc = "Free online currency converter and exchange rate calculator. Convert 160+ world currencies with real-time currency exchange rates, live forex calculator data, and instant money converter tools.";
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={withBasePath('/currency-converter/')}>
  <div class="mx-auto max-w-5xl space-y-10">
    <!-- Breadcrumb / compact page context -->
    <nav class="site-tool-breadcrumb flex items-center gap-2 text-xs font-medium text-[color:var(--muted)] mb-4 pt-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <a href="/#calculators?category=Converters" class="hover:text-[color:var(--accent)]">Converters</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Currency Converter</span>
    </nav>

    <!-- ACTUAL TOOL UI -->
    <CurrencyConverterApp />

    <!-- Description Section -->
    <header class="space-y-3">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--fg)]">
        Currency Converter &amp; Exchange Rate Calculator
      </h1>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
        Calculate live foreign currency exchange rates, compare world currencies, and convert foreign currency instantly with our free online currency converter and forex calculator.
      </p>
    </header>
  </div>
</SiteLayout>
