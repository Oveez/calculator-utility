---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { siteName, withBasePath } from '../utils/site';

const pageTitle = `Contact Us · ${siteName}`;
const pageDesc = `Get in touch with the ${siteName} development team. Report a bug, suggest a new calculator feature, or request tax bracket updates.`;
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={withBasePath('/contact/')}>
  <div class="mx-auto max-w-4xl space-y-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-medium text-[color:var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--fg)]">Home</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Contact</span>
    </nav>

    <!-- Page Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-bold text-[color:var(--fg)]">
        <span>Support &amp; Feedback</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-[color:var(--fg)] sm:text-3xl lg:text-4xl">
        Contact the Development Team
      </h1>
      <p class="text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
        Have feedback, discovered a calculation discrepancy, or want to suggest a new country tax bracket or financial calculator? We would love to hear from you.
      </p>
    </header>

    <!-- Contact Options Cards -->
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 space-y-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
          <Icon name="github" class="w-5 h-5" />
        </div>
        <div>
          <h2 class="text-base font-bold text-[color:var(--fg)]">GitHub Repository &amp; Issues</h2>
          <p class="mt-1 text-xs leading-relaxed text-[color:var(--muted)]">
            Open-source feature requests, formula reviews, and bug reports can be submitted directly via GitHub.
          </p>
        </div>
        <a
          href="https://github.com/Oveez/calculator-utility/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline"
        >
          <span>Open a GitHub Issue</span>
          <Icon name="arrow-right" class="w-3 h-3" />
        </a>
      </div>

      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 space-y-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
          <Icon name="mail" class="w-5 h-5" />
        </div>
        <div>
          <h2 class="text-base font-bold text-[color:var(--fg)]">Direct Email Inquiries</h2>
          <p class="mt-1 text-xs leading-relaxed text-[color:var(--muted)]">
            For general questions, partnerships, or tax data verification inquiries, email our maintainers.
          </p>
        </div>
        <a
          href="mailto:calculatorutility2026@gmail.com"
          class="inline-block text-xs font-mono font-semibold text-[color:var(--fg)] hover:underline"
        >
          calculatorutility2026@gmail.com
        </a>
      </div>
    </div>

    <!-- Quick Message Form -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-5">
      <div class="space-y-1">
        <h2 class="text-lg font-bold tracking-tight text-[color:var(--fg)]">Send us your feedback</h2>
        <p class="text-xs text-[color:var(--muted)]">Calculations run locally in your browser, but your feedback helps us improve all tool engines.</p>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); document.getElementById('contact-success').classList.remove('hidden'); this.reset();">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block space-y-1.5 text-xs font-bold text-[color:var(--fg)]">
            <span>Your Name</span>
            <input
              type="text"
              required
              placeholder="e.g. Jane Doe"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-xs sm:text-sm text-[color:var(--fg)] outline-none transition focus:border-[color:var(--border-strong)] focus:ring-1 focus:ring-[color:var(--accent)]"
            />
          </label>
          <label class="block space-y-1.5 text-xs font-bold text-[color:var(--fg)]">
            <span>Your Email</span>
            <input
              type="email"
              required
              placeholder="jane@example.com"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-xs sm:text-sm text-[color:var(--fg)] outline-none transition focus:border-[color:var(--border-strong)] focus:ring-1 focus:ring-[color:var(--accent)]"
            />
          </label>
        </div>

        <label class="block space-y-1.5 text-xs font-bold text-[color:var(--fg)]">
          <span>Topic / Category</span>
          <select
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-xs sm:text-sm text-[color:var(--fg)] outline-none transition focus:border-[color:var(--border-strong)] focus:ring-1 focus:ring-[color:var(--accent)]"
          >
            <option value="tax">Tax Calculator &amp; Bracket Correction</option>
            <option value="currency">Currency Converter &amp; Exchange Rates</option>
            <option value="math">Math / Finance Formula Discrepancy</option>
            <option value="feature">New Calculator Suggestion</option>
            <option value="general">General Feedback / Privacy Question</option>
          </select>
        </label>

        <label class="block space-y-1.5 text-xs font-bold text-[color:var(--fg)]">
          <span>Message</span>
          <textarea
            rows="4"
            required
            placeholder="Describe your suggestion or calculation issue in detail..."
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-xs sm:text-sm text-[color:var(--fg)] outline-none transition focus:border-[color:var(--border-strong)] focus:ring-1 focus:ring-[color:var(--accent)]"
          ></textarea>
        </label>

        <button
          type="submit"
          class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-[color:var(--accent)] px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]"
        >
          Send Message
        </button>
      </form>

      <div id="contact-success" class="hidden rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-xs font-semibold text-[color:var(--fg)]">
        Thank you for your message! Our team will review your feedback promptly.
      </div>
    </section>
  </div>
</SiteLayout>
