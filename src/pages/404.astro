---
import SiteLayout from '../layouts/SiteLayout.astro';
import { calculators } from '../data/calculators';
import { getCalculatorPath } from '../utils/calculators';
import { siteName, withBasePath } from '../utils/site';

const popularCalculators = calculators.slice(0, 4);
---

<SiteLayout title={`Page Not Found · ${siteName}`} description="The requested calculator or page was not found.">
  <div class="mx-auto max-w-2xl py-12 text-center">
    <div class="inline-flex h-20 w-20 items-center justify-center rounded-3xl bg-[color:var(--accent-soft)] text-4xl shadow-inner">
      🔍
    </div>

    <h1 class="mt-6 text-4xl font-bold tracking-tight text-[color:var(--fg)] sm:text-5xl">404 - Page Not Found</h1>
    <p class="mt-4 text-lg text-[color:var(--muted)]">
      The calculator or page you were looking for doesn't exist or may have been moved.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={withBasePath('/')}
        class="inline-flex items-center gap-2 rounded-full bg-[color:var(--accent)] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[color:var(--accent-strong)] hover:shadow"
      >
        <span>🏠 Return Home</span>
      </a>
      <a
        href={withBasePath('/#calculators')}
        class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-6 py-3 text-sm font-semibold text-[color:var(--fg)] shadow-sm transition hover:border-[color:var(--accent)] hover:bg-[color:var(--surface-strong)]"
      >
        <span>Browse All Calculators</span>
      </a>
    </div>

    <div class="mt-14 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 text-left shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wider text-[color:var(--accent)]">Popular Tools</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {popularCalculators.map((calc) => (
          <a
            href={getCalculatorPath(calc.slug)}
            class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:-translate-y-0.5 hover:border-[color:var(--accent)]"
          >
            <p class="text-xs font-semibold text-[color:var(--accent)]">{calc.category}</p>
            <p class="mt-1 font-semibold text-[color:var(--fg)] group-hover:text-[color:var(--accent)]">{calc.title}</p>
            <p class="mt-1 text-xs text-[color:var(--muted)] line-clamp-1">{calc.metaDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</SiteLayout>
