---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Strong Password Generator — Cryptographically Secure Passwords · ${siteName}`;
const pageDesc = 'Generate strong, unbreakable passwords using Web Cryptography CSPRNG. Customize uppercase, lowercase, numbers, symbols, and length with real-time entropy calculation.';
const canonicalUrl = toAbsoluteUrl('/generators/password-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Generators', href: toAbsoluteUrl('/generators/') },
  { label: 'Password Generator' },
];

const schemaFaq = [
  {
    question: 'How secure is in-browser password generation?',
    answer: 'It uses `window.crypto.getRandomValues`, which pulls entropy directly from OS-level hardware cryptographic pools. Because it runs purely in client-side memory, the password is never transmitted across any network.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Strong Password Generator',
    url: canonicalUrl,
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pwd-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>CSPRNG Zero-Knowledge Generator</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Strong Password Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate uncrackable, cryptographically secure passwords with custom character sets and entropy scores.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Password Display Box -->
      <div class="space-y-3 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8">
        <div class="flex items-center justify-between gap-4">
          <input
            type="text"
            id="pwd-display"
            readonly
            class="w-full bg-transparent font-mono text-xl sm:text-3xl font-extrabold text-[color:var(--fg)] tracking-wider focus:outline-hidden select-all"
            value="Generating..."
          />
          <button
            type="button"
            data-copy-btn
            class="shrink-0 rounded-2xl bg-[color:var(--fg)] px-5 py-3 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 active:scale-95"
          >
            Copy Password
          </button>
        </div>

        <div class="flex items-center justify-between text-xs pt-3 border-t border-[color:var(--border)]">
          <span id="strength-lbl" class="font-bold text-cyan-500 dark:text-cyan-400">Very Strong (128 bits entropy)</span>
          <button type="button" id="regen-btn" class="inline-flex items-center gap-1 font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
            </svg>
            <span>Regenerate</span>
          </button>
        </div>
      </div>

      <!-- Settings & Sliders -->
      <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
        <div>
          <div class="flex justify-between mb-1 font-bold text-[color:var(--fg)]">
            <span>Password Length:</span>
            <span id="len-txt" class="font-mono text-cyan-500 dark:text-cyan-400 text-sm">20</span>
          </div>
          <input type="range" id="len-slider" min="8" max="64" value="20" class="w-full accent-[color:var(--fg)] cursor-pointer" />
        </div>

        <div class="grid gap-3 sm:grid-cols-2 pt-2">
          <label class="flex items-center gap-2 cursor-pointer font-semibold text-[color:var(--fg)]">
            <input type="checkbox" id="opt-upper" checked class="rounded accent-[color:var(--fg)]" />
            <span>Uppercase Letters (A-Z)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer font-semibold text-[color:var(--fg)]">
            <input type="checkbox" id="opt-lower" checked class="rounded accent-[color:var(--fg)]" />
            <span>Lowercase Letters (a-z)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer font-semibold text-[color:var(--fg)]">
            <input type="checkbox" id="opt-nums" checked class="rounded accent-[color:var(--fg)]" />
            <span>Numbers (0-9)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer font-semibold text-[color:var(--fg)]">
            <input type="checkbox" id="opt-syms" checked class="rounded accent-[color:var(--fg)]" />
            <span>Symbols (!@#$%^&amp;*)</span>
          </label>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pwd-app]');
      if (!root) return;

      const pwdDisplay = root.querySelector('#pwd-display');
      const lenSlider = root.querySelector('#len-slider');
      const lenTxt = root.querySelector('#len-txt');
      const optUpper = root.querySelector('#opt-upper');
      const optLower = root.querySelector('#opt-lower');
      const optNums = root.querySelector('#opt-nums');
      const optSyms = root.querySelector('#opt-syms');
      const strengthLbl = root.querySelector('#strength-lbl');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const regenBtn = root.querySelector('#regen-btn');

      const UPPERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const LOWERS = 'abcdefghijklmnopqrstuvwxyz';
      const NUMBERS = '0123456789';
      const SYMBOLS = '!@#$%^&*()_+-=[]{}|;:,.<>?';

      function generate() {
        let pool = '';
        if (optUpper.checked) pool += UPPERS;
        if (optLower.checked) pool += LOWERS;
        if (optNums.checked) pool += NUMBERS;
        if (optSyms.checked) pool += SYMBOLS;

        if (!pool) {
          pwdDisplay.value = 'Select at least 1 set';
          strengthLbl.textContent = 'None';
          return;
        }

        const len = parseInt(lenSlider.value, 10);
        lenTxt.textContent = len;

        const randArr = new Uint32Array(len);
        crypto.getRandomValues(randArr);

        let pwd = '';
        for (let i = 0; i < len; i++) {
          pwd += pool[randArr[i] % pool.length];
        }

        pwdDisplay.value = pwd;

        const entropy = Math.round(len * Math.log2(pool.length));
        if (entropy >= 100) strengthLbl.textContent = `Very Strong (${entropy} bits entropy)`;
        else if (entropy >= 70) strengthLbl.textContent = `Strong (${entropy} bits entropy)`;
        else if (entropy >= 50) strengthLbl.textContent = `Moderate (${entropy} bits entropy)`;
        else strengthLbl.textContent = `Weak (${entropy} bits entropy)`;
      }

      [lenSlider, optUpper, optLower, optNums, optSyms].forEach(el => el.addEventListener('input', generate));
      regenBtn.addEventListener('click', generate);

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(pwdDisplay.value);
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => copyBtn.textContent = orig, 1800);
      });

      generate();
    })();
  </script>
</SiteLayout>
