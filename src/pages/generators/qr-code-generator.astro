---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Free QR Code Generator — URL, WiFi, Email & Text QR Codes · ${siteName}`;
const pageDesc = 'Generate high-resolution scannable QR codes for website URLs, WiFi networks, plain text, and emails online. 100% private in-browser tool with PNG download.';
const canonicalUrl = toAbsoluteUrl('/generators/qr-code-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Generators', href: toAbsoluteUrl('/generators/') },
  { label: 'QR Code Generator' },
];

const schemaFaq = [
  {
    question: 'How does in-browser QR code generation work?',
    answer: 'It encodes your payload string into a 2D matrix barcode format using the standard Reed-Solomon error correction algorithm and renders the high-contrast module pattern onto an HTML5 Canvas.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'QR Code Generator',
    url: canonicalUrl,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-qr-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Vector 2D Barcode Generator</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Free QR Code Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate instant, high-contrast QR codes for websites, WiFi networks, and text messages.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Input Configuration -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
          <div>
            <label for="qr-type" class="font-bold text-[color:var(--fg)] block mb-1">QR Code Content Type:</label>
            <select id="qr-type" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
              <option value="url">Website URL (https://...)</option>
              <option value="text">Plain Text Message</option>
              <option value="wifi">WiFi Network Credentials</option>
              <option value="email">Email Address &amp; Subject</option>
            </select>
          </div>

          <!-- Dynamic Input Fields based on type -->
          <div id="field-url" class="space-y-2">
            <label for="qr-url-input" class="font-bold text-[color:var(--fg)] block">Website URL:</label>
            <input
              type="url"
              id="qr-url-input"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-mono"
              placeholder="https://example.com"
              value="https://calculatorutility.tech" />
          </div>

          <div id="field-text" class="hidden space-y-2">
            <label for="qr-plain-text" class="font-bold text-[color:var(--fg)] block">Plain Text:</label>
            <textarea
              id="qr-plain-text"
              rows="3"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="Enter message or notes..."
            ></textarea>
          </div>

          <div id="field-wifi" class="hidden space-y-3">
            <div>
              <label for="wifi-ssid" class="font-bold text-[color:var(--fg)] block mb-1">Network Name (SSID):</label>
              <input type="text" id="wifi-ssid" placeholder="MyWiFiNetwork" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]" />
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="wifi-pass" class="font-bold text-[color:var(--fg)] block mb-1">Password:</label>
                <input type="text" id="wifi-pass" placeholder="Password123" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]" />
              </div>
              <div>
                <label for="wifi-auth" class="font-bold text-[color:var(--fg)] block mb-1">Security:</label>
                <select id="wifi-auth" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
                  <option value="WPA">WPA/WPA2/WPA3</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">None (Open)</option>
                </select>
              </div>
            </div>
          </div>

          <div id="field-email" class="hidden space-y-3">
            <div>
              <label for="email-addr" class="font-bold text-[color:var(--fg)] block mb-1">Recipient Email:</label>
              <input type="email" id="email-addr" placeholder="support@example.com" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]" />
            </div>
            <div>
              <label for="email-sub" class="font-bold text-[color:var(--fg)] block mb-1">Subject:</label>
              <input type="text" id="email-sub" placeholder="Inquiry from QR" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-2">
            <div>
              <label for="fg-color" class="font-bold text-[color:var(--fg)] block mb-1">QR Color:</label>
              <input type="color" id="fg-color" value="#09090b" class="h-9 w-full rounded-xl border border-[color:var(--border)] cursor-pointer bg-transparent" />
            </div>
            <div>
              <label for="bg-color" class="font-bold text-[color:var(--fg)] block mb-1">Background:</label>
              <input type="color" id="bg-color" value="#ffffff" class="h-9 w-full rounded-xl border border-[color:var(--border)] cursor-pointer bg-transparent" />
            </div>
          </div>
        </div>

        <!-- Live QR Code Canvas & Download -->
        <div class="flex flex-col items-center justify-center space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center">
          <div class="p-3 bg-[color:var(--surface)] rounded-2xl border border-[color:var(--border)] shadow-sm inline-block">
            <canvas id="qr-canvas" width="240" height="240" class="block"></canvas>
          </div>
          <p class="text-xs text-[color:var(--muted)]">Scan with any standard smartphone camera or QR reader.</p>
          <div class="flex gap-2 w-full max-w-xs">
            <button
              type="button"
              id="dl-btn"
              class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-[color:var(--accent)] py-2.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer"
            >
              <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span>Download PNG</span>
            </button>
            <button
              type="button"
              id="copy-qr-btn"
              class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-2.5 text-xs font-bold text-[color:var(--fg)] shadow-xs transition hover:bg-[color:var(--surface-strong)] active:scale-95 cursor-pointer"
              title="Copy Image to Clipboard"
            >
              <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              <span>Copy</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <!-- Lightweight Standalone Standard QR Code Library -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-qr-app]');
      if (!root) return;

      const qrType = root.querySelector('#qr-type');
      const urlInput = root.querySelector('#qr-url-input');
      const textInput = root.querySelector('#qr-plain-text');
      const wifiSsid = root.querySelector('#wifi-ssid');
      const wifiPass = root.querySelector('#wifi-pass');
      const wifiAuth = root.querySelector('#wifi-auth');
      const emailAddr = root.querySelector('#email-addr');
      const emailSub = root.querySelector('#email-sub');
      const fgColor = root.querySelector('#fg-color');
      const bgColor = root.querySelector('#bg-color');
      const canvas = root.querySelector('#qr-canvas');
      const dlBtn = root.querySelector('#dl-btn');
      const copyBtn = root.querySelector('#copy-qr-btn');

      const fieldUrl = root.querySelector('#field-url');
      const fieldText = root.querySelector('#field-text');
      const fieldWifi = root.querySelector('#field-wifi');
      const fieldEmail = root.querySelector('#field-email');

      let qrcodeInstance = null;

      function getPayloadString() {
        const type = qrType.value;
        if (type === 'url') {
          return urlInput.value.trim() || 'https://calculatorutility.tech';
        } else if (type === 'text') {
          return textInput.value.trim() || 'Hello from Calculator Utility';
        } else if (type === 'wifi') {
          const ssid = wifiSsid.value.trim() || 'NetworkName';
          const pass = wifiPass.value.trim();
          const auth = wifiAuth.value;
          return `WIFI:S:${ssid};T:${auth};P:${pass};;`;
        } else if (type === 'email') {
          const email = emailAddr.value.trim() || 'user@example.com';
          const sub = encodeURIComponent(emailSub.value.trim() || '');
          return `mailto:${email}?subject=${sub}`;
        }
        return 'https://calculatorutility.tech';
      }

      function updateQr() {
        const payload = getPayloadString();
        const fg = fgColor.value || '#09090b';
        const bg = bgColor.value || '#ffffff';

        // Use QRCode.js library or fallback
        if (window.QRCode) {
          const tempDiv = document.createElement('div');
          try {
            new QRCode(tempDiv, {
              text: payload,
              width: 240,
              height: 240,
              colorDark: fg,
              colorLight: bg,
              correctLevel: QRCode.CorrectLevel.M,
            });

            // Extract canvas from tempDiv to main canvas
            const generatedCanvas = tempDiv.querySelector('canvas');
            if (generatedCanvas) {
              const ctx = canvas.getContext('2d');
              ctx.clearRect(0, 0, canvas.width, canvas.height);
              ctx.drawImage(generatedCanvas, 0, 0, canvas.width, canvas.height);
            }
          } catch (e) {
            console.error('QR Render error:', e);
          }
        }
      }

      function onTypeChange() {
        fieldUrl.classList.add('hidden');
        fieldText.classList.add('hidden');
        fieldWifi.classList.add('hidden');
        fieldEmail.classList.add('hidden');

        if (qrType.value === 'url') fieldUrl.classList.remove('hidden');
        else if (qrType.value === 'text') fieldText.classList.remove('hidden');
        else if (qrType.value === 'wifi') fieldWifi.classList.remove('hidden');
        else if (qrType.value === 'email') fieldEmail.classList.remove('hidden');

        updateQr();
      }

      qrType.addEventListener('change', onTypeChange);
      [urlInput, textInput, wifiSsid, wifiPass, wifiAuth, emailAddr, emailSub, fgColor, bgColor].forEach((el) => {
        el?.addEventListener('input', updateQr);
      });

      dlBtn.addEventListener('click', () => {
        const link = document.createElement('a');
        link.download = 'qrcode.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });

      copyBtn?.addEventListener('click', async () => {
        try {
          canvas.toBlob(async (blob) => {
            if (!blob) return;
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': blob })
            ]);
            copyBtn.innerHTML = `
              <svg class="w-3.5 h-3.5 text-cyan-500 dark:text-cyan-400 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Copied!</span>
            `;
            setTimeout(() => {
              copyBtn.innerHTML = `
                <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span>Copy</span>
              `;
            }, 2000);
          });
        } catch (err) {
          alert('Copy to clipboard is not supported in this browser.');
        }
      });

      // Check for CDN loaded
      if (window.QRCode) {
        updateQr();
      } else {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
        script.onload = updateQr;
        document.head.appendChild(script);
      }
    })();
  </script>
</SiteLayout>
