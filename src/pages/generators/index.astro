---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Online Generators | Random Numbers, Names, Passwords, QR Codes & SKUs · ${siteName}`;
const pageDesc = 'Free client-side generators. Generate random numbers, choices, names, cryptographically secure passwords, readable passphrases, QR codes, invoice numbers, and retail SKUs in your browser.';
const canonicalUrl = toAbsoluteUrl('/generators/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Generators' },
];

const genToolsList = [
  {
    slug: 'random-number-generator',
    title: 'Random Number Generator (RNG)',
    badge: 'Popular',
    metaDescription: 'Generate single or bulk cryptographically secure random integers, decimals, or lottery numbers.',
    href: withBasePath('/generators/random-number-generator/'),
    icon: 'dice',
  },
  {
    slug: 'random-name-picker',
    title: 'Random Name Picker',
    badge: 'Raffles / Giveaways',
    metaDescription: 'Pick winning names from custom lists for raffles, giveaways, and contests with animated countdown.',
    href: withBasePath('/generators/random-name-picker/'),
    icon: 'dice',
  },
  {
    slug: 'random-choice-generator',
    title: 'Random Choice / Decision Maker',
    badge: 'Decisions',
    metaDescription: 'Can’t decide what to eat or do? Pick a random choice instantly from your custom list of options.',
    href: withBasePath('/generators/random-choice-generator/'),
    icon: 'dice',
  },
  {
    slug: 'password-generator',
    title: 'Strong Password Generator',
    badge: 'Security',
    metaDescription: 'Generate high-entropy cryptographically secure random passwords with symbols, numbers, and custom lengths.',
    href: withBasePath('/generators/password-generator/'),
    icon: 'lock',
  },
  {
    slug: 'passphrase-generator',
    title: 'Diceware Passphrase Generator',
    badge: 'Memorable',
    metaDescription: 'Generate human-memorable, high-security multi-word passphrases (e.g. correct-horse-battery-staple).',
    href: withBasePath('/generators/passphrase-generator/'),
    icon: 'lock',
  },
  {
    slug: 'qr-code-generator',
    title: 'QR Code Generator',
    badge: 'Popular',
    metaDescription: 'Generate high-resolution scannable QR codes for URLs, WiFi credentials, plain text, and emails.',
    href: withBasePath('/generators/qr-code-generator/'),
    icon: 'qr',
  },
  {
    slug: 'invoice-number-generator',
    title: 'Invoice Number Generator',
    badge: 'Business',
    metaDescription: 'Create professional sequential, date-based, and project-coded invoice serial numbering schemes.',
    href: withBasePath('/generators/invoice-number-generator/'),
    icon: 'finance',
  },
  {
    slug: 'sku-generator',
    title: 'Retail SKU Generator',
    badge: 'E-Commerce',
    metaDescription: 'Generate structured Stock Keeping Unit (SKU) product codes for inventory management and online stores.',
    href: withBasePath('/generators/sku-generator/'),
    icon: 'finance',
  },
];

const schemaFaq = [
  {
    question: 'Are generated passwords or data stored on a server?',
    answer: 'No. All random generators execute 100% locally in your browser using Web Cryptography (`window.crypto.getRandomValues`). Nothing is sent to any server.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-bold text-[color:var(--fg)]">
        <span>CSPRNG Online Generators</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Online Generators Suite
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Generate cryptographically secure passwords, random numbers, decisions, QR codes, and e-commerce SKU codes in your browser.
      </p>
    </header>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Directory</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">8 Client-Side Generators</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          8 Tools
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {genToolsList.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
          >
            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold text-[color:var(--fg)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)]">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[color:var(--fg)]">
              <span>Open Generator</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
