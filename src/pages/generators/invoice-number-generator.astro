---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Invoice Number Generator — Professional Serial Numbering Schemes · ${siteName}`;
const pageDesc = 'Create standardized invoice numbering schemes (Date-based, Client-prefixed, Sequential with zero-padding) for freelancers and small businesses in bulk.';
const canonicalUrl = toAbsoluteUrl('/generators/invoice-number-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Generators', href: toAbsoluteUrl('/generators/') },
  { label: 'Invoice Number Generator' },
];

const schemaFaq = [
  {
    question: 'What is the best practice for invoice numbering formats?',
    answer: 'Popular schemes include: Date-based (`INV-YYYYMM-001`), Client-coded (`CLI-2026-0042`), and pure sequential with 4 or 5 zero padding (`INV-00100`). Consistent numbering ensures seamless tax tracking and auditing.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Invoice Number Generator',
    url: canonicalUrl,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-inv-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Accounting &amp; Billing Serializer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Invoice Number Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate professional, structured invoice serial numbers for freelance contracts and business billing.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="inv-prefix" class="font-bold text-[color:var(--fg)] block mb-1">Prefix Code:</label>
          <input
            type="text"
            id="inv-prefix"
            value="INV-"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]" />
        </div>

        <div>
          <label for="date-fmt" class="font-bold text-[color:var(--fg)] block mb-1">Date Infix:</label>
          <select id="date-fmt" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="YYYYMM">YYYYMM (202609)</option>
            <option value="YYYY">YYYY (2026)</option>
            <option value="YYMM">YYMM (2609)</option>
            <option value="none">No Date</option>
          </select>
        </div>

        <div>
          <label for="start-seq" class="font-bold text-[color:var(--fg)] block mb-1">Starting Number:</label>
          <input
            type="number"
            id="start-seq"
            min="1"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]" placeholder="e.g. 1" />
        </div>

        <div>
          <label for="gen-count" class="font-bold text-[color:var(--fg)] block mb-1">Batch Count:</label>
          <input
            type="number"
            id="gen-count"
            min="1"
            max="100"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]" placeholder="e.g. 10" />
        </div>
      </div>

      <!-- Output List -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated Invoice Series</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Series</span>
          </button>
        </div>
        <textarea
          id="inv-output"
          rows="8"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-cyan-500 dark:text-cyan-400 font-bold focus:outline-hidden"
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-inv-app]');
      if (!root) return;

      const prefix = root.querySelector('#inv-prefix');
      const dateFmt = root.querySelector('#date-fmt');
      const startSeq = root.querySelector('#start-seq');
      const genCount = root.querySelector('#gen-count');
      const output = root.querySelector('#inv-output');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function getDatePart(fmt) {
        const now = new Date();
        const yyyy = now.getFullYear();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const yy = String(yyyy).slice(-2);

        if (fmt === 'YYYYMM') return `${yyyy}${mm}-`;
        if (fmt === 'YYYY') return `${yyyy}-`;
        if (fmt === 'YYMM') return `${yy}${mm}-`;
        return '';
      }

      function update() {
        const p = prefix.value.trim();
        const d = getDatePart(dateFmt.value);
        const start = (startSeq.value !== '' && !isNaN(parseInt(startSeq.value, 10)) ? parseInt(startSeq.value, 10) : 0);
        const count = Math.min(100, Math.max(1, (genCount.value !== '' && !isNaN(parseInt(genCount.value, 10)) ? parseInt(genCount.value, 10) : 0)));

        const list = [];
        for (let i = 0; i < count; i++) {
          const num = String(start + i).padStart(4, '0');
          list.push(`${p}${d}${num}`);
        }

        output.value = list.join('\n');
      }

      [prefix, dateFmt, startSeq, genCount].forEach(el => el.addEventListener('input', update));

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      update();
    })();
  </script>
</SiteLayout>
