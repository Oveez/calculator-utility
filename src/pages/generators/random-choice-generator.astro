---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Random Choice Generator — Quick Decision Maker · ${siteName}`;
const pageDesc = 'Can’t decide between options? Pick a random choice instantly from your list (e.g. what to eat, movies to watch, daily tasks). 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/generators/random-choice-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Generators', href: toAbsoluteUrl('/generators/') },
  { label: 'Random Choice Generator' },
];

const schemaFaq = [
  {
    question: 'How does the random choice generator make decisions?',
    answer: 'It selects an option uniformly from your input choices using browser-level CSPRNG entropy (`crypto.getRandomValues`).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Random Choice Generator',
    url: canonicalUrl,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-choice-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Everyday Decision Maker</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Random Choice Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Let randomness make your choices. Perfect for food picks, team decisions, and activities.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Choice Hero Display -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-8 sm:p-12 text-center space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">The Decision Is:</span>
        <p id="choice-result" class="text-3xl sm:text-5xl font-black text-cyan-500 dark:text-cyan-400 min-h-16 flex items-center justify-center">
          Make a Choice!
        </p>

        <button
          type="button"
          id="decide-btn"
          class="inline-flex items-center justify-center gap-2 rounded-2xl bg-[color:var(--accent)] px-8 py-3.5 text-sm sm:text-base font-extrabold text-white shadow-md transition hover:opacity-90 active:scale-95 cursor-pointer"
        >
          <Icon name="dice" class="w-5 h-5" />
          <span>Decide for Me</span>
        </button>
      </div>

      <!-- Presets & Inputs -->
      <div class="space-y-4">
        <div class="flex flex-wrap gap-2 text-xs">
          <span class="text-[color:var(--muted)] py-1 font-semibold">Presets:</span>
          <button type="button" data-preset="food" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 font-semibold text-[color:var(--fg)] hover:border-emerald-500 cursor-pointer">Food / Dinner</button>
          <button type="button" data-preset="movie" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 font-semibold text-[color:var(--fg)] hover:border-emerald-500 cursor-pointer">Movie Genres</button>
          <button type="button" data-preset="yesno" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 font-semibold text-[color:var(--fg)] hover:border-emerald-500 cursor-pointer">Yes / No / Maybe</button>
        </div>

        <div class="space-y-2">
          <label for="choices-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Your Options (One choice per line)</label>
          <textarea
            id="choices-in"
            rows="6"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Option 1&#10;Option 2&#10;Option 3"
          >Italian (Pasta &amp; Pizza)
Japanese (Sushi &amp; Ramen)
Mexican (Tacos &amp; Burritos)
Thai (Pad Thai &amp; Curry)
Mediterranean (Falafel &amp; Shawarma)</textarea>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-choice-app]');
      if (!root) return;

      const choicesIn = root.querySelector('#choices-in');
      const decideBtn = root.querySelector('#decide-btn');
      const choiceResult = root.querySelector('#choice-result');
      const presetBtns = root.querySelectorAll('[data-preset]');

      const PRESETS = {
        food: 'Pizza\nBurgers\nSushi\nTacos\nSalad & Bowls\nIndian Curry\nChinese Noodles',
        movie: 'Action & Adventure\nSci-Fi & Fantasy\nComedy\nPsychological Thriller\nDrama\nDocumentary',
        yesno: 'Yes, Absolutely!\nNo, Not today.\nMaybe (Flip a coin again)'
      };

      presetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-preset');
          choicesIn.value = PRESETS[type] || '';
          choiceResult.textContent = 'Make a Choice!';
        });
      });

      function decide() {
        const list = choicesIn.value.split('\n').map(s => s.trim()).filter(s => s.length > 0);
        if (list.length === 0) {
          choiceResult.textContent = 'Please enter options!';
          return;
        }

        decideBtn.disabled = true;
        let counter = 0;
        const interval = setInterval(() => {
          const rand = list[Math.floor(Math.random() * list.length)];
          choiceResult.textContent = rand;
          counter++;
          if (counter > 12) {
            clearInterval(interval);
            const randArr = new Uint32Array(1);
            crypto.getRandomValues(randArr);
            const chosen = list[randArr[0] % list.length];
            choiceResult.textContent = chosen;
            decideBtn.disabled = false;
          }
        }, 60);
      }

      decideBtn.addEventListener('click', decide);
    })();
  </script>
</SiteLayout>
