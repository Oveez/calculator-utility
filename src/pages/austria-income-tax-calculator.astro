---
import SiteLayout from '../layouts/SiteLayout.astro';
import AtTaxCalculatorApp from '../components/tax/AtTaxCalculatorApp.astro';
import TaxFaqSection from '../components/tax/TaxFaqSection.astro';
import CountryTaxSelector from '../components/tax/CountryTaxSelector.astro';
import { atProfile } from '../data/tax/countries/at';

const profile = atProfile;
const defaultYear = profile.years[profile.defaultTaxYear];
---

<SiteLayout title="Salary Calculator Austria 2026: Net Pay · ToolsCastle"
  description="Free salary calculator Austria and gross-to-net tool. Compute Austrian net take-home pay, SV insurance, and 2026 BMF progressive tax brackets."
>
  
  <div class="mx-auto max-w-5xl space-y-10">
    <!-- Breadcrumb / compact page context -->
    <nav class="site-tool-breadcrumb mb-4 pt-1 flex items-center gap-2 text-xs font-medium text-[color:var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">{profile.name}</span>
    </nav>


    <!-- Flagship Interactive Calculator App -->
    <AtTaxCalculatorApp profile={profile} />

    <!-- Description Section -->
    <header class="space-y-3">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--fg)]">
        Salary Calculator Austria: 2026 Gross to Net Tax Calculator
      </h1>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
        Calculate Austrian net salary and income tax (Einkommensteuer / Lohnsteuer) with our free Austria tax calculator. Compute social insurance (SV ~18.12%), 13th and 14th month pay, and official 2026 BMF inflation-adjusted brackets.
      </p>
    </header>

    <!-- Informational / Educational Content Section -->
    <section class="space-y-6 rounded-[2rem] border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8" aria-labelledby="how-it-works-heading">
      <h2 id="how-it-works-heading" class="text-2xl font-bold tracking-tight text-[color:var(--fg)]">
        How {profile.name} Income Tax is Calculated ({defaultYear.taxYear})
      </h2>
      <div class="space-y-4 text-sm leading-relaxed text-[color:var(--muted)]">
        <p>
          Income tax in {profile.name} is determined using a progressive marginal bracket system. Taxpayers only pay each bracket's specific rate on the slice of taxable income falling within that tier.
        </p>
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4">
            <p class="font-bold text-[color:var(--fg)]">1. Gross Income</p>
            <p class="mt-1 text-xs">Total annual salary, wages, and earned employment compensation.</p>
          </div>
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4">
            <p class="font-bold text-[color:var(--fg)]">2. Allowances &amp; Deductions</p>
            <p class="mt-1 text-xs">Standard statutory allowances and tax-free thresholds subtracted from gross earnings.</p>
          </div>
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4">
            <p class="font-bold text-[color:var(--fg)]">3. Progressive Tax Slices</p>
            <p class="mt-1 text-xs">Progressive rates applied sequentially to arrive at net take-home salary.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Country FAQs with Schema Markup -->
    <TaxFaqSection faqItems={profile.faqItems} countryName={profile.name} />

    <!-- Country Selector Hub Grid -->
    <CountryTaxSelector currentCountryId="austria" />
  </div>
</SiteLayout>
