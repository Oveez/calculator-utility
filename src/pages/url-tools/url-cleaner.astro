---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `URL Cleaner — Strip Tracking Parameters & Spy Tags · ${siteName}`;
const pageDesc = 'Clean URLs by removing marketing trackers, click IDs, and analytics tags (utm_*, fbclid, gclid, msclkid, ref, igshid) online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/url-tools/url-cleaner/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'URL Tools', href: toAbsoluteUrl('/url-tools/') },
  { label: 'URL Cleaner' },
];

const schemaFaq = [
  {
    question: 'Which tracking tags does this URL cleaner remove?',
    answer: 'It removes Facebook Click IDs (`fbclid`), Google Ads (`gclid`), Microsoft Ads (`msclkid`), Instagram (`igshid`), TikTok (`ttclid`), Mailchimp (`mc_eid`), Twitter (`twclid`), and all standard Google Analytics (`utm_*`) tags.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'URL Tracking Cleaner',
    url: canonicalUrl,
    applicationCategory: 'PrivacyApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-clean-url-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Anti-Tracker URL Sanitizer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        URL Tracking Parameter Cleaner
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Strip tracking tokens, ad click IDs, and analytics parameters while keeping clean destination links intact.
      </p>
    </header>

    <div class="space-y-6">
      <div class="space-y-2">
        <label for="url-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tracked URL Input</label>
        <textarea
          id="url-in"
          rows="3"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste URL with tracking tags..."
        >https://example.com/item/4921?utm_source=facebook&utm_medium=cpc&fbclid=IwAR2X_9aJkL5Q8zP7mN3B1vC&gclid=CjwKCAjw&ref=share#specs</textarea>
      </div>

      <!-- Result Card -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Clean Sanitized URL</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Clean URL</span>
          </button>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4">
          <p id="clean-out" class="font-mono text-xs font-bold text-cyan-500 dark:text-cyan-400 break-all select-all">-</p>
        </div>
        <p id="stripped-tags" class="text-xs text-[color:var(--muted)]"></p>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-clean-url-app]');
      if (!root) return;

      const input = root.querySelector('#url-in');
      const output = root.querySelector('#clean-out');
      const tagsEl = root.querySelector('#stripped-tags');
      const copyBtn = root.querySelector('[data-copy-btn]');

      const TRACKING_PREFIXES = ['utm_', 'fbclid', 'gclid', 'gclsrc', 'dclid', 'msclkid', 'twclid', 'ttclid', 'igshid', 'mc_eid', '_hsenc', '_hsmi', 'mkt_tok'];

      function cleanUrl() {
        const raw = input.value.trim();
        if (!raw) { output.textContent = '-'; tagsEl.textContent = ''; return; }

        try {
          const url = new URL(raw.startsWith('http') ? raw : `https://${raw}`);
          const stripped = [];

          const keysToDelete = [];
          url.searchParams.forEach((val, key) => {
            const lower = key.toLowerCase();
            if (TRACKING_PREFIXES.some(p => lower.startsWith(p)) || lower === 'ref' || lower === 'source') {
              keysToDelete.push(key);
              stripped.push(key);
            }
          });

          keysToDelete.forEach(k => url.searchParams.delete(k));

          output.textContent = url.toString();
          tagsEl.textContent = stripped.length > 0
            ? `Removed ${stripped.length} tracker parameter(s): ${stripped.join(', ')}`
            : 'No tracking parameters detected in this URL.';
        } catch (e) {
          output.textContent = 'Invalid URL format.';
          tagsEl.textContent = '';
        }
      }

      input.addEventListener('input', cleanUrl);

      copyBtn.addEventListener('click', () => {
        const text = output.textContent;
        if (!text || text === '-') return;
        navigator.clipboard.writeText(text);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      cleanUrl();
    })();
  </script>
</SiteLayout>
