---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHero from '../../components/SiteHero.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `URL & Web Tools | UTM Builder, Query Parsers & URL Cleaners · ${siteName}`;
const pageDesc = 'Free client-side URL and query parameter tools. Build UTM campaign links, extract query parameters, parse and construct query strings, strip tracking tags, and encode HTML entities.';
const canonicalUrl = toAbsoluteUrl('/url-tools/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'URL Tools' },
];

const urlToolsList = [
  {
    slug: 'url-parameter-extractor',
    title: 'URL Parameter Extractor',
    badge: 'Popular',
    metaDescription: 'Extract, decode, and table all URL query parameters and hash fragments from complex links.',
    href: withBasePath('/url-tools/url-parameter-extractor/'),
    icon: 'converter',
  },
  {
    slug: 'query-string-parser',
    title: 'Query String Parser',
    badge: 'Debugging',
    metaDescription: 'Parse raw query string fragments (?key=value) into structured JSON and key-value tables.',
    href: withBasePath('/url-tools/query-string-parser/'),
    icon: 'converter',
  },
  {
    slug: 'query-string-builder',
    title: 'Query String Builder',
    badge: 'Builder',
    metaDescription: 'Construct formatted, percent-encoded query strings from key-value inputs with live URL preview.',
    href: withBasePath('/url-tools/query-string-builder/'),
    icon: 'converter',
  },
  {
    slug: 'utm-builder',
    title: 'Google Analytics UTM Builder',
    badge: 'Marketing',
    metaDescription: 'Build clean marketing campaign URLs with Source, Medium, Campaign, Term, and Content parameters.',
    href: withBasePath('/url-tools/utm-builder/'),
    icon: 'converter',
  },
  {
    slug: 'utm-parser',
    title: 'UTM Parameter Parser',
    badge: 'Marketing',
    metaDescription: 'Inspect and extract campaign marketing tags from tracked URLs and ad links.',
    href: withBasePath('/url-tools/utm-parser/'),
    icon: 'converter',
  },
  {
    slug: 'url-cleaner',
    title: 'URL Tracking Parameter Cleaner',
    badge: 'Privacy',
    metaDescription: 'Strip spy tracking and ad parameters (fbclid, gclid, utm_*, msclkid) while keeping clean destination links.',
    href: withBasePath('/url-tools/url-cleaner/'),
    icon: 'converter',
  },
  {
    slug: 'html-entity-encoder-decoder',
    title: 'HTML Entity Encoder & Decoder',
    badge: 'Web',
    metaDescription: 'Encode special characters into HTML entities (&amp;, &lt;, &gt;) and decode entities back to text.',
    href: withBasePath('/url-tools/html-entity-encoder-decoder/'),
    icon: 'code',
  },
];

const schemaFaq = [
  {
    question: 'Are my URLs or marketing links tracked on this site?',
    answer: 'No. All URL parsing, parameter extraction, and link generation occur 100% locally in your browser memory. We never log or store your links.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl} heroCompact={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <SiteHero
    slot="hero"
    breadcrumbs={breadcrumbItems}
    badge="Client-Side URL Suite"
    title="URL &amp; Query String Tools"
    description="Inspect, build, parse, clean, and format web URLs and marketing links with zero server tracking."
  />

  <article class="space-y-10 py-2">

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Directory</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">7 In-Browser Web Engines</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          7 Tools
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {urlToolsList.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
            data-calculator-card
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon slug={tool.slug} category="URL & Web" size="md" />
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2.5 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center justify-between pt-2.5 border-t border-[color:var(--border)]/60">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                <span>Open Tool</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
              </span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--muted)] group-hover:text-[color:var(--fg)] transition-colors">Instant</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
