---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Google Analytics UTM Builder — Free Campaign URL Maker · ${siteName}`;
const pageDesc = 'Create tracking URLs for Google Analytics 4 (GA4), marketing campaigns, newsletters, and social media ads with utm_source, utm_medium, and utm_campaign tags.';
const canonicalUrl = toAbsoluteUrl('/url-tools/utm-builder/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'URL Tools', href: toAbsoluteUrl('/url-tools/') },
  { label: 'UTM Builder' },
];

const schemaFaq = [
  {
    question: 'What are UTM parameters and why are they used?',
    answer: 'UTM (Urchin Tracking Module) parameters are 5 standard query tags added to URLs to track marketing campaign performance in Google Analytics: Source, Medium, Campaign, Term, and Content.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Google Analytics UTM Builder',
    url: canonicalUrl,
    applicationCategory: 'MarketingApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-utm-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Google Analytics 4 Tracking Link Generator</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Google Analytics UTM Campaign Builder
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate standard tracking links for Google Analytics 4, email blasts, paid search, and social media campaigns.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Input Form -->
      <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
        <div>
          <label for="utm-url" class="font-bold text-[color:var(--fg)] block mb-1">
            Website URL <span class="text-red-500">*</span>:
          </label>
          <input
            type="text"
            id="utm-url"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
            placeholder="https://example.com/product"
            value="https://calculatorutility.tech/" />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="utm-source" class="font-bold text-[color:var(--fg)] block mb-1">
              Campaign Source (utm_source) <span class="text-red-500">*</span>:
            </label>
            <input
              type="text"
              id="utm-source"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. google, newsletter, twitter"
              value="newsletter" />
          </div>

          <div>
            <label for="utm-medium" class="font-bold text-[color:var(--fg)] block mb-1">
              Campaign Medium (utm_medium) <span class="text-red-500">*</span>:
            </label>
            <input
              type="text"
              id="utm-medium"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. cpc, banner, email, social"
              value="email" />
          </div>
        </div>

        <div>
          <label for="utm-campaign" class="font-bold text-[color:var(--fg)] block mb-1">
            Campaign Name (utm_campaign) <span class="text-red-500">*</span>:
          </label>
          <input
            type="text"
            id="utm-campaign"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
            placeholder="e.g. spring_sale, launch_2026"
            value="launch_promo" />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="utm-term" class="font-medium text-[color:var(--muted)] block mb-1">
              Campaign Term (utm_term - Optional):
            </label>
            <input
              type="text"
              id="utm-term"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. running+shoes, developer+tools" />
          </div>

          <div>
            <label for="utm-content" class="font-medium text-[color:var(--muted)] block mb-1">
              Campaign Content (utm_content - Optional):
            </label>
            <input
              type="text"
              id="utm-content"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. logolink, hero_cta" />
          </div>
        </div>
      </div>

      <!-- Result Card -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated Campaign URL</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy URL</span>
          </button>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4">
          <p id="utm-out" class="font-mono text-xs font-bold text-cyan-500 dark:text-cyan-400 break-all select-all">-</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-utm-app]');
      if (!root) return;

      const urlIn = root.querySelector('#utm-url');
      const srcIn = root.querySelector('#utm-source');
      const medIn = root.querySelector('#utm-medium');
      const cmpIn = root.querySelector('#utm-campaign');
      const trmIn = root.querySelector('#utm-term');
      const cntIn = root.querySelector('#utm-content');
      const output = root.querySelector('#utm-out');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function buildUtm() {
        const rawUrl = urlIn.value.trim();
        if (!rawUrl) { output.textContent = '-'; return; }

        try {
          const url = new URL(rawUrl.startsWith('http') ? rawUrl : `https://${rawUrl}`);

          if (srcIn.value.trim()) url.searchParams.set('utm_source', srcIn.value.trim());
          if (medIn.value.trim()) url.searchParams.set('utm_medium', medIn.value.trim());
          if (cmpIn.value.trim()) url.searchParams.set('utm_campaign', cmpIn.value.trim());
          if (trmIn.value.trim()) url.searchParams.set('utm_term', trmIn.value.trim());
          else url.searchParams.delete('utm_term');
          if (cntIn.value.trim()) url.searchParams.set('utm_content', cntIn.value.trim());
          else url.searchParams.delete('utm_content');

          output.textContent = url.toString();
        } catch (e) {
          output.textContent = 'Invalid base URL format.';
        }
      }

      [urlIn, srcIn, medIn, cmpIn, trmIn, cntIn].forEach(inp => inp.addEventListener('input', buildUtm));

      copyBtn.addEventListener('click', () => {
        const text = output.textContent;
        if (!text || text === '-') return;
        navigator.clipboard.writeText(text);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      buildUtm();
    })();
  </script>
</SiteLayout>
