---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `UTM Campaign Creator — Free UTM URL Maker · ${siteName}`;
const pageDesc = 'Free UTM campaign creator and UTM url maker. Build custom tracking links with utm parameter creator tags for Google Analytics GA4 and campaign ads.';
const canonicalUrl = toAbsoluteUrl('/url-tools/utm-builder/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'UTM Campaign Creator' },
];

const schemaFaq = [
  {
    question: 'What is a UTM campaign creator and why use a UTM URL maker?',
    answer: 'A UTM campaign creator and UTM URL maker attaches 5 standardized query tags (source, medium, campaign, term, content) to your web links so Google Analytics 4 (GA4) can track where your marketing traffic originates.',
  },
  {
    question: 'How does this UTM parameter creator handle campaign source and medium?',
    answer: 'This online UTM code builder formats utm_source (e.g., newsletter, google) and utm_medium (e.g., email, cpc) according to Google Analytics URL conventions, stripping errant spaces and avoiding duplicate question marks.',
  },
  {
    question: 'Can I parse or inspect existing tracking links?',
    answer: 'Yes. If you already have a tagged URL and want to extract or audit its query parameters, use our companion <a href="/url-tools/utm-parser/" class="text-[color:var(--accent)] font-semibold hover:underline">UTM Parser Tool</a>.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Google Analytics UTM Builder',
    url: canonicalUrl,
    applicationCategory: 'MarketingApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  
  <article class="space-y-10 py-2" data-utm-app>
    <!-- Breadcrumb / compact page context -->
    <nav class="site-tool-breadcrumb mb-4 pt-1" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>


    <div class="space-y-6">
      <!-- Input Form -->
      <div class="space-y-4 rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
        <div>
          <label for="utm-url" class="font-bold text-[color:var(--fg)] block mb-1">
            Website URL <span class="text-red-500">*</span>:
          </label>
          <input
            type="text"
            id="utm-url"
            class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
            placeholder="https://example.com/product"
            value="https://toolscastle.app/" />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="utm-source" class="font-bold text-[color:var(--fg)] block mb-1">
              Campaign Source (utm_source) <span class="text-red-500">*</span>:
            </label>
            <input
              type="text"
              id="utm-source"
              class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. google, newsletter, twitter"
              value="newsletter" />
          </div>

          <div>
            <label for="utm-medium" class="font-bold text-[color:var(--fg)] block mb-1">
              Campaign Medium (utm_medium) <span class="text-red-500">*</span>:
            </label>
            <input
              type="text"
              id="utm-medium"
              class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. cpc, banner, email, social"
              value="email" />
          </div>
        </div>

        <div>
          <label for="utm-campaign" class="font-bold text-[color:var(--fg)] block mb-1">
            Campaign Name (utm_campaign) <span class="text-red-500">*</span>:
          </label>
          <input
            type="text"
            id="utm-campaign"
            class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
            placeholder="e.g. spring_sale, launch_2026"
            value="launch_promo" />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="utm-term" class="font-medium text-[color:var(--muted)] block mb-1">
              Campaign Term (utm_term - Optional):
            </label>
            <input
              type="text"
              id="utm-term"
              class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. running+shoes, developer+tools" />
          </div>

          <div>
            <label for="utm-content" class="font-medium text-[color:var(--muted)] block mb-1">
              Campaign Content (utm_content - Optional):
            </label>
            <input
              type="text"
              id="utm-content"
              class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. logolink, hero_cta" />
          </div>
        </div>
      </div>

      <!-- Result Card -->
      <div class="space-y-3 rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated Campaign URL</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy URL</span>
          </button>
        </div>
        <div class="rounded-none border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4">
          <p id="utm-out" class="font-mono text-xs font-bold text-cyan-500 dark:text-cyan-400 break-all select-all">-</p>
        </div>
      </div>
    </div>

    <!-- Description Section -->
    <header class="space-y-3">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--fg)]">
        UTM Campaign Creator &amp; UTM URL Maker
      </h1>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
        Create custom campaign tracking links with our free UTM campaign creator and UTM URL maker. Add essential tags like campaign source, medium, and name with this online UTM parameter creator for Google Analytics 4 (GA4).
      </p>
    </header>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]" set:html={faq.answer} />
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-utm-app]');
      if (!root) return;

      const urlIn = root.querySelector('#utm-url');
      const srcIn = root.querySelector('#utm-source');
      const medIn = root.querySelector('#utm-medium');
      const cmpIn = root.querySelector('#utm-campaign');
      const trmIn = root.querySelector('#utm-term');
      const cntIn = root.querySelector('#utm-content');
      const output = root.querySelector('#utm-out');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function buildUtm() {
        const rawUrl = urlIn.value.trim();
        if (!rawUrl) { output.textContent = '-'; return; }

        try {
          const url = new URL(rawUrl.startsWith('http') ? rawUrl : `https://${rawUrl}`);

          if (srcIn.value.trim()) url.searchParams.set('utm_source', srcIn.value.trim());
          if (medIn.value.trim()) url.searchParams.set('utm_medium', medIn.value.trim());
          if (cmpIn.value.trim()) url.searchParams.set('utm_campaign', cmpIn.value.trim());
          if (trmIn.value.trim()) url.searchParams.set('utm_term', trmIn.value.trim());
          else url.searchParams.delete('utm_term');
          if (cntIn.value.trim()) url.searchParams.set('utm_content', cntIn.value.trim());
          else url.searchParams.delete('utm_content');

          output.textContent = url.toString();
        } catch (e) {
          output.textContent = 'Invalid base URL format.';
        }
      }

      [urlIn, srcIn, medIn, cmpIn, trmIn, cntIn].forEach(inp => inp.addEventListener('input', buildUtm));

      copyBtn.addEventListener('click', () => {
        const text = output.textContent;
        if (!text || text === '-') return;
        navigator.clipboard.writeText(text);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      buildUtm();
    })();
  </script>
</SiteLayout>
