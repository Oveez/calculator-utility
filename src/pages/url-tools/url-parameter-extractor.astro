---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `URL Parameter Extractor — Parse Query String Parameters · ${siteName}`;
const pageDesc = 'Extract and inspect URL query parameters, hash fragments, and decoded values online. Converts URL search params into a structured key-value table. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/url-tools/url-parameter-extractor/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'URL Tools', href: toAbsoluteUrl('/url-tools/') },
  { label: 'URL Parameter Extractor' },
];

const schemaFaq = [
  {
    question: 'How does this tool parse URL parameters?',
    answer: 'It parses the target URL using the standard browser `URL` and `URLSearchParams` interfaces, extracting the protocol, hostname, path, key-value pairs, and hash fragments.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'URL Parameter Extractor',
    url: canonicalUrl,
    applicationCategory: 'WebApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-param-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>URL SearchParams Parser</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        URL Query Parameter Extractor
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Extract, decode, and inspect all query string parameters from URLs and links in an interactive table.
      </p>
    </header>

    <div class="space-y-6">
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="url-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Enter Target URL</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="url-in"
          rows="3"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="https://example.com/search?q=calculator&category=math&utm_source=newsletter"
        >https://example.com/search?q=developer+tools&utm_source=twitter&utm_medium=social&utm_campaign=launch_2026&ref=blog#section2</textarea>
      </div>

      <!-- URL Components Summary -->
      <div class="grid gap-3 sm:grid-cols-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
        <div>
          <p class="text-[10px] text-[color:var(--muted)] font-bold">Host / Domain:</p>
          <p id="url-host" class="font-mono font-bold text-[color:var(--fg)]">-</p>
        </div>
        <div>
          <p class="text-[10px] text-[color:var(--muted)] font-bold">Pathname:</p>
          <p id="url-path" class="font-mono font-bold text-[color:var(--fg)]">-</p>
        </div>
        <div>
          <p class="text-[10px] text-[color:var(--muted)] font-bold">Hash Fragment:</p>
          <p id="url-hash" class="font-mono font-bold text-[color:var(--fg)]">-</p>
        </div>
      </div>

      <!-- Extracted Parameters Table -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Extracted Query Parameters</span>
          <span id="param-count" class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--fg)]">
            0 Parameters
          </span>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)]">
          <table class="w-full text-left text-xs">
            <thead class="bg-[color:var(--surface-strong)] text-[color:var(--muted)] border-b border-[color:var(--border)]">
              <tr>
                <th class="p-3.5 font-bold">Parameter Key</th>
                <th class="p-3.5 font-bold">Raw Value</th>
                <th class="p-3.5 font-bold">Decoded Value</th>
              </tr>
            </thead>
            <tbody id="params-tbody" class="divide-y divide-[color:var(--border)] font-mono text-[color:var(--fg)]">
              <tr><td colspan="3" class="p-4 text-center text-[color:var(--muted)] italic">No parameters found.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-param-app]');
      if (!root) return;

      const input = root.querySelector('#url-in');
      const hostEl = root.querySelector('#url-host');
      const pathEl = root.querySelector('#url-path');
      const hashEl = root.querySelector('#url-hash');
      const tbody = root.querySelector('#params-tbody');
      const paramCount = root.querySelector('#param-count');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');

      function parse() {
        const raw = input.value.trim();
        if (!raw) {
          hostEl.textContent = '-';
          pathEl.textContent = '-';
          hashEl.textContent = '-';
          paramCount.textContent = '0 Parameters';
          tbody.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-[color:var(--muted)] italic">No parameters found.</td></tr>';
          return;
        }

        try {
          const url = new URL(raw.startsWith('http') ? raw : `https://${raw}`);
          hostEl.textContent = url.hostname || '-';
          pathEl.textContent = url.pathname || '/';
          hashEl.textContent = url.hash || 'None';

          const rows = [];
          url.searchParams.forEach((val, key) => {
            rows.push(`
              <tr class="hover:bg-[color:var(--surface-strong)]">
                <td class="p-3.5 font-bold text-cyan-500 dark:text-cyan-400">${key}</td>
                <td class="p-3.5 text-[color:var(--muted)]">${val}</td>
                <td class="p-3.5 font-semibold">${decodeURIComponent(val)}</td>
              </tr>
            `);
          });

          paramCount.textContent = `${rows.length} Parameter${rows.length === 1 ? '' : 's'}`;
          tbody.innerHTML = rows.length > 0 ? rows.join('') : '<tr><td colspan="3" class="p-4 text-center text-[color:var(--muted)] italic">No query parameters in this URL.</td></tr>';
        } catch (e) {
          hostEl.textContent = 'Invalid URL';
          pathEl.textContent = '-';
          hashEl.textContent = '-';
        }
      }

      input.addEventListener('input', parse);

      sampleBtn.addEventListener('click', () => {
        input.value = 'https://calculatorutility.tech/developer-tools/?filter=json&sort=popular&utm_source=twitter&utm_medium=social#tools';
        parse();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        parse();
      });

      parse();
    })();
  </script>
</SiteLayout>
