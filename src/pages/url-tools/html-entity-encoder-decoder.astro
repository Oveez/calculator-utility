---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `HTML Entity Encoder & Decoder — Convert Named Entities Online · ${siteName}`;
const pageDesc = 'Encode special characters into HTML entities (&amp;, &lt;, &gt;, &quot;) or decode HTML entities back to raw readable text online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/url-tools/html-entity-encoder-decoder/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'URL Tools', href: toAbsoluteUrl('/url-tools/') },
  { label: 'HTML Entity Encoder & Decoder' },
];

const schemaFaq = [
  {
    question: 'Why do we need HTML entity encoding?',
    answer: 'Characters like `<` and `>` have reserved structural meanings in HTML syntax. Converting them to `&lt;` and `&gt;` ensures the browser displays them safely without interpreting them as HTML tags, preventing XSS vulnerabilities.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'HTML Entity Encoder & Decoder',
    url: canonicalUrl,
    applicationCategory: 'WebApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-entity-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>HTML Character Entity Parser</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        HTML Entity Encoder &amp; Decoder
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Encode reserved symbols into HTML entities or decode HTML entities back to raw text.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Input -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="entity-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Input Text</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="entity-in"
          rows="14"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Enter text or HTML entities here..."
        ></textarea>

        <div class="flex gap-3">
          <button
            type="button"
            data-encode-btn
            class="flex-1 rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
          >
            Encode to Entities
          </button>
          <button
            type="button"
            data-decode-btn
            class="flex-1 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] py-2.5 text-xs font-bold text-[color:var(--fg)] shadow-xs transition hover:bg-[color:var(--surface)]"
          >
            Decode Entities
          </button>
        </div>
      </div>

      <!-- Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Processed Output</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy</span>
          </button>
        </div>
        <textarea
          id="entity-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Processed text will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-entity-app]');
      if (!root) return;

      const input = root.querySelector('#entity-in');
      const output = root.querySelector('#entity-out');
      const encodeBtn = root.querySelector('[data-encode-btn]');
      const decodeBtn = root.querySelector('[data-decode-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function encodeEntities() {
        const text = input.value;
        if (!text) { output.value = ''; return; }
        const div = document.createElement('div');
        div.textContent = text;
        output.value = div.innerHTML;
      }

      function decodeEntities() {
        const text = input.value;
        if (!text) { output.value = ''; return; }
        const div = document.createElement('div');
        div.innerHTML = text;
        output.value = div.textContent || div.innerText || '';
      }

      encodeBtn.addEventListener('click', encodeEntities);
      decodeBtn.addEventListener('click', decodeEntities);

      sampleBtn.addEventListener('click', () => {
        input.value = `<div class="promo">\n  <h1>50% OFF & Free Shipping!</h1>\n  <p>Price: $19.99 &euro;18.50 &pound;15.00</p>\n</div>`;
        encodeEntities();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      encodeEntities();
    })();
  </script>
</SiteLayout>
