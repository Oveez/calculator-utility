---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `Whitespace Remover — Strip Extra Spaces & Tabs · ${siteName}`;
const pageDesc = 'Remove extra spaces, collapse multiple whitespaces, strip leading/trailing spaces, and remove tab characters online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/text-tools/whitespace-remover/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Text Tools', href: toAbsoluteUrl('/text-tools/') },
  { label: 'Whitespace Remover' },
];

const schemaFaq = [
  {
    question: 'How does the whitespace remover collapse spaces?',
    answer: 'It scans text streams and replaces multiple consecutive spaces or tabs with a single space (`\\s+` to ` `), optionally trimming leading and trailing whitespace from the start and end of every line.',
  },
  {
    question: 'Why is removing trailing whitespace important?',
    answer: 'Trailing whitespace at the end of code lines causes noisy Git diffs, linting errors (PEP 8, ESLint), and unnecessary byte bloat. Removing only trailing spaces cleans commits without destroying essential indentation.',
  },
  {
    question: 'What are Non-Breaking Spaces (&nbsp; / \\u00A0)?',
    answer: 'Non-breaking spaces look identical to regular spaces in browsers and editors but possess a different Unicode code point (U+00A0). This often breaks compilers, regex parsers, and terminal scripts. This tool converts them to standard ASCII spaces.',
  },
  {
    question: 'Is my text processed securely?',
    answer: 'Yes. All string operations execute 100% locally inside your web browser using client-side JavaScript. No text is ever transmitted over the network.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Whitespace Remover',
    url: canonicalUrl,
    applicationCategory: 'TextApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    id: 'collapse-spaces',
    name: 'Collapse Consecutive Spaces',
    description: 'Compresses sequences of two or more spaces into exactly one single space character.',
    whyItMatters: 'Fixes awkward double-spacing and formatting artifacts from PDF and Word conversions.',
    typicalRange: 'Enabled / Disabled (Default: Enabled)',
  },
  {
    id: 'trim-lines',
    name: 'Trim Lines',
    description: 'Removes all space and tab characters from the very beginning and very end of each line.',
    whyItMatters: 'Cleans up dirty indentation and prevents unwanted margin padding in text exports.',
    typicalRange: 'Enabled / Disabled (Default: Enabled)',
  },
  {
    id: 'trailing-only',
    name: 'Trailing Whitespace Only',
    description: 'Strips only spaces at the end of lines while preserving code indentation at the beginning.',
    whyItMatters: 'Ideal for programmers preparing clean Pull Requests without disturbing code hierarchy.',
    typicalRange: 'Enabled / Disabled (Default: Disabled)',
  },
  {
    id: 'tab-conversion',
    name: 'Tab Conversion',
    description: 'Converts tab characters (`\\t`) to equivalent space blocks (e.g. 2, 4, or 8 spaces), or spaces to tabs.',
    whyItMatters: 'Standardizes indentation across diverse codebases and collaborative markdown files.',
    typicalRange: 'Keep Tabs, Tabs to 2 Spaces, Tabs to 4 Spaces, Spaces to Tabs',
  },
];

const workedExampleData = {
  title: 'Cleaning Trailing Whitespace in a Python Script',
  description: 'Cleaning code to satisfy strict PEP 8 linting rules without breaking indentation.',
  formula: 'Bytes Saved = Initial Character Count - Final Character Count',
  steps: [
    {
      step: 'Step 1: Input Code Block',
      calculation: 'Script loaded with 15 lines and 35 trailing spaces on various lines.',
      result: '15 lines loaded',
    },
    {
      step: 'Step 2: Apply Trailing Whitespace Strip',
      calculation: 'Remove `\\s+$` on each line while preserving leading indentation.',
      result: '35 trailing space characters stripped',
    },
    {
      step: 'Step 3: Normalize Non-Breaking Spaces',
      calculation: '3 accidental `\\u00A0` non-breaking spaces replaced with standard ASCII.',
      result: '100% clean, lint-compliant script',
    },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-ws-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>100% Client-Side • Multiple Cleaning Modes • Non-Breaking Space Fix</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Whitespace Remover
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Remove extra spaces, collapse multiple whitespaces, strip leading/trailing spaces, and remove tab characters online. Clean formatting and optimize file size in real-time.
      </p>
    </header>

    <!-- Metrics Summary Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center shadow-xs">
        <span class="block text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Spaces Removed</span>
        <span id="stat-spaces-removed" class="mt-1 block text-xl sm:text-2xl font-black text-rose-600 dark:text-rose-400 font-mono">0</span>
      </div>
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center shadow-xs">
        <span class="block text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Tabs Converted</span>
        <span id="stat-tabs-converted" class="mt-1 block text-xl sm:text-2xl font-black text-[color:var(--accent)] font-mono">0</span>
      </div>
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center shadow-xs">
        <span class="block text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Bytes Saved</span>
        <span id="stat-bytes-saved" class="mt-1 block text-xl sm:text-2xl font-black text-cyan-600 dark:text-cyan-400 dark:text-cyan-400 font-mono">0 B</span>
      </div>
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center shadow-xs">
        <span class="block text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Total Lines</span>
        <span id="stat-total-lines" class="mt-1 block text-xl sm:text-2xl font-black text-[color:var(--fg)] font-mono">0</span>
      </div>
    </div>

    <!-- Controls Panel -->
    <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4 shadow-sm">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 text-xs">
        <div>
          <label for="opt-operation" class="block font-bold text-[color:var(--fg)] mb-1.5">Primary Operation</label>
          <select id="opt-operation" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
            <option value="collapse">Collapse Multiple Spaces to Single</option>
            <option value="trim">Trim Leading &amp; Trailing Whitespace</option>
            <option value="trailing-only">Remove Trailing Whitespace Only (Keep Indents)</option>
            <option value="all-spaces">Remove ALL Spaces &amp; Tabs (Minify)</option>
          </select>
        </div>

        <div>
          <label for="opt-tabs" class="block font-bold text-[color:var(--fg)] mb-1.5">Tab Characters (\t)</label>
          <select id="opt-tabs" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="keep">Keep Tabs As Is</option>
            <option value="spaces-2">Convert Tabs to 2 Spaces</option>
            <option value="spaces-4">Convert Tabs to 4 Spaces</option>
            <option value="spaces-8">Convert Tabs to 8 Spaces</option>
            <option value="to-tabs">Convert 4 Spaces to Tabs</option>
            <option value="remove-tabs">Remove Tabs Completely</option>
          </select>
        </div>

        <div class="space-y-2 pt-1">
          <label class="flex items-center gap-2 font-medium text-[color:var(--fg)] cursor-pointer">
            <input type="checkbox" id="opt-nbsp" checked class="rounded accent-[color:var(--accent)]" />
            <span>Convert Non-Breaking Spaces (&amp;nbsp;)</span>
          </label>
          <label class="flex items-center gap-2 font-medium text-[color:var(--fg)] cursor-pointer">
            <input type="checkbox" id="opt-strip-blank-lines" class="rounded accent-[color:var(--accent)]" />
            <span>Remove Empty / Blank Lines</span>
          </label>
        </div>

        <div class="space-y-2 pt-1">
          <label class="flex items-center gap-2 font-medium text-[color:var(--fg)] cursor-pointer">
            <input type="checkbox" id="opt-clean-newlines" class="rounded accent-[color:var(--accent)]" />
            <span>Normalize Newlines (CRLF &rarr; LF)</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Dual Workspace Grid -->
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Left: Source Editor -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <label for="text-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Source Text</label>
            <span id="char-count-in" class="text-[11px] text-[color:var(--muted)]">0 chars</span>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <label for="file-upload" class="cursor-pointer text-[color:var(--accent)] hover:underline font-semibold flex items-center gap-1">
              <span>Import File</span>
              <input type="file" id="file-upload" accept=".txt,.md,.py,.js,.html,.css,.csv,.log" class="hidden" />
            </label>
            <span class="text-[color:var(--border)]">•</span>
            <button type="button" id="btn-sample" class="text-[color:var(--accent)] hover:underline font-semibold cursor-pointer">Sample</button>
            <span class="text-[color:var(--border)]">•</span>
            <button type="button" id="btn-clear" class="text-rose-600 dark:text-rose-400 hover:underline cursor-pointer">Clear</button>
          </div>
        </div>
        <textarea
          id="text-in"
          rows="15"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--accent)] focus:outline-hidden transition shadow-inner"
          placeholder="Paste text with excessive spaces or tabs here..."
        ></textarea>
      </div>

      <!-- Right: Processed Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Clean Output</span>
            <span id="char-count-out" class="text-[11px] text-[color:var(--muted)]">0 chars</span>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="btn-copy"
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] shadow-xs transition hover:bg-[color:var(--surface-strong)]"
            >
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span id="copy-label">Copy</span>
            </button>
            <button
              type="button"
              id="btn-download"
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-[color:var(--accent)] px-3 py-1.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90"
            >
              <span>Download .txt</span>
            </button>
          </div>
        </div>
        <textarea
          id="text-out"
          rows="15"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden transition shadow-inner"
          placeholder="Clean text will appear here in real-time..."
        ></textarea>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="How Whitespace Sanitization Operates"
      description="Learn about trailing whitespace hazards, non-breaking space replacement, and tab-to-space normalization."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-ws-app]');
      if (!root) return;

      const textIn = root.querySelector('#text-in');
      const textOut = root.querySelector('#text-out');
      const optOperation = root.querySelector('#opt-operation');
      const optTabs = root.querySelector('#opt-tabs');
      const optNbsp = root.querySelector('#opt-nbsp');
      const optStripBlankLines = root.querySelector('#opt-strip-blank-lines');
      const optCleanNewlines = root.querySelector('#opt-clean-newlines');

      const statSpacesRemoved = root.querySelector('#stat-spaces-removed');
      const statTabsConverted = root.querySelector('#stat-tabs-converted');
      const statBytesSaved = root.querySelector('#stat-bytes-saved');
      const statTotalLines = root.querySelector('#stat-total-lines');
      const charCountIn = root.querySelector('#char-count-in');
      const charCountOut = root.querySelector('#char-count-out');

      const btnSample = root.querySelector('#btn-sample');
      const btnClear = root.querySelector('#btn-clear');
      const btnCopy = root.querySelector('#btn-copy');
      const copyLabel = root.querySelector('#copy-label');
      const btnDownload = root.querySelector('#btn-download');
      const fileUpload = root.querySelector('#file-upload');

      const SAMPLE_TEXT = `   function calculateTotal( items ) {   \n\t\tlet total = 0;   \n\t\tfor ( let i = 0;   i < items.length; i++ ) {   \n\t\t\ttotal += items[i].price;   \n\t\t}   \n\t\treturn total;   \n   }   \n\n\n   const result = calculateTotal( [ { price: 10 },   { price: 25 } ] );   `;

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function processWhitespace() {
        let text = textIn.value;
        charCountIn.textContent = `${text.length.toLocaleString()} chars`;

        if (!text.length) {
          textOut.value = '';
          statSpacesRemoved.textContent = '0';
          statTabsConverted.textContent = '0';
          statBytesSaved.textContent = '0 B';
          statTotalLines.textContent = '0';
          charCountOut.textContent = '0 chars';
          return;
        }

        const initialLength = text.length;

        // Convert Non-Breaking Spaces
        if (optNbsp.checked) {
          text = text.replace(/\u00A0/g, ' ');
        }

        // Normalize newlines
        if (optCleanNewlines.checked) {
          text = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
        }

        // Handle tabs
        const tabMode = optTabs.value;
        let tabsConverted = 0;
        if (tabMode === 'spaces-2') {
          const tabMatches = text.match(/\t/g);
          if (tabMatches) tabsConverted = tabMatches.length;
          text = text.replace(/\t/g, '  ');
        } else if (tabMode === 'spaces-4') {
          const tabMatches = text.match(/\t/g);
          if (tabMatches) tabsConverted = tabMatches.length;
          text = text.replace(/\t/g, '    ');
        } else if (tabMode === 'spaces-8') {
          const tabMatches = text.match(/\t/g);
          if (tabMatches) tabsConverted = tabMatches.length;
          text = text.replace(/\t/g, '        ');
        } else if (tabMode === 'to-tabs') {
          text = text.replace(/    /g, '\t');
        } else if (tabMode === 'remove-tabs') {
          const tabMatches = text.match(/\t/g);
          if (tabMatches) tabsConverted = tabMatches.length;
          text = text.replace(/\t/g, '');
        }

        // Operation mode
        const op = optOperation.value;
        let lines = text.split(/\r\n|\r|\n/);

        if (op === 'all-spaces') {
          text = text.replace(/[ \t]/g, '');
          lines = text.split(/\r\n|\r|\n/);
        } else if (op === 'trailing-only') {
          lines = lines.map(l => l.replace(/[ \t]+$/, ''));
        } else if (op === 'trim') {
          lines = lines.map(l => l.trim().replace(/[ \t]+/g, ' '));
        } else {
          // collapse
          lines = lines.map(l => l.replace(/[ \t]+/g, ' ').trim());
        }

        // Strip blank lines if requested
        if (optStripBlankLines.checked) {
          lines = lines.filter(l => l.trim().length > 0);
        }

        const result = (op === 'all-spaces' && !text.includes('\n')) ? text : lines.join('\n');
        textOut.value = result;
        charCountOut.textContent = `${result.length.toLocaleString()} chars`;

        // Calculate statistics
        const finalLength = result.length;
        const bytesSaved = Math.max(0, initialLength - finalLength);
        const spacesInitial = (textIn.value.match(/ /g) || []).length;
        const spacesFinal = (result.match(/ /g) || []).length;
        const spacesRemoved = Math.max(0, spacesInitial - spacesFinal);

        statSpacesRemoved.textContent = spacesRemoved.toLocaleString();
        statTabsConverted.textContent = tabsConverted.toLocaleString();
        statBytesSaved.textContent = formatBytes(bytesSaved);
        statTotalLines.textContent = lines.length.toLocaleString();
      }

      // Event Listeners
      textIn.addEventListener('input', processWhitespace);
      optOperation.addEventListener('change', processWhitespace);
      optTabs.addEventListener('change', processWhitespace);
      optNbsp.addEventListener('change', processWhitespace);
      optStripBlankLines.addEventListener('change', processWhitespace);
      optCleanNewlines.addEventListener('change', processWhitespace);

      btnSample?.addEventListener('click', () => {
        textIn.value = SAMPLE_TEXT;
        processWhitespace();
      });

      btnClear?.addEventListener('click', () => {
        textIn.value = '';
        processWhitespace();
      });

      btnCopy?.addEventListener('click', async () => {
        if (!textOut.value) return;
        try {
          await navigator.clipboard.writeText(textOut.value);
          copyLabel.textContent = 'Copied!';
          setTimeout(() => { copyLabel.textContent = 'Copy'; }, 2000);
        } catch (e) {
          textOut.select();
          document.execCommand('copy');
          copyLabel.textContent = 'Copied!';
          setTimeout(() => { copyLabel.textContent = 'Copy'; }, 2000);
        }
      });

      btnDownload?.addEventListener('click', () => {
        if (!textOut.value) return;
        const blob = new Blob([textOut.value], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'whitespace_cleaned.txt';
        a.click();
        URL.revokeObjectURL(url);
      });

      fileUpload?.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (evt) => {
          textIn.value = evt.target.result;
          processWhitespace();
        };
        reader.readAsText(file);
      });

      if (textIn.value) {
        processWhitespace();
      }
    })();
  </script>
</SiteLayout>
