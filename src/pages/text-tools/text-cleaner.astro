---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Text Cleaner & Sanitizer — Free Online Text Formatting · ${siteName}`;
const pageDesc = 'Clean and sanitize messy text online. Strip HTML tags, remove emojis, normalize line endings, trim extra spaces, and remove punctuation. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/text-tools/text-cleaner/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Text Tools', href: toAbsoluteUrl('/text-tools/') },
  { label: 'Text Cleaner' },
];

const schemaFaq = [
  {
    question: 'What clean-up transformations does this tool offer?',
    answer: 'You can toggle stripping HTML tags, removing emojis, stripping punctuation, converting to ASCII, collapsing whitespaces, and normalizing Windows (CRLF) vs Unix (LF) line breaks.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Text Cleaner & Sanitizer',
    url: canonicalUrl,
    applicationCategory: 'TextApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-cleaner-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Multi-Transformation Sanitizer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Text Cleaner &amp; Sanitizer
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Clean messy copy-pastes, remove weird characters, normalize whitespace, and strip unwanted markup.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Input -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="clean-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Messy Input Text</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="clean-in"
          rows="12"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste messy text here..."
        ></textarea>

        <!-- Options Checklist -->
        <div class="grid grid-cols-2 gap-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="opt-html" checked class="rounded accent-[color:var(--fg)]" />
            <span>Strip HTML Tags</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="opt-emojis" class="rounded accent-[color:var(--fg)]" />
            <span>Remove Emojis</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="opt-spaces" checked class="rounded accent-[color:var(--fg)]" />
            <span>Collapse Spaces</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="opt-punct" class="rounded accent-[color:var(--fg)]" />
            <span>Remove Punctuation</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="opt-blank" checked class="rounded accent-[color:var(--fg)]" />
            <span>Remove Blank Lines</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="opt-ascii" class="rounded accent-[color:var(--fg)]" />
            <span>ASCII Only</span>
          </label>
        </div>
      </div>

      <!-- Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Cleaned Text</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy</span>
          </button>
        </div>
        <textarea
          id="clean-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Sanitized text will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-cleaner-app]');
      if (!root) return;

      const input = root.querySelector('#clean-in');
      const output = root.querySelector('#clean-out');
      const optHtml = root.querySelector('#opt-html');
      const optEmojis = root.querySelector('#opt-emojis');
      const optSpaces = root.querySelector('#opt-spaces');
      const optPunct = root.querySelector('#opt-punct');
      const optBlank = root.querySelector('#opt-blank');
      const optAscii = root.querySelector('#opt-ascii');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function sanitize() {
        let text = input.value;
        if (!text) { output.value = ''; return; }

        if (optHtml.checked) {
          text = text.replace(/<[^>]*>/g, '');
        }
        if (optEmojis.checked) {
          text = text.replace(/[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F700}-\u{1F77F}\u{1F780}-\u{1F7FF}\u{1F800}-\u{1F8FF}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FA6F}\u{1FA70}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/gu, '');
        }
        if (optPunct.checked) {
          text = text.replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?"'’“”]/g, '');
        }
        if (optAscii.checked) {
          text = text.replace(/[^\x00-\x7F]/g, '');
        }
        if (optSpaces.checked) {
          text = text.replace(/ +/g, ' ');
        }

        let lines = text.split('\n').map(l => l.trim());
        if (optBlank.checked) {
          lines = lines.filter(l => l.length > 0);
        }

        output.value = lines.join('\n');
      }

      input.addEventListener('input', sanitize);
      [optHtml, optEmojis, optSpaces, optPunct, optBlank, optAscii].forEach(cb => cb.addEventListener('change', sanitize));

      sampleBtn.addEventListener('click', () => {
        input.value = `<p>Hello <b>World</b>! 🚀🎉 Welcome to Calculator Utility.</p>\n\n\n   This has   extra    spaces   and (punctuation)?\n<span style="color:red">Goodbye!</span>`;
        sanitize();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
