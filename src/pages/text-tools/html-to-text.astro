      // Copy & Download
      btnCopy.addEventListener('click', async () => {
        if (!textOut.value) return;
        try {
          await navigator.clipboard.writeText(textOut.value);
          const orig = btnCopy.textContent;
          btnCopy.textContent = '✓ Copied Text!';
          setTimeout(() => { btnCopy.textContent = orig; }, 1800);
        } catch (e) {
          console.error(e);
        }
      });

      btnDownload.addEventListener('click', () => {
        if (!textOut.value) return;
        const blob = new Blob([textOut.value], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `extracted-text-${Date.now()}.txt`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      // Initial run
      btnSampleArticle.click();
    })();
