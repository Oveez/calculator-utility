---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `HTML to Plain Text Converter — Strip HTML Tags Online · ${siteName}`;
const pageDesc = 'Convert HTML code into clean, readable plain text online. Strips tags, scripts, CSS styles, and decodes HTML entities. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/text-tools/html-to-text/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Text Tools', href: toAbsoluteUrl('/text-tools/') },
  { label: 'HTML to Plain Text' },
];

const schemaFaq = [
  {
    question: 'How does this tool strip HTML tags?',
    answer: 'It leverages the browser’s native DOMParser engine to parse the HTML DOM tree, extracting textual node contents (`textContent`) while ignoring `<script>`, `<style>`, and markup tags.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'HTML to Plain Text Converter',
    url: canonicalUrl,
    applicationCategory: 'TextApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-html-text-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Native Browser DOM Parser</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        HTML to Plain Text Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Strip HTML tags, extract clean copy from web pages, and decode HTML character entities instantly.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="html-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">HTML Source</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="html-in"
          rows="16"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="<div><h1>Welcome</h1><p>This is paragraph text with a <a href='#'>link</a>.</p></div>"
        ></textarea>
        <button
          type="button"
          data-strip-btn
          class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Convert to Plain Text
        </button>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Plain Text Output</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Text</span>
          </button>
        </div>
        <textarea
          id="text-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Extracted plain text will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-html-text-app]');
      if (!root) return;

      const input = root.querySelector('#html-in');
      const output = root.querySelector('#text-out');
      const stripBtn = root.querySelector('[data-strip-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function stripHtml() {
        const raw = input.value;
        if (!raw) { output.value = ''; return; }

        try {
          const parser = new DOMParser();
          const doc = parser.parseFromString(raw, 'text/html');

          // Remove script and style elements
          doc.querySelectorAll('script, style').forEach(el => el.remove());

          // Replace block elements with line breaks before text extraction
          doc.querySelectorAll('p, div, h1, h2, h3, h4, h5, h6, li, br, tr').forEach(el => {
            el.insertAdjacentText('afterend', '\n');
          });

          const text = doc.body.textContent || '';
          output.value = text.split('\n').map(l => l.trim()).filter(l => l.length > 0).join('\n');
        } catch (e) {
          output.value = raw.replace(/<[^>]*>/g, '');
        }
      }

      stripBtn.addEventListener('click', stripHtml);
      input.addEventListener('input', stripHtml);

      sampleBtn.addEventListener('click', () => {
        input.value = '<article>\n  <h1>Calculator Utility Suite</h1>\n  <p>Explore over <strong>85+ browser tools</strong> and utilities.</p>\n  <ul>\n    <li>100% Client-side processing</li>\n    <li>Zero server uploads</li>\n  </ul>\n  <style>.hidden { display: none; }</style>\n  <' + 'script>console.log("Ignored script");<' + '/script>\n</article>';
        stripHtml();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
