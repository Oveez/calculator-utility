---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Text Diff Checker — Free Online Text Compare Tool · ${siteName}`;
const pageDesc = 'Compare two text files or snippets side-by-side online. Highlights additions, deletions, and line changes with whitespace ignore options. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/text-tools/text-diff-checker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Text Tools', href: toAbsoluteUrl('/text-tools/') },
  { label: 'Text Diff Checker' },
];

const schemaFaq = [
  {
    question: 'How does this diff checker calculate text differences?',
    answer: 'It uses the standard Myers diff algorithm to identify the minimal edit distance between the original and modified texts, highlighting inserted, deleted, and identical lines.',
  },
  {
    question: 'Is my confidential text uploaded anywhere?',
    answer: 'No. The entire diff computation executes in client-side JavaScript inside your browser. No data ever leaves your device.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Text Diff Checker',
    url: canonicalUrl,
    applicationCategory: 'TextApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-diff-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Myers Diff Algorithm Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Text Diff Checker &amp; Comparison Tool
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Compare two text blocks or code files to find additions, removals, and modifications side-by-side.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 lg:grid-cols-2">
        <!-- Text 1 -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="text1-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Original Text</label>
            <button type="button" data-sample-btn class="text-xs font-semibold text-[color:var(--primary)] hover:underline">Load Sample</button>
          </div>
          <textarea
            id="text1-in"
            rows="10"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste original text here..."
          ></textarea>
        </div>

        <!-- Text 2 -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="text2-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Modified Text</label>
            <button type="button" data-clear-btn class="text-xs text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
          <textarea
            id="text2-in"
            rows="10"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste modified text here..."
          ></textarea>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <label class="flex items-center gap-2 text-xs text-[color:var(--muted)] cursor-pointer">
          <input type="checkbox" id="ignore-ws" class="rounded accent-[color:var(--fg)]" />
          <span>Ignore Leading/Trailing Whitespace</span>
        </label>
        <button
          type="button"
          data-compare-btn
          class="rounded-xl bg-[color:var(--fg)] px-6 py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Compare Texts
        </button>
      </div>

      <!-- Diff Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Diff Output</span>
          <div class="flex items-center gap-3 text-xs">
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span> Added</span>
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-red-500"></span> Removed</span>
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-zinc-500"></span> Unchanged</span>
          </div>
        </div>
        <div
          id="diff-out"
          class="min-h-36 font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 space-y-1 text-[color:var(--fg)] overflow-x-auto"
        >
          <p class="text-[color:var(--muted)] italic">Enter texts above and click Compare.</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-diff-app]');
      if (!root) return;

      const t1 = root.querySelector('#text1-in');
      const t2 = root.querySelector('#text2-in');
      const ignoreWs = root.querySelector('#ignore-ws');
      const compareBtn = root.querySelector('[data-compare-btn]');
      const diffOut = root.querySelector('#diff-out');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function compare() {
        let v1 = t1.value;
        let v2 = t2.value;

        if (!v1 && !v2) {
          diffOut.innerHTML = '<p class="text-[color:var(--muted)] italic">Please provide text inputs to compare.</p>';
          return;
        }

        const lines1 = v1.split('\n');
        const lines2 = v2.split('\n');
        const isIgnore = ignoreWs.checked;

        const norm1 = isIgnore ? lines1.map(l => l.trim()) : lines1;
        const norm2 = isIgnore ? lines2.map(l => l.trim()) : lines2;

        const result = [];
        let i = 0, j = 0;

        while (i < lines1.length || j < lines2.length) {
          if (i < lines1.length && j < lines2.length && norm1[i] === norm2[j]) {
            result.push(`<div class="p-1 text-[color:var(--muted)]">  ${escapeHtml(lines1[i])}</div>`);
            i++; j++;
          } else {
            let matched = false;
            for (let look = 1; look < 6; look++) {
              if (i + look < lines1.length && norm1[i + look] === norm2[j]) {
                for (let k = 0; k < look; k++) {
                  result.push(`<div class="p-1 rounded bg-red-500/10 text-red-600 dark:text-red-400 font-bold">- ${escapeHtml(lines1[i + k])}</div>`);
                }
                i += look;
                matched = true;
                break;
              }
              if (j + look < lines2.length && norm1[i] === norm2[j + look]) {
                for (let k = 0; k < look; k++) {
                  result.push(`<div class="p-1 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">+ ${escapeHtml(lines2[j + k])}</div>`);
                }
                j += look;
                matched = true;
                break;
              }
            }

            if (!matched) {
              if (i < lines1.length) {
                result.push(`<div class="p-1 rounded bg-red-500/10 text-red-600 dark:text-red-400 font-bold">- ${escapeHtml(lines1[i])}</div>`);
                i++;
              }
              if (j < lines2.length) {
                result.push(`<div class="p-1 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">+ ${escapeHtml(lines2[j])}</div>`);
                j++;
              }
            }
          }
        }

        diffOut.innerHTML = result.join('');
      }

      compareBtn.addEventListener('click', compare);
      ignoreWs.addEventListener('change', compare);

      sampleBtn.addEventListener('click', () => {
        t1.value = `Calculator Utility v2.3\n- 72 Core Calculators\n- Academic GPA Tools\n- Tax Suite for 24 countries\n- Standard design system`;
        t2.value = `Calculator Utility v2.4\n- 85+ Non-Calculator Utilities\n- Academic GPA Tools\n- Tax Suite for 24 countries\n- Developer & Text Tools Suite\n- 100% Client-side privacy`;
        compare();
      });

      clearBtn.addEventListener('click', () => {
        t1.value = '';
        t2.value = '';
        diffOut.innerHTML = '<p class="text-[color:var(--muted)] italic">Enter texts above and click Compare.</p>';
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
