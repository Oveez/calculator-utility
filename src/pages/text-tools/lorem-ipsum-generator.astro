---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Lorem Ipsum Generator — Free Placeholder Dummy Text · ${siteName}`;
const pageDesc = 'Generate custom Lorem Ipsum placeholder dummy text by paragraphs, sentences, or word count online. Includes HTML tag formatting and instant copy options.';
const canonicalUrl = toAbsoluteUrl('/text-tools/lorem-ipsum-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Text Tools', href: toAbsoluteUrl('/text-tools/') },
  { label: 'Lorem Ipsum Generator' },
];

const schemaFaq = [
  {
    question: 'What is Lorem Ipsum placeholder text?',
    answer: 'Lorem Ipsum is standard placeholder text derived from sections of Cicero’s 45 BC Latin philosophical treatise, used by graphic designers and developers to preview typography and layouts without distracting content.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Lorem Ipsum Generator',
    url: canonicalUrl,
    applicationCategory: 'TextApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-lorem-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Mockup &amp; Wireframe Copy</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Lorem Ipsum Dummy Text Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate placeholder text for UI mockups, websites, and print layouts by paragraphs, sentences, or word count.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Options Bar -->
      <div class="grid gap-4 sm:grid-cols-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="lorem-type" class="font-bold text-[color:var(--fg)] block mb-1.5">Generate By:</label>
          <select id="lorem-type" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="paragraphs">Paragraphs</option>
            <option value="sentences">Sentences</option>
            <option value="words">Words</option>
          </select>
        </div>
        <div>
          <label for="lorem-qty" class="font-bold text-[color:var(--fg)] block mb-1.5">Quantity:</label>
          <input
            type="number"
            id="lorem-qty"
            min="1"
            max="100"
            value="3"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div class="flex items-end">
          <label class="flex items-center gap-2 text-[color:var(--muted)] cursor-pointer pb-2">
            <input type="checkbox" id="start-lorem" checked class="rounded accent-[color:var(--fg)]" />
            <span>Start with "Lorem ipsum..."</span>
          </label>
        </div>
      </div>

      <button
        type="button"
        data-generate-btn
        class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
      >
        Generate Lorem Ipsum
      </button>

      <!-- Output -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated Placeholder Text</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Text</span>
          </button>
        </div>
        <textarea
          id="lorem-out"
          rows="14"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Generated Lorem Ipsum will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-lorem-app]');
      if (!root) return;

      const typeSelect = root.querySelector('#lorem-type');
      const qtyInput = root.querySelector('#lorem-qty');
      const startLoremCheck = root.querySelector('#start-lorem');
      const generateBtn = root.querySelector('[data-generate-btn]');
      const output = root.querySelector('#lorem-out');
      const copyBtn = root.querySelector('[data-copy-btn]');

      const words = [
        'lorem', 'ipsum', 'dolor', 'sit', 'amet', 'consectetur', 'adipiscing', 'elit', 'curabitur',
        'vel', 'hendrerit', 'libero', 'eleifend', 'blandit', 'nunc', 'ornare', 'odio', 'ut',
        'orci', 'gravida', 'imperdiet', 'nullam', 'purus', 'lacinia', 'a', 'pretium', 'quis',
        'congue', 'praesent', 'sagittis', 'laoreet', 'auctor', 'mauris', 'non', 'velit', 'eros',
        'dictum', 'proin', 'accumsan', 'sapien', 'nec', 'massa', 'volutpat', 'venenatis', 'sed',
        'eu', 'molestie', 'lacus', 'quisque', 'porttitor', 'ligula', 'dui', 'mollis', 'tempus',
        'at', 'magna', 'vestibulum', 'turpis', 'ac', 'diam', 'tincidunt', 'id', 'condimentum',
        'enim', 'sodales', 'in', 'hac', 'habitasse', 'platea', 'dictumst', 'aenean', 'neque',
        'fusce', 'augue', 'leo', 'eget', 'semper', 'mattis', 'tortor', 'scelerisque', 'nulla'
      ];

      function getRandomWord() {
        return words[Math.floor(Math.random() * words.length)];
      }

      function getSentence(wordCount = 10) {
        const sentenceWords = [];
        for (let i = 0; i < wordCount; i++) {
          sentenceWords.push(getRandomWord());
        }
        sentenceWords[0] = sentenceWords[0].charAt(0).toUpperCase() + sentenceWords[0].slice(1);
        return sentenceWords.join(' ') + '.';
      }

      function getParagraph(sentenceCount = 5) {
        const sentences = [];
        for (let i = 0; i < sentenceCount; i++) {
          sentences.push(getSentence(Math.floor(Math.random() * 8) + 8));
        }
        return sentences.join(' ');
      }

      function generate() {
        const type = typeSelect.value;
        const qty = Math.min(100, Math.max(1, parseInt(qtyInput.value, 10) || 3));
        const startLorem = startLoremCheck.checked;

        let result = '';

        if (type === 'paragraphs') {
          const paras = [];
          for (let i = 0; i < qty; i++) {
            paras.push(getParagraph());
          }
          if (startLorem && paras.length > 0) {
            paras[0] = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. ' + paras[0];
          }
          result = paras.join('\n\n');
        } else if (type === 'sentences') {
          const sents = [];
          for (let i = 0; i < qty; i++) {
            sents.push(getSentence());
          }
          if (startLorem && sents.length > 0) {
            sents[0] = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.';
          }
          result = sents.join(' ');
        } else if (type === 'words') {
          const wList = [];
          for (let i = 0; i < qty; i++) {
            wList.push(getRandomWord());
          }
          if (startLorem && wList.length >= 2) {
            wList[0] = 'lorem';
            wList[1] = 'ipsum';
          }
          result = wList.join(' ');
        }

        output.value = result;
      }

      generateBtn.addEventListener('click', generate);

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      generate();
    })();
  </script>
</SiteLayout>
