---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Text Line Sorter — Sort Lines Alphabetically Online · ${siteName}`;
const pageDesc = 'Sort lines of text alphabetically (A-Z, Z-A), numerically (0-9, 9-0), by length, or randomize order online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/text-tools/line-sorter/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Text Tools', href: toAbsoluteUrl('/text-tools/') },
  { label: 'Line Sorter' },
];

const schemaFaq = [
  {
    question: 'What sorting options are available?',
    answer: 'You can sort lines Alphabetically (A-Z or Z-A), Numerically (ascending/descending), by Line Length (shortest to longest or longest to shortest), or randomly shuffle lines.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Text Line Sorter',
    url: canonicalUrl,
    applicationCategory: 'TextApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-sorter-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Alphabetical &amp; Numeric Ordering</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Text Line Sorter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Sort lists and lines alphabetically, numerically, by length, or randomly in your browser.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="text-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Original List</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="text-in"
          rows="14"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste lines to sort here..."
        ></textarea>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <label for="sort-mode" class="text-xs font-medium text-[color:var(--muted)]">Sort Mode:</label>
            <select id="sort-mode" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1.5 text-xs text-[color:var(--fg)]">
              <option value="alpha-asc">Alphabetical (A → Z)</option>
              <option value="alpha-desc">Reverse Alphabetical (Z → A)</option>
              <option value="num-asc">Numeric (0 → 9)</option>
              <option value="num-desc">Numeric (9 → 0)</option>
              <option value="len-asc">Shortest to Longest</option>
              <option value="len-desc">Longest to Shortest</option>
              <option value="random">Random Shuffle</option>
            </select>
          </div>
          <button
            type="button"
            data-sort-btn
            class="rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
          >
            Sort Lines
          </button>
        </div>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Sorted Output</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy</span>
          </button>
        </div>
        <textarea
          id="text-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Sorted lines will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-sorter-app]');
      if (!root) return;

      const input = root.querySelector('#text-in');
      const output = root.querySelector('#text-out');
      const modeSelect = root.querySelector('#sort-mode');
      const sortBtn = root.querySelector('[data-sort-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function sortLines() {
        const text = input.value;
        if (!text) { output.value = ''; return; }

        const lines = text.split('\n').filter(l => l.length > 0);
        const mode = modeSelect.value;

        switch (mode) {
          case 'alpha-asc': lines.sort((a, b) => a.localeCompare(b)); break;
          case 'alpha-desc': lines.sort((a, b) => b.localeCompare(a)); break;
          case 'num-asc': lines.sort((a, b) => (parseFloat(a) || 0) - (parseFloat(b) || 0)); break;
          case 'num-desc': lines.sort((a, b) => (parseFloat(b) || 0) - (parseFloat(a) || 0)); break;
          case 'len-asc': lines.sort((a, b) => a.length - b.length); break;
          case 'len-desc': lines.sort((a, b) => b.length - a.length); break;
          case 'random': lines.sort(() => Math.random() - 0.5); break;
        }

        output.value = lines.join('\n');
      }

      sortBtn.addEventListener('click', sortLines);
      modeSelect.addEventListener('change', sortLines);
      input.addEventListener('input', sortLines);

      sampleBtn.addEventListener('click', () => {
        input.value = `Zebra\nApple\nMango\nBanana\nOrange\nPineapple\nGrape`;
        sortLines();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
