const engine = new CalculatorWorker({ precision: 12 });
const result = await engine.compute('integral(sin(x), 0, pi)');
console.log('Result:', result.value); // 2.000000000000
\`\`\`

> "Simplicity and privacy are the core pillars of web utilities."

### Project Roadmap Checklist
- [x] Integrate GFM markdown syntax parser
- [x] Real-time side-by-side live rendering preview
- [x] Full HTML5 standalone document export
- [ ] Offline PWA Service Worker caching

For more details, visit our official documentation at [CalculatorUtility.tech](https://calculatorutility.tech/).`;
        update();
      });

      btnSampleTables.addEventListener('click', () => {
        input.value = `# Performance & Compatibility Benchmark

Below is the comparative execution latency across different browser environments:

| Engine | Browser Family | Latency (ms) | Memory Used | Status |
|:---|:---:|---:|---:|:---:|
| V8 | Google Chrome | 1.24 ms | 14.2 MB | ==Active== |
| SpiderMonkey | Mozilla Firefox | 1.38 ms | 16.1 MB | ==Active== |
| JavaScriptCore | Apple Safari | 1.15 ms | 12.8 MB | ==Active== |
| Blink | MS Edge | 1.22 ms | 14.0 MB | ==Active== |

### Pricing Comparison Matrix

| Tier Name | Max Lines | Cloud Storage | API Access | Monthly Price |
|:---|:---:|:---:|:---:|---:|
| Free | 50,000 | No (Local) | Standard | $0 / mo |
| Pro Dev | 1,000,000 | No (Local) | Unlimited | $12 / mo |
| Enterprise | Unlimited | Custom On-Prem | Priority SLA | $49 / mo |`;
        update();
      });

      // Copy & Download
      btnCopyHtml.addEventListener('click', async () => {
        if (!htmlOut.value) return;
        try {
          await navigator.clipboard.writeText(htmlOut.value);
          const orig = btnCopyHtml.textContent;
          btnCopyHtml.textContent = '✓ Copied HTML!';
          setTimeout(() => { btnCopyHtml.textContent = orig; }, 1800);
        } catch (e) {
          console.error(e);
        }
      });

      btnDownloadHtml.addEventListener('click', () => {
        if (!htmlOut.value) return;
        const blob = new Blob([htmlOut.value], { type: 'text/html;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `document-${Date.now()}.html`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      // Initial run
      btnSampleDoc.click();
    })();
  </script>
</SiteLayout>
