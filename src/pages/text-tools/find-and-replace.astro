---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `Find and Replace Text Online — Bulk String Replacer · ${siteName}`;
const pageDesc = 'Bulk find and replace text and regular expressions online. Supports case sensitivity, whole word matching, regex mode, and live replacement counter. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/text-tools/find-and-replace/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Text Tools', href: toAbsoluteUrl('/text-tools/') },
  { label: 'Find and Replace' },
];

const schemaFaq = [
  {
    question: 'Can I use Regular Expressions in Find and Replace?',
    answer: 'Yes. Check the "Use Regular Expression" toggle to use standard JavaScript ECMAScript regex syntax (e.g., `\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b` for emails). Capture groups like `$1` and `$2` are supported in the replacement field.',
  },
  {
    question: 'What is the "Preserve Case" feature?',
    answer: 'Preserve Case dynamically matches the letter casing of each individual occurrence. If your target is "cat" -> "dog", "Cat" becomes "Dog", "CAT" becomes "DOG", and "cat" becomes "dog".',
  },
  {
    question: 'Can I replace escape sequences like newlines or tabs?',
    answer: 'Yes. Check the "Interpret Escape Sequences" option to interpret `\\n` as line breaks, `\\t` as tab stops, and `\\\\` as literal backslashes.',
  },
  {
    question: 'How do Chained Multi-Rules work?',
    answer: 'You can add multiple find-and-replace rules. The tool executes Rule 1 across the text, then pipes the result into Rule 2, and so on, enabling complex multi-stage text transformations in a single click.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Find and Replace Tool',
    url: canonicalUrl,
    applicationCategory: 'TextApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    id: 'find-query',
    name: 'Search Pattern (Find)',
    description: 'The exact substring, word, or regular expression pattern you wish to locate in the text.',
    whyItMatters: 'Forms the match criteria across the entire input corpus.',
    typicalRange: 'Literal string or RegExp (e.g. \\d{3}-\\d{4})',
  },
  {
    id: 'replace-string',
    name: 'Replacement String',
    description: 'The text that will substitute every matched occurrence. Supports capture group backreferences ($1, $2) in regex mode.',
    whyItMatters: 'Specifies the target replacement text or tokens.',
    typicalRange: 'Any string (or blank to delete occurrences)',
  },
  {
    id: 'match-case',
    name: 'Match Case',
    description: 'Enforces strict case matching (e.g., "Report" will not match "report").',
    whyItMatters: 'Prevents unintended replacements in mixed-case documents.',
    typicalRange: 'Enabled / Disabled (Default: Disabled)',
  },
  {
    id: 'whole-word',
    name: 'Whole Word Only',
    description: 'Requires word boundary markers on both sides of the match. For example, "cat" will match "cat" but not "catch" or "scat".',
    whyItMatters: 'Protects partial word substrings from accidental replacement.',
    typicalRange: 'Enabled / Disabled (Default: Disabled)',
  },
  {
    id: 'use-regex',
    name: 'Regular Expression (Regex)',
    description: 'Parses the find string as a dynamic JavaScript regular expression pattern with global matching.',
    whyItMatters: 'Unlocks powerful pattern-based search like dates, telephone numbers, emails, and code structures.',
    typicalRange: 'Enabled / Disabled (Default: Disabled)',
  },
];

const workedExampleData = {
  title: 'Refactoring API Endpoint Strings',
  description: 'Updating legacy v1 API endpoints to v2 with dynamic capture groups.',
  formula: 'Find: /api/v1/(\\w+) -> Replace: /api/v2/$1',
  steps: [
    {
      step: 'Step 1: Define Pattern & Group',
      calculation: 'Search pattern "/api/v1/(\\w+)" with regex enabled.',
      result: 'Captures resource name in $1',
    },
    {
      step: 'Step 2: Define Replacement Group',
      calculation: 'Replacement expression set to "/api/v2/$1".',
      result: 'Substitute group reference',
    },
    {
      step: 'Step 3: Execute Batch Replacement',
      calculation: '5 occurrences of "/api/v1/users" and "/api/v1/orders" updated.',
      result: 'All 5 URLs refactored to v2 instantly',
    },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-find-replace-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>100% Client-Side • Chained Multi-Rules • Regex &amp; Case Preservation</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Find and Replace Text
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Bulk find and replace strings or regular expressions across multi-line text. Multi-rule chaining, escape sequences, word boundaries, and real-time replacement counters.
      </p>
    </header>

    <!-- Find & Replace Control Panel -->
    <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-5 shadow-sm">
      <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Replacement Rules</span>
        <div class="flex items-center gap-2">
          <span id="rep-count-badge" class="rounded-full bg-cyan-500/10 px-2.5 py-0.5 text-xs font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400 border border-cyan-500/20 font-mono">
            0 Replacements
          </span>
          <button
            type="button"
            id="btn-add-rule"
            class="cursor-pointer text-xs font-bold text-[color:var(--accent)] hover:underline"
          >
            + Add Another Rule
          </button>
        </div>
      </div>

      <!-- Rule Rows Container -->
      <div id="rules-container" class="space-y-3">
        <!-- Default Rule 1 -->
        <div class="rule-row grid gap-3 sm:grid-cols-12 items-center rounded-2xl bg-[color:var(--surface-strong)] p-3.5 border border-[color:var(--border)]">
          <div class="sm:col-span-5">
            <label class="block text-[11px] font-bold text-[color:var(--muted)] mb-1">Find:</label>
            <input
              type="text"
              class="rule-find w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 text-xs text-[color:var(--fg)] font-mono"
              placeholder="Text or pattern to find..."
              value="old_string"
            />
          </div>
          <div class="sm:col-span-5">
            <label class="block text-[11px] font-bold text-[color:var(--muted)] mb-1">Replace With:</label>
            <input
              type="text"
              class="rule-replace w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 text-xs text-[color:var(--fg)] font-mono"
              placeholder="Replacement string..."
              value="new_string"
            />
          </div>
          <div class="sm:col-span-2 flex items-center justify-end gap-1.5 pt-4 sm:pt-0">
            <button
              type="button"
              class="btn-del-rule hidden text-rose-500 hover:text-rose-700 text-xs font-bold p-1 cursor-pointer"
              title="Delete rule"
            >
              ✕
            </button>
          </div>
        </div>
      </div>

      <!-- Modifiers & Switches -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-[color:var(--border)] text-xs">
        <div class="flex flex-wrap items-center gap-4 text-[color:var(--fg)]">
          <label class="flex items-center gap-1.5 cursor-pointer font-medium">
            <input type="checkbox" id="match-case" class="rounded accent-[color:var(--accent)]" />
            <span>Match Case</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer font-medium">
            <input type="checkbox" id="match-word" class="rounded accent-[color:var(--accent)]" />
            <span>Whole Word</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer font-medium">
            <input type="checkbox" id="use-regex" class="rounded accent-[color:var(--accent)]" />
            <span>Use Regex</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer font-medium">
            <input type="checkbox" id="escape-seq" class="rounded accent-[color:var(--accent)]" />
            <span>Interpret Escape Sequences (\n, \t)</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer font-medium">
            <input type="checkbox" id="preserve-case" class="rounded accent-[color:var(--accent)]" />
            <span>Preserve Case (Smart)</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Dual Workspace Grid -->
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Left: Source Editor -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <label for="text-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Source Text</label>
            <span id="char-count-in" class="text-[11px] text-[color:var(--muted)]">0 chars</span>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <label for="file-upload" class="cursor-pointer text-[color:var(--accent)] hover:underline font-semibold flex items-center gap-1">
              <span>Import File</span>
              <input type="file" id="file-upload" accept=".txt,.md,.js,.ts,.html,.css,.json,.csv,.log" class="hidden" />
            </label>
            <span class="text-[color:var(--border)]">•</span>
            <button type="button" id="btn-sample" class="text-[color:var(--accent)] hover:underline font-semibold cursor-pointer">Sample</button>
            <span class="text-[color:var(--border)]">•</span>
            <button type="button" id="btn-clear" class="text-rose-600 dark:text-rose-400 hover:underline cursor-pointer">Clear</button>
          </div>
        </div>
        <textarea
          id="text-in"
          rows="14"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--accent)] focus:outline-hidden transition shadow-inner"
          placeholder="Paste or type text to find and replace..."
        >This is an old_string example with old_string repeated multiple times in this old_string test block.
Another OLD_STRING in uppercase, and Old_String in title case for testing case preservation.</textarea>
      </div>

      <!-- Right: Processed Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Replaced Output</span>
            <span id="char-count-out" class="text-[11px] text-[color:var(--muted)]">0 chars</span>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="btn-copy"
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] shadow-xs transition hover:bg-[color:var(--surface-strong)]"
            >
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span id="copy-label">Copy</span>
            </button>
            <button
              type="button"
              id="btn-download"
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-[color:var(--accent)] px-3 py-1.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90"
            >
              <span>Download .txt</span>
            </button>
          </div>
        </div>
        <textarea
          id="text-out"
          rows="14"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden transition shadow-inner"
          placeholder="Modified text will appear here in real-time..."
        ></textarea>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="How Find and Replace Operates"
      description="Detailed guide on string matching algorithms, capture groups, whole word boundaries, and case preservation."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-find-replace-app]');
      if (!root) return;

      const textIn = root.querySelector('#text-in');
      const textOut = root.querySelector('#text-out');
      const repCountBadge = root.querySelector('#rep-count-badge');
      const charCountIn = root.querySelector('#char-count-in');
      const charCountOut = root.querySelector('#char-count-out');

      const rulesContainer = root.querySelector('#rules-container');
      const btnAddRule = root.querySelector('#btn-add-rule');

      const matchCase = root.querySelector('#match-case');
      const matchWord = root.querySelector('#match-word');
      const useRegex = root.querySelector('#use-regex');
      const escapeSeq = root.querySelector('#escape-seq');
      const preserveCase = root.querySelector('#preserve-case');

      const btnSample = root.querySelector('#btn-sample');
      const btnClear = root.querySelector('#btn-clear');
      const btnCopy = root.querySelector('#btn-copy');
      const copyLabel = root.querySelector('#copy-label');
      const btnDownload = root.querySelector('#btn-download');
      const fileUpload = root.querySelector('#file-upload');

      const SAMPLE_TEXT = `This is an old_string example with old_string repeated multiple times in this old_string test block.
Another OLD_STRING in uppercase, and Old_String in title case for testing case preservation.`;

      function unescapeString(str) {
        return str
          .replace(/\\n/g, '\n')
          .replace(/\\t/g, '\t')
          .replace(/\\r/g, '\r')
          .replace(/\\\\/g, '\\');
      }

      function applyCase(original, replacement) {
        if (!replacement || typeof replacement !== 'string') return replacement;
        if (original === original.toUpperCase()) return replacement.toUpperCase();
        if (original === original.toLowerCase()) return replacement.toLowerCase();
        if (original[0] === original[0].toUpperCase() && original.slice(1) === original.slice(1).toLowerCase()) {
          return replacement.charAt(0).toUpperCase() + replacement.slice(1).toLowerCase();
        }
        return replacement;
      }

      function processText() {
        let text = textIn.value;
        charCountIn.textContent = `${text.length.toLocaleString()} chars`;

        if (!text.length) {
          textOut.value = '';
          repCountBadge.textContent = '0 Replacements';
          charCountOut.textContent = '0 chars';
          return;
        }

        const isCase = matchCase.checked;
        const isWord = matchWord.checked;
        const isRegex = useRegex.checked;
        const isEscape = escapeSeq.checked;
        const isPreserveCase = preserveCase.checked;

        const ruleRows = rulesContainer.querySelectorAll('.rule-row');
        let totalReplacements = 0;

        for (const row of ruleRows) {
          const findIn = row.querySelector('.rule-find');
          const replaceIn = row.querySelector('.rule-replace');
          if (!findIn || !replaceIn) continue;

          let findVal = findIn.value;
          let repVal = replaceIn.value;

          if (!findVal) continue;

          if (isEscape) {
            findVal = unescapeString(findVal);
            repVal = unescapeString(repVal);
          }

          try {
            let regex;
            if (isRegex) {
              const flags = 'g' + (isCase ? '' : 'i');
              regex = new RegExp(findVal, flags);
            } else {
              // Escape special regex chars for literal match
              let pattern = findVal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
              if (isWord) {
                pattern = '\\b' + pattern + '\\b';
              }
              const flags = 'g' + (isCase ? '' : 'i');
              regex = new RegExp(pattern, flags);
            }

            // Count matches
            const matches = text.match(regex);
            if (matches) {
              totalReplacements += matches.length;
            }

            if (isPreserveCase) {
              text = text.replace(regex, (match, ...args) => {
                let replaced = repVal;
                // If capture groups are present in regex mode
                if (isRegex) {
                  replaced = repVal.replace(/\$([0-9]+|&)/g, (m, g) => {
                    if (g === '&') return match;
                    const idx = parseInt(g, 10);
                    return args[idx - 1] !== undefined ? args[idx - 1] : m;
                  });
                }
                return applyCase(match, replaced);
              });
            } else {
              if (isRegex) {
                text = text.replace(regex, repVal);
              } else {
                // Literal replacement (protect $$ $1 from literal string replaces)
                text = text.replace(regex, () => repVal);
              }
            }
          } catch (err) {
            // Regex syntax error while typing
          }
        }

        textOut.value = text;
        charCountOut.textContent = `${text.length.toLocaleString()} chars`;
        repCountBadge.textContent = `${totalReplacements.toLocaleString()} Replacements`;
      }

      function updateDeleteButtons() {
        const rows = rulesContainer.querySelectorAll('.rule-row');
        rows.forEach(row => {
          const btn = row.querySelector('.btn-del-rule');
          if (btn) {
            if (rows.length > 1) {
              btn.classList.remove('hidden');
            } else {
              btn.classList.add('hidden');
            }
          }
        });
      }

      btnAddRule?.addEventListener('click', () => {
        const count = rulesContainer.querySelectorAll('.rule-row').length + 1;
        const newRow = document.createElement('div');
        newRow.className = 'rule-row grid gap-3 sm:grid-cols-12 items-center rounded-2xl bg-[color:var(--surface-strong)] p-3.5 border border-[color:var(--border)]';
        newRow.innerHTML = `
          <div class="sm:col-span-5">
            <label class="block text-[11px] font-bold text-[color:var(--muted)] mb-1">Find #${count}:</label>
            <input
              type="text"
              class="rule-find w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 text-xs text-[color:var(--fg)] font-mono"
              placeholder="Text or pattern to find..."
            />
          </div>
          <div class="sm:col-span-5">
            <label class="block text-[11px] font-bold text-[color:var(--muted)] mb-1">Replace With #${count}:</label>
            <input
              type="text"
              class="rule-replace w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 text-xs text-[color:var(--fg)] font-mono"
              placeholder="Replacement string..."
            />
          </div>
          <div class="sm:col-span-2 flex items-center justify-end gap-1.5 pt-4 sm:pt-0">
            <button
              type="button"
              class="btn-del-rule text-rose-500 hover:text-rose-700 text-xs font-bold p-1 cursor-pointer"
              title="Delete rule"
            >
              ✕
            </button>
          </div>
        `;
        rulesContainer.appendChild(newRow);
        updateDeleteButtons();

        newRow.querySelector('.rule-find')?.addEventListener('input', processText);
        newRow.querySelector('.rule-replace')?.addEventListener('input', processText);
        newRow.querySelector('.btn-del-rule')?.addEventListener('click', () => {
          newRow.remove();
          updateDeleteButtons();
          processText();
        });
      });

      rulesContainer.addEventListener('click', (e) => {
        const btn = e.target.closest('.btn-del-rule');
        if (btn) {
          const row = btn.closest('.rule-row');
          if (row && rulesContainer.querySelectorAll('.rule-row').length > 1) {
            row.remove();
            updateDeleteButtons();
            processText();
          }
        }
      });

      rulesContainer.addEventListener('input', (e) => {
        if (e.target.matches('.rule-find') || e.target.matches('.rule-replace')) {
          processText();
        }
      });

      // Switches & Input listeners
      textIn.addEventListener('input', processText);
      matchCase.addEventListener('change', processText);
      matchWord.addEventListener('change', processText);
      useRegex.addEventListener('change', processText);
      escapeSeq.addEventListener('change', processText);
      preserveCase.addEventListener('change', processText);

      btnSample?.addEventListener('click', () => {
        textIn.value = SAMPLE_TEXT;
        processText();
      });

      btnClear?.addEventListener('click', () => {
        textIn.value = '';
        processText();
      });

      btnCopy?.addEventListener('click', async () => {
        if (!textOut.value) return;
        try {
          await navigator.clipboard.writeText(textOut.value);
          copyLabel.textContent = 'Copied!';
          setTimeout(() => { copyLabel.textContent = 'Copy'; }, 2000);
        } catch (e) {
          textOut.select();
          document.execCommand('copy');
          copyLabel.textContent = 'Copied!';
          setTimeout(() => { copyLabel.textContent = 'Copy'; }, 2000);
        }
      });

      btnDownload?.addEventListener('click', () => {
        if (!textOut.value) return;
        const blob = new Blob([textOut.value], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'find_replace_output.txt';
        a.click();
        URL.revokeObjectURL(url);
      });

      fileUpload?.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (evt) => {
          textIn.value = evt.target.result;
          processText();
        };
        reader.readAsText(file);
      });

      updateDeleteButtons();
      if (textIn.value) {
        processText();
      }
    })();
  </script>
</SiteLayout>
