---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Shipping & Freight Calculators | CBM, Volumetric & Container Capacity · ${siteName}`;
const pageDesc = 'Free shipping and freight logistics calculators. Calculate CBM (cubic meters), volumetric weight, carrier dimensional weight, chargeable weight, and container capacity.';
const canonicalUrl = toAbsoluteUrl('/shipping-calculators/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Shipping Calculators' },
];

const shippingCalculators = [
  {
    slug: 'cbm-calculator',
    title: 'CBM (Cubic Meter) Calculator',
    badge: 'Freight Volume',
    metaDescription: 'Calculate total shipment volume in CBM (m³) and CFT (ft³) from carton dimensions and estimate 20ft, 40ft, and 40HQ container utilization.',
    href: withBasePath('/shipping-calculators/cbm-calculator/'),
    icon: 'converter',
  },
  {
    slug: 'volumetric-weight-calculator',
    title: 'Volumetric Weight Calculator',
    badge: 'Air & Courier',
    metaDescription: 'Calculate dimensional volumetric weight for express air couriers (DHL, FedEx, UPS divisor 5000) and IATA air freight (divisor 6000).',
    href: withBasePath('/shipping-calculators/volumetric-weight-calculator/'),
    icon: 'converter',
  },
  {
    slug: 'dimensional-weight-calculator',
    title: 'Dimensional Weight Calculator',
    badge: 'Domestic Couriers',
    metaDescription: 'Calculate domestic US and international DIM weight for FedEx, UPS, and USPS packages with standard 139 and 166 cubic inch divisors.',
    href: withBasePath('/shipping-calculators/dimensional-weight-calculator/'),
    icon: 'career',
  },
  {
    slug: 'chargeable-weight-calculator',
    title: 'Chargeable Weight Calculator',
    badge: 'Cost Estimator',
    metaDescription: 'Compare actual gross weight against volumetric weight to determine billable chargeable weight and calculate estimated freight shipping costs.',
    href: withBasePath('/shipping-calculators/chargeable-weight-calculator/'),
    icon: 'finance',
  },
  {
    slug: 'container-capacity-calculator',
    title: 'Container Capacity Calculator',
    badge: 'Ocean Freight',
    metaDescription: 'Estimate how many product cartons fit inside 20ft (33 CBM), 40ft (67 CBM), and 40HQ (76 CBM) standard shipping containers with realistic stacking efficiency.',
    href: withBasePath('/shipping-calculators/container-capacity-calculator/'),
    icon: 'converter',
  },
];

const schemaFaq = [
  {
    question: 'How is CBM (Cubic Meter) calculated for freight shipping?',
    answer: 'CBM is calculated as: Length (m) × Width (m) × Height (m) × Quantity. When measuring in centimeters: CBM = (Length cm × Width cm × Height cm ÷ 1,000,000) × Quantity.',
  },
  {
    question: 'What is the rule for Chargeable Weight in air freight?',
    answer: 'Freight forwarders and air carriers charge whichever value is greater: the Actual Gross Weight (measured on a physical scale) or the Volumetric/Dimensional Weight (calculated as L × W × H ÷ 6000 for air freight or ÷ 5000 for express couriers).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-bold text-[color:var(--fg)]">
        <span>Global Logistics &amp; Cargo Suite</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Shipping &amp; Logistics Calculators
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        A precision toolset for importers, exporters, Amazon FBA sellers, freight forwarders, and logistics coordinators. Accurately calculate cargo volume, dimensional weights, and ocean container load capacity.
      </p>
    </header>

    <!-- Calculators Grid -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Freight Engines</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">5 Specialized Logistics Tools</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          5 Calculators
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {shippingCalculators.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
          >
            <div class="space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon slug={tool.slug} category="Shipping & Logistics" size="md" />
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold text-[color:var(--fg)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)]">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[color:var(--fg)]">
              <span>Open Calculator</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
