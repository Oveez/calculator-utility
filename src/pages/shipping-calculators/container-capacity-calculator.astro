---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Container Capacity Calculator | 20ft, 40ft & 40HQ Carton Packing · ${siteName}`;
const pageDesc = 'Estimate how many product cartons will fit into 20ft, 40ft, and 40ft High Cube standard shipping containers with realistic 85-90% packing efficiency.';
const canonicalUrl = toAbsoluteUrl('/shipping-calculators/container-capacity-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Shipping Calculators', href: toAbsoluteUrl('/shipping-calculators/') },
  { label: 'Container Capacity Calculator' },
];

const faqs = [
  {
    question: 'How many cartons fit in a 20ft vs 40ft container?',
    answer: 'A standard 20ft container has a maximum volume of 33.2 CBM and realistically fits about 28–30 CBM of cargo (due to 85–90% stacking efficiency). A 40ft container holds 67.7 CBM (58–62 CBM usable), and a 40HQ holds 76.3 CBM (68–72 CBM usable).',
  },
  {
    question: 'What is the maximum payload weight for ocean containers?',
    answer: 'Maximum payload weight for a 20ft container is approximately 28,080 kg (61,900 lbs), and for 40ft/40HQ containers is approximately 28,600 kg (63,050 lbs), though road weight limits in destination countries may impose stricter caps.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Container Capacity Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Ocean Freight Container Stacking</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Container Capacity Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Estimate the maximum number of master cartons that will realistically fit into standard 20ft, 40ft, and 40HQ ocean shipping containers with weight and volume constraints.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-container-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Container &amp; Carton Specs</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="container-type" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Container Size</label>
            <select id="container-type" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-sm font-semibold text-[color:var(--fg)] outline-none" data-container-type>
              <option value="20ft" selected>20' Standard Dry (33.2 CBM / Max 28,080 kg)</option>
              <option value="40ft">40' Standard Dry (67.7 CBM / Max 28,600 kg)</option>
              <option value="40hq">40' High Cube (76.3 CBM / Max 28,600 kg)</option>
            </select>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div>
              <label for="box-l" class="block text-xs font-medium text-[color:var(--muted)]">Carton L (cm)</label>
              <input id="box-l" type="number" min="1" step="any" value="40" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-box-l />
            </div>
            <div>
              <label for="box-w" class="block text-xs font-medium text-[color:var(--muted)]">Carton W (cm)</label>
              <input id="box-w" type="number" min="1" step="any" value="30" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-box-w />
            </div>
            <div>
              <label for="box-h" class="block text-xs font-medium text-[color:var(--muted)]">Carton H (cm)</label>
              <input id="box-h" type="number" min="1" step="any" value="30" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-box-h />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label for="box-wt" class="block text-xs font-medium text-[color:var(--muted)]">Gross Weight / Carton (kg)</label>
              <input id="box-wt" type="number" min="0.1" step="0.5" value="12" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-box-wt />
            </div>
            <div>
              <label for="stack-eff" class="block text-xs font-medium text-[color:var(--muted)]">Stacking Efficiency</label>
              <select id="stack-eff" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-stack-eff>
                <option value="88" selected>88% (Standard Carton Stacking)</option>
                <option value="82">82% (Palletized Cargo)</option>
                <option value="95">95% (Dense Hand Loading)</option>
              </select>
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6 sm:p-8">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Container Capacity</span>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Realistic Cartons Packed</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-cartons>
                811
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-summary>
                Total Cargo Weight: 9,732 kg (34.7% of Max Payload)
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Volume Utilization:</span>
                <span class="font-bold text-[color:var(--fg)]" data-vol-util>87.9% (29.20 CBM)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Max Theoretical Fit:</span>
                <span class="font-bold text-[color:var(--fg)]" data-theo-cartons>922 cartons</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-container-app]');
      if (!root) return;

      const inType = root.querySelector('[data-container-type]');
      const inL = root.querySelector('[data-box-l]');
      const inW = root.querySelector('[data-box-w]');
      const inH = root.querySelector('[data-box-h]');
      const inWt = root.querySelector('[data-box-wt]');
      const inEff = root.querySelector('[data-stack-eff]');
      const outCartons = root.querySelector('[data-res-cartons]');
      const outSummary = root.querySelector('[data-res-summary]');
      const outVolUtil = root.querySelector('[data-vol-util]');
      const outTheo = root.querySelector('[data-theo-cartons]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      const specs = {
        '20ft': { maxCbm: 33.2, maxPayload: 28080 },
        '40ft': { maxCbm: 67.7, maxPayload: 28600 },
        '40hq': { maxCbm: 76.3, maxPayload: 28600 },
      };

      function update() {
        const type = inType.value || '20ft';
        const spec = specs[type] || specs['20ft'];
        const l = Math.max(1, parseFloat(inL.value || '40'));
        const w = Math.max(1, parseFloat(inW.value || '30'));
        const h = Math.max(1, parseFloat(inH.value || '30'));
        const wt = Math.max(0.1, parseFloat(inWt.value || '12'));
        const eff = parseFloat(inEff.value || '88') / 100;

        const unitCbm = (l / 100) * (w / 100) * (h / 100);
        const theoFit = unitCbm > 0 ? Math.floor(spec.maxCbm / unitCbm) : 0;
        const realisticVolFit = Math.floor(theoFit * eff);
        const maxByWeight = Math.floor(spec.maxPayload / wt);

        const actualPacked = Math.min(realisticVolFit, maxByWeight);
        const totalCargoWt = actualPacked * wt;
        const totalCbmUsed = actualPacked * unitCbm;
        const volPct = (totalCbmUsed / spec.maxCbm) * 100;
        const wtPct = (totalCargoWt / spec.maxPayload) * 100;

        if (outCartons) outCartons.textContent = actualPacked.toLocaleString();
        if (outSummary) {
          outSummary.textContent = `Total Cargo Weight: ${Math.round(totalCargoWt).toLocaleString()} kg (${wtPct.toFixed(1)}% of Max Payload)`;
        }
        if (outVolUtil) outVolUtil.textContent = `${volPct.toFixed(1)}% (${totalCbmUsed.toFixed(2)} CBM)`;
        if (outTheo) outTheo.textContent = `${theoFit.toLocaleString()} cartons (100% theoretical)`;
      }

      inType.addEventListener('change', update);
      inL.addEventListener('input', update);
      inW.addEventListener('input', update);
      inH.addEventListener('input', update);
      inWt.addEventListener('input', update);
      inEff.addEventListener('change', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inType.value = '20ft';
          inL.value = '40';
          inW.value = '30';
          inH.value = '30';
          inWt.value = '12';
          inEff.value = '88';
          update();
        });
      }

      update();
    })();
  </script>
</SiteLayout>
