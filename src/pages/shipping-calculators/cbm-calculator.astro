---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `CBM Calculator | Cargo Volume & Container Fit (m³ & ft³) · ${siteName}`;
const pageDesc = 'Free CBM (Cubic Meter) calculator for freight shipping. Calculate total cargo volume in m³ and ft³, multi-box consignments, and 20ft/40ft/40HQ container load percentages.';
const canonicalUrl = toAbsoluteUrl('/shipping-calculators/cbm-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Shipping Calculators', href: toAbsoluteUrl('/shipping-calculators/') },
  { label: 'CBM Calculator' },
];

const faqs = [
  {
    question: 'How do you calculate CBM for cartons?',
    answer: 'CBM (Cubic Meters) is calculated as: Length (m) × Width (m) × Height (m) × Quantity. In centimeters: (L × W × H ÷ 1,000,000) × Quantity. In inches: (L × W × H ÷ 61,023.7) × Quantity.',
  },
  {
    question: 'What are the CBM capacities of standard shipping containers?',
    answer: 'Standard container usable volume capacities are: 20ft Standard Container (~28–33.2 CBM), 40ft Standard Container (~58–67.7 CBM), and 40ft High Cube Container (~68–76.3 CBM).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CBM Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Freight &amp; Logistics Volume</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        CBM (Cubic Meter) Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Calculate the total cubic volume of your shipment in cubic meters (m³) and cubic feet (ft³), and check your container load percentage across standard 20ft, 40ft, and 40HQ ocean containers.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-cbm-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">
        <div class="space-y-5">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Package Dimensions</h2>
            <div class="flex items-center gap-2">
              <select class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] outline-none" data-unit-select>
                <option value="cm" selected>Centimeters (cm)</option>
                <option value="m">Meters (m)</option>
                <option value="in">Inches (in)</option>
                <option value="ft">Feet (ft)</option>
              </select>
              <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
                ↺ Reset
              </button>
            </div>
          </div>

          <!-- Dynamic Package Rows Container -->
          <div class="space-y-3" data-items-container>
            <!-- Injected rows via JS -->
          </div>

          <button
            type="button"
            class="inline-flex items-center gap-2 cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-2 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition"
            data-add-row-btn
          >
            <span>+ Add Package Type</span>
          </button>
        </div>

        <!-- Result Box -->
        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6 sm:p-8">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Consignment Volume</span>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Total Cargo Volume</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-cbm>
                4.8000 m³
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-cft>
                169.51 Cubic Feet (CFT)
              </p>
            </div>

            <!-- Container Fit Progress -->
            <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <p class="font-bold uppercase tracking-wider text-[color:var(--muted)] text-[10px]">Container Load Utilization</p>
              <div class="space-y-1.5">
                <div class="flex justify-between">
                  <span>20ft Standard (33.2 CBM):</span>
                  <span class="font-bold font-mono text-[color:var(--fg)]" data-fit-20>14.5%</span>
                </div>
                <div class="w-full bg-[color:var(--surface-strong)] rounded-full h-1.5 overflow-hidden">
                  <div class="bg-[color:var(--accent)] h-1.5 rounded-full" data-bar-20 style="width: 14.5%"></div>
                </div>
              </div>

              <div class="space-y-1.5 pt-1">
                <div class="flex justify-between">
                  <span>40ft Standard (67.7 CBM):</span>
                  <span class="font-bold font-mono text-[color:var(--fg)]" data-fit-40>7.1%</span>
                </div>
                <div class="w-full bg-[color:var(--surface-strong)] rounded-full h-1.5 overflow-hidden">
                  <div class="bg-[color:var(--accent)] h-1.5 rounded-full" data-bar-40 style="width: 7.1%"></div>
                </div>
              </div>

              <div class="space-y-1.5 pt-1">
                <div class="flex justify-between">
                  <span>40ft High Cube (76.3 CBM):</span>
                  <span class="font-bold font-mono text-[color:var(--fg)]" data-fit-40hq>6.3%</span>
                </div>
                <div class="w-full bg-[color:var(--surface-strong)] rounded-full h-1.5 overflow-hidden">
                  <div class="bg-[color:var(--accent)] h-1.5 rounded-full" data-bar-40hq style="width: 6.3%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-cbm-app]');
      if (!root) return;

      const unitSelect = root.querySelector('[data-unit-select]');
      const container = root.querySelector('[data-items-container]');
      const addBtn = root.querySelector('[data-add-row-btn]');
      const resetBtn = root.querySelector('[data-reset-btn]');
      const outCbm = root.querySelector('[data-res-cbm]');
      const outCft = root.querySelector('[data-res-cft]');
      const fit20 = root.querySelector('[data-fit-20]');
      const bar20 = root.querySelector('[data-bar-20]');
      const fit40 = root.querySelector('[data-fit-40]');
      const bar40 = root.querySelector('[data-bar-40]');
      const fit40hq = root.querySelector('[data-fit-40hq]');
      const bar40hq = root.querySelector('[data-bar-40hq]');

      let items = [
        { length: 50, width: 40, height: 40, quantity: 60 },
      ];

      function toMeters(val, u) {
        if (u === 'cm') return val / 100;
        if (u === 'm') return val;
        if (u === 'in') return val * 0.0254;
        if (u === 'ft') return val * 0.3048;
        return val;
      }

      function render() {
        if (!container) return;
        const u = unitSelect.value;
        container.innerHTML = items.map((it, idx) => `
          <div class="grid grid-cols-[1fr_1fr_1fr_1fr_auto] gap-2 items-center p-2.5 rounded-2xl bg-[color:var(--surface)] border border-[color:var(--border)]">
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Length (${u})</label>
              <input type="number" min="0" step="any" value="${it.length}" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-l="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Width (${u})</label>
              <input type="number" min="0" step="any" value="${it.width}" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-w="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Height (${u})</label>
              <input type="number" min="0" step="any" value="${it.height}" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-h="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Quantity</label>
              <input type="number" min="1" step="1" value="${it.quantity}" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-q="${idx}" />
            </div>
            <div class="flex items-end pt-3">
              <button type="button" class="cursor-pointer text-xs text-red-500 hover:text-red-700 px-2 py-1 font-bold" data-remove-row="${idx}">✕</button>
            </div>
          </div>
        `).join('');

        attachListeners();
        calc();
      }

      function attachListeners() {
        container.querySelectorAll('[data-item-l]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemL].length = parseFloat(e.target.value || '0'); calc(); });
        });
        container.querySelectorAll('[data-item-w]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemW].width = parseFloat(e.target.value || '0'); calc(); });
        });
        container.querySelectorAll('[data-item-h]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemH].height = parseFloat(e.target.value || '0'); calc(); });
        });
        container.querySelectorAll('[data-item-q]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemQ].quantity = parseInt(e.target.value || '1', 10); calc(); });
        });
        container.querySelectorAll('[data-remove-row]').forEach(btn => {
          btn.addEventListener('click', e => {
            const idx = parseInt(e.target.dataset.removeRow, 10);
            if (items.length > 1) { items.splice(idx, 1); render(); }
          });
        });
      }

      function calc() {
        const u = unitSelect.value;
        let totalCbm = 0;

        items.forEach(it => {
          const lm = toMeters(Math.max(0, it.length || 0), u);
          const wm = toMeters(Math.max(0, it.width || 0), u);
          const hm = toMeters(Math.max(0, it.height || 0), u);
          const qty = Math.max(1, it.quantity || 1);
          totalCbm += (lm * wm * hm) * qty;
        });

        const totalCft = totalCbm * 35.3147;
        const p20 = Math.min(100, (totalCbm / 33.2) * 100);
        const p40 = Math.min(100, (totalCbm / 67.7) * 100);
        const p40hq = Math.min(100, (totalCbm / 76.3) * 100);

        if (outCbm) outCbm.textContent = `${totalCbm.toFixed(4)} m³`;
        if (outCft) outCft.textContent = `${totalCft.toFixed(2)} Cubic Feet (CFT)`;

        if (fit20) fit20.textContent = `${p20.toFixed(1)}%`;
        if (bar20) bar20.style.width = `${p20}%`;
        if (fit40) fit40.textContent = `${p40.toFixed(1)}%`;
        if (bar40) bar40.style.width = `${p40}%`;
        if (fit40hq) fit40hq.textContent = `${p40hq.toFixed(1)}%`;
        if (bar40hq) bar40hq.style.width = `${p40hq}%`;
      }

      if (addBtn) {
        addBtn.addEventListener('click', () => {
          items.push({ length: 40, width: 30, height: 30, quantity: 20 });
          render();
        });
      }

      unitSelect.addEventListener('change', render);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          unitSelect.value = 'cm';
          items = [{ length: 50, width: 40, height: 40, quantity: 60 }];
          render();
        });
      }

      render();
    })();
  </script>
</SiteLayout>
