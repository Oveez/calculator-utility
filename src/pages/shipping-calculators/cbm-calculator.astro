---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const parameterGuide = [
  { id: 'cbmVolume', name: 'Total Cargo Volume (CBM / m³)', description: 'Cubic meter displacement of the total consignment, combining all carton lines.', whyItMatters: 'Primary metric for ocean freight shipping (LCL / FCL) and warehousing storage fees.', typicalRange: '0.1 to 100+ CBM', unit: 'm³' },
  { id: 'cftVolume', name: 'Total Volume in Cubic Feet (CFT / ft³)', description: 'Imperial volume equivalent (1 CBM = 35.3147 CFT).', whyItMatters: 'Standard volume measurement used in US domestic trucking (LTL) and air cargo handling.', typicalRange: '3.5 to 3,500+ CFT', unit: 'ft³' },
  { id: 'container20ft', name: '20ft Container Utilization', description: 'Percentage load of a standard 20ft ocean container (usable capacity ~33.2 CBM).', whyItMatters: 'Determines whether your shipment qualifies for full-container load (FCL) or less-than-container load (LCL).', typicalRange: '0% to 100%', unit: '%' },
  { id: 'container40ft', name: '40ft Container Utilization', description: 'Percentage load of a standard 40ft ocean container (usable capacity ~67.7 CBM).', whyItMatters: 'Ideal for medium to large export consignments balancing volume and payload weight.', typicalRange: '0% to 100%', unit: '%' },
  { id: 'container40hq', name: '40ft High Cube Utilization', description: 'Percentage load of a 40ft High Cube container with extra 1-foot vertical clearance (~76.3 CBM).', whyItMatters: 'Preferred for lightweight, high-volume, bulky cargo (furniture, apparel, plastics).', typicalRange: '0% to 100%', unit: '%' },
  { id: 'unitSelector', name: 'Dimension Measurement Units', description: 'Supports centimeters (cm), meters (m), inches (in), or feet (ft).', whyItMatters: 'Ensures precision regardless of whether supplier packing lists use metric or imperial blueprints.', typicalRange: 'cm, m, in, ft', unit: 'unit' },
];

const pageTitle = `CBM Calculator | Cargo Volume & Container Fit (m³ & ft³) · ${siteName}`;
const pageDesc = 'Free CBM (Cubic Meter) calculator for freight shipping. Calculate total cargo volume in m³ and ft³, multi-box consignments, and 20ft/40ft/40HQ container load percentages.';
const canonicalUrl = toAbsoluteUrl('/shipping-calculators/cbm-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Shipping Calculators', href: toAbsoluteUrl('/shipping-calculators/') },
  { label: 'CBM Calculator' },
];

const faqs = [
  {
    question: 'How do you calculate CBM for cartons?',
    answer: 'CBM (Cubic Meters) is calculated as: Length (m) × Width (m) × Height (m) × Quantity. In centimeters: (L × W × H ÷ 1,000,000) × Quantity. In inches: (L × W × H ÷ 61,023.7) × Quantity.',
  },
  {
    question: 'What are the CBM capacities of standard shipping containers?',
    answer: 'Standard container usable volume capacities are: 20ft Standard Container (~28–33.2 CBM), 40ft Standard Container (~58–67.7 CBM), and 40ft High Cube Container (~68–76.3 CBM).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'CBM Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Freight &amp; Logistics Volume</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        CBM (Cubic Meter) Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Calculate the total cubic volume of your shipment in cubic meters (m³) and cubic feet (ft³), and check your container load percentage across standard 20ft, 40ft, and 40HQ ocean containers.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-cbm-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">
        <div class="space-y-5">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Package Dimensions</h2>
            <div class="flex items-center gap-2">
              <select class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] outline-none" data-unit-select>
                <option value="cm" selected>Centimeters (cm)</option>
                <option value="m">Meters (m)</option>
                <option value="in">Inches (in)</option>
                <option value="ft">Feet (ft)</option>
              </select>
              <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
                ↺ Reset
              </button>
            </div>
          </div>

          <!-- Dynamic Package Rows Container -->
          <div class="space-y-3" data-items-container>
            <!-- Injected rows via JS -->
          </div>

          <button
            type="button"
            class="inline-flex items-center gap-2 cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-2 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition"
            data-add-row-btn
          >
            <span>+ Add Package Type</span>
          </button>
        </div>

        <!-- Result Box -->
        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Consignment Volume</span>
              <button
                type="button"
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition cursor-pointer"
                data-copy-btn
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </b            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Total Cargo Volume</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-cbm>
                0.0000 m³
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-cft>
                0.00 Cubic Feet (CFT)
              </p>
            </div>

            <!-- Container Fit Progress -->
            <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <p class="font-bold uppercase tracking-wider text-[color:var(--muted)] text-[10px]">Container Load Utilization</p>

              <div class="space-y-1.5">
                <div class="flex justify-between">
                  <span>20ft Standard (33.2 CBM):</span>
                  <span class="font-bold font-mono text-[color:var(--fg)]" data-fit-20>0.0%</span>
                </div>
                <div class="w-full bg-[color:var(--surface-strong)] rounded-full h-1.5 overflow-hidden">
                  <div class="bg-[color:var(--accent)] h-1.5 rounded-full" data-bar-20 style="width: 0%"></div>
                </div>
              </div>

              <div class="space-y-1.5 pt-1">
                <div class="flex justify-between">
                  <span>40ft Standard (67.7 CBM):</span>
                  <span class="font-bold font-mono text-[color:var(--fg)]" data-fit-40>0.0%</span>
                </div>
                <div class="w-full bg-[color:var(--surface-strong)] rounded-full h-1.5 overflow-hidden">
                  <div class="bg-[color:var(--accent)] h-1.5 rounded-full" data-bar-40 style="width: 0%"></div>
                </div>
              </div>

              <div class="space-y-1.5 pt-1">
                <div class="flex justify-between">
                  <span>40ft High Cube (76.3 CBM):</span>
                  <span class="font-bold font-mono text-[color:var(--fg)]" data-fit-40hq>0.0%</span>
                </div>
                <div class="w-full bg-[color:var(--surface-strong)] rounded-full h-1.5 overflow-hidden">
                  <div class="bg-[color:var(--accent)] h-1.5 rounded-full" data-bar-40hq style="width: 0%"></div>
                </div>
              </div>
            </div>     </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formula & Conversion Architecture -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Volume Mathematics</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" /><span>How Cargo Volume (CBM &amp; CFT) Is Calculated</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">1. Metric CBM Formulas</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            From cm: CBM = (Length × Width × Height ÷ 1,000,000) × Qty
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            When dimensions are in meters: CBM = Length (m) × Width (m) × Height (m) × Quantity.
          </p>
        </div>

        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">2. Imperial CFT &amp; Container Fit</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            CFT = Total CBM × 35.3147 | Fit% = (Total CBM ÷ Capacity) × 100
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Evaluates against standard usable ocean capacities: 20ft (33.2 m³), 40ft (67.7 m³), 40HQ (76.3 m³).
          </p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Step-By-Step Walkthrough</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" /><span>Worked Example: 50 Export Cartons (60 × 40 × 40 cm)</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">1. Single Carton Volume</p>
          <p class="text-[color:var(--muted)]">L = 60 cm, W = 40 cm, H = 40 cm.</p>
          <p class="text-[color:var(--muted)]">Unit CBM = (60 × 40 × 40) ÷ 1,000,000.</p>
          <p class="text-[color:var(--muted)]">Unit CBM = <strong>0.0960 m³</strong> per carton.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">2. Consignment Volume</p>
          <p class="text-[color:var(--muted)]">Total CBM = 0.0960 × 50 = <strong>4.8000 m³</strong>.</p>
          <p class="text-[color:var(--muted)]">Total CFT = 4.8000 × 35.3147 = <strong>169.51 ft³</strong>.</p>
          <p class="text-[color:var(--muted)]">Eligible for Ocean LCL consolidation.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">3. Container Load Fit</p>
          <p class="text-[color:var(--muted)]">20ft Container (33.2 m³): <strong>14.5% load</strong>.</p>
          <p class="text-[color:var(--muted)]">40ft Container (67.7 m³): <strong>7.1% load</strong>.</p>
          <p class="text-[color:var(--muted)]">40ft High Cube (76.3 m³): <strong>6.3% load</strong>.</p>
        </div>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-cbm-app]');
      if (!root) return;

      const unitSelect = root.querySelector('[data-unit-select]');
      const container = root.querySelector('[data-items-container]');
      const addBtn = root.querySelector('[data-add-row-btn]');
      const resetBtn = root.querySelector('[data-reset-btn]');
      const outCbm = root.querySelector('[data-res-cbm]');
      const outCft = root.querySelector('[data-res-cft]');
      const fit20 = root.querySelector('[data-fit-20]');
      const bar20 = root.querySelector('[data-bar-20]');
      const fit40 = root.querySelector('[data-fit-40]');
      const bar40 = root.querySelector('[data-bar-40]');
      const fit40hq = root.querySelector('[data-fit-40hq]');
           let items = [
        { length: '', width: '', height: '', quantity: '' },
      ];

      function toMeters(val, u) {
        if (u === 'cm') return val / 100;
        if (u === 'm') return val;
        if (u === 'in') return val * 0.0254;
        if (u === 'ft') return val * 0.3048;
        return val;
      }

      function render() {
        if (!container) return;
        const u = unitSelect.value;
        container.innerHTML = items.map((it, idx) => `
          <div class="grid grid-cols-[1fr_1fr_1fr_1fr_auto] gap-2 items-center p-2.5 rounded-2xl bg-[color:var(--surface)] border border-[color:var(--border)]">
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Length (${u})</label>
              <input type="number" min="0" step="any" value="${it.length ?? ''}" placeholder="e.g. 50" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-l="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Width (${u})</label>
              <input type="number" min="0" step="any" value="${it.width ?? ''}" placeholder="e.g. 40" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-w="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Height (${u})</label>
              <input type="number" min="0" step="any" value="${it.height ?? ''}" placeholder="e.g. 40" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-h="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] uppercase font-bold text-[color:var(--muted)]">Quantity</label>
              <input type="number" min="1" step="1" value="${it.quantity ?? ''}" placeholder="e.g. 60" class="mt-0.5 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1.5 text-xs font-semibold text-[color:var(--fg)] outline-none" data-item-q="${idx}" />
            </div>
            <div class="flex items-end pt-3">
              <button type="button" class="cursor-pointer text-xs text-rose-500 hover:text-rose-700 hover:bg-rose-500/10 rounded-lg p-1.5 transition" data-remove-row="${idx}" aria-label="Remove row"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
            </div>
          </div>
        `).join('');

        attachListeners();
        calc();
      }

      function attachListeners() {
        container.querySelectorAll('[data-item-l]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemL].length = e.target.value; calc(); });
        });
        container.querySelectorAll('[data-item-w]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemW].width = e.target.value; calc(); });
        });
        container.querySelectorAll('[data-item-h]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemH].height = e.target.value; calc(); });
        });
        container.querySelectorAll('[data-item-q]').forEach(input => {
          input.addEventListener('input', e => { items[e.target.dataset.itemQ].quantity = e.target.value; calc(); });
        });
        container.querySelectorAll('[data-remove-row]').forEach(btn => {
          btn.addEventListener('click', e => {
            const idx = parseInt(e.target.dataset.removeRow, 10);
            if (items.length > 1) { items.splice(idx, 1); render(); }
          });
        });
      }

      function calc() {
        const u = unitSelect.value;
        let totalCbm = 0;

        items.forEach(it => {
          const l = parseFloat(it.length) || 0;
          const w = parseFloat(it.width) || 0;
          const h = parseFloat(it.height) || 0;
          const qty = parseInt(it.quantity, 10) || 0;
          if (l > 0 && w > 0 && h > 0 && qty > 0) {
            const lm = toMeters(l, u);
            const wm = toMeters(w, u);
            const hm = toMeters(h, u);
            totalCbm += (lm * wm * hm) * qty;
          }
        });

        const totalCft = totalCbm * 35.3147;
        const p20 = Math.min(100, (totalCbm / 33.2) * 100);
        const p40 = Math.min(100, (totalCbm / 67.7) * 100);
        const p40hq = Math.min(100, (totalCbm / 76.3) * 100);

        if (outCbm) outCbm.textContent = `${totalCbm.toFixed(4)} m³`;
        if (outCft) outCft.textContent = `${totalCft.toFixed(2)} Cubic Feet (CFT)`;

        if (fit20) fit20.textContent = `${p20.toFixed(1)}%`;
        if (bar20) bar20.style.width = `${p20}%`;
        if (fit40) fit40.textContent = `${p40.toFixed(1)}%`;
        if (bar40) bar40.style.width = `${p40}%`;
        if (fit40hq) fit40hq.textContent = `${p40hq.toFixed(1)}%`;
        if (bar40hq) bar40hq.style.width = `${p40hq}%`;
      }

      if (addBtn) {
        addBtn.addEventListener('click', () => {
          items.push({ length: '', width: '', height: '', quantity: '' });
          render();
        });
      }

      unitSelect.addEventListener('change', render);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          unitSelect.value = 'cm';
          items = [{ length: '', width: '', height: '', quantity: '' }];
          render();
        });
      }

      const copyBtn = root.querySelector('[data-copy-btn]');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = `Consignment Cargo Volume:\n• Total Volume: ${outCbm?.textContent || ''} (${outCft?.textContent || ''})\n• 20ft Container Load: ${fit20?.textContent || ''}\n• 40ft Container Load: ${fit40?.textContent || ''}\n• 40HQ Container Load: ${fit40hq?.textContent || ''}`;
          try {
            await navigator.clipboard.writeText(text);
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>Copied!</span>';
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          } catch (e) {
            console.error('Clipboard copy failed', e);
          }
        });
      }

      render();
    })();
  </script>
</SiteLayout>
