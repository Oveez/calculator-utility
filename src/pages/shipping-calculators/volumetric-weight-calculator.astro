---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `Volumetric Weight Calculator | Air Freight & Courier Divisors · ${siteName}`;
const pageDesc = 'Calculate dimensional volumetric weight for express couriers (DHL, FedEx, UPS divisor 5000) and IATA air freight (divisor 6000) in kg and lbs.';
const canonicalUrl = toAbsoluteUrl('/shipping-calculators/volumetric-weight-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Shipping Calculators', href: toAbsoluteUrl('/shipping-calculators/') },
  { label: 'Volumetric Weight Calculator' },
];

const faqs = [
  {
    question: 'How is volumetric weight calculated for air freight and couriers?',
    answer: 'For dimensions in centimeters: Volumetric Weight (kg) = (Length × Width × Height) ÷ Divisor. Express couriers (DHL, FedEx, UPS International) use divisor 5000 (1 CBM = 200 kg). Standard IATA Air Freight uses divisor 6000 (1 CBM = 167 kg).',
  },
  {
    question: 'Why do shipping carriers charge by volumetric weight?',
    answer: 'Air cargo holds are limited by physical volume as well as payload weight. Lightweight, bulky goods (like pillows or styrofoam) consume large space without adding weight, so airlines charge for the equivalent volumetric weight.',
  },
];

const parameterGuide = [
  {
    id: 'carrierDivisor',
    name: 'Carrier Divisor Standard',
    description:
      'Dimensional factor determined by mode of transport. Express couriers (DHL, FedEx, UPS) standardly use divisor 5000 (1 CBM = 200 kg). IATA standard air freight cargo uses divisor 6000 (1 CBM = 167 kg).',
    whyItMatters: 'Divisor 5000 produces 20% higher billable weight than Divisor 6000.',
    typicalRange: '5000 (Courier) vs 6000 (IATA Air)',
    unit: 'divisor',
  },
  {
    id: 'packageDimensions',
    name: 'Package Dimensions (cm)',
    description:
      'The length, width, and height of each carton or crate measured at its outermost points (including bulges, handles, and pallet overhang).',
    whyItMatters: 'Multiplied together to determine cubic centimeters (cm³) volume.',
    typicalRange: '10 to 200 cm',
    unit: 'cm',
  },
  {
    id: 'packageQuantity',
    name: 'Package Quantity (Units)',
    description:
      'Total number of identical pieces in the consignment. Volume and weight calculate per unit and scale across the entire shipment batch.',
    whyItMatters: 'Scales unit volumetric weight up to the total consignment weight.',
    typicalRange: '1 to 500+ units',
    unit: 'units',
  },
  {
    id: 'volumetricWeight',
    name: 'Calculated Volumetric Weight (kg)',
    description:
      'The dimensional equivalent weight computed as (Length × Width × Height in cm) ÷ Divisor × Quantity. Expressed in kg and lbs.',
    whyItMatters: 'The minimum air weight billed for low-density or bulky cargo.',
    typicalRange: '1 to 5,000+ kg',
    unit: 'kg',
  },
  {
    id: 'actualWeight',
    name: 'Actual Gross Weight (kg)',
    description:
      'The physical gross weight of the packages placed on a certified scale, including carton boxes, internal packing, dunnage, and strapping.',
    whyItMatters: 'Compared directly with volumetric weight to find final billing basis.',
    typicalRange: '0.1 to 10,000 kg',
    unit: 'kg',
  },
  {
    id: 'chargeableBasis',
    name: 'Chargeable Weight Basis',
    description:
      'The final weight basis invoiced by carriers. By universal freight convention, carriers charge the greater of actual gross weight vs. volumetric weight.',
    whyItMatters: 'Directly determines freight invoicing cost per kg.',
    typicalRange: 'Max of Actual vs Volumetric',
    unit: 'basis',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Volumetric Weight Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Air Cargo &amp; Courier Logistics</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Volumetric Weight Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Calculate dimensional weight for air cargo and express courier shipments. Supports standard 5000 and 6000 divisors in metric (cm/kg) and imperial (in/lbs) units.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-vol-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Package Dimensions</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="carrier-mode" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Carrier / Freight Standard</label>
            <select id="carrier-mode" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-sm font-semibold text-[color:var(--fg)] outline-none" data-carrier-mode>
              <option value="5000" selected>Express Courier - DHL / FedEx / UPS (Divisor 5000)</option>
              <option value="6000">IATA Air Freight Standard (Divisor 6000)</option>
              <option value="custom">Custom Divisor</option>
            </select>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div>
              <label for="vol-l" class="block text-xs font-medium text-[color:var(--muted)]">Length (cm)</label>
              <input id="vol-l" type="number" min="0" step="any" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-vol-l placeholder="e.g. 60" />
            </div>
            <div>
              <label for="vol-w" class="block text-xs font-medium text-[color:var(--muted)]">Width (cm)</label>
              <input id="vol-w" type="number" min="0" step="any" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-vol-w placeholder="e.g. 40" />
            </div>
            <div>
              <label for="vol-h" class="block text-xs font-medium text-[color:var(--muted)]">Height (cm)</label>
              <input id="vol-h" type="number" min="0" step="any" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-vol-h placeholder="e.g. 40" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label for="vol-qty" class="block text-xs font-medium text-[color:var(--muted)]">Package Quantity</label>
              <input id="vol-qty" type="number" min="1" step="1" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-vol-qty placeholder="e.g. 5" />
            </div>
            <div>
              <label for="vol-act-wt" class="block text-xs font-medium text-[color:var(--muted)]">Actual Weight (kg/unit opt)</label>
              <input id="vol-act-wt" type="number" min="0" step="0.1" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-vol-act placeholder="e.g. 12" />
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Chargeable Estimate</span>
              <button
                type="button"
                class="inline-flex items-center gap-1.5 rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-semibold text-[color:var(--fg)] hover:bg-[color:var(--bg)] transition cursor-pointer"
                data-copy-btn
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </button>
            </div>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Total Volumetric Weight</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-volkg>
                0.00 kg
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-vollbs>
                0.00 lbs (0.00 kg / package)
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Total Actual Weight:</span>
                <span class="font-bold text-[color:var(--fg)]" data-disp-act>0.00 kg (0.00 lbs)</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="font-bold text-[color:var(--fg)]">Chargeable Weight Basis:</span>
                <span class="font-bold text-[color:var(--muted)] font-mono" data-disp-basis>—</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formula & Volumetric Divisors -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Air Freight &amp; Courier Mathematics</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" /><span>How Volumetric Weight is Calculated</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">1. Metric Centimeter Divisors</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Volumetric Wt (kg) = (Length × Width × Height in cm) ÷ Divisor × Qty
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            Express Couriers (DHL, FedEx Express, UPS): Divisor <strong>5000</strong> (1 CBM = 200 kg). IATA Standard Air Freight: Divisor <strong>6000</strong> (1 CBM = 167 kg).
          </p>
        </div>

        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-2">
          <p class="font-bold text-[color:var(--fg)]">2. Chargeable Rule</p>
          <div class="rounded-xl bg-[color:var(--surface)] p-3 font-mono text-xs text-[color:var(--fg)] overflow-x-auto">
            Chargeable Wt = max(Actual Gross Scale Weight, Volumetric Weight)
          </div>
          <p class="text-xs text-[color:var(--muted)]">
            If volumetric weight exceeds actual weight, the shipment is considered "light/bulky" cargo and charged on dimensional weight.
          </p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Example -->
    <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Step-By-Step Walkthrough</p>
        <h2 class="text-xl font-bold text-[color:var(--fg)] flex items-center gap-2"><Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" /><span>Worked Example: 5 Cartons (60 × 40 × 40 cm, 12 kg each)</span></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 text-xs sm:text-sm">
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">1. Single Unit Volumetric Weight</p>
          <p class="text-[color:var(--muted)]">Volume = 60 × 40 × 40 = <strong>96,000 cm³</strong>.</p>
          <p class="text-[color:var(--muted)]">Express Divisor = 5000.</p>
          <p class="text-[color:var(--muted)]">Unit Vol Wt = 96,000 ÷ 5000 = <strong>19.20 kg</strong>.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">2. Consignment Totals (5 Pcs)</p>
          <p class="text-[color:var(--muted)]">Total Vol Wt = 19.20 × 5 = <strong>96.00 kg (211.64 lbs)</strong>.</p>
          <p class="text-[color:var(--muted)]">Total Actual Wt = 12 × 5 = <strong>60.00 kg (132.28 lbs)</strong>.</p>
          <p class="text-[color:var(--muted)]">At IATA Div 6000: Vol Wt = 80.00 kg.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--bg)] p-4 border border-[color:var(--border)] space-y-1.5">
          <p class="font-bold text-[color:var(--fg)]">3. Invoiced Billing Basis</p>
          <p class="text-[color:var(--muted)]">96.00 kg volumetric &gt; 60.00 kg actual.</p>
          <p class="text-[color:var(--muted)]">Billed on <strong>Volumetric Weight (96.00 kg)</strong>.</p>
          <p class="text-[color:var(--muted)]">Carrier bills for an additional <strong>36.00 kg</strong>.</p>
        </div>
      </div>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-vol-app]');
      if (!root) return;

      const inDiv = root.querySelector('[data-carrier-mode]');
      const inL = root.querySelector('[data-vol-l]');
      const inW = root.querySelector('[data-vol-w]');
      const inH = root.querySelector('[data-vol-h]');
      const inQty = root.querySelector('[data-vol-qty]');
      const inAct = root.querySelector('[data-vol-act]');
      const outKg = root.querySelector('[data-res-volkg]');
      const outLbs = root.querySelector('[data-res-vollbs]');
      const outAct = root.querySelector('[data-disp-act]');
      const outBasis = root.querySelector('[data-disp-basis]');
      const resetBtn = root.querySelector('[data-reset-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function update() {
        const div = (inDiv.value !== '' && !isNaN(parseFloat(inDiv.value)) ? parseFloat(inDiv.value) : 0);
        const l = inL.value ? Math.max(0, (inL.value !== '' && !isNaN(parseFloat(inL.value)) ? parseFloat(inL.value) : 0)) : 0;
        const w = inW.value ? Math.max(0, (inW.value !== '' && !isNaN(parseFloat(inW.value)) ? parseFloat(inW.value) : 0)) : 0;
        const h = inH.value ? Math.max(0, (inH.value !== '' && !isNaN(parseFloat(inH.value)) ? parseFloat(inH.value) : 0)) : 0;
        const qty = inQty.value ? Math.max(1, (inQty.value !== '' && !isNaN(parseInt(inQty.value, 10)) ? parseInt(inQty.value, 10) : 0)) : 1;
        const actPer = inAct.value ? Math.max(0, (inAct.value !== '' && !isNaN(parseFloat(inAct.value)) ? parseFloat(inAct.value) : 0)) : 0;

        const hasDims = l > 0 && w > 0 && h > 0;
        const unitVolKg = hasDims ? (l * w * h) / div : 0;
        const totalVolKg = unitVolKg * qty;
        const totalVolLbs = totalVolKg * 2.20462;

        const totalActKg = actPer * qty;
        const totalActLbs = totalActKg * 2.20462;

        if (!hasDims && totalActKg === 0) {
          if (outKg) outKg.textContent = '0.00 kg';
          if (outLbs) outLbs.textContent = '0.00 lbs (0.00 kg / package)';
          if (outAct) outAct.textContent = '0.00 kg (0.00 lbs)';
          if (outBasis) {
            outBasis.textContent = '—';
            outBasis.className = 'font-bold text-[color:var(--muted)] font-mono';
          }
          return;
        }

        if (outKg) outKg.textContent = `${totalVolKg.toFixed(2)} kg`;
        if (outLbs) outLbs.textContent = `${totalVolLbs.toFixed(2)} lbs (${unitVolKg.toFixed(2)} kg / package)`;
        if (outAct) outAct.textContent = `${totalActKg.toFixed(2)} kg (${totalActLbs.toFixed(2)} lbs)`;

        if (outBasis) {
          if (totalVolKg >= totalActKg) {
            outBasis.textContent = `Volumetric Weight (${totalVolKg.toFixed(2)} kg)`;
            outBasis.className = 'font-bold text-red-500 font-mono';
          } else {
            outBasis.textContent = `Actual Gross Weight (${totalActKg.toFixed(2)} kg)`;
            outBasis.className = 'font-bold text-cyan-600 dark:text-cyan-400 font-mono';
          }
        }
      }

      inDiv.addEventListener('change', update);
      inL.addEventListener('input', update);
      inW.addEventListener('input', update);
      inH.addEventListener('input', update);
      inQty.addEventListener('input', update);
      inAct.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inDiv.value = '';
          inL.value = '';
          inW.value = '';
          inH.value = '';
          inQty.value = '';
          inAct.value = '';
          update();
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = [
            '--- Volumetric Weight Summary ---',
            `Divisor: ${inDiv.value === '5000' ? 'Express Courier 5000' : inDiv.value === '6000' ? 'IATA Air Freight 6000' : 'Custom'}`,
            `Dimensions: ${inL.value} × ${inW.value} × ${inH.value} cm`,
            `Quantity: ${inQty.value} units`,
            `Total Volumetric Weight: ${outKg?.textContent || ''} (${outLbs?.textContent || ''})`,
            `Total Actual Weight: ${outAct?.textContent || ''}`,
            `Chargeable Basis: ${outBasis?.textContent || ''}`,
          ].join('\n');

          try {
            await navigator.clipboard.writeText(text);
            const orig = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>✓ Copied!</span>';
            setTimeout(() => {
              copyBtn.innerHTML = orig;
            }, 2000);
          } catch {
            alert('Failed to copy to clipboard');
          }
        });
      }

      update();
    })();
  </script>
</SiteLayout>
