---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CurrencyConverterApp from '../../components/CurrencyConverterApp.astro';
import Icon from '../../components/Icon.astro';
import { withBasePath } from '../../utils/site';

const pageTitle = "Currency Converter — Live Currency Exchange Rates & Forex Calculator";
const pageDesc = "Free online currency converter and exchange rate calculator. Convert 160+ world currencies with real-time currency exchange rates, live forex calculator data, and instant money converter tools.";
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={withBasePath('/calculators/currency-converter/')}>
  <div class="mx-auto max-w-5xl space-y-10">
    <!-- Breadcrumb / compact page context -->
    <nav class="site-tool-breadcrumb flex items-center gap-2 text-xs font-medium text-[color:var(--muted)] mb-4 pt-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <a href="/#calculators?category=Converters" class="hover:text-[color:var(--accent)]">Converters</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Currency Converter</span>
    </nav>

    <!-- Interactive Currency App -->
    <CurrencyConverterApp />

    <!-- Description Section -->
    <header class="space-y-3">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--fg)]">
        Currency Converter &amp; Exchange Rate Calculator
      </h1>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
        Calculate live foreign currency exchange rates, compare world currencies, and convert foreign currency instantly with our free online currency converter and forex calculator.
      </p>
    </header>

    <!-- Related Financial & Conversion Tools -->
    <section class="mt-10 space-y-4">
      <div class="space-y-0.5">
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Related Tools</p>
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-[color:var(--fg)]">Explore More Financial &amp; Conversion Calculators</h2>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/tax-calculators/vat-calculator/" class="group rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
            <Icon name="finance" class="w-4 h-4" />
          </div>
          <h3 class="mt-2 text-xs font-bold text-[color:var(--fg)]">Global VAT / GST</h3>
          <p class="mt-0.5 text-[11px] text-[color:var(--muted)]">Calculate price before &amp; after consumption tax.</p>
        </a>
        <a href="/calculators/discount-calculator/" class="group rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
            <Icon name="math" class="w-4 h-4" />
          </div>
          <h3 class="mt-2 text-xs font-bold text-[color:var(--fg)]">Discount &amp; Sales Tax</h3>
          <p class="mt-0.5 text-[11px] text-[color:var(--muted)]">Calculate markdown savings and checkout total.</p>
        </a>
        <a href="/calculators/compound-interest-calculator/" class="group rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
            <Icon name="finance" class="w-4 h-4" />
          </div>
          <h3 class="mt-2 text-xs font-bold text-[color:var(--fg)]">Compound Interest</h3>
          <p class="mt-0.5 text-[11px] text-[color:var(--muted)]">Forecast long-term investment growth and returns.</p>
        </a>
        <a href="/tax-calculators/" class="group rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
            <Icon name="career" class="w-4 h-4" />
          </div>
          <h3 class="mt-2 text-xs font-bold text-[color:var(--fg)]">24-Country Tax Suite</h3>
          <p class="mt-0.5 text-[11px] text-[color:var(--muted)]">Official income tax and salary take-home calculators.</p>
        </a>
      </div>
    </section>
  </div>
</SiteLayout>
