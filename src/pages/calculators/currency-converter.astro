---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CurrencyConverterApp from '../../components/CurrencyConverterApp.astro';
import { withBasePath } from '../../utils/site';

const pageTitle = "Real-Time Currency Converter | Live Exchange Rates";
const pageDesc = "Convert 160+ world currencies with free, live real-time exchange rates. Instant conversions for USD, EUR, GBP, JPY, CAD, AUD, INR, and more with zero fees.";
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={withBasePath('/calculators/currency-converter/')}>
  <div class="mx-auto max-w-5xl space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-medium text-[color:var(--muted)]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--accent)]">Home</a>
      <span>/</span>
      <a href="/#calculators?category=Converters" class="hover:text-[color:var(--accent)]">Converters</a>
      <span>/</span>
      <span class="text-[color:var(--fg)] font-semibold">Currency Converter</span>
    </nav>

    <!-- Page Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--accent)]">
        <span>🌐 160+ Currencies • Free Real-Time API</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl lg:text-5xl">
        Real-Time Currency Converter
      </h1>
      <p class="max-w-3xl text-base leading-relaxed text-[color:var(--muted)] sm:text-lg">
        Get live foreign exchange rates, compare major world currencies, and calculate conversions instantly with 0% retail bank markup.
      </p>
    </header>

    <!-- Interactive Currency App -->
    <CurrencyConverterApp />

    <!-- Related Financial & Conversion Tools -->
    <section class="mt-12 space-y-6">
      <div class="space-y-1">
        <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--accent)]">Related Tools</p>
        <h2 class="text-2xl font-bold tracking-tight text-[color:var(--fg)]">Explore More Financial &amp; Conversion Calculators</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/tax-calculators/vat-calculator/" class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:-translate-y-0.5 hover:border-[color:var(--accent)] hover:shadow-md">
          <span class="text-2xl">🏷️</span>
          <h3 class="mt-2 text-sm font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)]">Global VAT / GST</h3>
          <p class="mt-1 text-xs text-[color:var(--muted)]">Calculate price before &amp; after consumption tax.</p>
        </a>
        <a href="/calculators/discount-calculator/" class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:-translate-y-0.5 hover:border-[color:var(--accent)] hover:shadow-md">
          <span class="text-2xl">🏷️</span>
          <h3 class="mt-2 text-sm font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)]">Discount &amp; Sales Tax</h3>
          <p class="mt-1 text-xs text-[color:var(--muted)]">Calculate markdown savings and final checkout total.</p>
        </a>
        <a href="/calculators/compound-interest-calculator/" class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:-translate-y-0.5 hover:border-[color:var(--accent)] hover:shadow-md">
          <span class="text-2xl">📈</span>
          <h3 class="mt-2 text-sm font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)]">Compound Interest</h3>
          <p class="mt-1 text-xs text-[color:var(--muted)]">Forecast long-term investment growth and returns.</p>
        </a>
        <a href="/tax-calculators/" class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:-translate-y-0.5 hover:border-[color:var(--accent)] hover:shadow-md">
          <span class="text-2xl">🏛️</span>
          <h3 class="mt-2 text-sm font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)]">24-Country Tax Suite</h3>
          <p class="mt-1 text-xs text-[color:var(--muted)]">Official income tax and salary take-home calculators.</p>
        </a>
      </div>
    </section>
  </div>
</SiteLayout>
