---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { siteName, withBasePath } from '../utils/site';
---

<SiteLayout title={`About · ${siteName}`} description="Learn about the design principles, zero-tracking privacy, and static architecture of Toolscastle.">
  <article class="mx-auto max-w-4xl space-y-8 py-4">
    <header class="space-y-3">
      <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--accent)]">About The Project</p>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--fg)]">
        Fast, Transparent, and Private Tools for Everyone.
      </h1>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
        {siteName} is a zero-backend, statically built collection of everyday calculators and career builders designed for speed, clarity, and uncompromising privacy.
      </p>
    </header>

    <section class="grid gap-6 sm:grid-cols-2">
      <div class="space-y-1.5 border-l-2 border-[color:var(--border)] pl-4">
        <h2 class="text-base font-bold text-[color:var(--fg)]">Instant Performance</h2>
        <p class="text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
          Pre-rendered static HTML and CSS. Calculations execute directly in browser memory without API delays or network lag.
        </p>
      </div>

      <div class="space-y-1.5 border-l-2 border-[color:var(--border)] pl-4">
        <h2 class="text-base font-bold text-[color:var(--fg)]">100% Client-Side Privacy</h2>
        <p class="text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
          Your numbers, financial records, and resume inputs never leave your device. We use zero tracking cookies and zero server logging.
        </p>
      </div>

      <div class="space-y-1.5 border-l-2 border-[color:var(--border)] pl-4">
        <h2 class="text-base font-bold text-[color:var(--fg)]">Clear &amp; Auditable Math</h2>
        <p class="text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
          Every tool is accompanied by an in-depth breakdown of the underlying equations, worked numerical examples, and verified official government rates.
        </p>
      </div>

      <div class="space-y-1.5 border-l-2 border-[color:var(--border)] pl-4">
        <h2 class="text-base font-bold text-[color:var(--fg)]">Universal Accessibility</h2>
        <p class="text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
          Engineered with responsive layouts, dark mode support, screen reader ARIA landmarks, and keyboard shortcuts for seamless operation on all devices.
        </p>
      </div>
    </section>

    <div class="flex justify-center pt-2">
      <a
        href={withBasePath('/#calculators')}
        class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--accent)] px-6 py-2.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90"
      >
        <span>Explore All Tools</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </article>
</SiteLayout>
