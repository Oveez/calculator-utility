---
import SiteHero from '../components/SiteHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { siteName, withBasePath } from '../utils/site';
---

<SiteLayout title={`About · ${siteName}`} description="Learn about the design principles, zero-tracking privacy, and static architecture of Toolscastle." heroCompact={true}>
  <SiteHero
    slot="hero"
    badge="About The Project"
    title="Fast, Transparent, and Private Tools for Everyone."
    description={`${siteName} is a zero-backend, statically built collection of everyday calculators and career builders designed for speed, clarity, and uncompromising privacy.`}
  />
  <article class="mx-auto max-w-4xl space-y-8 py-4">

    <section class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
          <Icon name="bolt" class="w-4 h-4" />
        </div>
        <h2 class="mt-3 text-base font-bold text-[color:var(--fg)]">Instant Performance</h2>
        <p class="mt-1 text-xs leading-relaxed text-[color:var(--muted)]">
          Pre-rendered static HTML and CSS. Calculations execute directly in browser memory without API delays or network lag.
        </p>
      </div>

      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
          <Icon name="shield" class="w-4 h-4" />
        </div>
        <h2 class="mt-3 text-base font-bold text-[color:var(--fg)]">100% Client-Side Privacy</h2>
        <p class="mt-1 text-xs leading-relaxed text-[color:var(--muted)]">
          Your numbers, financial records, and resume inputs never leave your device. We use zero tracking cookies and zero server logging.
        </p>
      </div>

      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
          <Icon name="math" class="w-4 h-4" />
        </div>
        <h2 class="mt-3 text-base font-bold text-[color:var(--fg)]">Clear &amp; Auditable Math</h2>
        <p class="mt-1 text-xs leading-relaxed text-[color:var(--muted)]">
          Every tool is accompanied by an in-depth breakdown of the underlying equations, worked numerical examples, and verified official government rates.
        </p>
      </div>

      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
          <Icon name="text" class="w-4 h-4" />
        </div>
        <h2 class="mt-3 text-base font-bold text-[color:var(--fg)]">Universal Accessibility</h2>
        <p class="mt-1 text-xs leading-relaxed text-[color:var(--muted)]">
          Engineered with responsive layouts, dark mode support, screen reader ARIA landmarks, and keyboard shortcuts for seamless operation on all devices.
        </p>
      </div>
    </section>

    <div class="flex justify-center pt-2">
      <a
        href={withBasePath('/#calculators')}
        class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--accent)] px-6 py-2.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90"
      >
        <span>Explore All Tools</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </article>
</SiteLayout>
