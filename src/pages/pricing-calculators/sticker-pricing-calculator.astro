---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Sticker Pricing Calculator | Vinyl Sticker & Decal Profit Margins · ${siteName}`;
const pageDesc = 'Calculate custom vinyl sticker production costs per unit, wholesale prices, Etsy/retail margins, and bulk tiered pricing (10, 25, 50, 100 units).';
const canonicalUrl = toAbsoluteUrl('/pricing-calculators/sticker-pricing-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Pricing Calculators', href: toAbsoluteUrl('/pricing-calculators/') },
  { label: 'Sticker Pricing Calculator' },
];

const faqs = [
  {
    question: 'How do you price handmade or manufacturer-printed stickers?',
    answer: 'Calculate unit production cost (printable vinyl paper + protective laminate + ink + cutter blade wear + packaging cello bag). Add your design/cutting labor time. A standard single sticker retails for $3.50 to $5.00 with wholesale pricing at 50% of retail ($1.75 to $2.50).',
  },
  {
    question: 'How should bulk discounts be structured for stickers?',
    answer: 'Bulk discount tiers typically offer 10% off for 10+ stickers, 20% off for 25+ stickers, 35% off for 50+ stickers, and 50% off for 100+ wholesale orders to reward larger order volume while keeping healthy profit margins.',
  },
  {
    question: 'What is a good profit margin for custom stickers?',
    answer: 'Because stickers are low-ticket items ($3–$5 retail), target a high gross margin of 75% to 85% on direct sales ($2.50 to $4.00 profit per sticker) and 50% on wholesale orders. This protects you against order minimums, transaction fees, and shipping costs.',
  },
];

const parameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'batchQty',
    name: 'Batch Production Quantity',
    description: 'Total number of die-cut or kiss-cut vinyl stickers produced in this printing run.',
    whyItMatters: 'Higher batch volumes achieve economies of scale, slashing your unit cost per sticker.',
    typicalRange: '25 – 1,000+ stickers',
    unit: 'Stickers',
  },
  {
    id: 'matCost',
    name: 'Total Materials Cost ($)',
    description: 'Cost of vinyl sticker sheets, thermal/cold laminate film, printer ink, and cutting mat/blade depreciation.',
    whyItMatters: 'Direct physical goods cost. Buying vinyl rolls in bulk significantly lowers this line item.',
    typicalRange: '$10 – $200+',
    unit: '$',
  },
  {
    id: 'packCost',
    name: 'Packaging & Sleeves ($)',
    description: 'Glassine or cello bags, branded backing cards, and rigid mailers.',
    whyItMatters: 'Essential for retail presentation and protecting stickers from bending during fulfillment.',
    typicalRange: '$2 – $40+',
    unit: '$',
  },
  {
    id: 'laborHrs',
    name: 'Production Labor (Hours)',
    description: 'Active hands-on time spent printing, laminating, plotter machine cutting, weeding, and packing.',
    whyItMatters: 'Makers often neglect labor time, turning profitable crafting into underpaid labor.',
    typicalRange: '0.5 – 5.0 hours',
    unit: 'Hours',
  },
  {
    id: 'hourlyWage',
    name: 'Artist / Maker Hourly Wage ($/hr)',
    description: 'The hourly wage you pay yourself for skilled design, machine operation, and quality control.',
    whyItMatters: 'Ensures your sticker craft business pays you fairly ($18–$30/hr).',
    typicalRange: '$15 – $45/hr',
    unit: '$/hr',
  },
  {
    id: 'unitCost',
    name: 'Unit Production Cost ($ / Sticker)',
    description: 'Total Batch Cost divided by Batch Quantity: (Materials + Packaging + Labor) ÷ Quantity.',
    whyItMatters: 'Your absolute break-even cost floor. Never sell a sticker below this price.',
    typicalRange: '$0.30 – $1.50 / sticker',
    unit: '$/sticker',
  },
  {
    id: 'retailMsrp',
    name: 'Suggested Retail Price (MSRP)',
    description: 'Standard retail price for a single sticker (industry benchmark $3.50 to $4.99).',
    whyItMatters: 'Anchors consumer perception and maximizes gross profit margins on direct sales.',
    typicalRange: '$3.00 – $6.00',
    unit: '$',
  },
  {
    id: 'batchProfit',
    name: 'Total Batch Net Profit ($)',
    description: 'Net profit generated across the entire batch if sold at suggested retail price.',
    whyItMatters: 'Measures total earnings generated for your studio time and creative investment.',
    typicalRange: '$50 – $2,500+',
    unit: '$',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Sticker Pricing Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Artist &amp; Vinyl Crafter Economics</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Sticker Pricing Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Calculate unit production costs, fair hourly design wages, retail selling prices, and bulk quantity tiers for in-house or outsourced custom sticker batches.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-sticker-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Production Batch Costs</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-xs">
              <label for="batch-qty" class="font-bold uppercase tracking-wider text-[color:var(--muted)]">Batch Quantity (Total Stickers)</label>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-[color:var(--muted)]">Presets:</span>
                <button type="button" class="cursor-pointer rounded bg-[color:var(--surface)] px-1.5 py-0.5 text-[10px] font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)]" data-preset="50">50</button>
                <button type="button" class="cursor-pointer rounded bg-[color:var(--surface)] px-1.5 py-0.5 text-[10px] font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)]" data-preset="100">100</button>
                <button type="button" class="cursor-pointer rounded bg-[color:var(--surface)] px-1.5 py-0.5 text-[10px] font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)]" data-preset="250">250</button>
                <button type="button" class="cursor-pointer rounded bg-[color:var(--surface)] px-1.5 py-0.5 text-[10px] font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)]" data-preset="500">500</button>
              </div>
            </div>
            <input id="batch-qty" type="number" min="1" step="1" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]" data-batch-qty placeholder="e.g. 100" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="mat-cost" class="block text-xs font-medium text-[color:var(--muted)]">Total Materials Cost ($)</label>
              <input id="mat-cost" type="number" min="0" step="0.5" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]" data-mat-cost placeholder="e.g. 32.00" />
              <p class="text-[10px] text-[color:var(--muted)] mt-0.5">Vinyl, laminate, ink, cutter wear</p>
            </div>
            <div>
              <label for="pack-sleeve" class="block text-xs font-medium text-[color:var(--muted)]">Packaging / Cello Bags ($)</label>
              <input id="pack-sleeve" type="number" min="0" step="0.5" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]" data-pack-cost placeholder="e.g. 8.00" />
              <p class="text-[10px] text-[color:var(--muted)] mt-0.5">Bags, backing cards, mailers</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label for="labor-hours" class="block text-xs font-medium text-[color:var(--muted)]">Production Labor (Hours)</label>
              <input id="labor-hours" type="number" min="0" step="0.25" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]" data-labor-hrs placeholder="e.g. 1.5" />
            </div>
            <div>
              <label for="hourly-wage" class="block text-xs font-medium text-[color:var(--muted)]">Your Hourly Wage ($/hr)</label>
              <input id="hourly-wage" type="number" min="0" step="1" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]" data-hourly-wage placeholder="e.g. 20" />
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Recommended Pricing</span>
              <button
                type="button"
                data-copy-summary-btn
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </button>
            </div>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center shadow-sm">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Suggested Retail Price (MSRP)</p>
              <p class="mt-1 text-4xl sm:text-5xl font-black tracking-tight text-cyan-600 dark:text-cyan-400" data-res-retail>
                $0.00
              </p>
              <p class="mt-2 text-xs font-bold text-[color:var(--muted)]" data-res-wholesale>
                Wholesale Price (50%): $0.00 / sticker
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Unit Production Cost:</span>
                <span class="font-bold text-[color:var(--fg)]" data-unit-cost>$0.00 / sticker</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Single Retail Margin:</span>
                <span class="font-bold text-cyan-600 dark:text-cyan-400" data-retail-margin>0.0% ($0.00 profit)</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="text-[color:var(--muted)]">Total Batch Net Profit (at MSRP):</span>
                <span class="font-black text-sm text-[color:var(--fg)]" data-batch-profit>$0.00</span>
              </div>
            </div>
          </div>

          <!-- Tiered Pricing Matrix -->
          <div class="space-y-2 pt-2 border-t border-[color:var(--border)]">
            <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Bulk Tier Recommendations</p>
            <div class="grid grid-cols-3 gap-2 text-center text-xs">
              <div class="p-2 rounded-xl bg-[color:var(--surface)] border border-[color:var(--border)] shadow-sm">
                <p class="text-[10px] text-[color:var(--muted)]">10+ Pack (-10%)</p>
                <p class="font-bold text-[color:var(--fg)] mt-0.5" data-tier-10>$0.00 ea</p>
                <p class="text-[9px] text-cyan-500 dark:text-cyan-400 font-medium" data-tier-10-profit>$0.00 profit</p>
              </div>
              <div class="p-2 rounded-xl bg-[color:var(--surface)] border border-[color:var(--border)] shadow-sm">
                <p class="text-[10px] text-[color:var(--muted)]">25+ Pack (-20%)</p>
                <p class="font-bold text-[color:var(--fg)] mt-0.5" data-tier-25>$0.00 ea</p>
                <p class="text-[9px] text-cyan-500 dark:text-cyan-400 font-medium" data-tier-25-profit>$0.00 profit</p>
              </div>
              <div class="p-2 rounded-xl bg-[color:var(--surface)] border border-[color:var(--border)] shadow-sm">
                <p class="text-[10px] text-[color:var(--muted)]">50+ Bulk (-35%)</p>
                <p class="font-bold text-[color:var(--fg)] mt-0.5" data-tier-50>$0.00 ea</p>
                <p class="text-[9px] text-cyan-500 dark:text-cyan-400 font-medium" data-tier-50-profit>$0.00 profit</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formula Reference Card -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-3">
      <h3 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Sticker Batch &amp; Tiered Pricing Formulas</span>
      </h3>
      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 space-y-1">
          <p class="font-bold text-[color:var(--fg)]">1. Total Batch &amp; Unit Cost</p>
          <p class="font-mono text-[color:var(--accent)]">C_batch = Materials + Packaging + (Labor × Wage)</p>
          <p class="font-mono text-[color:var(--accent)]">C_unit = C_batch ÷ Batch Quantity</p>
          <p class="text-[11px]">Precision calculation down to the exact penny per sticker.</p>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 space-y-1">
          <p class="font-bold text-[color:var(--fg)]">2. Retail MSRP &amp; Wholesale Pricing</p>
          <p class="font-mono text-[color:var(--accent)]">P_retail = max($3.50, C_unit × 4) rounded to .99</p>
          <p class="font-mono text-[color:var(--accent)]">P_wholesale = P_retail × 0.50</p>
          <p class="text-[11px]">Guarantees healthy 75%+ margins on retail and 50% on wholesale.</p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Vinyl Sticker Example -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-3">
      <h3 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Step-by-Step Worked Calculation Example</span>
      </h3>
      <div class="space-y-3 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        <p>
          Suppose you print and machine-cut a batch of <strong class="text-[color:var(--fg)]">100 die-cut vinyl stickers</strong>:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Printable vinyl + holographic laminate + ink: <strong>$32.00</strong></li>
          <li>Protective cello bags &amp; backing cards: <strong>$8.00</strong></li>
          <li>Labor time: <strong>1.5 hours</strong> at <strong>$20.00/hour</strong> = <strong>$30.00</strong></li>
        </ul>
        <ol class="list-decimal pl-5 space-y-2 pt-1">
          <li>
            <strong class="text-[color:var(--fg)]">Compute Unit Cost:</strong><br />
            Total Batch Cost = $32.00 + $8.00 + $30.00 = <strong class="text-[color:var(--fg)]">$70.00</strong><br />
            Unit Cost = $70.00 ÷ 100 = <strong class="text-[color:var(--fg)]">$0.70 per sticker</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Determine Retail &amp; Wholesale Pricing:</strong><br />
            Suggested Retail Price (MSRP) = <strong class="text-[color:var(--fg)]">$3.99 each</strong> ($3.29 profit per sticker, <strong class="text-cyan-500 dark:text-cyan-400 font-bold">82.5% gross margin</strong>).<br />
            Wholesale Price (50%) = <strong class="text-[color:var(--fg)]">$2.00 each</strong> ($1.30 profit per sticker, <strong class="text-cyan-500 dark:text-cyan-400 font-bold">65.0% margin</strong>).
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Batch Net Profit:</strong><br />
            Selling all 100 stickers at retail yields $3.99 × 100 = $399.00 revenue minus $70.00 batch cost = <strong class="text-cyan-500 dark:text-cyan-400 font-bold">$329.00 net profit</strong>.
          </li>
        </ol>
      </div>
    </section>

    <!-- Interactive Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-sticker-app]');
      if (!root) return;

      const inQty = root.querySelector('[data-batch-qty]');
      const inMat = root.querySelector('[data-mat-cost]');
      const inPack = root.querySelector('[data-pack-cost]');
      const inHrs = root.querySelector('[data-labor-hrs]');
      const inWage = root.querySelector('[data-hourly-wage]');
      const presets = Array.from(root.querySelectorAll('[data-preset]'));

      const outRetail = root.querySelector('[data-res-retail]');
      const outWholesale = root.querySelector('[data-res-wholesale]');
      const outUnitCost = root.querySelector('[data-unit-cost]');
      const outMargin = root.querySelector('[data-retail-margin]');
      const outBatchProfit = root.querySelector('[data-batch-profit]');

      const outT10 = root.querySelector('[data-tier-10]');
      const outT10Profit = root.querySelector('[data-tier-10-profit]');
      const outT25 = root.querySelector('[data-tier-25]');
      const outT25Profit = root.querySelector('[data-tier-25-profit]');
      const outT50 = root.querySelector('[data-tier-50]');
      const outT50Profit = root.querySelector('[data-tier-50-profit]');

      const resetBtn = root.querySelector('[data-reset-btn]');
      const copyBtn = root.querySelector('[data-copy-summary-btn]');

      function update() {
        const hasInput = inQty.value || inMat.value || inPack.value || inHrs.value || inWage.value;
        const qty = inQty.value ? Math.max(1, (inQty.value !== '' && !isNaN(parseInt(inQty.value, 10)) ? parseInt(inQty.value, 10) : 0)) : 1;
        const mat = inMat.value ? Math.max(0, (inMat.value !== '' && !isNaN(parseFloat(inMat.value)) ? parseFloat(inMat.value) : 0)) : 0;
        const pack = inPack.value ? Math.max(0, (inPack.value !== '' && !isNaN(parseFloat(inPack.value)) ? parseFloat(inPack.value) : 0)) : 0;
        const hrs = inHrs.value ? Math.max(0, (inHrs.value !== '' && !isNaN(parseFloat(inHrs.value)) ? parseFloat(inHrs.value) : 0)) : 0;
        const wage = inWage.value ? Math.max(0, (inWage.value !== '' && !isNaN(parseFloat(inWage.value)) ? parseFloat(inWage.value) : 0)) : 0;

        const totalLabor = hrs * wage;
        const totalBatchCost = mat + pack + totalLabor;

        if (!hasInput || totalBatchCost === 0) {
          if (outRetail) outRetail.textContent = '$0.00';
          if (outWholesale) outWholesale.textContent = 'Wholesale Price (50%): $0.00 / sticker';
          if (outUnitCost) outUnitCost.textContent = '$0.00 / sticker';
          if (outMargin) outMargin.textContent = '0.0% ($0.00 profit)';
          if (outBatchProfit) outBatchProfit.textContent = '$0.00';
          if (outT10) outT10.textContent = '$0.00 ea';
          if (outT10Profit) outT10Profit.textContent = '$0.00 profit';
          if (outT25) outT25.textContent = '$0.00 ea';
          if (outT25Profit) outT25Profit.textContent = '$0.00 profit';
          if (outT50) outT50.textContent = '$0.00 ea';
          if (outT50Profit) outT50Profit.textContent = '$0.00 profit';
          return;
        }

        const unitCost = totalBatchCost / qty;

        // Retail multiplier: minimum $3.50 or 4x unit cost (whichever higher)
        let retail = Math.max(3.50, unitCost * 4);
        retail = Math.ceil(retail * 10) / 10 - 0.01; // Round to .99
        if (retail < unitCost * 2) retail = unitCost * 3.5;

        const wholesale = retail * 0.50;
        const profit = retail - unitCost;
        const margin = retail > 0 ? (profit / retail) * 100 : 0;
        const batchNet = profit * qty;

        const p10 = retail * 0.90;
        const p25 = retail * 0.80;
        const p50 = retail * 0.65;

        if (outRetail) outRetail.textContent = `$${retail.toFixed(2)}`;
        if (outWholesale) outWholesale.textContent = `Wholesale Price (50%): $${wholesale.toFixed(2)} / sticker`;
        if (outUnitCost) outUnitCost.textContent = `$${unitCost.toFixed(2)} / sticker`;
        if (outMargin) outMargin.textContent = `${margin.toFixed(1)}% ($${profit.toFixed(2)} profit)`;
        if (outBatchProfit) outBatchProfit.textContent = `$${batchNet.toFixed(2)}`;

        if (outT10) outT10.textContent = `$${p10.toFixed(2)} ea`;
        if (outT10Profit) outT10Profit.textContent = `$${(p10 - unitCost).toFixed(2)} profit`;

        if (outT25) outT25.textContent = `$${p25.toFixed(2)} ea`;
        if (outT25Profit) outT25Profit.textContent = `$${(p25 - unitCost).toFixed(2)} profit`;

        if (outT50) outT50.textContent = `$${p50.toFixed(2)} ea`;
        if (outT50Profit) outT50Profit.textContent = `$${(p50 - unitCost).toFixed(2)} profit`;
      }

      inQty.addEventListener('input', update);
      inMat.addEventListener('input', update);
      inPack.addEventListener('input', update);
      inHrs.addEventListener('input', update);
      inWage.addEventListener('input', update);

      presets.forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-preset');
          if (val) {
            inQty.value = val;
            update();
          }
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inQty.value = '';
          inMat.value = '';
          inPack.value = '';
          inHrs.value = '';
          inWage.value = '';
          update();
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const qty = inQty.value;
          const mat = inMat.value;
          const pack = inPack.value;
          const hrs = inHrs.value;
          const wage = inWage.value;
          const unitCost = outUnitCost?.textContent || '';
          const retail = outRetail?.textContent || '';
          const wholesale = outWholesale?.textContent || '';
          const margin = outMargin?.textContent || '';
          const batchProfit = outBatchProfit?.textContent || '';

          const text = [
            `Sticker Batch Pricing Report`,
            `----------------------------------------`,
            `Batch Production Quantity:    ${qty} stickers`,
            `Raw Materials:                $${mat}`,
            `Packaging & Sleeves:          $${pack}`,
            `Production Labor:             ${hrs} hrs @ $${wage}/hr`,
            `----------------------------------------`,
            `Unit Production Cost:         ${unitCost}`,
            `Suggested Retail Price (MSRP): ${retail}`,
            `${wholesale}`,
            `Retail Profit Margin:         ${margin}`,
            `Total Batch Net Profit:       ${batchProfit}`,
          ].join('\n');

          navigator.clipboard.writeText(text).then(() => {
            const orig = copyBtn.textContent;
            copyBtn.textContent = '✓ Copied!';
            setTimeout(() => { copyBtn.textContent = orig; }, 2000);
          });
        });
      }

      update();
    })();
  </script>
</SiteLayout>
