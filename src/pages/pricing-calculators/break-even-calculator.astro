---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Break-Even Calculator for Products | Units, Revenue & Contribution Margin · ${siteName}`;
const pageDesc = 'Calculate exact break-even sales volume in units and dollars based on fixed monthly costs, unit selling price, variable production costs, and target profit goals.';
const canonicalUrl = toAbsoluteUrl('/pricing-calculators/break-even-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Pricing Calculators', href: toAbsoluteUrl('/pricing-calculators/') },
  { label: 'Product Break-Even Calculator' },
];

const faqs = [
  {
    question: 'How do you calculate break-even point in units and revenue?',
    answer: 'Break-Even Units = Total Fixed Costs ÷ (Selling Price Per Unit - Variable Cost Per Unit). Break-Even Revenue = Break-Even Units × Selling Price Per Unit. The difference (Selling Price - Variable Cost) is called the Contribution Margin.',
  },
  {
    question: 'What is Contribution Margin Ratio?',
    answer: 'Contribution Margin Ratio = (Contribution Margin ÷ Selling Price) × 100. It reveals what percentage of every dollar of sales goes toward paying down fixed overhead and generating profit.',
  },
  {
    question: 'How do you calculate sales needed to hit a target monthly profit?',
    answer: 'Target Sales Volume = (Total Fixed Costs + Target Profit) ÷ Unit Contribution Margin. For example, if your fixed costs are $3,500/mo, contribution margin is $27/unit, and your target profit is $2,000, you must sell ($3,500 + $2,000) ÷ $27 = 204 units ($9,180 revenue).',
  },
];

const parameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'fixedCosts',
    name: 'Total Monthly Fixed Costs ($)',
    description: 'Operating expenses that remain constant regardless of production volume (studio rent, insurance, software, base salaries, domain fees).',
    whyItMatters: 'Establishes the minimum monthly financial hurdle your business must recover before making any profit.',
    typicalRange: '$500 – $25,000+/mo',
    unit: '$',
  },
  {
    id: 'unitPrice',
    name: 'Unit Selling Price ($ / Unit)',
    description: 'The gross retail or wholesale price charged to the customer for one single unit.',
    whyItMatters: 'Higher prices increase your unit contribution margin, dramatically reducing the number of units needed to break even.',
    typicalRange: '$1.00 – $1,000+',
    unit: '$',
  },
  {
    id: 'varCost',
    name: 'Variable Cost Per Unit ($ / Unit)',
    description: 'Direct costs incurred only when producing or shipping one unit (raw materials, packaging, direct piece-rate labor, transaction fees).',
    whyItMatters: 'Every dollar saved on variable costs flows 100% into your unit contribution margin.',
    typicalRange: '$0.50 – $500+',
    unit: '$',
  },
  {
    id: 'targetProfit',
    name: 'Target Monthly Profit ($)',
    description: 'The net monthly income or return you want your business to generate beyond covering baseline overhead.',
    whyItMatters: 'Allows founders and makers to set realistic production and sales targets for sustainable business growth.',
    typicalRange: '$0 – $50,000+/mo',
    unit: '$',
  },
  {
    id: 'unitContrib',
    name: 'Unit Contribution Margin ($)',
    description: 'Selling Price minus Variable Cost ($P - VC$). The net cash generated by each sale that contributes to fixed costs.',
    whyItMatters: 'If this number is negative or tiny, your business loses money on every sale regardless of volume.',
    typicalRange: '$1.00 – $500+',
    unit: '$',
  },
  {
    id: 'contribRatio',
    name: 'Contribution Margin Ratio (CMR %)',
    description: 'Contribution Margin divided by Selling Price: (CM ÷ P) × 100%.',
    whyItMatters: 'Measures product efficiency and pricing power. High-margin businesses (60%+) need far fewer sales to cover overhead.',
    typicalRange: '20% – 85%',
    unit: '%',
  },
  {
    id: 'breakEvenUnits',
    name: 'Break-Even Sales Volume (Units)',
    description: 'Fixed Costs divided by Unit Contribution Margin. The exact number of units you must sell each month to achieve zero net loss.',
    whyItMatters: 'The essential operational threshold separating solvency from business insolvency.',
    typicalRange: '10 – 10,000+ units',
    unit: 'Units',
  },
  {
    id: 'breakEvenRev',
    name: 'Break-Even Monthly Revenue ($)',
    description: 'Break-Even Units multiplied by Unit Selling Price.',
    whyItMatters: 'Translates unit goals into total monthly cash flow required on your sales dashboard.',
    typicalRange: '$1,000 – $100,000+',
    unit: '$',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Product Break-Even Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Business Economics &amp; Cost-Volume-Profit Analysis</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Product Break-Even Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Determine how many units and monthly sales revenue you need to cover studio rent, equipment, and overhead before generating your first dollar of profit.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-breakeven-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Costs &amp; Target Parameters</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="fixed-costs" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Total Monthly Fixed Overhead ($)
            </label>
            <input
              id="fixed-costs"
              type="number"
              min="0"
              step="100"
            <input
              id="fixed-costs"
              type="number"
              min="0"
              step="100"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              data-fixed-costs placeholder="e.g. 3,500" />
            <p class="text-[10px] text-[color:var(--muted)]">Rent, software, insurance, base salaries, utilities, subscriptions</p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="unit-price" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Selling Price ($ / Unit)</label>
              <input id="unit-price" type="number" min="0.01" step="0.5" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]" data-unit-price placeholder="e.g. 45.00" />
            </div>
            <div>
              <label for="var-cost" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Variable Cost ($ / Unit)</label>
              <input id="var-cost" type="number" min="0" step="0.5" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]" data-var-cost placeholder="e.g. 18.00" />
            </div>
          </div>

          <div class="space-y-1.5 pt-1 border-t border-[color:var(--border)]/60">
            <div class="flex justify-between text-xs font-bold text-[color:var(--fg)]">
              <label for="target-profit">Target Monthly Profit ($)</label>
              <span class="text-[color:var(--muted)]">Optional</span>
            </div>
            <input
              id="target-profit"
              type="number"
              min="0"
              step="250"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              data-target-profit placeholder="e.g. 2,000" />
            <p class="text-[10px] text-[color:var(--muted)]">Desired net take-home profit after covering all fixed overhead</p>
          </div>
        </form>

        <!-- Right Side: Results Cards -->
        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Break-Even Analysis</span>
              <button
                type="button"
                data-copy-summary-btn
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
              >
                <Icon name="copy" class="w-3.5 h-3.5" />
                <span>Copy Summary</span>
              </button>
            </div>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center shadow-sm">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Break-Even Sales Volume</p>
              <p class="mt-1 text-4xl sm:text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-units>
                0 Units
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-rev>
                Break-Even Monthly Revenue: $0.00
              </p>
            </div>

            <!-- Target Profit Goal Card -->
            <div class="rounded-2xl border border-cyan-500/30 bg-cyan-500/5 p-4 text-xs space-y-1">
              <div class="flex justify-between items-center">
                <span class="font-bold text-cyan-600 dark:text-cyan-400">To Earn Target Profit:</span>
                <span class="font-black text-sm text-[color:var(--fg)]" data-target-units>0 Units</span>
              </div>
              <div class="flex justify-between text-[color:var(--muted)]">
                <span>Target Monthly Revenue:</span>
                <span class="font-bold" data-target-rev>$0.00</span>
              </div>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Unit Contribution Margin ($P - VC$):</span>
                <span class="font-bold text-cyan-600 dark:text-cyan-400" data-unit-contrib>$0.00 / unit</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Contribution Margin Ratio (CMR):</span>
                <span class="font-bold text-[color:var(--fg)]" data-contrib-ratio>0.0%</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="text-[color:var(--muted)]">Daily Break-Even Run-Rate (30d):</span>
                <span class="font-bold text-[color:var(--fg)]" data-daily-rate>0.0 units / day ($0.00/day)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Weekly Break-Even Run-Rate (4.3w):</span>
                <span class="font-bold text-[color:var(--fg)]" data-weekly-rate>0.0 units / week ($0.00/wk)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mathematical Formula Reference Card -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-3">
      <h3 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Cost-Volume-Profit (CVP) Mathematical Formulas</span>
      </h3>
      <div class="grid gap-4 sm:grid-cols-2 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 space-y-1">
          <p class="font-bold text-[color:var(--fg)]">1. Unit Contribution Margin &amp; Ratio</p>
          <p class="font-mono text-[color:var(--accent)]">CM = Selling Price - Variable Cost</p>
          <p class="font-mono text-[color:var(--accent)]">CMR = (CM ÷ Selling Price) × 100%</p>
          <p class="text-[11px]">The exact portion of each sale contributing to covering fixed costs.</p>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 space-y-1">
          <p class="font-bold text-[color:var(--fg)]">2. Break-Even Volume</p>
          <p class="font-mono text-[color:var(--accent)]">Break-Even Units (Q_BE) = Fixed Costs ÷ CM</p>
          <p class="font-mono text-[color:var(--accent)]">Break-Even Revenue (R_BE) = Q_BE × Selling Price</p>
          <p class="text-[11px]">Units required to cover all operating overhead with zero net loss.</p>
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 space-y-1 sm:col-span-2">
          <p class="font-bold text-[color:var(--fg)]">3. Target Profit Sales Volume</p>
          <p class="font-mono text-[color:var(--accent)]">Target Units = (Total Fixed Costs + Target Net Profit) ÷ CM</p>
          <p class="text-[11px]">Volume required to cover both fixed operational costs and your net profit goal.</p>
        </div>
      </div>
    </section>

    <!-- Step-by-Step Worked Business Example -->
    <section class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-3">
      <h3 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
        <Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" />
        <span>Step-by-Step Worked Calculation Example</span>
      </h3>
      <div class="space-y-3 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        <p>
          Suppose an e-commerce studio incurs <strong class="text-[color:var(--fg)]">$3,500.00/month</strong> in fixed overhead (studio rent, software, insurance). They sell a custom product for <strong class="text-[color:var(--fg)]">$45.00</strong> with a variable production and packaging cost of <strong class="text-[color:var(--fg)]">$18.00/unit</strong>:
        </p>
        <ol class="list-decimal pl-5 space-y-2">
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Unit Contribution Margin:</strong><br />
            Contribution Margin = $45.00 - $18.00 = <strong class="text-[color:var(--fg)]">$27.00 per unit</strong><br />
            Contribution Margin Ratio = ($27.00 ÷ $45.00) × 100% = <strong class="text-[color:var(--fg)]">60.0%</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Break-Even Volume:</strong><br />
            Break-Even Units = $3,500.00 ÷ $27.00 = 129.63 &rarr; <strong class="text-cyan-500 dark:text-cyan-400 font-bold">130 units/month</strong> (or 4.3 units/day).<br />
            Break-Even Revenue = 130 × $45.00 = <strong class="text-cyan-500 dark:text-cyan-400 font-bold">$5,850.00 monthly revenue</strong>.
          </li>
          <li>
            <strong class="text-[color:var(--fg)]">Calculate Volume for $2,000.00 Target Monthly Profit:</strong><br />
            Target Units = ($3,500.00 + $2,000.00) ÷ $27.00 = $5,500.00 ÷ $27.00 = 203.7 &rarr; <strong class="text-cyan-500 dark:text-cyan-400 font-bold">204 units</strong> ($9,180.00 monthly revenue).
          </li>
        </ol>
      </div>
    </section>

    <!-- Interactive Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-breakeven-app]');
      if (!root) return;

      const inFixed = root.querySelector('[data-fixed-costs]');
      const inPrice = root.querySelector('[data-unit-price]');
      const inVar = root.querySelector('[data-var-cost]');
      const inTarget = root.querySelector('[data-target-profit]');
      const outUnits = root.querySelector('[data-res-units]');
      const outRev = root.querySelector('[data-res-rev]');
      const outTargetUnits = root.querySelector('[data-target-units]');
      const outTargetRev = root.querySelector('[data-target-rev]');
      const outContrib = root.querySelector('[data-unit-contrib]');
      const outRatio = root.querySelector('[data-contrib-ratio]');
      const outDaily = root.querySelector('[data-daily-rate]');
      const outWeekly = root.querySelector('[data-weekly-rate]');
      const resetBtn = root.querySelector('[data-reset-btn]');
      const copyBtn = root.querySelector('[data-copy-summary-btn]');

      function update() {
        const fixed = inFixed.value ? Math.max(0, (inFixed.value !== '' && !isNaN(parseFloat(inFixed.value)) ? parseFloat(inFixed.value) : 0)) : 0;
        const price = inPrice.value ? Math.max(0, (inPrice.value !== '' && !isNaN(parseFloat(inPrice.value)) ? parseFloat(inPrice.value) : 0)) : 0;
        const varCost = inVar.value ? Math.max(0, (inVar.value !== '' && !isNaN(parseFloat(inVar.value)) ? parseFloat(inVar.value) : 0)) : 0;
        const target = inTarget.value ? Math.max(0, (inTarget.value !== '' && !isNaN(parseFloat(inTarget.value)) ? parseFloat(inTarget.value) : 0)) : 0;

        const contrib = price > varCost ? (price - varCost) : 0;
        const ratio = price > 0 && contrib > 0 ? (contrib / price) * 100 : 0;

        let units = 0;
        let rev = 0;
        let targetUnits = 0;
        let targetRev = 0;

        if (contrib > 0 && (fixed > 0 || target > 0)) {
          units = Math.ceil(fixed / contrib);
          rev = units * price;
          targetUnits = Math.ceil((fixed + target) / contrib);
          targetRev = targetUnits * price;
        }

        if (outUnits) outUnits.textContent = `${units.toLocaleString()} Units`;
        if (outRev) outRev.textContent = `Break-Even Monthly Revenue: $${rev.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (outTargetUnits) outTargetUnits.textContent = `${targetUnits.toLocaleString()} Units`;
        if (outTargetRev) outTargetRev.textContent = `$${targetRev.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (outContrib) outContrib.textContent = `$${contrib.toFixed(2)} / unit`;
        if (outRatio) outRatio.textContent = `${ratio.toFixed(1)}%`;

        const dailyUnits = (units / 30).toFixed(1);
        const dailyRev = (rev / 30).toFixed(2);
        const weeklyUnits = (units / 4.33).toFixed(1);
        const weeklyRev = (rev / 4.33).toFixed(2);

        if (outDaily) outDaily.textContent = `${dailyUnits} units / day ($${dailyRev}/day)`;
        if (outWeekly) outWeekly.textContent = `${weeklyUnits} units / week ($${weeklyRev}/wk)`;
      }

      inFixed.addEventListener('input', update);
      inPrice.addEventListener('input', update);
      inVar.addEventListener('input', update);
      inTarget.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inFixed.value = '';
          inPrice.value = '';
          inVar.value = '';
          inTarget.value = '';
          update();
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const fixed = inFixed.value;
          const price = inPrice.value;
          const varCost = inVar.value;
          const target = inTarget.value;
          const units = outUnits?.textContent || '';
          const rev = outRev?.textContent || '';
          const targetUnits = outTargetUnits?.textContent || '';
          const targetRev = outTargetRev?.textContent || '';
          const contrib = outContrib?.textContent || '';
          const ratio = outRatio?.textContent || '';

          const text = [
            `Product Break-Even & CVP Analysis Summary`,
            `----------------------------------------`,
            `Total Monthly Fixed Costs:    $${fixed}`,
            `Unit Selling Price:           $${price}`,
            `Unit Variable Cost:           $${varCost}`,
            `Unit Contribution Margin:     ${contrib}`,
            `Contribution Margin Ratio:    ${ratio}`,
            `----------------------------------------`,
            `Break-Even Volume:            ${units}`,
            `${rev}`,
            `----------------------------------------`,
            `Target Monthly Profit:        $${target}`,
            `Required Sales for Target:    ${targetUnits} (${targetRev})`,
          ].join('\n');

          navigator.clipboard.writeText(text).then(() => {
            const orig = copyBtn.textContent;
            copyBtn.textContent = '✓ Copied!';
            setTimeout(() => { copyBtn.textContent = orig; }, 2000);
          });
        });
      }

      update();
    })();
  </script>
</SiteLayout>
