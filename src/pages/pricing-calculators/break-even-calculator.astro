---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Break-Even Calculator for Products | Units, Revenue & Contribution Margin · ${siteName}`;
const pageDesc = 'Calculate exact break-even sales volume in units and dollars based on fixed monthly costs, unit selling price, and variable production costs.';
const canonicalUrl = toAbsoluteUrl('/pricing-calculators/break-even-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Pricing Calculators', href: toAbsoluteUrl('/pricing-calculators/') },
  { label: 'Product Break-Even Calculator' },
];

const faqs = [
  {
    question: 'How do you calculate break-even point in units and revenue?',
    answer: 'Break-Even Units = Total Fixed Costs ÷ (Selling Price Per Unit - Variable Cost Per Unit). Break-Even Revenue = Break-Even Units × Selling Price Per Unit. The difference (Selling Price - Variable Cost) is called the Contribution Margin.',
  },
  {
    question: 'What is Contribution Margin Ratio?',
    answer: 'Contribution Margin Ratio = (Contribution Margin ÷ Selling Price) × 100. It reveals what percentage of every dollar of sales goes toward paying down fixed overhead and generating profit.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Product Break-Even Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Business Economics &amp; Cost Volume Profit</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Product Break-Even Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Determine how many units you need to sell each month to cover rent, salaries, and overhead before generating your first dollar of profit.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-breakeven-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Costs &amp; Pricing</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="fixed-costs" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Total Monthly Fixed Costs ($)
            </label>
            <input
              id="fixed-costs"
              type="number"
              min="0"
              step="100"
              value="3500"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none"
              data-fixed-costs
            />
            <p class="text-[10px] text-[color:var(--muted)]">Rent, software, insurance, base salaries, subscriptions</p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="unit-price" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Selling Price ($ / Unit)</label>
              <input id="unit-price" type="number" min="0.01" step="0.5" value="45.00" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-unit-price />
            </div>
            <div>
              <label for="var-cost" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Variable Cost ($ / Unit)</label>
              <input id="var-cost" type="number" min="0" step="0.5" value="18.00" class="mt-1 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-var-cost />
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6 sm:p-8">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Break-Even Analysis</span>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Required Sales Volume</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-units>
                130 Units
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-rev>
                Break-Even Monthly Revenue: $5,850.00
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Unit Contribution Margin:</span>
                <span class="font-bold text-green-600" data-unit-contrib>$27.00 / unit</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Contribution Margin Ratio:</span>
                <span class="font-bold text-[color:var(--fg)]" data-contrib-ratio>60.0%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-breakeven-app]');
      if (!root) return;

      const inFixed = root.querySelector('[data-fixed-costs]');
      const inPrice = root.querySelector('[data-unit-price]');
      const inVar = root.querySelector('[data-var-cost]');
      const outUnits = root.querySelector('[data-res-units]');
      const outRev = root.querySelector('[data-res-rev]');
      const outContrib = root.querySelector('[data-unit-contrib]');
      const outRatio = root.querySelector('[data-contrib-ratio]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      function update() {
        const fixed = Math.max(0, parseFloat(inFixed.value || '0'));
        const price = Math.max(0.01, parseFloat(inPrice.value || '1'));
        const varCost = Math.max(0, parseFloat(inVar.value || '0'));

        const contrib = price - varCost;
        const ratio = price > 0 ? (contrib / price) * 100 : 0;

        let units = 0;
        let rev = 0;
        if (contrib > 0) {
          units = Math.ceil(fixed / contrib);
          rev = units * price;
        }

        if (outUnits) outUnits.textContent = `${units.toLocaleString()} Units`;
        if (outRev) outRev.textContent = `Break-Even Monthly Revenue: $${rev.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (outContrib) outContrib.textContent = `$${contrib.toFixed(2)} / unit`;
        if (outRatio) outRatio.textContent = `${ratio.toFixed(1)}%`;
      }

      inFixed.addEventListener('input', update);
      inPrice.addEventListener('input', update);
      inVar.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inFixed.value = '3500';
          inPrice.value = '45.00';
          inVar.value = '18.00';
          update();
        });
      }

      update();
    })();
  </script>
</SiteLayout>
