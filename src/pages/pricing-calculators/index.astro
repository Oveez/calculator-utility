---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHero from '../../components/SiteHero.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Handmade & Product Pricing Calculators | Stickers, Crafts & Break-Even · ${siteName}`;
const pageDesc = 'Free product pricing calculators for makers, artists, and handmade crafters. Calculate vinyl sticker batch pricing, craft wholesale/retail markups, and product break-even volume.';
const canonicalUrl = toAbsoluteUrl('/pricing-calculators/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Pricing Calculators' },
];

const pricingCalculators = [
  {
    slug: 'sticker-pricing-calculator',
    title: 'Sticker Pricing Calculator',
    badge: 'Artists & Crafters',
    metaDescription: 'Calculate unit production costs, wholesale price, retail margins, and bulk tiered pricing for custom vinyl sticker and decal batches.',
    href: withBasePath('/pricing-calculators/sticker-pricing-calculator/'),
    icon: 'career',
  },
  {
    slug: 'handmade-product-pricing-calculator',
    title: 'Handmade Product Pricing Calculator',
    badge: 'Craft Business',
    metaDescription: 'Calculate profitable wholesale (2x) and retail (4x) prices for handmade candles, jewelry, crochet, soap, and custom artisan goods.',
    href: withBasePath('/pricing-calculators/handmade-product-pricing-calculator/'),
    icon: 'finance',
  },
  {
    slug: 'break-even-calculator',
    title: 'Product Break-Even Calculator',
    badge: 'Business Finance',
    metaDescription: 'Determine the exact number of units and sales revenue required to cover fixed overhead expenses and achieve business profitability.',
    href: withBasePath('/pricing-calculators/break-even-calculator/'),
    icon: 'math',
  },
];

const schemaFaq = [
  {
    question: 'What is the standard formula for pricing handmade goods?',
    answer: 'The industry-standard craft pricing formula is: Total Cost = Materials + (Labor Hours × Hourly Wage) + Studio Overhead + Packaging. Wholesale Price = Total Cost × 2. Suggested Retail Price (MSRP) = Wholesale Price × 2 (or Total Cost × 4).',
  },
  {
    question: 'How is product break-even calculated?',
    answer: 'Break-even quantity is calculated as: Break-Even Units = Total Monthly Fixed Costs ÷ (Selling Price Per Unit - Variable Cost Per Unit). The denominator is known as the unit contribution margin.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl} heroCompact={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <SiteHero
    slot="hero"
    breadcrumbs={breadcrumbItems}
    badge="Handmade Crafters &amp; Product Pricing Suite"
    title="Product &amp; Craft Pricing Calculators"
    description="A financial suite designed for artists, sticker makers, Etsy sellers, and craft businesses. Calculate unit production costs, pay yourself a fair hourly wage, and price your handmade products for sustainable retail and wholesale profit."
  />

  <article class="space-y-10 py-2">
    <!-- Calculators Grid -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Pricing Engines</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">3 Specialized Pricing Tools</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          3 Calculators
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {pricingCalculators.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
            data-calculator-card
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon slug={tool.slug} category="Pricing & Commerce" size="md" />
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2.5 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center justify-between pt-2.5 border-t border-[color:var(--border)]/60">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                <span>Open Calculator</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
              </span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--muted)] group-hover:text-[color:var(--fg)] transition-colors">Instant</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
