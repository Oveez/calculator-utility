---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../utils/site';

const pageTitle = `Disclaimer · ${siteName}`;
const pageDesc = `General informational, financial, medical, and career tool disclaimers for ${siteName}.`;
const canonicalUrl = toAbsoluteUrl('/disclaimer/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Disclaimer' },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <article class="mx-auto max-w-3xl space-y-8 py-4">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-medium text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--accent)]">Legal &amp; Compliance</p>
      <h1 class="text-3xl font-bold tracking-tight text-[color:var(--fg)] sm:text-4xl">Website Disclaimer</h1>
      <p class="text-xs text-[color:var(--muted)]">Last updated: August 2026</p>
    </header>

    <div class="space-y-6 text-sm leading-relaxed text-[color:var(--muted)]">
      
      <!-- 1. General Disclaimer -->
      <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 space-y-3 shadow-sm">
        <h2 class="text-lg font-bold text-[color:var(--fg)]">1. General Informational Use Only</h2>
        <p>
          All information, interactive calculation tools, converters, guides, and resume builders provided on <strong>{siteName}</strong> are published in good faith and for general educational, personal estimation, and informational purposes only. {siteName} makes no warranties about the completeness, reliability, or absolute accuracy of this information. Any action you take upon the information you find on this website is strictly at your own risk.
        </p>
      </section>

      <!-- 2. Financial & Tax Disclaimer -->
      <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 space-y-3 shadow-sm">
        <h2 class="text-lg font-bold text-[color:var(--fg)]">2. Financial, Mortgage &amp; Tax Calculation Disclaimer</h2>
        <p>
          Calculators including mortgage repayment estimators, progressive income tax calculators across 24 national jurisdictions, currency converters, compound interest models, and VAT calculators are mathematical models based on publicly available formulas and standard tax brackets.
        </p>
        <p>
          These tools do <strong>not</strong> constitute certified financial advice, legal counsel, or professional tax accounting. Tax laws, statutory deductions, local allowances, and interest rates vary based on individual circumstances and evolve over time. Always consult a licensed CPA, chartered tax advisor, or certified financial planner before making financial commitments.
        </p>
      </section>

      <!-- 3. Health & Medical Disclaimer -->
      <section class="rounded-3xl border border-amber-500/20 bg-amber-500/5 p-6 space-y-3">
        <h2 class="text-lg font-bold text-amber-900 dark:text-amber-300">3. Health, Fitness &amp; Medical Disclaimer (BMI &amp; Nutrition)</h2>
        <p>
          Health tools such as the <strong>Body Mass Index (BMI) Calculator</strong>, <strong>Daily Calorie Calculator</strong>, and <strong>Water Intake Calculator</strong> are designed strictly as general population screening estimates based on formulas published by the World Health Organization (WHO) and Centers for Disease Control and Prevention (CDC).
        </p>
        <p>
          <strong>These calculations are NOT medical diagnoses, clinical evaluations, or substitutes for professional healthcare advice.</strong> BMI does not measure body fat directly and does not account for muscle mass, bone density, age, pregnancy, or individual metabolic health. Always seek the advice of a qualified physician, registered dietitian, or healthcare provider for personalized medical evaluation.
        </p>
      </section>

      <!-- 4. Career Tools & Resume Disclaimer -->
      <section class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 space-y-3 shadow-sm">
        <h2 class="text-lg font-bold text-[color:var(--fg)]">4. Career Tools &amp; Resume Builder Disclaimer</h2>
        <p>
          The <strong>CV Maker / Resume Builder</strong> and career guides provide formatting frameworks and ATS best-practice recommendations. {siteName} does not guarantee employment, interview callbacks, hiring outcomes, or specific salary offers resulting from resumes created with our tool. Hiring decisions are solely at the discretion of prospective employers.
        </p>
      </section>

      <!-- 5. External Links Disclaimer -->
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-[color:var(--fg)]">5. External Links &amp; Third-Party Services</h2>
        <p>
          From our website, you may visit other websites via hyperlinks (e.g. GitHub, official government tax authorities, CDC resources). While we strive to provide only quality links to useful and ethical websites, we have no control over the content and nature of these external sites.
        </p>
      </section>

      <!-- 6. Contact -->
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-[color:var(--fg)]">6. Contact Us</h2>
        <p>
          If you require any more information or have any questions about our site's disclaimer, please feel free to contact us via our <a href={withBasePath('/contact/')} class="text-[color:var(--accent)] underline">Contact Page</a>.
        </p>
      </section>

      <div class="pt-4">
        <a href={withBasePath('/')} class="text-xs font-semibold text-[color:var(--accent)] hover:underline">
          ← Back to Homepage
        </a>
      </div>
    </div>
  </article>
</SiteLayout>
