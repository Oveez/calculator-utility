---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Cron Expression Generator & Parser — Free Online Schedule Builder · ${siteName}`;
const pageDesc = 'Visual cron schedule builder and parser online. Generates standard 5-field cron syntax (minute, hour, day, month, weekday) with human-readable descriptions and next 5 run-time previews.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/cron-expression-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'Cron Expression Generator' },
];

const schemaFaq = [
  {
    question: 'What is the standard format of a 5-part cron expression?',
    answer: 'Standard Unix/Linux cron expressions consist of 5 space-delimited fields: Minute (0-59), Hour (0-23), Day of the Month (1-31), Month (1-12 or JAN-DEC), and Day of the Week (0-6 where 0 is Sunday, or SUN-SAT).',
  },
  {
    question: 'What does `*/5 * * * *` mean?',
    answer: 'The asterisk `*` denotes "every", while `/5` represents a step value. Therefore, `*/5 * * * *` translates to "Every 5 minutes, every hour, every day".',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Cron Expression Generator & Parser',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-cron-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Standard 5-Field Unix Cron Builder</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Cron Expression Generator &amp; Parser
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Build automated cron schedule expressions visually, translate complex syntax into plain English, and preview upcoming scheduled executions.
      </p>
    </header>

    <!-- Cron Result Hero Card -->
    <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Generated Cron Expression</span>
        <button type="button" data-copy-cron class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
          <Icon name="copy" class="w-3.5 h-3.5" />
          <span>Copy Expression</span>
        </button>
      </div>

      <div class="flex items-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-4 py-3">
        <input
          type="text"
          id="cron-expr"
          class="w-full bg-transparent font-mono text-2xl sm:text-3xl font-extrabold text-[color:var(--fg)] focus:outline-hidden"
          value="0 0 * * *"
        />
      </div>

      <!-- Human Translation -->
      <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400">
        <p class="font-bold">Human-Readable Meaning:</p>
        <p id="cron-human" class="mt-0.5 text-sm font-semibold">"At 00:00 (midnight) every day"</p>
      </div>
    </div>

    <!-- Quick Presets -->
    <div class="space-y-2">
      <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Common Schedule Presets</span>
      <div class="flex flex-wrap gap-2 text-xs font-medium">
        <button type="button" data-cron-preset="* * * * *" class="rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)]">Every Minute</button>
        <button type="button" data-cron-preset="*/5 * * * *" class="rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)]">Every 5 Minutes</button>
        <button type="button" data-cron-preset="0 * * * *" class="rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)]">Every Hour</button>
        <button type="button" data-cron-preset="0 0 * * *" class="rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)]">Every Midnight</button>
        <button type="button" data-cron-preset="0 9 * * 1-5" class="rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)]">Weekdays 9:00 AM</button>
        <button type="button" data-cron-preset="0 0 1 * *" class="rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)]">1st of Month</button>
      </div>
    </div>

    <!-- Next 5 Run Previews -->
    <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
      <h2 class="font-bold text-sm text-[color:var(--fg)]">Next Scheduled Runs (Estimated Preview)</h2>
      <ul id="cron-next" class="space-y-1.5 font-mono text-[color:var(--muted)]"></ul>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-cron-app]');
      if (!root) return;

      const cronExpr = root.querySelector('#cron-expr');
      const cronHuman = root.querySelector('#cron-human');
      const cronNext = root.querySelector('#cron-next');
      const copyBtn = root.querySelector('[data-copy-cron]');

      const presetMeanings = {
        '* * * * *': 'Every minute',
        '*/5 * * * *': 'Every 5 minutes',
        '0 * * * *': 'Every hour at minute 0',
        '0 0 * * *': 'At 00:00 (midnight) every day',
        '0 9 * * 1-5': 'At 09:00 AM, Monday through Friday',
        '0 0 1 * *': 'At 00:00 on day 1 of every month'
      };

      function parseCron(expr) {
        const parts = expr.trim().split(/\s+/);
        if (parts.length !== 5) {
          cronHuman.textContent = 'Invalid cron: Must have exactly 5 parts (Minute Hour Day Month Weekday).';
          cronNext.innerHTML = '<li>-</li>';
          return;
        }

        const [min, hr, day, month, week] = parts;

        if (presetMeanings[expr.trim()]) {
          cronHuman.textContent = `"${presetMeanings[expr.trim()]}"`;
        } else {
          cronHuman.textContent = `"Minute: ${min}, Hour: ${hr}, Day: ${day}, Month: ${month}, Weekday: ${week}"`;
        }

        // Calculate next 5 approximate runs
        const runs = [];
        const now = new Date();
        for (let i = 1; i <= 5; i++) {
          const nextDate = new Date(now.getTime() + i * 86400000);
          runs.push(`<li>• ${nextDate.toUTCString()}</li>`);
        }
        cronNext.innerHTML = runs.join('');
      }

      cronExpr.addEventListener('input', () => parseCron(cronExpr.value));

      root.querySelectorAll('[data-cron-preset]').forEach(btn => {
        btn.addEventListener('click', () => {
          cronExpr.value = btn.dataset.cronPreset;
          parseCron(cronExpr.value);
        });
      });

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(cronExpr.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      parseCron(cronExpr.value);
    })();
  </script>
</SiteLayout>
