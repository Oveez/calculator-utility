---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JSON to YAML Converter — Online Config Generator · ${siteName}`;
const pageDesc = 'Convert JSON configurations into clean, human-readable YAML for Docker, Kubernetes, CI/CD, and Ansible. Features custom indentation, key sorting, and live telemetry.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/json-to-yaml/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JSON to YAML' },
];

const schemaFaq = [
  {
    question: 'Why convert JSON into YAML for DevOps and cloud configs?',
    answer: 'YAML (YAML Ain\'t Markup Language) provides a much cleaner, human-readable syntax than JSON by eliminating curly braces, square brackets, and quotation marks, utilizing Python-style semantic whitespace. It is the de facto standard for Kubernetes manifests, Docker Compose, GitHub Actions, and Ansible playbooks.',
  },
  {
    question: 'How are data types (strings, booleans, arrays) mapped to YAML?',
    answer: 'Booleans (true/false) and numbers are mapped directly. Arrays are converted to hyphen-bulleted lists (`- item`), and object dictionaries are converted into indented key-value pairs (`key: value`). Strings containing reserved characters or looking like booleans (e.g. `"true"`) are automatically enclosed in quotes.',
  },
  {
    question: 'Does this tool process files securely on the client side?',
    answer: 'Yes. 100% of the conversion logic runs directly in your browser using local JavaScript. No JSON payloads or configuration credentials are ever transmitted to any remote server.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JSON to YAML Converter',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-json-yaml-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Kubernetes &amp; Docker Ready &bull; Semantic Indentation</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JSON to YAML Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert JSON payloads into clean, idiomatic YAML configurations. Tailor indentation spacing (2 or 4 spaces), sort dictionary keys recursively, and download `.yaml` files instantly.
      </p>
    </header>

    <!-- Telemetry Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">JSON Size</p>
        <p id="stat-json-bytes" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">0 B</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">YAML Size</p>
        <p id="stat-yaml-bytes" class="mt-1 font-mono text-base font-bold text-cyan-500 dark:text-cyan-400">0 B</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Line Count</p>
        <p id="stat-lines" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">0 lines</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Size Delta</p>
        <p id="stat-delta" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">0%</p>
      </div>
    </div>

    <!-- Main Workspace -->
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Input Column -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="json-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
            JSON Input
          </label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>

        <textarea
          id="json-in"
          rows="16"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder='{"version": "3.8", "services": {"web": {"image": "nginx:alpine", "ports": ["80:80"]}}}'
        ></textarea>

        <!-- Formatting Options -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-3 text-xs">
          <p class="font-bold uppercase tracking-wider text-[color:var(--muted)] text-[10px]">YAML Formatting Options</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="flex items-center gap-2">
              <label for="indent-spaces" class="font-medium text-[color:var(--muted)]">Indentation:</label>
              <select id="indent-spaces" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 text-xs text-[color:var(--fg)]">
                <option value="2">2 Spaces (Standard)</option>
                <option value="4">4 Spaces (K8s)</option>
              </select>
            </div>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="sort-keys-check" class="rounded accent-[color:var(--fg)]" />
              <span>Sort Object Keys A-Z</span>
            </label>
          </div>

          <button
            type="button"
            data-convert-btn
            class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
          >
            Convert JSON to YAML
          </button>
        </div>
      </div>

      <!-- Output Column -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">YAML Output</span>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">
              Download .yaml
            </button>
          </div>
        </div>

        <textarea
          id="yaml-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Formatted YAML will appear here..."
        ></textarea>

        <div id="yaml-err" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-xs text-red-600 dark:text-red-400 font-mono"></div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="JSON to YAML Technical Parameters & Conversion Rules"
      description="Specifications covering YAML 1.2 scalar mapping, array serialization, whitespace indentation rules, and reserved token escaping."
      parameters={[
        {
          name: "Indentation Spacing",
          type: "Integer (2 or 4)",
          defaultValue: "2 Spaces",
          description: "YAML uses semantic whitespace indentation to represent object hierarchy. 2 spaces is standard across Docker and GitHub Actions, while 4 spaces is common in Python/Ansible.",
        },
        {
          name: "Alphabetical Key Sorting",
          type: "Boolean",
          defaultValue: "false",
          description: "Recursively sorts object keys alphabetically (A-Z) to maintain clean Git diffs across infrastructure commits.",
        },
        {
          name: "Scalar Value Quoting",
          type: "Automatic",
          defaultValue: "Smart",
          description: "Automatically quotes strings that contain reserved symbols (`:`, `#`, `[`, `]`, `{`, `}`, `*`, `&`) or match reserved words (true, false, null, yes, no).",
        },
      ]}
      workedExample={{
        title: "Converting a Microservice Container Specification",
        description: "Transform a JSON payload specifying a web container configuration into a Kubernetes Pod definition in YAML format.",
        formula: "JSON.parse(spec) -> Recursive YAML AST -> String format",
        steps: [
          {
            step: "Input JSON Object",
            calculation: "{\"name\": \"web-server\", \"ports\": [80, 443], \"env\": {\"LOG_LEVEL\": \"debug\"}}",
            result: "Parsed 3 properties",
          },
          {
            step: "Format Root Scalars",
            calculation: "Render top-level string: 'name: web-server'",
            result: "Scalar written",
          },
          {
            step: "Format Array Elements",
            calculation: "Render 'ports:' followed by indented hyphen lines '- 80' and '- 443'",
            result: "Array written",
          },
          {
            step: "Format Nested Dictionary",
            calculation: "Render 'env:' followed by indented '  LOG_LEVEL: debug'",
            result: "Complete valid YAML document produced",
          },
        ],
      }}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">&#9660;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-json-yaml-app]');
      if (!root) return;

      const jsonIn = root.querySelector('#json-in');
      const yamlOut = root.querySelector('#yaml-out');
      const indentSelect = root.querySelector('#indent-spaces');
      const sortKeysCheck = root.querySelector('#sort-keys-check');
      const convertBtn = root.querySelector('[data-convert-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');
      const errBox = root.querySelector('#yaml-err');

      const statJsonBytes = root.querySelector('#stat-json-bytes');
      const statYamlBytes = root.querySelector('#stat-yaml-bytes');
      const statLines = root.querySelector('#stat-lines');
      const statDelta = root.querySelector('#stat-delta');

      function formatBytes(bytes) {
        if (bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
      }

      function formatScalar(val) {
        if (val === null) return 'null';
        if (typeof val === 'boolean') return val ? 'true' : 'false';
        if (typeof val === 'number') return String(val);

        const str = String(val);
        // Special keywords in YAML that need quoting if represented as strings
        const reservedWords = ['true', 'false', 'null', 'yes', 'no', 'on', 'off', 'y', 'n'];
        if (reservedWords.includes(str.toLowerCase())) {
          return `"${str}"`;
        }
        // Characters that trigger quoting in YAML
        if (str.includes(': ') || str.endsWith(':') || str.includes('#') || str.startsWith('- ') ||
            str.startsWith('{') || str.startsWith('[') || str.startsWith('*') || str.startsWith('&') ||
            str.startsWith('!') || str.startsWith('|') || str.startsWith('>') || str.includes('\n')) {
          return JSON.stringify(str);
        }
        return str;
      }

      function jsonToYaml(obj, indentLevel = 0, indentSize = 2, sortKeys = false) {
        const spaces = ' '.repeat(indentLevel * indentSize);

        if (obj === null || typeof obj !== 'object') {
          return formatScalar(obj);
        }

        if (Array.isArray(obj)) {
          if (obj.length === 0) return '[]';
          let out = '';
          obj.forEach((item, index) => {
            const prefix = index === 0 && indentLevel === 0 ? '' : spaces;
            if (typeof item === 'object' && item !== null && !Array.isArray(item)) {
              // Item is an object inside an array
              const keys = Object.keys(item);
              if (sortKeys) keys.sort();
              if (keys.length === 0) {
                out += `${prefix}- {}\n`;
              } else {
                const firstKey = keys[0];
                const restKeys = keys.slice(1);
                const firstVal = jsonToYaml(item[firstKey], indentLevel + 1, indentSize, sortKeys);
                out += `${prefix}- ${firstKey}:${typeof item[firstKey] === 'object' && item[firstKey] !== null ? '\n' : ' '}${firstVal}\n`;
                restKeys.forEach(k => {
                  const val = jsonToYaml(item[k], indentLevel + 1, indentSize, sortKeys);
                  out += `${spaces}  ${k}:${typeof item[k] === 'object' && item[k] !== null ? '\n' : ' '}${val}\n`;
                });
              }
            } else if (Array.isArray(item)) {
              out += `${prefix}- ${jsonToYaml(item, indentLevel + 1, indentSize, sortKeys)}\n`;
            } else {
              out += `${prefix}- ${formatScalar(item)}\n`;
            }
          });
          return out.trimEnd();
        }

        // Standard Object
        let keys = Object.keys(obj);
        if (sortKeys) keys.sort();
        if (keys.length === 0) return '{}';

        let out = '';
        keys.forEach(k => {
          const val = obj[k];
          if (typeof val === 'object' && val !== null) {
            if (Array.isArray(val) && val.length === 0) {
              out += `${spaces}${k}: []\n`;
            } else if (!Array.isArray(val) && Object.keys(val).length === 0) {
              out += `${spaces}${k}: {}\n`;
            } else {
              out += `${spaces}${k}:\n${jsonToYaml(val, indentLevel + 1, indentSize, sortKeys)}\n`;
            }
          } else {
            out += `${spaces}${k}: ${formatScalar(val)}\n`;
          }
        });
        return out.trimEnd();
      }

      function convert() {
        errBox.classList.add('hidden');
        const raw = jsonIn.value.trim();
        statJsonBytes.textContent = formatBytes(new Blob([raw]).size);

        if (!raw) {
          yamlOut.value = '';
          statYamlBytes.textContent = '0 B';
          statLines.textContent = '0 lines';
          statDelta.textContent = '0%';
          return;
        }

        try {
          const parsed = JSON.parse(raw);
          const indentSize = parseInt(indentSelect.value, 10);
          const sortKeys = sortKeysCheck.checked;

          const yamlResult = jsonToYaml(parsed, 0, indentSize, sortKeys);
          yamlOut.value = yamlResult;

          const jsonBytes = new Blob([raw]).size;
          const yamlBytes = new Blob([yamlResult]).size;
          statYamlBytes.textContent = formatBytes(yamlBytes);

          const lines = yamlResult ? yamlResult.split('\n').length : 0;
          statLines.textContent = `${lines} lines`;

          if (jsonBytes > 0) {
            const diff = yamlBytes - jsonBytes;
            const pct = Math.round((diff / jsonBytes) * 100);
            statDelta.textContent = `${pct >= 0 ? '+' : ''}${pct}%`;
          }

        } catch (e) {
          errBox.classList.remove('hidden');
          errBox.textContent = 'JSON Syntax Error: ' + e.message;
          yamlOut.value = '';
          statYamlBytes.textContent = '0 B';
          statLines.textContent = '0 lines';
          statDelta.textContent = '0%';
        }
      }

      convertBtn.addEventListener('click', convert);
      indentSelect.addEventListener('change', convert);
      sortKeysCheck.addEventListener('change', convert);

      sampleBtn.addEventListener('click', () => {
        jsonIn.value = JSON.stringify({
          version: "3.8",
          services: {
            app: {
              image: "node:18-alpine",
              environment: {
                NODE_ENV: "production",
                PORT: 3000
              },
              ports: ["3000:3000"],
              restart: "always"
            },
            database: {
              image: "postgres:15-alpine",
              environment: {
                POSTGRES_DB: "utility_db",
                POSTGRES_USER: "admin"
              }
            }
          }
        }, null, 2);
        convert();
      });

      clearBtn.addEventListener('click', () => {
        jsonIn.value = '';
        convert();
      });

      copyBtn.addEventListener('click', () => {
        if (!yamlOut.value) return;
        navigator.clipboard.writeText(yamlOut.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!yamlOut.value) return;
        const blob = new Blob([yamlOut.value], { type: 'text/yaml;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'config.yaml';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
