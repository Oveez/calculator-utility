---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JSON to YAML Converter — Free Online Config Formatter · ${siteName}`;
const pageDesc = 'Convert JSON configurations to clean YAML online. Ideal for Docker Compose, Kubernetes manifests, GitHub Actions, and CI/CD pipelines. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/json-to-yaml/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JSON to YAML' },
];

const schemaFaq = [
  {
    question: 'How does JSON to YAML conversion handle types?',
    answer: 'Standard JSON types (strings, numbers, booleans, arrays, nested objects, null) map directly to native YAML scalar, sequence, and mapping types with clean whitespace indentation.',
  },
  {
    question: 'Why use YAML over JSON for configurations?',
    answer: 'YAML supports comments, is more concise, and eliminates braces/brackets, making it the industry standard for Docker Compose, Kubernetes, OpenAPI, and CI/CD configuration files.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JSON to YAML Converter',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-json-yaml-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>CI/CD Config Conversion</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JSON to YAML Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert JSON files into clean, readable YAML syntax for Docker, Kubernetes, and cloud configs.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="json-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">JSON Input</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Sample Config</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="json-in"
          rows="16"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder='{"version": "3.8", "services": {"web": {"image": "nginx:alpine", "ports": ["80:80"]}}}'
        ></textarea>
        <button
          type="button"
          data-convert-btn
          class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Convert to YAML
        </button>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">YAML Output</span>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">
              Download .yaml
            </button>
          </div>
        </div>
        <textarea
          id="yaml-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="YAML output will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-json-yaml-app]');
      if (!root) return;

      const input = root.querySelector('#json-in');
      const output = root.querySelector('#yaml-out');
      const convertBtn = root.querySelector('[data-convert-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      function jsonToYaml(obj, indent = 0) {
        const spaces = '  '.repeat(indent);
        if (obj === null) return 'null\n';
        if (typeof obj === 'undefined') return '\n';
        if (typeof obj === 'boolean' || typeof obj === 'number') return `${obj}\n`;
        if (typeof obj === 'string') {
          if (obj.includes('\n') || /[:#[\]{},&*!|>'"%@`]/.test(obj)) {
            return `"${obj.replace(/"/g, '\\"')}"\n`;
          }
          return `${obj}\n`;
        }
        if (Array.isArray(obj)) {
          if (obj.length === 0) return '[]\n';
          let str = '\n';
          obj.forEach(item => {
            const val = jsonToYaml(item, indent + 1);
            if (typeof item === 'object' && item !== null && !Array.isArray(item)) {
              str += `${spaces}- ${val.trimStart()}`;
            } else {
              str += `${spaces}- ${val}`;
            }
          });
          return str;
        }
        if (typeof obj === 'object') {
          const keys = Object.keys(obj);
          if (keys.length === 0) return '{}\n';
          let str = '\n';
          keys.forEach(k => {
            const val = jsonToYaml(obj[k], indent + 1);
            if (typeof obj[k] === 'object' && obj[k] !== null && Object.keys(obj[k]).length > 0) {
              str += `${spaces}${k}:${val}`;
            } else {
              str += `${spaces}${k}: ${val}`;
            }
          });
          return str;
        }
        return `${obj}\n`;
      }

      function convert() {
        const raw = input.value.trim();
        if (!raw) {
          output.value = '';
          return;
        }
        try {
          const parsed = JSON.parse(raw);
          const yaml = jsonToYaml(parsed).trim();
          output.value = yaml;
        } catch (e) {
          output.value = 'Invalid JSON: ' + e.message;
        }
      }

      convertBtn.addEventListener('click', convert);

      sampleBtn.addEventListener('click', () => {
        input.value = JSON.stringify({
          version: "3.8",
          services: {
            app: {
              image: "node:18-alpine",
              environment: {
                NODE_ENV: "production",
                PORT: 3000
              },
              ports: ["3000:3000"],
              restart: "always"
            }
          }
        }, null, 2);
        convert();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/yaml;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'config.yaml';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
