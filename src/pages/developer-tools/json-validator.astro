---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JSON Validator & Syntax Checker — RFC 8259 Inspector · ${siteName}`;
const pageDesc = 'Validate JSON strings online with exact line, column, and snippet error pointers. Includes auto-repair for trailing commas, structural metrics, and 100% private browser execution.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/json-validator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JSON Validator' },
];

const schemaFaq = [
  {
    question: 'How does this JSON Validator check syntax?',
    answer: 'It parses raw text against the RFC 8259 standard using browser-native JSON engines, identifying exact character offsets, line numbers, and syntax violations such as unquoted keys or trailing commas.',
  },
  {
    question: 'Can this tool automatically fix common JSON errors?',
    answer: 'Yes. The "Auto-Repair Common Errors" button removes trailing commas, converts single quotes to valid double quotes, and encloses unquoted keys.',
  },
  {
    question: 'Is my JSON uploaded to any server?',
    answer: 'No. All validation and repair operations run 100% in your browser memory. Sensitive config files, credentials, and API responses are never transmitted over the network.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JSON Validator & Syntax Checker',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuide = [
  {
    id: 'syntax_diagnostics',
    name: 'Line & Column Pointer',
    description: 'Calculates the exact line and character offset where the parser failed.',
    whyItMatters: 'Saves developers hours of manually scanning large payloads for a single misplaced comma.',
    typicalRange: 'Exact (Line X, Col Y)',
  },
  {
    id: 'trailing_commas',
    name: 'Trailing Commas',
    description: 'Commas after the final property in an object or element in an array.',
    whyItMatters: 'While legal in modern JavaScript and TypeScript, trailing commas are strictly forbidden in RFC 8259 JSON and crash standard JSON.parse() calls.',
    typicalRange: 'Invalid in RFC 8259',
  },
  {
    id: 'quote_rules',
    name: 'Double Quote Requirement',
    description: 'All string values and object property keys must be wrapped in ASCII double quotes (").',
    whyItMatters: 'Single quotes (\') and backticks (`) are illegal in standard JSON and must be replaced.',
    typicalRange: 'Strict Double Quotes (")',
  },
  {
    id: 'auto_repair',
    name: 'Auto-Repair Engine',
    description: 'A heuristic cleaner that automatically strips trailing commas, transforms single quotes, and fixes unquoted keys.',
    whyItMatters: 'Quickly fixes JSON copied from JavaScript code, Python dictionaries, or log outputs.',
    typicalRange: 'One-Click Repair',
  },
  {
    id: 'structure_analysis',
    name: 'Payload Metrics',
    description: 'Breakdown of root type, nesting depth, object key counts, and primitive types.',
    whyItMatters: 'Provides deep visibility into API payload complexity before database storage.',
    typicalRange: 'Real-time telemetry',
  },
  {
    id: 'privacy',
    name: 'In-Memory Security',
    description: 'All parsing executes within browser memory using HTML5 APIs.',
    whyItMatters: 'Confidential production configs, JWT tokens, and customer records remain secure.',
    typicalRange: '100% Client-Side',
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-validator-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>RFC 8259 Standard Syntax Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JSON Validator &amp; Syntax Checker
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Check raw JSON for syntax violations with line and column precision, inspect structural metrics, and auto-repair common errors with a single click.
      </p>
    </header>

    <!-- Main Workspace -->
    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Input Column -->
      <div class="space-y-3 lg:col-span-2">
        <div class="flex items-center justify-between">
          <label for="val-input" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
            Raw JSON Code
          </label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-valid class="font-semibold text-[color:var(--primary)] hover:underline cursor-pointer">Valid Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-err-sample class="font-semibold text-rose-500 hover:underline cursor-pointer">Error Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">Clear</button>
          </div>
        </div>

        <textarea
          id="val-input"
          rows="18"
          class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste raw JSON here to inspect syntax..."
        ></textarea>

        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex gap-2">
            <button
              type="button"
              id="btn-auto-fix"
              class="rounded-xl border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs font-bold text-amber-600 dark:text-amber-400 hover:bg-amber-500/20 cursor-pointer"
            >
              🛠️ Auto-Repair Common Errors
            </button>
            <button
              type="button"
              id="btn-beautify"
              class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-2 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] cursor-pointer"
            >
              ✨ Beautify
            </button>
          </div>
          <button
            type="button"
            data-validate-btn
            class="rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 cursor-pointer"
          >
            🔍 Validate Syntax
          </button>
        </div>
      </div>

      <!-- Result Diagnostics Column -->
      <div class="space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Validation Diagnostics</h2>

        <!-- Status Card -->
        <div data-status-card class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-center">
          <div data-status-icon class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--muted)]">
            <svg class="h-6 w-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <p data-status-title class="font-bold text-base text-[color:var(--fg)]">Awaiting Input</p>
          <p data-status-desc class="text-xs text-[color:var(--muted)]">Paste or type JSON code to run syntax validation.</p>
        </div>

        <!-- Error Card -->
        <div id="error-details" class="hidden space-y-2.5 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs text-rose-600 dark:text-rose-400">
          <div class="flex items-center justify-between font-bold">
            <span>Syntax Error Detected</span>
            <span class="rounded bg-rose-500/20 px-1.5 py-0.5 font-mono text-[10px]" id="err-pos">Line 1, Col 1</span>
          </div>
          <p id="error-msg" class="font-mono text-[11px] leading-relaxed"></p>
          <div id="error-snippet" class="rounded-xl border border-rose-500/20 bg-[color:var(--bg)] p-3 font-mono text-[11px] text-[color:var(--fg)] whitespace-pre overflow-x-auto"></div>
        </div>

        <!-- Structure Telemetry Card -->
        <div id="structure-card" class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
          <p class="font-bold text-[color:var(--fg)] uppercase tracking-wider text-[11px]">Payload Structure</p>
          <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
            <div class="rounded-lg bg-[color:var(--bg)] p-2">
              <span class="text-[color:var(--muted)] block text-[10px]">Root Type:</span>
              <strong id="meta-type" class="text-[color:var(--fg)]">-</strong>
            </div>
            <div class="rounded-lg bg-[color:var(--bg)] p-2">
              <span class="text-[color:var(--muted)] block text-[10px]">Max Depth:</span>
              <strong id="meta-depth" class="text-[color:var(--fg)]">-</strong>
            </div>
            <div class="rounded-lg bg-[color:var(--bg)] p-2">
              <span class="text-[color:var(--muted)] block text-[10px]">Total Keys:</span>
              <strong id="meta-keys" class="text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">-</strong>
            </div>
            <div class="rounded-lg bg-[color:var(--bg)] p-2">
              <span class="text-[color:var(--muted)] block text-[10px]">Payload Size:</span>
              <strong id="meta-size" class="text-[color:var(--fg)]">-</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Step-by-Step Worked Example -->
    <section class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-[color:var(--accent)]/15 px-2.5 py-1 text-xs font-bold text-[color:var(--accent)]">Worked Example</span>
        <h2 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Fixing JavaScript Object Copied as JSON</h2>
      </div>
      <p>
        Developers often copy objects from console logs or JS code that fail standard JSON parsing due to unquoted keys, single quotes, and trailing commas:
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-rose-500/30 bg-rose-500/5 p-4 font-mono text-xs">
          <span class="text-rose-600 dark:text-rose-400 block mb-1 font-bold font-sans">Invalid JS/Python Object:</span>
          &#123;<br/>
          &nbsp;&nbsp;id: 101,<br/>
          &nbsp;&nbsp;status: 'active',<br/>
          &nbsp;&nbsp;roles: ['admin', 'editor',],<br/>
          &#125;
        </div>
        <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 p-4 font-mono text-xs">
          <span class="text-cyan-600 dark:text-cyan-400 dark:text-cyan-400 block mb-1 font-bold font-sans">Auto-Repaired Valid RFC 8259 JSON:</span>
          &#123;<br/>
          &nbsp;&nbsp;&quot;id&quot;: 101,<br/>
          &nbsp;&nbsp;&quot;status&quot;: &quot;active&quot;,<br/>
          &nbsp;&nbsp;&quot;roles&quot;: [&quot;admin&quot;, &quot;editor&quot;]<br/>
          &#125;
        </div>
      </div>
      <p class="text-xs text-[color:var(--muted)]">
        Clicking <strong>Auto-Repair Common Errors</strong> automatically encloses property names in double quotes, swaps single quotes, and removes trailing commas.
      </p>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-validator-app]');
      if (!root) return;

      const input = root.querySelector('#val-input');
      const valBtn = root.querySelector('[data-validate-btn]');
      const autoFixBtn = root.querySelector('#btn-auto-fix');
      const beautifyBtn = root.querySelector('#btn-beautify');
      const statusIcon = root.querySelector('[data-status-icon]');
      const statusTitle = root.querySelector('[data-status-title]');
      const statusDesc = root.querySelector('[data-status-desc]');
      const errorDetails = root.querySelector('#error-details');
      const errorMsg = root.querySelector('#error-msg');
      const errPos = root.querySelector('#err-pos');
      const errorSnippet = root.querySelector('#error-snippet');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const sampleValid = root.querySelector('[data-sample-valid]');
      const errSample = root.querySelector('[data-err-sample]');

      const metaType = root.querySelector('#meta-type');
      const metaDepth = root.querySelector('#meta-depth');
      const metaKeys = root.querySelector('#meta-keys');
      const metaSize = root.querySelector('#meta-size');

      function formatBytes(bytes) {
        if (bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
      }

      function analyzeStructure(obj) {
        let keys = 0;
        let maxDepth = 1;

        function traverse(current, depth) {
          if (depth > maxDepth) maxDepth = depth;
          if (Array.isArray(current)) {
            current.forEach(item => traverse(item, depth + 1));
          } else if (current !== null && typeof current === 'object') {
            const kList = Object.keys(current);
            keys += kList.length;
            kList.forEach(k => traverse(current[k], depth + 1));
          }
        }

        traverse(obj, 1);
        return { keys, maxDepth };
      }

      function getLineAndCol(text, pos) {
        const lines = text.substring(0, pos).split('\n');
        const line = lines.length;
        const col = lines[lines.length - 1].length + 1;
        return { line, col };
      }

      function validate() {
        const text = input.value.trim();
        if (!text) {
          statusIcon.className = 'mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--muted)]';
          statusIcon.innerHTML = '<svg class="h-6 w-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>';
          statusTitle.textContent = 'Awaiting Input';
          statusDesc.textContent = 'Paste or type JSON code to run syntax validation.';
          errorDetails.classList.add('hidden');
          metaType.textContent = '-';
          metaDepth.textContent = '-';
          metaKeys.textContent = '-';
          metaSize.textContent = '-';
          return;
        }

        try {
          const parsed = JSON.parse(text);
          statusIcon.className = 'mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 dark:text-cyan-400 border border-cyan-500/20';
          statusIcon.innerHTML = '<svg class="h-6 w-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          statusTitle.textContent = 'Valid JSON Syntax';
          statusDesc.textContent = 'Code strictly complies with the RFC 8259 JSON specification.';
          errorDetails.classList.add('hidden');

          const rootType = Array.isArray(parsed) ? 'Array' : (parsed !== null && typeof parsed === 'object') ? 'Object' : typeof parsed;
          const { keys, maxDepth } = analyzeStructure(parsed);

          metaType.textContent = rootType;
          metaDepth.textContent = maxDepth.toString();
          metaKeys.textContent = keys.toLocaleString();
          metaSize.textContent = formatBytes(new Blob([text]).size);
        } catch (err) {
          statusIcon.className = 'mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-500/15 text-rose-600 dark:text-rose-400 border border-rose-500/20';
          statusIcon.innerHTML = '<svg class="h-6 w-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
          statusTitle.textContent = 'Syntax Violation';
          statusDesc.textContent = 'Malformed JSON. See error pointer below.';
          errorDetails.classList.remove('hidden');
          errorMsg.textContent = err.message;

          metaType.textContent = 'Invalid';
          metaDepth.textContent = '-';
          metaKeys.textContent = '-';
          metaSize.textContent = formatBytes(new Blob([text]).size);

          // Find position
          let pos = -1;
          const match = err.message.match(/at position (\d+)/);
          if (match) {
            pos = parseInt(match[1], 10);
          } else {
            const lineColMatch = err.message.match(/line (\d+) column (\d+)/);
            if (lineColMatch) {
              const targetLine = parseInt(lineColMatch[1], 10);
              const targetCol = parseInt(lineColMatch[2], 10);
              errPos.textContent = `Line ${targetLine}, Col ${targetCol}`;
            }
          }

          if (pos >= 0) {
            const { line, col } = getLineAndCol(text, pos);
            errPos.textContent = `Line ${line}, Col ${col}`;

            const lines = text.split('\n');
            const errLineIdx = line - 1;
            const contextLine = lines[errLineIdx] || '';
            const pointer = ' '.repeat(Math.max(0, col - 1)) + '^';
            errorSnippet.textContent = `${contextLine}\n${pointer}`;
          } else {
            errorSnippet.textContent = text.slice(0, 100) + '...';
          }
        }
      }

      function autoFix() {
        let text = input.value;
        if (!text) return;

        // 1. Remove trailing commas before } or ]
        text = text.replace(/,\s*([\}\]])/g, '$1');

        // 2. Replace single quotes around keys and values with double quotes
        text = text.replace(/'([^'\\]*(?:\\.[^'\\]*)*)'/g, '"$1"');

        // 3. Quote unquoted object keys: { key: "value" } -> { "key": "value" }
        text = text.replace(/([{,]\s*)([a-zA-Z0-9_$]+)\s*:/g, '$1"$2":');

        input.value = text;
        validate();
      }

      function beautify() {
        try {
          const parsed = JSON.parse(input.value);
          input.value = JSON.stringify(parsed, null, 2);
          validate();
        } catch (e) {
          validate();
        }
      }

      valBtn.addEventListener('click', validate);
      input.addEventListener('input', () => {
        clearTimeout(input._timer);
        input._timer = setTimeout(validate, 250);
      });

      autoFixBtn.addEventListener('click', autoFix);
      beautifyBtn.addEventListener('click', beautify);

      sampleValid.addEventListener('click', () => {
        input.value = JSON.stringify({
          database: "PostgreSQL",
          connected: true,
          pool: {
            min: 5,
            max: 20,
            idleTimeoutMillis: 30000
          },
          tags: ["production", "replica", "us-east-1"]
        }, null, 2);
        validate();
      });

      errSample.addEventListener('click', () => {
        input.value = `{\n  service: 'AuthService',\n  status: "active",\n  retry_codes: [500, 502, 503,],\n}`;
        validate();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        validate();
      });

      // Init with sample
      sampleValid.click();
    })();
  </script>
</SiteLayout>
