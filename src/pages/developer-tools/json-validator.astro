---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JSON Validator & Syntax Checker — Free Online Tool · ${siteName}`;
const pageDesc = 'Validate JSON syntax in real time with line-by-line error location, error character indicators, and RFC 8259 compliance verification. 100% private in-browser processing.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/json-validator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JSON Validator' },
];

const schemaFaq = [
  {
    question: 'How does this JSON validator locate syntax errors?',
    answer: 'The parser evaluates your JSON against strict ECMAScript/RFC 8259 specifications. If an error occurs, it inspects the character index and calculates the exact line number and column.',
  },
  {
    question: 'What are common reasons JSON validation fails?',
    answer: 'Common errors include trailing commas after the last array/object element, using single quotes instead of double quotes, missing colons, and unquoted object keys.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JSON Validator',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-validator-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>RFC 8259 Standard Validator</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JSON Validator &amp; Syntax Checker
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Instantly check raw JSON for syntax errors, missing brackets, trailing commas, and unquoted keys with line and column precision.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Input Area -->
      <div class="space-y-3 lg:col-span-2">
        <div class="flex items-center justify-between">
          <label for="val-input" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
            Raw JSON Code
          </label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-err-sample class="text-[color:var(--primary)] hover:underline font-semibold">Load Bad JSON</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="val-input"
          rows="16"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste JSON here to check validity..."
        ></textarea>
        <button
          type="button"
          data-validate-btn
          class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Validate JSON Syntax
        </button>
      </div>

      <!-- Result Card -->
      <div class="space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Validation Diagnostics</h2>
        <div data-status-card class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-center space-y-3">
          <div data-status-icon class="mx-auto flex h-10 w-10 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--muted)]">
            <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <p data-status-title class="font-bold text-sm text-[color:var(--fg)]">Awaiting Input</p>
          <p data-status-desc class="text-xs text-[color:var(--muted)]">Paste or type JSON to run validation.</p>
        </div>

        <div id="error-details" class="hidden rounded-2xl border border-red-500/30 bg-red-500/10 p-4 space-y-2 text-xs text-red-600 dark:text-red-400">
          <p class="font-bold">Error Detected:</p>
          <p id="error-msg" class="font-mono text-[11px]"></p>
          <div class="flex gap-4 pt-1 text-[11px]">
            <span>Line: <strong id="err-line" class="font-mono text-[color:var(--fg)]">-</strong></span>
            <span>Column: <strong id="err-col" class="font-mono text-[color:var(--fg)]">-</strong></span>
          </div>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs space-y-2 text-[color:var(--muted)]">
          <p class="font-bold text-[color:var(--fg)]">Validation Rules Checked:</p>
          <p class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-emerald-500 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Valid quotes on all property keys</p>
          <p class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-emerald-500 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> No illegal trailing commas</p>
          <p class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-emerald-500 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Balanced brackets and braces</p>
          <p class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-emerald-500 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Proper UTF-8 escape sequences</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-validator-app]');
      if (!root) return;

      const input = root.querySelector('#val-input');
      const valBtn = root.querySelector('[data-validate-btn]');
      const statusIcon = root.querySelector('[data-status-icon]');
      const statusTitle = root.querySelector('[data-status-title]');
      const statusDesc = root.querySelector('[data-status-desc]');
      const errorDetails = root.querySelector('#error-details');
      const errorMsg = root.querySelector('#error-msg');
      const errLine = root.querySelector('#err-line');
      const errCol = root.querySelector('#err-col');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const errSample = root.querySelector('[data-err-sample]');

      function validate() {
        const text = input.value.trim();
        if (!text) {
          statusIcon.className = 'mx-auto flex h-10 w-10 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--muted)]';
          statusIcon.innerHTML = '<svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>';
          statusTitle.textContent = 'Awaiting Input';
          statusDesc.textContent = 'Paste or type JSON to run validation.';
          errorDetails.classList.add('hidden');
          return;
        }

        try {
          JSON.parse(text);
          statusIcon.className = 'mx-auto flex h-10 w-10 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20';
          statusIcon.innerHTML = '<svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          statusTitle.textContent = 'Valid JSON';
          statusDesc.textContent = 'Your JSON syntax strictly adheres to RFC 8259 specifications.';
          errorDetails.classList.add('hidden');
        } catch (err) {
          statusIcon.className = 'mx-auto flex h-10 w-10 items-center justify-center rounded-2xl bg-red-500/10 text-red-500 border border-red-500/20';
          statusIcon.innerHTML = '<svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
          statusTitle.textContent = 'Invalid JSON Syntax';
          statusDesc.textContent = 'Syntax error detected. See details below.';
          errorDetails.classList.remove('hidden');
          errorMsg.textContent = err.message;

          // Estimate line / col
          let line = 1, col = 1;
          const match = err.message.match(/at position (\d+)/);
          if (match) {
            const pos = parseInt(match[1], 10);
            const lines = text.substring(0, pos).split('\n');
            line = lines.length;
            col = lines[lines.length - 1].length + 1;
          }
          errLine.textContent = line;
          errCol.textContent = col;
        }
      }

      valBtn.addEventListener('click', validate);
      input.addEventListener('input', validate);

      errSample.addEventListener('click', () => {
        input.value = `{\n  "service": "Calculator Utility",\n  "status": "online",\n  "trailing_comma_error": true,\n}`;
        validate();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        validate();
      });
    })();
  </script>
</SiteLayout>
