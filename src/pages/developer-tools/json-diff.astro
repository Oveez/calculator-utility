---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JSON Diff & Compare Tool — Free Online Structural Comparator · ${siteName}`;
const pageDesc = 'Compare two JSON objects side-by-side or unified. Highlights added, deleted, and modified keys and values. 100% private in-browser comparison.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/json-diff/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JSON Diff' },
];

const schemaFaq = [
  {
    question: 'How does JSON Diff differ from plain text diff?',
    answer: 'Plain text diffs compare raw line strings, which fail when object keys are reordered. A JSON diff parses both objects semantically, comparing keys and deep values regardless of indentation or formatting differences.',
  },
  {
    question: 'Can this tool compare deeply nested objects and arrays?',
    answer: 'Yes. It recursively traverses nested objects and arrays, flagging added, removed, and modified values at each depth.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JSON Diff Tool',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-json-diff-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Semantic Tree Comparison</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JSON Diff &amp; Comparator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Compare two JSON files to find differences, added keys, removed properties, and changed values.
      </p>
    </header>

    <div class="space-y-4">
      <div class="grid gap-4 lg:grid-cols-2">
        <!-- JSON 1 -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="json1-input" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Original JSON (Left)
            </label>
            <button type="button" data-sample-btn class="text-xs font-semibold text-[color:var(--primary)] hover:underline">Load Sample Diff</button>
          </div>
          <textarea
            id="json1-input"
            rows="10"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste original JSON..."
          ></textarea>
        </div>

        <!-- JSON 2 -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="json2-input" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Modified JSON (Right)
            </label>
            <button type="button" data-clear-btn class="text-xs text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear All</button>
          </div>
          <textarea
            id="json2-input"
            rows="10"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="Paste modified JSON..."
          ></textarea>
        </div>
      </div>

      <button
        type="button"
        data-compare-btn
        class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
      >
        Compare JSON Objects
      </button>

      <!-- Diff Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Diff Results</span>
          <div class="flex items-center gap-3 text-xs">
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span> Added</span>
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-red-500"></span> Removed</span>
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span> Modified</span>
          </div>
        </div>
        <div
          id="diff-result"
          class="min-h-32 font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 space-y-1 text-[color:var(--fg)] overflow-x-auto"
        >
          <p class="text-[color:var(--muted)] italic">Enter two JSON objects above and click Compare.</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-json-diff-app]');
      if (!root) return;

      const j1 = root.querySelector('#json1-input');
      const j2 = root.querySelector('#json2-input');
      const compareBtn = root.querySelector('[data-compare-btn]');
      const diffResult = root.querySelector('#diff-result');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');

      function compare() {
        const v1 = j1.value.trim();
        const v2 = j2.value.trim();

        if (!v1 || !v2) {
          diffResult.innerHTML = '<p class="text-[color:var(--muted)] italic">Please provide both JSON inputs.</p>';
          return;
        }

        try {
          const o1 = JSON.parse(v1);
          const o2 = JSON.parse(v2);

          const lines = [];

          function diffObjects(obj1, obj2, path = '') {
            const allKeys = Array.from(new Set([...Object.keys(obj1 || {}), ...Object.keys(obj2 || {})]));
            
            allKeys.forEach(k => {
              const curPath = path ? `${path}.${k}` : k;
              const has1 = obj1 && k in obj1;
              const has2 = obj2 && k in obj2;

              if (has1 && !has2) {
                lines.push(`<div class="p-1 rounded bg-red-500/10 text-red-600 dark:text-red-400">- [REMOVED] <strong>${curPath}</strong>: ${JSON.stringify(obj1[k])}</div>`);
              } else if (!has1 && has2) {
                lines.push(`<div class="p-1 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">+ [ADDED] <strong>${curPath}</strong>: ${JSON.stringify(obj2[k])}</div>`);
              } else {
                const val1 = obj1[k];
                const val2 = obj2[k];

                if (typeof val1 === 'object' && val1 !== null && typeof val2 === 'object' && val2 !== null) {
                  diffObjects(val1, val2, curPath);
                } else if (val1 !== val2) {
                  lines.push(`<div class="p-1 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400">~ [CHANGED] <strong>${curPath}</strong>: ${JSON.stringify(val1)} → ${JSON.stringify(val2)}</div>`);
                } else {
                  lines.push(`<div class="p-1 text-[color:var(--muted)] opacity-60">  [SAME] ${curPath}: ${JSON.stringify(val1)}</div>`);
                }
              }
            });
          }

          diffObjects(o1, o2);

          if (lines.length === 0) {
            diffResult.innerHTML = '<p class="text-emerald-500 font-bold">Both JSON objects are structurally identical!</p>';
          } else {
            diffResult.innerHTML = lines.join('');
          }
        } catch (e) {
          diffResult.innerHTML = `<p class="text-red-500 font-semibold">JSON Parse Error: ${e.message}</p>`;
        }
      }

      compareBtn.addEventListener('click', compare);

      sampleBtn.addEventListener('click', () => {
        j1.value = JSON.stringify({ name: "Calculator Utility", version: "2.3.0", status: "beta", tags: ["calc", "tools"] }, null, 2);
        j2.value = JSON.stringify({ name: "Calculator Utility", version: "2.4.0", status: "production", license: "MIT", tags: ["calc", "tools", "utilities"] }, null, 2);
        compare();
      });

      clearBtn.addEventListener('click', () => {
        j1.value = '';
        j2.value = '';
        diffResult.innerHTML = '<p class="text-[color:var(--muted)] italic">Enter two JSON objects above and click Compare.</p>';
      });
    })();
  </script>
</SiteLayout>
