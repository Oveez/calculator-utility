---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JSON Minifier & Compressor — Free Online Tool · ${siteName}`;
const pageDesc = 'Minify and compress JSON strings online. Strips whitespaces, tabs, and newlines to reduce payload size for web APIs and database storage. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/json-minifier/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JSON Minifier' },
];

const schemaFaq = [
  {
    question: 'Why should I minify JSON payloads?',
    answer: 'Minified JSON removes all non-functional formatting characters like line breaks, indentation spaces, and tabs. This reduces payload byte size by 20% to 50%, saving bandwidth and speeding up API network transfers.',
  },
  {
    question: 'Does minification alter data values or numbers?',
    answer: 'No. Minification strictly strips formatting whitespace outside of string literals. All string values, numbers, booleans, and nulls remain identical.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JSON Minifier',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-minifier-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Instant Payload Compression</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JSON Minifier &amp; Compressor
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Compress JSON into a compact single line. Calculate exact byte savings and copy minified payloads for production APIs and config storage.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Input -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="min-input" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
            Formatted JSON Input
          </label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="min-input"
          rows="16"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste formatted JSON here to minify..."
        ></textarea>
        <button
          type="button"
          data-minify-btn
          class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Minify JSON
        </button>
      </div>

      <!-- Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Minified Output</span>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy</span>
            </button>
          </div>
        </div>
        <textarea
          id="min-output"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Minified single-line JSON will appear here..."
        ></textarea>

        <!-- Stats Bar -->
        <div data-stats-bar class="grid grid-cols-3 gap-2 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center text-xs">
          <div>
            <p class="text-[10px] text-[color:var(--muted)]">Original Size</p>
            <p data-orig-size class="font-mono font-bold text-[color:var(--fg)]">0 B</p>
          </div>
          <div>
            <p class="text-[10px] text-[color:var(--muted)]">Minified Size</p>
            <p data-min-size class="font-mono font-bold text-[color:var(--fg)]">0 B</p>
          </div>
          <div>
            <p class="text-[10px] text-[color:var(--muted)]">Saved</p>
            <p data-saved-pct class="font-mono font-bold text-emerald-500">0%</p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-minifier-app]');
      if (!root) return;

      const input = root.querySelector('#min-input');
      const output = root.querySelector('#min-output');
      const minifyBtn = root.querySelector('[data-minify-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const origSize = root.querySelector('[data-orig-size]');
      const minSize = root.querySelector('[data-min-size]');
      const savedPct = root.querySelector('[data-saved-pct]');

      function minify() {
        const raw = input.value.trim();
        if (!raw) {
          output.value = '';
          origSize.textContent = '0 B';
          minSize.textContent = '0 B';
          savedPct.textContent = '0%';
          return;
        }

        try {
          const parsed = JSON.parse(raw);
          const minified = JSON.stringify(parsed);
          output.value = minified;

          const origBytes = new Blob([raw]).size;
          const minBytes = new Blob([minified]).size;
          const diff = origBytes - minBytes;
          const pct = origBytes > 0 ? Math.round((diff / origBytes) * 100) : 0;

          origSize.textContent = origBytes + ' B';
          minSize.textContent = minBytes + ' B';
          savedPct.textContent = pct > 0 ? `-${pct}% (${diff} B)` : '0%';
        } catch (e) {
          output.value = 'Invalid JSON: ' + e.message;
        }
      }

      minifyBtn.addEventListener('click', minify);
      input.addEventListener('input', minify);

      sampleBtn.addEventListener('click', () => {
        input.value = `{\n  "name": "Calculator Utility",\n  "tier": "Free",\n  "tools_count": 85,\n  "supported_formats": [\n    "JSON",\n    "CSV",\n    "YAML",\n    "XML"\n  ]\n}`;
        minify();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        minify();
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });
    })();
  </script>
</SiteLayout>
