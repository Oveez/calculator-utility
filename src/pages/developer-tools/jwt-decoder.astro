---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JWT Token Decoder — Free Online JSON Web Token Inspector · ${siteName}`;
const pageDesc = 'Decode and inspect JSON Web Tokens (JWT) online. Decodes Header, Payload claims, expiration timestamps (exp), and issuers locally. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/jwt-decoder/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JWT Decoder' },
];

const schemaFaq = [
  {
    question: 'Does decoding a JWT on this page verify its cryptographic signature?',
    answer: 'No. This tool decodes and formats the Base64URL-encoded Header and Payload claims for inspection. Validating the signature requires verifying it against your application’s private or public cryptographic secret key.',
  },
  {
    question: 'Is my JWT token transmitted to any server?',
    answer: 'No. All JWT string decoding runs entirely within your browser memory. Your tokens and sensitive claims never touch an external network.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JWT Token Decoder',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-jwt-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Browser Memory Only</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JWT Token Decoder &amp; Inspector
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Decode JSON Web Token (JWT) headers and payloads. Inspect issued-at (iat) and expiration (exp) dates with human-readable timestamps.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Input Area -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="jwt-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
            Encoded JWT Token (Header.Payload.Signature)
          </label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample JWT</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="jwt-in"
          rows="5"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
        ></textarea>
        <div id="jwt-err" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-xs text-red-600 dark:text-red-400"></div>
      </div>

      <!-- Decoded Columns -->
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Header -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-500">Header: Algorithm &amp; Token Type</span>
          </div>
          <textarea
            id="jwt-header"
            rows="8"
            readonly
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-purple-500/30 bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
            placeholder="Decoded header..."
          ></textarea>
        </div>

        <!-- Payload -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-500">Payload: Data Claims</span>
          </div>
          <textarea
            id="jwt-payload"
            rows="8"
            readonly
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-blue-500/30 bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
            placeholder="Decoded payload claims..."
          ></textarea>
        </div>
      </div>

      <!-- Claim Inspection Card -->
      <div id="claims-card" class="hidden space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <h2 class="font-bold text-sm text-[color:var(--fg)]">Key Claims Summary</h2>
        <div class="grid gap-3 sm:grid-cols-3">
          <div>
            <p class="text-[10px] text-[color:var(--muted)]">Subject (sub):</p>
            <p id="claim-sub" class="font-mono font-bold text-[color:var(--fg)]">-</p>
          </div>
          <div>
            <p class="text-[10px] text-[color:var(--muted)]">Issued At (iat):</p>
            <p id="claim-iat" class="font-mono font-bold text-[color:var(--fg)]">-</p>
          </div>
          <div>
            <p class="text-[10px] text-[color:var(--muted)]">Expires (exp):</p>
            <p id="claim-exp" class="font-mono font-bold text-[color:var(--fg)]">-</p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-jwt-app]');
      if (!root) return;

      const input = root.querySelector('#jwt-in');
      const headerOut = root.querySelector('#jwt-header');
      const payloadOut = root.querySelector('#jwt-payload');
      const errBox = root.querySelector('#jwt-err');
      const claimsCard = root.querySelector('#claims-card');
      const claimSub = root.querySelector('#claim-sub');
      const claimIat = root.querySelector('#claim-iat');
      const claimExp = root.querySelector('#claim-exp');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');

      function decode() {
        const token = input.value.trim();
        if (!token) {
          headerOut.value = '';
          payloadOut.value = '';
          errBox.classList.add('hidden');
          claimsCard.classList.add('hidden');
          return;
        }

        const parts = token.split('.');
        if (parts.length !== 3) {
          errBox.classList.remove('hidden');
          errBox.textContent = 'Invalid JWT format: A valid JWT must contain exactly 3 dot-separated segments (Header.Payload.Signature).';
          headerOut.value = '';
          payloadOut.value = '';
          claimsCard.classList.add('hidden');
          return;
        }

        try {
          errBox.classList.add('hidden');
          const b64Decode = (str) => {
            let b64 = str.replace(/-/g, '+').replace(/_/g, '/');
            while (b64.length % 4) b64 += '=';
            return decodeURIComponent(escape(atob(b64)));
          };

          const headerObj = JSON.parse(b64Decode(parts[0]));
          const payloadObj = JSON.parse(b64Decode(parts[1]));

          headerOut.value = JSON.stringify(headerObj, null, 2);
          payloadOut.value = JSON.stringify(payloadObj, null, 2);

          // Claims summary
          claimsCard.classList.remove('hidden');
          claimSub.textContent = payloadObj.sub || 'None';
          claimIat.textContent = payloadObj.iat ? new Date(payloadObj.iat * 1000).toLocaleString() : 'None';
          if (payloadObj.exp) {
            const expDate = new Date(payloadObj.exp * 1000);
            const isExpired = Date.now() > expDate.getTime();
            claimExp.innerHTML = `${expDate.toLocaleString()} ${isExpired ? '<span class="text-red-500 font-bold">(Expired)</span>' : '<span class="text-emerald-500 font-bold">(Valid)</span>'}`;
          } else {
            claimExp.textContent = 'None';
          }
        } catch (e) {
          errBox.classList.remove('hidden');
          errBox.textContent = 'Decoding Error: ' + e.message;
          claimsCard.classList.add('hidden');
        }
      }

      input.addEventListener('input', decode);

      sampleBtn.addEventListener('click', () => {
        input.value = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyXzk5ODgiLCJuYW1lIjoiQWxleCBKb2huc29uIiwicm9sZSI6ImFkbWluIiwiaWF0IjoxNzI1MzYwMDAwLCJleHAiOjE4ODMxNjAwMDB9.dGVzdF9zaWduYXR1cmVfaGVyZQ';
        decode();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        decode();
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
