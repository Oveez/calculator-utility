---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JWT Token Decoder & Inspector — Decode JWT Online · ${siteName}`;
const pageDesc = 'Decode, inspect, and analyze JSON Web Tokens (JWT) online. Color-coded header, payload claims, expiration timers, and standard claim verification. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/jwt-decoder/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JWT Decoder' },
];

const schemaFaq = [
  {
    question: 'Does decoding a JWT on this page verify its cryptographic signature?',
    answer: 'No. This tool decodes and formats the Base64URL-encoded Header and Payload claims for client-side debugging. Validating the cryptographic signature requires checking against your backend server’s private key or HMAC secret.',
  },
  {
    question: 'Is my JWT token transmitted to any server?',
    answer: 'No. All JWT string decoding runs entirely within your browser memory. Your tokens and sensitive authorization claims never leave your device.',
  },
  {
    question: 'How does the token expiration calculator work?',
    answer: 'It reads the standard "exp" (expiration timestamp) claim from the payload, converts the Unix epoch to a human-readable date, and compares it against your local system clock to determine whether the token is currently active or expired.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JWT Token Decoder',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuide = [
  {
    id: 'jwt_header',
    name: 'Header (alg, typ)',
    description: 'Specifies the cryptographic signing algorithm (e.g., HS256, RS256) and token type (typically "JWT").',
    whyItMatters: 'Tells backend verification libraries which algorithm to use when checking the signature hash.',
    typicalRange: 'HS256, RS256, ES256, EdDSA',
  },
  {
    id: 'jwt_payload',
    name: 'Payload Claims',
    description: 'The JSON object containing assertions about an entity (user, tenant, permissions) and metadata.',
    whyItMatters: 'Stores identity and authorization parameters such as roles, user IDs, and scopes.',
    typicalRange: 'Custom JSON object',
  },
  {
    id: 'exp_claim',
    name: 'Expiration Time (exp)',
    description: 'Unix epoch timestamp after which the JWT must NOT be accepted for processing.',
    whyItMatters: 'Protects against replay attacks if an access token is leaked. Short-lived tokens (5–15 mins) are standard.',
    typicalRange: 'Unix seconds (e.g. 1772839200)',
  },
  {
    id: 'iat_claim',
    name: 'Issued At (iat)',
    description: 'Timestamp when the token was generated by the authentication server.',
    whyItMatters: 'Used to determine the total age of the token and invalidate tokens issued before password changes.',
    typicalRange: 'Unix seconds',
  },
  {
    id: 'sub_claim',
    name: 'Subject (sub)',
    description: 'The principal that is the subject of the JWT (usually a user ID or service UUID).',
    whyItMatters: 'Identifies the authenticated user to downstream microservices.',
    typicalRange: 'User ID, UUID, or email',
  },
  {
    id: 'signature',
    name: 'Cryptographic Signature',
    description: 'Base64URL-encoded hash of the header and payload created with a secret key or private certificate.',
    whyItMatters: 'Guarantees the token was not tampered with in transit by an unauthorized party.',
    typicalRange: 'HMAC or Digital Signature',
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-jwt-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>100% Client-Side In-Memory Decoding</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JWT Token Decoder &amp; Inspector
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Decode JSON Web Tokens (JWT) into readable header and payload claims. Inspect expiration dates (exp), issued-at (iat) timestamps, and security parameters with zero server transmission.
      </p>
    </header>

    <!-- Expiration Telemetry Bar -->
    <div id="status-card" class="grid grid-cols-2 gap-3 sm:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center">
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Token Status</span>
        <span id="stat-status" class="font-mono text-sm font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">Active</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Algorithm</span>
        <span id="stat-alg" class="font-mono text-sm font-bold text-purple-600 dark:text-purple-400">HS256</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Issued At</span>
        <span id="stat-iat" class="font-mono text-xs font-bold text-[color:var(--fg)] truncate block px-2">-</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Expires At</span>
        <span id="stat-exp" class="font-mono text-xs font-bold text-[color:var(--fg)] truncate block px-2">-</span>
      </div>
    </div>

    <!-- Main Workspace -->
    <div class="space-y-6">
      <!-- Encoded JWT Input Area -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="jwt-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
            Encoded JWT Token (Header.Payload.Signature)
          </label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="font-semibold text-[color:var(--primary)] hover:underline cursor-pointer">Load Sample JWT</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">Clear</button>
          </div>
        </div>
        <textarea
          id="jwt-in"
          rows="5"
          class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Paste encoded JWT here (e.g. eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)"
        ></textarea>
        <div id="jwt-err" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-600 dark:text-rose-400 font-mono"></div>
      </div>

      <!-- Decoded Columns -->
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Header -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Header: Algorithm &amp; Token Type</span>
            <button type="button" id="copy-hdr-btn" class="text-xs font-bold text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">Copy</button>
          </div>
          <textarea
            id="jwt-header"
            rows="8"
            readonly
            class="w-full rounded-2xl border border-purple-500/30 bg-[color:var(--surface-strong)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:outline-hidden"
            placeholder="Decoded header..."
          ></textarea>
        </div>

        <!-- Payload -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Payload: Data Claims</span>
            <button type="button" id="copy-pay-btn" class="text-xs font-bold text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">Copy</button>
          </div>
          <textarea
            id="jwt-payload"
            rows="8"
            readonly
            class="w-full rounded-2xl border border-blue-500/30 bg-[color:var(--surface-strong)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:outline-hidden"
            placeholder="Decoded payload claims..."
          ></textarea>
        </div>
      </div>

      <!-- Standard Claims Summary Table -->
      <div id="claims-card" class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)]">Key Claims Inspection</h2>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
            <p class="text-[10px] uppercase tracking-wider text-[color:var(--muted)] font-bold">Subject (sub)</p>
            <p id="claim-sub" class="font-mono font-bold text-[color:var(--fg)] text-xs mt-1 truncate">-</p>
          </div>
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
            <p class="text-[10px] uppercase tracking-wider text-[color:var(--muted)] font-bold">Issuer (iss)</p>
            <p id="claim-iss" class="font-mono font-bold text-[color:var(--fg)] text-xs mt-1 truncate">-</p>
          </div>
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
            <p class="text-[10px] uppercase tracking-wider text-[color:var(--muted)] font-bold">Audience (aud)</p>
            <p id="claim-aud" class="font-mono font-bold text-[color:var(--fg)] text-xs mt-1 truncate">-</p>
          </div>
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
            <p class="text-[10px] uppercase tracking-wider text-[color:var(--muted)] font-bold">Issued At (iat)</p>
            <p id="claim-iat" class="font-mono text-xs text-[color:var(--fg)] mt-1">-</p>
          </div>
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
            <p class="text-[10px] uppercase tracking-wider text-[color:var(--muted)] font-bold">Expires (exp)</p>
            <p id="claim-exp" class="font-mono text-xs text-[color:var(--fg)] mt-1">-</p>
          </div>
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
            <p class="text-[10px] uppercase tracking-wider text-[color:var(--muted)] font-bold">Time Remaining</p>
            <p id="claim-remaining" class="font-mono font-bold text-xs mt-1 text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">-</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Step-by-Step Worked Example -->
    <section class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-[color:var(--accent)]/15 px-2.5 py-1 text-xs font-bold text-[color:var(--accent)]">Worked Example</span>
        <h2 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Decoding an OAuth2 User Access Token</h2>
      </div>
      <p>
        An OAuth2 / OpenID Connect provider returns a compact string composed of three dot-separated Base64URL segments:
      </p>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 font-mono text-xs overflow-x-auto">
        <span class="text-purple-500 font-bold">eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9</span>.<span class="text-blue-500 font-bold">eyJzdWIiOiJ1c3JfOTA5MiIsIm5hbWUiOiJBbGljZSBTbWl0aCIsImFkbWluIjp0cnVlLCJleHAiOjE3NzI4MzkyMDB9</span>.<span class="text-cyan-500 font-bold">TJVA95OrM7E2cBab30RMHrHDcEfxjoYZgeFONFh7HgQ</span>
      </div>
      <p class="text-xs text-[color:var(--muted)]">
        The decoder unpacks the purple header (Algorithm HS256) and blue payload claims (User ID <code>usr_9092</code>, Admin role <code>true</code>), and converts the Unix expiration timestamp <code>1772839200</code> into local human time.
      </p>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-jwt-app]');
      if (!root) return;

      const input = root.querySelector('#jwt-in');
      const headerOut = root.querySelector('#jwt-header');
      const payloadOut = root.querySelector('#jwt-payload');
      const errBox = root.querySelector('#jwt-err');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyHdrBtn = root.querySelector('#copy-hdr-btn');
      const copyPayBtn = root.querySelector('#copy-pay-btn');

      const statStatus = root.querySelector('#stat-status');
      const statAlg = root.querySelector('#stat-alg');
      const statIat = root.querySelector('#stat-iat');
      const statExp = root.querySelector('#stat-exp');

      const claimSub = root.querySelector('#claim-sub');
      const claimIss = root.querySelector('#claim-iss');
      const claimAud = root.querySelector('#claim-aud');
      const claimIat = root.querySelector('#claim-iat');
      const claimExp = root.querySelector('#claim-exp');
      const claimRemaining = root.querySelector('#claim-remaining');

      function b64UrlDecode(str) {
        let base64 = str.replace(/-/g, '+').replace(/_/g, '/');
        while (base64.length % 4) {
          base64 += '=';
        }
        return decodeURIComponent(escape(atob(base64)));
      }

      function formatUnixDate(sec) {
        if (!sec || isNaN(sec)) return '-';
        const d = new Date(sec * 1000);
        return d.toLocaleString() + ' (' + d.toISOString().replace('T', ' ').slice(0, 19) + ' UTC)';
      }

      function formatDuration(secDiff) {
        const abs = Math.abs(secDiff);
        const days = Math.floor(abs / 86400);
        const hours = Math.floor((abs % 86400) / 3600);
        const mins = Math.floor((abs % 3600) / 60);

        let str = '';
        if (days > 0) str += `${days}d `;
        if (hours > 0 || days > 0) str += `${hours}h `;
        str += `${mins}m`;

        return secDiff >= 0 ? `Expires in ${str}` : `Expired ${str} ago`;
      }

      function decode() {
        const raw = input.value.trim();
        if (!raw) {
          headerOut.value = '';
          payloadOut.value = '';
          errBox.classList.add('hidden');
          statStatus.textContent = 'Awaiting Input';
          statStatus.className = 'font-mono text-sm font-bold text-[color:var(--muted)]';
          statAlg.textContent = '-';
          statIat.textContent = '-';
          statExp.textContent = '-';
          claimSub.textContent = '-';
          claimIss.textContent = '-';
          claimAud.textContent = '-';
          claimIat.textContent = '-';
          claimExp.textContent = '-';
          claimRemaining.textContent = '-';
          return;
        }

        const parts = raw.split('.');
        if (parts.length < 2) {
          errBox.classList.remove('hidden');
          errBox.textContent = 'Invalid JWT format: A valid token contains 3 dot-separated Base64URL parts (Header.Payload.Signature).';
          headerOut.value = '';
          payloadOut.value = '';
          return;
        }

        try {
          const headerJson = b64UrlDecode(parts[0]);
          const payloadJson = b64UrlDecode(parts[1]);

          const headerObj = JSON.parse(headerJson);
          const payloadObj = JSON.parse(payloadJson);

          errBox.classList.add('hidden');
          headerOut.value = JSON.stringify(headerObj, null, 2);
          payloadOut.value = JSON.stringify(payloadObj, null, 2);

          // Update Alg
          statAlg.textContent = headerObj.alg || 'none';

          // Update Claims
          claimSub.textContent = payloadObj.sub || 'none';
          claimIss.textContent = payloadObj.iss || 'none';
          claimAud.textContent = typeof payloadObj.aud === 'object' ? JSON.stringify(payloadObj.aud) : (payloadObj.aud || 'none');

          const nowSec = Math.floor(Date.now() / 1000);

          if (payloadObj.iat) {
            statIat.textContent = new Date(payloadObj.iat * 1000).toLocaleTimeString();
            claimIat.textContent = formatUnixDate(payloadObj.iat);
          } else {
            statIat.textContent = 'None';
            claimIat.textContent = 'None specified';
          }

          if (payloadObj.exp) {
            statExp.textContent = new Date(payloadObj.exp * 1000).toLocaleTimeString();
            claimExp.textContent = formatUnixDate(payloadObj.exp);

            const diff = payloadObj.exp - nowSec;
            if (diff > 0) {
              statStatus.textContent = '🟢 Active';
              statStatus.className = 'font-mono text-sm font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400';
              claimRemaining.textContent = formatDuration(diff);
              claimRemaining.className = 'font-mono font-bold text-xs mt-1 text-cyan-600 dark:text-cyan-400 dark:text-cyan-400';
            } else {
              statStatus.textContent = '🔴 Expired';
              statStatus.className = 'font-mono text-sm font-bold text-rose-600 dark:text-rose-400';
              claimRemaining.textContent = formatDuration(diff);
              claimRemaining.className = 'font-mono font-bold text-xs mt-1 text-rose-600 dark:text-rose-400';
            }
          } else {
            statExp.textContent = 'Never (No exp)';
            claimExp.textContent = 'No expiration (exp) claim set';
            statStatus.textContent = '🟢 No Expiration';
            statStatus.className = 'font-mono text-sm font-bold text-blue-500';
            claimRemaining.textContent = 'Indefinite';
            claimRemaining.className = 'font-mono font-bold text-xs mt-1 text-blue-500';
          }
        } catch (e) {
          errBox.classList.remove('hidden');
          errBox.textContent = 'Decoding Error: Could not parse token parts as Base64URL JSON: ' + e.message;
          headerOut.value = '';
          payloadOut.value = '';
        }
      }

      input.addEventListener('input', decode);

      sampleBtn.addEventListener('click', () => {
        // Create sample token valid for 2 hours in the future
        const now = Math.floor(Date.now() / 1000);
        const header = btoa(JSON.stringify({ alg: "HS256", typ: "JWT" })).replace(/=/g, '');
        const payload = btoa(JSON.stringify({
          sub: "user_748201",
          name: "Alice Developer",
          role: "SiteAdmin",
          iss: "https://auth.calculatorutility.tech",
          aud: "https://api.calculatorutility.tech",
          iat: now - 300,
          exp: now + 7200
        })).replace(/=/g, '');
        input.value = `${header}.${payload}.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk`;
        decode();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        decode();
      });

      copyHdrBtn.addEventListener('click', () => {
        if (!headerOut.value) return;
        navigator.clipboard.writeText(headerOut.value);
        copyHdrBtn.textContent = 'Copied!';
        setTimeout(() => copyHdrBtn.textContent = 'Copy', 1800);
      });

      copyPayBtn.addEventListener('click', () => {
        if (!payloadOut.value) return;
        navigator.clipboard.writeText(payloadOut.value);
        copyPayBtn.textContent = 'Copied!';
        setTimeout(() => copyPayBtn.textContent = 'Copy', 1800);
      });

      // Init sample
      sampleBtn.click();
    })();
  </script>
</SiteLayout>
