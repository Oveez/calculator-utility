---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `JSON to CSV Converter — Free Online Table Exporter · ${siteName}`;
const pageDesc = 'Convert JSON arrays and objects to CSV tables online. Auto-flattens keys, supports custom delimiters (comma, tab, semicolon), and provides instant Excel download. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/json-to-csv/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'JSON to CSV' },
];

const schemaFaq = [
  {
    question: 'How does this tool handle nested JSON objects?',
    answer: 'Nested objects are serialized or flattened into stringified values with appropriate CSV quote escaping according to RFC 4180 standards.',
  },
  {
    question: 'Can I download the output as an Excel-ready file?',
    answer: 'Yes. Click "Download CSV" to save a `.csv` file directly to your device that opens natively in Microsoft Excel, Google Sheets, or Apple Numbers.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'JSON to CSV Converter',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-json-csv-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Tabular Transformation</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        JSON to CSV Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert JSON arrays and object lists into structured, comma-separated values (CSV) ready for Excel, Google Sheets, and SQL databases.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Input -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="json-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
            JSON Array Input
          </label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample Array</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="json-in"
          rows="16"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder='[{"id": 1, "name": "Alice", "role": "Engineer"}, {"id": 2, "name": "Bob", "role": "Designer"}]'
        ></textarea>
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <label for="csv-delim" class="text-xs font-medium text-[color:var(--muted)]">Delimiter:</label>
            <select id="csv-delim" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs text-[color:var(--fg)]">
              <option value=",">Comma (,)</option>
              <option value=";">Semicolon (;)</option>
              <option value="	">Tab (\t)</option>
              <option value="|">Pipe (|)</option>
            </select>
          </div>
          <button
            type="button"
            data-convert-btn
            class="rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
          >
            Convert to CSV
          </button>
        </div>
      </div>

      <!-- Output -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">CSV Output</span>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">
              Download CSV
            </button>
          </div>
        </div>
        <textarea
          id="csv-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="CSV table rows will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-json-csv-app]');
      if (!root) return;

      const input = root.querySelector('#json-in');
      const output = root.querySelector('#csv-out');
      const delimSelect = root.querySelector('#csv-delim');
      const convertBtn = root.querySelector('[data-convert-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      function convert() {
        const raw = input.value.trim();
        if (!raw) {
          output.value = '';
          return;
        }

        try {
          let data = JSON.parse(raw);
          if (!Array.isArray(data)) {
            data = [data]; // convert single object to array
          }

          if (data.length === 0) {
            output.value = '';
            return;
          }

          const delim = delimSelect.value;
          const headers = Array.from(new Set(data.flatMap(item => typeof item === 'object' && item !== null ? Object.keys(item) : [])));

          function escapeVal(v) {
            if (v === null || v === undefined) return '';
            const str = typeof v === 'object' ? JSON.stringify(v) : String(v);
            if (str.includes(delim) || str.includes('"') || str.includes('\n')) {
              return '"' + str.replace(/"/g, '""') + '"';
            }
            return str;
          }

          const headLine = headers.map(escapeVal).join(delim);
          const bodyLines = data.map(row => headers.map(h => escapeVal(row[h])).join(delim));

          output.value = [headLine, ...bodyLines].join('\n');
        } catch (e) {
          output.value = 'Invalid JSON: ' + e.message;
        }
      }

      convertBtn.addEventListener('click', convert);
      delimSelect.addEventListener('change', convert);

      sampleBtn.addEventListener('click', () => {
        input.value = JSON.stringify([
          { id: 101, product: "Wireless Mouse", price: 29.99, in_stock: true, department: "Electronics" },
          { id: 102, product: "Mechanical Keyboard", price: 89.50, in_stock: true, department: "Electronics" },
          { id: 103, product: "Desk Mat (Large)", price: 19.00, in_stock: false, department: "Office" }
        ], null, 2);
        convert();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'exported_data.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
