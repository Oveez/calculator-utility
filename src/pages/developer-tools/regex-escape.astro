---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Regex Escape Tool — Escape Special Regex Characters · ${siteName}`;
const pageDesc = 'Escape special regex characters (. * + ? ^ $ { } [ ] ( ) | \\ /) in literal strings for safe inclusion in dynamic JavaScript and backend RegExp constructors.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/regex-escape/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'Regex Escape' },
];

const schemaFaq = [
  {
    question: 'Why do literal strings need escaping before being passed to new RegExp()?',
    answer: 'Characters like `.`, `*`, `+`, `?`, `^`, `$`, `(`, `)`, `[`, `]`, `{`, `}`, `|`, and `\\` have special structural meanings in regular expressions. Escaping them with backslashes ensures they match literal punctuation rather than regex patterns.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Regex Special Character Escaper',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-regex-escape-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>RegExp Constructor Safety</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Regex Special Character Escaper
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Escape special regular expression metacharacters in literal text to safely use strings inside dynamic RegExp objects.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="esc-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Raw Literal String</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="esc-in"
          rows="12"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="e.g. price is $100.00 (or [10-20]%)"
        ></textarea>
        <button
          type="button"
          data-esc-btn
          class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Escape Special Characters
        </button>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Escaped Regex Pattern</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Pattern</span>
          </button>
        </div>
        <textarea
          id="esc-out"
          rows="12"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Escaped string will appear here..."
        ></textarea>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs space-y-1.5 text-[color:var(--muted)]">
          <p class="font-bold text-[color:var(--fg)]">Escaped Metacharacters:</p>
          <p class="font-mono">. * + ? ^ $ { } ( ) | [ ] \ /</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-regex-escape-app]');
      if (!root) return;

      const input = root.querySelector('#esc-in');
      const output = root.querySelector('#esc-out');
      const escBtn = root.querySelector('[data-esc-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      function update() {
        output.value = escapeRegex(input.value);
      }

      escBtn.addEventListener('click', update);
      input.addEventListener('input', update);

      sampleBtn.addEventListener('click', () => {
        input.value = 'Formula: [A + B] * (x / y)^2 = $100.00? Yes/No.';
        update();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
