---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `YAML to JSON Converter — Free Online Config Parser · ${siteName}`;
const pageDesc = 'Convert YAML files into valid structured JSON online. Handles key-value mappings, nested sequences, lists, and booleans. 100% private in-browser conversion.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/yaml-to-json/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'YAML to JSON' },
];

const schemaFaq = [
  {
    question: 'How does this tool convert YAML to JSON?',
    answer: 'It parses YAML line indentation, nested mappings, and lists in memory, converting them into standard ECMAScript objects before serializing to formatted JSON.',
  },
  {
    question: 'Is my YAML data sent to an external server?',
    answer: 'No. The conversion runs 100% locally in your browser memory. No files or text are uploaded anywhere.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'YAML to JSON Converter',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-yaml-json-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Config Parser</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        YAML to JSON Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert YAML configurations into standardized JSON format with formatted 2-space indentation.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="yaml-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">YAML Input</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Load Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="yaml-in"
          rows="16"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="server:&#10;  port: 8080&#10;  ssl: true&#10;routes:&#10;  - /api/v1&#10;  - /auth"
        ></textarea>
        <button
          type="button"
          data-convert-btn
          class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        >
          Convert to JSON
        </button>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">JSON Output</span>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">
              Download .json
            </button>
          </div>
        </div>
        <textarea
          id="json-out"
          rows="16"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Formatted JSON will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-yaml-json-app]');
      if (!root) return;

      const input = root.querySelector('#yaml-in');
      const output = root.querySelector('#json-out');
      const convertBtn = root.querySelector('[data-convert-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      // Lightweight client-side YAML parser
      function parseSimpleYaml(yamlStr) {
        const lines = yamlStr.split('\n');
        const rootObj = {};
        const stack = [{ obj: rootObj, indent: -1 }];

        function parseVal(val) {
          val = val.trim();
          if (val === 'true') return true;
          if (val === 'false') return false;
          if (val === 'null') return null;
          if (/^-?\d+(\.\d+)?$/.test(val)) return parseFloat(val);
          if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
            return val.slice(1, -1);
          }
          return val;
        }

        for (let i = 0; i < lines.length; i++) {
          const rawLine = lines[i];
          if (!rawLine.trim() || rawLine.trim().startsWith('#')) continue;

          const indent = rawLine.search(/\S/);
          const line = rawLine.trim();

          while (stack.length > 1 && indent <= stack[stack.length - 1].indent) {
            stack.pop();
          }
          const parent = stack[stack.length - 1].obj;

          if (line.startsWith('- ')) {
            const listVal = line.substring(2).trim();
            if (!Array.isArray(parent)) {
              // Convert current object key to array or push
            }
            if (Array.isArray(parent)) {
              parent.push(parseVal(listVal));
            }
          } else if (line.includes(':')) {
            const colonIdx = line.indexOf(':');
            const key = line.substring(0, colonIdx).trim();
            const rest = line.substring(colonIdx + 1).trim();

            if (!rest) {
              // Look ahead to see if list or object
              const nextLine = lines[i + 1] ? lines[i + 1].trim() : '';
              if (nextLine.startsWith('- ')) {
                parent[key] = [];
                stack.push({ obj: parent[key], indent });
              } else {
                parent[key] = {};
                stack.push({ obj: parent[key], indent });
              }
            } else {
              parent[key] = parseVal(rest);
            }
          }
        }
        return rootObj;
      }

      function convert() {
        const raw = input.value.trim();
        if (!raw) {
          output.value = '';
          return;
        }
        try {
          const obj = parseSimpleYaml(raw);
          output.value = JSON.stringify(obj, null, 2);
        } catch (e) {
          output.value = 'Failed to parse YAML: ' + e.message;
        }
      }

      convertBtn.addEventListener('click', convert);

      sampleBtn.addEventListener('click', () => {
        input.value = `server:\n  host: 0.0.0.0\n  port: 8080\n  ssl: true\nfeatures:\n  - calculators\n  - text-tools\n  - developer-tools\nversion: "2.4"`;
        convert();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'converted.json';
        a.click();
        URL.revokeObjectURL(url);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
