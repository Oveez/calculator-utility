---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `URL Percent Encoder & Decoder — Free Online Tool · ${siteName}`;
const pageDesc = 'Encode and decode URL parameters and query strings online. Converts special characters to percent-encoded hex codes (%20, %26) and decodes URLs back to readable text. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/url-encoder-decoder/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'URL Encoder / Decoder' },
];

const schemaFaq = [
  {
    question: 'What is the difference between encodeURI and encodeURIComponent?',
    answer: '`encodeURI` encodes a full URL while preserving reserved protocol and domain characters like ":", "/", "?", and "#". `encodeURIComponent` encodes all special characters, making it suitable for query parameter values.',
  },
  {
    question: 'Why do URLs need percent-encoding?',
    answer: 'Standard URLs only permit a subset of US-ASCII characters. Non-ASCII characters (spaces, ampersands, punctuation, emojis) must be percent-encoded so web servers can parse them unambiguously.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'URL Encoder & Decoder',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-url-enc-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>RFC 3986 URL Percent Encoding</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        URL Percent Encoder &amp; Decoder
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Encode query strings into percent-encoded ASCII or decode URL parameters back into human-readable text.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="url-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Input Text or URL</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="text-[color:var(--primary)] hover:underline font-semibold">Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)]">Clear</button>
          </div>
        </div>
        <textarea
          id="url-in"
          rows="14"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Enter text or URL to encode or decode..."
        ></textarea>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <label for="mode-select" class="text-xs font-medium text-[color:var(--muted)]">Encode Type:</label>
            <select id="mode-select" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs text-[color:var(--fg)]">
              <option value="component">Component (encodeURIComponent)</option>
              <option value="full">Full URL (encodeURI)</option>
            </select>
          </div>
          <div class="flex gap-2">
            <button type="button" data-enc-btn class="rounded-xl bg-[color:var(--fg)] px-4 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90">
              Encode URL
            </button>
            <button type="button" data-dec-btn class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-2 text-xs font-bold text-[color:var(--fg)] transition hover:bg-[color:var(--surface-strong)]">
              Decode URL
            </button>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Result Output</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy</span>
          </button>
        </div>
        <textarea
          id="url-out"
          rows="14"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Encoded or decoded result will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-url-enc-app]');
      if (!root) return;

      const input = root.querySelector('#url-in');
      const output = root.querySelector('#url-out');
      const modeSelect = root.querySelector('#mode-select');
      const encBtn = root.querySelector('[data-enc-btn]');
      const decBtn = root.querySelector('[data-dec-btn]');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');
      const sampleBtn = root.querySelector('[data-sample-btn]');

      function encode() {
        const text = input.value;
        if (!text) { output.value = ''; return; }
        output.value = modeSelect.value === 'full' ? encodeURI(text) : encodeURIComponent(text);
      }

      function decode() {
        const text = input.value;
        if (!text) { output.value = ''; return; }
        try {
          output.value = decodeURIComponent(text.replace(/\+/g, ' '));
        } catch (e) {
          output.value = 'Failed to decode: ' + e.message;
        }
      }

      encBtn.addEventListener('click', encode);
      decBtn.addEventListener('click', decode);

      sampleBtn.addEventListener('click', () => {
        input.value = 'https://example.com/search?query=hello world & categories=tools&calc=100%';
        encode();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        output.value = '';
      });

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      sampleBtn.click();
    })();
  </script>
</SiteLayout>
