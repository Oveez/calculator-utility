---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Cryptographic Hash Generator — MD5, SHA-1, SHA-256, SHA-512 · ${siteName}`;
const pageDesc = 'Generate MD5, SHA-1, SHA-256, SHA-384, and SHA-512 cryptographic hashes online. Includes HMAC secret keys, hex/base64 casing, and native Web Crypto API. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/developer-tools/hash-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Developer Tools', href: toAbsoluteUrl('/developer-tools/') },
  { label: 'Hash Generator' },
];

const schemaFaq = [
  {
    question: 'How are cryptographic hashes calculated on this page?',
    answer: 'SHA family hashes (SHA-1, SHA-256, SHA-384, SHA-512) are computed using the browser’s native crypto.subtle Web Crypto API, providing hardware-accelerated, collision-resistant hashing directly on your device.',
  },
  {
    question: 'Is MD5 still safe for cryptographic passwords?',
    answer: 'No. MD5 is cryptographically broken due to practical collision vulnerabilities. It should only be used for fast non-security checksums (like file integrity checks) or legacy API compatibility. For security, use SHA-256 or SHA-512 with salts or Argon2/bcrypt.',
  },
  {
    question: 'Does this tool support HMAC (Keyed-Hash Message Authentication Code)?',
    answer: 'Yes. Enabling HMAC mode allows providing a secret key to compute keyed message authentication digests used in API request signing (e.g. AWS Signature v4, Stripe webhooks).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Cryptographic Hash Generator',
    url: canonicalUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuide = [
  {
    id: 'sha256',
    name: 'SHA-256 (256-bit)',
    description: 'NIST FIPS 180-4 standard hashing algorithm producing a 64-character hexadecimal digest.',
    whyItMatters: 'Industry standard for SSL/TLS certificates, Bitcoin proof-of-work, Git commit trees, and API checksums.',
    typicalRange: '64 hex chars / 256 bits',
  },
  {
    id: 'sha512',
    name: 'SHA-512 (512-bit)',
    description: 'Extended SHA-2 family member operating on 64-bit words, producing a 128-character hexadecimal digest.',
    whyItMatters: 'Offers the highest theoretical security margin against quantum collision attacks.',
    typicalRange: '128 hex chars / 512 bits',
  },
  {
    id: 'hmac_mode',
    name: 'HMAC (Keyed Hash)',
    description: 'Combines a secret cryptographic key with message data using an underlying hash function.',
    whyItMatters: 'Verifies both data integrity and sender authenticity for webhook signatures (GitHub, Stripe, Shopify).',
    typicalRange: 'Secret key + Message digest',
  },
  {
    id: 'output_casing',
    name: 'Output Format (Hex vs Base64)',
    description: 'Transforms binary hash bytes into lowercase hexadecimal, uppercase hex, or compact Base64 strings.',
    whyItMatters: 'Allows matching expected API header formats without extra conversion steps.',
    typicalRange: 'Lowercase Hex, Uppercase Hex, Base64',
  },
  {
    id: 'md5_legacy',
    name: 'MD5 (128-bit)',
    description: 'Legacy 32-character digest algorithm developed by Ronald Rivest in 1991.',
    whyItMatters: 'Widely used in Content-MD5 headers and file deduplication, but unsafe for passwords.',
    typicalRange: '32 hex characters',
  },
  {
    id: 'web_crypto',
    name: 'Web Crypto Hardware Acceleration',
    description: 'Executes within the browser sandbox using compiled native C++ crypto modules in the browser engine.',
    whyItMatters: 'Yields sub-millisecond hashing performance while guaranteeing zero network leaks.',
    typicalRange: '100% In-Browser',
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-hash-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Hardware-Accelerated Web Crypto API</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Cryptographic Hash Generator
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate MD5, SHA-1, SHA-256, SHA-384, and SHA-512 cryptographic digests. Supports HMAC secret signing, hex/base64 formats, and live string metrics with zero server transmission.
      </p>
    </header>

    <!-- Metrics Bar -->
    <div id="stats-bar" class="grid grid-cols-2 gap-3 sm:grid-cols-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-center">
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Input Length</span>
        <span id="stat-len" class="font-mono text-lg font-bold text-[color:var(--fg)]">43 chars</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Input Byte Size</span>
        <span id="stat-bytes" class="font-mono text-lg font-bold text-[color:var(--fg)]">43 B</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Active Mode</span>
        <span id="stat-mode" class="font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400 truncate block px-2">Standard Hash</span>
      </div>
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-[color:var(--muted)]">Engine</span>
        <span class="font-mono text-xs font-bold text-purple-600 dark:text-purple-400 truncate block px-2">crypto.subtle</span>
      </div>
    </div>

    <!-- Main Workspace -->
    <div class="space-y-6">
      <!-- Input -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="hash-in" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Input Text</label>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-sample-btn class="font-semibold text-[color:var(--primary)] hover:underline cursor-pointer">Sample</button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-clear-btn class="text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">Clear</button>
          </div>
        </div>
        <textarea
          id="hash-in"
          rows="4"
          class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 font-mono text-xs leading-relaxed text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="Type or paste text to generate cryptographic hashes..."
        >The quick brown fox jumps over the lazy dog</textarea>

        <!-- Options Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
          <div class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
              <label for="casing-select" class="font-medium text-[color:var(--muted)]">Format:</label>
              <select id="casing-select" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-2.5 py-1 text-xs text-[color:var(--fg)]">
                <option value="hex-lower">Lowercase Hex</option>
                <option value="hex-upper">Uppercase Hex</option>
                <option value="base64">Base64 Encoded</option>
              </select>
            </div>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" id="hmac-toggle" class="rounded border-[color:var(--border)] accent-[color:var(--fg)]" />
              <span class="font-semibold text-[color:var(--fg)]">Enable HMAC Secret Key</span>
            </label>
          </div>

          <div id="hmac-wrapper" class="hidden flex items-center gap-2 flex-1 max-w-sm">
            <label for="hmac-key" class="font-bold text-[color:var(--fg)]">Key:</label>
            <input
              type="text"
              id="hmac-key"
              placeholder="Enter secret HMAC key..."
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1.5 font-mono text-xs text-[color:var(--fg)] focus:outline-hidden"
              value="secret-key-123" />
          </div>
        </div>
      </div>

      <!-- Hash Results Grid -->
      <div class="space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Calculated Hash Digests</h2>

        <!-- SHA-256 -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-[color:var(--fg)]" id="label-sha256">SHA-256 (256-bit)</span>
              <span class="rounded bg-cyan-500/15 px-2 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400">Industry Standard</span>
            </div>
            <button type="button" data-copy-hash="sha256" class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span>Copy</span>
            </button>
          </div>
          <p id="hash-sha256" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3 font-mono text-xs text-[color:var(--fg)] break-all select-all">-</p>
        </div>

        <!-- SHA-512 -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-[color:var(--fg)]" id="label-sha512">SHA-512 (512-bit)</span>
              <span class="rounded bg-purple-500/15 px-2 py-0.5 text-[10px] font-bold text-purple-600 dark:text-purple-400">High Security</span>
            </div>
            <button type="button" data-copy-hash="sha512" class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span>Copy</span>
            </button>
          </div>
          <p id="hash-sha512" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3 font-mono text-xs text-[color:var(--fg)] break-all select-all">-</p>
        </div>

        <!-- SHA-384 -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-xs text-[color:var(--fg)]" id="label-sha384">SHA-384 (384-bit)</span>
            <button type="button" data-copy-hash="sha384" class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span>Copy</span>
            </button>
          </div>
          <p id="hash-sha384" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3 font-mono text-xs text-[color:var(--fg)] break-all select-all">-</p>
        </div>

        <!-- SHA-1 -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-[color:var(--fg)]" id="label-sha1">SHA-1 (160-bit)</span>
              <span class="rounded bg-amber-500/15 px-2 py-0.5 text-[10px] font-bold text-amber-600 dark:text-amber-400">Git / Legacy</span>
            </div>
            <button type="button" data-copy-hash="sha1" class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span>Copy</span>
            </button>
          </div>
          <p id="hash-sha1" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3 font-mono text-xs text-[color:var(--fg)] break-all select-all">-</p>
        </div>

        <!-- MD5 (Standard Hash only) -->
        <div id="md5-card" class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-[color:var(--fg)]">MD5 (128-bit)</span>
              <span class="rounded bg-rose-500/15 px-2 py-0.5 text-[10px] font-bold text-rose-600 dark:text-rose-400">Checksum Only</span>
            </div>
            <button type="button" data-copy-hash="md5" class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer">
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span>Copy</span>
            </button>
          </div>
          <p id="hash-md5" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3 font-mono text-xs text-[color:var(--fg)] break-all select-all">-</p>
        </div>
      </div>
    </div>

    <!-- Step-by-Step Worked Example -->
    <section class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-[color:var(--accent)]/15 px-2.5 py-1 text-xs font-bold text-[color:var(--accent)]">Worked Example</span>
        <h2 class="text-base sm:text-lg font-bold text-[color:var(--fg)]">Standard Benchmark: "The quick brown fox jumps over the lazy dog"</h2>
      </div>
      <p>
        Cryptographic algorithms produce fixed-length deterministic digests from arbitrary text:
      </p>
      <div class="space-y-2 font-mono text-xs">
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 break-all">
          <span class="text-[color:var(--muted)] block font-bold font-sans text-[11px]">SHA-256 Digest (64 Hex Characters):</span>
          d7a8fbb307d7809469ca9abcb0082e4f8d5651e468d7525f6183e2a4f383a8b4
        </div>
        <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 break-all">
          <span class="text-[color:var(--muted)] block font-bold font-sans text-[11px]">MD5 Checksum (32 Hex Characters):</span>
          9e107d9d372bb6826bd81d3542a419d6
        </div>
      </div>
      <p class="text-xs text-[color:var(--muted)]">
        Notice how changing even a single period or character completely transforms every bit of the output due to the avalanche effect.
      </p>
    </section>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-hash-app]');
      if (!root) return;

      const input = root.querySelector('#hash-in');
      const casingSelect = root.querySelector('#casing-select');
      const hmacToggle = root.querySelector('#hmac-toggle');
      const hmacWrapper = root.querySelector('#hmac-wrapper');
      const hmacKey = root.querySelector('#hmac-key');

      const statLen = root.querySelector('#stat-len');
      const statBytes = root.querySelector('#stat-bytes');
      const statMode = root.querySelector('#stat-mode');

      const outSha256 = root.querySelector('#hash-sha256');
      const outSha512 = root.querySelector('#hash-sha512');
      const outSha384 = root.querySelector('#hash-sha384');
      const outSha1 = root.querySelector('#hash-sha1');
      const outMd5 = root.querySelector('#hash-md5');
      const md5Card = root.querySelector('#md5-card');

      const labelSha256 = root.querySelector('#label-sha256');
      const labelSha512 = root.querySelector('#label-sha512');
      const labelSha384 = root.querySelector('#label-sha384');
      const labelSha1 = root.querySelector('#label-sha1');

      const sampleBtn = root.querySelector('[data-sample-btn]');
      const clearBtn = root.querySelector('[data-clear-btn]');

      // MD5 in pure JS
      function md5(string) {
        function rotateLeft(lValue, iShiftBits) {
          return (lValue << iShiftBits) | (lValue >>> (32 - iShiftBits));
        }
        function addUnsigned(lX, lY) {
          const lX8 = (lX & 0x80000000);
          const lY8 = (lY & 0x80000000);
          const lX4 = (lX & 0x40000000);
          const lY4 = (lY & 0x40000000);
          const lResult = (lX & 0x3FFFFFFF) + (lY & 0x3FFFFFFF);
          if (lX4 & lY4) return (lResult ^ 0x80000000 ^ lX8 ^ lY8);
          if (lX4 | lY4) {
            if (lResult & 0x40000000) return (lResult ^ 0xC0000000 ^ lX8 ^ lY8);
            return (lResult ^ 0x40000000 ^ lX8 ^ lY8);
          }
          return (lResult ^ lX8 ^ lY8);
        }
        function F(x, y, z) { return (x & y) | ((~x) & z); }
        function G(x, y, z) { return (x & z) | (y & (~z)); }
        function H(x, y, z) { return (x ^ y ^ z); }
        function I(x, y, z) { return (y ^ (x | (~z))); }
        function FF(a, b, c, d, x, s, ac) {
          a = addUnsigned(a, addUnsigned(addUnsigned(F(b, c, d), x), ac));
          return addUnsigned(rotateLeft(a, s), b);
        }
        function GG(a, b, c, d, x, s, ac) {
          a = addUnsigned(a, addUnsigned(addUnsigned(G(b, c, d), x), ac));
          return addUnsigned(rotateLeft(a, s), b);
        }
        function HH(a, b, c, d, x, s, ac) {
          a = addUnsigned(a, addUnsigned(addUnsigned(H(b, c, d), x), ac));
          return addUnsigned(rotateLeft(a, s), b);
        }
        function II(a, b, c, d, x, s, ac) {
          a = addUnsigned(a, addUnsigned(addUnsigned(I(b, c, d), x), ac));
          return addUnsigned(rotateLeft(a, s), b);
        }
        function convertToWordArray(str) {
          let lWordCount;
          const lMessageLength = str.length;
          const lNumberOfWords_temp1 = lMessageLength + 8;
          const lNumberOfWords_temp2 = (lNumberOfWords_temp1 - (lNumberOfWords_temp1 % 64)) / 64;
          const lNumberOfWords = (lNumberOfWords_temp2 + 1) * 16;
          const lWordArray = new Array(lNumberOfWords - 1);
          let lBytePosition = 0;
          let lByteCount = 0;
          while (lByteCount < lMessageLength) {
            lWordCount = (lByteCount - (lByteCount % 4)) / 4;
            lBytePosition = (lByteCount % 4) * 8;
            lWordArray[lWordCount] = (lWordArray[lWordCount] | (str.charCodeAt(lByteCount) << lBytePosition));
            lByteCount++;
          }
          lWordCount = (lByteCount - (lByteCount % 4)) / 4;
          lBytePosition = (lByteCount % 4) * 8;
          lWordArray[lWordCount] = lWordArray[lWordCount] | (0x80 << lBytePosition);
          lWordArray[lNumberOfWords - 2] = lMessageLength << 3;
          lWordArray[lNumberOfWords - 1] = lMessageLength >>> 29;
          return lWordArray;
        }
        function wordToHex(lValue) {
          let wordToHexValue = '', wordToHexValue_temp = '', lByte, lCount;
          for (lCount = 0; lCount <= 3; lCount++) {
            lByte = (lValue >>> (lCount * 8)) & 255;
            wordToHexValue_temp = '0' + lByte.toString(16);
            wordToHexValue += wordToHexValue_temp.slice(-2);
          }
          return wordToHexValue;
        }

        const x = convertToWordArray(unescape(encodeURIComponent(string)));
        let a = 0x67452301, b = 0xEFCDAB89, c = 0x98BADCFE, d = 0x10325476;
        for (let k = 0; k < x.length; k += 16) {
          const AA = a, BB = b, CC = c, DD = d;
          a = FF(a, b, c, d, x[k + 0], 7, 0xD76AA478); d = FF(d, a, b, c, x[k + 1], 12, 0xE8C7B756);
          c = FF(c, d, a, b, x[k + 2], 17, 0x242070DB); b = FF(b, c, d, a, x[k + 3], 22, 0xC1BDCEEE);
          a = FF(a, b, c, d, x[k + 4], 7, 0xF57C0FAF); d = FF(d, a, b, c, x[k + 5], 12, 0x4787C62A);
          c = FF(c, d, a, b, x[k + 6], 17, 0xA8304613); b = FF(b, c, d, a, x[k + 7], 22, 0xFD469501);
          a = FF(a, b, c, d, x[k + 8], 7, 0x698098D8); d = FF(d, a, b, c, x[k + 9], 12, 0x8B44F7AF);
          c = FF(c, d, a, b, x[k + 10], 17, 0xFFFF5BB1); b = FF(b, c, d, a, x[k + 11], 22, 0x895CD7BE);
          a = FF(a, b, c, d, x[k + 12], 7, 0x6B901122); d = FF(d, a, b, c, x[k + 13], 12, 0xFD987193);
          c = FF(c, d, a, b, x[k + 14], 17, 0xA679438E); b = FF(b, c, d, a, x[k + 15], 22, 0x49B40821);
          a = GG(a, b, c, d, x[k + 1], 5, 0xF61E2562); d = GG(d, a, b, c, x[k + 6], 9, 0xC040B340);
          c = GG(c, d, a, b, x[k + 11], 14, 0x265E5A51); b = GG(b, c, d, a, x[k + 0], 20, 0xE9B6C7AA);
          a = GG(a, b, c, d, x[k + 5], 5, 0xD62F105D); d = GG(d, a, b, c, x[k + 10], 9, 0x2441453);
          c = GG(c, d, a, b, x[k + 15], 14, 0xD8A1E681); b = GG(b, c, d, a, x[k + 4], 20, 0xE7D3FBC8);
          a = GG(a, b, c, d, x[k + 9], 5, 0x21E1CDE6); d = GG(d, a, b, c, x[k + 14], 9, 0xC33707D6);
          c = GG(c, d, a, b, x[k + 3], 14, 0xF4D50D87); b = GG(b, c, d, a, x[k + 8], 20, 0x455A14ED);
          a = GG(a, b, c, d, x[k + 13], 5, 0xA9E3E905); d = GG(d, a, b, c, x[k + 2], 9, 0xFCEFA3F8);
          c = GG(c, d, a, b, x[k + 7], 14, 0x676F02D9); b = GG(b, c, d, a, x[k + 12], 20, 0x8D2A4C8A);
          a = HH(a, b, c, d, x[k + 5], 4, 0xFFFA3942); d = HH(d, a, b, c, x[k + 8], 11, 0x8771F681);
          c = HH(c, d, a, b, x[k + 11], 16, 0x6D9D6122); b = HH(b, c, d, a, x[k + 14], 23, 0xFDE5380C);
          a = HH(a, b, c, d, x[k + 1], 4, 0xA4BEEA44); d = HH(d, a, b, c, x[k + 4], 11, 0x4BDECFA9);
          c = HH(c, d, a, b, x[k + 7], 16, 0xF6BB4B60); b = HH(b, c, d, a, x[k + 10], 23, 0xBEBFBC70);
          a = HH(a, b, c, d, x[k + 13], 4, 0x289B7EC6); d = HH(d, a, b, c, x[k + 0], 11, 0xEAA127FA);
          c = HH(c, d, a, b, x[k + 3], 16, 0xD4EF3085); b = HH(b, c, d, a, x[k + 6], 23, 0x4881D05);
          a = HH(a, b, c, d, x[k + 9], 4, 0xD9D4D039); d = HH(d, a, b, c, x[k + 12], 11, 0xE6DB99E5);
          c = HH(c, d, a, b, x[k + 15], 16, 0x1FA27CF8); b = HH(b, c, d, a, x[k + 2], 23, 0xC4AC5665);
          a = II(a, b, c, d, x[k + 0], 6, 0xF4292244); d = II(d, a, b, c, x[k + 7], 10, 0x432AFF97);
          c = II(c, d, a, b, x[k + 14], 15, 0xAB9423A7); b = II(b, c, d, a, x[k + 5], 21, 0xFC93A039);
          a = II(a, b, c, d, x[k + 12], 6, 0x655B59C3); d = II(d, a, b, c, x[k + 3], 10, 0x8F0CCC92);
          c = II(c, d, a, b, x[k + 10], 15, 0xFFEFF47D); b = II(b, c, d, a, x[k + 1], 21, 0x85845DD1);
          a = II(a, b, c, d, x[k + 8], 6, 0x6FA87E4F); d = II(d, a, b, c, x[k + 15], 10, 0xFE2CE6E0);
          c = II(c, d, a, b, x[k + 6], 15, 0xA3014314); b = II(b, c, d, a, x[k + 13], 21, 0x4E0811A1);
          a = II(a, b, c, d, x[k + 4], 6, 0xF7537E82); d = II(d, a, b, c, x[k + 11], 10, 0xBD3AF235);
          c = II(c, d, a, b, x[k + 2], 15, 0x2AD7D2BB); b = II(b, c, d, a, x[k + 9], 21, 0xEB86D391);
          a = addUnsigned(a, AA); b = addUnsigned(b, BB); c = addUnsigned(c, CC); d = addUnsigned(d, DD);
        }
        return (wordToHex(a) + wordToHex(b) + wordToHex(c) + wordToHex(d)).toLowerCase();
      }

      function bufferToFormat(buf, format) {
        const arr = Array.from(new Uint8Array(buf));
        if (format === 'base64') {
          const binary = arr.map(b => String.fromCharCode(b)).join('');
          return btoa(binary);
        }
        const hex = arr.map(b => b.toString(16).padStart(2, '0')).join('');
        return format === 'hex-upper' ? hex.toUpperCase() : hex.toLowerCase();
      }

      async function computeStandardHash(algoName, text, format) {
        const enc = new TextEncoder();
        const buf = await crypto.subtle.digest(algoName, enc.encode(text));
        return bufferToFormat(buf, format);
      }

      async function computeHmac(algoName, keyStr, text, format) {
        const enc = new TextEncoder();
        const keyData = enc.encode(keyStr);
        const msgData = enc.encode(text);

        const cryptoKey = await crypto.subtle.importKey(
          'raw',
          keyData,
          { name: 'HMAC', hash: { name: algoName } },
          false,
          ['sign']
        );

        const sig = await crypto.subtle.sign('HMAC', cryptoKey, msgData);
        return bufferToFormat(sig, format);
      }

      async function updateHashes() {
        const text = input.value;
        const format = casingSelect.value;
        const isHmac = hmacToggle.checked;
        const key = hmacKey.value;

        statLen.textContent = `${text.length} chars`;
        statBytes.textContent = `${new Blob([text]).size} B`;

        if (isHmac) {
          hmacWrapper.classList.remove('hidden');
          md5Card.classList.add('hidden'); // Web Crypto subtle doesn't support HMAC-MD5
          statMode.textContent = 'HMAC Keyed Hash';
          statMode.className = 'font-mono text-xs font-bold text-purple-600 dark:text-purple-400 truncate block px-2';

          labelSha256.textContent = 'HMAC-SHA256';
          labelSha512.textContent = 'HMAC-SHA512';
          labelSha384.textContent = 'HMAC-SHA384';
          labelSha1.textContent = 'HMAC-SHA1';

          try {
            outSha256.textContent = await computeHmac('SHA-256', key, text, format);
            outSha512.textContent = await computeHmac('SHA-512', key, text, format);
            outSha384.textContent = await computeHmac('SHA-384', key, text, format);
            outSha1.textContent = await computeHmac('SHA-1', key, text, format);
          } catch (e) {
            outSha256.textContent = 'Error computing HMAC: ' + e.message;
          }
        } else {
          hmacWrapper.classList.add('hidden');
          md5Card.classList.remove('hidden');
          statMode.textContent = 'Standard Digest';
          statMode.className = 'font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400 dark:text-cyan-400 truncate block px-2';

          labelSha256.textContent = 'SHA-256 (256-bit)';
          labelSha512.textContent = 'SHA-512 (512-bit)';
          labelSha384.textContent = 'SHA-384 (384-bit)';
          labelSha1.textContent = 'SHA-1 (160-bit)';

          try {
            outSha256.textContent = await computeStandardHash('SHA-256', text, format);
            outSha512.textContent = await computeStandardHash('SHA-512', text, format);
            outSha384.textContent = await computeStandardHash('SHA-384', text, format);
            outSha1.textContent = await computeStandardHash('SHA-1', text, format);

            const rawMd5 = md5(text);
            if (format === 'hex-upper') {
              outMd5.textContent = rawMd5.toUpperCase();
            } else if (format === 'base64') {
              const hexBytes = rawMd5.match(/.{1,2}/g).map(byte => String.fromCharCode(parseInt(byte, 16))).join('');
              outMd5.textContent = btoa(hexBytes);
            } else {
              outMd5.textContent = rawMd5.toLowerCase();
            }
          } catch (e) {
            outSha256.textContent = 'Error: ' + e.message;
          }
        }
      }

      input.addEventListener('input', () => {
        clearTimeout(input._timer);
        input._timer = setTimeout(updateHashes, 150);
      });

      casingSelect.addEventListener('change', updateHashes);
      hmacToggle.addEventListener('change', updateHashes);
      hmacKey.addEventListener('input', () => {
        clearTimeout(hmacKey._timer);
        hmacKey._timer = setTimeout(updateHashes, 200);
      });

      sampleBtn.addEventListener('click', () => {
        input.value = "The quick brown fox jumps over the lazy dog";
        updateHashes();
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        updateHashes();
      });

      // Individual Copy Handlers
      root.querySelectorAll('[data-copy-hash]').forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.dataset.copyHash;
          const targetEl = root.querySelector(`#hash-${type}`);
          if (!targetEl || !targetEl.textContent || targetEl.textContent === '-') return;

          navigator.clipboard.writeText(targetEl.textContent);
          const span = btn.querySelector('span');
          const orig = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => span.textContent = orig, 1800);
        });
      });

      // Initialize
      updateHashes();
    })();
  </script>
