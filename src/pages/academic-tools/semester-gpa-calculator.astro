---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const parameterGuide = [
  { id: 'courseCredits', name: 'Course Credits', description: 'Credit hours or contact units assigned to the course (typically 3 to 4 credits).', whyItMatters: 'Weights the impact of the course grade on your overall term average.', typicalRange: '1.0 to 5.0 credits', unit: 'credits' },
  { id: 'letterGrade', name: 'Letter Grade', description: 'Standard collegiate letter grade earned (A, A-, B+, B, B-, C+, C, D, F).', whyItMatters: 'Converts directly into numeric grade points on the 4.0 scale (A=4.0, B=3.0, C=2.0).', typicalRange: 'A+ to F' },
  { id: 'qualityPoints', name: 'Quality Points', description: 'Credit hours multiplied by numeric grade points.', whyItMatters: 'The fundamental numerator used to compute term GPA (Quality Points ÷ Total Credits).', typicalRange: '0 to 20 pts' },
  { id: 'priorCredits', name: 'Prior Cumulative Credits', description: 'Total academic credits completed in earlier college semesters.', whyItMatters: 'Dilutes term volatility when projecting your updated cumulative GPA.', typicalRange: '0 to 120+ credits', unit: 'credits' },
  { id: 'priorGpa', name: 'Prior Cumulative GPA', description: 'Your existing cumulative GPA prior to the current term.', whyItMatters: 'Combined with new semester quality points to calculate updated overall standing.', typicalRange: '0.0 to 4.0' },
];

const pageTitle = `Semester GPA Calculator | College & University 4.0 Scale · ${siteName}`;
const pageDesc = 'Calculate your weighted semester GPA on a standard 4.0 scale with credit hours and letter grades. Add multiple courses and project your new cumulative GPA.';
const canonicalUrl = toAbsoluteUrl('/academic-tools/semester-gpa-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Academic Tools', href: toAbsoluteUrl('/academic-tools/') },
  { label: 'Semester GPA Calculator' },
];

const faqs = [
  {
    question: 'How is weighted semester GPA calculated?',
    answer: 'Semester GPA is calculated by multiplying each course’s credit hours by its grade point value (e.g., A = 4.0, B = 3.0) to get Quality Points, then dividing the sum of all quality points by total semester credit hours: Semester GPA = Total Quality Points ÷ Total Credits.',
  },
  {
    question: 'What is the standard 4.0 college grade scale?',
    answer: 'Standard letter values are: A = 4.0, A- = 3.7, B+ = 3.3, B = 3.0, B- = 2.7, C+ = 2.3, C = 2.0, C- = 1.7, D+ = 1.3, D = 1.0, and F = 0.0.',
  },
  {
    question: 'How do prior credits impact my cumulative GPA?',
    answer: 'Your new cumulative GPA combines prior earned quality points with this semester’s quality points: Cumulative GPA = (Prior Points + Semester Points) ÷ (Prior Credits + Semester Credits).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Semester GPA Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>University Grade Scale</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Semester GPA Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Compute your term GPA with precision. Add individual courses, assign credit weights, select letter grades, and view your updated cumulative GPA instantaneously.
      </p>
    </header>

    <!-- Interactive Semester GPA App -->
    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-semester-gpa-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Current Semester Courses</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset Courses
            </button>
          </div>

          <!-- Dynamic Courses Container -->
          <div class="space-y-3" data-courses-list>
            <!-- Injected rows via JS -->
          </div>

          <button
            type="button"
            class="inline-flex items-center gap-2 cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-2 text-xs font-bold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition"
            data-add-course-btn
          >
            <span>+ Add Course</span>
          </button>

          <!-- Prior Cumulative GPA Section (Optional) -->
          <div class="pt-4 border-t border-[color:var(--border)] space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Prior Cumulative History (Optional)</h3>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="prior-gpa" class="block text-xs font-medium text-[color:var(--muted)]">Prior Cumulative GPA</label>
                <input
                  id="prior-gpa"
                  type="number"
                  min="0"
                  max="4.0"
                  step="0.01"
                  class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none"
                  data-prior-gpa placeholder="e.g. 3.45" />
              </div>
              <div>
                <label for="prior-credits" class="block text-xs font-medium text-[color:var(--muted)]">Prior Total Credits</label>
                <input
                  id="prior-credits"
                  type="number"
                  min="0"
                  step="1"
                  class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none"
                  data-prior-credits placeholder="e.g. 45" />
              </div>
            </div>
          </div>
        </div>

        <!-- GPA Output Panel -->
        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Semester Score</span>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Weighted Semester GPA</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-gpa>
                3.60
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-gpa-standing>
                Academic Honors Standing (Dean's List Range)
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Total Semester Credits:</span>
                <span class="font-bold text-[color:var(--fg)]" data-total-credits>15</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Total Quality Points:</span>
                <span class="font-bold text-[color:var(--fg)]" data-total-points>54.00</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="font-bold text-[color:var(--fg)]">Updated Cumulative GPA:</span>
                <span class="font-bold text-[color:var(--accent)]" data-res-cumulative>3.49</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Parameter Guide -->
    <CalculatorParameterGuide parameters={parameterGuide} />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-semester-gpa-app]');
      if (!root) return;

      const coursesList = root.querySelector('[data-courses-list]');
      const addBtn = root.querySelector('[data-add-course-btn]');
      const resetBtn = root.querySelector('[data-reset-btn]');
      const inPriorGpa = root.querySelector('[data-prior-gpa]');
      const inPriorCredits = root.querySelector('[data-prior-credits]');
      const resGpa = root.querySelector('[data-res-gpa]');
      const gpaStanding = root.querySelector('[data-gpa-standing]');
      const totalCredits = root.querySelector('[data-total-credits]');
      const totalPoints = root.querySelector('[data-total-points]');
      const resCumulative = root.querySelector('[data-res-cumulative]');

      const gradePoints = {
        'A+': 4.0, A: 4.0, 'A-': 3.7,
        'B+': 3.3, B: 3.0, 'B-': 2.7,
        'C+': 2.3, C: 2.0, 'C-': 1.7,
        'D+': 1.3, D: 1.0, F: 0.0
      };

      let courses = [
        { name: 'Calculus II', credits: 4, grade: 'A' },
        { name: 'Computer Science I', credits: 4, grade: 'A-' },
        { name: 'Physics & Lab', credits: 4, grade: 'B+' },
        { name: 'Academic Writing', credits: 3, grade: 'B' },
      ];

      function renderCourses() {
        if (!coursesList) return;
        coursesList.innerHTML = courses.map((c, i) => `
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr_auto] gap-2 items-center p-2.5 rounded-2xl bg-[color:var(--surface)] border border-[color:var(--border)]">
            <input
              type="text"
              value="${c.name}"
              placeholder="Course name"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none"
              data-course-name="${i}" />
            <input
              type="number"
              min="0.5"
              max="12"
              step="0.5"
              value="${c.credits}"
              placeholder="Credits"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none"
              data-course-credits="${i}" />
            <select
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none"
              data-course-grade="${i}"
            >
              ${Object.keys(gradePoints).map(g => `<option value="${g}" ${g === c.grade ? 'selected' : ''}>${g} (${gradePoints[g].toFixed(1)})</option>`).join('')}
            </select>
            <button
              type="button"
              class="cursor-pointer text-xs text-red-500 hover:text-red-700 px-2 py-1 font-bold"
              data-remove-course="${i}"
            >
              ✕
            </button>
          </div>
        `).join('');

        attachListeners();
        calculate();
      }

      function attachListeners() {
        coursesList.querySelectorAll('[data-course-name]').forEach(input => {
          input.addEventListener('input', (e) => {
            const idx = parseInt(e.target.dataset.courseName, 10);
            courses[idx].name = e.target.value;
          });
        });

        coursesList.querySelectorAll('[data-course-credits]').forEach(input => {
          input.addEventListener('input', (e) => {
            const idx = parseInt(e.target.dataset.courseCredits, 10);
            courses[idx].credits = parseFloat(e.target.value || target.dataset.default || '0');
            calculate();
          });
        });

        coursesList.querySelectorAll('[data-course-grade]').forEach(select => {
          select.addEventListener('change', (e) => {
            const idx = parseInt(e.target.dataset.courseGrade, 10);
            courses[idx].grade = e.target.value;
            calculate();
          });
        });

        coursesList.querySelectorAll('[data-remove-course]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt(e.target.dataset.removeCourse, 10);
            if (courses.length > 1) {
              courses.splice(idx, 1);
              renderCourses();
            }
          });
        });
      }

      function calculate() {
        let semCredits = 0;
        let semPoints = 0;

        courses.forEach(c => {
          const cred = Math.max(0, c.credits || 0);
          const pts = gradePoints[c.grade] ?? 0;
          semCredits += cred;
          semPoints += cred * pts;
        });

        const semGpa = semCredits > 0 ? semPoints / semCredits : 0;
        if (resGpa) resGpa.textContent = semGpa.toFixed(2);
        if (totalCredits) totalCredits.textContent = String(semCredits);
        if (totalPoints) totalPoints.textContent = semPoints.toFixed(2);

        if (gpaStanding) {
          if (semGpa >= 3.7) gpaStanding.textContent = "Dean's List / High Honors Range";
          else if (semGpa >= 3.0) gpaStanding.textContent = "Good Academic Standing";
          else if (semGpa >= 2.0) gpaStanding.textContent = "Satisfactory Academic Progress";
          else gpaStanding.textContent = "Academic Probation Warning";
        }

        const priorGpa = parseFloat(inPriorGpa?.value || '0');
        const priorCredits = parseFloat(inPriorCredits?.value || '0');

        if (priorCredits > 0) {
          const priorPoints = priorGpa * priorCredits;
          const cumCredits = priorCredits + semCredits;
          const cumGpa = cumCredits > 0 ? (priorPoints + semPoints) / cumCredits : semGpa;
          if (resCumulative) resCumulative.textContent = cumGpa.toFixed(2);
        } else {
          if (resCumulative) resCumulative.textContent = semGpa.toFixed(2);
        }
      }

      if (addBtn) {
        addBtn.addEventListener('click', () => {
          courses.push({ name: `Elective ${courses.length + 1}`, credits: 3, grade: 'A' });
          renderCourses();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          courses = [
            { name: 'Calculus II', credits: 4, grade: 'A' },
            { name: 'Computer Science I', credits: 4, grade: 'A-' },
            { name: 'Physics & Lab', credits: 4, grade: 'B+' },
            { name: 'Academic Writing', credits: 3, grade: 'B' },
          ];
          if (inPriorGpa) inPriorGpa.value = '';
          if (inPriorCredits) inPriorCredits.value = '';
          renderCourses();
        });
      }

      inPriorGpa?.addEventListener('input', calculate);
      inPriorCredits?.addEventListener('input', calculate);

      renderCourses();
    })();
  </script>
</SiteLayout>
