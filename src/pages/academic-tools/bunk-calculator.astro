---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Bunk Calculator | How Many Classes Can I Miss? · ${siteName}`;
const pageDesc = 'College bunk calculator. Calculate exactly how many lectures and lab classes you can skip without falling below your minimum attendance requirement (75% or 80%).';
const canonicalUrl = toAbsoluteUrl('/academic-tools/bunk-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Academic Tools', href: toAbsoluteUrl('/academic-tools/') },
  { label: 'Bunk Calculator' },
];

const faqs = [
  {
    question: 'How does the bunk calculator work?',
    answer: 'The bunk calculator determines the maximum number of classes you can skip while staying at or above your minimum attendance percentage (e.g., 75%). It calculates Safe Bunks = ⌊(Classes Attended ÷ Target Fraction) - Total Classes⌋.',
  },
  {
    question: 'What happens if I bunk one more class right now?',
    answer: 'If you skip the next class, your total classes increases by 1 while your attended classes remains unchanged. The new attendance will be (Attended ÷ (Total + 1)) × 100.',
  },
  {
    question: 'Can I calculate bunks for medical leave or college festivals?',
    answer: 'Yes! Enter your current attendance and the target criteria. The calculator will immediately tell you how many days or lectures you can afford to miss for extracurricular events, sports, or illness.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'College Bunk Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>College &amp; University Planner</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        College Bunk Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Need to take a day off? Calculate exactly how many lectures and practical labs you can safely bunk without violating your 75% or 80% university attendance cutoff rule.
      </p>
    </header>

    <!-- Bunk App Card -->
    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-bunk-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Class Information</h2>
            <button
              type="button"
              class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition"
              data-reset-btn
            >
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="bunk-attended" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Lectures Attended So Far
            </label>
            <input
              id="bunk-attended"
              type="number"
              min="0"
              value="42"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)]"
              data-bunk-attended
            />
          </div>

          <div class="space-y-1.5">
            <label for="bunk-total" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Total Lectures Held So Far
            </label>
            <input
              id="bunk-total"
              type="number"
              min="1"
              value="50"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)]"
              data-bunk-total
            />
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="bunk-target" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Required Minimum Criteria
              </label>
              <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-0.5 text-xs font-bold text-[color:var(--fg)]" data-bunk-target-display>
                75%
              </span>
            </div>
            <input
              id="bunk-target"
              type="range"
              min="60"
              max="90"
              step="5"
              value="75"
              class="w-full accent-[color:var(--accent)] cursor-pointer"
              data-bunk-target
            />
            <div class="flex justify-between text-[11px] font-semibold text-[color:var(--muted)]">
              <span>60%</span>
              <span class="font-bold text-[color:var(--fg)]">75% (Standard)</span>
              <span>80%</span>
              <span>85%</span>
              <span>90%</span>
            </div>
          </div>
        </form>

        <!-- Result Box -->
        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6 sm:p-8">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Bunk Allowance</span>
              <span class="rounded-full px-3 py-0.5 text-xs font-bold" data-bunk-badge>Safe</span>
            </div>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Safe Classes You Can Skip</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-safe-bunks>
                6
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-bunk-summary>
                You can bunk 6 consecutive classes and remain above 75%.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5">
                <p class="text-[11px] text-[color:var(--muted)]">Current Attendance</p>
                <p class="mt-1 text-lg font-bold text-[color:var(--fg)]" data-curr-pct>84.00%</p>
              </div>
              <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5">
                <p class="text-[11px] text-[color:var(--muted)]">After Bunking 1 Class</p>
                <p class="mt-1 text-lg font-bold text-[color:var(--fg)]" data-next-bunk-pct>82.35%</p>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-[color:var(--border)]">
            <a
              href={withBasePath('/academic-tools/attendance-calculator/')}
              class="block w-full text-center rounded-xl bg-[color:var(--fg)] px-4 py-2.5 text-xs font-bold text-[color:var(--bg)] transition hover:opacity-90"
            >
              Open Full Attendance Shortage Tool →
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Educational & Strategy Content -->
    <section class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 space-y-2">
        <h2 class="text-base font-bold text-[color:var(--fg)]">The Mathematics of Bunking</h2>
        <p class="text-xs leading-relaxed text-[color:var(--muted)]">
          When you miss a class, your total number of conducted classes increases while your attended tally stays frozen. If you have a high safety margin (e.g. 85%), each skipped lecture reduces your percentage by a small fraction, but once you near 75%, even a single missed lecture will trigger shortage warnings.
        </p>
      </div>
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 space-y-2">
        <h2 class="text-base font-bold text-[color:var(--fg)]">Smart Attendance Safety Strategy</h2>
        <p class="text-xs leading-relaxed text-[color:var(--muted)]">
          Never exhaust your safe bunk quota early in the semester. Keep at least 2–3 buffer classes reserved for unforeseen illness, emergency travel, project deadlines, or placement interview rounds.
        </p>
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-bunk-app]');
      if (!root) return;

      const inAtt = root.querySelector('[data-bunk-attended]');
      const inTot = root.querySelector('[data-bunk-total]');
      const inTar = root.querySelector('[data-bunk-target]');
      const tarDisp = root.querySelector('[data-bunk-target-display]');
      const safeBunks = root.querySelector('[data-safe-bunks]');
      const bunkSummary = root.querySelector('[data-bunk-summary]');
      const currPct = root.querySelector('[data-curr-pct]');
      const nextPct = root.querySelector('[data-next-bunk-pct]');
      const badge = root.querySelector('[data-bunk-badge]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      function update() {
        const attended = Math.max(0, parseInt(inAtt.value || '0', 10));
        const total = Math.max(1, parseInt(inTot.value || '1', 10));
        const target = Math.max(1, Math.min(100, parseInt(inTar.value || '75', 10)));
        const targetFrac = target / 100;

        if (tarDisp) tarDisp.textContent = `${target}%`;

        const pct = (attended / total) * 100;
        if (currPct) currPct.textContent = `${pct.toFixed(2)}%`;

        const next = (attended / (total + 1)) * 100;
        if (nextPct) nextPct.textContent = `${next.toFixed(2)}%`;

        if (pct >= target) {
          const safe = Math.max(0, Math.floor((attended / targetFrac) - total));
          if (safeBunks) safeBunks.textContent = String(safe);
          if (bunkSummary) {
            bunkSummary.textContent = safe === 0
              ? `You are right on the edge! Bunking the next class will drop you below ${target}%.`
              : `You can safely skip ${safe} class${safe === 1 ? '' : 'es'} without dropping below ${target}%.`;
          }
          if (badge) {
            badge.className = 'rounded-full px-3 py-0.5 text-xs font-bold bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20';
            badge.textContent = safe === 0 ? 'Warning' : 'Safe';
          }
        } else {
          const mustAttend = targetFrac >= 1 ? 999 : Math.max(0, Math.ceil((targetFrac * total - attended) / (1 - targetFrac)));
          if (safeBunks) safeBunks.textContent = '0';
          if (bunkSummary) {
            bunkSummary.textContent = `Shortage alert! You cannot bunk any classes. Attend ${mustAttend} consecutive class${mustAttend === 1 ? '' : 'es'} to recover.`;
          }
          if (badge) {
            badge.className = 'rounded-full px-3 py-0.5 text-xs font-bold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20';
            badge.textContent = 'Shortage';
          }
        }
      }

      inAtt.addEventListener('input', update);
      inTot.addEventListener('input', update);
      inTar.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inAtt.value = '42';
          inTot.value = '50';
          inTar.value = '75';
          update();
        });
      }

      update();
    })();
  </script>
</SiteLayout>
