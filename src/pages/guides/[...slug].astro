---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import { withBasePath } from '../../utils/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const articleImage = guide.data.coverImage
  ? new URL(guide.data.coverImage, 'https://toolscastle.app').toString()
  : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": guide.data.title,
  "description": guide.data.description,
  ...(articleImage ? { "image": [articleImage] } : {}),
  "datePublished": guide.data.publishDate,
  "dateModified": guide.data.publishDate,
  "inLanguage": "en-US",
  "author": {
    "@type": "Person",
    "name": guide.data.author,
    "jobTitle": "Developer & Author",
    "affiliation": {
      "@type": "EducationalOrganization",
      "name": "University of Dhaka",
      "department": "Department of Management Information Systems"
    },
    "sameAs": "https://www.linkedin.com/in/tanveerovee"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ToolsCastle",
    "url": "https://toolscastle.app"
  }
};
---

<SiteLayout
  title={guide.data.title}
  description={guide.data.description}
  canonical={`/guides/${guide.id}/`}
  ogType="article"
>
  <!-- KaTeX for crisp mathematical formulas rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous" slot="head" />

  <article id="guide-article" class="mx-auto max-w-4xl py-6 sm:py-10">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-500" aria-label="Breadcrumb">
      <a href={withBasePath('/')} class="hover:text-[color:var(--accent)] transition-colors">Home</a>
      <span>/</span>
      <a href={withBasePath('/guides/')} class="hover:text-[color:var(--accent)] transition-colors">Guides</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold truncate max-w-[200px] sm:max-w-md" aria-current="page">
        {guide.data.title}
      </span>
    </nav>

    <!-- Header Meta & Title -->
    <header class="border-b border-slate-200 pb-8 mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-block rounded-md bg-orange-100 text-[color:var(--accent)] px-2.5 py-0.5 text-xs font-bold">
          {guide.data.category}
        </span>
        <span class="text-xs text-slate-400">•</span>
        <time datetime={guide.data.publishDate} class="text-xs text-slate-500 font-medium">
          Published {new Date(guide.data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mb-4 leading-tight">
        {guide.data.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6">
        {guide.data.description}
      </p>

      <!-- Author Attribution Card (E-E-A-T Compliant) -->
      <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[color:var(--accent)] text-white font-bold text-base shadow-xs">
            TI
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-slate-900">{guide.data.author}</span>
              <a
                href="https://www.linkedin.com/in/tanveerovee"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-xs text-blue-600 hover:underline"
                title="View LinkedIn Profile"
              >
                LinkedIn ↗
              </a>
            </div>
            <p class="text-xs text-slate-500">
              {guide.data.affiliation || "Department of Management Information Systems, University of Dhaka"}
            </p>
          </div>
        </div>

        <div class="text-xs text-slate-500 text-left sm:text-right border-t sm:border-t-0 pt-2 sm:pt-0 border-slate-200 w-full sm:w-auto">
          <span class="block font-semibold text-slate-700">Reviewed & Verified By</span>
          <span>Tax specialist faculty & CA peers</span>
        </div>
      </div>
    </header>

    <!-- Companion Tool Callout Card -->
    {guide.data.relatedTool && (
      <aside class="mb-8 rounded-xl border-2 border-orange-200 bg-orange-50/60 p-5 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-[color:var(--accent)]">Interactive Companion Tool</span>
          <h2 class="text-base font-bold text-slate-900 mt-0.5">{guide.data.relatedToolName}</h2>
          <p class="text-xs text-slate-600 mt-1 max-w-xl">
            Run these exact calculations with your custom figures in real time. 100% private and computed client-side in your browser.
          </p>
        </div>
        <a
          href={withBasePath(guide.data.relatedTool)}
          class="shrink-0 rounded-lg bg-[color:var(--accent)] px-4 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-[#d84315] transition-colors inline-flex items-center gap-1.5"
        >
          Launch Calculator
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </aside>
    )}

    <!-- Editorial Cover / Infographic Diagram -->
    {guide.data.coverImage && (
      <figure class="mb-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src={withBasePath(guide.data.coverImage)}
          alt={guide.data.coverImageAlt || guide.data.title}
          class="w-full h-auto object-cover max-h-[500px]"
          loading="eager"
          decoding="async"
        />
        {guide.data.coverImageAlt && (
          <figcaption class="px-4 py-2.5 text-center text-xs text-slate-500 border-t border-slate-100 bg-slate-50/80">
            {guide.data.coverImageAlt}
          </figcaption>
        )}
      </figure>
    )}

    <!-- Markdown Article Body with Custom Styling -->
    <div class="guide-content text-slate-800 text-[15px] sm:text-[16px] leading-relaxed">
      <Content />
    </div>

    <!-- Author & Editorial Footer Card -->
    <footer class="mt-14 border-t border-slate-200 pt-8">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-[color:var(--accent)] text-white font-extrabold text-xl shadow-md">
            TI
          </div>
          <div class="flex-1">
            <h3 class="text-base font-bold text-slate-900">About the Author: Tanvirul Islam</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              Tanvirul Islam is a developer and student from the Department of Management Information Systems (MIS) at the University of Dhaka, Bangladesh. He designs client-side utility platforms and financial models with peer review from university professors specializing in tax law and colleagues in Chartered Accountancy (CA).
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-semibold">
              <a href="https://www.linkedin.com/in/tanveerovee" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
                LinkedIn Profile ↗
              </a>
              <a href="https://github.com/Oveez/calculator-utility" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:underline">
                GitHub Repository ↗
              </a>
              <a href={withBasePath('/about/')} class="text-[color:var(--accent)] hover:underline">
                Editorial Methodology & Disclaimers →
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </article>

  <!-- Auto-render KaTeX math scripts -->
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" crossorigin="anonymous"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" crossorigin="anonymous" id="katex-autorender-script"></script>
  <script is:inline>
    function runKaTeX() {
      if (!window.renderMathInElement) return;
      const article = document.getElementById('guide-article');
      if (!article) return;

      // Pre-sanitize any HTML entities or markdown-injected italics inside display math
      const blocks = article.querySelectorAll('p, li, td');
      const dbl = '$' + '$';
      blocks.forEach(function(el) {
        if (el.innerHTML.indexOf(dbl) !== -1) {
          el.innerHTML = el.innerHTML.replace(/\$\$([\s\S]*?)\$\$/g, function(match, math) {
            var clean = math
              .replace(/<em>(.*?)<\/em>/g, '_$1')
              .replace(/&amp;/g, '&')
              .replace(/&lt;/g, '<')
              .replace(/&gt;/g, '>')
              .replace(/[’‘]/g, "'");
            return dbl + clean + dbl;
          });
        }
      });

      window.renderMathInElement(article, {
        delimiters: [
          { left: dbl, right: dbl, display: true },
          { left: '\\[', right: '\\]', display: true },
          { left: '\\(', right: '\\)', display: false }
        ],
        ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
        throwOnError: false
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runKaTeX);
    } else {
      runKaTeX();
    }
    window.addEventListener('load', runKaTeX);
  </script>

  <!-- Article JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</SiteLayout>

<style is:global>
  .guide-content h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin-top: 2.25rem;
    margin-bottom: 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    line-height: 1.3;
  }
  .guide-content h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1e293b;
    margin-top: 1.75rem;
    margin-bottom: 0.625rem;
    line-height: 1.4;
  }
  .guide-content p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
    color: #334155;
  }
  .guide-content ul, .guide-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .guide-content ul {
    list-style-type: disc;
  }
  .guide-content ol {
    list-style-type: decimal;
  }
  .guide-content li {
    margin-bottom: 0.5rem;
    line-height: 1.65;
    color: #334155;
  }
  .guide-content table {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.875rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .guide-content th {
    background-color: #f8fafc;
    color: #0f172a;
    font-weight: 700;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #cbd5e1;
  }
  .guide-content td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
  }
  .guide-content tr:last-child td {
    border-bottom: none;
  }
  .guide-content tr:hover td {
    background-color: #f8fafc;
  }
  .guide-content blockquote {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #475569;
    font-style: italic;
    background-color: #f8fafc;
    padding: 0.75rem 1rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .guide-content code {
    background-color: #f1f5f9;
    color: #0f172a;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .guide-content pre {
    background-color: #0f172a;
    color: #f8fafc;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .guide-content a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .guide-content a:hover {
    color: #d84315;
  }
  .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.75rem 0;
    margin: 1rem 0 !important;
  }
</style>
