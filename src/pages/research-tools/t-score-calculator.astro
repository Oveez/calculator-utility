---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `T-Score Calculator | Student's t-Statistic & Psychometric T-Score · ${siteName}`;
const pageDesc = 'Calculate Student’s t-statistic, degrees of freedom, p-value, and standardized psychological test T-score (T = 50 + 10Z) from sample data.';
const canonicalUrl = toAbsoluteUrl('/research-tools/t-score-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'T-Score Calculator' },
];

const faqs = [
  {
    question: 'What is the difference between a statistical t-test and a standardized T-score?',
    answer: 'In hypothesis testing, the t-statistic t = (x̄ - μ₀) ÷ (s / √n) measures sample variance from a hypothesized mean. In psychometric testing and behavioral assessments, a T-score is a standardized metric with a fixed mean of 50 and standard deviation of 10: T = 50 + 10Z.',
  },
  {
    question: 'How do degrees of freedom affect Student’s t-distribution?',
    answer: 'For a one-sample t-test, degrees of freedom df = n - 1. As df increases beyond 30 to 100, the t-distribution becomes virtually identical to the standard normal bell curve.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'T-Score Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Hypothesis Testing &amp; Psychometrics</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        T-Score &amp; t-Statistic Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Compute Student's one-sample t-statistic, degrees of freedom, and standardized test T-scores for clinical psychological and educational evaluations.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-tscore-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Sample Inputs</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="sample-mean-t" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Sample Mean (x̄)</label>
            <input id="sample-mean-t" type="number" step="any" value="24.8" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-sample-mean />
          </div>

          <div class="space-y-1.5">
            <label for="hypo-mean-t" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Hypothesized Population Mean (μ₀)</label>
            <input id="hypo-mean-t" type="number" step="any" value="20.0" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-hypo-mean />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="sample-sd-t" class="block text-xs font-medium text-[color:var(--muted)]">Sample SD (s)</label>
              <input id="sample-sd-t" type="number" min="0.001" step="any" value="5.2" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-sample-sd />
            </div>
            <div>
              <label for="sample-n-t" class="block text-xs font-medium text-[color:var(--muted)]">Sample Size (n)</label>
              <input id="sample-n-t" type="number" min="2" step="1" value="16" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-sample-n />
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6 sm:p-8">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Test Statistic</span>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Student's t-Statistic</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-t>
                +3.692
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-df-display>
                Degrees of Freedom (df) = 15
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Standard Error (SE):</span>
                <span class="font-mono font-bold text-[color:var(--fg)]" data-se-val>1.300</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Two-Tailed p-value:</span>
                <span class="font-mono font-bold text-[color:var(--accent)]" data-p-val>p = 0.0022</span>
              </div>
              <div class="flex justify-between border-t border-[color:var(--border)] pt-2">
                <span class="text-[color:var(--muted)]">Psychometric T-Score:</span>
                <span class="font-mono font-bold text-[color:var(--fg)]" data-psych-t>T = 86.92</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-tscore-app]');
      if (!root) return;

      const inMean = root.querySelector('[data-sample-mean]');
      const inHypo = root.querySelector('[data-hypo-mean]');
      const inSd = root.querySelector('[data-sample-sd]');
      const inN = root.querySelector('[data-sample-n]');
      const outT = root.querySelector('[data-res-t]');
      const outDf = root.querySelector('[data-df-display]');
      const outSe = root.querySelector('[data-se-val]');
      const outP = root.querySelector('[data-p-val]');
      const outPsych = root.querySelector('[data-psych-t]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      function update() {
        const x = parseFloat(inMean.value || '0');
        const mu = parseFloat(inHypo.value || '0');
        const s = Math.max(0.0001, parseFloat(inSd.value || '1'));
        const n = Math.max(2, parseInt(inN.value || '10', 10));
        const df = n - 1;

        const se = s / Math.sqrt(n);
        const t = (x - mu) / se;

        // Approximate two-tailed p-value for Student t
        // Using approximation for t-distribution tail
        const zApprox = Math.abs(t) * Math.sqrt(1 - 1 / (4 * df));
        const erfVal = 0.5 * (1 + (function(x){
          const sign = x >= 0 ? 1 : -1; const a = Math.abs(x);
          const t1 = 1 / (1 + 0.3275911 * a);
          return sign * (1 - (((((1.061405429*t1 - 1.453152027)*t1 + 1.421413741)*t1 - 0.284496736)*t1 + 0.254829592)*t1*Math.exp(-a*a)));
        })(zApprox / Math.SQRT2));
        const pTwo = Math.max(0.0001, Math.min(1.0, 2 * (1 - erfVal)));

        const psychT = 50 + (10 * t);

        if (outT) outT.textContent = t >= 0 ? `+${t.toFixed(3)}` : t.toFixed(3);
        if (outDf) outDf.textContent = `Degrees of Freedom (df) = ${df}`;
        if (outSe) outSe.textContent = se.toFixed(3);
        if (outP) outP.textContent = `p = ${pTwo.toFixed(4)}`;
        if (outPsych) outPsych.textContent = `T = ${psychT.toFixed(2)}`;
      }

      inMean.addEventListener('input', update);
      inHypo.addEventListener('input', update);
      inSd.addEventListener('input', update);
      inN.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inMean.value = '24.8';
          inHypo.value = '20.0';
          inSd.value = '5.2';
          inN.value = '16';
          update();
        });
      }

      update();
    })();
  </script>
</SiteLayout>
