---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Random Sample Generator — Simple Random Sampling Tool · ${siteName}`;
const pageDesc = 'Generate simple random sample (SRS) selections from population sizes (N) or raw item lists without replacement. Uses Web Cryptography CSPRNG random generation.';
const canonicalUrl = toAbsoluteUrl('/research-tools/random-sample-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'Random Sample Generator' },
];

const schemaFaq = [
  {
    question: 'How does Simple Random Sampling (SRS) work without replacement?',
    answer: 'It applies the Fisher-Yates shuffle algorithm using cryptographically secure random values (`crypto.getRandomValues`) to ensure each population member has an equal, independent probability of selection.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Random Sample Generator',
    url: canonicalUrl,
    applicationCategory: 'AcademicApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-srs-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Fisher-Yates CSPRNG Sampler</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Random Sample Generator (SRS)
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Select unbiased, cryptographically randomized samples from population ranges or raw subject lists.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 sm:grid-cols-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="pop-size" class="font-bold text-[color:var(--fg)] block mb-1">Total Population (N):</label>
          <input
            type="number"
            id="pop-size"
            min="1"
            max="100000"
            value="100"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="sample-size" class="font-bold text-[color:var(--fg)] block mb-1">Sample Size to Draw (n):</label>
          <input
            type="number"
            id="sample-size"
            min="1"
            max="10000"
            value="15"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
      </div>

      <button
        type="button"
        data-draw-btn
        class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
      >
        Draw Random Sample
      </button>

      <!-- Results Card -->
      <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Selected Sample Units</span>
          <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy List</span>
          </button>
        </div>
        <div id="sample-output" class="flex flex-wrap gap-2 font-mono text-xs"></div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-srs-app]');
      if (!root) return;

      const popSize = root.querySelector('#pop-size');
      const sampleSize = root.querySelector('#sample-size');
      const drawBtn = root.querySelector('[data-draw-btn]');
      const output = root.querySelector('#sample-output');
      const copyBtn = root.querySelector('[data-copy-btn]');

      function drawSample() {
        const N = Math.min(100000, Math.max(1, parseInt(popSize.value, 10) || 100));
        const n = Math.min(N, Math.max(1, parseInt(sampleSize.value, 10) || 10));

        const population = Array.from({ length: N }, (_, i) => i + 1);

        // Fisher-Yates partial shuffle
        for (let i = 0; i < n; i++) {
          const randArr = new Uint32Array(1);
          crypto.getRandomValues(randArr);
          const j = i + (randArr[0] % (N - i));
          const temp = population[i];
          population[i] = population[j];
          population[j] = temp;
        }

        const sampled = population.slice(0, n).sort((a, b) => a - b);

        output.innerHTML = sampled.map(num => `
          <span class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1.5 font-bold text-emerald-500">
            #${num}
          </span>
        `).join('');
      }

      drawBtn.addEventListener('click', drawSample);

      copyBtn.addEventListener('click', () => {
        const items = Array.from(output.querySelectorAll('span')).map(s => s.textContent.trim());
        if (items.length === 0) return;
        navigator.clipboard.writeText(items.join(', '));
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      drawSample();
    })();
  </script>
</SiteLayout>
