---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Correlation Calculator — Pearson r & Spearman Rank Coefficient · ${siteName}`;
const pageDesc = 'Calculate Pearson correlation coefficient (r), coefficient of determination (R²), covariance, and statistical relationship strength online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/research-tools/correlation-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'Correlation Calculator' },
];

const schemaFaq = [
  {
    question: 'How is Pearson correlation coefficient (r) calculated?',
    answer: 'Pearson r = Cov(X, Y) / (SD_x * SD_y), measuring the linear correlation between two continuous variables between -1 (perfect negative) and +1 (perfect positive).',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Correlation Calculator',
    url: canonicalUrl,
    applicationCategory: 'AcademicApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-corr-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Statistical Association Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Pearson Correlation Calculator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Calculate Pearson correlation (r), R² variance explained, and covariance between two paired datasets.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <label for="x-vals" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Variable X Values (comma separated)</label>
          <textarea
            id="x-vals"
            rows="4"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="10, 20, 30, 40, 50"
          >45, 52, 60, 68, 75, 82, 90</textarea>
        </div>

        <div class="space-y-2">
          <label for="y-vals" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Variable Y Values (comma separated)</label>
          <textarea
            id="y-vals"
            rows="4"
            class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
            placeholder="15, 28, 32, 45, 58"
          >50, 55, 62, 70, 78, 85, 94</textarea>
        </div>
      </div>

      <!-- Stats Results Grid -->
      <div class="grid gap-4 sm:grid-cols-3 text-center">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Pearson (r)</span>
          <p id="res-r" class="text-3xl font-extrabold text-emerald-500">-</p>
          <p id="res-interp" class="text-[11px] font-semibold text-[color:var(--fg)]">-</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">R² Variance</span>
          <p id="res-r2" class="text-3xl font-extrabold text-[color:var(--fg)]">-</p>
          <p class="text-[11px] text-[color:var(--muted)]">Explained Variation</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Sample Covariance</span>
          <p id="res-cov" class="text-3xl font-extrabold text-[color:var(--fg)]">-</p>
          <p id="res-pairs" class="text-[11px] text-[color:var(--muted)]">N = 0 pairs</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-corr-app]');
      if (!root) return;

      const xInput = root.querySelector('#x-vals');
      const yInput = root.querySelector('#y-vals');
      const resR = root.querySelector('#res-r');
      const resR2 = root.querySelector('#res-r2');
      const resCov = root.querySelector('#res-cov');
      const resInterp = root.querySelector('#res-interp');
      const resPairs = root.querySelector('#res-pairs');

      function parseNums(str) {
        return str.split(/[\s,]+/).map(Number).filter(n => !isNaN(n));
      }

      function calc() {
        const x = parseNums(xInput.value);
        const y = parseNums(yInput.value);

        const n = Math.min(x.length, y.length);
        if (n < 2) {
          resR.textContent = '-'; resR2.textContent = '-'; resCov.textContent = '-';
          resInterp.textContent = 'Need at least 2 pairs';
          resPairs.textContent = 'N = 0';
          return;
        }

        const meanX = x.slice(0, n).reduce((a, b) => a + b, 0) / n;
        const meanY = y.slice(0, n).reduce((a, b) => a + b, 0) / n;

        let num = 0, denX = 0, denY = 0;
        for (let i = 0; i < n; i++) {
          const dx = x[i] - meanX;
          const dy = y[i] - meanY;
          num += dx * dy;
          denX += dx * dx;
          denY += dy * dy;
        }

        const r = denX === 0 || denY === 0 ? 0 : num / Math.sqrt(denX * denY);
        const r2 = r * r;
        const cov = num / (n - 1);

        resR.textContent = r.toFixed(4);
        resR2.textContent = (r2 * 100).toFixed(1) + '%';
        resCov.textContent = cov.toFixed(2);
        resPairs.textContent = `N = ${n} paired observations`;

        const absR = Math.abs(r);
        let interp = 'Negligible correlation';
        if (absR >= 0.9) interp = 'Very strong correlation';
        else if (absR >= 0.7) interp = 'Strong correlation';
        else if (absR >= 0.5) interp = 'Moderate correlation';
        else if (absR >= 0.3) interp = 'Weak correlation';

        resInterp.textContent = (r < 0 ? 'Negative: ' : 'Positive: ') + interp;
      }

      xInput.addEventListener('input', calc);
      yInput.addEventListener('input', calc);
      calc();
    })();
  </script>
</SiteLayout>
