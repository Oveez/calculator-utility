---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Sample Size Calculator | Survey & Research Sample Sizing · ${siteName}`;
const pageDesc = 'Calculate exact scientific sample sizes for surveys, clinical trials, and thesis research using Cochran’s formula, means estimation, finite population correction, and response rate buffers.';
const canonicalUrl = toAbsoluteUrl('/research-tools/sample-size-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'Sample Size Calculator' },
];

const parameterGuideData: CalculatorParameterInfo[] = [
  {
    name: 'Confidence Level (Z-Score)',
    description: 'The statistical probability that the true population parameter lies within your estimated margin of error. 95% (Z = 1.960) is the universal scientific consensus; 99% (Z = 2.576) is standard in clinical and high-stakes research.',
    type: 'Percentage & Critical Z',
    defaultValue: '95% (Z = 1.960)',
    whyItMatters: 'Higher confidence levels exponentially increase the required sample size.',
  },
  {
    name: 'Margin of Error (±% Precision / Absolute E)',
    description: 'The maximum tolerable difference between your sample estimate and the true population parameter. Halving the margin of error quadruples the required sample size.',
    type: 'Precision Margin (±% or Units)',
    defaultValue: '±5.0%',
    whyItMatters: 'Governs the statistical tightness and reliability of study findings.',
  },
  {
    name: 'Expected Population Proportion (p) vs Standard Deviation (σ)',
    description: 'For proportions, p = 0.50 yields the maximum variance p(1-p) = 0.25 (the most conservative sample size). For continuous means, σ represents the estimated population dispersion.',
    type: 'Dispersion Parameter',
    defaultValue: '50% (Max Variance)',
    whyItMatters: 'Guarantees the sample size is mathematically sufficient regardless of observed response distributions.',
  },
  {
    name: 'Finite Population Correction (FPC)',
    description: 'A reduction factor applied when the sample size exceeds 5% of the total target population (n / N > 0.05).',
    type: 'Adjustment Factor',
    defaultValue: 'Automatic when N is provided',
    whyItMatters: 'Prevents wasteful over-sampling when surveying well-defined organizations, hospitals, or student bodies.',
  },
];

const schemaFaq = [
  {
    question: 'How is sample size calculated for an unknown or infinite population?',
    answer: 'For proportions, Cochran’s formula is applied: n₀ = (Z² × p(1 - p)) ÷ e², where Z is the critical value for your chosen confidence level (1.96 for 95%), p is the estimated proportion (0.50 gives the most conservative sample size), and e is the acceptable margin of error (0.05 for ±5%).',
  },
  {
    question: 'What is Finite Population Correction (FPC)?',
    answer: 'When sampling from a small or known finite population N, the unadjusted sample size n₀ is adjusted down using FPC: n = n₀ ÷ [1 + (n₀ - 1) ÷ N]. This prevents over-sampling when the sample exceeds 5% of the total population.',
  },
  {
    question: 'How does response rate affect required survey invitations?',
    answer: 'Because not everyone invited completes the survey, you must divide the statistical sample size by the anticipated completion rate: Required Invitations = Recommended Sample Size ÷ Response Rate. For example, needing 385 completes with a 20% response rate requires inviting 1,925 participants.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Scientific Sample Size Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-sample-size-app>
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Scientific Sampling Methodology &amp; Survey Sizing</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Sample Size Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Calculate the exact number of survey respondents or experimental subjects needed for your thesis dissertation, clinical trial, or market research poll. Supports proportions, continuous means, and non-response buffers.
      </p>
    </header>

    <!-- Mode Selector Tabs -->
    <div class="flex flex-wrap gap-2 border-b border-[color:var(--border)] pb-2 text-xs font-semibold">
      <button
        type="button"
        id="tab-mode-prop"
        class="mode-tab active rounded-xl bg-[color:var(--accent)] px-4 py-2 text-white transition cursor-pointer"
        data-mode="proportion"
      >
        Proportion / Survey Percentage Mode
      </button>
      <button
        type="button"
        id="tab-mode-mean"
        class="mode-tab rounded-xl bg-[color:var(--surface)] border border-[color:var(--border)] px-4 py-2 text-[color:var(--muted)] hover:text-[color:var(--fg)] transition cursor-pointer"
        data-mode="mean"
      >
        Continuous Mean Estimation Mode
      </button>
    </div>

    <!-- App Card -->
    <div class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-xs sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <!-- Form Panel -->
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Study Parameters</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" id="reset-btn">
              ↺ Reset
            </button>
          </div>

          <!-- Confidence Level -->
          <div class="space-y-1.5">
            <label for="conf-level" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Confidence Level
            </label>
            <select
              id="conf-level"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-sm font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
            >
              <option value="90">90% (Z = 1.645)</option>
              <option value="95" selected>95% — Scientific Standard (Z = 1.960)</option>
              <option value="99">99% — High Precision / Clinical (Z = 2.576)</option>
            </select>
          </div>

          <!-- Proportion Mode Inputs -->
          <div id="prop-fields" class="space-y-4">
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="moe-input" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                  Margin of Error (±%)
                </label>
                <span class="text-xs font-mono text-cyan-500 dark:text-cyan-400 font-bold" id="moe-display">5.0%</span>
              </div>
              <input
                id="moe-input"
                type="number"
                min="0.1"
                max="20"
                step="0.1"
                value="5.0"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              />
            </div>

            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="prop-input" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                  Expected Population Proportion (%)
                </label>
                <span class="text-xs font-mono text-[color:var(--fg)]" id="prop-display">50%</span>
              </div>
              <input
                id="prop-input"
                type="number"
                min="1"
                max="99"
                step="1"
                value="50"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              />
              <p class="text-[11px] text-[color:var(--muted)]">50% provides maximum statistical variance and the safest sample size.</p>
            </div>
          </div>

          <!-- Mean Mode Inputs (Hidden by default) -->
          <div id="mean-fields" class="hidden space-y-4">
            <div class="space-y-1.5">
              <label for="mean-moe" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] block">
                Acceptable Absolute Margin of Error (E):
              </label>
              <input
                id="mean-moe"
                type="number"
                step="0.01"
                min="0.001"
                value="2.0"
                placeholder="e.g. 2.0 (in measurement units)"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              />
            </div>

            <div class="space-y-1.5">
              <label for="mean-sd" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] block">
                Estimated Population Standard Deviation (σ):
              </label>
              <input
                id="mean-sd"
                type="number"
                step="0.01"
                min="0.001"
                value="10.0"
                placeholder="e.g. 10.0 (from pilot study or literature)"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              />
              <p class="text-[11px] text-[color:var(--muted)]">Obtained from pilot studies, previous publications, or Range / 4 rule of thumb.</p>
            </div>
          </div>

          <!-- Population Size (Optional) -->
          <div class="space-y-1.5 pt-1 border-t border-[color:var(--border)]/60">
            <label for="pop-input" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Population Size (N) — Optional for Finite Correction:
            </label>
            <input
              id="pop-input"
              type="number"
              min="10"
              step="1"
              placeholder="Leave blank for infinite / unknown population"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-sm font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
            />
          </div>

          <!-- Response Rate Buffer -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="resp-rate" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Anticipated Response Rate (%):
              </label>
              <span class="text-xs font-mono text-[color:var(--fg)]" id="resp-rate-disp">100% (No Drop-off)</span>
            </div>
            <input
              id="resp-rate"
              type="number"
              min="5"
              max="100"
              step="5"
              value="100"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-2.5 text-sm font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
            />
            <p class="text-[11px] text-[color:var(--muted)]">e.g. 20% typical for email surveys; 60% for internal staff audits.</p>
          </div>
        </form>

        <!-- Result Box -->
        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-6 sm:p-8 shadow-sm">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Required Sample Size</span>
              <button
                type="button"
                id="copy-result-btn"
                class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
              >
                Copy Result
              </button>
            </div>

            <div>
              <div class="flex items-baseline gap-2">
                <span id="res-sample-size" class="text-5xl font-extrabold tracking-tight text-cyan-500 dark:text-cyan-400 font-mono">385</span>
                <span class="text-sm font-semibold text-[color:var(--muted)]">respondents</span>
              </div>
              <p id="res-fpc-status" class="mt-1 text-xs text-[color:var(--muted)]">Cochran's formula (Infinite population assumption)</p>
            </div>

            <!-- Survey Distribution Planning Box -->
            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
              <span class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Distribution Recruitment Target</span>
              <div class="flex items-baseline justify-between">
                <span class="text-xs font-semibold text-[color:var(--fg)]">Invitations to Send:</span>
                <span id="res-invitations" class="text-xl font-bold font-mono text-cyan-400">385</span>
              </div>
              <p id="res-buffer-text" class="text-[11px] text-[color:var(--muted)]">100% response rate assumed. No over-sampling buffer added.</p>
            </div>

            <!-- Breakdown Telemetry -->
            <div class="divide-y divide-[color:var(--border)] border-t border-[color:var(--border)] text-xs">
              <div class="flex justify-between py-2">
                <span class="text-[color:var(--muted)]">Critical Z-Value:</span>
                <span id="res-z-val" class="font-mono font-bold text-[color:var(--fg)]">1.960</span>
              </div>
              <div class="flex justify-between py-2">
                <span class="text-[color:var(--muted)]">Base Unadjusted Size (n₀):</span>
                <span id="res-n0" class="font-mono font-bold text-[color:var(--fg)]">384.16</span>
              </div>
              <div class="flex justify-between py-2">
                <span class="text-[color:var(--muted)]">Finite Correction Factor:</span>
                <span id="res-fpc-factor" class="font-mono font-bold text-[color:var(--fg)]">1.000 (None)</span>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-cyan-500/20 bg-cyan-500/10 p-3.5 text-xs leading-relaxed text-cyan-400">
            <strong>Statistical Guarantee:</strong> A random sample of <span id="res-callout-n" class="font-bold font-mono">385</span> subjects will reflect the true population within <span id="res-callout-moe" class="font-bold">±5.0%</span> at <span id="res-callout-conf" class="font-bold">95%</span> confidence.
          </div>
        </div>
      </div>
    </div>

    <!-- Sensitivity Matrix Table -->
    <section class="space-y-4">
      <div>
        <h2 class="text-lg font-bold text-[color:var(--fg)]">Sample Size Sensitivity Comparison Matrix</h2>
        <p class="text-xs text-[color:var(--muted)]">Required sample sizes across margins of error (±1% to ±5%) and standard confidence levels</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)]">
        <table class="w-full text-left text-xs">
          <thead class="bg-[color:var(--surface-strong)] text-[color:var(--muted)] border-b border-[color:var(--border)]">
            <tr>
              <th class="p-3.5 font-bold">Margin of Error (±%)</th>
              <th class="p-3.5 font-bold text-center">90% Confidence (Z = 1.645)</th>
              <th class="p-3.5 font-bold text-center text-cyan-500 dark:text-cyan-400">95% Confidence (Z = 1.960)</th>
              <th class="p-3.5 font-bold text-center">99% Confidence (Z = 2.576)</th>
              <th class="p-3.5 font-bold">Recommended Use Case</th>
            </tr>
          </thead>
          <tbody id="matrix-tbody" class="divide-y divide-[color:var(--border)] font-mono">
            <!-- Dynamically rendered by JavaScript -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- Parameter Guide Component -->
    <CalculatorParameterGuide
      parameters={parameterGuideData}
      workedExample={{
        title: 'Academic Survey Sample Size Calculation',
        description: 'Sizing an undergraduate university student survey with a known cohort population of N = 5,000.',
        formula: 'n₀ = [Z² × p(1 - p)] ÷ e² | n = n₀ ÷ [1 + (n₀ - 1) ÷ N]',
        steps: [
          {
            step: 'Calculate Unadjusted Base Size (n₀)',
            calculation: '(1.960² × 0.50 × 0.50) ÷ (0.05²)',
            result: 'n₀ = 384.16 subjects',
          },
          {
            step: 'Apply Finite Population Correction (N = 5000)',
            calculation: '384.16 ÷ [1 + (384.16 - 1) ÷ 5000]',
            result: 'n = 356.81 subjects',
          },
          {
            step: 'Ceiling Integer Rounding',
            calculation: 'Round up to nearest whole participant',
            result: 'Recommended Sample Size = 357 respondents',
          },
          {
            step: 'Account for 25% Response Rate',
            calculation: '357 ÷ 0.25',
            result: 'Send 1,428 survey invitations',
          },
        ],
      }}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">&blacktriangledown;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-sample-size-app]');
      if (!root) return;

      // Tabs
      const modeTabs = root.querySelectorAll('.mode-tab');
      const propFields = root.querySelector('#prop-fields');
      const meanFields = root.querySelector('#mean-fields');

      // Inputs
      const confLevel = root.querySelector('#conf-level');
      const moeInput = root.querySelector('#moe-input');
      const moeDisplay = root.querySelector('#moe-display');
      const propInput = root.querySelector('#prop-input');
      const propDisplay = root.querySelector('#prop-display');
      const meanMoe = root.querySelector('#mean-moe');
      const meanSd = root.querySelector('#mean-sd');
      const popInput = root.querySelector('#pop-input');
      const respRate = root.querySelector('#resp-rate');
      const respRateDisp = root.querySelector('#resp-rate-disp');
      const resetBtn = root.querySelector('#reset-btn');

      // Outputs
      const resSampleSize = root.querySelector('#res-sample-size');
      const resFpcStatus = root.querySelector('#res-fpc-status');
      const resInvitations = root.querySelector('#res-invitations');
      const resBufferText = root.querySelector('#res-buffer-text');
      const resZVal = root.querySelector('#res-z-val');
      const resN0 = root.querySelector('#res-n0');
      const resFpcFactor = root.querySelector('#res-fpc-factor');
      const resCalloutN = root.querySelector('#res-callout-n');
      const resCalloutMoe = root.querySelector('#res-callout-moe');
      const resCalloutConf = root.querySelector('#res-callout-conf');
      const copyBtn = root.querySelector('#copy-result-btn');
      const matrixTbody = root.querySelector('#matrix-tbody');

      let currentMode = 'proportion';

      const zMap = {
        '90': 1.645,
        '95': 1.960,
        '99': 2.576,
      };

      function calculate() {
        const conf = confLevel.value;
        const z = zMap[conf] || 1.960;
        const pop = parseFloat(popInput.value) || 0;
        const rate = Math.max(5, Math.min(100, parseFloat(respRate.value) || 100)) / 100;

        resZVal.textContent = z.toFixed(3);
        resCalloutConf.textContent = `${conf}%`;

        let n0 = 0;
        let finalN = 0;

        if (currentMode === 'proportion') {
          const e = (parseFloat(moeInput.value) || 5) / 100;
          const p = (parseFloat(propInput.value) || 50) / 100;
          moeDisplay.textContent = `${(e * 100).toFixed(1)}%`;
          propDisplay.textContent = `${Math.round(p * 100)}%`;
          resCalloutMoe.textContent = `±${(e * 100).toFixed(1)}%`;

          n0 = (Math.pow(z, 2) * p * (1 - p)) / Math.pow(e, 2);
        } else {
          const e = parseFloat(meanMoe.value) || 2;
          const sd = parseFloat(meanSd.value) || 10;
          resCalloutMoe.textContent = `±${e} units`;

          n0 = Math.pow((z * sd) / e, 2);
        }

        resN0.textContent = n0.toFixed(2);

        // Apply Finite Population Correction (FPC)
        if (pop > 0 && pop > n0) {
          finalN = Math.ceil(n0 / (1 + ((n0 - 1) / pop)));
          const fpcFactor = finalN / n0;
          resFpcFactor.textContent = fpcFactor.toFixed(3);
          resFpcStatus.textContent = `Adjusted for finite population N = ${pop.toLocaleString()}`;
        } else {
          finalN = Math.ceil(n0);
          resFpcFactor.textContent = '1.000 (None)';
          resFpcStatus.textContent = pop > 0 ? `Population N (${pop.toLocaleString()}) too small for FPC` : 'Cochran’s formula (Infinite population assumption)';
        }

        resSampleSize.textContent = finalN.toLocaleString();
        resCalloutN.textContent = finalN.toLocaleString();

        // Calculate Response Rate Buffer
        respRateDisp.textContent = `${Math.round(rate * 100)}% Response Rate`;
        const invitesNeeded = Math.ceil(finalN / rate);
        resInvitations.textContent = invitesNeeded.toLocaleString();

        if (rate < 1.0) {
          resBufferText.textContent = `At ${Math.round(rate * 100)}% response rate, you need ${(invitesNeeded - finalN).toLocaleString()} extra invites as a safety buffer.`;
        } else {
          resBufferText.textContent = '100% response rate assumed. No over-sampling buffer added.';
        }

        updateMatrix(pop);
      }

      function updateMatrix(pop) {
        if (!matrixTbody) return;

        const tiers = [
          { moe: 0.01, label: '±1.0%', desc: 'National censuses, presidential polling, high-stakes medical trials' },
          { moe: 0.02, label: '±2.0%', desc: 'Rigorous public policy surveys & large academic dissertations' },
          { moe: 0.03, label: '±3.0%', desc: 'Standard professional market research & enterprise customer studies' },
          { moe: 0.04, label: '±4.0%', desc: 'B2B surveys, university course evaluations, exploratory research' },
          { moe: 0.05, label: '±5.0%', desc: 'Academic standard threshold for student projects and pilot polls' },
        ];

        matrixTbody.innerHTML = tiers.map(t => {
          function calcN(zVal) {
            let n0 = (Math.pow(zVal, 2) * 0.25) / Math.pow(t.moe, 2);
            if (pop > 0 && pop > n0) {
              return Math.ceil(n0 / (1 + ((n0 - 1) / pop)));
            }
            return Math.ceil(n0);
          }

          const n90 = calcN(1.645);
          const n95 = calcN(1.960);
          const n99 = calcN(2.576);

          return `
            <tr class="hover:bg-[color:var(--surface-strong)] transition">
              <td class="p-3.5 font-bold text-[color:var(--fg)]">${t.label}</td>
              <td class="p-3.5 text-center text-[color:var(--muted)]">${n90.toLocaleString()}</td>
              <td class="p-3.5 text-center font-bold text-cyan-500 dark:text-cyan-400">${n95.toLocaleString()}</td>
              <td class="p-3.5 text-center text-[color:var(--muted)]">${n99.toLocaleString()}</td>
              <td class="p-3.5 font-sans text-[11px] text-[color:var(--muted)]">${t.desc}</td>
            </tr>
          `;
        }).join('');
      }

      modeTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          modeTabs.forEach(t => {
            t.classList.remove('bg-[color:var(--accent)]', 'text-white');
            t.classList.add('bg-[color:var(--surface)]', 'border', 'border-[color:var(--border)]', 'text-[color:var(--muted)]');
          });
          tab.classList.add('bg-[color:var(--accent)]', 'text-white');
          tab.classList.remove('bg-[color:var(--surface)]', 'border-[color:var(--border)]', 'text-[color:var(--muted)]');

          currentMode = tab.dataset.mode;
          propFields.classList.toggle('hidden', currentMode !== 'proportion');
          meanFields.classList.toggle('hidden', currentMode !== 'mean');
          calculate();
        });
      });

      resetBtn?.addEventListener('click', () => {
        confLevel.value = '95';
        moeInput.value = '5.0';
        propInput.value = '50';
        meanMoe.value = '2.0';
        meanSd.value = '10.0';
        popInput.value = '';
        respRate.value = '100';
        calculate();
      });

      copyBtn?.addEventListener('click', () => {
        const text = `Recommended Sample Size: ${resSampleSize.textContent} respondents (Confidence: ${confLevel.value}%, Margin of Error: ${resCalloutMoe.textContent}, Population: ${popInput.value || 'Infinite'}, Invitations Needed: ${resInvitations.textContent})`;
        navigator.clipboard.writeText(text).then(() => {
          const orig = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = orig; }, 1800);
        });
      });

      [confLevel, moeInput, propInput, meanMoe, meanSd, popInput, respRate].forEach(el => {
        el?.addEventListener('input', calculate);
      });

      calculate();
    })();
  </script>
</SiteLayout>
