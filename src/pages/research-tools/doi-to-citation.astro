---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `DOI to Citation Generator — APA 7, MLA 9, BibTeX, Chicago, IEEE · ${siteName}`;
const pageDesc = 'Generate formatted academic citations from a DOI or article metadata online. Instant CrossRef metadata lookup with APA 7th, MLA 9th, Chicago, Harvard, IEEE, and BibTeX export.';
const canonicalUrl = toAbsoluteUrl('/research-tools/doi-to-citation/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'DOI to Citation' },
];

const parameterGuideData: CalculatorParameterInfo[] = [
  {
    name: 'Digital Object Identifier (DOI)',
    description: 'A unique alphanumeric string assigned by the International DOI Foundation (IDF) to persistently identify journal articles, datasets, and academic publications.',
    type: 'String (e.g., 10.xxxx/xxxx)',
    defaultValue: '10.1038/s41586-020-2649-2',
    whyItMatters: 'Guarantees persistent, un-breaking hyperlink access to scholarly literature even if publisher domain names change.',
  },
  {
    name: 'Author Attribution (First & Last Names)',
    description: 'Primary researchers or institutional authors credited on the paper. Academic citation styles format names differently (e.g. APA uses "Last, F. M.", MLA uses "Last, First").',
    type: 'Author List',
    defaultValue: 'Vaswani, Ashish, et al.',
    whyItMatters: 'Essential for intellectual credit, citation indexing metrics (h-index), and bibliographic verification.',
  },
  {
    name: 'Publication Year & Date Parts',
    description: 'The calendar year in which the peer-reviewed version was officially published in print or online-first format.',
    type: 'Integer (YYYY)',
    defaultValue: '2017',
    whyItMatters: 'Chronological anchor determining theoretical recency and compliance with literature review standards.',
  },
  {
    name: 'Journal Container & Volume / Issue / Pages',
    description: 'The publishing journal or conference proceeding title, along with volume number, issue number, and specific page ranges.',
    type: 'Bibliographic Metadata',
    defaultValue: 'Advances in Neural Information Processing Systems, 30, 5998–6008',
    whyItMatters: 'Allows physical and digital retrieval from library databases and university repositories.',
  },
];

const schemaFaq = [
  {
    question: 'How are journal citations formatted in APA 7th vs MLA 9th?',
    answer: 'APA 7th follows: Author, A. A., & Author, B. B. (Year). Title of article. Title of Journal, volume(issue), pages. https://doi.org/xxx. MLA 9th follows: Author, First. "Title of Article." Title of Journal, vol. x, no. y, Year, pp. xx-xx. https://doi.org/xxx.',
  },
  {
    question: 'How does the automated CrossRef DOI lookup work?',
    answer: 'When you enter a DOI and click "Fetch Online Metadata", the browser queries the public CrossRef REST API (api.crossref.org/works/). It automatically extracts verified author rosters, article titles, journal names, publication years, volume, issue, and page numbers directly into the editor.',
  },
  {
    question: 'What is a BibTeX file and how is it used?',
    answer: 'BibTeX is a standardized bibliography format used in LaTeX documents. It creates a structured `@article` citation key that LaTeX engines automatically format according to academic journal style templates.',
  },
  {
    question: 'Does this citation tool save or transmit my research data?',
    answer: 'No. Queries to the public CrossRef API are performed directly in your local browser sandbox. None of your citation entries, draft manuscripts, or bibliography lists are ever logged or saved to any third-party server.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'DOI to Citation Generator',
    url: canonicalUrl,
    applicationCategory: 'AcademicApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-doi-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>CrossRef API &amp; Multi-Style Bibliographic Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        DOI to Citation Generator
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate peer-reviewed academic citations formatted in APA 7, MLA 9, Chicago, Harvard, IEEE, and BibTeX. Enter a DOI for instant automated CrossRef metadata retrieval or manually customize bibliographic details.
      </p>
    </header>

    <div class="space-y-6">
      <!-- DOI Quick Lookup Bar -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 space-y-4">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-end gap-3">
          <div class="grow space-y-1">
            <label for="doi-val" class="font-bold text-xs uppercase tracking-wider text-[color:var(--fg)] block">
              Digital Object Identifier (DOI):
            </label>
            <div class="relative">
              <input
                type="text"
                id="doi-val"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-2.5 font-mono text-xs sm:text-sm text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
                placeholder="e.g. 10.1038/s41586-020-2649-2 or https://doi.org/..."
                value="10.1038/s41586-020-2649-2" />
            </div>
          </div>
          <button
            type="button"
            id="fetch-doi-btn"
            class="rounded-2xl bg-[color:var(--accent)] px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer shrink-0"
          >
            Fetch Online Metadata
          </button>
        </div>

        <div id="fetch-status" class="hidden text-xs font-medium"></div>

        <!-- Quick Samples -->
        <div class="flex flex-wrap items-center gap-2 text-xs pt-1 border-t border-[color:var(--border)]/60">
          <span class="text-[color:var(--muted)] font-semibold">Sample DOIs:</span>
          <button type="button" class="sample-doi-btn rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-[color:var(--fg)] hover:border-emerald-500 cursor-pointer" data-doi="10.1038/s41586-020-2649-2">AlphaFold 2 (Nature 2021)</button>
          <button type="button" class="sample-doi-btn rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-[color:var(--fg)] hover:border-emerald-500 cursor-pointer" data-doi="10.1126/science.1102896">Higgs Boson (Science 2012)</button>
          <button type="button" class="sample-doi-btn rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-[color:var(--fg)] hover:border-emerald-500 cursor-pointer" data-doi="10.1145/3065386">Deep Residual Learning (CVPR 2016)</button>
        </div>
      </div>

      <!-- Metadata Editor Form -->
      <div class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
        <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Bibliographic Fields</span>
          <button type="button" id="clear-btn" class="text-[11px] font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">
            Clear All
          </button>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="author-val" class="font-bold text-[color:var(--fg)] block mb-1">Author(s) (Last, First):</label>
            <input
              type="text"
              id="author-val"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. Jumper, John, Evans, Richard, & Pritzel, Alexander"
              value="Jumper, John, et al." />
          </div>
          <div>
            <label for="title-val" class="font-bold text-[color:var(--fg)] block mb-1">Article / Paper Title:</label>
            <input
              type="text"
              id="title-val"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              placeholder="e.g. Highly accurate protein structure prediction with AlphaFold"
              value="Highly accurate protein structure prediction with AlphaFold" />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-4">
          <div class="sm:col-span-2">
            <label for="journal-val" class="font-bold text-[color:var(--fg)] block mb-1">Journal / Publication Name:</label>
            <input
              type="text"
              id="journal-val"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              value="Nature" />
          </div>
          <div>
            <label for="year-val" class="font-bold text-[color:var(--fg)] block mb-1">Year of Publication:</label>
            <input
              type="number"
              id="year-val"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]" placeholder="e.g. 2,021" />
          </div>
          <div>
            <label for="vol-val" class="font-bold text-[color:var(--fg)] block mb-1">Volume (Issue):</label>
            <input
              type="text"
              id="vol-val"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
              value="596(7873)" />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <label for="pages-val" class="font-bold text-[color:var(--fg)] block mb-1">Page Range:</label>
            <input
              type="text"
              id="pages-val"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
              value="583–589" />
          </div>
          <div class="sm:col-span-2">
            <label for="publisher-val" class="font-bold text-[color:var(--fg)] block mb-1">Publisher (Optional):</label>
            <input
              type="text"
              id="publisher-val"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]"
              value="Nature Publishing Group" />
          </div>
        </div>
      </div>

      <!-- Formatted Citations Output Section -->
      <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Generated Academic Citations</h2>
            <p class="text-xs text-[color:var(--muted)]">Formatted according to the latest official publication manuals</p>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="dl-bib-btn"
              class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--fg)] hover:border-emerald-500 transition cursor-pointer"
            >
              Download .bib File
            </button>
            <button
              type="button"
              id="copy-all-btn"
              class="rounded-xl bg-[color:var(--accent)] px-3.5 py-1.5 text-xs font-bold text-white hover:opacity-90 transition cursor-pointer"
            >
              Copy All Citations
            </button>
          </div>
        </div>

        <div class="grid gap-3.5">
          <!-- APA 7 -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-cyan-500 dark:text-cyan-400 uppercase tracking-wider">APA 7th Edition</span>
              <button type="button" class="copy-single-btn text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer" data-target="cite-apa">Copy APA</button>
            </div>
            <p id="cite-apa" class="text-xs sm:text-sm leading-relaxed text-[color:var(--fg)] font-serif select-all break-words">-</p>
          </div>

          <!-- MLA 9 -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-cyan-500 dark:text-cyan-400 uppercase tracking-wider">MLA 9th Edition</span>
              <button type="button" class="copy-single-btn text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer" data-target="cite-mla">Copy MLA</button>
            </div>
            <p id="cite-mla" class="text-xs sm:text-sm leading-relaxed text-[color:var(--fg)] font-serif select-all break-words">-</p>
          </div>

          <!-- Chicago (Author-Date) -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-cyan-500 dark:text-cyan-400 uppercase tracking-wider">Chicago (Author-Date 17th)</span>
              <button type="button" class="copy-single-btn text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer" data-target="cite-chicago">Copy Chicago</button>
            </div>
            <p id="cite-chicago" class="text-xs sm:text-sm leading-relaxed text-[color:var(--fg)] font-serif select-all break-words">-</p>
          </div>

          <!-- Harvard Reference -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-cyan-500 dark:text-cyan-400 uppercase tracking-wider">Harvard Style</span>
              <button type="button" class="copy-single-btn text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer" data-target="cite-harvard">Copy Harvard</button>
            </div>
            <p id="cite-harvard" class="text-xs sm:text-sm leading-relaxed text-[color:var(--fg)] font-serif select-all break-words">-</p>
          </div>

          <!-- IEEE -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-cyan-500 dark:text-cyan-400 uppercase tracking-wider">IEEE Format</span>
              <button type="button" class="copy-single-btn text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer" data-target="cite-ieee">Copy IEEE</button>
            </div>
            <p id="cite-ieee" class="text-xs sm:text-sm leading-relaxed text-[color:var(--fg)] font-mono select-all break-words">-</p>
          </div>

          <!-- BibTeX -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-cyan-500 dark:text-cyan-400 uppercase tracking-wider">BibTeX Entry (LaTeX)</span>
              <button type="button" class="copy-single-btn text-xs font-bold text-[color:var(--fg)] hover:underline cursor-pointer" data-target="cite-bib">Copy BibTeX</button>
            </div>
            <pre id="cite-bib" class="text-xs leading-relaxed text-[color:var(--fg)] font-mono whitespace-pre-wrap select-all bg-[color:var(--surface-strong)] p-3 rounded-xl border border-[color:var(--border)]">-</pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Parameter Guide Component -->
    <CalculatorParameterGuide
      parameters={parameterGuideData}
      workedExample={{
        title: 'DOI Citation Generation Example',
        description: 'Generating compliant bibliographic entries for a high-impact Nature journal publication.',
        formula: 'Author(s) + (Year) + Title + Journal + Volume(Issue) + Pages + DOI Link',
        steps: [
          {
            step: 'Input DOI / Query CrossRef',
            calculation: 'Query 10.1038/s41586-020-2649-2 against CrossRef API',
            result: 'AlphaFold protein prediction metadata retrieved',
          },
          {
            step: 'Format APA 7th',
            calculation: 'Author, A. (2021). Title. Nature, 596(7873), 583–589',
            result: 'Jumper, J., et al. (2021). Highly accurate protein structure prediction with AlphaFold. Nature, 596(7873), 583–589. https://doi.org/10.1038/s41586-020-2649-2',
          },
          {
            step: 'Format MLA 9th',
            calculation: 'Author. "Title." Nature, vol. 596, no. 7873, 2021, pp. 583-589',
            result: 'Jumper, John, et al. "Highly accurate protein structure prediction with AlphaFold." Nature, vol. 596, no. 7873, 2021, pp. 583–589. https://doi.org/10.1038/s41586-020-2649-2',
          },
          {
            step: 'Export BibTeX Entry',
            calculation: 'Create LaTeX @article block with citation key jumper2021',
            result: 'Ready for insertion into .bib database',
          },
        ],
      }}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">&blacktriangledown;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-doi-app]');
      if (!root) return;

      const doiVal = root.querySelector('#doi-val');
      const authorVal = root.querySelector('#author-val');
      const titleVal = root.querySelector('#title-val');
      const yearVal = root.querySelector('#year-val');
      const journalVal = root.querySelector('#journal-val');
      const volVal = root.querySelector('#vol-val');
      const pagesVal = root.querySelector('#pages-val');
      const publisherVal = root.querySelector('#publisher-val');
      const fetchBtn = root.querySelector('#fetch-doi-btn');
      const fetchStatus = root.querySelector('#fetch-status');
      const clearBtn = root.querySelector('#clear-btn');

      const citeApa = root.querySelector('#cite-apa');
      const citeMla = root.querySelector('#cite-mla');
      const citeChicago = root.querySelector('#cite-chicago');
      const citeHarvard = root.querySelector('#cite-harvard');
      const citeIeee = root.querySelector('#cite-ieee');
      const citeBib = root.querySelector('#cite-bib');

      const copySingleBtns = root.querySelectorAll('.copy-single-btn');
      const copyAllBtn = root.querySelector('#copy-all-btn');
      const dlBibBtn = root.querySelector('#dl-bib-btn');
      const sampleDoiBtns = root.querySelectorAll('.sample-doi-btn');

      function cleanDoi(raw) {
        return raw.trim()
          .replace(/^https?:\/\/(dx\.)?doi\.org\//i, '')
          .replace(/^doi:\s*/i, '');
      }

      function updateCitations() {
        const a = authorVal.value.trim() || 'Author, A.';
        const t = titleVal.value.trim() || 'Untitled Article';
        const j = journalVal.value.trim() || 'Journal';
        const y = yearVal.value.trim() || '2024';
        const v = volVal.value.trim();
        const p = pagesVal.value.trim();
        const pub = publisherVal.value.trim();
        const rawDoi = cleanDoi(doiVal.value);
        const doiLink = rawDoi ? `https://doi.org/${rawDoi}` : '';

        // Extract volume and issue
        let volNum = v;
        let issueNum = '';
        const vMatch = v.match(/^([^(]+)(?:\(([^)]+)\))?$/);
        if (vMatch) {
          volNum = vMatch[1].trim();
          issueNum = vMatch[2] ? vMatch[2].trim() : '';
        }

        // APA 7th
        let apa = `${a} (${y}). ${t}. <em>${j}</em>`;
        if (volNum) apa += `, <em>${volNum}</em>`;
        if (issueNum) apa += `(${issueNum})`;
        if (p) apa += `, ${p}`;
        if (doiLink) apa += `. ${doiLink}`;
        else apa += '.';
        citeApa.innerHTML = apa;

        // MLA 9th
        let mla = `${a} "${t}." <em>${j}</em>`;
        if (volNum) mla += `, vol. ${volNum}`;
        if (issueNum) mla += `, no. ${issueNum}`;
        mla += `, ${y}`;
        if (p) mla += `, pp. ${p}`;
        if (doiLink) mla += `, ${doiLink}`;
        mla += '.';
        citeMla.innerHTML = mla;

        // Chicago (Author-Date 17th)
        let chicago = `${a} ${y}. "${t}." <em>${j}</em>`;
        if (volNum) chicago += ` ${volNum}`;
        if (issueNum) chicago += `, no. ${issueNum}`;
        if (p) chicago += `: ${p}`;
        if (doiLink) chicago += `. ${doiLink}`;
        else chicago += '.';
        citeChicago.innerHTML = chicago;

        // Harvard Style
        let harvard = `${a}, ${y}. ${t}. <em>${j}</em>`;
        if (volNum) harvard += `, ${volNum}`;
        if (issueNum) harvard += `(${issueNum})`;
        if (p) harvard += `, pp. ${p}`;
        if (doiLink) harvard += `. Available at: &lt;${doiLink}&gt;`;
        else harvard += '.';
        citeHarvard.innerHTML = harvard;

        // IEEE Format
        const firstInitialMatch = a.match(/^(?:([A-Za-z]+),\s*([A-Za-z]+))|([A-Za-z]+)/);
        const ieeeAuthor = firstInitialMatch ? `${firstInitialMatch[2] ? firstInitialMatch[2][0] + '. ' : ''}${firstInitialMatch[1] || firstInitialMatch[3]}` : a;
        let ieee = `${ieeeAuthor}, "${t}," <em>${j}</em>`;
        if (volNum) ieee += `, vol. ${volNum}`;
        if (issueNum) ieee += `, no. ${issueNum}`;
        if (p) ieee += `, pp. ${p}`;
        ieee += `, ${y}`;
        if (doiLink) ieee += `, doi: ${rawDoi}`;
        ieee += '.';
        citeIeee.innerHTML = ieee;

        // BibTeX Key
        const firstWordAuthor = a.split(/[\s,]+/)[0].toLowerCase().replace(/[^a-z0-9]/g, '') || 'article';
        const bibKey = `${firstWordAuthor}${y}`;

        const bibtex = `@article{${bibKey},
  author  = {${a}},
  title   = {${t}},
  journal = {${j}},
  year    = {${y}}${volNum ? `,\n  volume  = {${volNum}}` : ''}${issueNum ? `,\n  number  = {${issueNum}}` : ''}${p ? `,\n  pages   = {${p}}` : ''}${rawDoi ? `,\n  doi     = {${rawDoi}}` : ''}${pub ? `,\n  publisher = {${pub}}` : ''}
}`;
        citeBib.textContent = bibtex;
      }

      async function fetchCrossRef(doi) {
        const clean = cleanDoi(doi);
        if (!clean) {
          showStatus('Please enter a valid DOI.', 'text-rose-500');
          return;
        }

        showStatus('Querying CrossRef API for article metadata...', 'text-cyan-500 dark:text-cyan-400');
        fetchBtn.disabled = true;
        fetchBtn.textContent = 'Fetching...';

        try {
          const res = await fetch(`https://api.crossref.org/works/${encodeURIComponent(clean)}`);
          if (!res.ok) throw new Error('DOI not found in CrossRef registry.');

          const data = await res.json();
          const item = data.message;

          // Authors
          if (item.author && item.author.length > 0) {
            authorVal.value = item.author.map((auth, idx) => {
              const family = auth.family || '';
              const given = auth.given ? auth.given.charAt(0) + '.' : '';
              return idx === 0 && item.author.length > 3
                ? `${family}, ${given} et al.`
                : `${family}, ${given}`;
            }).slice(0, 3).join(', ');
          }

          // Title
          if (item.title && item.title.length > 0) {
            titleVal.value = item.title[0];
          }

          // Journal / Container
          if (item['container-title'] && item['container-title'].length > 0) {
            journalVal.value = item['container-title'][0];
          }

          // Year
          const dateParts = item['published-print']?.['date-parts'] || item['published-online']?.['date-parts'] || item.created?.['date-parts'];
          if (dateParts && dateParts[0] && dateParts[0][0]) {
            yearVal.value = dateParts[0][0];
          }

          // Volume & Issue
          const vol = item.volume || '';
          const issue = item.issue ? `(${item.issue})` : '';
          volVal.value = `${vol}${issue}`;

          // Pages
          if (item.page) {
            pagesVal.value = item.page;
          }

          // Publisher
          if (item.publisher) {
            publisherVal.value = item.publisher;
          }

          showStatus('✓ Article metadata successfully retrieved and loaded!', 'text-cyan-500 dark:text-cyan-400');
          updateCitations();
        } catch (err) {
          showStatus('Online DOI lookup unavailable or DOI not found. You can enter metadata manually below.', 'text-amber-500');
        } finally {
          fetchBtn.disabled = false;
          fetchBtn.textContent = 'Fetch Online Metadata';
        }
      }

      function showStatus(msg, colorClass) {
        fetchStatus.className = `text-xs font-semibold ${colorClass} block`;
        fetchStatus.textContent = msg;
      }

      // Events
      fetchBtn?.addEventListener('click', () => fetchCrossRef(doiVal.value));

      sampleDoiBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          doiVal.value = btn.dataset.doi;
          fetchCrossRef(btn.dataset.doi);
        });
      });

      clearBtn?.addEventListener('click', () => {
        doiVal.value = '';
        authorVal.value = '';
        titleVal.value = '';
        yearVal.value = '';
        journalVal.value = '';
        volVal.value = '';
        pagesVal.value = '';
        publisherVal.value = '';
        updateCitations();
      });

      [doiVal, authorVal, titleVal, yearVal, journalVal, volVal, pagesVal, publisherVal].forEach(el => {
        el?.addEventListener('input', updateCitations);
      });

      // Copy single citation
      copySingleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          const targetEl = root.querySelector(`#${targetId}`);
          if (!targetEl) return;
          const text = targetEl.innerText || targetEl.textContent;
          navigator.clipboard.writeText(text).then(() => {
            const orig = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(() => { btn.textContent = orig; }, 1800);
          });
        });
      });

      // Copy All
      copyAllBtn?.addEventListener('click', () => {
        const text = [
          '=== APA 7th Edition ===',
          citeApa.innerText,
          '\n=== MLA 9th Edition ===',
          citeMla.innerText,
          '\n=== Chicago 17th ===',
          citeChicago.innerText,
          '\n=== Harvard ===',
          citeHarvard.innerText,
          '\n=== IEEE ===',
          citeIeee.innerText,
          '\n=== BibTeX ===',
          citeBib.textContent
        ].join('\n');

        navigator.clipboard.writeText(text).then(() => {
          const orig = copyAllBtn.textContent;
          copyAllBtn.textContent = 'All Copied!';
          setTimeout(() => { copyAllBtn.textContent = orig; }, 1800);
        });
      });

      // Download BibTeX
      dlBibBtn?.addEventListener('click', () => {
        const blob = new Blob([citeBib.textContent], { type: 'application/x-bibtex' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'citation.bib';
        a.click();
      });

      updateCitations();
    })();
  </script>
</SiteLayout>
