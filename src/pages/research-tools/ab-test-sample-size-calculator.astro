---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `A/B Test Sample Size Calculator | Split Test Statistical Power · ${siteName}`;
const pageDesc = 'Calculate required traffic and sample size per variant for A/B split testing based on baseline conversion rate, Minimum Detectable Effect (MDE), statistical power, and daily visitors.';
const canonicalUrl = toAbsoluteUrl('/research-tools/ab-test-sample-size-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'A/B Test Sample Size Calculator' },
];

const faqs = [
  {
    question: 'What is Minimum Detectable Effect (MDE)?',
    answer: 'The Minimum Detectable Effect (MDE) is the smallest percentage change in conversion rate that your experiment is statistically powered to detect. Smaller MDE targets require exponentially larger traffic and sample sizes.',
  },
  {
    question: 'Why is 80% statistical power standard in A/B testing?',
    answer: 'Statistical power (1 - β) is the probability that your test will detect a true lift when one exists. A power of 80% balances test speed with a 20% risk of Type II false negative errors.',
  },
  {
    question: 'How does daily traffic affect split test duration?',
    answer: 'Test duration in days equals required sample size per variant divided by your daily visitor traffic per variant. We recommend running experiments for at least 1 to 2 full 7-day business cycles to normalize day-of-week seasonality.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'A/B Test Sample Size Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Conversion Rate Optimization (CRO)</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        A/B Test Sample Size Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Determine how much traffic and sample size you need per variation to reach statistical significance before launching your experiment.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-abtest-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Experiment Parameters</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="base-cvr" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Baseline Conversion Rate (%)
            </label>
            <input
              id="base-cvr"
              type="number"
              min="0.1"
              max="99"
              step="0.1"
              value="5.0"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none"
              data-base-cvr
            />
          </div>

          <div class="space-y-1.5">
            <label for="mde-input" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Minimum Detectable Effect (Relative MDE %)
            </label>
            <input
              id="mde-input"
              type="number"
              min="1"
              max="100"
              step="1"
              value="10"
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none"
              data-mde-input
            />
            <p class="text-[11px] text-[color:var(--muted)]">A 10% relative lift on a 5.0% baseline detects changes up to 5.5%.</p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="ab-power" class="block text-xs font-medium text-[color:var(--muted)]">Statistical Power</label>
              <select id="ab-power" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-ab-power>
                <option value="80" selected>80% Power (Standard)</option>
                <option value="90">90% Power (High Rigor)</option>
              </select>
            </div>
            <div>
              <label for="ab-conf" class="block text-xs font-medium text-[color:var(--muted)]">Significance Level (α)</label>
              <select id="ab-conf" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-ab-conf>
                <option value="95" selected>95% (α = 0.05)</option>
                <option value="90">90% (α = 0.10)</option>
                <option value="99">99% (α = 0.01)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label for="ab-variants" class="block text-xs font-medium text-[color:var(--muted)]">Variants Count</label>
              <input id="ab-variants" type="number" min="2" max="6" value="2" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-ab-variants />
            </div>
            <div>
              <label for="daily-traffic" class="block text-xs font-medium text-[color:var(--muted)]">Daily Total Visitors (Opt)</label>
              <input id="daily-traffic" type="number" min="10" placeholder="e.g. 2000" class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none" data-daily-traffic />
            </div>
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6 sm:p-8">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Sample Size Requirement</span>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Sample Size Per Variant</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-per-variant>
                30,378
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-total>
                Total Experiment Traffic: 60,756 visitors
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Detectable Conversion Target:</span>
                <span class="font-mono font-bold text-[color:var(--fg)]" data-target-cvr>5.50% (+0.50% absolute)</span>
              </div>
              <div class="flex justify-between" data-duration-row>
                <span class="text-[color:var(--muted)]">Estimated Test Duration:</span>
                <span class="font-mono font-bold text-[color:var(--accent)]" data-duration-days>31 Days</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-abtest-app]');
      if (!root) return;

      const inBase = root.querySelector('[data-base-cvr]');
      const inMde = root.querySelector('[data-mde-input]');
      const inPower = root.querySelector('[data-ab-power]');
      const inConf = root.querySelector('[data-ab-conf]');
      const inVariants = root.querySelector('[data-ab-variants]');
      const inDaily = root.querySelector('[data-daily-traffic]');
      const outPerVar = root.querySelector('[data-res-per-variant]');
      const outTotal = root.querySelector('[data-res-total]');
      const outTargetCvr = root.querySelector('[data-target-cvr]');
      const outDuration = root.querySelector('[data-duration-days]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      const zMap = { '90': 1.644853, '95': 1.959964, '99': 2.575829 };
      const powerZMap = { '80': 0.841621, '90': 1.281552 };

      function update() {
        const p1 = Math.max(0.001, parseFloat(inBase.value || '5.0') / 100);
        const mde = Math.max(0.1, parseFloat(inMde.value || '10') / 100);
        const zAlpha = zMap[inConf.value] || 1.96;
        const zBeta = powerZMap[inPower.value] || 0.8416;
        const variants = Math.max(2, parseInt(inVariants.value || '2', 10));
        const daily = inDaily.value ? parseInt(inDaily.value, 10) : undefined;

        const delta = p1 * mde;
        const p2 = p1 + delta;
        const pBar = (p1 + p2) / 2;

        const term1 = zAlpha * Math.sqrt(2 * pBar * (1 - pBar));
        const term2 = zBeta * Math.sqrt(p1 * (1 - p1) + p2 * (1 - p2));
        const nPer = Math.ceil(Math.pow(term1 + term2, 2) / Math.pow(delta, 2));
        const total = nPer * variants;

        if (outPerVar) outPerVar.textContent = nPer.toLocaleString();
        if (outTotal) outTotal.textContent = `Total Experiment Traffic: ${total.toLocaleString()} visitors (${variants} variants)`;
        if (outTargetCvr) outTargetCvr.textContent = `${(p2 * 100).toFixed(2)}% (+${(delta * 100).toFixed(2)}% absolute lift)`;

        if (outDuration) {
          if (daily && daily > 0) {
            const days = Math.ceil(total / daily);
            outDuration.textContent = `${days} Days (${(daily / variants).toFixed(0)} visitors/day per variant)`;
          } else {
            outDuration.textContent = 'Enter daily traffic above to calculate days';
          }
        }
      }

      inBase.addEventListener('input', update);
      inMde.addEventListener('input', update);
      inPower.addEventListener('change', update);
      inConf.addEventListener('change', update);
      inVariants.addEventListener('input', update);
      inDaily.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inBase.value = '5.0';
          inMde.value = '10';
          inPower.value = '80';
          inConf.value = '95';
          inVariants.value = '2';
          inDaily.value = '2000';
          update();
        });
      }

      update();
    })();
  </script>
</SiteLayout>
