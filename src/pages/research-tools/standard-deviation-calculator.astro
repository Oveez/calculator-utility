---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Standard Deviation Calculator — Sample & Population Variance · ${siteName}`;
const pageDesc = 'Calculate sample standard deviation (s), population standard deviation (σ), variance, mean, sum, and count online with step-by-step statistical formulas.';
const canonicalUrl = toAbsoluteUrl('/research-tools/standard-deviation-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'Standard Deviation Calculator' },
];

const schemaFaq = [
  {
    question: 'What is the difference between Sample (s) and Population (σ) Standard Deviation?',
    answer: 'Sample standard deviation divides sum of squared deviations by `n - 1` (Bessel’s correction) to provide an unbiased estimator for sample subsets. Population standard deviation divides by `N` when data contains the entire population.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Standard Deviation Calculator',
    url: canonicalUrl,
    applicationCategory: 'AcademicApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-sd-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Statistical Dispersion Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Standard Deviation &amp; Variance Calculator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Compute sample standard deviation (s), population standard deviation (σ), variance, mean, and range.
      </p>
    </header>

    <div class="space-y-6">
      <div class="space-y-2">
        <label for="data-vals" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Enter Dataset Values (comma or space separated)</label>
        <textarea
          id="data-vals"
          rows="4"
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-[color:var(--fg)] focus:border-[color:var(--border-strong)] focus:outline-hidden"
          placeholder="12, 15, 18, 22, 25, 30"
        >10, 12, 23, 23, 16, 23, 21, 16</textarea>
      </div>

      <!-- Stats Grid -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 text-center">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Sample SD (s)</span>
          <p id="res-sample-sd" class="text-2xl font-extrabold text-emerald-500">-</p>
          <p class="text-[10px] text-[color:var(--muted)]">n - 1 Bessel Divisor</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Population SD (σ)</span>
          <p id="res-pop-sd" class="text-2xl font-extrabold text-[color:var(--fg)]">-</p>
          <p class="text-[10px] text-[color:var(--muted)]">N Divisor</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Sample Variance (s²)</span>
          <p id="res-var" class="text-2xl font-extrabold text-[color:var(--fg)]">-</p>
        </div>

        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-1">
          <span class="text-xs font-bold text-[color:var(--muted)] uppercase">Mean (μ / x̄)</span>
          <p id="res-mean" class="text-2xl font-extrabold text-[color:var(--fg)]">-</p>
          <p id="res-count" class="text-[10px] text-[color:var(--muted)]">Count: 0</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-sd-app]');
      if (!root) return;

      const dataInput = root.querySelector('#data-vals');
      const resSampleSd = root.querySelector('#res-sample-sd');
      const resPopSd = root.querySelector('#res-pop-sd');
      const resVar = root.querySelector('#res-var');
      const resMean = root.querySelector('#res-mean');
      const resCount = root.querySelector('#res-count');

      function calculate() {
        const nums = dataInput.value.split(/[\s,]+/).map(Number).filter(n => !isNaN(n));
        const n = nums.length;

        if (n === 0) {
          resSampleSd.textContent = '-'; resPopSd.textContent = '-'; resVar.textContent = '-';
          resMean.textContent = '-'; resCount.textContent = 'Count: 0';
          return;
        }

        const sum = nums.reduce((a, b) => a + b, 0);
        const mean = sum / n;
        const sqDiffs = nums.reduce((a, b) => a + Math.pow(b - mean, 2), 0);

        const popSd = Math.sqrt(sqDiffs / n);
        const sampleSd = n > 1 ? Math.sqrt(sqDiffs / (n - 1)) : 0;
        const sampleVar = n > 1 ? sqDiffs / (n - 1) : 0;

        resSampleSd.textContent = sampleSd.toFixed(4);
        resPopSd.textContent = popSd.toFixed(4);
        resVar.textContent = sampleVar.toFixed(4);
        resMean.textContent = mean.toFixed(4);
        resCount.textContent = `Count: ${n} numbers (Sum: ${sum})`;
      }

      dataInput.addEventListener('input', calculate);
      calculate();
    })();
  </script>
</SiteLayout>
