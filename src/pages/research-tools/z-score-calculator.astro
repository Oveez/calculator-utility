---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Z-Score Calculator | Standard Normal Score & Percentile Rank · ${siteName}`;
const pageDesc = 'Calculate Z-score, percentile ranking, and normal distribution probabilities (left-tail, right-tail, two-tailed) from raw test scores, mean, and standard deviation.';
const canonicalUrl = toAbsoluteUrl('/research-tools/z-score-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'Z-Score Calculator' },
];

const faqs = [
  {
    question: 'What is a Z-score and how is it calculated?',
    answer: 'A Z-score measures how many standard deviations a raw data point X lies above or below the mean μ: Z = (X - μ) ÷ σ. A Z-score of +2.0 means the value is two standard deviations above the population average.',
  },
  {
    question: 'How does Z-score convert to a percentile rank?',
    answer: 'The percentile rank is the cumulative probability of the standard normal distribution Φ(Z) multiplied by 100. For instance, a Z-score of 0.0 corresponds to the 50th percentile, while Z = +1.96 corresponds to the 97.5th percentile.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Z-Score Calculator',
    url: canonicalUrl,
    description: pageDesc,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-semibold text-[color:var(--fg)]">
        <span>Standard Normal Distribution</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Z-Score &amp; Percentile Calculator
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Transform raw observational data and exam scores into standard normal distribution Z-scores. Instantly view percentile rank and area under the bell curve.
      </p>
    </header>

    <div
      class="rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-[var(--shadow)] sm:p-10"
      data-zscore-app
    >
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <form class="space-y-5" onsubmit="return false;">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-[color:var(--fg)]">Distribution Data</h2>
            <button type="button" class="cursor-pointer text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)]" data-reset-btn>
              ↺ Reset
            </button>
          </div>

          <div class="space-y-1.5">
            <label for="raw-score" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Raw Score (X)</label>
            <input id="raw-score" type="number" step="any" value="85" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-raw-score />
          </div>

          <div class="space-y-1.5">
            <label for="pop-mean" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Population Mean (μ)</label>
            <input id="pop-mean" type="number" step="any" value="70" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-pop-mean />
          </div>

          <div class="space-y-1.5">
            <label for="pop-sd" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Standard Deviation (σ)</label>
            <input id="pop-sd" type="number" min="0.0001" step="any" value="10" class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base font-semibold text-[color:var(--fg)] outline-none" data-pop-sd />
          </div>
        </form>

        <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6 sm:p-8">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Standard Normal Output</span>

            <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center">
              <p class="text-xs font-semibold text-[color:var(--muted)]">Calculated Z-Score</p>
              <p class="mt-1 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-z>
                +1.50
              </p>
              <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-percentile>
                93.32th Percentile Ranking
              </p>
            </div>

            <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Left Tail Area P(Z &lt; z):</span>
                <span class="font-mono font-bold text-[color:var(--fg)]" data-p-left>0.9332 (93.32%)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Right Tail Area P(Z &gt; z):</span>
                <span class="font-mono font-bold text-[color:var(--fg)]" data-p-right>0.0668 (6.68%)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[color:var(--muted)]">Two-Tailed P(|Z| &gt; |z|):</span>
                <span class="font-mono font-bold text-[color:var(--fg)]" data-p-two>0.1336</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-zscore-app]');
      if (!root) return;

      const inRaw = root.querySelector('[data-raw-score]');
      const inMean = root.querySelector('[data-pop-mean]');
      const inSd = root.querySelector('[data-pop-sd]');
      const outZ = root.querySelector('[data-res-z]');
      const outPct = root.querySelector('[data-res-percentile]');
      const outPLeft = root.querySelector('[data-p-left]');
      const outPRight = root.querySelector('[data-p-right]');
      const outPTwo = root.querySelector('[data-p-two]');
      const resetBtn = root.querySelector('[data-reset-btn]');

      function erf(x) {
        const sign = x >= 0 ? 1 : -1;
        const absX = Math.abs(x);
        const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
        const t = 1.0 / (1.0 + p * absX);
        const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-absX * absX);
        return sign * y;
      }

      function normalCdf(z) {
        return 0.5 * (1 + erf(z / Math.SQRT2));
      }

      function update() {
        const x = parseFloat(inRaw.value || '0');
        const m = parseFloat(inMean.value || '0');
        const s = Math.max(0.000001, parseFloat(inSd.value || '1'));

        const z = (x - m) / s;
        const left = normalCdf(z);
        const right = 1 - left;
        const two = 2 * Math.min(left, right);

        const zSign = z >= 0 ? `+${z.toFixed(2)}` : z.toFixed(2);
        if (outZ) outZ.textContent = zSign;
        if (outPct) outPct.textContent = `${(left * 100).toFixed(2)}th Percentile Ranking`;
        if (outPLeft) outPLeft.textContent = `${left.toFixed(4)} (${(left * 100).toFixed(2)}%)`;
        if (outPRight) outPRight.textContent = `${right.toFixed(4)} (${(right * 100).toFixed(2)}%)`;
        if (outPTwo) outPTwo.textContent = two.toFixed(4);
      }

      inRaw.addEventListener('input', update);
      inMean.addEventListener('input', update);
      inSd.addEventListener('input', update);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inRaw.value = '85';
          inMean.value = '70';
          inSd.value = '10';
          update();
        });
      }

      update();
    })();
  </script>
</SiteLayout>
