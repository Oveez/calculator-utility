---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Participant ID Generator — Anonymized Research Subject Codes · ${siteName}`;
const pageDesc = 'Generate anonymized participant codes (PID-XXXX) and research subject ID lists for clinical trials, psychology studies, and surveys. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/research-tools/participant-id-generator/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Research Tools', href: toAbsoluteUrl('/research-tools/') },
  { label: 'Participant ID Generator' },
];

const schemaFaq = [
  {
    question: 'Why are randomized Participant IDs required in research?',
    answer: 'Anonymized identifiers prevent researcher bias, comply with institutional ethics (IRB/HIPAA/GDPR), and ensure subject confidentiality by decoupling personal data from study measurements.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Participant ID Generator',
    url: canonicalUrl,
    applicationCategory: 'AcademicApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pid-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>IRB-Compliant Subject Anonymizer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Participant ID Generator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Generate custom, anonymized subject codes and cohort identifiers in bulk for clinical trials and surveys.
      </p>
    </header>

    <div class="space-y-6">
      <div class="grid gap-4 sm:grid-cols-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="pid-prefix" class="font-bold text-[color:var(--fg)] block mb-1">Prefix Code:</label>
          <input
            type="text"
            id="pid-prefix"
            value="PID-"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="pid-count" class="font-bold text-[color:var(--fg)] block mb-1">Total Subjects:</label>
          <input
            type="number"
            id="pid-count"
            min="1"
            max="1000"
            value="25"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="pid-digits" class="font-bold text-[color:var(--fg)] block mb-1">Digit Padding:</label>
          <select id="pid-digits" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="4">4 Digits (0001)</option>
            <option value="3">3 Digits (001)</option>
            <option value="5">5 Digits (00001)</option>
            <option value="rand">Alphanumeric Random (e.g. A9X2)</option>
          </select>
        </div>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <button
            type="button"
            data-gen-btn
            class="rounded-xl bg-[color:var(--fg)] px-5 py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
          >
            Generate Participant Codes
          </button>
          <div class="flex items-center gap-2">
            <button type="button" data-copy-btn class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] hover:underline">
              <Icon name="copy" class="w-3.5 h-3.5" />
              <span>Copy All</span>
            </button>
            <span class="text-[color:var(--border)]">|</span>
            <button type="button" data-dl-btn class="text-xs font-bold text-[color:var(--fg)] hover:underline">Download CSV</button>
          </div>
        </div>

        <textarea
          id="pid-out"
          rows="12"
          readonly
          class="w-full font-mono text-xs leading-relaxed rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 text-[color:var(--fg)] focus:outline-hidden"
          placeholder="Generated subject IDs will appear here..."
        ></textarea>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pid-app]');
      if (!root) return;

      const prefix = root.querySelector('#pid-prefix');
      const count = root.querySelector('#pid-count');
      const digits = root.querySelector('#pid-digits');
      const genBtn = root.querySelector('[data-gen-btn]');
      const output = root.querySelector('#pid-out');
      const copyBtn = root.querySelector('[data-copy-btn]');
      const dlBtn = root.querySelector('[data-dl-btn]');

      function getRandomHex(len = 4) {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        let res = '';
        for (let i = 0; i < len; i++) {
          res += chars[Math.floor(Math.random() * chars.length)];
        }
        return res;
      }

      function generatePids() {
        const p = prefix.value.trim();
        const n = Math.min(1000, Math.max(1, parseInt(count.value, 10) || 25));
        const mode = digits.value;

        const list = ['Participant_ID'];
        for (let i = 1; i <= n; i++) {
          if (mode === 'rand') {
            list.push(`${p}${getRandomHex(4)}`);
          } else {
            const padLen = parseInt(mode, 10);
            list.push(`${p}${String(i).padStart(padLen, '0')}`);
          }
        }

        output.value = list.join('\n');
      }

      genBtn.addEventListener('click', generatePids);

      copyBtn.addEventListener('click', () => {
        if (!output.value) return;
        navigator.clipboard.writeText(output.value);
        const span = copyBtn.querySelector('span');
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => span.textContent = orig, 1800);
      });

      dlBtn.addEventListener('click', () => {
        if (!output.value) return;
        const blob = new Blob([output.value], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'participant_ids.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      generatePids();
    })();
  </script>
</SiteLayout>
