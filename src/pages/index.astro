  <!-- New Specialized Tool Suites Showcase -->
  <section class="mt-12 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Utility Directory</p>
