        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-500 shadow-xs">
              <Icon name="image" class="w-4 h-4" />
            </div>
            <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">10 Tools</span>
