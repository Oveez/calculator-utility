    </div>

    <!-- Empty search result alert -->
    <div class="rounded-2xl border border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-8 text-center text-[color:var(--muted)]" data-search-empty hidden>
      <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)]">
        <Icon name="search" class="w-5 h-5 text-[color:var(--muted)]" />
      </div>
      <p class="mt-3 text-base font-bold text-[color:var(--fg)]">No calculators found</p>
      <p class="mt-1 text-xs">No tools match your current search or category filter.</p>
      <button
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-[color:var(--accent)] px-4 py-2 text-xs font-bold text-white shadow-xs transition hover:opacity-90"
        data-reset-filters
      >
        Show All Calculators
      </button>
    </div>
  </section>

  <!-- Client-Side Search & Category Filter Logic -->
  <script is:inline>
    (function () {
      const searchInputs = Array.from(document.querySelectorAll('[data-calculator-search]'));
      const cards = Array.from(document.querySelectorAll('[data-calculator-card]'));
      const categoryTabs = Array.from(document.querySelectorAll('[data-category-tab]'));
      const heroCategoryButtons = Array.from(document.querySelectorAll('[data-hero-category]'));
      const resetButtons = Array.from(document.querySelectorAll('[data-reset-filters]'));
      const searchCount = document.querySelector('[data-search-count]');
      const activeCategoryLabel = document.querySelector('[data-active-category-label]');
      const activeFilterBar = document.querySelector('[data-active-filter-bar]');
      const filterSummary = document.querySelector('[data-filter-summary]');
      const emptyState = document.querySelector('[data-search-empty]');
      const grid = document.querySelector('[data-calculator-grid]');

      let activeCategory = '';
      let currentQuery = '';

      function getSearchQuery() {
        const input = searchInputs.find((i) => i && i.value);
        return (input ? input.value : currentQuery).trim().toLowerCase();
      }

      function updateResults() {
        const query = getSearchQuery();
        let visibleCount = 0;

        cards.forEach((card) => {
          const searchableText = (card.dataset.searchText || '').toLowerCase();
          const cardCategory = (card.dataset.calculatorCategory || '').trim();
          const matchesSearch = query.length === 0 || searchableText.includes(query);
          const matchesCategory = activeCategory.length === 0 || cardCategory.toLowerCase() === activeCategory.toLowerCase();
          const isVisible = matchesSearch && matchesCategory;

          if (isVisible) {
            card.removeAttribute('hidden');
            card.style.display = '';
            visibleCount += 1;
          } else {
            card.setAttribute('hidden', '');
            card.style.display = 'none';
          }
        });

        // Update indicators & counters
        if (searchCount) searchCount.textContent = String(visibleCount);
        if (activeCategoryLabel) activeCategoryLabel.textContent = activeCategory || 'All Categories';

        // Update active filter summary bar
        if (activeFilterBar && filterSummary) {
          const hasFilters = activeCategory.length > 0 || query.length > 0;
          if (hasFilters) {
            activeFilterBar.removeAttribute('hidden');
            activeFilterBar.style.display = 'flex';
            const parts = [];
            if (activeCategory) parts.push(`Category: "${activeCategory}"`);
            if (query) parts.push(`Search: "${query}"`);
            filterSummary.textContent = parts.join(' | ');
          } else {
            activeFilterBar.setAttribute('hidden', '');
            activeFilterBar.style.display = 'none';
          }
        }

        // Empty state alert
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.removeAttribute('hidden');
            emptyState.style.display = 'block';
          } else {
            emptyState.setAttribute('hidden', '');
            emptyState.style.display = 'none';
          }
        }
      }

      function setActiveCategory(catName, shouldScroll = false) {
        activeCategory = (catName || '').trim();

        categoryTabs.forEach((tab) => {
          const tabCat = (tab.dataset.categoryName || '').trim();
          const isSelected = (!activeCategory && !tabCat) || (activeCategory && tabCat.toLowerCase() === activeCategory.toLowerCase());

          tab.setAttribute('aria-pressed', String(isSelected));
          tab.setAttribute('aria-selected', String(isSelected));

          const colorClass = tab.dataset.colorClass || 'text-[color:var(--fg)]';
          const bgClass = tab.dataset.bgClass || 'bg-[color:var(--surface-strong)]';

          if (isSelected) {
            if (!tabCat) {
              tab.className = 'inline-flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-1.5 text-xs font-bold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current border-[color:var(--border-strong)] bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs active';
            } else {
              tab.className = `inline-flex cursor-pointer items-center gap-2 rounded-xl border border-current px-3.5 py-1.5 text-xs font-bold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current ${colorClass} ${bgClass} shadow-xs active`;
            }
          } else {
            tab.className = 'inline-flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]';
          }
        });

        if (grid) {
          grid.classList.remove('tab-content-enter');
          void grid.offsetWidth;
          grid.classList.add('tab-content-enter');
        }

        updateResults();

        if (shouldScroll) {
          const target = document.getElementById('calculators');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

      function resetAllFilters() {
        searchInputs.forEach((input) => {
          if (input) input.value = '';
        });
        currentQuery = '';
        setActiveCategory('');
      }

      function readUrlCategory() {
        try {
          const params = new URLSearchParams(window.location.search);
          let cat = params.get('category');
          if (!cat && window.location.hash) {
            const hash = window.location.hash;
            if (hash.includes('category=')) {
              const hashParams = new URLSearchParams(hash.split('?')[1] || hash.substring(1));
              cat = hashParams.get('category');
            }
          }
          if (cat) {
            setActiveCategory(decodeURIComponent(cat));
          }
        } catch (e) {}
      }

      categoryTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const cat = tab.dataset.categoryName || '';
          setActiveCategory(cat);
        });
      });

      heroCategoryButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.heroCategory || '';
          setActiveCategory(cat, true);
        });
      });

      searchInputs.forEach((input) => {
        input.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          searchInputs.forEach((other) => {
            if (other !== input) other.value = currentQuery;
          });
          updateResults();
        });
      });

      resetButtons.forEach((btn) => {
        btn.addEventListener('click', resetAllFilters);
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) {
          const mainSearch = searchInputs[0];
          if (mainSearch) {
            e.preventDefault();
            mainSearch.focus();
            mainSearch.select();
          }
        }
      });

      window.addEventListener('popstate', readUrlCategory);
      window.addEventListener('hashchange', readUrlCategory);

      readUrlCategory();
      updateResults();
    })();
  </script>
</SiteLayout>
