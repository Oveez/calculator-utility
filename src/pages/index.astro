  <!-- Client-Side Modern Scrolling & Directory Filter Logic -->
  <script is:inline>
    (function () {
      // 1. HORIZONTAL CAROUSELS LOGIC (Scroll-Snap, Next/Prev, Drag-to-Scroll, Progress Bar)
      function initCarousels() {
        const carousels = document.querySelectorAll('[data-carousel]');

        carousels.forEach((carousel) => {
          const track = carousel.querySelector('[data-carousel-track]');
          const prevBtn = carousel.querySelector('[data-carousel-prev]');
          const nextBtn = carousel.querySelector('[data-carousel-next]');
          const fadeLeft = carousel.querySelector('[data-carousel-fade-left]');
          const fadeRight = carousel.querySelector('[data-carousel-fade-right]');
          const progressBar = carousel.querySelector('[data-carousel-progress-bar]');

          if (!track) return;

          function updateControls() {
            const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
            const currentScroll = track.scrollLeft;

            if (prevBtn) {
              prevBtn.disabled = currentScroll <= 4;
            }
            if (nextBtn) {
              nextBtn.disabled = currentScroll >= maxScroll - 4;
            }
            if (fadeLeft) {
              fadeLeft.style.opacity = currentScroll > 12 ? '1' : '0';
            }
            if (fadeRight) {
              fadeRight.style.opacity = currentScroll < maxScroll - 12 ? '1' : '0';
            }
            if (progressBar && maxScroll > 0) {
              const thumbPercent = Math.min(100, Math.max(10, (track.clientWidth / track.scrollWidth) * 100));
              const progressRatio = currentScroll / maxScroll;
              progressBar.style.width = thumbPercent + '%';
              progressBar.style.transform = `translateX(${progressRatio * (100 / (thumbPercent / 100) - 100)}%)`;
            }
          }

          if (prevBtn) {
            prevBtn.addEventListener('click', () => {
              track.scrollBy({ left: -Math.max(260, track.clientWidth * 0.75), behavior: 'smooth' });
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', () => {
              track.scrollBy({ left: Math.max(260, track.clientWidth * 0.75), behavior: 'smooth' });
            });
          }

          track.addEventListener('scroll', () => {
            requestAnimationFrame(updateControls);
          }, { passive: true });

          // Mouse Drag-to-Scroll support for desktop users
          let isDown = false;
          let startX = 0;
          let scrollLeft = 0;
          let hasDragged = false;

          track.addEventListener('mousedown', (e) => {
            isDown = true;
            hasDragged = false;
            track.classList.add('cursor-grabbing');
            track.classList.remove('cursor-grab');
            startX = e.pageX - track.offsetLeft;
            scrollLeft = track.scrollLeft;
          });

          window.addEventListener('mouseup', () => {
            if (!isDown) return;
            isDown = false;
            track.classList.remove('cursor-grabbing');
            track.classList.add('cursor-grab');
          });

          track.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - track.offsetLeft;
            const walk = (x - startX) * 1.3;
            if (Math.abs(walk) > 5) {
              hasDragged = true;
            }
            track.scrollLeft = scrollLeft - walk;
          });

          track.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopPropagation();
            }
          }, true);

          // Initial control update
          updateControls();
          window.addEventListener('resize', updateControls);
        });
      }

      // 2. ALL TOOLS DIRECTORY FILTER & STREAMLINED PAGINATION
      const searchInputs = Array.from(document.querySelectorAll('[data-calculator-search]'));
      const grid = document.querySelector('[data-calculator-grid]');
      const cards = grid ? Array.from(grid.querySelectorAll('[data-calculator-card]')) : [];
      const categoryTabs = Array.from(document.querySelectorAll('[data-category-tab]'));
      const resetButtons = Array.from(document.querySelectorAll('[data-reset-filters]'));
      const searchCount = document.querySelector('[data-search-count]');
      const activeCategoryLabel = document.querySelector('[data-active-category-label]');
      const activeFilterBar = document.querySelector('[data-active-filter-bar]');
      const filterSummary = document.querySelector('[data-filter-summary]');
      const emptyState = document.querySelector('[data-search-empty]');
      const paginationContainer = document.querySelector('[data-pagination-container]');
      const paginationShown = document.querySelector('[data-pagination-shown]');
      const paginationTotal = document.querySelector('[data-pagination-total]');
      const loadMoreBtn = document.querySelector('[data-load-more-btn]');
      const showAllBtn = document.querySelector('[data-show-all-btn]');
      const categoryJumpLinks = Array.from(document.querySelectorAll('[data-category-jump]'));

      let activeCategory = '';
      let currentQuery = '';
      let pageSize = 12; // Start with clean 12 tools in "All" view to eliminate vertical scroll
      const PAGE_INCREMENT = 18;

      function getSearchQuery() {
        const input = searchInputs.find((i) => i && i.value);
        return (input ? input.value : currentQuery).trim().toLowerCase();
      }

      function updateResults() {
        const query = getSearchQuery();
        const isFiltering = query.length > 0 || activeCategory.length > 0;
        let matchedCount = 0;
        let visibleCount = 0;

        cards.forEach((card) => {
          const searchableText = (card.dataset.searchText || '').toLowerCase();
          const cardCategory = (card.dataset.calculatorCategory || '').trim();
          const matchesSearch = query.length === 0 || searchableText.includes(query);
          const matchesCategory = activeCategory.length === 0 || cardCategory.toLowerCase() === activeCategory.toLowerCase();
          const isMatch = matchesSearch && matchesCategory;

          if (isMatch) {
            matchedCount += 1;
            // In "All" view without search, apply pagination limit to avoid endless scrolling
            const withinPage = isFiltering || matchedCount <= pageSize;
            if (withinPage) {
              card.removeAttribute('hidden');
              card.style.display = '';
              visibleCount += 1;
            } else {
              card.setAttribute('hidden', '');
              card.style.display = 'none';
            }
          } else {
            card.setAttribute('hidden', '');
            card.style.display = 'none';
          }
        });

        // Update counters & labels
        if (searchCount) searchCount.textContent = String(matchedCount);
        if (activeCategoryLabel) activeCategoryLabel.textContent = activeCategory || 'All Categories';

        // Update pagination bar
        if (paginationContainer) {
          if (isFiltering || matchedCount <= pageSize) {
            paginationContainer.style.display = 'none';
          } else {
            paginationContainer.style.display = 'flex';
            if (paginationShown) paginationShown.textContent = String(visibleCount);
            if (paginationTotal) paginationTotal.textContent = String(matchedCount);

            const remaining = matchedCount - visibleCount;
            if (loadMoreBtn) {
              const nextBatch = Math.min(PAGE_INCREMENT, remaining);
              loadMoreBtn.innerHTML = `<span>Load More (+${nextBatch})</span><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>`;
            }
          }
        }

        // Update active filter summary bar
        if (activeFilterBar && filterSummary) {
          if (isFiltering) {
            activeFilterBar.removeAttribute('hidden');
            activeFilterBar.style.display = 'flex';
            const parts = [];
            if (activeCategory) parts.push(`Category: "${activeCategory}"`);
            if (query) parts.push(`Search: "${query}"`);
            filterSummary.textContent = parts.join(' | ');
          } else {
            activeFilterBar.setAttribute('hidden', '');
            activeFilterBar.style.display = 'none';
          }
        }

        // Empty state alert
        if (emptyState) {
          if (matchedCount === 0) {
            emptyState.removeAttribute('hidden');
            emptyState.style.display = 'block';
          } else {
            emptyState.setAttribute('hidden', '');
            emptyState.style.display = 'none';
          }
        }
      }

      function setActiveCategory(catName, shouldScroll = false) {
        activeCategory = (catName || '').trim();

        categoryTabs.forEach((tab) => {
          const tabCat = (tab.dataset.categoryName || '').trim();
          const isSelected = (!activeCategory && !tabCat) || (activeCategory && tabCat.toLowerCase() === activeCategory.toLowerCase());

          tab.setAttribute('aria-pressed', String(isSelected));
          tab.setAttribute('aria-selected', String(isSelected));

          const icon = tab.querySelector('[data-tab-icon]');
          const countBadge = tab.querySelector('[data-tab-count]');
          const iconColor = tab.dataset.iconColor || 'text-[color:var(--muted)]';

          if (isSelected) {
            tab.className = 'inline-flex shrink-0 cursor-pointer items-center gap-2 border border-transparent bg-slate-900 text-white px-3 py-1.5 text-xs font-bold shadow-xs active transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current';
            if (icon) {
              icon.className = 'w-3.5 h-3.5 stroke-current shrink-0 text-white';
            }
            if (countBadge) {
              countBadge.className = 'px-1.5 py-0.2 text-[10px] font-bold bg-white/20 text-white';
            }
            // Auto scroll category tab into view on horizontal rail
            tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            tab.className = 'inline-flex shrink-0 cursor-pointer items-center gap-2 border border-[color:var(--border)] bg-white text-[color:var(--muted)] hover:border-[color:var(--accent)] hover:text-[color:var(--fg)] px-3 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current';
            if (icon) {
              icon.className = `w-3.5 h-3.5 stroke-current shrink-0 ${iconColor}`;
            }
            if (countBadge) {
              countBadge.className = 'px-1.5 py-0.2 text-[10px] font-bold bg-slate-100 text-[color:var(--muted)]';
            }
          }
        });

        updateResults();

        if (shouldScroll) {
          const target = document.getElementById('calculators');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

      function resetAllFilters() {
        searchInputs.forEach((input) => {
          if (input) input.value = '';
        });
        currentQuery = '';
        pageSize = 12;
        setActiveCategory('');
      }

      function readUrlCategory() {
        try {
          const params = new URLSearchParams(window.location.search);
          let cat = params.get('category');
          if (!cat && window.location.hash) {
            const hash = window.location.hash;
            if (hash.includes('category=')) {
              const hashParams = new URLSearchParams(hash.split('?')[1] || hash.substring(1));
              cat = hashParams.get('category');
            }
          }
          if (cat) {
            setActiveCategory(decodeURIComponent(cat));
          }
        } catch (e) {}
      }

      // Pagination events
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', () => {
          pageSize += PAGE_INCREMENT;
          updateResults();
        });
      }

      if (showAllBtn) {
        showAllBtn.addEventListener('click', () => {
          pageSize = 9999;
          updateResults();
        });
      }

      // Quick jump links from shelves to categories
      categoryJumpLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          const cat = link.dataset.categoryJump;
          if (cat) {
            setActiveCategory(cat, true);
          }
        });
      });

      categoryTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const cat = tab.dataset.categoryName || '';
          setActiveCategory(cat);
        });
      });

      searchInputs.forEach((input) => {
        input.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          searchInputs.forEach((other) => {
            if (other !== input) other.value = currentQuery;
          });
          updateResults();
        });
      });

      resetButtons.forEach((btn) => {
        btn.addEventListener('click', resetAllFilters);
      });

      // Keyboard hotkey '/' for quick search focus
      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) {
          const mainSearch = searchInputs[0];
          if (mainSearch) {
            e.preventDefault();
            mainSearch.focus();
            mainSearch.select();
            const calculatorsSection = document.getElementById('calculators');
            if (calculatorsSection) {
              calculatorsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      });

      window.addEventListener('popstate', readUrlCategory);
      window.addEventListener('hashchange', readUrlCategory);

      // Run on page load
      initCarousels();
      readUrlCategory();
      updateResults();
    })();
  </script>
</SiteLayout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .cursor-grab {
    cursor: grab;
  }
  .cursor-grabbing {
    cursor: grabbing;
    user-select: none;
  }
</style>
