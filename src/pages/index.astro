---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHeroBanner from '../components/HomeHeroBanner.astro';
import Icon from '../components/Icon.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { allToolsIndex } from '../data/allToolsIndex';
import { siteName, siteTagline, withBasePath } from '../utils/site';
import { getCategoryIconConfig } from '../utils/toolIcons';

// Logical category ordering for the 186 tools directory
const categoryOrder = [
  'Finance',
  'Tax & Finance',
  'Education',
  'Academic',
  'Health',
  'Math',
  'Converters',
  'Time',
  'Text',
  'Data',
  'Developer',
  'Image',
  'PDF',
  'Color',
  'Generators',
  'Research',
  'Business',
  'Career',
  'Pricing',
  'Shipping',
  'URL',
];

const uniqueCategories = Array.from(new Set(allToolsIndex.map((t) => t.category))).sort((a, b) => {
  const ia = categoryOrder.indexOf(a);
  const ib = categoryOrder.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b);
});

const categories = uniqueCategories.map((category) => ({
  name: category,
  count: allToolsIndex.filter((tool) => tool.category === category).length,
}));

// Category tabs including "All"
const categoryTabs = [{ name: 'All', count: allToolsIndex.length }, ...categories];

// 1. Trending & Popular Calculators (10 flagship tools)
const popularUrls = [
  '/calculators/mortgage-calculator/',
  '/currency-converter/',
  '/calculators/compound-interest-calculator/',
  '/pdf-tools/pdf-editor/',
  '/career-tools/cv-maker/',
  '/calculators/bmi-calculator/',
  '/calculators/gpa-calculator/',
  '/calculators/percentage-calculator/',
  '/calculators/discount-calculator/',
  '/calculators/salary-calculator/',
];
const popularTools = popularUrls
  .map((url) => allToolsIndex.find((t) => t.url === url))
  .filter((t): t is typeof allToolsIndex[0] => Boolean(t));

// 2. 24 Statutory Country Tax Engines
const taxEngines = [
  { country: 'United States', flag: '🇺🇸', authority: 'IRS', currency: 'USD ($)', path: '/us-income-tax-calculator/' },
  { country: 'United Kingdom', flag: '🇬🇧', authority: 'HMRC', currency: 'GBP (£)', path: '/uk-income-tax-calculator/' },
  { country: 'Canada', flag: '🇨🇦', authority: 'CRA', currency: 'CAD ($)', path: '/canada-income-tax-calculator/' },
  { country: 'Australia', flag: '🇦🇺', authority: 'ATO', currency: 'AUD ($)', path: '/australia-income-tax-calculator/' },
  { country: 'Germany', flag: '🇩🇪', authority: 'BMF', currency: 'EUR (€)', path: '/germany-income-tax-calculator/' },
  { country: 'France', flag: '🇫🇷', authority: 'DGFiP', currency: 'EUR (€)', path: '/france-income-tax-calculator/' },
  { country: 'Ireland', flag: '🇮🇪', authority: 'Revenue', currency: 'EUR (€)', path: '/ireland-income-tax-calculator/' },
  { country: 'Netherlands', flag: '🇳🇱', authority: 'Box 1', currency: 'EUR (€)', path: '/netherlands-income-tax-calculator/' },
  { country: 'Spain', flag: '🇪🇸', authority: 'AEAT', currency: 'EUR (€)', path: '/spain-income-tax-calculator/' },
  { country: 'Italy', flag: '🇮🇹', authority: 'IRPEF', currency: 'EUR (€)', path: '/italy-income-tax-calculator/' },
  { country: 'Switzerland', flag: '🇨🇭', authority: 'ESTV', currency: 'CHF', path: '/switzerland-income-tax-calculator/' },
  { country: 'Belgium', flag: '🇧🇪', authority: 'SPF / ONSS', currency: 'EUR (€)', path: '/belgium-income-tax-calculator/' },
  { country: 'Austria', flag: '🇦🇹', authority: 'BMF', currency: 'EUR (€)', path: '/austria-income-tax-calculator/' },
  { country: 'Sweden', flag: '🇸🇪', authority: 'Skatteverket', currency: 'SEK (kr)', path: '/sweden-income-tax-calculator/' },
  { country: 'Norway', flag: '🇳🇴', authority: 'Skatteetaten', currency: 'NOK (kr)', path: '/norway-income-tax-calculator/' },
  { country: 'Denmark', flag: '🇩🇰', authority: 'Skat', currency: 'DKK (kr)', path: '/denmark-income-tax-calculator/' },
  { country: 'Finland', flag: '🇫🇮', authority: 'Vero', currency: 'EUR (€)', path: '/finland-income-tax-calculator/' },
  { country: 'Poland', flag: '🇵🇱', authority: 'KAS', currency: 'PLN (zł)', path: '/poland-income-tax-calculator/' },
  { country: 'Singapore', flag: '🇸🇬', authority: 'IRAS', currency: 'SGD ($)', path: '/singapore-income-tax-calculator/' },
  { country: 'Japan', flag: '🇯🇵', authority: 'NTA', currency: 'JPY (¥)', path: '/japan-income-tax-calculator/' },
  { country: 'South Korea', flag: '🇰🇷', authority: 'NTS', currency: 'KRW (₩)', path: '/south-korea-income-tax-calculator/' },
  { country: 'New Zealand', flag: '🇳🇿', authority: 'IRD', currency: 'NZD ($)', path: '/new-zealand-income-tax-calculator/' },
  { country: 'Mexico', flag: '🇲🇽', authority: 'SAT', currency: 'MXN ($)', path: '/mexico-income-tax-calculator/' },
  { country: 'Portugal', flag: '🇵🇹', authority: 'AT', currency: 'EUR (€)', path: '/portugal-income-tax-calculator/' },
];

// 3. Academic & Student Suite (8 tools)
const academicUrls = [
  '/education-tools/assignment-cover-maker/',
  '/academic-tools/bunk-calculator/',
  '/academic-tools/final-grade-calculator/',
  '/academic-tools/attendance-calculator/',
  '/education-tools/study-schedule-generator/',
  '/academic-tools/semester-gpa-calculator/',
  '/education-tools/random-student-picker/',
  '/education-tools/exam-seating-generator/',
];
const academicTools = academicUrls
  .map((url) => allToolsIndex.find((t) => t.url === url))
  .filter((t): t is typeof allToolsIndex[0] => Boolean(t));

// 4. PDF, Image & Privacy Studio (8 tools)
const pdfMediaUrls = [
  '/pdf-tools/pdf-editor/',
  '/pdf-tools/pdf-merger/',
  '/pdf-tools/images-to-pdf/',
  '/pdf-tools/pdf-to-images/',
  '/image-tools/image-compressor/',
  '/image-tools/exif-remover/',
  '/pdf-tools/pdf-page-extractor/',
  '/color-tools/color-contrast-checker/',
];
const pdfMediaTools = pdfMediaUrls
  .map((url) => allToolsIndex.find((t) => t.url === url))
  .filter((t): t is typeof allToolsIndex[0] => Boolean(t));

// 5. Developer & Data Arsenal (8 tools)
const devDataUrls = [
  '/developer-tools/json-formatter/',
  '/developer-tools/regex-tester/',
  '/developer-tools/jwt-decoder/',
  '/data-tools/csv-to-json/',
  '/developer-tools/base64-encoder-decoder/',
  '/developer-tools/cron-expression-generator/',
  '/developer-tools/uuid-generator/',
  '/developer-tools/timestamp-converter/',
];
const devDataTools = devDataUrls
  .map((url) => allToolsIndex.find((t) => t.url === url))
  .filter((t): t is typeof allToolsIndex[0] => Boolean(t));

// Sets for high-intent badge chips (POPULAR / NEW)
const popularSet = new Set([
  'currency-converter',
  'mortgage-calculator',
  'compound-interest-calculator',
  'bmi-calculator',
  'gpa-calculator',
  'discount-calculator',
  'json-formatter',
  'percentage-calculator',
  'sales-tax-calculator',
  'pdf-to-image',
  'image-compressor',
  'cv-maker',
]);

const newToolSet = new Set([
  'assignment-cover-maker',
  'exam-seating-generator',
  'study-schedule-generator',
  'random-group-generator',
  'jwt-decoder',
  'regex-tester',
  'cron-expression-generator',
  'csv-to-json-converter',
  'color-contrast-checker',
]);

const homeTitle = "Free Calculator Online — Math, Finance & Online Tools | ToolsCastle";
const homeDescription = "Free calculator online suite featuring 186+ fast tools: finance calculator, math calculator, mortgage, tax, salary, GPA, and developer tools. 100% private in-browser computations.";
---

<SiteLayout title={homeTitle} description={homeDescription} canonical={withBasePath('/')}>
  <!-- Full-Width Top Animated Banner -->
  <HomeHeroBanner slot="top-banner" />

  <div class="sr-only">
    <h1>{siteName} - Free Calculator Online &amp; Smart Tools</h1>
    <p>{siteTagline}</p>
  </div>

  <!-- SECTION 1: Trending & Essential Calculators (Curated Horizontal Shelf) -->
  <section id="popular" class="mt-10 scroll-mt-24 space-y-3" data-carousel>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-orange-50 text-[color:var(--accent)] border border-orange-200" style="border-radius:0;">
            Flagship Hub
          </span>
          <span class="text-xs font-semibold text-[color:var(--muted)]">10 Top Tools</span>
        </div>
        <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">Trending &amp; Popular Calculators</h2>
        <p class="text-xs sm:text-sm text-[color:var(--muted)]">Our most frequently used financial, math, and everyday decision engines.</p>
      </div>

      <div class="flex items-center gap-2 shrink-0 self-end">
        <a href="#calculators" class="text-xs font-bold text-[color:var(--accent)] hover:underline mr-2 hidden sm:inline-flex items-center gap-1">
          <span>Explore All 186 Tools</span>
          <Icon name="arrow-right" class="w-3 h-3" />
        </a>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center border border-[color:var(--border)] bg-white text-[color:var(--fg)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="border-radius:0;"
            aria-label="Previous tools"
            data-carousel-prev
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center border border-[color:var(--border)] bg-white text-[color:var(--fg)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="border-radius:0;"
            aria-label="Next tools"
            data-carousel-next
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Horizontal Snap Track with Edge Gradient Indicators -->
    <div class="relative group/shelf">
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-white to-transparent opacity-0 transition-opacity duration-200" data-carousel-fade-left></div>
      
      <div
        class="flex gap-3.5 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 px-0.5 no-scrollbar touch-pan-x cursor-grab"
        data-carousel-track
      >
        {popularTools.map((tool) => {
          const slug = tool.url.replace(/^\/|\/$/g, '').split('/').pop() || '';
          return (
            <a
              href={withBasePath(tool.url)}
              class="group snap-start shrink-0 w-[270px] sm:w-[310px] md:w-[330px] flex flex-col justify-between border border-[color:var(--border)] bg-white p-5 transition hover:border-[color:var(--accent)] hover:shadow-xs"
              style="border-radius:0;"
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <ToolIcon url={tool.url} title={tool.title} category={tool.category} size="md" />
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex items-center bg-orange-50 px-2 py-0.5 text-[10px] font-bold text-[color:var(--accent)] border border-orange-200" style="border-radius:0;">
                      POPULAR
                    </span>
                    <span class="inline-flex bg-slate-50 px-2 py-0.5 text-[11px] font-semibold text-[color:var(--muted)] border border-[color:var(--border)]" style="border-radius:0;">
                      {tool.category}
                    </span>
                  </div>
                </div>
                <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                  {tool.title}
                </h3>
                <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
                  {tool.desc}
                </p>
              </div>

              <div class="mt-5 flex items-center justify-between pt-2.5 border-t border-[color:var(--border)]/70">
                <span class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                  <span>Open Tool</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
                </span>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--muted)]">Instant</span>
              </div>
            </a>
          );
        })}
      </div>

      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-l from-white to-transparent opacity-100 transition-opacity duration-200" data-carousel-fade-right></div>
    </div>

    <!-- Visual Scroll Progress Indicator -->
    <div class="w-full bg-slate-100 h-0.5 overflow-hidden relative">
      <div class="h-full bg-[color:var(--accent)] transition-all duration-150 origin-left" style="width: 25%;" data-carousel-progress-bar></div>
    </div>
  </section>

  <!-- SECTION 2: 24 Country Statutory Tax Suite (Curated Horizontal Shelf) -->
  <section id="tax-suite" class="mt-12 scroll-mt-24 space-y-3" data-carousel>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300" style="border-radius:0;">
            Statutory Suite
          </span>
          <span class="text-xs font-semibold text-[color:var(--muted)]">24 Verified Countries (2026/2027)</span>
        </div>
        <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">International Income Tax &amp; Salary Engines</h2>
        <p class="text-xs sm:text-sm text-[color:var(--muted)]">Official government tax brackets, social contributions, and take-home pay calculators.</p>
      </div>

      <div class="flex items-center gap-2 shrink-0 self-end">
        <a href="#calculators" class="text-xs font-bold text-[color:var(--accent)] hover:underline mr-2 hidden sm:inline-flex items-center gap-1" data-category-jump="Tax & Finance">
          <span>View Tax &amp; Finance Category</span>
          <Icon name="arrow-right" class="w-3 h-3" />
        </a>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center border border-[color:var(--border)] bg-white text-[color:var(--fg)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="border-radius:0;"
            aria-label="Previous tax engines"
            data-carousel-prev
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center border border-[color:var(--border)] bg-white text-[color:var(--fg)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="border-radius:0;"
            aria-label="Next tax engines"
            data-carousel-next
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Horizontal Snap Track for 24 Country Flags -->
    <div class="relative group/shelf">
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-white to-transparent opacity-0 transition-opacity duration-200" data-carousel-fade-left></div>

      <div
        class="flex gap-3 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 px-0.5 no-scrollbar touch-pan-x cursor-grab"
        data-carousel-track
      >
        {taxEngines.map((engine) => (
          <a
            href={withBasePath(engine.path)}
            class="group snap-start shrink-0 w-[185px] sm:w-[205px] flex flex-col items-center justify-between border border-[color:var(--border)] bg-white p-4 text-center transition hover:border-[color:var(--accent)] hover:bg-slate-50 hover:shadow-xs"
            style="border-radius:0;"
          >
            <div class="flex flex-col items-center space-y-2">
              <span class="text-3xl transition-transform duration-200 group-hover:scale-110 select-none">{engine.flag}</span>
              <div class="space-y-0.5">
                <h3 class="text-xs sm:text-sm font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                  {engine.country}
                </h3>
                <p class="text-[10px] sm:text-[11px] font-mono font-medium text-[color:var(--muted)]">
                  {engine.authority} • {engine.currency}
                </p>
              </div>
            </div>

            <div class="mt-3.5 w-full pt-2 border-t border-[color:var(--border)]/70 flex items-center justify-center gap-1 text-[11px] font-bold text-[color:var(--accent)]">
              <span>Calculate Tax</span>
              <Icon name="arrow-right" class="w-3 h-3 transition group-hover:translate-x-0.5" />
            </div>
          </a>
        ))}
      </div>

      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-l from-white to-transparent opacity-100 transition-opacity duration-200" data-carousel-fade-right></div>
    </div>

    <!-- Visual Scroll Progress Indicator -->
    <div class="w-full bg-slate-100 h-0.5 overflow-hidden relative">
      <div class="h-full bg-[color:var(--accent)] transition-all duration-150 origin-left" style="width: 15%;" data-carousel-progress-bar></div>
    </div>
  </section>

  <!-- SECTION 3: Academic & Student Hub (Curated Horizontal Shelf) -->
  <section class="mt-12 scroll-mt-24 space-y-3" data-carousel>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300" style="border-radius:0;">
            Campus &amp; Study
          </span>
          <span class="text-xs font-semibold text-[color:var(--muted)]">College &amp; University</span>
        </div>
        <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">Academic &amp; Student Utilities</h2>
        <p class="text-xs sm:text-sm text-[color:var(--muted)]">GPA calculators, attendance trackers, study planners, and assignment cover makers.</p>
      </div>

      <div class="flex items-center gap-2 shrink-0 self-end">
        <a href="#calculators" class="text-xs font-bold text-[color:var(--accent)] hover:underline mr-2 hidden sm:inline-flex items-center gap-1" data-category-jump="Academic">
          <span>View Academic Tools</span>
          <Icon name="arrow-right" class="w-3 h-3" />
        </a>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center border border-[color:var(--border)] bg-white text-[color:var(--fg)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="border-radius:0;"
            aria-label="Previous academic tools"
            data-carousel-prev
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center border border-[color:var(--border)] bg-white text-[color:var(--fg)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="border-radius:0;"
            aria-label="Next academic tools"
            data-carousel-next
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Horizontal Snap Track -->
    <div class="relative group/shelf">
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-white to-transparent opacity-0 transition-opacity duration-200" data-carousel-fade-left></div>

      <div
        class="flex gap-3.5 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 px-0.5 no-scrollbar touch-pan-x cursor-grab"
        data-carousel-track
      >
        {academicTools.map((tool) => (
          <a
            href={withBasePath(tool.url)}
            class="group snap-start shrink-0 w-[270px] sm:w-[310px] md:w-[330px] flex flex-col justify-between border border-[color:var(--border)] bg-white p-5 transition hover:border-[color:var(--accent)] hover:shadow-xs"
            style="border-radius:0;"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon url={tool.url} title={tool.title} category={tool.category} size="md" />
                <span class="inline-flex bg-slate-50 px-2 py-0.5 text-[11px] font-semibold text-[color:var(--muted)] border border-[color:var(--border)]" style="border-radius:0;">
                  {tool.category}
                </span>
              </div>
              <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
                {tool.desc}
              </p>
            </div>

            <div class="mt-5 flex items-center justify-between pt-2.5 border-t border-[color:var(--border)]/70">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                <span>Open Tool</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
              </span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--muted)]">Student</span>
            </div>
          </a>
