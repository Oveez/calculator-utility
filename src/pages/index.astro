        </div>
        <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-bold text-[color:var(--fg)]">Open Suite →</span>
      </a>

      <a href={withBasePath('/pdf-tools/')} class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]">
        <div class="space-y-2">
