          <h3 class="font-bold text-sm text-[color:var(--fg)]">Developer Utilities</h3>
          <p class="text-[11px] text-[color:var(--muted)] leading-relaxed">JSON formatter, JWT decoder, Regex tester, UUIDs &amp; Cron generator.</p>
        </div>
        <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-bold text-[color:var(--fg)]">Open Suite →</span>
      </a>

      <a href={withBasePath('/data-tools/')} class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]">
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-teal-500/10 border border-teal-500/20 text-teal-500 shadow-xs">
              <Icon name="converter" class="w-4 h-4" />
            </div>
            <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">6 Tools</span>
          </div>
          <h3 class="font-bold text-sm text-[color:var(--fg)]">Data &amp; CSV Utilities</h3>
          <p class="text-[11px] text-[color:var(--muted)] leading-relaxed">CSV to JSON, column extractor, deduplicator, sorter &amp; markdown tables.</p>
        </div>
        <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-bold text-[color:var(--fg)]">Open Suite →</span>
