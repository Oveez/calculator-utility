        <span class="text-2xl transition group-hover:scale-105">🇪🇸</span>
        <span class="mt-1.5 text-xs font-bold text-[color:var(--fg)]">Spain</span>
        <span class="text-[10px] font-mono text-[color:var(--muted)]">AEAT (EUR €)</span>
      </a>
      <a href="/italy-income-tax-calculator/" class="group flex flex-col items-center justify-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 text-center transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]">
        <span class="text-2xl transition group-hover:scale-105">🇮🇹</span>
        <span class="mt-1.5 text-xs font-bold text-[color:var(--fg)]">Italy</span>
        <span class="text-[10px] font-mono text-[color:var(--muted)]">IRPEF (EUR €)</span>
      </a>
      <a href="/netherlands-income-tax-calculator/" class="group flex flex-col items-center justify-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 text-center transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]">
        <span class="text-2xl transition group-hover:scale-105">🇳🇱</span>
        <span class="mt-1.5 text-xs font-bold text-[color:var(--fg)]">Netherlands</span>
        <span class="text-[10px] font-mono text-[color:var(--muted)]">Box 1 (EUR €)</span>
      </a>
      <a href="/switzerland-income-tax-calculator/" class="group flex flex-col items-center justify-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 text-center transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]">
        <span class="text-2xl transition group-hover:scale-105">🇨🇭</span>
        <span class="mt-1.5 text-xs font-bold text-[color:var(--fg)]">Switzerland</span>
        <span class="text-[10px] font-mono text-[color:var(--muted)]">ESTV (CHF)</span>
      </a>
      <a href="/singapore-income-tax-calculator/" class="group flex flex-col items-center justify-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 text-center transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]">
        <span class="text-2xl transition group-hover:scale-105">🇸🇬</span>
        <span class="mt-1.5 text-xs font-bold text-[color:var(--fg)]">Singapore</span>
        <span class="text-[10px] font-mono text-[color:var(--muted)]">IRAS (SGD $)</span>
      </a>
      <a href="/japan-income-tax-calculator/" class="group flex flex-col items-center justify-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 text-center transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]">
        <span class="text-2xl transition group-hover:scale-105">🇯🇵</span>
        <span class="mt-1.5 text-xs font-bold text-[color:var(--fg)]">Japan</span>
        <span class="text-[10px] font-mono text-[color:var(--muted)]">NTA (JPY ¥)</span>
      </a>
    </div>
  </section>

  <!-- Popular Calculators Section -->
  <section id="popular" class="mt-14 scroll-mt-24 space-y-5">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Top Picks</p>
        <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">Popular Calculators</h2>
      </div>
      <a href="#calculators" class="text-xs font-bold text-[color:var(--fg)] hover:underline">
        View All {calculators.length} Tools ↓
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {popularCalculators.map((calculator) => (
        <a
          class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
          href={getCalculatorPath(calculator.slug)}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <ToolIcon slug={calculator.slug} category={calculator.category} size="md" />
              <span class="inline-flex rounded-md bg-[color:var(--surface-strong)] px-2.5 py-0.5 text-[11px] font-semibold text-[color:var(--muted)] border border-[color:var(--border)]">
                {calculator.category}
              </span>
            </div>
            <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] transition-colors">
              {calculator.title}
            </h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
              {calculator.metaDescription}
            </p>
          </div>

          <div class="mt-5 flex items-center gap-1 text-xs font-bold text-[color:var(--fg)]">
            <span>Open Tool</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Full Library Directory & Filter Section -->
  <section id="calculators" class="mt-14 scroll-mt-24 space-y-6">
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div id="categories" class="scroll-mt-24">
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Browse By Category</p>
          <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">All Calculators Directory</h2>
        </div>
        <div class="flex items-center gap-2 text-xs text-[color:var(--muted)]">
          <span class="font-semibold text-[color:var(--fg)]" data-active-category-label>All Categories</span>
          <span>•</span>
          <span><strong class="text-[color:var(--fg)]" data-search-count>{allToolsIndex.length}</strong> of {allToolsIndex.length} tools</span>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Calculator Categories">
        {categoryTabs.map((category, index) => {
          const catConfig = getCategoryIconConfig(category.name);
          return (
            <button
              class:list={[
                'inline-flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]',
                index === 0
                  ? 'border-[color:var(--accent)] bg-[color:var(--accent)] text-[color:var(--accent-fg)] shadow-[0_0_14px_var(--accent-glow)]'
                  : 'border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]',
              ]}
              type="button"
              role="tab"
              data-category-tab
              data-category-name={category.name === 'All' ? '' : category.name}
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <svg class={`w-3.5 h-3.5 stroke-current shrink-0 ${index === 0 ? 'text-[color:var(--accent-fg)]' : catConfig.textColor}`} viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={catConfig.svgPath} />
              <span>{category.name}</span>
              <span class="rounded-md bg-black/10 dark:bg-[color:var(--surface)]/20 px-1.5 py-0.2 text-[10px] font-bold">{category.count}</span>
            </button>
          );
        })}
      </div>

      <!-- Active Filters Reset Bar (Hidden by default) -->
      <div class="flex items-center justify-between gap-3 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-2 text-xs text-[color:var(--muted)]" data-active-filter-bar hidden>
        <div class="flex items-center gap-2">
          <span>Active filter:</span>
          <span class="font-bold text-[color:var(--fg)]" data-filter-summary>None</span>
        </div>
        <button
          type="button"
          class="cursor-pointer font-bold text-[color:var(--fg)] hover:underline"
          data-reset-filters
        >
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Calculator Cards Grid (186 tools) -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-calculator-grid>
      {allToolsIndex.map((tool) => (
        <article
          class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
          data-calculator-card
          data-calculator-category={tool.category}
          data-search-text={`${tool.title} ${tool.category} ${tool.desc} ${tool.url}`.toLowerCase()}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <ToolIcon url={tool.url} title={tool.title} category={tool.category} size="md" />
              <span class="inline-flex rounded-md bg-[color:var(--surface-strong)] px-2.5 py-0.5 text-[11px] font-semibold text-[color:var(--muted)] border border-[color:var(--border)]">
                {tool.category}
              </span>
            </div>
            <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] transition-colors">
              {tool.title}
            </h3>
            <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
              {tool.desc}
            </p>
          </div>

          <a
            class="mt-5 inline-flex items-center justify-center rounded-xl bg-[color:var(--fg)] px-4 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
            href={withBasePath(tool.url)}
          >
            Launch Tool →
          </a>
        </article>
      ))}
    </div>

    <!-- Empty search result alert -->
    <div class="rounded-2xl border border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-8 text-center text-[color:var(--muted)]" data-search-empty hidden>
      <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)]">
        <Icon name="search" class="w-5 h-5 text-[color:var(--muted)]" />
      </div>
      <p class="mt-3 text-base font-bold text-[color:var(--fg)]">No calculators found</p>
      <p class="mt-1 text-xs">No tools match your current search or category filter.</p>
      <button
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-[color:var(--fg)] px-4 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
        data-reset-filters
      >
        Show All Calculators
      </button>
    </div>
  </section>

  <!-- Client-Side Search & Category Filter Logic -->
  <script is:inline>
    (function () {
      const searchInputs = Array.from(document.querySelectorAll('[data-calculator-search]'));
      const cards = Array.from(document.querySelectorAll('[data-calculator-card]'));
      const categoryTabs = Array.from(document.querySelectorAll('[data-category-tab]'));
      const heroCategoryButtons = Array.from(document.querySelectorAll('[data-hero-category]'));
      const resetButtons = Array.from(document.querySelectorAll('[data-reset-filters]'));
      const searchCount = document.querySelector('[data-search-count]');
      const activeCategoryLabel = document.querySelector('[data-active-category-label]');
      const activeFilterBar = document.querySelector('[data-active-filter-bar]');
      const filterSummary = document.querySelector('[data-filter-summary]');
      const emptyState = document.querySelector('[data-search-empty]');
      const grid = document.querySelector('[data-calculator-grid]');

      let activeCategory = '';
      let currentQuery = '';

      function getSearchQuery() {
        const input = searchInputs.find((i) => i && i.value);
        return (input ? input.value : currentQuery).trim().toLowerCase();
      }

      function updateResults() {
        const query = getSearchQuery();
        let visibleCount = 0;

        cards.forEach((card) => {
          const searchableText = (card.dataset.searchText || '').toLowerCase();
          const cardCategory = (card.dataset.calculatorCategory || '').trim();
          const matchesSearch = query.length === 0 || searchableText.includes(query);
          const matchesCategory = activeCategory.length === 0 || cardCategory.toLowerCase() === activeCategory.toLowerCase();
          const isVisible = matchesSearch && matchesCategory;

          if (isVisible) {
            card.removeAttribute('hidden');
            card.style.display = '';
            visibleCount += 1;
          } else {
            card.setAttribute('hidden', '');
            card.style.display = 'none';
          }
        });

        // Update indicators & counters
        if (searchCount) searchCount.textContent = String(visibleCount);
        if (activeCategoryLabel) activeCategoryLabel.textContent = activeCategory || 'All Categories';

        // Update active filter summary bar
        if (activeFilterBar && filterSummary) {
          const hasFilters = activeCategory.length > 0 || query.length > 0;
          if (hasFilters) {
            activeFilterBar.removeAttribute('hidden');
            activeFilterBar.style.display = 'flex';
            const parts = [];
            if (activeCategory) parts.push(`Category: "${activeCategory}"`);
            if (query) parts.push(`Search: "${query}"`);
            filterSummary.textContent = parts.join(' | ');
          } else {
            activeFilterBar.setAttribute('hidden', '');
            activeFilterBar.style.display = 'none';
          }
        }

        // Empty state alert
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.removeAttribute('hidden');
            emptyState.style.display = 'block';
          } else {
            emptyState.setAttribute('hidden', '');
            emptyState.style.display = 'none';
          }
        }
      }

      function setActiveCategory(catName, shouldScroll = false) {
        activeCategory = (catName || '').trim();

        categoryTabs.forEach((tab) => {
          const tabCat = (tab.dataset.categoryName || '').trim();
          const isSelected = (!activeCategory && !tabCat) || (activeCategory && tabCat.toLowerCase() === activeCategory.toLowerCase());

          tab.setAttribute('aria-pressed', String(isSelected));
          tab.setAttribute('aria-selected', String(isSelected));

          if (isSelected) {
            tab.className = 'inline-flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] border-[color:var(--accent)] bg-[color:var(--accent)] text-[color:var(--accent-fg)] shadow-[0_0_14px_var(--accent-glow)]';
          } else {
            tab.className = 'inline-flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]';
          }
        });

        if (grid) {
          grid.classList.remove('tab-content-enter');
          void grid.offsetWidth;
          grid.classList.add('tab-content-enter');
        }

        updateResults();

        if (shouldScroll) {
          const target = document.getElementById('calculators');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

      function resetAllFilters() {
        searchInputs.forEach((input) => {
          if (input) input.value = '';
        });
        currentQuery = '';
        setActiveCategory('');
      }

      function readUrlCategory() {
        try {
          const params = new URLSearchParams(window.location.search);
          let cat = params.get('category');
          if (!cat && window.location.hash) {
            const hash = window.location.hash;
            if (hash.includes('category=')) {
              const hashParams = new URLSearchParams(hash.split('?')[1] || hash.substring(1));
              cat = hashParams.get('category');
            }
          }
          if (cat) {
            setActiveCategory(decodeURIComponent(cat));
          }
        } catch (e) {}
      }

      categoryTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const cat = tab.dataset.categoryName || '';
          setActiveCategory(cat);
        });
      });

      heroCategoryButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.heroCategory || '';
          setActiveCategory(cat, true);
        });
      });

      searchInputs.forEach((input) => {
        input.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          searchInputs.forEach((other) => {
            if (other !== input) other.value = currentQuery;
          });
          updateResults();
        });
      });

      resetButtons.forEach((btn) => {
        btn.addEventListener('click', resetAllFilters);
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) {
          const mainSearch = searchInputs[0];
          if (mainSearch) {
            e.preventDefault();
            mainSearch.focus();
            mainSearch.select();
          }
        }
      });

      window.addEventListener('popstate', readUrlCategory);
      window.addEventListener('hashchange', readUrlCategory);

      readUrlCategory();
      updateResults();
    })();
  </script>
</SiteLayout>
