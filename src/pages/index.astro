  <!-- Popular Calculators Section -->
  <section id="popular" class="mt-14 scroll-mt-24 space-y-5">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Top Picks</p>
