    </div>
  </section>

  <!-- Full Library Directory & Filter Section -->
  <section id="calculators" class="mt-14 scroll-mt-24 space-y-6">
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div id="categories" class="scroll-mt-24">
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Browse By Category</p>
          <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">All Calculators Directory</h2>
        </div>
        <div class="flex items-center gap-2 text-xs text-[color:var(--muted)]">
          <span class="font-semibold text-[color:var(--fg)]" data-active-category-label>All Categories</span>
          <span>•</span>
          <span><strong class="text-[color:var(--fg)]" data-search-count>{allToolsIndex.length}</strong> of {allToolsIndex.length} tools</span>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Calculator Categories">
        {categoryTabs.map((category, index) => {
          const catConfig = getCategoryIconConfig(category.name);
          const activeTextColor = category.name === 'All' ? 'text-[color:var(--fg)]' : catConfig.textColor;
          const activeBgColor = category.name === 'All' ? 'bg-[color:var(--surface-strong)]' : catConfig.badgeBg;
          return (
            <button
              class:list={[
                'inline-flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-1.5 text-xs transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current',
                index === 0
                  ? 'active font-bold border-[color:var(--border-strong)] bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs'
                  : 'border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--fg)] font-semibold hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]',
              ]}
              type="button"
              role="tab"
              data-category-tab
              data-category-name={category.name === 'All' ? '' : category.name}
              data-color-class={activeTextColor}
              data-bg-class={activeBgColor}
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <svg class={`w-3.5 h-3.5 stroke-current shrink-0 ${catConfig.textColor}`} viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={catConfig.svgPath} />
              <span>{category.name}</span>
              <span class="rounded-md bg-black/5 dark:bg-white/10 px-1.5 py-0.5 text-[10px] font-bold">{category.count}</span>
            </button>
          );
        })}
      </div>

      <!-- Active Filters Reset Bar (Hidden by default) -->
      <div class="flex items-center justify-between gap-3 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-2 text-xs text-[color:var(--muted)]" data-active-filter-bar hidden>
        <div class="flex items-center gap-2">
          <span>Active filter:</span>
          <span class="font-bold text-[color:var(--fg)]" data-filter-summary>None</span>
        </div>
        <button
          type="button"
          class="cursor-pointer font-bold text-[color:var(--fg)] hover:underline"
