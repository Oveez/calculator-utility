          <a href={withBasePath('/image-tools/')} class="inline-flex items-center gap-1.5 cursor-pointer rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1.5 text-[color:var(--fg)] font-semibold shadow-xs transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]">
            <Icon name="image" class="w-3.5 h-3.5 text-[color:var(--accent)]" />
            <span>Image Tools (10)</span>
