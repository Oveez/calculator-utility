          <a href={withBasePath('/pdf-tools/')} class="inline-flex items-center gap-1.5 cursor-pointer rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1.5 text-[color:var(--fg)] font-semibold shadow-xs transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]">
