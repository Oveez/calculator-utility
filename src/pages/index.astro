---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { calculators } from '../data/calculators';
import { allToolsIndex } from '../data/allToolsIndex';
import { getCalculatorPath } from '../utils/calculators';
import { siteName, siteTagline, withBasePath } from '../utils/site';
import { getCategoryIconConfig } from '../utils/toolIcons';

// Logical category ordering for the 186 tools directory
const categoryOrder = [
  'Finance',
  'Tax & Finance',
  'Education',
  'Academic',
  'Health',
  'Math',
  'Converters',
  'Time',
  'Text',
  'Data',
  'Developer',
  'Image',
  'PDF',
  'Color',
  'Generators',
  'Research',
  'Business',
  'Career',
  'Pricing',
  'Shipping',
  'URL',
];

const uniqueCategories = Array.from(new Set(allToolsIndex.map((t) => t.category))).sort((a, b) => {
  const ia = categoryOrder.indexOf(a);
  const ib = categoryOrder.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b);
});

const categories = uniqueCategories.map((category) => ({
  name: category,
  count: allToolsIndex.filter((tool) => tool.category === category).length,
}));

// Highlight top high-demand calculators for the popular section
const popularSlugs = [
  'currency-converter',
  'mortgage-calculator',
  'compound-interest-calculator',
  'bmi-calculator',
  'gpa-calculator',
  'discount-calculator',
];
const popularCalculators = popularSlugs
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is typeof calculators[0] => Boolean(c));

const categoryTabs = [{ name: 'All', count: allToolsIndex.length }, ...categories];

const homeTitle = "Calculator Utility — Free Online Calculator & Smart Tools";
const homeDescription = "Free online calculator suite with 186+ fast tools and calculators for finance calculator, math calculator, BMI, tax, and developer conversions.";
---

<SiteLayout title={homeTitle} description={homeDescription} canonical={withBasePath('/')}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-10 lg:p-12">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-[color:var(--fg)] shadow-xs">
          <span>Fast • 100% Client-Side • Privacy-First</span>
        </div>

        <div class="space-y-4">
          <h1 class="text-3xl font-bold tracking-tight text-[color:var(--fg)] sm:text-4xl lg:text-5xl">
            Free online calculator &amp; smart utility tools.
          </h1>
          <p class="max-w-xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
            Over 186 precision tools and calculators across 16 specialized hubs for finance calculator, developer tools, tax engines, PDF utilities, image processors, and math calculator tasks. Instant browser computations with zero server latency.
          </p>
        </div>

        <!-- Hero Search Bar -->
        <form class="max-w-xl" role="search" aria-label="Search calculators" onsubmit="return false;">
          <label class="relative block cursor-pointer" data-trigger-search>
            <span class="sr-only">Search all tools and calculators</span>
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[color:var(--muted)]">
              <Icon name="search" class="w-4 h-4 text-[color:var(--accent)]" />
            </div>
            <input
              class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-3.5 pl-11 pr-24 text-sm sm:text-base text-[color:var(--fg)] outline-none transition placeholder:text-[color:var(--muted)] hover:border-[color:var(--border-strong)] focus:border-[color:var(--border-strong)] focus:ring-1 focus:ring-[color:var(--accent)] cursor-pointer"
              type="search"
              placeholder="Search 186+ tools (JSON, PDF, GPA, Tax, BMI)..."
              aria-label="Search calculators"
              data-calculator-search
              data-trigger-search
              readonly
            />
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 gap-1.5">
              <span class="hidden sm:inline text-[11px] font-semibold text-[color:var(--muted)]">Quick Search</span>
              <kbd class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2 py-0.5 text-xs font-mono text-[color:var(--muted)]">
                /
              </kbd>
            </div>
          </label>
        </form>

        <!-- Category Quick Pills -->
        <div class="flex flex-wrap gap-2 text-xs font-medium">
          <a href={withBasePath('/developer-tools/')} class="inline-flex items-center gap-1.5 cursor-pointer rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1.5 text-[color:var(--fg)] font-semibold shadow-xs transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)]">
            <Icon name="code" class="w-3.5 h-3.5 text-[color:var(--accent)]" />
