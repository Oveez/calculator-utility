  <!-- Client-Side Script: Tab Switching, Live Reactive Computations, and Carousels -->
  <script is:inline define:vars={{ baselineRates: baselineExchangeRates }}>
    (function () {
      // 1. PLAYGROUND TAB SWITCHING LOGIC
      const playground = document.querySelector('[data-playground]');
      if (playground) {
        const tabs = playground.querySelectorAll('.playground-tab');
        const panels = playground.querySelectorAll('.playground-panel');

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetTab = tab.dataset.tab;

            tabs.forEach((t) => {
              const isActive = t === tab;
              t.setAttribute('aria-selected', String(isActive));
              if (isActive) {
                t.className = 'playground-tab active inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold border transition cursor-pointer bg-slate-900 text-white border-slate-900 shadow-xs';
              } else {
                t.className = 'playground-tab inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold border transition cursor-pointer bg-white text-[color:var(--muted)] border-[color:var(--border)] hover:border-[color:var(--accent)] hover:text-[color:var(--fg)]';
              }
            });

            panels.forEach((p) => {
              if (p.dataset.panel === targetTab) {
                p.classList.remove('hidden');
              } else {
                p.classList.add('hidden');
              }
            });
          });
        });

        // LIVE CURRENCY CALCULATOR
        const curAmount = playground.querySelector('[data-currency-amount]');
        const curFrom = playground.querySelector('[data-currency-from]');
        const curTo = playground.querySelector('[data-currency-to]');
        const curResult = playground.querySelector('[data-currency-result]');
        const curSummary = playground.querySelector('[data-currency-input-summary]');
        const curRateInfo = playground.querySelector('[data-currency-rate-info]');

        function updateCurrency() {
          if (!curAmount || !curFrom || !curTo || !curResult) return;
          const amt = parseFloat(curAmount.value) || 0;
          const fromCode = curFrom.value;
          const toCode = curTo.value;

          const fromRate = baselineRates[fromCode] || 1.0;
          const toRate = baselineRates[toCode] || 1.0;

          // Conversion formula: (Amount / fromRate) * toRate
          const converted = (amt / fromRate) * toRate;
          const singleUnit = (1 / fromRate) * toRate;

          curResult.textContent = converted.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + toCode;
          if (curSummary) {
            curSummary.textContent = amt.toLocaleString() + ' ' + fromCode + ' equals';
          }
          if (curRateInfo) {
            curRateInfo.textContent = `1 ${fromCode} = ${singleUnit.toFixed(4)} ${toCode} • Mid-market exchange rate`;
          }
        }

        if (curAmount) curAmount.addEventListener('input', updateCurrency);
        if (curFrom) curFrom.addEventListener('change', updateCurrency);
        if (curTo) curTo.addEventListener('change', updateCurrency);
        updateCurrency();

        // LIVE MORTGAGE ESTIMATOR
        const loanPrincipal = playground.querySelector('[data-loan-principal]');
        const loanRate = playground.querySelector('[data-loan-rate]');
        const loanYears = playground.querySelector('[data-loan-years]');
        const loanMonthly = playground.querySelector('[data-loan-monthly]');
        const loanInterest = playground.querySelector('[data-loan-interest]');
        const loanTotal = playground.querySelector('[data-loan-total]');

        function updateMortgage() {
          if (!loanPrincipal || !loanRate || !loanYears || !loanMonthly) return;
          const P = parseFloat(loanPrincipal.value) || 0;
          const annualRate = parseFloat(loanRate.value) || 0;
          const years = parseFloat(loanYears.value) || 30;

          const n = years * 12;
          const r = annualRate / 100 / 12;

          let monthlyPayment = 0;
          if (r > 0 && n > 0 && P > 0) {
            monthlyPayment = P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
          } else if (n > 0 && P > 0) {
            monthlyPayment = P / n;
          }

          const totalPaid = monthlyPayment * n;
          const totalInterestPaid = Math.max(0, totalPaid - P);

          loanMonthly.textContent = '$' + monthlyPayment.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          if (loanInterest) loanInterest.textContent = '$' + totalInterestPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          if (loanTotal) loanTotal.textContent = '$' + totalPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        if (loanPrincipal) loanPrincipal.addEventListener('input', updateMortgage);
        if (loanRate) loanRate.addEventListener('input', updateMortgage);
        if (loanYears) loanYears.addEventListener('change', updateMortgage);
        updateMortgage();

        // LIVE TAX & TAKE-HOME ESTIMATOR
        const taxCountry = playground.querySelector('[data-tax-country]');
        const taxGross = playground.querySelector('[data-tax-gross]');
        const taxNet = playground.querySelector('[data-tax-net]');
        const taxMonthly = playground.querySelector('[data-tax-monthly]');
        const taxRate = playground.querySelector('[data-tax-rate]');
        const taxTotalDeduction = playground.querySelector('[data-tax-total-deduction]');
        const taxLink = playground.querySelector('[data-tax-link]');

        function updateTax() {
          if (!taxCountry || !taxGross || !taxNet) return;
          const country = taxCountry.value;
          const gross = parseFloat(taxGross.value) || 0;
          const selectedOption = taxCountry.options[taxCountry.selectedIndex];
          const currSymbol = selectedOption ? selectedOption.dataset.currency || '$' : '$';
          const linkPath = selectedOption ? selectedOption.dataset.path : '/us-income-tax-calculator/';

          let effectiveRate = 0.20;
          if (country === 'US') {
            effectiveRate = gross > 100000 ? 0.23 : (gross > 50000 ? 0.19 : 0.13);
          } else if (country === 'UK') {
            effectiveRate = gross > 80000 ? 0.32 : (gross > 40000 ? 0.22 : 0.14);
          } else if (country === 'CA') {
            effectiveRate = gross > 100000 ? 0.29 : (gross > 50000 ? 0.24 : 0.16);
          } else if (country === 'AU') {
            effectiveRate = gross > 120000 ? 0.29 : (gross > 60000 ? 0.22 : 0.15);
          } else if (country === 'DE') {
            effectiveRate = gross > 80000 ? 0.42 : (gross > 45000 ? 0.35 : 0.27);
          } else if (country === 'FR') {
            effectiveRate = gross > 70000 ? 0.34 : (gross > 40000 ? 0.25 : 0.18);
          }

          const deductions = gross * effectiveRate;
          const net = Math.max(0, gross - deductions);
          const monthly = net / 12;

          taxNet.textContent = currSymbol + Math.round(net).toLocaleString();
          if (taxMonthly) taxMonthly.textContent = `~${currSymbol}${Math.round(monthly).toLocaleString()} / month`;
          if (taxRate) taxRate.textContent = (effectiveRate * 100).toFixed(1) + '%';
          if (taxTotalDeduction) taxTotalDeduction.textContent = currSymbol + Math.round(deductions).toLocaleString();
          if (taxLink) taxLink.setAttribute('href', linkPath);
        }

        if (taxCountry) taxCountry.addEventListener('change', updateTax);
        if (taxGross) taxGross.addEventListener('input', updateTax);
        updateTax();
      }

      // 2. HORIZONTAL TAX SUITE CAROUSEL LOGIC
      const carousels = document.querySelectorAll('[data-carousel]');
      carousels.forEach((carousel) => {
        const track = carousel.querySelector('[data-carousel-track]');
        const prevBtn = carousel.querySelector('[data-carousel-prev]');
        const nextBtn = carousel.querySelector('[data-carousel-next]');
        const fadeLeft = carousel.querySelector('[data-carousel-fade-left]');
        const fadeRight = carousel.querySelector('[data-carousel-fade-right]');
        const progressBar = carousel.querySelector('[data-carousel-progress-bar]');

        if (!track) return;

        function updateControls() {
          const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
          const currentScroll = track.scrollLeft;

          if (prevBtn) prevBtn.disabled = currentScroll <= 4;
          if (nextBtn) nextBtn.disabled = currentScroll >= maxScroll - 4;
          if (fadeLeft) fadeLeft.style.opacity = currentScroll > 12 ? '1' : '0';
          if (fadeRight) fadeRight.style.opacity = currentScroll < maxScroll - 12 ? '1' : '0';
          if (progressBar && maxScroll > 0) {
            const thumbPercent = Math.min(100, Math.max(10, (track.clientWidth / track.scrollWidth) * 100));
            const progressRatio = currentScroll / maxScroll;
            progressBar.style.width = thumbPercent + '%';
            progressBar.style.transform = `translateX(${progressRatio * (100 / (thumbPercent / 100) - 100)}%)`;
          }
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            track.scrollBy({ left: -Math.max(260, track.clientWidth * 0.75), behavior: 'smooth' });
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            track.scrollBy({ left: Math.max(260, track.clientWidth * 0.75), behavior: 'smooth' });
          });
        }

        track.addEventListener('scroll', () => {
          requestAnimationFrame(updateControls);
        }, { passive: true });

        // Mouse Drag-to-Scroll support
        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;
        let hasDragged = false;

        track.addEventListener('mousedown', (e) => {
          isDown = true;
          hasDragged = false;
          track.classList.add('cursor-grabbing');
          track.classList.remove('cursor-grab');
          startX = e.pageX - track.offsetLeft;
          scrollLeft = track.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false;
          track.classList.remove('cursor-grabbing');
          track.classList.add('cursor-grab');
        });

        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - track.offsetLeft;
          const walk = (x - startX) * 1.3;
          if (Math.abs(walk) > 5) hasDragged = true;
          track.scrollLeft = scrollLeft - walk;
        });

        track.addEventListener('click', (e) => {
          if (hasDragged) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, true);

        updateControls();
        window.addEventListener('resize', updateControls);
      });
    })();
  </script>
