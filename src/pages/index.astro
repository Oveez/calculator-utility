---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHeroBanner from '../components/HomeHeroBanner.astro';
import KeypadCalculator from '../components/KeypadCalculator.astro';
import Icon from '../components/Icon.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { allToolsIndex } from '../data/allToolsIndex';
import { baselineExchangeRates, popularCurrencies, allCurrencies } from '../data/currency';
import { siteName, siteTagline, withBasePath } from '../utils/site';

// 24 Statutory Country Tax Engines
const taxEngines = [
  { country: 'United States', flag: '🇺🇸', authority: 'IRS', currency: 'USD ($)', path: '/us-income-tax-calculator/', code: 'US' },
  { country: 'United Kingdom', flag: '🇬🇧', authority: 'HMRC', currency: 'GBP (£)', path: '/uk-income-tax-calculator/', code: 'UK' },
  { country: 'Canada', flag: '🇨🇦', authority: 'CRA', currency: 'CAD ($)', path: '/canada-income-tax-calculator/', code: 'CA' },
  { country: 'Australia', flag: '🇦🇺', authority: 'ATO', currency: 'AUD ($)', path: '/australia-income-tax-calculator/', code: 'AU' },
  { country: 'Germany', flag: '🇩🇪', authority: 'BMF', currency: 'EUR (€)', path: '/germany-income-tax-calculator/', code: 'DE' },
  { country: 'France', flag: '🇫🇷', authority: 'DGFiP', currency: 'EUR (€)', path: '/france-income-tax-calculator/', code: 'FR' },
  { country: 'Ireland', flag: '🇮🇪', authority: 'Revenue', currency: 'EUR (€)', path: '/ireland-income-tax-calculator/', code: 'IE' },
  { country: 'Netherlands', flag: '🇳🇱', authority: 'Box 1', currency: 'EUR (€)', path: '/netherlands-income-tax-calculator/', code: 'NL' },
  { country: 'Spain', flag: '🇪🇸', authority: 'AEAT', currency: 'EUR (€)', path: '/spain-income-tax-calculator/', code: 'ES' },
  { country: 'Italy', flag: '🇮🇹', authority: 'IRPEF', currency: 'EUR (€)', path: '/italy-income-tax-calculator/', code: 'IT' },
  { country: 'Switzerland', flag: '🇨🇭', authority: 'ESTV', currency: 'CHF', path: '/switzerland-income-tax-calculator/', code: 'CH' },
  { country: 'Belgium', flag: '🇧🇪', authority: 'SPF / ONSS', currency: 'EUR (€)', path: '/belgium-income-tax-calculator/', code: 'BE' },
  { country: 'Austria', flag: '🇦🇹', authority: 'BMF', currency: 'EUR (€)', path: '/austria-income-tax-calculator/', code: 'AT' },
  { country: 'Sweden', flag: '🇸🇪', authority: 'Skatteverket', currency: 'SEK (kr)', path: '/sweden-income-tax-calculator/', code: 'SE' },
  { country: 'Norway', flag: '🇳🇴', authority: 'Skatteetaten', currency: 'NOK (kr)', path: '/norway-income-tax-calculator/', code: 'NO' },
  { country: 'Denmark', flag: '🇩🇰', authority: 'Skat', currency: 'DKK (kr)', path: '/denmark-income-tax-calculator/', code: 'DK' },
  { country: 'Finland', flag: '🇫🇮', authority: 'Vero', currency: 'EUR (€)', path: '/finland-income-tax-calculator/', code: 'FI' },
  { country: 'Poland', flag: '🇵🇱', authority: 'KAS', currency: 'PLN (zł)', path: '/poland-income-tax-calculator/', code: 'PL' },
  { country: 'Singapore', flag: '🇸🇬', authority: 'IRAS', currency: 'SGD ($)', path: '/singapore-income-tax-calculator/', code: 'SG' },
  { country: 'Japan', flag: '🇯🇵', authority: 'NTA', currency: 'JPY (¥)', path: '/japan-income-tax-calculator/', code: 'JP' },
  { country: 'South Korea', flag: '🇰🇷', authority: 'NTS', currency: 'KRW (₩)', path: '/south-korea-income-tax-calculator/', code: 'KR' },
  { country: 'New Zealand', flag: '🇳🇿', authority: 'IRD', currency: 'NZD ($)', path: '/new-zealand-income-tax-calculator/', code: 'NZ' },
  { country: 'Mexico', flag: '🇲🇽', authority: 'SAT', currency: 'MXN ($)', path: '/mexico-income-tax-calculator/', code: 'MX' },
  { country: 'Portugal', flag: '🇵🇹', authority: 'AT', currency: 'EUR (€)', path: '/portugal-income-tax-calculator/', code: 'PT' },
];

// Curated Top Tools for Quick Launcher
const quickLauncherTools = [
  { title: 'US Income Tax', url: '/us-income-tax-calculator/', badge: 'STATUTORY', icon: '🇺🇸' },
  { title: 'UK Salary Tax', url: '/uk-income-tax-calculator/', badge: 'HMRC', icon: '🇬🇧' },
  { title: 'Currency Converter', url: '/currency-converter/', badge: 'LIVE FX', icon: '💱' },
  { title: 'PDF Editor', url: '/pdf-tools/pdf-editor/', badge: 'PRIVATE', icon: '📄' },
  { title: 'Mortgage Calculator', url: '/calculators/mortgage-calculator/', badge: 'FINANCE', icon: '🏠' },
  { title: 'GPA Calculator', url: '/calculators/gpa-calculator/', badge: 'ACADEMIC', icon: '🎓' },
  { title: 'JSON Formatter', url: '/developer-tools/json-formatter/', badge: 'DEV', icon: '💻' },
  { title: 'Assignment Cover', url: '/education-tools/assignment-cover-maker/', badge: 'PDF EXPORT', icon: '🎨' },
];

// 4 Flagship Illustrated Guides to showcase on homepage
const featuredGuides = [
  {
    title: 'Progressive Tax Brackets Explained: Marginal vs. Effective Rates',
    slug: '/guides/progressive-tax-brackets-explained/',
    image: '/images/guides/progressive-tax-brackets-explained.jpg',
    readTime: '6 min read',
    category: 'Tax & Salary',
    summary: 'Understand the mathematical mechanics of progressive tax brackets, debunk the higher-bracket myth, and calculate your true effective rate.',
  },
  {
    title: 'Gross Pay vs. Net Pay: Where Does Your Paycheck Actually Go?',
    slug: '/guides/gross-pay-vs-net-pay/',
    image: '/images/guides/gross-pay-vs-net-pay.jpg',
    readTime: '5 min read',
    category: 'Payroll & Compensation',
    summary: 'A step-by-step statutory breakdown of federal withholdings, mandatory social insurance contributions, and pre-tax deductions.',
  },
  {
    title: 'The Mathematics of Mortgage Amortization & Early Payoff',
    slug: '/guides/how-mortgage-amortization-works/',
    image: '/images/guides/how-mortgage-amortization-works.jpg',
    readTime: '6 min read',
    category: 'Real Estate & Loans',
    summary: 'Derive monthly payment formulas, understand compound interest front-loading, and calculate the exact return on extra principal payments.',
  },
  {
    title: 'GPA vs. CGPA & Credit Hour Weighting: The Complete University Guide',
    slug: '/guides/gpa-vs-cgpa-credit-hours/',
    image: '/images/guides/gpa-vs-cgpa-credit-hours.jpg',
    readTime: '5 min read',
    category: 'Academic Strategy',
    summary: 'Detailed explanation of weighted grade point averages, semester credit allocations, and calculating exam scores needed for graduation honors.',
  },
];

const homeTitle = "ToolsCastle — Precision Online Calculators, Tax Engines & In-Browser Tools";
const homeDescription = "Modern in-browser calculation suite featuring 24 statutory national tax engines, live currency conversions, mortgage estimators, PDF editor, and developer tools. 100% private client-side execution.";
---

<SiteLayout title={homeTitle} description={homeDescription} canonical={withBasePath('/')}>
  <!-- Full-Width Hero Banner with Animated Dotted Castle Logo -->
  <HomeHeroBanner slot="top-banner" />

  <div class="sr-only">
    <h1>{siteName} - Precision Online Calculators &amp; Smart Tools</h1>
    <p>{siteTagline}</p>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-16 py-8">

    <!-- =========================================================================
         SECTION 1: QUICK OMNISEARCH LAUNCHER & HIGH-INTENT ACTION CHIPS
         ========================================================================= -->
    <section id="calculators" class="space-y-4 scroll-mt-24">
      <div class="border border-[color:var(--border)] bg-slate-50/70 p-4 sm:p-6 shadow-xs" style="border-radius:0;">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--accent)] font-mono">Quick Launcher</span>
            <h2 class="text-base sm:text-lg font-bold tracking-tight text-[color:var(--fg)]">
              Instant Access to 186+ Precision Calculators &amp; Utilities
            </h2>
          </div>

          <div class="flex items-center gap-2">
            <a
              href={withBasePath('/all-tools/')}
              class="inline-flex items-center gap-1.5 border border-[color:var(--border)] bg-white px-3.5 py-2 text-xs font-bold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition shadow-xs"
              style="border-radius:0;"
            >
              <span>Browse Full 186-Tool Catalog</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Quick Launch Pills -->
        <div class="mt-4 flex flex-wrap items-center gap-2 pt-3 border-t border-slate-200/80">
          <span class="text-xs font-semibold text-[color:var(--muted)] mr-1 hidden sm:inline">Popular shortcuts:</span>
          {quickLauncherTools.map((t) => (
            <a
              href={withBasePath(t.url)}
              class="group inline-flex items-center gap-1.5 border border-[color:var(--border)] bg-white px-2.5 py-1.5 text-xs font-medium text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition shadow-2xs"
              style="border-radius:0;"
            >
              <span class="text-sm select-none">{t.icon}</span>
              <span class="font-bold">{t.title}</span>
              <span class="text-[9px] font-mono text-[color:var(--muted)] group-hover:text-[color:var(--accent)] transition-colors">{t.badge}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 2: THE INTERACTIVE LIVE PLAYGROUND DOCK (COMPUTE ON HOMEPAGE)
         ========================================================================= -->
    <section id="interactive-dock" class="scroll-mt-24 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-orange-50 text-[color:var(--accent)] border border-orange-200" style="border-radius:0;">
              Live Computation Dock
            </span>
            <span class="text-xs font-semibold text-[color:var(--muted)]">Compute Instantly Without Navigating</span>
          </div>
          <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">
            Interactive In-Browser Playground
          </h2>
          <p class="text-xs sm:text-sm text-[color:var(--muted)]">
            Run real-time currency conversions, mortgage amortizations, tax estimates, or arithmetic directly inside your browser.
          </p>
        </div>
      </div>

      <!-- Tabbed Card Shell -->
      <div class="border border-[color:var(--border)] bg-white shadow-xs" style="border-radius:0;" data-playground>
        <!-- Tab Bar -->
        <div class="flex flex-wrap items-center border-b border-[color:var(--border)] bg-slate-50/60 p-1 sm:p-2 gap-1" role="tablist">
          <button
            type="button"
            class="playground-tab active inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold border transition cursor-pointer bg-slate-900 text-white border-slate-900 shadow-xs"
            style="border-radius:0;"
            role="tab"
            data-tab="currency"
            aria-selected="true"
          >
            <span>💱</span>
            <span>Currency Converter</span>
          </button>

          <button
            type="button"
            class="playground-tab inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold border transition cursor-pointer bg-white text-[color:var(--muted)] border-[color:var(--border)] hover:border-[color:var(--accent)] hover:text-[color:var(--fg)]"
            style="border-radius:0;"
            role="tab"
            data-tab="keypad"
            aria-selected="false"
          >
            <span>🔢</span>
            <span>Keypad Calculator</span>
          </button>

          <button
            type="button"
            class="playground-tab inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold border transition cursor-pointer bg-white text-[color:var(--muted)] border-[color:var(--border)] hover:border-[color:var(--accent)] hover:text-[color:var(--fg)]"
            style="border-radius:0;"
            role="tab"
            data-tab="mortgage"
            aria-selected="false"
          >
            <span>🏠</span>
            <span>Mortgage &amp; Loan</span>
          </button>

          <button
            type="button"
            class="playground-tab inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold border transition cursor-pointer bg-white text-[color:var(--muted)] border-[color:var(--border)] hover:border-[color:var(--accent)] hover:text-[color:var(--fg)]"
            style="border-radius:0;"
            role="tab"
            data-tab="tax"
            aria-selected="false"
          >
            <span>⚖️</span>
            <span>Take-Home Pay</span>
          </button>
        </div>

        <!-- Panel 1: Live Currency Converter -->
        <div class="playground-panel p-5 sm:p-6 space-y-6" data-panel="currency">
          <div class="grid gap-4 sm:grid-cols-3 items-end">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">Amount</label>
              <input
                type="number"
                value="1000"
                min="0.01"
                step="any"
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)]"
                style="border-radius:0;"
                data-currency-amount
              />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">From Currency</label>
              <select
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)] cursor-pointer"
                style="border-radius:0;"
                data-currency-from
              >
                {popularCurrencies.map((code) => {
                  const curr = allCurrencies[code] || { code, name: code, flag: '' };
                  return (
                    <option value={code} selected={code === 'USD'}>
                      {curr.flag} {code} — {curr.name}
                    </option>
                  );
                })}
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">To Currency</label>
              <select
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)] cursor-pointer"
                style="border-radius:0;"
                data-currency-to
              >
                {popularCurrencies.map((code) => {
                  const curr = allCurrencies[code] || { code, name: code, flag: '' };
                  return (
                    <option value={code} selected={code === 'EUR'}>
                      {curr.flag} {code} — {curr.name}
                    </option>
                  );
                })}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-[color:var(--border)] bg-slate-50 p-4" style="border-radius:0;">
            <div>
              <p class="text-xs text-[color:var(--muted)]" data-currency-input-summary>1,000 USD equals</p>
              <div class="mt-0.5 text-2xl sm:text-3xl font-extrabold text-[color:var(--fg)]" data-currency-result>
                920.00 EUR
              </div>
              <p class="mt-1 text-xs text-[color:var(--muted)] font-mono" data-currency-rate-info>
                1 USD = 0.9200 EUR • Mid-market exchange rate
              </p>
            </div>

            <div class="flex items-center gap-3">
              <a
                href={withBasePath('/currency-converter/')}
                class="inline-flex items-center gap-1.5 bg-[color:var(--accent)] px-4 py-2 text-xs font-bold text-white hover:bg-[color:var(--accent-hover)] transition cursor-pointer shadow-xs whitespace-nowrap"
                style="border-radius:0;"
              >
                <span>Full Currency Studio</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>

        <!-- Panel 2: Standard Keypad Calculator -->
        <div class="playground-panel p-5 sm:p-6 hidden" data-panel="keypad">
          <div class="max-w-md mx-auto">
            <KeypadCalculator />
          </div>
        </div>

        <!-- Panel 3: Quick Loan & Mortgage Estimator -->
        <div class="playground-panel p-5 sm:p-6 space-y-6 hidden" data-panel="mortgage">
          <div class="grid gap-4 sm:grid-cols-3">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">Loan Amount ($)</label>
              <input
                type="number"
                value="400000"
                step="5000"
                min="1000"
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)]"
                style="border-radius:0;"
                data-loan-principal
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">Interest Rate (% p.a.)</label>
              <input
                type="number"
                value="6.5"
                step="0.05"
                min="0.1"
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)]"
                style="border-radius:0;"
                data-loan-rate
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">Loan Term (Years)</label>
              <select
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)] cursor-pointer"
                style="border-radius:0;"
                data-loan-years
              >
                <option value="15">15 Years (180 months)</option>
                <option value="20">20 Years (240 months)</option>
                <option value="25">25 Years (300 months)</option>
                <option value="30" selected>30 Years (360 months)</option>
              </select>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-3 border border-[color:var(--border)] bg-slate-50 p-4" style="border-radius:0;">
            <div>
              <span class="text-xs text-[color:var(--muted)]">Monthly Principal &amp; Interest</span>
              <div class="mt-0.5 text-xl sm:text-2xl font-extrabold text-[color:var(--accent)]" data-loan-monthly>$2,528.27</div>
              <span class="text-[10px] text-slate-500 font-mono">30-year fixed rate</span>
            </div>
            <div>
              <span class="text-xs text-[color:var(--muted)]">Total Interest Payable</span>
              <div class="mt-0.5 text-lg sm:text-xl font-bold text-[color:var(--fg)]" data-loan-interest>$510,177.20</div>
              <span class="text-[10px] text-slate-500 font-mono">Over loan life</span>
            </div>
            <div class="flex flex-col justify-between">
              <div>
                <span class="text-xs text-[color:var(--muted)]">Total Repayment Amount</span>
                <div class="mt-0.5 text-lg sm:text-xl font-bold text-[color:var(--fg)]" data-loan-total>$910,177.20</div>
              </div>
              <a
                href={withBasePath('/calculators/mortgage-calculator/')}
                class="mt-2 inline-flex items-center gap-1 text-xs font-bold text-[color:var(--accent)] hover:underline"
              >
                <span>Full Amortization Schedule</span>
                <Icon name="arrow-right" class="w-3 h-3" />
              </a>
            </div>
          </div>
        </div>

        <!-- Panel 4: Quick Take-Home Salary Estimator -->
        <div class="playground-panel p-5 sm:p-6 space-y-6 hidden" data-panel="tax">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">Country Tax Jurisdiction</label>
              <select
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)] cursor-pointer"
                style="border-radius:0;"
                data-tax-country
              >
                <option value="US" data-path="/us-income-tax-calculator/" data-currency="$">🇺🇸 United States (IRS Federal + FICA)</option>
                <option value="UK" data-path="/uk-income-tax-calculator/" data-currency="£">🇬🇧 United Kingdom (HMRC PAYE + NI)</option>
                <option value="CA" data-path="/canada-income-tax-calculator/" data-currency="$">🇨🇦 Canada (CRA Federal + Provincial + CPP/EI)</option>
                <option value="AU" data-path="/australia-income-tax-calculator/" data-currency="$">🇦🇺 Australia (ATO Stage 3 + Medicare)</option>
                <option value="DE" data-path="/germany-income-tax-calculator/" data-currency="€">🇩🇪 Germany (BMF EStG + Social Contributions)</option>
                <option value="FR" data-path="/france-income-tax-calculator/" data-currency="€">🇫🇷 France (DGFiP + CSG/CRDS)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] mb-1">Annual Gross Salary</label>
              <input
                type="number"
                value="85000"
                step="1000"
                min="5000"
                class="w-full border border-[color:var(--border)] bg-white px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] focus:outline-none focus:border-[color:var(--accent)]"
                style="border-radius:0;"
                data-tax-gross
              />
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-3 border border-[color:var(--border)] bg-slate-50 p-4" style="border-radius:0;">
            <div>
              <span class="text-xs text-[color:var(--muted)]">Estimated Annual Take-Home</span>
              <div class="mt-0.5 text-xl sm:text-2xl font-extrabold text-[color:var(--accent)]" data-tax-net>$68,540</div>
              <span class="text-[10px] text-slate-500 font-mono" data-tax-monthly>~$5,711 / month</span>
            </div>
            <div>
              <span class="text-xs text-[color:var(--muted)]">Effective Tax &amp; Contribution Rate</span>
              <div class="mt-0.5 text-lg sm:text-xl font-bold text-[color:var(--fg)]" data-tax-rate>19.4%</div>
              <span class="text-[10px] text-slate-500 font-mono">Combined statutory burden</span>
            </div>
            <div class="flex flex-col justify-between">
              <div>
                <span class="text-xs text-[color:var(--muted)]">Total Tax &amp; Levies</span>
                <div class="mt-0.5 text-lg sm:text-xl font-bold text-[color:var(--fg)]" data-tax-total-deduction>$16,460</div>
              </div>
              <a
                href={withBasePath('/us-income-tax-calculator/')}
                class="mt-2 inline-flex items-center gap-1 text-xs font-bold text-[color:var(--accent)] hover:underline"
                data-tax-link
              >
                <span>Full Statutory Breakdown</span>
                <Icon name="arrow-right" class="w-3 h-3" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 3: THE 4 CORE SUPERPOWER SUITES (FLAGSHIP ARCHITECTURE SHOWCASES)
         ========================================================================= -->

    <!-- SUITE 1: 24-Country Statutory Income Tax Suite -->
