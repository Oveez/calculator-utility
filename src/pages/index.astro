      </div>

      <!-- Hero Stats Card -->
      <aside class="grid gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-6">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Library Overview</p>
