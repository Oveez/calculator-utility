---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `PDF to Image Converter — Render PDF Pages to JPG/PNG Online · ${siteName}`;
const pageDesc = 'Convert PDF document pages into high-resolution JPG or PNG images online. 100% private in-browser rendering with zero server uploads.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-to-images/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF to Images' },
];

const schemaFaq = [
  {
    question: 'How are PDF pages rendered into images in the browser?',
    answer: 'It utilizes Mozilla’s PDF.js client-side engine to parse PDF vector drawing instructions and rasterize each page canvas directly onto an HTML5 Canvas surface at custom DPI resolutions, exporting pristine PNG, JPEG, or WebP files without uploading any data.',
  },
  {
    question: 'Can I select specific pages or a page range to convert?',
    answer: 'Yes! You can choose to convert all pages, the first page thumbnail only, or specify custom ranges and commas (e.g. "1-3, 5, 8") to render only the exact sheets you need.',
  },
  {
    question: 'What resolution / DPI options are available?',
    answer: 'You can choose between Standard (72 DPI, 1.0x scale for web thumbnails), High Resolution (150 DPI, 2.0x scale for sharp reading), and Ultra HD (300 DPI, 3.0x scale for professional printing and archival clarity).',
  },
  {
    question: 'Are my confidential documents uploaded to any third-party server?',
    answer: 'No. The entire PDF.js decoding pipeline and HTML5 Canvas rasterization run 100% locally inside your browser memory. Your files never leave your device.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF to Image Converter',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    name: 'DPI Resolution Scale',
    type: 'Standard 72 DPI (1.0x) | High 150 DPI (2.0x) | Ultra HD 300 DPI (3.0x)',
    description: 'Multiplies canvas raster resolution. Higher DPI yields crisp typography and fine detail at the cost of larger image dimensions and longer processing time.',
  },
  {
    name: 'Image Format',
    type: 'PNG (.png) | JPEG (.jpg) | WebP (.webp)',
    description: 'PNG preserves lossless crisp lines and text clarity; JPEG is ideal for scanned photographs and smaller file sizes; WebP offers modern compression efficiency.',
  },
  {
    name: 'Page Scope',
    type: 'All Pages | First Page Only | Custom Range (e.g. 1-4, 7)',
    description: 'Restricts rendering to specific page subsets, saving memory and processing overhead on large multi-hundred-page documents.',
  },
];

const workedExampleData = {
  title: 'Rendering PDF Pages to 150 DPI PNG Images',
  description: 'Step-by-step client-side rasterization of vector PDF pages using Mozilla PDF.js.',
  formula: 'Raster Scale = Target DPI / 72 → Canvas Dimensions = (PDF Width × Scale, PDF Height × Scale)',
  steps: [
    {
      step: 'Vector Page Tree Parsing',
      calculation: 'Loaded PDF document via PDF.js worker. Document contains 8 pages of vector diagrams and text.',
      result: 'Page viewports initialized in browser memory.',
    },
    {
      step: 'DPI Resolution Scaling',
      calculation: 'Selected 150 DPI (Scale = 150 / 72 ≈ 2.083x). A4 page (595 × 842 pt) scales to 1240 × 1754 px canvas.',
      result: 'Crisp typography and diagram rendering without raster blurriness.',
    },
    {
      step: 'Canvas Rasterization & Blob Export',
      calculation: 'Rendered vector stream onto HTML5 Canvas and exported as lossless image/png blobs.',
      result: 'High-definition PNG images ready for individual or batch ZIP download.',
    },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pdf-img-app>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Mozilla PDF.js Rasterizer • Up to 300 DPI • Zero Cloud Uploads</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF to Image Converter
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert PDF document pages into crisp, high-resolution JPG, PNG, or WebP images online. Preview rendered sheets, adjust DPI up to 300 DPI, and download individual pages or batch collections.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-10 text-center transition hover:border-[color:var(--accent)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-3 block">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs">
            <Icon name="document" class="w-7 h-7 text-[color:var(--accent)]" />
          </div>
          <div>
            <p class="text-base font-bold text-[color:var(--fg)]">Choose a PDF or drag &amp; drop here</p>
            <p class="text-xs text-[color:var(--muted)] mt-1">Converts pages to JPG/PNG/WebP locally (100% private in browser)</p>
          </div>
          <span class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs">
            Select PDF File
          </span>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB • 0 pages</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Settings & Actions Card -->
      <div id="render-card" class="hidden space-y-6 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <!-- Settings Grid -->
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-4 text-xs">
          <div>
            <label for="out-img-fmt" class="font-bold text-[color:var(--fg)] block mb-1.5">Output Format</label>
            <select id="out-img-fmt" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="image/png">PNG (.png) [Lossless / Crisp]</option>
              <option value="image/jpeg">JPEG (.jpg) [Lightweight]</option>
              <option value="image/webp">WebP (.webp) [Modern Web]</option>
            </select>
          </div>

          <div>
            <label for="render-dpi" class="font-bold text-[color:var(--fg)] block mb-1.5">Resolution / DPI Scale</label>
            <select id="render-dpi" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="1.5">High (110 DPI - 1.5× scale)</option>
              <option value="2.0" selected>Very High (150 DPI - 2.0× scale)</option>
              <option value="3.0">Ultra HD (300 DPI - 3.0× scale)</option>
              <option value="1.0">Standard (72 DPI - 1.0× scale)</option>
            </select>
          </div>

          <div>
            <label for="page-scope" class="font-bold text-[color:var(--fg)] block mb-1.5">Pages to Render</label>
            <select id="page-scope" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="all">All Pages in Document</option>
              <option value="first">First Page Only (Thumbnail)</option>
              <option value="custom">Custom Range (e.g. 1-3, 5)</option>
            </select>
          </div>

          <div id="custom-range-box" class="hidden">
            <label for="custom-range-in" class="font-bold text-[color:var(--fg)] block mb-1.5">Custom Range</label>
            <input
              type="text"
              id="custom-range-in"
              placeholder="e.g. 1-3, 5"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
            />
          </div>
        </div>

        <!-- Render Button & Status -->
        <div class="space-y-2 pt-2 border-t border-[color:var(--border)]">
          <button
            type="button"
            id="render-btn"
            class="w-full rounded-xl bg-[color:var(--fg)] py-3 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
          >
            <span>⚡ Render PDF Pages to Images</span>
          </button>
          <div id="render-progress-bar" class="hidden h-1.5 w-full overflow-hidden rounded-full bg-[color:var(--surface-strong)]">
            <div id="render-progress-fill" class="h-full bg-[color:var(--accent)] transition-all duration-200" style="width: 0%;"></div>
          </div>
          <p id="render-status" class="text-center text-xs text-[color:var(--muted)]"></p>
        </div>

        <!-- Rendered Results Gallery -->
        <div id="results-section" class="hidden space-y-4 pt-4 border-t border-[color:var(--border)]">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Rendered Page Images:</span>
              <span id="rendered-count-badge" class="ml-2 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">0 pages</span>
            </div>
            <button
              type="button"
              id="btn-download-all"
              class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-2 text-xs font-bold text-[color:var(--fg)] hover:border-[color:var(--accent)] transition cursor-pointer"
            >
              📥 Download All Images
            </button>
          </div>

          <div id="gallery-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4"></div>
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="PDF Page Rasterization & Resolution Guide"
      description="Learn about Mozilla PDF.js vector rendering engines, canvas DPI scaling calculations, pixel geometries, and image export formats."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <!-- Mozilla PDF.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" is:inline></script>
  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-img-app]');
      if (!root) return;

      if (window.pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      const fileIn = root.querySelector('#pdf-file');
      const dropzone = root.querySelector('#dropzone-box');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const card = root.querySelector('#render-card');

      const outFmtSelect = root.querySelector('#out-img-fmt');
      const renderDpiSelect = root.querySelector('#render-dpi');
      const pageScopeSelect = root.querySelector('#page-scope');
      const customRangeBox = root.querySelector('#custom-range-box');
      const customRangeIn = root.querySelector('#custom-range-in');

      const renderBtn = root.querySelector('#render-btn');
      const renderStatus = root.querySelector('#render-status');
      const renderProgressBar = root.querySelector('#render-progress-bar');
      const renderProgressFill = root.querySelector('#render-progress-fill');

      const resultsSection = root.querySelector('#results-section');
      const galleryGrid = root.querySelector('#gallery-grid');
      const renderedCountBadge = root.querySelector('#rendered-count-badge');
      const btnDownloadAll = root.querySelector('#btn-download-all');

      let currentFile = null;
      let currentPdfDoc = null;
      let renderedBlobs = []; // Array of { pageNum, blob, dataUrl, filename }

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      pageScopeSelect.addEventListener('change', () => {
        if (pageScopeSelect.value === 'custom') {
          customRangeBox.classList.remove('hidden');
        } else {
          customRangeBox.classList.add('hidden');
        }
      });

      async function loadPdf(file) {
        if (!window.pdfjsLib) {
          alert('PDF.js library is loading, please wait a second and retry.');
          return;
        }

        currentFile = file;
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • Reading structure...`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');
        card.classList.remove('hidden');
        resultsSection.classList.add('hidden');
        galleryGrid.innerHTML = '';
        renderedBlobs = [];

        try {
          const arrayBuffer = await file.arrayBuffer();
          currentPdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          thumbInfo.textContent = `${formatBytes(file.size)} • ${currentPdfDoc.numPages} pages detected`;
          customRangeIn.placeholder = `1-${currentPdfDoc.numPages}`;
        } catch (err) {
          console.error('Error loading PDF:', err);
          thumbInfo.textContent = `${formatBytes(file.size)} • Failed to read document`;
          alert('Could not parse PDF file. Ensure the document is not password protected.');
        }
      }

      // Drag and drop
      ['dragenter', 'dragover'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-[color:var(--accent)]');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-[color:var(--accent)]');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (file && (file.type === 'application/pdf' || file.name.endsWith('.pdf'))) {
          loadPdf(file);
        }
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) loadPdf(file);
        fileIn.value = '';
      });

      // Parse custom page ranges (e.g. "1-3, 5, 8")
      function parsePageRanges(str, totalPages) {
        if (!str || !str.trim()) {
          return Array.from({ length: totalPages }, (_, i) => i + 1);
        }

        const pages = new Set();
        const parts = str.split(',');

        for (const part of parts) {
          const trimmed = part.trim();
          if (trimmed.includes('-')) {
            const [startStr, endStr] = trimmed.split('-');
            const s = parseInt(startStr, 10);
            const e = parseInt(endStr, 10);
            if (!isNaN(s) && !isNaN(e)) {
              for (let p = Math.min(s, e); p <= Math.max(s, e); p++) {
                if (p >= 1 && p <= totalPages) pages.add(p);
              }
            }
          } else {
            const p = parseInt(trimmed, 10);
            if (!isNaN(p) && p >= 1 && p <= totalPages) {
              pages.add(p);
            }
          }
        }

        return Array.from(pages).sort((a, b) => a - b);
      }

      // Render button
      renderBtn.addEventListener('click', async () => {
        if (!currentPdfDoc) {
          alert('Please select a valid PDF file first.');
          return;
        }

        const totalPages = currentPdfDoc.numPages;
        let targetPages = [];

        const scope = pageScopeSelect.value;
        if (scope === 'all') {
          targetPages = Array.from({ length: totalPages }, (_, i) => i + 1);
        } else if (scope === 'first') {
          targetPages = [1];
        } else if (scope === 'custom') {
          targetPages = parsePageRanges(customRangeIn.value, totalPages);
          if (targetPages.length === 0) {
            alert('Invalid custom page range. Please enter valid page numbers.');
            return;
          }
        }

        const mimeType = outFmtSelect.value;
        const ext = mimeType === 'image/png' ? 'png' : (mimeType === 'image/webp' ? 'webp' : 'jpg');
        const scale = parseFloat(renderDpiSelect.value) || 1.5;
        const baseName = currentFile.name.substring(0, currentFile.name.lastIndexOf('.')) || 'document';

        renderBtn.disabled = true;
        renderBtn.classList.add('opacity-70');
        renderProgressBar.classList.remove('hidden');
        renderProgressFill.style.width = '0%';
        galleryGrid.innerHTML = '';
        renderedBlobs = [];

        try {
          for (let i = 0; i < targetPages.length; i++) {
            const pageNum = targetPages[i];
            const pct = Math.round(((i) / targetPages.length) * 100);
            renderProgressFill.style.width = `${pct}%`;
            renderStatus.textContent = `Rasterizing page ${pageNum} (${i + 1} of ${targetPages.length})...`;

            const page = await currentPdfDoc.getPage(pageNum);
            const viewport = page.getViewport({ scale: scale });

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');

            await page.render({
              canvasContext: ctx,
              viewport: viewport,
            }).promise;

            // Convert canvas to blob
            const blob = await new Promise(resolve => canvas.toBlob(resolve, mimeType, 0.92));
            const dataUrl = URL.createObjectURL(blob);
            const filename = `${baseName}_page_${pageNum}.${ext}`;

            renderedBlobs.push({ pageNum, blob, dataUrl, filename, width: canvas.width, height: canvas.height });

            // Create gallery item
            const cardEl = document.createElement('div');
            cardEl.className = 'flex flex-col rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-2.5 shadow-xs';
            cardEl.innerHTML = `
              <div class="relative flex h-36 w-full items-center justify-center overflow-hidden rounded-xl bg-[color:var(--surface-strong)]">
                <img src="${dataUrl}" alt="Page ${pageNum}" class="max-h-full max-w-full object-contain shadow-xs" />
                <span class="absolute top-1.5 left-1.5 rounded-md bg-black/60 px-1.5 py-0.5 text-[10px] font-bold text-white backdrop-blur-xs">
                  Page ${pageNum}
                </span>
              </div>
              <div class="mt-2 min-w-0 space-y-0.5">
                <p class="truncate text-[11px] font-bold text-[color:var(--fg)]">${filename}</p>
                <p class="text-[10px] text-[color:var(--muted)]">${canvas.width}×${canvas.height} • ${formatBytes(blob.size)}</p>
              </div>
              <div class="mt-2 pt-2 border-t border-[color:var(--border)]">
                <a href="${dataUrl}" download="${filename}" class="w-full inline-flex items-center justify-center gap-1 rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] py-1 text-xs font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] transition">
                  📥 Download
                </a>
              </div>
            `;
            galleryGrid.appendChild(cardEl);
          }

          renderProgressFill.style.width = '100%';
          renderStatus.textContent = `✓ Successfully converted ${targetPages.length} pages to high-res images!`;
          resultsSection.classList.remove('hidden');
          renderedCountBadge.textContent = `${targetPages.length} pages`;
        } catch (err) {
          console.error('Rendering error:', err);
          renderStatus.textContent = `Error during rasterization: ${err.message || err}`;
        } finally {
          renderBtn.disabled = false;
          renderBtn.classList.remove('opacity-70');
        }
      });

      // Download all images sequentially
      btnDownloadAll.addEventListener('click', () => {
        if (renderedBlobs.length === 0) return;
        renderedBlobs.forEach((item, index) => {
          setTimeout(() => {
            const a = document.createElement('a');
            a.href = item.dataUrl;
            a.download = item.filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }, index * 250);
        });
      });
    })();
  </script>
</SiteLayout>
