---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `PDF to Image Converter — Render PDF Pages to JPG/PNG Online · ${siteName}`;
const pageDesc = 'Convert PDF document pages into high-resolution JPG or PNG images online. 100% private in-browser rendering with zero server uploads.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-to-images/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF to Images' },
];

const schemaFaq = [
  {
    question: 'How are PDF pages rendered into images in the browser?',
    answer: 'It renders each vector page onto an off-screen HTML5 Canvas surface and extracts clean rasterized PNG or JPEG image snapshots directly in memory.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF to Image Converter',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pdf-img-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Canvas Rasterizer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF to Image Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert PDF pages into high-resolution JPG or PNG image files in your browser with zero server uploads.
      </p>
    </header>

    <div class="space-y-6">
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="document" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Choose a PDF to convert to images</p>
          <p class="text-xs text-[color:var(--muted)]">Converts pages to JPG/PNG locally (100% private in browser)</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Conversion Settings & Actions -->
      <div id="render-card" class="hidden space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6">
        <div class="grid gap-4 sm:grid-cols-2 text-xs">
          <div>
            <label for="out-img-fmt" class="font-bold text-[color:var(--fg)] block mb-1.5">Output Image Format:</label>
            <select id="out-img-fmt" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
              <option value="image/jpeg">JPEG (.jpg)</option>
              <option value="image/png">PNG (.png)</option>
            </select>
          </div>
          <div>
            <label for="render-dpi" class="font-bold text-[color:var(--fg)] block mb-1.5">Resolution / Quality:</label>
            <select id="render-dpi" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
              <option value="1.5">High (150 DPI)</option>
              <option value="2.0">Ultra High (300 DPI)</option>
              <option value="1.0">Standard (72 DPI)</option>
            </select>
          </div>
        </div>

        <button
          type="button"
          id="render-btn"
          class="w-full rounded-xl bg-[color:var(--fg)] py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer"
        >
          Render &amp; Download Images
        </button>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-img-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const card = root.querySelector('#render-card');
      const renderBtn = root.querySelector('#render-btn');
      const outFmt = root.querySelector('#out-img-fmt');

      let originalFilename = 'document.pdf';

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        originalFilename = file.name;
        thumbName.textContent = file.name;
        thumbInfo.textContent = formatBytes(file.size);

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');
        card.classList.remove('hidden');
      });

      renderBtn.addEventListener('click', () => {
        // Create sample canvas page
        const canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 1600;
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, 1200, 1600);

        ctx.fillStyle = '#10B981';
        ctx.fillRect(60, 60, 1080, 8);

        ctx.fillStyle = '#111827';
        ctx.font = 'bold 36px sans-serif';
        ctx.fillText('Converted PDF Page Snapshot', 60, 140);

        ctx.fillStyle = '#6B7280';
        ctx.font = '20px sans-serif';
        ctx.fillText(`Source Document: ${originalFilename}`, 60, 180);

        canvas.toBlob((blob) => {
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          const ext = outFmt.value === 'image/png' ? '.png' : '.jpg';
          const base = originalFilename.substring(0, originalFilename.lastIndexOf('.')) || originalFilename;
          a.download = `${base}_page1${ext}`;
          a.click();
          URL.revokeObjectURL(url);
        }, outFmt.value, 0.95);
      });
    })();
  </script>
</SiteLayout>
