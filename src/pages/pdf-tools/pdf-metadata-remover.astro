---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `PDF Metadata Remover — Strip Author & Creator Info Online · ${siteName}`;
const pageDesc = 'Remove sensitive metadata, author names, creation software footprints, and timestamps from PDF documents online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-metadata-remover/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF Metadata Remover' },
];

const schemaFaq = [
  {
    question: 'How does in-browser PDF metadata sanitization work?',
    answer: 'It parses the PDF binary byte stream, nullifies and strips `/Author`, `/Title`, `/Creator`, and `/Producer` metadata objects inside the document dictionary, and exports a sanitized binary file.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Metadata Remover',
    url: canonicalUrl,
    applicationCategory: 'PrivacyApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pdf-clean-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Binary PDF Sanitizer</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF Metadata &amp; Author Remover
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Strip author names, software footprints, and creation history from PDF documents before distributing files.
      </p>
    </header>

    <div class="space-y-6">
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="document" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Choose a PDF document to sanitize</p>
          <p class="text-xs text-[color:var(--muted)]">Strips author, title &amp; producer tags (100% private in browser)</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Action Card -->
      <div id="clean-card" class="hidden space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold text-[color:var(--fg)]">Metadata Successfully Cleaned</span>
          </div>
          <button
            type="button"
            id="dl-clean-btn"
            class="rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer"
          >
            Download Cleaned PDF
          </button>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 text-xs text-[color:var(--muted)] rounded-xl bg-[color:var(--surface-strong)] p-4">
          <div>
            <p>Original File: <strong id="orig-name" class="text-[color:var(--fg)]">-</strong></p>
            <p>Original Size: <strong id="orig-size" class="text-[color:var(--fg)]">-</strong></p>
          </div>
          <div>
            <p>Author &amp; Title Tags: <strong class="text-emerald-500 font-bold">Sanitized</strong></p>
            <p>Producer Footprints: <strong class="text-emerald-500 font-bold">Stripped</strong></p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-clean-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const cleanCard = root.querySelector('#clean-card');
      const dlBtn = root.querySelector('#dl-clean-btn');
      const origName = root.querySelector('#orig-name');
      const origSize = root.querySelector('#orig-size');

      let cleanBlobUrl = null;
      let origFileName = 'document.pdf';

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      fileIn.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        origFileName = file.name;
        origName.textContent = file.name;
        origSize.textContent = formatBytes(file.size);

        thumbName.textContent = file.name;
        thumbInfo.textContent = formatBytes(file.size);

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        const buffer = await file.arrayBuffer();
        let text = new TextDecoder('latin1').decode(buffer);

        // Sanitize standard metadata string tags by blanking them
        text = text
          .replace(/\/Title\s*\([^)]*\)/g, '/Title ()')
          .replace(/\/Author\s*\([^)]*\)/g, '/Author ()')
          .replace(/\/Subject\s*\([^)]*\)/g, '/Subject ()')
          .replace(/\/Keywords\s*\([^)]*\)/g, '/Keywords ()')
          .replace(/\/Creator\s*\([^)]*\)/g, '/Creator ()')
          .replace(/\/Producer\s*\([^)]*\)/g, '/Producer ()')
          .replace(/\/CreationDate\s*\([^)]*\)/g, '/CreationDate ()')
          .replace(/\/ModDate\s*\([^)]*\)/g, '/ModDate ()');

        const uint8Array = new Uint8Array(text.length);
        for (let i = 0; i < text.length; i++) {
          uint8Array[i] = text.charCodeAt(i) & 0xff;
        }

        const blob = new Blob([uint8Array], { type: 'application/pdf' });
        if (cleanBlobUrl) URL.revokeObjectURL(cleanBlobUrl);
        cleanBlobUrl = URL.createObjectURL(blob);

        cleanCard.classList.remove('hidden');
      });

      dlBtn.addEventListener('click', () => {
        if (!cleanBlobUrl) return;
        const a = document.createElement('a');
        a.href = cleanBlobUrl;
        const base = origFileName.substring(0, origFileName.lastIndexOf('.')) || origFileName;
        a.download = `${base}_sanitized.pdf`;
        a.click();
      });
    })();
  </script>
</SiteLayout>
