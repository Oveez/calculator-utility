---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `PDF Splitter — Split Multi-Page PDF into Files Online · ${siteName}`;
const pageDesc = 'Split multi-page PDF documents into individual single-page files or custom page ranges online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-splitter/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF Splitter' },
];

const schemaFaq = [
  {
    question: 'Can I split large PDF files without uploading them to a cloud server?',
    answer: 'Yes. All parsing, page tree extraction, and PDF binary partitioning execute directly in your browser’s local memory using client-side JavaScript, ensuring 100% data confidentiality.',
  },
  {
    question: 'What splitting modes are supported?',
    answer: 'You can split by custom ranges (e.g. 1-3, 5-8), extract all pages into individual single-page PDFs, split by fixed chunk intervals (e.g. every 2 pages), separate into Even vs. Odd page collections, or bisect in half.',
  },
  {
    question: 'Can I preview the split parts before downloading?',
    answer: 'Yes! The live Partition Preview table visualizes every generated document segment, page counts, and page indices before any file generation begins.',
  },
  {
    question: 'Are my confidential documents uploaded anywhere?',
    answer: 'No. All PDF binary manipulations run strictly in your web browser memory. No files, metadata, or document data are ever transmitted to any server.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Splitter',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    name: 'Partition Strategy',
    type: 'Custom Ranges | Fixed N Pages | Single Pages | Even / Odd | Bisect Half',
    description: 'Controls how the master PDF page catalog is partitioned into target documents. Custom Ranges allows selective extraction of specific sheets.',
  },
  {
    name: 'Custom Range Syntax',
    type: 'Comma-separated ranges (e.g. 1-3, 5, 8-12)',
    description: 'Specifies inclusive page bounds. 1-based page indexing is used so "1-3" extracts pages 1, 2, and 3.',
  },
  {
    name: 'Fixed Chunk Interval',
    type: 'Integer (1 to Total Pages)',
    description: 'Divides the document into uniform blocks of N pages each. Useful for batch printing or chunked review workflows.',
  },
];

const workedExampleData = {
  title: 'Splitting a 10-Page Document into 3-Page Chunks',
  description: 'Step-by-step chunked partitioning of a master PDF document into discrete sub-documents.',
  formula: 'Input Pages [1..N] → Partition Function(Strategy) → Sub-Documents [PDF₁, PDF₂, ... PDFₖ]',
  steps: [
    {
      step: 'Document Catalog Inspection',
      calculation: 'Master PDF contains 10 total pages. Selected Fixed Chunk Interval = 3 pages.',
      result: 'Calculated 4 partition segments: [1-3], [4-6], [7-9], [10].',
    },
    {
      step: 'Page Extraction & Tree Replication',
      calculation: 'Cloned page dictionaries for each segment into isolated PDFDocument instances.',
      result: 'All internal fonts, annotations, and vector streams preserved for each slice.',
    },
    {
      step: 'Binary Packaging & Preview Generation',
      calculation: 'Generated 4 distinct PDF blobs with customized filenames (document-part-1.pdf to part-4.pdf).',
      result: 'Interactive download table populated with file sizes and page ranges.',
    },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pdf-split-app>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local PDF Partition Engine • Range Validator • Even/Odd Split</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF Splitter
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Separate multi-page PDF documents into individual files, custom page ranges, or fixed chunks in your browser with zero remote server data uploads.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Upload Dropzone -->
      <div id="dropzone-container" class="relative overflow-hidden rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-10 text-center transition hover:border-[color:var(--accent)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />

        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-3 block">
          <div id="upload-icon-box" class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs">
            <Icon name="document" class="w-7 h-7 text-[color:var(--accent)]" />
          </div>
          <div>
            <p class="text-base font-bold text-[color:var(--fg)]">Choose a PDF or drag &amp; drop to split</p>
            <p class="text-xs text-[color:var(--muted)] mt-1">100% Private In-Browser Processing • Supports Multi-Page Documents</p>
          </div>
          <span class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs">
            Select PDF File
          </span>
        </label>

        <!-- Visual Upload Preview Window -->
        <div id="file-preview-card" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 text-left">
          <div class="flex items-center gap-3.5 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="doc-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p class="text-[11px] text-[color:var(--muted)]"><span id="doc-size">-</span> • <strong id="total-pgs" class="text-[color:var(--accent)]">0</strong> pages detected</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Splitting Configuration Card -->
      <div id="split-card" class="hidden space-y-6 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 text-xs">
          <div>
            <label for="split-mode" class="font-bold text-[color:var(--fg)] block mb-1.5">Partition Strategy</label>
            <select id="split-mode" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="custom">Custom Page Ranges (e.g. 1-3, 5, 7-10)</option>
              <option value="fixed">Fixed Chunk Intervals (Every N Pages)</option>
              <option value="single">Single Pages (Export Each Page Separately)</option>
              <option value="even-odd">Even vs. Odd Pages (Two Documents)</option>
              <option value="half">Bisect in Half (Part 1 &amp; Part 2)</option>
            </select>
          </div>

          <!-- Custom Page Range Input -->
          <div id="custom-range-container">
            <label for="page-ranges-input" class="font-bold text-[color:var(--fg)] block mb-1.5">Page Range Specification</label>
            <input
              type="text"
              id="page-ranges-input"
              placeholder="e.g. 1-3, 5, 7-10"
              value="1-2"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-mono font-semibold"
            />
          </div>

          <!-- Fixed Chunk Size Input -->
          <div id="fixed-chunk-container" class="hidden">
            <label for="chunk-size-input" class="font-bold text-[color:var(--fg)] block mb-1.5">Pages Per File</label>
            <input
              type="number"
              id="chunk-size-input"
              min="1"
              value="2"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-mono font-semibold"
            />
          </div>

          <div>
            <label for="filename-pattern" class="font-bold text-[color:var(--fg)] block mb-1.5">File Naming Suffix</label>
            <select id="filename-pattern" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="part">_part_1.pdf, _part_2.pdf</option>
              <option value="pages">_pages_1-3.pdf, _pages_4-6.pdf</option>
            </select>
          </div>
        </div>

        <!-- Partition Preview Audit Table -->
        <div class="space-y-2 pt-2 border-t border-[color:var(--border)]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Calculated Output Files:</span>
            <span id="partition-count-badge" class="rounded-full bg-[color:var(--surface-strong)] px-2.5 py-0.5 font-mono text-[11px] font-bold text-[color:var(--accent)]">
              0 parts
            </span>
          </div>

          <div class="overflow-x-auto rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)]">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-[color:var(--border)] bg-[color:var(--surface)] text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">
                <tr>
                  <th class="p-3 w-12 text-center">#</th>
                  <th class="p-3">Generated Filename</th>
                  <th class="p-3">Included Pages</th>
                  <th class="p-3 w-28 text-center">Page Count</th>
                </tr>
              </thead>
              <tbody id="partition-tbody" class="divide-y divide-[color:var(--border)]"></tbody>
            </table>
          </div>
        </div>

        <!-- Action Button & Status -->
        <div class="space-y-2 pt-2 border-t border-[color:var(--border)]">
          <button
            type="button"
            id="split-btn"
            class="w-full rounded-xl bg-[color:var(--fg)] py-3 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
          >
            <span>⚡ Split &amp; Download PDF Files</span>
          </button>
          <div id="split-status-alert" class="hidden text-center text-xs text-emerald-600 dark:text-emerald-400 font-semibold"></div>
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="PDF Splitting Geometry & Partition Architecture"
      description="Understand in-memory vector page extraction, dictionary references, subset catalog creation, and range syntax rules."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <!-- PDF-LIB Script for Client-Side Vector PDF Manipulation -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-split-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const dropzone = root.querySelector('#dropzone-container');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const previewCard = root.querySelector('#file-preview-card');
      const card = root.querySelector('#split-card');
      const docName = root.querySelector('#doc-name');
      const docSize = root.querySelector('#doc-size');
      const totalPgs = root.querySelector('#total-pgs');

      const splitMode = root.querySelector('#split-mode');
      const customRangeContainer = root.querySelector('#custom-range-container');
      const pageRangesInput = root.querySelector('#page-ranges-input');
      const fixedChunkContainer = root.querySelector('#fixed-chunk-container');
      const chunkSizeInput = root.querySelector('#chunk-size-input');
      const filenamePatternSelect = root.querySelector('#filename-pattern');

      const partitionTbody = root.querySelector('#partition-tbody');
      const partitionCountBadge = root.querySelector('#partition-count-badge');
      const splitBtn = root.querySelector('#split-btn');
      const statusAlert = root.querySelector('#split-status-alert');

      let currentArrayBuffer = null;
      let originalFilename = 'document.pdf';
      let pageCount = 0;
      let calculatedChunks = []; // Array of { label, pages: [0, 1...], filename }

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function parsePageRanges(inputStr, maxPages) {
        const ranges = [];
        const parts = inputStr.split(',').map(s => s.trim()).filter(Boolean);

        for (const part of parts) {
          if (part.includes('-')) {
            const [startStr, endStr] = part.split('-');
            const start = parseInt(startStr, 10);
            const end = parseInt(endStr, 10);
            if (!isNaN(start) && !isNaN(end) && start >= 1 && end >= start) {
              const clampedEnd = Math.min(end, maxPages);
              const group = [];
              for (let p = start; p <= clampedEnd; p++) {
                group.push(p - 1); // 0-indexed
              }
              if (group.length > 0) ranges.push({ label: `${start}–${clampedEnd}`, pages: group });
            }
          } else {
            const p = parseInt(part, 10);
            if (!isNaN(p) && p >= 1 && p <= maxPages) {
              ranges.push({ label: `${p}`, pages: [p - 1] });
            }
          }
        }
        return ranges;
      }

      function updateCalculatedChunks() {
        if (!pageCount) return;

        const base = originalFilename.substring(0, originalFilename.lastIndexOf('.')) || 'document';
        const mode = splitMode.value;
        const pattern = filenamePatternSelect.value;
        let chunks = [];

        if (mode === 'custom') {
          chunks = parsePageRanges(pageRangesInput.value, pageCount);
        } else if (mode === 'fixed') {
          const chunkSize = Math.max(1, parseInt(chunkSizeInput.value, 10) || 1);
          for (let i = 0; i < pageCount; i += chunkSize) {
            const group = [];
            const end = Math.min(i + chunkSize, pageCount);
            for (let j = i; j < end; j++) group.push(j);
            chunks.push({ label: `${i + 1}–${end}`, pages: group });
          }
        } else if (mode === 'single') {
          for (let i = 0; i < pageCount; i++) {
            chunks.push({ label: `${i + 1}`, pages: [i] });
          }
        } else if (mode === 'even-odd') {
          const oddPages = [];
          const evenPages = [];
          for (let i = 0; i < pageCount; i++) {
            if ((i + 1) % 2 !== 0) oddPages.push(i);
            else evenPages.push(i);
          }
          if (oddPages.length > 0) chunks.push({ label: 'Odd Pages (1, 3, 5...)', pages: oddPages });
          if (evenPages.length > 0) chunks.push({ label: 'Even Pages (2, 4, 6...)', pages: evenPages });
        } else if (mode === 'half') {
          const mid = Math.ceil(pageCount / 2);
          const p1 = [];
          for (let i = 0; i < mid; i++) p1.push(i);
          const p2 = [];
          for (let i = mid; i < pageCount; i++) p2.push(i);
          chunks.push({ label: `1–${mid}`, pages: p1 });
          if (p2.length > 0) chunks.push({ label: `${mid + 1}–${pageCount}`, pages: p2 });
        }

        // Attach filenames
        calculatedChunks = chunks.map((c, idx) => {
          let suffix = '';
          if (pattern === 'pages') {
            suffix = `_pages_${c.label.replace(/[^0-9–-]/g, '')}`;
          } else {
            suffix = `_part_${idx + 1}`;
          }
          return {
            ...c,
            filename: `${base}${suffix}.pdf`,
          };
        });

        // Render preview table
        partitionCountBadge.textContent = `${calculatedChunks.length} parts`;
        let html = '';
        calculatedChunks.forEach((c, idx) => {
          html += `
            <tr class="hover:bg-[color:var(--surface)]">
              <td class="p-3 text-center font-bold text-[color:var(--muted)]">${idx + 1}</td>
              <td class="p-3 font-semibold text-[color:var(--fg)] truncate max-w-xs font-mono text-[11px]">${c.filename}</td>
              <td class="p-3 font-mono text-[color:var(--muted)]">Page(s) ${c.label}</td>
              <td class="p-3 text-center">
                <span class="rounded-full bg-[color:var(--surface-strong)] px-2.5 py-0.5 font-mono text-[11px] font-bold text-[color:var(--accent)]">
                  ${c.pages.length} pgs
                </span>
              </td>
            </tr>
          `;
        });
        partitionTbody.innerHTML = html;
      }

      async function handleFile(file) {
        originalFilename = file.name;
        docName.textContent = file.name;
        docSize.textContent = formatBytes(file.size);

        currentArrayBuffer = await file.arrayBuffer();

        try {
          if (window.PDFLib) {
            const pdfDoc = await PDFLib.PDFDocument.load(currentArrayBuffer, { ignoreEncryption: true });
            pageCount = pdfDoc.getPageCount();
          } else {
            pageCount = 1;
          }
        } catch (err) {
          pageCount = 1;
        }

        totalPgs.textContent = String(pageCount);
        pageRangesInput.value = pageCount > 2 ? `1-${Math.ceil(pageCount / 2)}, ${Math.ceil(pageCount / 2) + 1}-${pageCount}` : `1-${pageCount}`;
        chunkSizeInput.max = String(pageCount);

        uploadPrompt.classList.add('hidden');
        previewCard.classList.remove('hidden');
        card.classList.remove('hidden');

        updateCalculatedChunks();
      }

      // Drag and drop
      ['dragenter', 'dragover'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-[color:var(--accent)]');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-[color:var(--accent)]');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (file && (file.type === 'application/pdf' || file.name.endsWith('.pdf'))) {
          handleFile(file);
        }
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
        fileIn.value = '';
      });

      splitMode.addEventListener('change', () => {
        const val = splitMode.value;
        customRangeContainer.classList.toggle('hidden', val !== 'custom');
        fixedChunkContainer.classList.toggle('hidden', val !== 'fixed');
        updateCalculatedChunks();
      });

      pageRangesInput.addEventListener('input', updateCalculatedChunks);
      chunkSizeInput.addEventListener('input', updateCalculatedChunks);
      filenamePatternSelect.addEventListener('change', updateCalculatedChunks);

      // Perform Split
      splitBtn.addEventListener('click', async () => {
        if (!currentArrayBuffer || calculatedChunks.length === 0) return;
        if (!window.PDFLib) {
          alert('PDF-Lib engine is still loading. Please wait a moment and try again.');
          return;
        }

        splitBtn.disabled = true;
        splitBtn.classList.add('opacity-70');
        statusAlert.classList.add('hidden');

        try {
          const srcDoc = await PDFLib.PDFDocument.load(currentArrayBuffer, { ignoreEncryption: true });

          for (let idx = 0; idx < calculatedChunks.length; idx++) {
            const chunk = calculatedChunks[idx];
            splitBtn.textContent = `Generating file ${idx + 1} of ${calculatedChunks.length}...`;

            const newDoc = await PDFLib.PDFDocument.create();
            const copiedPages = await newDoc.copyPages(srcDoc, chunk.pages);
            copiedPages.forEach(p => newDoc.addPage(p));
            const pdfBytes = await newDoc.save();

            const blob = new Blob([pdfBytes], { type: 'application/pdf' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = chunk.filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          }

          statusAlert.textContent = `✓ Successfully generated and downloaded ${calculatedChunks.length} PDF file(s)!`;
          statusAlert.classList.remove('hidden');
        } catch (err) {
          console.error('Split error:', err);
          alert('Could not split PDF: ' + (err.message || 'Unknown error'));
        } finally {
          splitBtn.disabled = false;
          splitBtn.classList.remove('opacity-70');
          splitBtn.textContent = '⚡ Split & Download PDF Files';
        }
      });
    })();
  </script>
</SiteLayout>
