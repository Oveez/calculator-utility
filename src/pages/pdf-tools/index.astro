---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHero from '../../components/SiteHero.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Free PDF Tools Online — Online PDF Tools & PDF Maker Suite · ${siteName}`;
const pageDesc = 'Free PDF tools online. Merge PDF to PDF, convert images to PDF, split PDF documents, render PDF to images, rotate pages, and view metadata with 100% private in-browser processing.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools' },
];

const pdfToolsList = [
  {
    slug: 'pdf-page-counter',
    title: 'PDF Page Counter',
    badge: 'Popular',
    metaDescription: 'Count total pages across single or batch PDF documents and audit page tallies instantly in your browser.',
    href: withBasePath('/pdf-tools/pdf-page-counter/'),
    icon: 'document',
  },
  {
    slug: 'pdf-metadata-viewer',
    title: 'PDF Metadata Viewer',
    badge: 'Inspection',
    metaDescription: 'View PDF details, Title, Author, Subject, Keywords, Creator tool, PDF version, and creation date.',
    href: withBasePath('/pdf-tools/pdf-metadata-viewer/'),
    icon: 'document',
  },
  {
    slug: 'pdf-metadata-remover',
    title: 'PDF Metadata Remover',
    badge: 'Privacy',
    metaDescription: 'Strip sensitive author names, software footprints, and revision timestamps from PDF documents privately.',
    href: withBasePath('/pdf-tools/pdf-metadata-remover/'),
    icon: 'document',
  },
  {
    slug: 'pdf-page-extractor',
    title: 'PDF Page Extractor',
    badge: 'Editing',
    metaDescription: 'Extract specific pages or custom ranges into a single PDF document or individual files.',
    href: withBasePath('/pdf-tools/pdf-page-extractor/'),
    icon: 'document',
  },
  {
    slug: 'pdf-page-reorderer',
    title: 'PDF Page Reorderer',
    badge: 'Editing',
    metaDescription: 'Rearrange, organize, reverse, and rotate pages in your PDF document with visual tile controls.',
    href: withBasePath('/pdf-tools/pdf-page-reorderer/'),
    icon: 'document',
  },
  {
    slug: 'pdf-splitter',
    title: 'PDF Splitter & Separator',
    badge: 'Transform',
    metaDescription: 'Free PDF splitter tool to split multi-page PDF documents into single-page files or custom page ranges.',
    href: withBasePath('/pdf-tools/pdf-splitter/'),
    icon: 'document',
  },
  {
    slug: 'pdf-merger',
    title: 'PDF Merger & Combiner',
    badge: 'Transform',
    metaDescription: 'Merge PDF to PDF and combine multiple PDF files into one single document in your browser.',
    href: withBasePath('/pdf-tools/pdf-merger/'),
    icon: 'document',
  },
  {
    slug: 'images-to-pdf',
    title: 'Images to PDF Converter',
    badge: 'Converter',
    metaDescription: 'Convert photos and images to PDF online with custom A4 sizing, orientation, and margins.',
    href: withBasePath('/pdf-tools/images-to-pdf/'),
    icon: 'document',
  },
  {
    slug: 'pdf-to-images',
    title: 'PDF to Images Converter',
    badge: 'Converter',
    metaDescription: 'Convert PDF to images and extract pages as high-resolution JPG, PNG, or WebP files.',
    href: withBasePath('/pdf-tools/pdf-to-images/'),
    icon: 'document',
  },
  {
    slug: 'pdf-rotate',
    title: 'PDF Page Rotator',
    badge: 'Orientation',
    metaDescription: 'Rotate PDF pages permanently by 90, 180, or 270 degrees for print-ready documents.',
    href: withBasePath('/pdf-tools/pdf-rotate/'),
    icon: 'document',
  },
  {
    slug: 'pdf-editor',
    title: 'PDF Editor',
    badge: 'Edit',
    metaDescription: 'Add text, draw shapes, highlight, insert images, sign, and annotate PDF documents — 100% private, in-browser PDF editing.',
    href: withBasePath('/pdf-tools/pdf-editor/'),
    icon: 'document',
  },
];

const schemaFaq = [
  {
    question: 'Are my confidential PDF documents uploaded to an external server?',
    answer: 'No. All PDF inspection, metadata stripping, page counting, and canvas conversions execute 100% locally in your browser memory using HTML5 FileReader and Web APIs.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl} heroCompact={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <SiteHero
    slot="hero"
    breadcrumbs={breadcrumbItems}
    badge="100% Private Client-Side PDF Suite"
    title="Free PDF Tools Online — PDF Maker &amp; Document Tools"
    description="Fast, free online PDF tools to merge PDF to PDF, convert images to PDF, split documents, extract pages, rotate orientations, and strip metadata with 100% private in-browser processing."
  />

  <article class="space-y-10 py-2">

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Directory</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">11 In-Browser PDF Engines</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          11 Tools
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pdfToolsList.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
            data-calculator-card
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon slug={tool.slug} category="PDF" size="md" />
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2.5 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold tracking-tight text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)] line-clamp-2">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center justify-between pt-2.5 border-t border-[color:var(--border)]/60">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-[color:var(--fg)] group-hover:text-[color:var(--accent)] transition-colors">
                <span>Open Tool</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5 transition group-hover:translate-x-1" />
              </span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--muted)] group-hover:text-[color:var(--fg)] transition-colors">Instant</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
