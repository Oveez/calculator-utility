---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `PDF Page Counter — Count Pages Online Privately · ${siteName}`;
const pageDesc = 'Count pages in PDF files and documents online. Supports single or multiple batch PDF uploads, file size checks, and page tallies with 100% private in-browser parsing.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-page-counter/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF Page Counter' },
];

const schemaFaq = [
  {
    question: 'How does in-browser PDF page counting work?',
    answer: 'It reads the PDF binary stream with HTML5 FileReader and scans for `/Type /Page` object markers and `/Count` dictionary tags inside the document catalog tree.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Page Counter',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-page-counter-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Binary PDF Parser</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF Page Counter &amp; Tally Tool
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Count total pages in PDF files and batch documents instantly without uploading them to external servers.
      </p>
    </header>

    <div class="space-y-6">
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="pdf-file" accept="application/pdf" multiple class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="document" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Choose PDF document(s) to count pages</p>
          <p class="text-xs text-[color:var(--muted)]">Supports multiple files (100% private in browser)</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Choose Other Files
          </label>
        </div>
      </div>

      <!-- Results Table -->
      <div id="results-table-card" class="hidden space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Count Results</span>
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1 text-xs font-bold">
            Total Pages: <span id="grand-total" class="text-emerald-500 font-mono">0</span>
          </div>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)]">
          <table class="w-full text-left text-xs">
            <thead class="bg-[color:var(--surface-strong)] text-[color:var(--muted)] border-b border-[color:var(--border)]">
              <tr>
                <th class="p-3.5 font-bold">Document Name</th>
                <th class="p-3.5 font-bold">File Size</th>
                <th class="p-3.5 font-bold">Page Count</th>
              </tr>
            </thead>
            <tbody id="pdf-tbody" class="divide-y divide-[color:var(--border)] font-mono text-[color:var(--fg)]"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-page-counter-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const tableCard = root.querySelector('#results-table-card');
      const grandTotal = root.querySelector('#grand-total');
      const tbody = root.querySelector('#pdf-tbody');

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function countPdfPages(buffer) {
        const text = new TextDecoder('latin1').decode(buffer);
        const matches = text.match(/\/Type\s*\/Page\b/g);
        if (matches && matches.length > 0) return matches.length;

        // Fallback: search /Count N
        const countMatch = text.match(/\/Count\s+(\d+)/);
        if (countMatch) return parseInt(countMatch[1], 10);
        return 1;
      }

      fileIn.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files);
        if (files.length === 0) return;

        thumbName.textContent = files.length === 1 ? files[0].name : `${files.length} PDF Documents Selected`;
        const totalSize = files.reduce((acc, f) => acc + f.size, 0);
        thumbInfo.textContent = `${formatBytes(totalSize)} total`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        tableCard.classList.remove('hidden');
        tbody.innerHTML = '';
        let total = 0;

        for (const file of files) {
          const buffer = await file.arrayBuffer();
          const pages = countPdfPages(buffer);
          total += pages;

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[color:var(--surface-strong)]';
          tr.innerHTML = `
            <td class="p-3.5 font-bold">${file.name}</td>
            <td class="p-3.5 text-[color:var(--muted)]">${formatBytes(file.size)}</td>
            <td class="p-3.5 font-bold text-emerald-500">${pages} pages</td>
          `;
          tbody.appendChild(tr);
        }

        grandTotal.textContent = total;
        thumbInfo.textContent = `${formatBytes(totalSize)} • ${total} total pages`;
      });
    })();
  </script>
</SiteLayout>
