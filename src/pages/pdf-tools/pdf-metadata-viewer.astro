---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `PDF Metadata Viewer — View PDF Title, Author & Properties · ${siteName}`;
const pageDesc = 'Inspect PDF document properties including Title, Author, Subject, Creator, Producer software, PDF version, and creation timestamps. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-metadata-viewer/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF Metadata Viewer' },
];

const schemaFaq = [
  {
    question: 'How are PDF document properties extracted?',
    answer: 'The viewer loads your PDF binary into client memory and parses the document catalog Info dictionary and XMP metadata stream using pdf-lib, extracting Title, Author, Subject, Keywords, Creator tool, Producer engine, and creation/modification timestamps.',
  },
  {
    question: 'Can I copy or export the extracted metadata?',
    answer: 'Yes! You can copy all metadata fields as formatted JSON, copy as a Markdown table for documentation, or download a .json file directly.',
  },
  {
    question: 'Does this tool inspect hidden XMP metadata?',
    answer: 'Yes. It inspects both standard Document Information Dictionary (DID) attributes and embedded Extensible Metadata Platform (XMP) packages when available.',
  },
  {
    question: 'Are my confidential documents uploaded to any remote server?',
    answer: 'No. The entire metadata extraction and inspection process runs 100% locally in your browser memory. No data is ever transmitted or logged.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Metadata Viewer',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    name: 'Document Information Dictionary',
    type: 'Key-Value Object Pairs',
    description: 'Standard PDF attributes including Title, Author, Subject, Keywords, Creator (authoring application), and Producer (PDF compiler engine).',
  },
  {
    name: 'Creation & Modification Timestamps',
    type: 'PDF Date Format / ISO-8601',
    description: 'Cryptographic or sequential date strings indicating when the file was first compiled and when it was last edited.',
  },
  {
    name: 'PDF Specification Version',
    type: 'Header String (PDF 1.0 - 2.0)',
    description: 'The binary header specification indicating feature support, encryption schemes, and compression layers.',
  },
];

const workedExampleData = {
  title: 'Worked Example & Step-by-Step Walkthrough',
  description: 'A practical demonstration of extracting metadata from an exported document.',
  formula: 'PDF Document → Catalog Trailer → Parse Info Dictionary & Timestamps → Formatted Audit Table',
  steps: [
    {
      step: 'Step 1: Read File Header & Trailer',
      calculation: 'Scanned header reveals PDF 1.7 specification; trailer contains root catalog and Info object reference.',
      result: 'Catalog dictionary resolved in ~15ms.',
    },
    {
      step: 'Step 2: Decode Metadata Strings',
      calculation: 'Title: "Q3 Financial Statement", Author: "Corporate Finance", Producer: "macOS Quartz PDFContext".',
      result: 'Metadata formatted into visual table with JSON and Markdown export readiness.',
    },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pdf-meta-app>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Deep Catalog Inspection • ISO Timestamps • JSON Export</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF Metadata Viewer &amp; Inspector
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Inspect PDF document properties including Title, Author, Subject, Creator tool, Producer software, PDF version, and revision timestamps without uploading files.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-10 text-center transition hover:border-[color:var(--accent)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-3 block">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs">
            <Icon name="document" class="w-7 h-7 text-[color:var(--accent)]" />
          </div>
          <div>
            <p class="text-base font-bold text-[color:var(--fg)]">Choose a PDF or drag &amp; drop to inspect</p>
            <p class="text-xs text-[color:var(--muted)] mt-1">Inspect authors, producers, timestamps, and tags (100% private in browser)</p>
          </div>
          <span class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--accent)] px-5 py-2 text-xs font-bold text-white shadow-xs">
            Select PDF File
          </span>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Metadata Table Card -->
      <div id="meta-card" class="hidden space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Extracted PDF Properties:</span>
            <span id="meta-fields-badge" class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
              Active Document
            </span>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <button
              type="button"
              id="btn-copy-json"
              class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] transition cursor-pointer"
            >
              <Icon name="copy" class="w-3.5 h-3.5 text-blue-500" /><span>Copy JSON</span>
            </button>
            <button
              type="button"
              id="btn-copy-md"
              class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] transition cursor-pointer"
            >
              <Icon name="document" class="w-3.5 h-3.5 text-indigo-500" /><span>Copy Markdown Table</span>
            </button>
            <button
              type="button"
              id="btn-download-json"
              class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 font-semibold text-[color:var(--accent)] hover:underline cursor-pointer"
            >
              <svg class="w-3.5 h-3.5 stroke-current text-emerald-500" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg><span>Download .json</span>
            </button>
          </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)]">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-[color:var(--border)] bg-[color:var(--surface)] text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">
              <tr>
                <th class="p-3.5 w-1/3">Property Key</th>
                <th class="p-3.5">Property Value</th>
              </tr>
            </thead>
            <tbody id="pdf-tbody" class="divide-y divide-[color:var(--border)] font-mono text-[color:var(--fg)]"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="PDF Document Information Dictionary & Metadata Architecture"
      description="Understand PDF specification headers, Info dictionary keys, ISO timestamp parsing, and digital fingerprinting."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline></script>
  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-meta-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const dropzone = root.querySelector('#dropzone-box');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const card = root.querySelector('#meta-card');
      const tbody = root.querySelector('#pdf-tbody');

      const btnCopyJson = root.querySelector('#btn-copy-json');
      const btnCopyMd = root.querySelector('#btn-copy-md');
      const btnDownloadJson = root.querySelector('#btn-download-json');

      let currentMetadata = {};

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function parsePdfDate(dateStr) {
        if (!dateStr || dateStr === 'Not specified') return 'Not specified';
        if (dateStr instanceof Date) return dateStr.toISOString();
        // D:YYYYMMDDHHmmSSOHH'mm'
        const match = dateStr.match(/^D:(\d{4})(\d{2})?(\d{2})?(\d{2})?(\d{2})?(\d{2})?/);
        if (match) {
          const [_, y, m, d, h, min, s] = match;
          const iso = `${y}-${m || '01'}-${d || '01'} ${h || '00'}:${min || '00'}:${s || '00'}`;
          return iso;
        }
        return dateStr;
      }

      function extractPdfTag(text, tag) {
        const regex = new RegExp(`\\/${tag}\\s*\\(([^)]+)\\)`);
        const match = text.match(regex);
        return match ? match[1] : 'Not specified';
      }

      async function handleFile(file) {
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • Reading metadata...`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        const buffer = await file.arrayBuffer();
        const text = new TextDecoder('latin1').decode(buffer);

        const versionMatch = text.match(/%PDF-(\d+\.\d+)/);
        const version = versionMatch ? versionMatch[1] : '1.4';

        let title = 'Not specified';
        let author = 'Not specified';
        let subject = 'Not specified';
        let keywords = 'Not specified';
        let creator = 'Not specified';
        let producer = 'Not specified';
        let creationDate = 'Not specified';
        let modDate = 'Not specified';
        let pageCount = 1;

        if (window.PDFLib) {
          try {
            const pdfDoc = await PDFLib.PDFDocument.load(buffer, { ignoreEncryption: true });
            pageCount = pdfDoc.getPageCount();
            title = pdfDoc.getTitle() || 'Not specified';
            author = pdfDoc.getAuthor() || 'Not specified';
            subject = pdfDoc.getSubject() || 'Not specified';
            keywords = pdfDoc.getKeywords() || 'Not specified';
            creator = pdfDoc.getCreator() || 'Not specified';
            producer = pdfDoc.getProducer() || 'Not specified';
            creationDate = parsePdfDate(pdfDoc.getCreationDate());
            modDate = parsePdfDate(pdfDoc.getModificationDate());
          } catch (e) {
            console.error('PDFLib parsing fallback:', e);
          }
        }

        // Fallback for raw text regex if still unspecified
        if (title === 'Not specified') title = extractPdfTag(text, 'Title');
        if (author === 'Not specified') author = extractPdfTag(text, 'Author');
        if (creator === 'Not specified') creator = extractPdfTag(text, 'Creator');
        if (producer === 'Not specified') producer = extractPdfTag(text, 'Producer');
        if (creationDate === 'Not specified') creationDate = parsePdfDate(extractPdfTag(text, 'CreationDate'));

        thumbInfo.textContent = `${formatBytes(file.size)} • ${pageCount} page(s) • PDF ${version}`;

        currentMetadata = {
          fileName: file.name,
          fileSizeBytes: file.size,
          fileSizeFormatted: formatBytes(file.size),
          pdfVersion: `PDF ${version}`,
          pageCount: pageCount,
          title: title,
          author: author,
          subject: subject,
          keywords: keywords,
          creatorTool: creator,
          pdfProducer: producer,
          creationDate: creationDate,
          modificationDate: modDate
        };

        const rows = [
          { key: 'File Name', val: currentMetadata.fileName },
          { key: 'File Size', val: currentMetadata.fileSizeFormatted },
          { key: 'PDF Version', val: currentMetadata.pdfVersion },
          { key: 'Total Pages', val: `${currentMetadata.pageCount} page(s)` },
          { key: 'Title', val: currentMetadata.title },
          { key: 'Author', val: currentMetadata.author },
          { key: 'Subject', val: currentMetadata.subject },
          { key: 'Keywords', val: currentMetadata.keywords },
          { key: 'Creator Tool', val: currentMetadata.creatorTool },
          { key: 'PDF Producer', val: currentMetadata.pdfProducer },
          { key: 'Creation Date', val: currentMetadata.creationDate },
          { key: 'Modification Date', val: currentMetadata.modificationDate },
        ];

        card.classList.remove('hidden');
        tbody.innerHTML = rows.map(r => `
          <tr class="hover:bg-[color:var(--surface)]">
            <td class="p-3.5 font-bold text-[color:var(--fg)]">${r.key}</td>
            <td class="p-3.5 text-xs select-all">${r.val}</td>
          </tr>
        `).join('');
      }

      // Drag and drop
      ['dragenter', 'dragover'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-[color:var(--accent)]');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-[color:var(--accent)]');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (file && (file.type === 'application/pdf' || file.name.endsWith('.pdf'))) {
          handleFile(file);
        }
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
        fileIn.value = '';
      });

      // Copy JSON
      btnCopyJson.addEventListener('click', async () => {
        if (!currentMetadata.fileName) return;
        try {
          await navigator.clipboard.writeText(JSON.stringify(currentMetadata, null, 2));
          const orig = btnCopyJson.textContent;
          btnCopyJson.textContent = '✓ Copied JSON!';
          setTimeout(() => { btnCopyJson.textContent = orig; }, 1800);
        } catch (e) {
          console.error(e);
        }
      });

      // Copy Markdown
      btnCopyMd.addEventListener('click', async () => {
        if (!currentMetadata.fileName) return;
        let md = '| Property | Value |\n|---|---|\n';
        for (const [k, v] of Object.entries(currentMetadata)) {
          md += `| ${k} | ${v} |\n`;
        }
        try {
          await navigator.clipboard.writeText(md);
          const orig = btnCopyMd.textContent;
          btnCopyMd.textContent = '✓ Copied Table!';
          setTimeout(() => { btnCopyMd.textContent = orig; }, 1800);
        } catch (e) {
          console.error(e);
        }
      });

      // Download JSON
      btnDownloadJson.addEventListener('click', () => {
        if (!currentMetadata.fileName) return;
        const blob = new Blob([JSON.stringify(currentMetadata, null, 2)], { type: 'application/json;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${currentMetadata.fileName}_metadata.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    })();
  </script>
</SiteLayout>
