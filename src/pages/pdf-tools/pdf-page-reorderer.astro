---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `PDF Page Reorderer — Rearrange & Organize PDF Pages Free · ${siteName}`;
const pageDesc = 'Free PDF page reorderer online. Rearrange, organize, reverse, and rotate pages in PDF documents with an interactive visual tile editor and 100% private in-browser processing.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-page-reorderer/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF Page Reorderer' },
];

const schemaFaq = [
  {
    question: 'How does PDF page reordering work?',
    answer: 'You can rearrange pages either visually by shifting cards left/right or by specifying a custom page sequence (e.g. 3, 1, 2, 4). The tool reorganizes the internal document page index structure in memory using pdf-lib.',
  },
  {
    question: 'Can I reverse the entire document with one click?',
    answer: 'Yes! The "Reverse Page Order" button instantly flips the entire page catalog from last to first, which is ideal for scanned documents loaded upside down or back-to-front.',
  },
  {
    question: 'Can I rotate or delete individual pages while reordering?',
    answer: 'Yes. Each page tile has independent rotate (90° clockwise) and remove controls, allowing you to clean up orientation defects while organizing page sequence.',
  },
  {
    question: 'Is my document uploaded to any external server?',
    answer: 'No. All PDF binary manipulations execute 100% locally in your web browser memory. No data ever leaves your computer.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Page Reorderer',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    name: 'Page Sequence Order',
    type: 'Visual Tile Grid & Comma-Separated List',
    description: 'Specifies the target page arrangement (e.g. 3, 1, 2, 4). Both the interactive visual cards and the manual text input synchronize seamlessly.',
  },
  {
    name: 'Rotation Angle',
    type: '0° | 90° | 180° | 270°',
    description: 'Rotates selected individual pages independently to fix inverted or landscape orientation issues.',
  },
  {
    name: 'Bulk Operations',
    type: 'Reverse All | Reset to Original',
    description: 'Quick presets for flipping duplex scans or restoring the original document structure.',
  },
];

const workedExampleData = {
  title: 'Worked Example & Step-by-Step Walkthrough',
  description: 'A practical demonstration of rearranging pages in a 4-page PDF.',
  formula: 'Target Order = [3, 1, 2, 4] → OutputDocument.addPages(SourcePages[order])',
  steps: [
    {
      step: 'Step 1: Parse Document Catalog',
      calculation: 'Source PDF loaded into memory; 4 pages indexed (Original indices: 1, 2, 3, 4).',
      result: 'Catalog parsed into 4 discrete vector page streams.',
    },
    {
      step: 'Step 2: Apply Custom Page Order & Rotation',
      calculation: 'Page 3 moved to position 1; Page 2 rotated 90° CW. New sequence: [3, 1, 2, 4].',
      result: 'New PDF compiled and downloaded with reordered page dictionary.',
    },
  ],
};
---

<SiteLayout heroCompact={true} title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  
  <div slot="hero" class="site-hero-header">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Local Page Tree Sequencing • Bulk Reverse • Page Rotator</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF Page Reorderer — Rearrange PDF Pages Online Free
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Reorganize, rearrange, rotate, and customize the page sequence of your PDF documents instantly with an interactive visual tile manager. Reverse page orders or remove unwanted sheets with 100% client-side privacy.
      </p>
    </header>
  </div>

  <article class="space-y-10 py-2" data-pdf-reorder-app>

    <div class="space-y-6">
      <!-- Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-10 text-center transition hover:border-[color:var(--accent)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-3 block">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs">
            <Icon name="document" class="w-7 h-7 text-[color:var(--accent)]" />
          </div>
          <div>
            <p class="text-base font-bold text-[color:var(--fg)]">Choose a PDF or drag &amp; drop to reorder</p>
            <p class="text-xs text-[color:var(--muted)] mt-1">100% private in-browser page reordering &amp; rotation</p>
          </div>
          <span class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--accent)] px-5 py-2 text-xs font-bold text-white shadow-xs">
            Select PDF File
          </span>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB • 0 pages</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Reordering Workspace Card -->
      <div id="reorder-card" class="hidden space-y-6 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <!-- Sequence Text Input & Quick Actions -->
        <div class="space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="space-y-1">
              <label for="order-seq" class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">New Page Order Sequence:</label>
              <p class="text-[11px] text-[color:var(--muted)]">Edit sequence manually or click arrows on tiles below.</p>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <button type="button" id="btn-reverse-all" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 font-semibold text-[color:var(--accent)] hover:underline cursor-pointer">
                ⇄ Reverse All Pages
              </button>
              <button type="button" id="btn-reset-order" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">
                ↺ Reset Order
              </button>
            </div>
          </div>

          <input
            type="text"
            id="order-seq"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 font-mono text-xs text-[color:var(--fg)] font-bold tracking-wide"
            placeholder="e.g. 3, 1, 2, 4" />
        </div>

        <!-- Interactive Visual Tile Grid -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Visual Page Catalog (Click arrows to reorder, ↻ to rotate):</span>
            <span class="text-[11px] text-[color:var(--muted)]">Click 🔍 to inspect full page</span>
          </div>
          <div id="reorder-tile-grid" class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 max-h-[520px] overflow-y-auto rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4"></div>
        </div>

        <!-- Output Filename & Actions -->
        <div class="grid gap-4 sm:grid-cols-2 pt-2 border-t border-[color:var(--border)] text-xs">
          <div>
            <label for="out-filename" class="font-bold text-[color:var(--fg)] block mb-1">Output Filename</label>
            <input
              type="text"
              id="out-filename"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-mono"
              value="reordered-document.pdf" />
          </div>
        </div>

        <!-- Submit Button & Status -->
        <div class="space-y-2 pt-2 border-t border-[color:var(--border)]">
          <button
            type="button"
            id="reorder-btn"
            class="w-full rounded-xl bg-[color:var(--accent)] py-3 text-xs font-bold text-white shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 14l3-3 3 3"></path><path d="M9 17l3 3 3-3"></path></svg><span>Reorder &amp; Download PDF</span>
          </button>
          <p id="reorder-status" class="text-center text-xs text-[color:var(--muted)]"></p>
        </div>
      </div>
    </div>

    <!-- Full-Page Zoom Inspection Modal -->
    <div id="page-zoom-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="relative max-w-3xl w-full max-h-[92vh] bg-[color:var(--surface)] border border-[color:var(--border)] rounded-3xl p-5 shadow-2xl flex flex-col items-center">
        <div class="flex w-full items-center justify-between pb-3 border-b border-[color:var(--border)] mb-3">
          <h4 id="zoom-title" class="font-bold text-sm text-[color:var(--fg)]">Page Preview</h4>
          <button type="button" id="close-zoom-btn" class="rounded-xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] px-3 py-1 text-xs font-bold hover:bg-[color:var(--border)] cursor-pointer">
            Close ✕
          </button>
        </div>
        <div class="overflow-auto max-h-[75vh] w-full flex items-center justify-center bg-slate-950/20 rounded-xl p-2">
          <img id="zoom-img" alt="Zoomed Page Preview" class="max-h-[72vh] max-w-full object-contain rounded-lg shadow-md" />
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="PDF Page Tree Reordering & Indexing Guide"
      description="Understand in-memory page tree node re-indexing, vector coordinate transformations, and rotation angle dictionaries."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <svg class="w-4 h-4 text-[color:var(--muted)] group-open:rotate-180 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <!-- PDF.js & PDF-Lib CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline></script>
  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-reorder-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const dropzone = root.querySelector('#dropzone-box');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const card = root.querySelector('#reorder-card');

      const orderSeqInput = root.querySelector('#order-seq');
      const btnReverseAll = root.querySelector('#btn-reverse-all');
      const btnResetOrder = root.querySelector('#btn-reset-order');
      const reorderTileGrid = root.querySelector('#reorder-tile-grid');
      const outFilenameInput = root.querySelector('#out-filename');

      const reorderBtn = root.querySelector('#reorder-btn');
      const reorderStatus = root.querySelector('#reorder-status');

      let currentBytes = null;
      let totalPages = 0;
      let originalFilename = 'document.pdf';
      // State: Array of { originalPageNum: 1, rotation: 0 }
      let currentOrder = [];
      let currentPdfJsDoc = null;
      const pageThumbnails = {}; // pageNum -> dataUrl

      // Modal elements
      const zoomModal = root.querySelector('#page-zoom-modal');
      const zoomTitle = root.querySelector('#zoom-title');
      const zoomImg = root.querySelector('#zoom-img');
      const closeZoomBtn = root.querySelector('#close-zoom-btn');

      if (closeZoomBtn && zoomModal) {
        closeZoomBtn.addEventListener('click', () => zoomModal.classList.add('hidden'));
        zoomModal.addEventListener('click', (e) => {
          if (e.target === zoomModal) zoomModal.classList.add('hidden');
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !zoomModal.classList.contains('hidden')) {
            zoomModal.classList.add('hidden');
          }
        });
      }

      if (window.pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      async function openZoomModal(p, rotation = 0) {
        if (!zoomModal || !zoomImg) return;
        zoomTitle.textContent = `Page ${p} of ${totalPages} — Full Inspection`;
        zoomModal.classList.remove('hidden');
        zoomImg.style.transform = `rotate(${rotation}deg)`;

        if (currentPdfJsDoc) {
          try {
            const page = await currentPdfJsDoc.getPage(p);
            const unscaledViewport = page.getViewport({ scale: 1 });
            const targetW = Math.min(1200, window.innerWidth * 0.85);
            const scale = targetW / unscaledViewport.width;
            const viewport = page.getViewport({ scale: scale });

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');

            await page.render({ canvasContext: ctx, viewport: viewport }).promise;
            zoomImg.src = canvas.toDataURL('image/jpeg', 0.9);
          } catch (err) {
            console.error('Error rendering high-res zoom:', err);
            if (pageThumbnails[p]) zoomImg.src = pageThumbnails[p];
          }
        } else if (pageThumbnails[p]) {
          zoomImg.src = pageThumbnails[p];
        }
      }

      async function renderThumbnailsAsync() {
        if (!currentPdfJsDoc) return;

        for (let p = 1; p <= totalPages; p++) {
          try {
            const page = await currentPdfJsDoc.getPage(p);
            const unscaledViewport = page.getViewport({ scale: 1 });
            const targetWidth = 190;
            const scale = targetWidth / unscaledViewport.width;
            const viewport = page.getViewport({ scale: scale });

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');

            await page.render({ canvasContext: ctx, viewport: viewport }).promise;
            const thumbUrl = canvas.toDataURL('image/jpeg', 0.85);
            pageThumbnails[p] = thumbUrl;

            // Update any matching tiles already on screen
            const tiles = reorderTileGrid.querySelectorAll(`[data-orig-page="${p}"]`);
            tiles.forEach(tile => {
              const loadingEl = tile.querySelector('.thumb-loading');
              const imgEl = tile.querySelector('.thumb-img');
              if (loadingEl) loadingEl.classList.add('hidden');
              if (imgEl) {
                imgEl.src = thumbUrl;
                imgEl.classList.remove('hidden');
              }
            });
          } catch (err) {
            console.error(`Error rendering thumb for page ${p}:`, err);
          }
        }
      }

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function updateInputFromOrder() {
        orderSeqInput.value = currentOrder.map(item => item.originalPageNum).join(', ');
      }

      function renderTiles() {
        reorderTileGrid.innerHTML = '';

        currentOrder.forEach((item, idx) => {
          const isFirst = idx === 0;
          const isLast = idx === currentOrder.length - 1;
          const p = item.originalPageNum;
          const thumbUrl = pageThumbnails[p];

          const tile = document.createElement('div');
          tile.dataset.origPage = p.toString();
          tile.className = 'group relative flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-2.5 shadow-xs transition hover:border-[color:var(--accent)] hover:shadow-md';
          tile.innerHTML = `
            <div class="flex w-full items-center justify-between text-[11px] font-bold text-[color:var(--muted)] pb-1.5 border-b border-[color:var(--border)]/60">
              <span class="rounded bg-[color:var(--surface-strong)] px-1.5 py-0.5 text-[color:var(--fg)]">Pos #${idx + 1}</span>
              ${item.rotation ? `<span class="rounded bg-amber-500/15 text-amber-600 dark:text-amber-400 px-1.5 py-0.5 text-[10px] font-bold">${item.rotation}°</span>` : ''}
            </div>

            <!-- Visual Page Thumbnail -->
            <div class="relative my-2 flex aspect-3/4 w-full items-center justify-center overflow-hidden rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)]">
              <div class="thumb-loading ${thumbUrl ? 'hidden' : 'flex'} absolute inset-0 items-center justify-center text-[10px] text-[color:var(--muted)] font-medium animate-pulse">
                Pg ${p}...
              </div>
              <img src="${thumbUrl || ''}" class="thumb-img ${thumbUrl ? '' : 'hidden'} max-h-full max-w-full object-contain pointer-events-none rounded transition-transform duration-200" style="transform: rotate(${item.rotation}deg);" alt="Page ${p}" />
              
              <!-- Original Page Badge -->
              <span class="absolute top-1.5 left-1.5 rounded-md bg-slate-900/80 px-1.5 py-0.5 text-[10px] font-bold text-white shadow-xs backdrop-blur-xs pointer-events-none">
                Pg ${p}
              </span>

              <!-- Zoom Inspect Button -->
              <button type="button" data-zoom="${p}" class="absolute top-1.5 right-1.5 rounded-md bg-white/95 dark:bg-slate-800/95 p-1 text-[color:var(--fg)] hover:scale-110 shadow-xs transition cursor-pointer" title="Zoom inspect page ${p}">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </button>
            </div>

            <!-- Page Action Toolbar -->
            <div class="flex w-full items-center justify-between border-t border-[color:var(--border)] pt-1.5 text-xs">
              <div class="flex items-center gap-1">
                <button type="button" data-left="${idx}" class="rounded p-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] ${isFirst ? 'opacity-30 cursor-not-allowed' : 'cursor-pointer'}" title="Move Earlier (Left)" aria-label="Move Left" ${isFirst ? 'disabled' : ''}>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                </button>
                <button type="button" data-right="${idx}" class="rounded p-1 text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] ${isLast ? 'opacity-30 cursor-not-allowed' : 'cursor-pointer'}" title="Move Later (Right)" aria-label="Move Right" ${isLast ? 'disabled' : ''}>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </button>
                <button type="button" data-rot="${idx}" class="rounded p-1 text-[color:var(--accent)] hover:bg-[color:var(--surface-strong)] cursor-pointer" title="Rotate 90° Clockwise" aria-label="Rotate 90°">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
                </button>
              </div>
              <button type="button" data-del="${idx}" class="rounded p-1 text-rose-500 hover:bg-rose-500/10 cursor-pointer" title="Exclude Page from Output" aria-label="Exclude Page">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
          `;

          // Handlers
          tile.querySelector('[data-zoom]').addEventListener('click', () => {
            openZoomModal(p, item.rotation);
          });

          tile.querySelector('[data-left]').addEventListener('click', () => {
            if (idx > 0) {
              const temp = currentOrder[idx];
              currentOrder[idx] = currentOrder[idx - 1];
              currentOrder[idx - 1] = temp;
              updateInputFromOrder();
              renderTiles();
            }
          });

          tile.querySelector('[data-right]').addEventListener('click', () => {
            if (idx < currentOrder.length - 1) {
              const temp = currentOrder[idx];
              currentOrder[idx] = currentOrder[idx + 1];
              currentOrder[idx + 1] = temp;
              updateInputFromOrder();
              renderTiles();
            }
          });

          tile.querySelector('[data-rot]').addEventListener('click', () => {
            item.rotation = (item.rotation + 90) % 360;
            renderTiles();
          });

          tile.querySelector('[data-del]').addEventListener('click', () => {
            currentOrder.splice(idx, 1);
            updateInputFromOrder();
            renderTiles();
          });

          reorderTileGrid.appendChild(tile);
        });
      }

      async function handleFile(file) {
        originalFilename = file.name;
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • Reading structure...`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        currentBytes = await file.arrayBuffer();

        try {
          if (window.PDFLib) {
            const pdfDoc = await PDFLib.PDFDocument.load(currentBytes, { ignoreEncryption: true });
            totalPages = pdfDoc.getPageCount();
          } else {
            totalPages = 1;
          }
        } catch (err) {
          totalPages = 1;
        }

        thumbInfo.textContent = `${formatBytes(file.size)} • ${totalPages} pages`;

        // Initialize 1..N order
        currentOrder = [];
        for (let i = 1; i <= totalPages; i++) {
          currentOrder.push({ originalPageNum: i, rotation: 0 });
        }

        updateInputFromOrder();
        renderTiles();
        card.classList.remove('hidden');

        // Start rendering page thumbnails
        if (window.pdfjsLib) {
          try {
            currentPdfJsDoc = await pdfjsLib.getDocument({ data: currentBytes.slice(0) }).promise;
            renderThumbnailsAsync();
          } catch (err) {
            console.error('PDF.js failed to load document for thumbnails:', err);
          }
        }
      }

      // Drag and drop
      ['dragenter', 'dragover'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-[color:var(--accent)]');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-[color:var(--accent)]');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (file && (file.type === 'application/pdf' || file.name.endsWith('.pdf'))) {
          handleFile(file);
        }
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
        fileIn.value = '';
      });

      btnReverseAll.addEventListener('click', () => {
        currentOrder.reverse();
        updateInputFromOrder();
        renderTiles();
      });

      btnResetOrder.addEventListener('click', () => {
        currentOrder = [];
        for (let i = 1; i <= totalPages; i++) {
          currentOrder.push({ originalPageNum: i, rotation: 0 });
        }
        updateInputFromOrder();
        renderTiles();
      });

      orderSeqInput.addEventListener('change', () => {
        const parts = orderSeqInput.value.split(',').map(s => parseInt(s.trim(), 10)).filter(n => !isNaN(n) && n >= 1 && n <= totalPages);
        if (parts.length > 0) {
          currentOrder = parts.map(p => ({ originalPageNum: p, rotation: 0 }));
          renderTiles();
        }
      });

      // Compile & download
      reorderBtn.addEventListener('click', async () => {
        if (!currentBytes || currentOrder.length === 0) return;
        if (!window.PDFLib) {
          alert('PDF-Lib engine is still loading. Please wait a moment.');
          return;
        }

        reorderBtn.disabled = true;
        reorderBtn.classList.add('opacity-70');
        reorderStatus.textContent = 'Reordering page objects and applying rotation matrix...';

        try {
          const srcDoc = await PDFLib.PDFDocument.load(currentBytes, { ignoreEncryption: true });
          const newDoc = await PDFLib.PDFDocument.create();

          for (const item of currentOrder) {
            const pageIndex = item.originalPageNum - 1;
            const [copiedPage] = await newDoc.copyPages(srcDoc, [pageIndex]);

            if (item.rotation) {
              const currentAngle = copiedPage.getRotation().angle;
              copiedPage.setRotation(PDFLib.degrees(currentAngle + item.rotation));
            }

            newDoc.addPage(copiedPage);
          }

          const pdfBytes = await newDoc.save();
          const blob = new Blob([pdfBytes], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;

          let filename = outFilenameInput.value.trim() || 'reordered-document.pdf';
          if (!filename.toLowerCase().endsWith('.pdf')) filename += '.pdf';
          a.download = filename;

          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);

          reorderStatus.innerHTML = `<span class="inline-flex items-center gap-1.5 text-emerald-500 font-semibold"><svg class="w-4 h-4 inline shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Successfully reorganized ${currentOrder.length} pages into ${filename}!</span>`;
        } catch (err) {
          console.error('Reorder error:', err);
          reorderStatus.textContent = `Error during reorder: ${err.message || err}`;
        } finally {
          reorderBtn.disabled = false;
          reorderBtn.classList.remove('opacity-70');
        }
      });
    })();
  </script>
</SiteLayout>
