  function sampleTextColor(ctx, x, y, w, h) {
    try {
      var cw = ctx.canvas.width, ch = ctx.canvas.height;
      if (!cw || !ch) return '#000000';
      var sx = Math.max(0, Math.min(cw - 1, Math.round(x)));
      var sy = Math.max(0, Math.min(ch - 1, Math.round(y)));
      var sw = Math.max(1, Math.min(cw - sx, Math.round(w)));
      var sh = Math.max(1, Math.min(ch - sy, Math.round(h)));
      if (sw <= 0 || sh <= 0) return '#000000';

      var imgData = ctx.getImageData(sx, sy, sw, sh);
      var d = imgData.data;
      var nonWhite = [];

      var step = Math.max(1, Math.floor(d.length / 2000)) * 4;
      for (var i = 0; i < d.length; i += step) {
        var r = d[i], g = d[i + 1], b = d[i + 2], a = d[i + 3];
        if (a < 50) continue;
        var lum = 0.299 * r + 0.587 * g + 0.114 * b;
        if (lum < 220) {
          nonWhite.push({ r: r, g: g, b: b, lum: lum });
        }
      }

      if (nonWhite.length === 0) return '#000000';

      nonWhite.sort(function(p1, p2) { return p1.lum - p2.lum; });
      var take = Math.max(1, Math.min(25, Math.floor(nonWhite.length * 0.4)));
      var sr = 0, sg = 0, sb = 0;
      for (var j = 0; j < take; j++) {
        sr += nonWhite[j].r;
        sg += nonWhite[j].g;
        sb += nonWhite[j].b;
      }
      var ar = Math.round(sr / take);
      var ag = Math.round(sg / take);
      var ab = Math.round(sb / take);

      function toHex(n) {
        var s = Math.max(0, Math.min(255, n)).toString(16);
        return s.length === 1 ? '0' + s : s;
      }
      return '#' + toHex(ar) + toHex(ag) + toHex(ab);
    } catch (e) {
      return '#000000';
    }
  }

  function samplePageBgColor(ctx, x, y) {
    try {
      if (!ctx || !ctx.canvas) return '#ffffff';
      var sx = Math.max(0, Math.min(ctx.canvas.width - 1, Math.round(x)));
      var sy = Math.max(0, Math.min(ctx.canvas.height - 1, Math.round(y)));
      var p = ctx.getImageData(sx, sy, 1, 1).data;
      if (p[3] < 30) return '#ffffff';
      return rgbToHex('rgb(' + p[0] + ',' + p[1] + ',' + p[2] + ')') || '#ffffff';
    } catch (e) {
      return '#ffffff';
    }
  }

  function getOriginalTextMaskBounds(b) {
    var fontSize = b.pdfFontSize || 12;
    var baselineY = b.baselineY != null ? b.baselineY : (b.origPdfY + fontSize * 0.85);
    // Tight ascender and descender boundaries (avoids eating into lines above and below)
    var top = baselineY - (fontSize * 0.78);
    var height = fontSize * 0.98;
    var x = b.origPdfX;
    var width = b.origPdfW;
    return { x: x, y: top, w: width, h: height };
  }

  function drawOriginalTextMask(ctx, b, scale) {
    if (!b || !b.isOriginal || !ctx) return;
    var mb = getOriginalTextMaskBounds(b);
    var mx = Math.round(mb.x * scale);
    var my = Math.round(mb.y * scale);
    var mw = Math.round(mb.w * scale);
    var mh = Math.round(mb.h * scale);
    var bg = b.bgColor || samplePageBgColor(pCtx, mx + 2, my + 2);
    ctx.save();
    ctx.fillStyle = bg;
    ctx.fillRect(mx, my, mw, mh);
    ctx.restore();
  }

