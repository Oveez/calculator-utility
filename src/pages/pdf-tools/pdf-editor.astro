      .replace(/[\uF06F\uF0A1\u25CB]/g, '○')
      .replace(/[\uF076\uF0A7\uF0FE\u25A0]/g, '■')
      .replace(/[\uF0A8\uF071\u25A1]/g, '□')
      .replace(/[\uF0FC\uF044\u2713\u2714]/g, '✔')
      .replace(/[\uF0D8\uF0E0\u27A4\u27A2]/g, '➢')
      .replace(/[\uF0B4\u25C6]/g, '◆')
      .replace(/[\uF02D\u2013\u2014]/g, '–')
      .replace(/\u00B7/g, '•');
  }

  function restoreSavedSelection() {
    if (state.savedSelectionRange && state.savedSelectionEl) {
      try {
        state.savedSelectionEl.focus();
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(state.savedSelectionRange);
      } catch (err) {}
    }
  }

  function rgbToHex(rgbStr) {
    if (!rgbStr) return null;
    var match = rgbStr.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/i);
    if (!match) return rgbStr;
    function h(x) { return ('0' + parseInt(x).toString(16)).slice(-2); }
    return '#' + h(match[1]) + h(match[2]) + h(match[3]);
  }

  function runsToHtml(runs, defaultStyle) {
    if (!runs || !runs.length) return '';
    return runs.map(function(r) {
      var styles = [];
      var fam = r.cssFamily || r.fontFamily || (defaultStyle && (defaultStyle.cssFamily || defaultStyle.fontFamily));
      if (fam) styles.push('font-family:' + fam);
      var fsPt = r.pdfFontSize || (defaultStyle && defaultStyle.pdfFontSize) || 14;
      styles.push('font-size:' + Math.round(fsPt * state.scale) + 'px');
      if (r.bold != null ? r.bold : (defaultStyle && defaultStyle.bold)) {
        styles.push('font-weight:bold');
      } else {
        styles.push('font-weight:normal');
      }
      if (r.italic != null ? r.italic : (defaultStyle && defaultStyle.italic)) {
        styles.push('font-style:italic');
      } else {
        styles.push('font-style:normal');
      }
      var col = r.color || (defaultStyle && defaultStyle.color) || '#000000';
      styles.push('color:' + col);
      if (r.highlight) {
        styles.push('background-color:' + r.highlight);
      }
      var escaped = normalizePdfGlyphs(r.text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      return '<span style="' + styles.join(';') + '">' + escaped + '</span>';
    }).join('');
  }

  function parseFormattingRuns(container, defaultStyle) {
    var runs = [];
    var baseStyle = {
      fontFamily: (defaultStyle && defaultStyle.fontFamily) || 'Arial',
      cssFamily: (defaultStyle && defaultStyle.cssFamily) || 'Arial, sans-serif',
      pdfFontSize: (defaultStyle && defaultStyle.pdfFontSize) || 14,
      bold: !!(defaultStyle && defaultStyle.bold),
      italic: !!(defaultStyle && defaultStyle.italic),
      color: (defaultStyle && defaultStyle.color) || '#000000',
      highlight: null
    };

    function traverse(node, currentStyle) {
      if (node.nodeType === Node.TEXT_NODE) {
        var txt = normalizePdfGlyphs(node.textContent);
        if (txt) {
          runs.push({
            text: txt,
            fontFamily: currentStyle.fontFamily,
            cssFamily: currentStyle.cssFamily,
            pdfFontSize: currentStyle.pdfFontSize,
            bold: currentStyle.bold,
            italic: currentStyle.italic,
            color: currentStyle.color,
            highlight: currentStyle.highlight
          });
        }
        return;
      }

      if (node.nodeType === Node.ELEMENT_NODE) {
        var nextStyle = Object.assign({}, currentStyle);
        var tag = node.tagName.toLowerCase();
        if (tag === 'b' || tag === 'strong') nextStyle.bold = true;
        if (tag === 'i' || tag === 'em') nextStyle.italic = true;
        if (tag === 'u') nextStyle.underline = true;

        var computed = node.style;
        if (computed.fontWeight === 'bold' || parseInt(computed.fontWeight) >= 600) nextStyle.bold = true;
        if (computed.fontWeight === 'normal' || computed.fontWeight === '400') nextStyle.bold = false;
        if (computed.fontStyle === 'italic' || computed.fontStyle === 'oblique') nextStyle.italic = true;
        if (computed.fontStyle === 'normal') nextStyle.italic = false;
        if (computed.fontFamily) {
          nextStyle.cssFamily = computed.fontFamily;
          nextStyle.fontFamily = computed.fontFamily.split(',')[0].replace(/['"]/g, '').trim();
        }
        if (computed.fontSize) {
          var px = parseFloat(computed.fontSize);
          if (px > 0) nextStyle.pdfFontSize = Math.round(px / state.scale);
        }
        if (computed.color) {
          nextStyle.color = rgbToHex(computed.color) || computed.color;
        }
        if (computed.backgroundColor && computed.backgroundColor !== 'transparent' && computed.backgroundColor !== 'rgba(0, 0, 0, 0)') {
          nextStyle.highlight = rgbToHex(computed.backgroundColor) || computed.backgroundColor;
        }

        if (tag === 'br') {
          runs.push({
            text: '\n',
            fontFamily: nextStyle.fontFamily,
            cssFamily: nextStyle.cssFamily,
            pdfFontSize: nextStyle.pdfFontSize,
            bold: nextStyle.bold,
            italic: nextStyle.italic,
            color: nextStyle.color,
            highlight: nextStyle.highlight
          });
          return;
        }

        for (var i = 0; i < node.childNodes.length; i++) {
          traverse(node.childNodes[i], nextStyle);
        }
      }
    }

    traverse(container, baseStyle);

    // Merge consecutive runs with identical styling
    var merged = [];
    runs.forEach(function(r) {
      var last = merged[merged.length - 1];
      if (last &&
          last.fontFamily === r.fontFamily &&
          last.pdfFontSize === r.pdfFontSize &&
          last.bold === r.bold &&
          last.italic === r.italic &&
          last.color === r.color &&
          last.highlight === r.highlight) {
        last.text += r.text;
      } else {
        merged.push(Object.assign({}, r));
      }
    });

    return merged;
  }

  // ── FLOATING TRAY & PARTIAL TEXT SELECTION FORMATTING ────────
  function updateFloatingTray() {
    var activeEl = document.activeElement;
    if (activeEl && (activeEl.closest('#ped-floating-tray') || activeEl.closest('.ped-ctx-toolbar'))) {
      return;
    }

    var sel = window.getSelection();
    if (!sel || sel.rangeCount === 0 || sel.isCollapsed) {
      floatingTray.classList.add('ped-hidden');
      return;
    }

    if (!activeEl || !activeEl.isContentEditable) {
      floatingTray.classList.add('ped-hidden');
      return;
    }

    var range = sel.getRangeAt(0);
    if (!activeEl.contains(range.commonAncestorContainer)) {
      floatingTray.classList.add('ped-hidden');
      return;
    }

    var rect = range.getBoundingClientRect();
    var pageRect = pageWrapper.getBoundingClientRect();

    var trayX = (rect.left + rect.width / 2) - pageRect.left;
    var trayY = rect.top - pageRect.top;

    // Bounds clamping inside page wrapper
    trayX = Math.max(160, Math.min(pageRect.width - 160, trayX));

    if (trayY < 48) {
      trayY = (rect.bottom - pageRect.top) + 8;
      floatingTray.style.transform = 'translate(-50%, 0)';
      floatingTray.style.marginTop = '0px';
    } else {
      trayY = Math.max(10, trayY);
      floatingTray.style.transform = 'translate(-50%, -100%)';
      floatingTray.style.marginTop = '-8px';
    }

    floatingTray.style.left = trayX + 'px';
    floatingTray.style.top = trayY + 'px';
    floatingTray.classList.remove('ped-hidden');

    syncFloatingTrayState(range);
  }

  function syncFloatingTrayState(range) {
    try {
      $('flt-bold').classList.toggle('active', document.queryCommandState('bold'));
      $('flt-italic').classList.toggle('active', document.queryCommandState('italic'));

      var node = range.commonAncestorContainer;
      if (node.nodeType === Node.TEXT_NODE) node = node.parentNode;
      if (node && node.nodeType === Node.ELEMENT_NODE) {
        var comp = window.getComputedStyle(node);
        if (comp.fontFamily) {
          var firstFam = comp.fontFamily.split(',')[0].replace(/['"]/g, '').trim();
          var matchOpt = $('flt-font-family').querySelector('option[value="' + firstFam + '"]');
          if (!matchOpt) {
            var nOpt = document.createElement('option');
            nOpt.value = firstFam;
            nOpt.textContent = firstFam;
            $('flt-font-family').appendChild(nOpt);
          }
          $('flt-font-family').value = firstFam;
        }
        if (comp.fontSize) {
          var pt = Math.round(parseFloat(comp.fontSize) / state.scale);
          var fsOpt = $('flt-font-size').querySelector('option[value="' + pt + '"]');
          if (!fsOpt) {
            var nfsOpt = document.createElement('option');
            nfsOpt.value = String(pt);
            nfsOpt.textContent = String(pt);
            $('flt-font-size').appendChild(nfsOpt);
          }
          $('flt-font-size').value = String(pt);
        }
        if (comp.color) {
          var hex = rgbToHex(comp.color);
          if (hex) $('flt-color').value = hex;
        }
      }
    } catch (err) {}
  }

  function applySpanStyleToRange(range, prop, value) {
    if (range.collapsed) return;
    var span = document.createElement('span');
    span.style[prop] = value;
    try {
      var fragment = range.extractContents();
      span.appendChild(fragment);
      range.insertNode(span);
      var sel = window.getSelection();
      sel.removeAllRanges();
      var newRange = document.createRange();
      newRange.selectNodeContents(span);
      sel.addRange(newRange);
      state.savedSelectionRange = newRange.cloneRange();
    } catch (err) {
      console.warn('applySpanStyle error:', err);
    }
  }

  function applyFormatToSelection(cmd, value) {
    var sel = window.getSelection();
    var hasSelection = sel && sel.rangeCount > 0 && !sel.isCollapsed;

    var curEl = state.activeEditEl || state.selectedEl;
    var curBlock = state.activeEditBlock || state.selectedAnn;
    if (!curEl && state.savedSelectionEl) {
      curEl = state.savedSelectionEl.closest('.ped-text-block');
    }
    if (!curBlock && curEl && curEl.dataset.blockId) {
      var p = state.currentPage;
      var blocks = (state.doc.textBlocks && state.doc.textBlocks[p]) || [];
      curBlock = blocks.find(function(x) { return x.id === curEl.dataset.blockId; });
    }

    if (!hasSelection) {
      // Whole-box formatting if nothing specifically selected
      if (curBlock && curEl) {
        if (cmd === 'fontName') {
          curBlock.fontFamily = value;
          curBlock.cssFamily = value;
        } else if (cmd === 'fontSize') {
          curBlock.pdfFontSize = parseInt(value) || 16;
          curBlock.fontSize = Math.round(curBlock.pdfFontSize * state.scale);
        } else if (cmd === 'bold') {
          curBlock.bold = !curBlock.bold;
        } else if (cmd === 'italic') {
          curBlock.italic = !curBlock.italic;
        } else if (cmd === 'foreColor') {
          curBlock.color = value;
        }
        curBlock.isModified = true;
        var contentEl = curEl.querySelector('.ped-text-content') || curEl.querySelector('.ped-et-content') || curEl.querySelector('.text-content');
        if (contentEl) {
          applyTextStyle(contentEl, curBlock);
          curBlock.runs = parseFormattingRuns(contentEl, curBlock);
        }
        if (curBlock.isOriginal) {
          drawOriginalTextMask(aCtx, curBlock, state.scale);
        }
        syncToolbarToBlock(curBlock);
        pushUndoSnapshot();
      }
      return;
    }

    // Text is selected! Apply to selected characters
    if (cmd === 'bold') {
      document.execCommand('bold', false, null);
    } else if (cmd === 'italic') {
      document.execCommand('italic', false, null);
    } else if (cmd === 'foreColor') {
      document.execCommand('foreColor', false, value);
    } else if (cmd === 'hiliteColor') {
      document.execCommand('hiliteColor', false, value);
    } else if (cmd === 'fontName') {
      applySpanStyleToRange(sel.getRangeAt(0), 'fontFamily', value);
    } else if (cmd === 'fontSize') {
      applySpanStyleToRange(sel.getRangeAt(0), 'fontSize', (parseInt(value) * state.scale) + 'px');
    }

    if (curEl && curBlock) {
      curBlock.isModified = true;
      var contentEl = curEl.querySelector('.ped-text-content') || curEl.querySelector('.ped-et-content') || curEl.querySelector('.text-content');
      if (contentEl) {
        curBlock.text = contentEl.innerText;
        curBlock.runs = parseFormattingRuns(contentEl, curBlock);
      }
      if (curBlock.isOriginal) {
        drawOriginalTextMask(aCtx, curBlock, state.scale);
      }
      syncToolbarToBlock(curBlock);
      pushUndoSnapshot();
    }

    var liveSel = window.getSelection();
    if (liveSel && liveSel.rangeCount > 0 && !liveSel.isCollapsed) {
      state.savedSelectionRange = liveSel.getRangeAt(0).cloneRange();
    }
    updateFloatingTray();
  }

  function setupFloatingTray() {
    floatingTray.addEventListener('mousedown', function(e) {
      e.stopPropagation();
      // Keep selection in contenteditable when clicking buttons or swatches
      if (!e.target.closest('select, input')) {
        e.preventDefault();
      }
    });

    $('flt-bold').addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      restoreSavedSelection();
      applyFormatToSelection('bold');
    });

    $('flt-italic').addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      restoreSavedSelection();
      applyFormatToSelection('italic');
    });

    ['left', 'center', 'right'].forEach(function(align) {
      var btn = $('flt-align-' + align);
      if (!btn) return;
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var b = state.activeEditBlock || state.selectedAnn;
        var el = state.activeEditEl || state.selectedEl;
        if (b && el) {
          b.align = align;
          b.isModified = true;
          var content = el.querySelector('.ped-text-content') || el.querySelector('.ped-et-content');
          if (content) content.style.textAlign = align;
          document.querySelectorAll('.align-btn').forEach(function(btnEl) {
            btnEl.classList.toggle('active', btnEl.dataset.align === align);
          });
          pushUndoSnapshot();
        }
      });
    });

    $('flt-font-family').addEventListener('change', function(e) {
      e.stopPropagation();
      restoreSavedSelection();
      applyFormatToSelection('fontName', this.value);
    });

    $('flt-font-size').addEventListener('change', function(e) {
      e.stopPropagation();
      restoreSavedSelection();
      applyFormatToSelection('fontSize', this.value);
    });

    $('flt-color').addEventListener('input', function(e) {
      e.stopPropagation();
      restoreSavedSelection();
      applyFormatToSelection('foreColor', this.value);
    });

    document.querySelectorAll('.flt-hl-swatch').forEach(function(swatch) {
      swatch.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        restoreSavedSelection();
        applyFormatToSelection('hiliteColor', this.dataset.hl);
      });
    });

    document.addEventListener('selectionchange', function() {
      var sel = window.getSelection();
      var activeEl = document.activeElement;
      if (activeEl && activeEl.isContentEditable && activeEl.closest('.ped-text-block')) {
        if (sel && sel.rangeCount > 0 && !sel.isCollapsed) {
          state.savedSelectionRange = sel.getRangeAt(0).cloneRange();
          state.savedSelectionEl = activeEl;
        }
      }
      updateFloatingTray();
    });
  }

  function setCaretAtEnd(el) {
    if (!el) return;
    try {
      el.focus();
      var range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    } catch (err) {}
  }

  function selectAllTextInContent(content) {
    if (!content) return;
    try {
      content.focus();
      var range = document.createRange();
      range.selectNodeContents(content);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    } catch (err) {}
  }

  function commitCurrentTextEdit() {
    floatingTray.classList.add('ped-hidden');
    if (state.activeEditEl && state.activeEditBlock) {
      var el = state.activeEditEl;
      var b = state.activeEditBlock;
      var content = el.querySelector('.ped-text-content') || el.querySelector('.ped-et-content') || el.querySelector('.text-content');
      if (content) {
        var newText = normalizePdfGlyphs(content.innerText);
        var newRuns = parseFormattingRuns(content, b);
        var changed = (newText !== b.text) || (JSON.stringify(newRuns) !== JSON.stringify(b.origRuns));

        if (changed) {
          b.text = newText;
          b.runs = newRuns;
          b.isModified = true;
        }

        // If newly added text box and user left it completely empty, discard it
        if (!b.isOriginal && (!b.text || !b.text.trim())) {
          b.isDeleted = true;
          var arr = state.doc.textBlocks[state.currentPage] || [];
          state.doc.textBlocks[state.currentPage] = arr.filter(function(x) { return x.id !== b.id; });
          el.remove();
        } else {
          content.contentEditable = 'false';
          if (changed) {
            pushUndoSnapshot();
          }
          if (b.isOriginal) {
            if (b.isModified) {
              drawOriginalTextMask(aCtx, b, state.scale);
            } else {
              // Not modified: revert transparent style so original canvas text shows cleanly with no mask
              content.style.color = 'transparent';
              redrawAnnotationsCanvas(state.currentPage);
            }
          }
        }
      }
      el.classList.remove('editing');
      state.activeEditEl = null;
      state.activeEditBlock = null;
    }
  }

  function startTextEditing(el, b, selectAll) {
    if (!el || !el.isConnected) return;
    if (state.activeEditEl !== el) {
      commitCurrentTextEdit();
    }

    if (state.selectedEl !== el) {
      selectElement(el, b);
    }

    state.activeEditEl = el;
    state.activeEditBlock = b;

    el.classList.add('custom-text', 'edited', 'editing');

    var content = el.querySelector('.ped-text-content') || el.querySelector('.ped-et-content') || el.querySelector('.text-content');
    if (content) {
      content.style.color = b.color || '#000000';
      if (b.runs && b.runs.length > 0) {
        content.innerHTML = runsToHtml(b.runs, b);
      } else {
        content.innerText = b.text;
      }
      content.contentEditable = 'true';
      content.focus();
      if (selectAll) {
        selectAllTextInContent(content);
      } else {
        setCaretAtEnd(content);
      }
    }

    // Mask original text on canvas immediately with tight boundaries
    if (b.isOriginal) {
      drawOriginalTextMask(aCtx, b, state.scale);
    }

    // Ensure toolbars are synced
    syncToolbarToBlock(b);

    setStatus('Editing text... Type to modify. Click outside or press Esc when done.');
  }

  function deselectAll() {
    commitCurrentTextEdit();
    floatingTray.classList.add('ped-hidden');
    if (state.selectedEl) {
      var el = state.selectedEl;
      var a = state.selectedAnn;
      el.classList.remove('selected', 'editing');
      var content = el.querySelector('.ped-text-content') || el.querySelector('.ped-et-content') || el.querySelector('.text-content');
      if (content) content.contentEditable = 'false';

      state.selectedEl = null;
      state.selectedAnn = null;
    }
    if (!state.activeTool || (state.activeTool !== 'text' && state.activeTool !== 'text-edit')) {
      textCtxToolbar.classList.add('ped-hidden');
    }
    if (state.activeTool !== 'draw') {
      drawCtxToolbar.classList.add('ped-hidden');
    }
    if (state.activeTool !== 'line') {
      shapeCtxToolbar.classList.add('ped-hidden');
    }
    if (state.activeTool !== 'highlight') {
      highlightCtxToolbar.classList.add('ped-hidden');
    }
    if (state.activeTool === 'text') {
      syncToolbarToNewText();
    }
  }

  function selectElement(el, a) {
    if (state.selectedEl === el) return;
    deselectAll();
    state.selectedEl = el;
    state.selectedAnn = a;
    el.classList.add('selected');

    var isText = (a.isOriginal !== undefined) || a.type === 'text' || a.type === 'edit-text' || (a.id && String(a.id).startsWith('tb-'));
    if (isText) {
      textCtxToolbar.classList.remove('ped-hidden');
      drawCtxToolbar.classList.add('ped-hidden');
      shapeCtxToolbar.classList.add('ped-hidden');
      highlightCtxToolbar.classList.add('ped-hidden');

      syncToolbarToBlock(a);
      $('text-ctx-hint').textContent = 'Click to edit, drag to move';
    } else if (a.type === 'shape') {
      shapeCtxToolbar.classList.remove('ped-hidden');
      textCtxToolbar.classList.add('ped-hidden');
      drawCtxToolbar.classList.add('ped-hidden');
      highlightCtxToolbar.classList.add('ped-hidden');
      $('shape-ctx-color').value = a.color || '#e53e3e';
      $('shape-ctx-width').value = String(a.width || 2);
      $('shape-ctx-fill-enable').checked = !!a.fill;
      $('shape-ctx-fill-color').value = a.fillColor || '#93c5fd';
      $('shape-ctx-fill-wrap').style.opacity = a.fill ? '1' : '0.5';

      $('ann-color').value = a.color || '#e53e3e';
      $('ann-width').value = String(a.width || 2);
      $('ann-fill-enable').checked = !!a.fill;
      $('ann-fill-color').value = a.fillColor || '#93c5fd';
      $('ann-fill-wrap').style.opacity = a.fill ? '1' : '0.5';
      setStatus('Shape selected. Drag to move, dots to resize, adjust color & fill above.');
    } else if (a.type === 'highlight') {
      highlightCtxToolbar.classList.remove('ped-hidden');
      textCtxToolbar.classList.add('ped-hidden');
      drawCtxToolbar.classList.add('ped-hidden');
      shapeCtxToolbar.classList.add('ped-hidden');
      $('hl-delete-btn').classList.remove('ped-hidden');
      document.querySelectorAll('.ped-hl-btn').forEach(function(b) {
        b.classList.toggle('active', b.dataset.hl === a.color);
      });
      $('hl-custom-color').value = a.color || '#fef08a';
      $('hl-opacity-select').value = String(a.opacity != null ? a.opacity : 0.35);
      setStatus('Highlight selected. Change color/opacity above, or press Delete to remove.');
    }
  }



  // ── SHAPE RENDERING (UNLOCKED, SELECTABLE, RESIZABLE, STYLABLE) ───
  function renderShapeSvg(svgWrap, a) {
    var w = Math.max(8, a.w || 20);
    var h = Math.max(8, a.h || 20);
    var sw = a.width || 2;
    var stroke = a.color || '#e53e3e';
    var fill = a.fill ? (a.fillColor || '#93c5fd') : 'transparent';
    var half = sw / 2;

    var html = '';
    if (a.shape === 'rect') {
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<rect x="' + half + '" y="' + half + '" width="' + Math.max(1, w - sw) + '" height="' + Math.max(1, h - sw) + '" rx="3" ' +
        'fill="' + fill + '" stroke="' + stroke + '" stroke-width="' + sw + '" />' +
        '</svg>';
    } else if (a.shape === 'circle') {
      var rx = Math.max(1, (w - sw) / 2);
      var ry = Math.max(1, (h - sw) / 2);
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<ellipse cx="' + (w / 2) + '" cy="' + (h / 2) + '" rx="' + rx + '" ry="' + ry + '" ' +
        'fill="' + fill + '" stroke="' + stroke + '" stroke-width="' + sw + '" />' +
        '</svg>';
    } else if (a.shape === 'line') {
      var lx1 = (a.x2 >= a.x1) ? half : (w - half);
      var ly1 = (a.y2 >= a.y1) ? half : (h - half);
      var lx2 = (a.x2 >= a.x1) ? (w - half) : half;
      var ly2 = (a.y2 >= a.y1) ? (h - half) : half;
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<line x1="' + lx1 + '" y1="' + ly1 + '" x2="' + lx2 + '" y2="' + ly2 + '" ' +
        'stroke="' + stroke + '" stroke-width="' + sw + '" stroke-linecap="round" />' +
        '</svg>';
    } else if (a.shape === 'arrow') {
      var lx1 = (a.x2 >= a.x1) ? half : (w - half);
      var ly1 = (a.y2 >= a.y1) ? half : (h - half);
      var lx2 = (a.x2 >= a.x1) ? (w - half) : half;
      var ly2 = (a.y2 >= a.y1) ? (h - half) : half;
      var angle = Math.atan2(ly2 - ly1, lx2 - lx1);
      var hl = Math.max(12, sw * 4);
      var p1x = lx2 - hl * Math.cos(angle - Math.PI / 6);
      var p1y = ly2 - hl * Math.sin(angle - Math.PI / 6);
      var p2x = lx2 - hl * Math.cos(angle + Math.PI / 6);
      var p2y = ly2 - hl * Math.sin(angle + Math.PI / 6);
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<line x1="' + lx1 + '" y1="' + ly1 + '" x2="' + lx2 + '" y2="' + ly2 + '" stroke="' + stroke + '" stroke-width="' + sw + '" stroke-linecap="round" />' +
        '<polygon points="' + lx2 + ',' + ly2 + ' ' + p1x + ',' + p1y + ' ' + p2x + ',' + p2y + '" fill="' + stroke + '" />' +
        '</svg>';
    }
    svgWrap.innerHTML = html;
  }

