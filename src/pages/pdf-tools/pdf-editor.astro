      state.defaultNewTextStyle.align = state.textAlign;
      state.defaultNewTextStyle.color = $('ctx-color').value;
      return;
    }

    a.isModified = true;
    a.fontFamily = $('ctx-font-family').value;
    a.cssFamily = a.fontFamily;
    var ptSize = parseInt($('ctx-font-size').value) || 16;
    a.pdfFontSize = ptSize;
    a.fontSize = Math.round(ptSize * state.scale);
    a.bold = state.bold;
    a.italic = state.italic;
    a.align = state.textAlign;
    a.color = $('ctx-color').value;

    el.classList.add('custom-text', 'edited');
    var contentEl = el.querySelector('.ped-text-content') || el.querySelector('.text-content') || el.querySelector('.ped-et-content');
    if (contentEl) {
      applyTextStyle(contentEl, a);
      a.runs = parseFormattingRuns(contentEl, a);
    }

    if (a.isOriginal) {
      drawOriginalTextMask(aCtx, a, state.scale);
    }

    syncToolbarToBlock(a);
    pushUndoSnapshot();
    // In-place styling: do NOT destroy the DOM with renderPageElements()!
  }

