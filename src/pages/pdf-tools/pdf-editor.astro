  function updateSelectedTextStyle() {
    var a = state.activeEditBlock || state.selectedAnn;
    var el = state.activeEditEl || state.selectedEl;
    if (!a || !el) {
      if (!state.defaultNewTextStyle) state.defaultNewTextStyle = {};
