<!-- GLOBAL STYLES FOR STATIC AND DYNAMIC ELEMENTS -->
<style is:global>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --ped-bg: #f5f5f5;
  --ped-surface: #ffffff;
  --ped-border: #e2e8f0;
  --ped-text: #1a202c;
  --ped-muted: #718096;
  --ped-accent: #3b82f6;
  --ped-accent-hover: #2563eb;
  --ped-toolbar-bg: #ffffff;
  --ped-toolbar-border: #e2e8f0;
  --ped-thumb-bg: #f0f0f0;
  --ped-active-bg: #eff6ff;
  --ped-active-border: #3b82f6;
  --ped-shadow: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.08);
  --ped-shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
}
[data-theme="dark"] {
  --ped-bg: #111827;
  --ped-surface: #1f2937;
  --ped-border: #374151;
  --ped-text: #f9fafb;
  --ped-muted: #9ca3af;
  --ped-toolbar-bg: #1f2937;
  --ped-toolbar-border: #374151;
  --ped-thumb-bg: #111827;
  --ped-active-bg: #1e3a5f;
  --ped-active-border: #3b82f6;
}

html, body { height: 100%; overflow: hidden; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ped-bg); color: var(--ped-text); }
.ped-hidden { display: none !important; }

/* ── UPLOAD PAGE ─────────────────────────────────── */
.ped-upload-page {
  height: 100vh; display: flex; flex-direction: column; background: var(--ped-bg);
}
.ped-upload-header {
  display: flex; align-items: center; gap: 16px; padding: 14px 24px;
  background: var(--ped-toolbar-bg); border-bottom: 1px solid var(--ped-toolbar-border);
  box-shadow: var(--ped-shadow);
}
.ped-back-link {
  display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600;
  color: var(--ped-muted); text-decoration: none; transition: color .15s;
}
.ped-back-link:hover { color: var(--ped-accent); }
.ped-back-link svg { width: 14px; height: 14px; }
.ped-upload-title { font-size: 16px; font-weight: 800; color: var(--ped-text); }
.ped-upload-badge {
  margin-left: auto; font-size: 11px; font-weight: 600; color: #10b981;
  background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.25); border-radius: 99px; padding: 2px 10px;
}
.ped-upload-body {
  flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px;
}
.ped-dropzone {
  width: 100%; max-width: 600px; display: flex; flex-direction: column; align-items: center;
  gap: 18px; background: var(--ped-surface); border: 2px dashed var(--ped-border);
  border-radius: 20px; padding: 52px 40px; text-align: center; transition: border-color .2s;
  cursor: pointer;
}
.ped-dropzone.drag-over { border-color: var(--ped-accent); background: var(--ped-active-bg); }
.ped-dropzone-icon svg {
  width: 64px; height: 64px; color: var(--ped-accent); stroke-width: 1;
}
.ped-dropzone-h1 { font-size: 24px; font-weight: 800; color: var(--ped-text); }
.ped-dropzone-sub { font-size: 14px; color: var(--ped-muted); margin-top: -8px; }
.ped-dropzone-btn {
  display: inline-flex; align-items: center; gap: 8px; background: var(--ped-accent);
  color: #fff; font-weight: 700; font-size: 14px; padding: 12px 28px; border-radius: 12px;
  border: none; cursor: pointer; transition: background .15s, transform .1s;
}
.ped-dropzone-btn:hover { background: var(--ped-accent-hover); transform: translateY(-1px); }
.ped-dropzone-btn svg { width: 16px; height: 16px; }
.ped-feature-badges {
  display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
}
.ped-feature-badges span {
  font-size: 12px; color: var(--ped-muted); background: var(--ped-bg);
  border: 1px solid var(--ped-border); border-radius: 8px; padding: 5px 12px;
}

/* ── EDITOR PAGE ─────────────────────────────────── */
.ped-editor-page {
  height: 100vh; display: flex; flex-direction: column; background: var(--ped-bg); overflow: hidden;
}

/* TOOLBAR */
.ped-toolbar {
  display: flex; align-items: center; gap: 4px; padding: 6px 12px;
  background: var(--ped-toolbar-bg); border-bottom: 1px solid var(--ped-toolbar-border);
  box-shadow: var(--ped-shadow); flex-shrink: 0; flex-wrap: wrap; min-height: 50px; z-index: 20;
}
.ped-tb-group { display: flex; align-items: center; gap: 2px; }
.ped-tb-sep { width: 1px; height: 28px; background: var(--ped-toolbar-border); margin: 0 6px; flex-shrink: 0; }
.ped-tb-btn {
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 1px; padding: 5px 8px; border-radius: 8px; border: 1px solid transparent;
  background: transparent; color: var(--ped-muted); cursor: pointer; font-size: 9px;
  font-weight: 600; white-space: nowrap; transition: all .15s; min-width: 44px;
}
.ped-tb-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
.ped-tb-btn:hover { background: var(--ped-active-bg); color: var(--ped-accent); border-color: var(--ped-active-border); }
.ped-tb-btn:disabled { opacity: .4; cursor: not-allowed; }
.ped-tb-btn.ped-tb-active { background: var(--ped-active-bg); color: var(--ped-accent); border-color: var(--ped-active-border); }
.ped-tool-btn.tool-active { background: var(--ped-accent); color: white !important; border-color: var(--ped-accent); }
.ped-tb-style-group { gap: 8px; }
.ped-style-label {
  display: flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 600; color: var(--ped-muted); cursor: pointer;
}
.ped-style-label input[type=color] { width: 26px; height: 26px; border-radius: 6px; border: 1px solid var(--ped-border); cursor: pointer; padding: 1px; background: transparent; }
.ped-style-label select {
  border: 1px solid var(--ped-border); border-radius: 6px; background: var(--ped-bg);
  color: var(--ped-text); font-size: 11px; font-weight: 600; padding: 3px 6px; cursor: pointer;
}
.ped-tb-right { margin-left: auto; display: flex; align-items: center; gap: 6px; }
.ped-btn-ghost { background: var(--ped-bg) !important; border-color: var(--ped-border) !important; color: var(--ped-text) !important; }
.ped-btn-primary { background: #f97316 !important; border-color: #f97316 !important; color: white !important; }
.ped-btn-primary:hover { background: #ea580c !important; }
.ped-btn-manage { color: var(--ped-accent) !important; background: var(--ped-active-bg) !important; border-color: var(--ped-active-border) !important; font-weight: 700 !important; }
.ped-btn-manage:hover { background: var(--ped-accent) !important; color: white !important; }

/* Dropdown */
.ped-dropdown-wrap { position: relative; }
.ped-caret { width: 8px; height: 5px; flex-shrink: 0; }
.ped-dropdown {
  position: absolute; top: calc(100% + 4px); left: 0; z-index: 100;
  background: var(--ped-surface); border: 1px solid var(--ped-border); border-radius: 10px;
  box-shadow: var(--ped-shadow-md); padding: 4px; min-width: 130px; display: none;
}
.ped-dropdown.open { display: block; }
.ped-dd-item {
  display: flex; align-items: center; gap: 8px; width: 100%; padding: 7px 10px;
  border-radius: 7px; border: none; background: transparent; color: var(--ped-text);
  font-size: 12px; font-weight: 600; cursor: pointer; text-align: left;
}
.ped-dd-item:hover { background: var(--ped-active-bg); color: var(--ped-accent); }
.ped-dd-item svg { width: 16px; height: 16px; flex-shrink: 0; }

/* CONTEXT TOOLBAR */
.ped-ctx-toolbar {
  display: flex; align-items: center; gap: 6px; padding: 6px 16px;
  background: var(--ped-surface); border-bottom: 1px solid var(--ped-border); flex-shrink: 0;
}
.ped-ctx-toolbar select {
  border: 1px solid var(--ped-border); border-radius: 7px; background: var(--ped-bg);
  color: var(--ped-text); font-size: 12px; font-weight: 600; padding: 4px 8px; cursor: pointer;
}
.ped-ctx-btn {
  padding: 4px 10px; border-radius: 7px; border: 1px solid var(--ped-border);
  background: transparent; color: var(--ped-text); cursor: pointer; font-size: 13px;
  font-weight: 700; transition: all .15s; display: inline-flex; align-items: center; justify-content: center;
}
.ped-ctx-btn:hover, .ped-ctx-btn.active { background: var(--ped-active-bg); border-color: var(--ped-accent); color: var(--ped-accent); }
.ped-ctx-sep { width: 1px; height: 22px; background: var(--ped-border); margin: 0 2px; }

/* PEN TRAY (DRAW CONTEXT TOOLBAR) */
.ped-pen-tray {
  background: var(--ped-surface);
  border-bottom: 1px solid var(--ped-border);
  flex-wrap: wrap;
  gap: 8px;
}
.ped-pen-types, .ped-pen-widths, .ped-pen-colors {
  display: flex; align-items: center; gap: 4px;
}
.ped-pen-type-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 10px; border-radius: 7px; border: 1px solid var(--ped-border);
  background: var(--ped-bg); color: var(--ped-text); cursor: pointer;
  font-size: 11px; font-weight: 700; transition: all .15s;
}
.ped-pen-type-btn:hover { background: var(--ped-active-bg); border-color: var(--ped-accent); color: var(--ped-accent); }
.ped-pen-type-btn.active { background: var(--ped-accent); border-color: var(--ped-accent); color: #ffffff; }
.ped-pwidth-btn {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 8px; border-radius: 6px; border: 1px solid var(--ped-border);
  background: var(--ped-bg); color: var(--ped-text); cursor: pointer;
  font-size: 11px; font-weight: 600; transition: all .15s;
}
.ped-pwidth-btn:hover { border-color: var(--ped-accent); }
.ped-pwidth-btn.active { background: var(--ped-active-bg); border-color: var(--ped-accent); color: var(--ped-accent); font-weight: 800; }
.ped-pwidth-btn span { background: currentColor; border-radius: 50%; display: inline-block; }
.ped-pcolor-btn {
  width: 20px; height: 20px; border-radius: 50%; border: 2px solid transparent;
  cursor: pointer; transition: transform .15s;
}
.ped-pcolor-btn:hover { transform: scale(1.15); }
.ped-pcolor-btn.active { border-color: white; box-shadow: 0 0 0 2px var(--ped-accent); }

/* SHAPE ANNOTATION */
.shape-annotation {
  position: absolute; cursor: move; pointer-events: all;
  box-sizing: border-box; outline: 1.5px dashed transparent;
  transition: outline 0.15s;
}
.shape-annotation:hover {
  outline: 1.5px dashed rgba(59, 130, 246, 0.6);
}
.shape-annotation.selected {
  outline: 1.5px solid #3b82f6 !important;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.25);
  z-index: 10;
}
.shape-svg-wrap {
  width: 100%; height: 100%; pointer-events: none;
}

/* EDITOR BODY */
.ped-editor-body {
  flex: 1; display: flex; overflow: hidden; min-height: 0;
}

/* THUMBNAILS */
.ped-thumb-panel {
  width: 140px; flex-shrink: 0; background: var(--ped-thumb-bg);
  border-right: 1px solid var(--ped-border); overflow-y: auto; padding: 10px 8px;
  display: flex; flex-direction: column; gap: 8px;
}
.ped-thumb-panel.collapsed { width: 0; padding: 0; overflow: hidden; }
.ped-thumb-list { display: flex; flex-direction: column; gap: 8px; }
.ped-thumb-item {
  position: relative; border-radius: 8px; overflow: hidden;
  border: 2px solid var(--ped-border); cursor: pointer; transition: border-color .15s;
  background: white;
}
.ped-thumb-item:hover { border-color: var(--ped-accent); }
.ped-thumb-item.active { border-color: var(--ped-accent); box-shadow: 0 0 0 2px var(--ped-accent); }
