    </div>
    <div id="stab-image" class="ped-mtab-body ped-hidden">
      <label class="ped-sign-img-upload">
        <input type="file" id="sign-img-input" accept="image/*" class="ped-hidden" />
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        Click to upload signature image
      </label>
      <img id="sign-img-preview" class="ped-hidden" alt="signature preview" style="max-height:120px;margin:10px auto 0;display:block;" />
    </div>
    <div class="ped-modal-footer">
