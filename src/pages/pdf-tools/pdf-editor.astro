---
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';
import '../../styles/global.css';

const pageTitle = `PDF Editor — Free Online PDF Editor Tool`;
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-editor/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content="Free online PDF editor. Add text, edit existing text, draw shapes, highlight, sign, and manage pages in your browser." />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>
    (function(){try{const t=localStorage.getItem('calculator-theme')||((window.matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light');document.documentElement.setAttribute('data-theme',t);document.documentElement.classList.toggle('dark',t==='dark');}catch(e){}})();
  </script>
</head>
<body class="pdf-editor-body">
<!-- ===== UPLOAD PAGE ===== -->
<div id="upload-page" class="ped-upload-page">
  <div class="ped-upload-header">
    <a href="/pdf-tools/" class="ped-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      PDF Tools
    </a>
    <span class="ped-upload-title">PDF Editor</span>
    <span class="ped-upload-badge">100% Private — In-Browser</span>
  </div>

  <div class="ped-upload-body">
    <input type="file" id="file-input" accept="application/pdf" class="ped-hidden" />
    <div id="drop-zone" class="ped-dropzone">
      <div class="ped-dropzone-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m6.75 12H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <h1 class="ped-dropzone-h1">Drop your PDF here to edit</h1>
      <p class="ped-dropzone-sub">or click the button below to choose a file</p>
      <label for="file-input" class="ped-dropzone-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        Select PDF File
      </label>
      <div class="ped-feature-badges">
        <span>✏️ Add &amp; Edit Text</span>
        <span>🖊 Draw &amp; Shapes</span>
        <span>🖍 Highlight</span>
        <span>🖼 Insert Image</span>
        <span>✍️ Sign PDF</span>
        <span>📑 Manage Pages</span>
      </div>
    </div>
  </div>
</div>

<!-- ===== EDITOR UI ===== -->
<div id="editor-page" class="ped-editor-page ped-hidden">

  <!-- TOP TOOLBAR -->
  <div class="ped-toolbar" id="main-toolbar">
    <!-- Group: File / History -->
    <div class="ped-tb-group">
      <button id="tb-thumbs" class="ped-tb-btn ped-tb-active" title="Toggle Thumbnails">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span>Thumbnails</span>
      </button>
      <button id="tb-undo" class="ped-tb-btn" title="Undo" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
        <span>Undo</span>
      </button>
      <button id="tb-redo" class="ped-tb-btn" title="Redo" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l6-6m0 0l-6-6m6 6H9a6 6 0 000 12h3"/></svg>
        <span>Redo</span>
      </button>
    </div>

    <div class="ped-tb-sep"></div>

    <!-- Group: Text Tools -->
    <div class="ped-tb-group">
      <button data-tool="text" class="ped-tb-btn ped-tool-btn" title="Add Text (Click anywhere on page to place)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
        <span>Add text</span>
      </button>
      <button data-tool="text-edit" class="ped-tb-btn ped-tool-btn" title="Edit Existing Text in PDF">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        <span>Edit text</span>
      </button>
      <button data-tool="sign" class="ped-tb-btn ped-tool-btn" title="Add Signature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
        <span>Sign</span>
      </button>
    </div>

    <div class="ped-tb-sep"></div>

    <!-- Group: Draw & Shape Tools -->
    <div class="ped-tb-group">
      <button data-tool="draw" class="ped-tb-btn ped-tool-btn" title="Freehand Draw">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
        <span>Draw</span>
      </button>
      <!-- Line / Shape dropdown -->
      <div class="ped-dropdown-wrap">
        <button data-tool="line" class="ped-tb-btn ped-tool-btn ped-dropdown-trigger" title="Line / Shape">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="19" x2="19" y2="5" stroke-linecap="round"/></svg>
          <span id="shape-btn-label">Line</span>
          <svg class="ped-caret" viewBox="0 0 10 6" fill="currentColor"><path d="M0 0l5 6 5-6z"/></svg>
        </button>
        <div class="ped-dropdown" id="line-dropdown">
          <button data-shape="line" class="ped-dd-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="19" x2="19" y2="5" stroke-linecap="round"/></svg> Line
          </button>
          <button data-shape="arrow" class="ped-dd-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg> Arrow
          </button>
          <button data-shape="rect" class="ped-dd-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="16" height="16" rx="2"/></svg> Box
          </button>
          <button data-shape="circle" class="ped-dd-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg> Circle
          </button>
        </div>
      </div>
      <button data-tool="highlight" class="ped-tb-btn ped-tool-btn" title="Text Highlight">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        <span>Highlight</span>
      </button>
      <button data-tool="image" class="ped-tb-btn ped-tool-btn" title="Insert Image (Click anywhere on page to place)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span>Image</span>
      </button>
      <button id="btn-rotate" class="ped-tb-btn" title="Rotate Page 90°">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        <span>Rotate</span>
      </button>
      <button data-tool="eraser" class="ped-tb-btn ped-tool-btn" title="Eraser (Erase lines, shapes, and items)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span>Eraser</span>
      </button>
    </div>

    <div class="ped-tb-sep"></div>

    <!-- Group: Style controls (Color, Width, Fill) -->
    <div class="ped-tb-group ped-tb-style-group" id="style-group">
      <label class="ped-style-label" title="Stroke / Line Color">
        <span>Color</span>
        <input type="color" id="ann-color" value="#e53e3e" />
      </label>
      <label class="ped-style-label" title="Line Thickness">
        <span>Width</span>
        <select id="ann-width">
          <option value="1">1px</option>
          <option value="2" selected>2px</option>
          <option value="4">4px</option>
          <option value="6">6px</option>
          <option value="10">10px</option>
        </select>
      </label>
      <label class="ped-style-label" title="Enable Fill for Shapes">
        <input type="checkbox" id="ann-fill-enable" />
        <span>Fill</span>
      </label>
      <label class="ped-style-label" id="ann-fill-wrap" style="opacity:0.5;" title="Fill Color">
        <input type="color" id="ann-fill-color" value="#93c5fd" />
      </label>
    </div>

    <!-- Right side: Manage Pages, Open, Download -->
    <div class="ped-tb-right">
      <button id="tb-manage-pages" class="ped-tb-btn ped-btn-manage" title="Manage Pages (Reorder, Delete, Rotate, Add)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="9" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span>Manage pages</span>
      </button>
      <label for="file-input-editor" class="ped-tb-btn ped-btn-ghost" title="Open another PDF">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        <span>Open</span>
      </label>
      <input type="file" id="file-input-editor" accept="application/pdf" class="ped-hidden" />
      <input type="file" id="img-file-input" accept="image/*" class="ped-hidden" />
      <button id="tb-download" class="ped-tb-btn ped-btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Download
      </button>
    </div>
  </div>

  <!-- TEXT CONTEXT TOOLBAR (shown when text tool or text annotation selected) -->
  <div id="text-ctx-toolbar" class="ped-ctx-toolbar ped-hidden">
    <select id="ctx-font-family" title="Font Family">
      <option value="Arial">Arial</option>
      <option value="Helvetica">Helvetica</option>
      <option value="Times New Roman">Times New Roman</option>
      <option value="Courier New">Courier New</option>
      <option value="Georgia">Georgia</option>
      <option value="Verdana">Verdana</option>
    </select>
    <select id="ctx-font-size" title="Font Size">
      <option value="10">10px</option><option value="12">12px</option><option value="14">14px</option>
      <option value="16">16px</option><option value="18" selected>18px</option><option value="20">20px</option>
      <option value="24">24px</option><option value="28">28px</option><option value="32">32px</option>
      <option value="36">36px</option><option value="48">48px</option>
    </select>
    <button id="ctx-bold" class="ped-ctx-btn" title="Bold"><b>B</b></button>
    <button id="ctx-italic" class="ped-ctx-btn" title="Italic"><i>I</i></button>
    <div class="ped-ctx-sep"></div>
    <button data-align="left" class="ped-ctx-btn align-btn" title="Align Left">
      <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M3 5h18v2H3V5zm0 4h12v2H3V9zm0 4h18v2H3v-2zm0 4h12v2H3v-2z"/></svg>
    </button>
    <button data-align="center" class="ped-ctx-btn align-btn" title="Center">
      <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M3 5h18v2H3V5zm3 4h12v2H6V9zm-3 4h18v2H3v-2zm3 4h12v2H6v-2z"/></svg>
    </button>
    <button data-align="right" class="ped-ctx-btn align-btn" title="Align Right">
      <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M3 5h18v2H3V5zm6 4h12v2H9V9zm-6 4h18v2H3v-2zm6 4h12v2H9v-2z"/></svg>
    </button>
    <div class="ped-ctx-sep"></div>
    <label style="display:flex;align-items:center;gap:4px;font-size:11px;color:var(--ped-muted);cursor:pointer;">
      Color <input type="color" id="ctx-color" value="#000000" style="width:24px;height:24px;border-radius:4px;border:1px solid var(--ped-border);cursor:pointer;" />
    </label>
    <button id="ctx-delete-btn" class="ped-ctx-btn" title="Delete Selected Text Box" style="color:#ef4444;margin-left:4px;">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    </button>
    <span id="text-ctx-hint" style="font-size:11px;color:var(--ped-muted);margin-left:auto;">Click anywhere to place</span>
  </div>

  <!-- DRAW CONTEXT TOOLBAR / PEN TRAY (shown when Draw tool is active) -->
  <div id="draw-ctx-toolbar" class="ped-ctx-toolbar ped-pen-tray ped-hidden">
    <div class="ped-pen-types">
      <button type="button" data-pen="pen" class="ped-pen-type-btn active" title="Ballpoint Pen (Solid, crisp line)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/></svg>
        <span>Pen</span>
      </button>
      <button type="button" data-pen="brush" class="ped-pen-type-btn" title="Brush / Calligraphy (Smooth artistic stroke)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.375 2.625a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.375-9.375z"/><path d="M9 18c-3 0-5 2-5 3s2 1 4 1 3-2 3-4"/></svg>
        <span>Brush</span>
      </button>
      <button type="button" data-pen="marker" class="ped-pen-type-btn" title="Felt Marker (Thick, rounded marker)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/></svg>
        <span>Marker</span>
      </button>
      <button type="button" data-pen="highlighter" class="ped-pen-type-btn" title="Highlighter (Semi-transparent accent)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l-6 6v3h3l6-6"/><path d="M22 2l-7 7-4-4 7-7 4 4z"/></svg>
        <span>Highlighter</span>
      </button>
    </div>

    <div class="ped-ctx-sep"></div>

    <div class="ped-pen-widths">
      <span style="font-size:11px;font-weight:700;color:var(--ped-muted);">Size:</span>
      <button type="button" data-pwidth="1" class="ped-pwidth-btn" title="Fine (1px)"><span style="width:3px;height:3px;"></span>1px</button>
      <button type="button" data-pwidth="2" class="ped-pwidth-btn active" title="Normal (2px)"><span style="width:5px;height:5px;"></span>2px</button>
      <button type="button" data-pwidth="4" class="ped-pwidth-btn" title="Medium (4px)"><span style="width:8px;height:8px;"></span>4px</button>
      <button type="button" data-pwidth="8" class="ped-pwidth-btn" title="Bold (8px)"><span style="width:11px;height:11px;"></span>8px</button>
      <button type="button" data-pwidth="16" class="ped-pwidth-btn" title="Thick (16px)"><span style="width:15px;height:15px;"></span>16px</button>
    </div>

    <div class="ped-ctx-sep"></div>

    <div class="ped-pen-colors">
      <button type="button" data-pcolor="#000000" class="ped-pcolor-btn active" style="background:#000000;" title="Black"></button>
      <button type="button" data-pcolor="#1d4ed8" class="ped-pcolor-btn" style="background:#1d4ed8;" title="Royal Blue"></button>
      <button type="button" data-pcolor="#dc2626" class="ped-pcolor-btn" style="background:#dc2626;" title="Red"></button>
      <button type="button" data-pcolor="#16a34a" class="ped-pcolor-btn" style="background:#16a34a;" title="Green"></button>
      <button type="button" data-pcolor="#ea580c" class="ped-pcolor-btn" style="background:#ea580c;" title="Orange"></button>
      <button type="button" data-pcolor="#9333ea" class="ped-pcolor-btn" style="background:#9333ea;" title="Purple"></button>
      <button type="button" data-pcolor="#eab308" class="ped-pcolor-btn" style="background:#eab308;" title="Yellow"></button>
      <label title="Custom Color" style="cursor:pointer;display:inline-flex;align-items:center;">
        <input type="color" id="draw-custom-color" value="#000000" style="width:22px;height:22px;border:none;border-radius:50%;cursor:pointer;padding:0;background:transparent;" />
      </label>
    </div>

    <span style="font-size:11px;color:var(--ped-muted);margin-left:auto;">Draw freehand on page</span>
  </div>

  <!-- SHAPE CONTEXT TOOLBAR (shown when Shape is selected or drawn) -->
  <div id="shape-ctx-toolbar" class="ped-ctx-toolbar ped-hidden">
    <label style="display:flex;align-items:center;gap:4px;font-size:12px;font-weight:600;color:var(--ped-text);cursor:pointer;">
      <span>Color</span>
      <input type="color" id="shape-ctx-color" value="#e53e3e" style="width:24px;height:24px;border-radius:4px;border:1px solid var(--ped-border);cursor:pointer;" />
    </label>

    <div class="ped-ctx-sep"></div>

    <label style="display:flex;align-items:center;gap:4px;font-size:12px;font-weight:600;color:var(--ped-text);">
      <span>Width</span>
      <select id="shape-ctx-width" style="border:1px solid var(--ped-border);border-radius:6px;padding:3px 6px;background:var(--ped-bg);color:var(--ped-text);font-size:12px;cursor:pointer;">
        <option value="1">1px</option>
        <option value="2" selected>2px</option>
        <option value="4">4px</option>
        <option value="6">6px</option>
        <option value="10">10px</option>
      </select>
    </label>

    <div class="ped-ctx-sep"></div>

    <label style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--ped-text);cursor:pointer;">
      <input type="checkbox" id="shape-ctx-fill-enable" style="cursor:pointer;" />
      <span>Fill</span>
    </label>
    <label id="shape-ctx-fill-wrap" style="display:flex;align-items:center;cursor:pointer;opacity:0.5;">
      <input type="color" id="shape-ctx-fill-color" value="#93c5fd" style="width:24px;height:24px;border-radius:4px;border:1px solid var(--ped-border);cursor:pointer;" />
    </label>

    <div class="ped-ctx-sep"></div>

    <button id="shape-ctx-delete-btn" class="ped-ctx-btn" title="Delete Selected Shape" style="color:#ef4444;gap:4px;">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      <span>Delete</span>
    </button>
    <span style="font-size:11px;color:var(--ped-muted);margin-left:auto;">Drag to move • Corner dots to resize • Change style above</span>
  </div>

  <!-- EDITOR BODY -->
  <div class="ped-editor-body">

    <!-- LEFT: Thumbnails -->
    <div id="thumb-panel" class="ped-thumb-panel">
      <div id="thumb-list" class="ped-thumb-list"></div>
    </div>

    <!-- CENTER: Canvas viewport -->
    <div id="canvas-viewport" class="ped-canvas-viewport">
      <div id="page-wrapper" class="ped-page-wrapper">
        <canvas id="pdf-canvas"></canvas>
        <canvas id="ann-canvas" style="position:absolute;top:0;left:0;"></canvas>
        <!-- Overlay for draggable text/image annotations and existing PDF text layer -->
        <div id="ann-overlay" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;"></div>
      </div>
    </div>

  </div>

  <!-- BOTTOM PAGE NAV BAR -->
  <div class="ped-bottom-bar">
    <button id="nav-first" class="ped-nav-btn" title="First page">⏮</button>
    <button id="nav-prev" class="ped-nav-btn" title="Previous page">◀</button>

