      ctx.beginPath(); ctx.moveTo(a.x1, a.y1); ctx.lineTo(a.x2, a.y2); ctx.stroke();
    } else if (a.shape === 'arrow') {
      drawArrow(ctx, a.x1, a.y1, a.x2, a.y2, a.color, a.width);
    } else if (a.shape === 'rect') {
      if (a.fill) {
        ctx.fillStyle = a.fillColor || 'rgba(59, 130, 246, 0.3)';
        ctx.fillRect(a.x1, a.y1, a.x2 - a.x1, a.y2 - a.y1);
      }
      ctx.strokeRect(a.x1, a.y1, a.x2 - a.x1, a.y2 - a.y1);
    } else if (a.shape === 'circle') {
      var rx = Math.max(1, Math.abs(a.x2 - a.x1) / 2), ry = Math.max(1, Math.abs(a.y2 - a.y1) / 2);
      ctx.beginPath();
      ctx.ellipse((a.x1 + a.x2) / 2, (a.y1 + a.y2) / 2, rx, ry, 0, 0, Math.PI * 2);
      if (a.fill) {
        ctx.fillStyle = a.fillColor || 'rgba(59, 130, 246, 0.3)';
        ctx.fill();
      }
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawArrow(ctx, x1, y1, x2, y2, color, width) {
    ctx.save(); ctx.strokeStyle = ctx.fillStyle = color || '#e53e3e'; ctx.lineWidth = width || 2;
    var angle = Math.atan2(y2 - y1, x2 - x1), hl = Math.max(12, (width || 2) * 4);
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - hl * Math.cos(angle - Math.PI / 6), y2 - hl * Math.sin(angle - Math.PI / 6));
    ctx.lineTo(x2 - hl * Math.cos(angle + Math.PI / 6), y2 - hl * Math.sin(angle + Math.PI / 6));
    ctx.closePath(); ctx.fill(); ctx.restore();
  }

  function drawHL(ctx, a) {
    ctx.save(); ctx.globalAlpha = 0.3; ctx.fillStyle = a.color || '#ffd700';
    ctx.fillRect(a.x1, a.y1, a.x2 - a.x1, a.y2 - a.y1);
    ctx.globalAlpha = 1; ctx.restore();
  }

  function previewShape(ctx, x1, y1, x2, y2) {
    var color = $('ann-color').value, width = parseInt($('ann-width').value) || 2;
    var fill = $('ann-fill-enable').checked, fillColor = $('ann-fill-color').value;
    ctx.save(); ctx.strokeStyle = color; ctx.lineWidth = width; ctx.lineCap = 'round';
    var s = state.activeShape;
    if (s === 'line') { ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); }
    else if (s === 'arrow') drawArrow(ctx, x1, y1, x2, y2, color, width);
    else if (s === 'rect') {
      if (fill) { ctx.fillStyle = fillColor; ctx.fillRect(x1, y1, x2 - x1, y2 - y1); }
      ctx.strokeRect(x1, y1, x2 - x1, y2 - y1);
    } else if (s === 'circle') {
      var rx = Math.max(1, Math.abs(x2 - x1) / 2), ry = Math.max(1, Math.abs(y2 - y1) / 2);
      ctx.beginPath(); ctx.ellipse((x1 + x2) / 2, (y1 + y2) / 2, rx, ry, 0, 0, Math.PI * 2);
      if (fill) { ctx.fillStyle = fillColor; ctx.fill(); }
      ctx.stroke();
    }
    ctx.restore();
  }

  // ── RESIZE HANDLES BUILDER (8 DOTS LIKE PDF HOUSE) ───────────
  function attachResizeDots(el, a, onResize) {
    var dirs = ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'];
    dirs.forEach(function(dir) {
      var dot = document.createElement('div');
      dot.className = 'resize-dot ' + dir;
      el.appendChild(dot);

      dot.addEventListener('mousedown', function(e) {
        e.preventDefault(); e.stopPropagation();
        var startX = e.clientX, startY = e.clientY;
        var origX = a.x, origY = a.y, origW = a.w || el.offsetWidth, origH = a.h || el.offsetHeight;

        function onMv(ev) {
          var dx = ev.clientX - startX, dy = ev.clientY - startY;
          var nw = origW, nh = origH, nx = origX, ny = origY;

          if (dir.includes('e')) nw = Math.max(30, origW + dx);
          if (dir.includes('s')) nh = Math.max(16, origH + dy);
          if (dir.includes('w')) {
            var diff = Math.min(dx, origW - 30);
            nx = origX + diff; nw = origW - diff;
          }
          if (dir.includes('n')) {
            var diffY = Math.min(dy, origH - 16);
            ny = origY + diffY; nh = origH - diffY;
          }

          a.x = Math.round(nx); a.y = Math.round(ny);
          a.w = Math.round(nw); a.h = Math.round(nh);
          el.style.left = a.x + 'px'; el.style.top = a.y + 'px';
          el.style.width = a.w + 'px'; el.style.height = a.h + 'px';
          if (onResize) onResize(a);
        }

        function onUp() {
          document.removeEventListener('mousemove', onMv);
          document.removeEventListener('mouseup', onUp);
          pushUndoSnapshot();
        }
        document.addEventListener('mousemove', onMv);
        document.addEventListener('mouseup', onUp);
      });
    });
  }

  // ── DRAG MOVE HANDLER (SMOOTH & DOES NOT BLOCK CLICKS) ─────────
  function attachDragMove(el, a, handleEl) {
    var target = handleEl || el;

    target.addEventListener('mousedown', function(e) {
      if (e.target.classList.contains('resize-dot')) return;
      if (el.classList.contains('editing')) return; // Allow natural text editing and selection

      e.stopPropagation();
      selectElement(el, a);

      var startX = e.clientX, startY = e.clientY;
      var origX = a.x, origY = a.y;
      var hasMoved = false;

      function onMv(ev) {
        var dx = ev.clientX - startX, dy = ev.clientY - startY;
        if (!hasMoved) {
          if (Math.hypot(dx, dy) < 4) return;
          hasMoved = true;
        }
        ev.preventDefault();
        a.x = Math.max(0, Math.round(origX + dx));
        a.y = Math.max(0, Math.round(origY + dy));
        el.style.left = a.x + 'px';
        el.style.top = a.y + 'px';
      }

      function onUp() {
        document.removeEventListener('mousemove', onMv);
        document.removeEventListener('mouseup', onUp);
        if (hasMoved) pushUndoSnapshot();
      }

      document.addEventListener('mousemove', onMv);
      document.addEventListener('mouseup', onUp);
    });

    target.addEventListener('dblclick', function(e) {
      if (a.type === 'text' || a.type === 'edit-text') {
        e.stopPropagation();
        e.preventDefault();
        startTextEditing(el, a);
      }
    });
  }

  function selectAllTextInContent(content) {
    if (!content) return;
    try {
      var range = document.createRange();
      range.selectNodeContents(content);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    } catch (err) {}
  }

  function startTextEditing(el, a) {
    selectElement(el, a);
    el.classList.add('editing');
    var content = el.querySelector('.text-content') || el.querySelector('.ped-et-content');
    if (content) {
      content.contentEditable = 'true';
      content.focus();
      selectAllTextInContent(content);
    }
    setStatus('Editing text... Type your text. Click outside or press Esc when done.');
  }

  function deselectAll() {
    if (state.selectedEl) {
      state.selectedEl.classList.remove('selected', 'editing', 'active');
      var content = state.selectedEl.querySelector('.text-content') || state.selectedEl.querySelector('.ped-et-content');
      if (content) content.contentEditable = 'false';
      state.selectedEl = null;
      state.selectedAnn = null;
    }
    if (!state.activeTool || (state.activeTool !== 'text' && state.activeTool !== 'text-edit')) {
      textCtxToolbar.classList.add('ped-hidden');
    }
    if (state.activeTool !== 'draw') {
      drawCtxToolbar.classList.add('ped-hidden');
    }
    if (state.activeTool !== 'line') {
      shapeCtxToolbar.classList.add('ped-hidden');
    }
  }

  function selectElement(el, a) {
    deselectAll();
    state.selectedEl = el;
    state.selectedAnn = a;
    el.classList.add('selected');

    if (a.type === 'text' || a.type === 'edit-text') {
      textCtxToolbar.classList.remove('ped-hidden');
      drawCtxToolbar.classList.add('ped-hidden');
      shapeCtxToolbar.classList.add('ped-hidden');

      if (a.fontFamily) {
        var fOpt = $('ctx-font-family').querySelector('option[value="' + a.fontFamily + '"]');
        if (fOpt) {
          $('ctx-font-family').value = a.fontFamily;
        } else {
          var newFOpt = document.createElement('option');
          newFOpt.value = a.fontFamily;
          newFOpt.textContent = a.fontFamily;
          $('ctx-font-family').appendChild(newFOpt);
          $('ctx-font-family').value = a.fontFamily;
        }
      }

      var fsVal = String(a.fontSize || 18);
      var opt = $('ctx-font-size').querySelector('option[value="' + fsVal + '"]');
      if (!opt) {
        var newOpt = document.createElement('option');
        newOpt.value = fsVal;
        newOpt.textContent = fsVal + 'px';
        $('ctx-font-size').appendChild(newOpt);
      }
      $('ctx-font-size').value = fsVal;

      $('ctx-color').value = a.color || '#000000';
      state.bold = !!a.bold; $('ctx-bold').classList.toggle('active', state.bold);
      state.italic = !!a.italic; $('ctx-italic').classList.toggle('active', state.italic);
      state.textAlign = a.align || 'left';
      document.querySelectorAll('.align-btn').forEach(function(b) {
        b.classList.toggle('active', b.dataset.align === state.textAlign);
      });
      $('text-ctx-hint').textContent = 'Double-click to edit text';
    } else if (a.type === 'shape') {
      shapeCtxToolbar.classList.remove('ped-hidden');
      textCtxToolbar.classList.add('ped-hidden');
      drawCtxToolbar.classList.add('ped-hidden');
      $('shape-ctx-color').value = a.color || '#e53e3e';
      $('shape-ctx-width').value = String(a.width || 2);
      $('shape-ctx-fill-enable').checked = !!a.fill;
      $('shape-ctx-fill-color').value = a.fillColor || '#93c5fd';
      $('shape-ctx-fill-wrap').style.opacity = a.fill ? '1' : '0.5';

      // Also sync main toolbar controls
      $('ann-color').value = a.color || '#e53e3e';
      $('ann-width').value = String(a.width || 2);
      $('ann-fill-enable').checked = !!a.fill;
      $('ann-fill-color').value = a.fillColor || '#93c5fd';
      $('ann-fill-wrap').style.opacity = a.fill ? '1' : '0.5';
      setStatus('Shape selected. Drag to move, dots to resize, adjust color & fill above.');
    }
  }

  // ── SHAPE RENDERING (UNLOCKED, SELECTABLE, RESIZABLE, STYLABLE) ───
  function renderShapeSvg(svgWrap, a) {
    var w = Math.max(8, a.w || 20);
    var h = Math.max(8, a.h || 20);
    var sw = a.width || 2;
    var stroke = a.color || '#e53e3e';
    var fill = a.fill ? (a.fillColor || '#93c5fd') : 'transparent';
    var half = sw / 2;

    var html = '';
    if (a.shape === 'rect') {
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<rect x="' + half + '" y="' + half + '" width="' + Math.max(1, w - sw) + '" height="' + Math.max(1, h - sw) + '" rx="3" ' +
        'fill="' + fill + '" stroke="' + stroke + '" stroke-width="' + sw + '" />' +
        '</svg>';
    } else if (a.shape === 'circle') {
      var rx = Math.max(1, (w - sw) / 2);
      var ry = Math.max(1, (h - sw) / 2);
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<ellipse cx="' + (w / 2) + '" cy="' + (h / 2) + '" rx="' + rx + '" ry="' + ry + '" ' +
        'fill="' + fill + '" stroke="' + stroke + '" stroke-width="' + sw + '" />' +
        '</svg>';
    } else if (a.shape === 'line') {
      var lx1 = (a.x2 >= a.x1) ? half : (w - half);
      var ly1 = (a.y2 >= a.y1) ? half : (h - half);
      var lx2 = (a.x2 >= a.x1) ? (w - half) : half;
      var ly2 = (a.y2 >= a.y1) ? (h - half) : half;
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<line x1="' + lx1 + '" y1="' + ly1 + '" x2="' + lx2 + '" y2="' + ly2 + '" ' +
        'stroke="' + stroke + '" stroke-width="' + sw + '" stroke-linecap="round" />' +
        '</svg>';
    } else if (a.shape === 'arrow') {
      var lx1 = (a.x2 >= a.x1) ? half : (w - half);
      var ly1 = (a.y2 >= a.y1) ? half : (h - half);
      var lx2 = (a.x2 >= a.x1) ? (w - half) : half;
      var ly2 = (a.y2 >= a.y1) ? (h - half) : half;
      var angle = Math.atan2(ly2 - ly1, lx2 - lx1);
      var hl = Math.max(12, sw * 4);
      var p1x = lx2 - hl * Math.cos(angle - Math.PI / 6);
      var p1y = ly2 - hl * Math.sin(angle - Math.PI / 6);
      var p2x = lx2 - hl * Math.cos(angle + Math.PI / 6);
      var p2y = ly2 - hl * Math.sin(angle + Math.PI / 6);
      html = '<svg width="100%" height="100%" viewBox="0 0 ' + w + ' ' + h + '" style="overflow:visible;display:block;">' +
        '<line x1="' + lx1 + '" y1="' + ly1 + '" x2="' + lx2 + '" y2="' + ly2 + '" stroke="' + stroke + '" stroke-width="' + sw + '" stroke-linecap="round" />' +
        '<polygon points="' + lx2 + ',' + ly2 + ' ' + p1x + ',' + p1y + ' ' + p2x + ',' + p2y + '" fill="' + stroke + '" />' +
        '</svg>';
    }
    svgWrap.innerHTML = html;
  }

  function restoreShapeEl(a) {
    var el = document.createElement('div');
    el.className = 'shape-annotation';
    el.dataset.annId = a.id;
    el.style.left = a.x + 'px';
    el.style.top = a.y + 'px';
    el.style.width = a.w + 'px';
    el.style.height = a.h + 'px';

    var svgWrap = document.createElement('div');
    svgWrap.className = 'shape-svg-wrap';
    el.appendChild(svgWrap);
    renderShapeSvg(svgWrap, a);

    attachResizeDots(el, a, function(updatedA) {
      renderShapeSvg(svgWrap, updatedA);
    });
    attachDragMove(el, a);

    el.addEventListener('click', function(e) {
      e.stopPropagation();
      selectElement(el, a);
    });

    annOverlay.appendChild(el);
    return el;
  }

  // ── ADD TEXTBOX (CLICK-TO-PLACE EXACT POSITION) ─────────────
  function createTextAnnotation(x, y) {
    var a = {
      type: 'text', id: Date.now(),
      x: x, y: y, w: 180, h: 36,
      text: '', fontFamily: $('ctx-font-family').value || 'Helvetica',
      fontSize: parseInt($('ctx-font-size').value) || 18,
      bold: state.bold, italic: state.italic, align: state.textAlign,
      color: $('ctx-color').value || '#000000'
    };
    pushAnn(a);
    var el = buildTextEl(a);
    annOverlay.appendChild(el);
    startTextEditing(el, a);
  }

  function buildTextEl(a) {
    var el = document.createElement('div');
    el.className = 'text-annotation';
    el.dataset.annId = a.id;
    el.style.left = a.x + 'px';
    el.style.top = a.y + 'px';
    el.style.width = (a.w || 180) + 'px';
    el.style.height = (a.h || 36) + 'px';

    var content = document.createElement('div');
    content.className = 'text-content';
    content.contentEditable = 'false';
    content.innerText = a.text || '';
    applyTextStyle(content, a);
    el.appendChild(content);

    attachResizeDots(el, a);
    attachDragMove(el, a);

    el.addEventListener('click', function(e) {
      e.stopPropagation();
      selectElement(el, a);
    });

    content.addEventListener('dblclick', function(e) {
      e.stopPropagation();
      selectAllTextInContent(content);
    });

    content.addEventListener('input', function() {
      a.text = content.innerText;
    });

    content.addEventListener('blur', function() {
      a.text = content.innerText;
      el.classList.remove('editing');
      content.contentEditable = 'false';
      if (!a.text.trim()) {
        deleteAnn(a.id, el);
      } else {
        pushUndoSnapshot();
      }
    });

    content.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') content.blur();
    });

    return el;
  }

  function applyTextStyle(el, a) {
    el.style.fontFamily = a.fontFamily || 'Arial';
    el.style.fontSize = (a.fontSize || 18) + 'px';
    el.style.fontWeight = a.bold ? 'bold' : 'normal';
    el.style.fontStyle = a.italic ? 'italic' : 'normal';
    el.style.textAlign = a.align || 'left';
    el.style.color = a.color || '#000000';
  }

  function restoreTextEl(a) {
    var el = buildTextEl(a);
    annOverlay.appendChild(el);
  }

  function deleteAnn(id, el) {
    var arr = state.pageAnns[state.currentPage] || [];
    state.pageAnns[state.currentPage] = arr.filter(function(x) { return x.id !== id; });
    if (el) el.remove();
    deselectAll();
    redrawAnnotations(state.currentPage);
    pushUndoSnapshot();
  }

  $('ctx-delete-btn').addEventListener('click', function() {
    if (state.selectedAnn && state.selectedEl) {
      deleteAnn(state.selectedAnn.id, state.selectedEl);
    }
  });

  $('shape-ctx-delete-btn').addEventListener('click', function() {
    if (state.selectedAnn && state.selectedEl) {
      deleteAnn(state.selectedAnn.id, state.selectedEl);
    }
  });

  // ── EDIT EXISTING PDF TEXT (PDF HOUSE STYLE) ───────────────────
  function sampleTextColor(ctx, x, y, w, h) {
    try {
      var cw = ctx.canvas.width, ch = ctx.canvas.height;
      if (!cw || !ch) return '#000000';
      var sx = Math.max(0, Math.min(cw - 1, Math.round(x)));
      var sy = Math.max(0, Math.min(ch - 1, Math.round(y)));
      var sw = Math.max(1, Math.min(cw - sx, Math.round(w)));
      var sh = Math.max(1, Math.min(ch - sy, Math.round(h)));
      if (sw <= 0 || sh <= 0) return '#000000';

      var imgData = ctx.getImageData(sx, sy, sw, sh);
      var d = imgData.data;
      var nonWhite = [];

      var step = Math.max(1, Math.floor(d.length / 2000)) * 4;
      for (var i = 0; i < d.length; i += step) {
        var r = d[i], g = d[i + 1], b = d[i + 2], a = d[i + 3];
        if (a < 50) continue;
        var lum = 0.299 * r + 0.587 * g + 0.114 * b;
        if (lum < 220) {
          nonWhite.push({ r: r, g: g, b: b, lum: lum });
        }
      }

      if (nonWhite.length === 0) return '#000000';

      nonWhite.sort(function(p1, p2) { return p1.lum - p2.lum; });
      var take = Math.max(1, Math.min(25, Math.floor(nonWhite.length * 0.4)));
      var sr = 0, sg = 0, sb = 0;
      for (var j = 0; j < take; j++) {
        sr += nonWhite[j].r;
        sg += nonWhite[j].g;
        sb += nonWhite[j].b;
      }
      var ar = Math.round(sr / take);
      var ag = Math.round(sg / take);
      var ab = Math.round(sb / take);

      function toHex(n) {
        var s = Math.max(0, Math.min(255, n)).toString(16);
        return s.length === 1 ? '0' + s : s;
      }
      return '#' + toHex(ar) + toHex(ag) + toHex(ab);
    } catch (e) {
      return '#000000';
    }
  }

  function detectFont(fontName, styleObj) {
    var raw = ((fontName || '') + ' ' + (styleObj && styleObj.fontFamily ? styleObj.fontFamily : '')).toLowerCase();
    
    var isSerif = /times|roman|georgia|cambria|garamond|serif|baskerville|palatino|minion|century|bookman/i.test(raw);
    var isMono = /courier|mono|consolas|menlo|monospace|typewriter/i.test(raw);
    var isGeorgia = /georgia/i.test(raw);
    var isVerdana = /verdana/i.test(raw);

    var family = 'Arial';
    var cssFamily = 'Arial, Helvetica, "Segoe UI", sans-serif';
    if (isGeorgia) {
      family = 'Georgia';
      cssFamily = 'Georgia, "Times New Roman", serif';
    } else if (isSerif) {
      family = 'Times New Roman';
      cssFamily = '"Times New Roman", Times, Georgia, serif';
    } else if (isMono) {
      family = 'Courier New';
      cssFamily = '"Courier New", Courier, monospace';
    } else if (isVerdana) {
      family = 'Verdana';
      cssFamily = 'Verdana, Geneva, sans-serif';
    }

    var isBold = /bold|black|heavy|700|semibold/i.test(fontName || '');
    var isItalic = /italic|oblique|slant/i.test(fontName || '');

    return {
      family: family,
      cssFamily: cssFamily,
      bold: isBold,
      italic: isItalic
    };
  }

  async function extractTextBlocks(page, vp) {
    var tc = await page.getTextContent();
    var styles = tc.styles || {};
    var rawItems = [];

    tc.items.forEach(function(item) {
      if (!item.str || !item.str.trim()) return;

      var fontInfo = detectFont(item.fontName, styles[item.fontName]);
      var tx = item.transform;
      var fontHeightPt = Math.hypot(tx[2], tx[3]) || Math.hypot(tx[0], tx[1]) || 12;
      var fontSize = Math.round(fontHeightPt * vp.scale);
      
      var pt = vp.convertToViewportPoint(tx[4], tx[5]);
      var baselineX = Math.round(pt[0]);
      var baselineY = Math.round(pt[1]);
      var w = Math.round(Math.abs(item.width * vp.scale));
      var h = Math.round(fontSize * 1.08);
      var y = Math.round(baselineY - fontSize * 0.82);

      var color = sampleTextColor(pCtx, baselineX, y, Math.max(16, w), Math.max(12, h));

      rawItems.push({
        str: item.str,
        x: baselineX,
        y: y,
        baselineX: baselineX,
        baselineY: baselineY,
        w: w,
        h: h,
        fontSize: fontSize,
        fontName: item.fontName || 'Helvetica',
        family: fontInfo.family,
        cssFamily: fontInfo.cssFamily,
        bold: fontInfo.bold,
        italic: fontInfo.italic,
        color: color
      });
    });

    // Sort top to bottom by baselineY, then left to right
    rawItems.sort(function(a, b) {
      if (Math.abs(a.baselineY - b.baselineY) > 5) return a.baselineY - b.baselineY;
      return a.x - b.x;
    });

    // Group text items on the same line into natural blocks
    var lines = [];
    rawItems.forEach(function(it) {
      var last = lines[lines.length - 1];
      var sameLine = last && Math.abs(last.baselineY - it.baselineY) <= 5;
      if (sameLine) {
        var gap = it.x - (last.x + last.w);
        if (gap >= -10 && gap < Math.max(25, it.fontSize * 1.5)) {
          var needsSpace = gap > (it.fontSize * 0.22) && !last.str.endsWith(' ') && !it.str.startsWith(' ');
          last.str += (needsSpace ? ' ' : '') + it.str;
          last.w = Math.round(Math.max(last.w, (it.x + it.w) - last.x));
          last.h = Math.max(last.h, it.h);
          last.bold = last.bold || it.bold;
          last.italic = last.italic || it.italic;
          if (it.color && it.color !== '#000000' && last.color === '#000000') {
            last.color = it.color;
          }
          return;
        }
      }
      lines.push(Object.assign({}, it));
    });

    return lines;
  }

  async function renderExistingTextLayer(p) {
    var page = await state.pdfDoc.getPage(p);
    var rotation = (state.pageRots[p] || 0) + page.rotate;
    var vp = page.getViewport({ scale: state.scale, rotation: rotation });
    var cacheKey = p + '-' + state.scale + '-' + rotation;
    if (!state.existingTextBlocks[cacheKey]) {
      state.existingTextBlocks[cacheKey] = await extractTextBlocks(page, vp);
    }
    var blocks = state.existingTextBlocks[cacheKey];

    // Remove any previous edit-layer
    var prevLayer = annOverlay.querySelector('.ped-edit-text-layer');
    if (prevLayer) prevLayer.remove();

    var layer = document.createElement('div');
    layer.className = 'ped-edit-text-layer';
    layer.style.cssText = 'position:absolute;inset:0;pointer-events:none;z-index:5;';

    blocks.forEach(function(b, idx) {
      var blockId = 'et-' + p + '-' + idx;
      var existingAnn = (state.pageAnns[p] || []).find(function(x) { return x.type === 'edit-text' && x.blockId === blockId; });
      if (existingAnn) return; // already restored as edited block

      var box = document.createElement('div');
      box.className = 'ped-existing-text-block';
      box.dataset.blockId = blockId;
      box.style.left = b.x + 'px';
      box.style.top = b.y + 'px';
      box.style.width = Math.max(24, Math.round(b.w + 8)) + 'px';
      box.style.height = Math.max(16, Math.round(b.h + 2)) + 'px';
      box.style.pointerEvents = 'all';

      // Keep text transparent initially: genuine PDF text on canvas shows cleanly without duplicates!
      var content = document.createElement('div');
      content.className = 'ped-et-content';
      content.style.fontSize = b.fontSize + 'px';
      content.style.fontFamily = b.cssFamily;
      content.style.fontWeight = b.bold ? 'bold' : 'normal';
      content.style.fontStyle = b.italic ? 'italic' : 'normal';
      content.style.color = 'transparent';
      content.contentEditable = 'false';
      content.innerText = b.str;
      box.appendChild(content);

      var annRef = {
        type: 'edit-text', blockId: blockId, id: Date.now() + idx,
        x: b.x, y: b.y, w: Math.round(b.w + 8), h: Math.round(b.h + 2),
        origX: b.x, origY: b.y, origW: Math.round(b.w + 8), origH: Math.round(b.h + 2),
        origText: b.str, text: b.str,
        fontSize: b.fontSize, fontFamily: b.family, cssFamily: b.cssFamily,
        color: b.color || '#000000', bold: b.bold, italic: b.italic, align: 'left'
      };

      attachResizeDots(box, annRef);
      attachDragMove(box, annRef);

      function activateBlock() {
        if (!box.classList.contains('active')) {
          box.classList.add('active', 'edited');
          box.style.background = '#ffffff';
          content.style.color = annRef.color || '#000000';
          content.style.fontFamily = annRef.cssFamily || 'Arial, sans-serif';
          content.style.fontSize = annRef.fontSize + 'px';
          content.style.fontWeight = annRef.bold ? 'bold' : 'normal';
          content.style.fontStyle = annRef.italic ? 'italic' : 'normal';

          // Insert opaque white mask at original location to prevent ghost original PDF text
          var mask = {
            type: 'mask',
            id: 'mask-' + blockId,
            x: b.x - 2,
            y: b.y - 1,
            w: b.w + 12,
            h: b.h + 4
          };
          if (!state.pageAnns[p]) state.pageAnns[p] = [];
          if (!state.pageAnns[p].some(function(m) { return m.id === mask.id; })) {
            state.pageAnns[p].unshift(mask);
            aCtx.save();
            aCtx.fillStyle = '#ffffff';
            aCtx.fillRect(mask.x, mask.y, mask.w, mask.h);
            aCtx.restore();
          }
          saveEditText(annRef, content.innerText);
        }
      }

      box.addEventListener('click', function(e) {
        e.stopPropagation();
        activateBlock();
        selectElement(box, annRef);
        setStatus('Text selected. Double-click to edit, drag borders to move.');
      });

      box.addEventListener('dblclick', function(e) {
        e.stopPropagation();
        activateBlock();
        startTextEditing(box, annRef);
      });

      content.addEventListener('dblclick', function(e) {
        e.stopPropagation();
        selectAllTextInContent(content);
      });

      content.addEventListener('input', function() {
        annRef.text = content.innerText;
        saveEditText(annRef, content.innerText);
      });
      content.addEventListener('blur', function() {
        annRef.text = content.innerText;
        box.classList.remove('editing');
        content.contentEditable = 'false';
        saveEditText(annRef, content.innerText);
        pushUndoSnapshot();
      });
      content.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') content.blur();
      });

      layer.appendChild(box);
    });

    annOverlay.appendChild(layer);
  }

  function saveEditText(annRef, text) {
    if (!state.pageAnns[state.currentPage]) state.pageAnns[state.currentPage] = [];
    var anns = state.pageAnns[state.currentPage];
    var existing = anns.find(function(x) { return x.blockId === annRef.blockId; });
    annRef.text = text;
    if (!existing) {
      anns.push(annRef);
    }
  }

  function restoreEditedTextEl(a) {
    var box = document.createElement('div');
    box.className = 'ped-existing-text-block active edited';
    box.dataset.blockId = a.blockId;
    box.style.left = a.x + 'px';
    box.style.top = a.y + 'px';
    box.style.width = Math.max(24, a.w) + 'px';
    box.style.height = Math.max(16, a.h) + 'px';
    box.style.background = '#ffffff';

    var content = document.createElement('div');
    content.className = 'ped-et-content';
    content.contentEditable = 'false';
    content.innerText = a.text;
    applyTextStyle(content, a);
    box.appendChild(content);

    attachResizeDots(box, a);
    attachDragMove(box, a);

    box.addEventListener('click', function(e) {
      e.stopPropagation();
      selectElement(box, a);
    });
    box.addEventListener('dblclick', function(e) {
      e.stopPropagation();
      startTextEditing(box, a);
    });
    content.addEventListener('dblclick', function(e) {
      e.stopPropagation();
      selectAllTextInContent(content);
    });
    content.addEventListener('input', function() { a.text = content.innerText; });
    content.addEventListener('blur', function() {
      a.text = content.innerText;
      box.classList.remove('editing');
      content.contentEditable = 'false';
      pushUndoSnapshot();
    });
    content.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') content.blur();
    });

    annOverlay.appendChild(box);
  }

  // ── IMAGES & SIGNATURES (CLICK TO PLACE & RESIZE) ────────────
  function createImgAnnotation(src, x, y, w, h) {
    var a = {
      type: 'image', id: Date.now(), src: src,
      x: x, y: y, w: w, h: h
    };
    pushAnn(a);
    restoreImgEl(a);
  }

  function restoreImgEl(a) {
    var wrap = document.createElement('div');
    wrap.className = 'img-annotation';
    wrap.dataset.annId = a.id;
    wrap.style.left = a.x + 'px';
    wrap.style.top = a.y + 'px';
    wrap.style.width = a.w + 'px';
    wrap.style.height = a.h + 'px';

    var img = document.createElement('img');
    img.src = a.src;
    img.draggable = false;
    wrap.appendChild(img);

    attachResizeDots(wrap, a);
    attachDragMove(wrap, a);

    wrap.addEventListener('click', function(e) {
      e.stopPropagation();
      selectElement(wrap, a);
    });

    annOverlay.appendChild(wrap);
    selectElement(wrap, a);
  }

  // ── CANVAS & PAGE INTERACTION & PLACEMENT ─────────────────
  pageWrapper.addEventListener('mousedown', function(e) {
    var tool = state.activeTool;
    if (tool === 'text') {
      if (e.target.closest('.text-annotation.editing') || e.target.closest('.ped-existing-text-block.editing')) return;
      e.preventDefault();
      e.stopPropagation();
      var pos = getOverlayPos(e);
      createTextAnnotation(pos.x, pos.y);
      setTool(null);
      return;
    }
    if (tool === 'place-image' && state.pendingImage) {
      e.preventDefault();
      e.stopPropagation();
      var pos = getOverlayPos(e);
      var pImg = state.pendingImage;
      createImgAnnotation(pImg.src, Math.round(pos.x - pImg.w / 2), Math.round(pos.y - pImg.h / 2), pImg.w, pImg.h);
      state.pendingImage = null;
      setTool(null);
      setStatus('Image placed. Drag to move, corner dots to resize.');
      return;
    }
    if (tool === 'place-sign' && state.pendingSignature) {
      e.preventDefault();
      e.stopPropagation();
      var pos = getOverlayPos(e);
      var sig = state.pendingSignature;
      var w = Math.min(220, annCanvas.width * 0.4);
      var h = Math.round(w * sig.h / sig.w);
      createImgAnnotation(sig.src, Math.round(pos.x - w / 2), Math.round(pos.y - h / 2), w, h);
      state.pendingSignature = null;
      setTool(null);
      setStatus('Signature placed. Drag to move, corner dots to resize.');
      return;
    }
  }, true);

  annCanvas.addEventListener('mousedown', function(e) {
    var tool = state.activeTool;
    var overlayPos = getOverlayPos(e);
    var canvasPos = getCanvasPos(e);

    if (!tool) {
      deselectAll();
      return;
    }
    e.preventDefault();

    // 1. Add Textbox right at clicked position
    if (tool === 'text') {
      createTextAnnotation(overlayPos.x, overlayPos.y);
      setTool(null);
      return;
    }

    // 2. Place Image right at clicked position
    if (tool === 'place-image' && state.pendingImage) {
      var pImg = state.pendingImage;
      createImgAnnotation(pImg.src, Math.round(overlayPos.x - pImg.w / 2), Math.round(overlayPos.y - pImg.h / 2), pImg.w, pImg.h);
      state.pendingImage = null;
      setTool(null);
      setStatus('Image placed. Drag to move, corner dots to resize.');
      return;
    }

    // 3. Place Signature right at clicked position
    if (tool === 'place-sign' && state.pendingSignature) {
      var sig = state.pendingSignature;
      var w = Math.min(220, annCanvas.width * 0.4);
      var h = Math.round(w * sig.h / sig.w);
      createImgAnnotation(sig.src, Math.round(overlayPos.x - w / 2), Math.round(overlayPos.y - h / 2), w, h);
      state.pendingSignature = null;
      setTool(null);
      setStatus('Signature placed. Drag to move, corner dots to resize.');
      return;
    }

    // 4. Eraser
    if (tool === 'eraser') {
      state.isErasing = true;
      eraseAt(canvasPos.x, canvasPos.y);
      return;
    }

    // 5. Draw & Line
    if (tool === 'draw') {
      state.isDrawing = true;
      state.drawStart = canvasPos;
      state.freehandPts = [canvasPos];
    } else if (tool === 'line') {
      state.isDrawing = true;
      state.drawStart = canvasPos;
      state.drawStartOverlay = overlayPos;
    }
    if (tool === 'highlight') {
      state.isDrawing = true;
      state.hlStart = canvasPos;
    }
  });

  annCanvas.addEventListener('mousemove', function(e) {
    var tool = state.activeTool;
    var canvasPos = getCanvasPos(e);

    if (tool === 'eraser' && state.isErasing) {
      eraseAt(canvasPos.x, canvasPos.y);
      return;
    }

    if (!state.isDrawing) return;

    if (tool === 'draw') {
      state.freehandPts.push(canvasPos);
      aCtx.save();
      var pType = state.drawStrokeType || 'pen';
      var pColor = state.drawPenColor || $('ann-color').value || '#000000';
      var pWidth = state.drawPenWidth || parseInt($('ann-width').value) || 2;
      var lineW = pType === 'highlighter' ? Math.max(16, pWidth * 3) : (pType === 'marker' ? pWidth * 1.5 : pWidth);

      aCtx.strokeStyle = pColor;
      aCtx.lineWidth = lineW;
      aCtx.lineCap = (pType === 'marker' || pType === 'highlighter') ? 'square' : 'round';
      aCtx.lineJoin = 'round';
      aCtx.globalAlpha = pType === 'highlighter' ? 0.35 : (pType === 'marker' ? 0.85 : 1.0);

      var pts = state.freehandPts;
      if (pts.length > 1) {
        aCtx.beginPath();
        aCtx.moveTo(pts[pts.length - 2].x, pts[pts.length - 2].y);
        aCtx.lineTo(pts[pts.length - 1].x, pts[pts.length - 1].y);
        aCtx.stroke();
      }
      aCtx.restore();
    } else if (tool === 'line') {
      redrawAnnotations(state.currentPage);
      previewShape(aCtx, state.drawStart.x, state.drawStart.y, canvasPos.x, canvasPos.y);
    } else if (tool === 'highlight') {
      redrawAnnotations(state.currentPage);
      aCtx.save();
      aCtx.globalAlpha = 0.3;
      aCtx.fillStyle = $('ann-color').value || '#ffd700';
      aCtx.fillRect(state.hlStart.x, state.hlStart.y, canvasPos.x - state.hlStart.x, canvasPos.y - state.hlStart.y);
      aCtx.globalAlpha = 1;
      aCtx.restore();
    }
  });

  window.addEventListener('mouseup', function(e) {
    state.isErasing = false;
    if (!state.isDrawing) return;
    state.isDrawing = false;
    var canvasPos = getCanvasPos(e);
    var overlayPos = getOverlayPos(e);
    var color = $('ann-color').value, width = parseInt($('ann-width').value) || 2;
    var fill = $('ann-fill-enable').checked, fillColor = $('ann-fill-color').value;
    var tool = state.activeTool;

    if (tool === 'draw') {
      var pType = state.drawStrokeType || 'pen';
      var pColor = state.drawPenColor || color || '#000000';
      var pWidth = state.drawPenWidth || width || 2;
      pushAnn({
        type: 'draw',
        shape: 'freehand',
        strokeType: pType,
        pts: [...state.freehandPts],
        color: pColor,
        width: pWidth,
        alpha: pType === 'highlighter' ? 0.35 : (pType === 'marker' ? 0.85 : 1.0)
      });
      redrawAnnotations(state.currentPage);
    } else if (tool === 'line') {
      var sOverlay = state.drawStartOverlay || overlayPos;
      var minX = Math.min(sOverlay.x, overlayPos.x);
      var minY = Math.min(sOverlay.y, overlayPos.y);
      var maxX = Math.max(sOverlay.x, overlayPos.x);
      var maxY = Math.max(sOverlay.y, overlayPos.y);
      var w = Math.max(20, maxX - minX);
      var h = Math.max(20, maxY - minY);

      var shapeAnn = {
        type: 'shape',
        shape: state.activeShape || 'rect',
        id: Date.now(),
        x: minX,
        y: minY,
        w: w,
        h: h,
        x1: sOverlay.x,
        y1: sOverlay.y,
        x2: overlayPos.x,
        y2: overlayPos.y,
        color: $('shape-ctx-color') ? $('shape-ctx-color').value : color,
        width: $('shape-ctx-width') ? (parseInt($('shape-ctx-width').value) || width) : width,
        fill: $('shape-ctx-fill-enable') ? $('shape-ctx-fill-enable').checked : fill,
        fillColor: $('shape-ctx-fill-color') ? $('shape-ctx-fill-color').value : fillColor
      };
      pushAnn(shapeAnn);
      redrawAnnotations(state.currentPage);
      var newEl = annOverlay.querySelector('.shape-annotation[data-ann-id="' + shapeAnn.id + '"]');
      if (newEl) selectElement(newEl, shapeAnn);
      setTool(null);
    } else if (tool === 'highlight') {
      pushAnn({ type: 'highlight', x1: state.hlStart.x, y1: state.hlStart.y, x2: canvasPos.x, y2: canvasPos.y, color: color });
      redrawAnnotations(state.currentPage);
    }
  });

  // ── ERASER FUNCTIONALITY (FIXED FOR THIN LINES) ─────────────
  function eraseAt(x, y) {
    var R = 28;
    var anns = state.pageAnns[state.currentPage] || [];
    var before = anns.length;

    state.pageAnns[state.currentPage] = anns.filter(function(a) {
      if (a.type === 'text' || a.type === 'edit-text') {
        return !(x >= a.x - 10 && x <= a.x + (a.w || 120) + 10 && y >= a.y - 10 && y <= a.y + (a.h || 30) + 10);
      }
      if (a.type === 'shape') {
        return !(x >= a.x - 10 && x <= a.x + a.w + 10 && y >= a.y - 10 && y <= a.y + a.h + 10);
      }
      if (a.type === 'image') {
        return !(x >= a.x - 5 && x <= a.x + a.w + 5 && y >= a.y - 5 && y <= a.y + a.h + 5);
      }
      if (a.type === 'draw' && a.shape === 'freehand') {
        if (!a.pts || a.pts.length < 2) return false;
        for (var i = 0; i < a.pts.length - 1; i++) {
          if (distToSegment(x, y, a.pts[i].x, a.pts[i].y, a.pts[i + 1].x, a.pts[i + 1].y) < R + (a.width || 2)) return false;
        }
        return true;
      }
      if (a.type === 'draw' && (a.shape === 'line' || a.shape === 'arrow')) {
        return distToSegment(x, y, a.x1, a.y1, a.x2, a.y2) > R + (a.width || 2);
      }
      if (a.type === 'draw' && a.shape === 'rect') {
        var d1 = distToSegment(x, y, a.x1, a.y1, a.x2, a.y1);
        var d2 = distToSegment(x, y, a.x2, a.y1, a.x2, a.y2);
        var d3 = distToSegment(x, y, a.x2, a.y2, a.x1, a.y2);
        var d4 = distToSegment(x, y, a.x1, a.y2, a.x1, a.y1);
        var inside = a.fill && (x >= Math.min(a.x1, a.x2) && x <= Math.max(a.x1, a.x2) && y >= Math.min(a.y1, a.y2) && y <= Math.max(a.y1, a.y2));
        return Math.min(d1, d2, d3, d4) > R && !inside;
      }
      if (a.type === 'draw' && a.shape === 'circle') {
        var cx = (a.x1 + a.x2) / 2, cy = (a.y1 + a.y2) / 2;
        var rx = Math.max(1, Math.abs(a.x2 - a.x1) / 2);
        var d = Math.abs(Math.hypot(x - cx, y - cy) - rx);
        return d > R;
      }
      if (a.type === 'highlight') {
        return !(x >= Math.min(a.x1, a.x2) - 5 && x <= Math.max(a.x1, a.x2) + 5 && y >= Math.min(a.y1, a.y2) - 5 && y <= Math.max(a.y1, a.y2) + 5);
      }
      return true;
    });

    if (state.pageAnns[state.currentPage].length !== before) {
      redrawAnnotations(state.currentPage);
      pushUndoSnapshot();
    }
  }

  // ── UNDO / REDO ──────────────────────────────────────────
  function pushAnn(a) {
    if (!state.pageAnns[state.currentPage]) state.pageAnns[state.currentPage] = [];
    state.pageAnns[state.currentPage].push(a);
    pushUndoSnapshot();
  }

  function pushUndoSnapshot() {
    state.undoStack.push({
      page: state.currentPage,
      snap: JSON.parse(JSON.stringify(state.pageAnns[state.currentPage] || []))
    });
    state.redoStack = [];
    updateUndoRedoBtns();
  }

  function updateUndoRedoBtns() {
    $('tb-undo').disabled = state.undoStack.length === 0;
    $('tb-redo').disabled = state.redoStack.length === 0;
  }

  $('tb-undo').addEventListener('click', function() {
    if (!state.undoStack.length) return;
    var e = state.undoStack.pop();
    state.redoStack.push({ page: e.page, snap: JSON.parse(JSON.stringify(state.pageAnns[e.page] || [])) });
    var prev = null;
    for (var i = state.undoStack.length - 1; i >= 0; i--) {
      if (state.undoStack[i].page === e.page) { prev = state.undoStack[i]; break; }
    }
    state.pageAnns[e.page] = prev ? JSON.parse(JSON.stringify(prev.snap)) : [];
    if (e.page === state.currentPage) redrawAnnotations(state.currentPage);
    updateUndoRedoBtns();
  });

  $('tb-redo').addEventListener('click', function() {
    if (!state.redoStack.length) return;
    var e = state.redoStack.pop();
    state.undoStack.push({ page: e.page, snap: JSON.parse(JSON.stringify(state.pageAnns[e.page] || [])) });
    state.pageAnns[e.page] = JSON.parse(JSON.stringify(e.snap));
    if (e.page === state.currentPage) redrawAnnotations(state.currentPage);
    updateUndoRedoBtns();
  });

  // ── TOOL ACTIVATION ──────────────────────────────────────
  function setTool(tool) {
    state.activeTool = tool;
    document.querySelectorAll('.ped-tool-btn').forEach(function(b) {
      b.classList.toggle('tool-active', b.dataset.tool === tool);
    });

    var cm = {
      text: 'crosshair', 'text-edit': 'default', 'place-image': 'crosshair', 'place-sign': 'crosshair',
      draw: 'crosshair', line: 'crosshair', highlight: 'text', eraser: 'cell'
    };
    annCanvas.style.cursor = cm[tool] || 'default';
    annCanvas.style.pointerEvents = 'all';

    textCtxToolbar.classList.add('ped-hidden');
    drawCtxToolbar.classList.add('ped-hidden');
    shapeCtxToolbar.classList.add('ped-hidden');

    // Remove existing edit-text layer whenever we switch away from text-edit
    if (tool !== 'text-edit') {
      var editLayer = annOverlay.querySelector('.ped-edit-text-layer');
      if (editLayer) editLayer.remove();
    }

    if (tool === 'text') {
      deselectAll();
      textCtxToolbar.classList.remove('ped-hidden');
      $('text-ctx-hint').textContent = 'Click anywhere on page to place text box';
      setStatus('Click anywhere on the PDF to place a text box');
    } else if (tool === 'text-edit') {
      textCtxToolbar.classList.remove('ped-hidden');
      $('text-ctx-hint').textContent = 'Click any outlined text box to edit';
      setStatus('Loading text blocks... Click any text box to edit');
      renderExistingTextLayer(state.currentPage);
    } else if (tool === 'draw') {
      drawCtxToolbar.classList.remove('ped-hidden');
      setStatus('Draw tool active. Choose pen stroke type, width, and color in the tray above.');
    } else if (tool === 'line') {
      shapeCtxToolbar.classList.remove('ped-hidden');
      setStatus('Shape tool active. Drag on page to draw shape, then adjust color & fill.');
    } else if (tool === 'place-image') {
      setStatus('Click anywhere on the PDF to place your image');
    } else if (tool === 'place-sign') {
      setStatus('Click anywhere on the PDF to place your signature');
    } else if (tool === 'eraser') {
      setStatus('Click or drag across lines and shapes to erase them');
      deselectAll();
    } else {
      deselectAll();
    }
  }

  document.querySelectorAll('.ped-tool-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var tool = btn.dataset.tool;
      if (tool === 'sign') { openSignModal(); return; }
      if (tool === 'image') { $('img-file-input').click(); return; }
      if (tool === 'line') {
        lineDropdown.classList.toggle('open');
        if (state.activeTool !== 'line') setTool('line');
        return;
      }
      setTool(state.activeTool === tool ? null : tool);
    });
