    </div>

    <button id="nav-next" class="ped-nav-btn" title="Next page">▶</button>
    <button id="nav-last" class="ped-nav-btn" title="Last page">⏭</button>

    <div class="ped-bottom-sep"></div>

    <button id="zoom-out-btn" class="ped-nav-btn" title="Zoom Out">−</button>
    <span id="zoom-label" class="ped-zoom-label">100%</span>
    <button id="zoom-in-btn" class="ped-nav-btn" title="Zoom In">+</button>
    <button id="zoom-fit-btn" class="ped-nav-btn" title="Fit to width">Fit</button>

    <div class="ped-bottom-sep"></div>
    <span id="status-msg" class="ped-status"></span>
  </div>

</div>

<!-- SIGN MODAL -->
