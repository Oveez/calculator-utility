  var signDrawing = false;
  var signPos = function(e) {
    var r = signCanvas.getBoundingClientRect();
    return { x: (e.clientX - r.left) * signCanvas.width / r.width, y: (e.clientY - r.top) * signCanvas.height / r.height };
  };
  signCanvas.addEventListener('mousedown', function(e) {
    signDrawing = true; var p = signPos(e); signCtx.beginPath(); signCtx.moveTo(p.x, p.y);
  });
  signCanvas.addEventListener('mousemove', function(e) {
    if (!signDrawing) return;
    var p = signPos(e);
    signCtx.lineWidth = state.signWidth || 3;
    signCtx.strokeStyle = state.signColor;
    signCtx.lineCap = signCtx.lineJoin = 'round';
    signCtx.lineTo(p.x, p.y);
    signCtx.stroke();
  });
  signCanvas.addEventListener('mouseup', function() { signDrawing = false; });
  signCanvas.addEventListener('mouseleave', function() { signDrawing = false; });

