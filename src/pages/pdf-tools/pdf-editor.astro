  display: flex; flex-direction: column; align-items: center; gap: 8px;
  cursor: pointer; position: relative; user-select: none;
}
.ped-mp-card-inner {
  position: relative; width: 100%; background: #ffffff;
  border-radius: 8px; border: 2px solid var(--ped-border); overflow: hidden;
  box-shadow: var(--ped-shadow); transition: all .15s;
}
.ped-mp-card:hover .ped-mp-card-inner { border-color: var(--ped-accent); transform: translateY(-2px); }
