  $('sign-done').addEventListener('click', function() {
    var activeTab = document.querySelector('.ped-mtab.ped-mtab-active').dataset.signTab;
    var src = null, sw = 220, sh = 70;
    if (activeTab === 'draw') {
      src = signCanvas.toDataURL();
      sw = 220; sh = Math.round(220 * signCanvas.height / signCanvas.width);
    } else if (activeTab === 'type') {
      var text = $('sign-type-input').value || 'Signature';
      var c = document.createElement('canvas'); c.width = 440; c.height = 120;
      var ctx = c.getContext('2d');
      ctx.font = 'bold 54px ' + state.signFont;
      ctx.fillStyle = state.signColor;
      ctx.fillText(text, 10, 80);
      src = c.toDataURL();
      sw = 220; sh = 60;
    } else if (activeTab === 'image') {
      var prev = $('sign-img-preview');
      if (prev && prev.src) {
        src = prev.src;
        sw = 200; sh = 80;
      }
    }
    if (src) {
      state.pendingSignature = { src: src, w: sw, h: sh };
      closeSignModal();
      setTool('place-sign');
    } else {
      closeSignModal();
    }
  });

  // ── MANAGE PAGES MODAL ───────────────────────────────────
  var mpState = { pages: [], zoomLevel: 'md' };

  $('tb-manage-pages').addEventListener('click', openManagePages);
  $('mp-close-btn').addEventListener('click', closeManagePages);
  $('mp-cancel-btn').addEventListener('click', closeManagePages);

  async function openManagePages() {
    if (!state.pdfDoc) return;
    managePagesModal.classList.remove('ped-hidden');
    mpState.pages = [];
    for (var p = 1; p <= state.totalPages; p++) {
      mpState.pages.push({
        id: 'p-' + p + '-' + Date.now(),
        origPageIndex: p - 1,
        rotation: state.pageRots[p] || 0,
        isNewBlank: false,
        selected: false
      });
    }
    renderMpGrid();
  }

  function closeManagePages() {
    managePagesModal.classList.add('ped-hidden');
  }

  async function renderMpGrid() {
    mpGrid.innerHTML = '';
    updateMpCount();
    for (var i = 0; i < mpState.pages.length; i++) {
      var pInfo = mpState.pages[i];
      var card = createMpCard(pInfo, i);
      mpGrid.appendChild(card);
    }
  }

  function createMpCard(pInfo, index) {
    var card = document.createElement('div');
    card.className = 'ped-mp-card' + (pInfo.selected ? ' selected' : '');
    card.dataset.index = index;

    var inner = document.createElement('div');
    inner.className = 'ped-mp-card-inner';

    var c = document.createElement('canvas');
    inner.appendChild(c);

    var check = document.createElement('div');
    check.className = 'ped-mp-check-badge';
    check.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';
    inner.appendChild(check);

    var numLbl = document.createElement('div');
    numLbl.className = 'ped-mp-card-num';
    numLbl.textContent = index + 1;

    card.appendChild(inner);
    card.appendChild(numLbl);

    (async function(canvas, info) {
      if (info.isNewBlank) {
        canvas.width = 140; canvas.height = 198;
        var ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, 140, 198);
        ctx.strokeStyle = '#e2e8f0'; ctx.strokeRect(0, 0, 140, 198);
        ctx.fillStyle = '#94a3b8'; ctx.font = '12px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText('Blank Page', 70, 99);
      } else {
        var page = await state.pdfDoc.getPage(info.origPageIndex + 1);
        var rot = ((info.rotation || 0) + page.rotate) % 360;
        var vp = page.getViewport({ scale: 0.22, rotation: rot });
        canvas.width = vp.width; canvas.height = vp.height;
        await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
      }
    })(c, pInfo);

    card.addEventListener('click', function(e) {
      pInfo.selected = !pInfo.selected;
      card.classList.toggle('selected', pInfo.selected);
      updateMpCount();
    });

    return card;
  }

  function updateMpCount() {
    var sel = mpState.pages.filter(function(p) { return p.selected; }).length;
    $('mp-status-info').textContent = sel + ' of ' + mpState.pages.length + ' page' + (mpState.pages.length === 1 ? '' : 's') + ' selected';
  }

  $('mp-act-new').addEventListener('click', function() {
    mpState.pages.push({
      id: 'blank-' + Date.now(),
      origPageIndex: null,
      rotation: 0,
      isNewBlank: true,
      selected: false
    });
    renderMpGrid();
  });

  $('mp-act-delete').addEventListener('click', function() {
    var sel = mpState.pages.filter(function(p) { return p.selected; });
    if (!sel.length) { alert('Please select page(s) to delete'); return; }
    if (sel.length === mpState.pages.length) { alert('Cannot delete all pages. The document must contain at least one page.'); return; }
    mpState.pages = mpState.pages.filter(function(p) { return !p.selected; });
    renderMpGrid();
  });

  $('mp-act-duplicate').addEventListener('click', function() {
    var newPages = [];
    mpState.pages.forEach(function(p) {
      newPages.push(p);
      if (p.selected) {
        newPages.push(Object.assign({}, p, { id: 'dup-' + Date.now() + Math.random(), selected: false }));
      }
    });
    mpState.pages = newPages;
    renderMpGrid();
  });

  $('mp-act-rot-left').addEventListener('click', function() {
    mpState.pages.forEach(function(p) {
      if (p.selected) p.rotation = ((p.rotation || 0) - 90 + 360) % 360;
    });
    renderMpGrid();
  });

  $('mp-act-rot-right').addEventListener('click', function() {
    mpState.pages.forEach(function(p) {
      if (p.selected) p.rotation = ((p.rotation || 0) + 90) % 360;
    });
    renderMpGrid();
  });

  $('mp-act-move-prev').addEventListener('click', function() {
    for (var i = 1; i < mpState.pages.length; i++) {
      if (mpState.pages[i].selected && !mpState.pages[i - 1].selected) {
        var tmp = mpState.pages[i - 1];
        mpState.pages[i - 1] = mpState.pages[i];
        mpState.pages[i] = tmp;
      }
    }
    renderMpGrid();
  });

  $('mp-act-move-next').addEventListener('click', function() {
    for (var i = mpState.pages.length - 2; i >= 0; i--) {
      if (mpState.pages[i].selected && !mpState.pages[i + 1].selected) {
        var tmp = mpState.pages[i + 1];
        mpState.pages[i + 1] = mpState.pages[i];
        mpState.pages[i] = tmp;
      }
    }
    renderMpGrid();
  });

  $('mp-act-select-all').addEventListener('click', function() {
    mpState.pages.forEach(function(p) { p.selected = true; });
    document.querySelectorAll('.ped-mp-card').forEach(function(c) { c.classList.add('selected'); });
    updateMpCount();
  });

  $('mp-act-select-none').addEventListener('click', function() {
    mpState.pages.forEach(function(p) { p.selected = false; });
    document.querySelectorAll('.ped-mp-card').forEach(function(c) { c.classList.remove('selected'); });
    updateMpCount();
  });

  $('mp-act-zoom-in').addEventListener('click', function() {
    mpGrid.classList.remove('zoom-sm'); mpGrid.classList.add('zoom-lg');
  });
  $('mp-act-zoom-out').addEventListener('click', function() {
    mpGrid.classList.remove('zoom-lg'); mpGrid.classList.add('zoom-sm');
  });

  $('mp-save-btn').addEventListener('click', async function() {
    var saveBtn = $('mp-save-btn'), origText = saveBtn.textContent;
    saveBtn.textContent = 'Applying changes...'; saveBtn.disabled = true;
    try {
      var PDFDocument = window.PDFLib.PDFDocument;
      var srcDoc = await PDFDocument.load(state.rawBytes);
      var newDoc = await PDFDocument.create();
      var newPageAnns = {}, newPageBlocks = {}, newPageRots = {};

      for (var i = 0; i < mpState.pages.length; i++) {
        var pInfo = mpState.pages[i];
        var targetPageNum = i + 1;
        if (pInfo.isNewBlank) {
          var blank = newDoc.addPage([595, 842]);
          if (pInfo.rotation) blank.setRotation(window.PDFLib.degrees(pInfo.rotation));
        } else {
          var copiedArr = await newDoc.copyPages(srcDoc, [pInfo.origPageIndex]);
          var copiedPage = copiedArr[0];
          var totalRot = (pInfo.rotation || 0) % 360;
          copiedPage.setRotation(window.PDFLib.degrees(totalRot));
          newDoc.addPage(copiedPage);

          var origPageNum = pInfo.origPageIndex + 1;
          if (state.doc.annotations[origPageNum]) {
            newPageAnns[targetPageNum] = JSON.parse(JSON.stringify(state.doc.annotations[origPageNum]));
          }
          if (state.doc.textBlocks[origPageNum]) {
            newPageBlocks[targetPageNum] = JSON.parse(JSON.stringify(state.doc.textBlocks[origPageNum]));
          }
        }
        newPageRots[targetPageNum] = pInfo.rotation || 0;
      }

      var newBytes = await newDoc.save();
      state.rawBytes = newBytes;
      state.pdfDoc = await pdfjsLib.getDocument({ data: new Uint8Array(state.rawBytes) }).promise;
      state.totalPages = state.pdfDoc.numPages;
      state.currentPage = Math.min(state.currentPage, state.totalPages);
      state.doc.annotations = newPageAnns;
      state.doc.textBlocks = newPageBlocks;
      state.pageRots = newPageRots;
      state.existingTextBlocks = {};
      totPageNum.textContent = state.totalPages;

      await buildThumbnails();
      await renderPage(state.currentPage);
      closeManagePages();
      setStatus('Pages updated successfully');
    } catch (err) {
      console.error(err);
      alert('Error updating pages: ' + err.message);
    }
    saveBtn.textContent = origText; saveBtn.disabled = false;
  });

  function drawTextRunsToExportCanvas(tCtx, a, exportScale) {
    var expX = (a.pdfX != null ? a.pdfX : a.x / state.scale) * exportScale;
    var expY = (a.pdfY != null ? a.pdfY : a.y / state.scale) * exportScale;
    var baseFs = (a.pdfFontSize || 14) * exportScale;

    // Group runs into lines separated by '\n'
    var lines = [[]];
    (a.runs || []).forEach(function(r) {
      var parts = String(r.text || '').split('\n');
      parts.forEach(function(p, idx) {
        if (idx > 0) lines.push([]);
        if (p.length > 0) {
          lines[lines.length - 1].push(Object.assign({}, r, { text: p }));
        }
      });
    });

    var curY = expY;
    lines.forEach(function(lineRuns) {
      if (!lineRuns.length) {
        curY += baseFs * 1.25;
        return;
      }
      var maxFs = baseFs;
      lineRuns.forEach(function(r) {
        var rfs = (r.pdfFontSize || a.pdfFontSize || 14) * exportScale;
        if (rfs > maxFs) maxFs = rfs;
      });
      var curX = expX;
      var baselineY = curY + maxFs * 0.85;

      lineRuns.forEach(function(r) {
        var rfs = (r.pdfFontSize || a.pdfFontSize || 14) * exportScale;
        var fontStr = (r.italic ? 'italic ' : '') + (r.bold ? 'bold ' : '') + Math.round(rfs) + 'px ' + (r.cssFamily || r.fontFamily || a.cssFamily || a.fontFamily || 'Arial, sans-serif');
        tCtx.save();
        var normText = normalizePdfGlyphs(r.text);
        var rw = tCtx.measureText(normText).width;

        if (r.highlight) {
          tCtx.save();
          tCtx.fillStyle = r.highlight;
          tCtx.globalAlpha = 0.35;
          tCtx.fillRect(curX, curY, rw, maxFs * 1.15);
          tCtx.restore();
        }

        tCtx.fillStyle = r.color || a.color || '#000000';
        tCtx.fillText(normText, curX, baselineY);
        tCtx.restore();
        curX += rw;
      });
      curY += maxFs * 1.25;
    });
  }

  // ── DOWNLOAD VIA PDF-LIB ──────────────────────────────────
  $('tb-download').addEventListener('click', async function() {
    commitCurrentTextEdit();
    var btn = $('tb-download'), orig = btn.innerHTML;
    btn.textContent = 'Exporting...'; btn.disabled = true;
    setStatus('Generating PDF...');
    try {
      var PDFDocument = window.PDFLib.PDFDocument;
      var pdfLibDoc = await PDFDocument.load(state.rawBytes.slice(0));
      var libPages = pdfLibDoc.getPages();

      for (var pi = 0; pi < libPages.length; pi++) {
        var pg = pi + 1;
        var blocks = (state.doc.textBlocks && state.doc.textBlocks[pg]) || [];
        var anns = (state.doc.annotations && state.doc.annotations[pg]) || [];
        var hasModBlocks = blocks.some(function(b) { return !b.isDeleted && (b.isModified || !b.isOriginal); });
        var hasDelBlocks = blocks.some(function(b) { return b.isOriginal && b.isDeleted; });

        if (!anns.length && !hasModBlocks && !hasDelBlocks) continue;

        var pdfJsPage = await state.pdfDoc.getPage(pg);
        var rot = (state.pageRots[pg] || 0) + pdfJsPage.rotate;
        var exportScale = 2.0;
        var vp = pdfJsPage.getViewport({ scale: exportScale, rotation: rot });
        var tc = document.createElement('canvas'); tc.width = vp.width; tc.height = vp.height;
        var tCtx = tc.getContext('2d');
        var sc = exportScale / state.scale;

        // 1. Draw masks to cover original text for modified or deleted original blocks
        blocks.forEach(function(b) {
          if (b.isOriginal && (b.isModified || b.isDeleted)) {
            drawOriginalTextMask(tCtx, b, exportScale);
          }
        });

        // 2. Draw annotations (masks, shapes, draw, highlights, images)
        for (var ai = 0; ai < anns.length; ai++) {
          var a = anns[ai];
          if (a.type === 'mask') {
            var mx = (a.pdfX != null ? a.pdfX : a.x / state.scale) * exportScale;
            var my = (a.pdfY != null ? a.pdfY : a.y / state.scale) * exportScale;
            var mw = (a.pdfW != null ? a.pdfW : a.w / state.scale) * exportScale;
            var mh = (a.pdfH != null ? a.pdfH : a.h / state.scale) * exportScale;
            tCtx.fillStyle = '#ffffff';
            tCtx.fillRect(mx, my, mw, mh);
          } else if (a.type === 'shape') {
            var sw = (a.pdfW != null ? a.pdfW * exportScale : a.w * sc);
            var sh = (a.pdfH != null ? a.pdfH * exportScale : a.h * sc);
            var sx = (a.pdfX != null ? a.pdfX * exportScale : a.x * sc);
            var sy = (a.pdfY != null ? a.pdfY * exportScale : a.y * sc);
            var strW = (a.width || 2) * sc;
            tCtx.save();
            tCtx.strokeStyle = a.color || '#e53e3e';
            tCtx.lineWidth = strW;
            tCtx.lineCap = 'round';
            if (a.shape === 'rect') {
              if (a.fill) {
                tCtx.fillStyle = a.fillColor || '#93c5fd';
                tCtx.fillRect(sx, sy, sw, sh);
              }
              tCtx.strokeRect(sx, sy, sw, sh);
            } else if (a.shape === 'circle') {
              tCtx.beginPath();
              tCtx.ellipse(sx + sw / 2, sy + sh / 2, Math.max(1, sw / 2), Math.max(1, sh / 2), 0, 0, Math.PI * 2);
              if (a.fill) {
                tCtx.fillStyle = a.fillColor || '#93c5fd';
                tCtx.fill();
              }
              tCtx.stroke();
            } else if (a.shape === 'line') {
              var lx1 = (a.x2 >= a.x1) ? sx : (sx + sw);
              var ly1 = (a.y2 >= a.y1) ? sy : (sy + sh);
              var lx2 = (a.x2 >= a.x1) ? (sx + sw) : sx;
              var ly2 = (a.y2 >= a.y1) ? (sy + sh) : sy;
              tCtx.beginPath();
              tCtx.moveTo(lx1, ly1);
              tCtx.lineTo(lx2, ly2);
              tCtx.stroke();
            } else if (a.shape === 'arrow') {
              var lx1 = (a.x2 >= a.x1) ? sx : (sx + sw);
              var ly1 = (a.y2 >= a.y1) ? sy : (sy + sh);
              var lx2 = (a.x2 >= a.x1) ? (sx + sw) : sx;
              var ly2 = (a.y2 >= a.y1) ? (sy + sh) : sy;
              drawArrow(tCtx, lx1, ly1, lx2, ly2, a.color, strW);
            }
            tCtx.restore();
          } else if (a.type === 'draw') {
            var sa = JSON.parse(JSON.stringify(a));
            if (sa.pts) sa.pts = sa.pts.map(function(p) { return { x: p.x * sc, y: p.y * sc }; });
            if (sa.x1 != null) { sa.x1 *= sc; sa.y1 *= sc; sa.x2 *= sc; sa.y2 *= sc; sa.width = (sa.width || 2) * sc; }
            drawShape(tCtx, sa);
          } else if (a.type === 'highlight') {
            tCtx.save();
            tCtx.globalCompositeOperation = 'multiply';
            tCtx.fillStyle = a.color || '#fef08a';
            if (a.lines && a.lines.length) {
              a.lines.forEach(function(ln) {
                var lx = (ln.pdfX != null ? ln.pdfX : ln.x / state.scale) * exportScale;
                var ly = (ln.pdfY != null ? ln.pdfY : ln.y / state.scale) * exportScale;
                var lw = (ln.pdfW != null ? ln.pdfW : ln.w / state.scale) * exportScale;
                var lh = (ln.pdfH != null ? ln.pdfH : ln.h / state.scale) * exportScale;
                tCtx.fillRect(lx, ly, lw, lh);
              });
            } else if (a.x1 != null) {
              tCtx.fillRect(a.x1 * sc, a.y1 * sc, (a.x2 - a.x1) * sc, (a.y2 - a.y1) * sc);
            }
            tCtx.restore();
          } else if (a.type === 'image') {
            await new Promise(function(res) {
              var img = new Image();
              img.src = a.src;
              img.onload = function() {
                tCtx.drawImage(img, a.x * sc, a.y * sc, a.w * sc, a.h * sc);
                res();
              };
              img.onerror = res;
            });
          }
        }

        // 3. Draw modified original text blocks and user-added text blocks
        blocks.forEach(function(b) {
          if (b.isDeleted) return;
          if (b.isOriginal && !b.isModified) return;
          if (b.runs && b.runs.length > 0) {
            drawTextRunsToExportCanvas(tCtx, b, exportScale);
          } else if (b.text) {
            var expX = b.pdfX * exportScale;
            var expY = b.pdfY * exportScale;
            var expW = b.pdfW * exportScale;
            var expFontSize = (b.pdfFontSize || 14) * exportScale;

            tCtx.save();
            tCtx.font = (b.italic ? 'italic ' : '') + (b.bold ? 'bold ' : '') + Math.round(expFontSize) + 'px ' + (b.cssFamily || b.fontFamily || 'Arial, sans-serif');
            tCtx.fillStyle = b.color || '#000000';
            tCtx.textAlign = b.align || 'left';
            var drawX = expX;
            if (b.align === 'center') drawX = expX + expW / 2;
            else if (b.align === 'right') drawX = expX + expW;

            var lines = String(b.text).split('\n');
            var lineH = expFontSize * 1.2;
            lines.forEach(function(ln, lidx) {
              tCtx.fillText(normalizePdfGlyphs(ln), drawX, expY + expFontSize * 0.85 + (lidx * lineH));
            });
            tCtx.restore();
          }
        });

        var imgBytes = await (await fetch(tc.toDataURL('image/png'))).arrayBuffer();
        var emb = await pdfLibDoc.embedPng(imgBytes);
        var sz = libPages[pi].getSize();
        libPages[pi].drawImage(emb, { x: 0, y: 0, width: sz.width, height: sz.height });
      }

      var bytes = await pdfLibDoc.save();
      var url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
      var a = document.createElement('a'); a.href = url;
      a.download = state.fileName.replace(/\.pdf$/i, '') + '-edited.pdf';
      a.click();
      URL.revokeObjectURL(url);
      setStatus('Downloaded successfully!');
    } catch (err) {
      console.error(err);
      setStatus('Export failed: ' + err.message);
    }
    btn.innerHTML = orig; btn.disabled = false;
  });

  function setStatus(msg) { statusMsg.textContent = msg; }
}
})();
</script>
</body>
</html>
