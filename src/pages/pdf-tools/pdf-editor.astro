  function detectFont(fontName, styleObj, fontObj) {
    var rawFontName = (fontName || '');
    var loadedName = (fontObj && (fontObj.loadedName || fontObj.name)) || '';
    var fallbackName = (fontObj && fontObj.fallbackName) || '';
    var styleFamily = (styleObj && styleObj.fontFamily) || '';
    var objName = (fontObj && (fontObj.name || '')) || '';
    
    var allNames = (rawFontName + ' ' + loadedName + ' ' + fallbackName + ' ' + styleFamily + ' ' + objName).toLowerCase();

    // Bold detection: check fontObj properties or comprehensive regex
    var isBold = false;
    if (fontObj && (fontObj.bold || fontObj.black || fontObj.weight === 'bold' || parseInt(fontObj.weight) >= 600)) {
      isBold = true;
    } else if (/bold|black|heavy|semibold|demibold|bld|w[6-9]00|700|800|900/i.test(allNames) ||
               /[-_, ](bd|b)$/i.test(rawFontName) ||
               /[-_, ](bd|b)$/i.test(loadedName)) {
      isBold = true;
    }

    // Italic detection: check fontObj properties or regex
    var isItalic = false;
    if (fontObj && (fontObj.italic || fontObj.style === 'italic' || fontObj.style === 'oblique')) {
      isItalic = true;
    } else if (/italic|oblique|slant|ita|it$/i.test(allNames) ||
               /[-_, ](it|i)$/i.test(rawFontName) ||
               /[-_, ](it|i)$/i.test(loadedName)) {
      isItalic = true;
    }

    var isSerif = /times|roman|georgia|cambria|garamond|serif|baskerville|palatino|minion|century|bookman/i.test(allNames);
    var isMono = /courier|mono|consolas|menlo|monospace|typewriter|fixed/i.test(allNames);
    var isGeorgia = /georgia/i.test(allNames);
    var isVerdana = /verdana/i.test(allNames);

    var family = 'Arial';
    var cssFamily = 'Arial, Helvetica, "Segoe UI", sans-serif';
    if (isGeorgia) {
      family = 'Georgia';
      cssFamily = 'Georgia, "Times New Roman", serif';
    } else if (isSerif) {
      family = 'Times New Roman';
      cssFamily = '"Times New Roman", Times, Georgia, serif';
    } else if (isMono) {
      family = 'Courier New';
      cssFamily = '"Courier New", Courier, monospace';
    } else if (isVerdana) {
      family = 'Verdana';
      cssFamily = 'Verdana, Geneva, sans-serif';
    }

    return {
      family: family,
      cssFamily: cssFamily,
      bold: isBold,
      italic: isItalic
    };
  }

  async function extractTextBlocks(page, rotation) {
    var baseVp = page.getViewport({ scale: 1.0, rotation: rotation });
    var tc = await page.getTextContent();
    var styles = tc.styles || {};
    var rawItems = [];

    tc.items.forEach(function(item) {
      if (!item.str || !item.str.trim()) return;
      var cleanStr = normalizePdfGlyphs(item.str);
      if (!cleanStr || !cleanStr.trim()) return;

      var fontObj = null;
      try {
        if (page.commonObjs && typeof page.commonObjs.has === 'function' && page.commonObjs.has(item.fontName)) {
          fontObj = page.commonObjs.get(item.fontName);
        } else if (page.objs && typeof page.objs.has === 'function' && page.objs.has(item.fontName)) {
          fontObj = page.objs.get(item.fontName);
        }
      } catch (err) {}

      var fontInfo = detectFont(item.fontName, styles[item.fontName], fontObj);
      var tx = item.transform;
      var fontHeightPt = Math.hypot(tx[2], tx[3]) || Math.hypot(tx[0], tx[1]) || 12;
      var fontSize = Math.round(fontHeightPt);

      var pt = baseVp.convertToViewportPoint(tx[4], tx[5]);
      var baselineX = Math.round(pt[0]);
      var baselineY = Math.round(pt[1]);
      var w = Math.round(Math.abs(item.width));
      var h = Math.round(fontSize * 1.15);
      var y = Math.round(baselineY - fontSize * 0.85);

      var screenX = baselineX * state.scale;
      var screenY = y * state.scale;
      var screenW = Math.max(16, w * state.scale);
      var screenH = Math.max(12, h * state.scale);
      var color = sampleTextColor(pCtx, screenX, screenY, screenW, screenH);

      rawItems.push({
        str: cleanStr,
        pdfX: baselineX,
        pdfY: y,
        baselineX: baselineX,
        baselineY: baselineY,
        pdfW: w,
        pdfH: h,
        pdfFontSize: fontSize,
        fontName: item.fontName || 'Helvetica',
        family: fontInfo.family,
        cssFamily: fontInfo.cssFamily,
        bold: fontInfo.bold,
        italic: fontInfo.italic,
        color: color
      });
    });

    // Sort top to bottom by baselineY, then left to right
    rawItems.sort(function(a, b) {
      var dy = Math.abs(a.baselineY - b.baselineY);
      var maxSame = Math.max(1.5, Math.min(3.5, Math.min(a.pdfFontSize, b.pdfFontSize) * 0.25));
      if (dy > maxSame) return a.baselineY - b.baselineY;
      return a.pdfX - b.pdfX;
    });

    // Group text items on the same line into natural blocks with preserved runs
    var lines = [];
    rawItems.forEach(function(it) {
      var last = lines[lines.length - 1];
      var maxSame = Math.max(1.5, Math.min(3.5, it.pdfFontSize * 0.25));
      var sameLine = last && Math.abs(last.baselineY - it.baselineY) <= maxSame;
      if (sameLine) {
        var gap = it.pdfX - (last.pdfX + last.pdfW);
        if (gap >= -8 && gap < Math.max(20, it.pdfFontSize * 1.5)) {
          var needsSpace = gap > (it.pdfFontSize * 0.22) && !last.str.endsWith(' ') && !it.str.startsWith(' ');
          if (needsSpace) {
            if (last.runs && last.runs.length) {
              last.runs[last.runs.length - 1].text += ' ';
            }
            last.str += ' ';
          }
          last.str += it.str;
          if (!last.runs) {
            last.runs = [{
              text: last.str,
              fontFamily: last.family,
              cssFamily: last.cssFamily,
              pdfFontSize: last.pdfFontSize,
              bold: last.bold,
              italic: last.italic,
              color: last.color
            }];
          }
          last.runs.push({
            text: it.str,
            fontFamily: it.family,
            cssFamily: it.cssFamily,
            pdfFontSize: it.pdfFontSize,
            bold: it.bold,
            italic: it.italic,
            color: it.color
          });
          last.pdfW = Math.round(Math.max(last.pdfW, (it.pdfX + it.pdfW) - last.pdfX));
          last.pdfH = Math.max(last.pdfH, it.pdfH);
          last.bold = last.bold || it.bold;
          last.italic = last.italic || it.italic;
          if (it.color && it.color !== '#000000' && last.color === '#000000') {
            last.color = it.color;
          }
          return;
        }
      }
      var block = Object.assign({}, it);
      block.runs = [{
        text: it.str,
        fontFamily: it.family,
        cssFamily: it.cssFamily,
        pdfFontSize: it.pdfFontSize,
        bold: it.bold,
        italic: it.italic,
        color: it.color
      }];
      lines.push(block);
    });

    return lines;
  }

  async function ensurePageTextBlocks(p) {
    if (!state.pdfDoc) return [];
    if (!state.doc.textBlocks[p]) {
      state.doc.textBlocks[p] = [];
      try {
        var page = await state.pdfDoc.getPage(p);
        var rotation = (state.pageRots[p] || 0) + page.rotate;
        var lines = await extractTextBlocks(page, rotation);
        lines.forEach(function(b, idx) {
          state.doc.textBlocks[p].push({
            id: 'tb-orig-' + p + '-' + idx,
            isOriginal: true,
            isModified: false,
            isDeleted: false,
            origPdfX: b.pdfX,
            origPdfY: b.pdfY,
            origPdfW: b.pdfW,
            origPdfH: b.pdfH,
            pdfX: b.pdfX,
            pdfY: b.pdfY,
            pdfW: b.pdfW,
            pdfH: b.pdfH,
            pdfFontSize: b.pdfFontSize,
            baselineX: b.baselineX,
            baselineY: b.baselineY,
            text: b.str,
            origText: b.str,
            runs: JSON.parse(JSON.stringify(b.runs || [])),
            origRuns: JSON.parse(JSON.stringify(b.runs || [])),
            fontFamily: b.family,
            cssFamily: b.cssFamily,
            bold: b.bold,
            italic: b.italic,
            color: b.color || '#000000',
            align: 'left'
          });
        });
      } catch (err) {
        console.error('Error extracting text blocks for page ' + p, err);
      }
    }
    return state.doc.textBlocks[p];
  }

  function createNewTextBlock(pdfX, pdfY) {
    var def = state.defaultNewTextStyle || {};
    var chosenPt = def.fontSize || parseInt($('ctx-font-size').value) || 16;
    var b = {
      id: 'tb-user-' + Date.now(),
      isOriginal: false,
      isModified: true,
      isDeleted: false,
      origPdfX: Math.round(pdfX * 10) / 10,
      origPdfY: Math.round(pdfY * 10) / 10,
      origPdfW: 160,
      origPdfH: 32,
      pdfX: Math.round(pdfX * 10) / 10,
      pdfY: Math.round(pdfY * 10) / 10,
      pdfW: 160,
      pdfH: 32,
      pdfFontSize: chosenPt,
      text: '',
      origText: '',
      runs: [],
      origRuns: [],
      fontFamily: def.fontFamily || $('ctx-font-family').value || 'Arial',
      cssFamily: def.fontFamily || $('ctx-font-family').value || 'Arial, sans-serif',
      bold: def.bold != null ? def.bold : state.bold,
      italic: def.italic != null ? def.italic : state.italic,
      align: def.align || state.textAlign || 'left',
      color: def.color || $('ctx-color').value || '#000000'
    };
    if (!state.doc.textBlocks[state.currentPage]) {
      state.doc.textBlocks[state.currentPage] = [];
    }
    state.doc.textBlocks[state.currentPage].push(b);
    pushUndoSnapshot();

    renderPageElements(state.currentPage);

    var newEl = annOverlay.querySelector('.ped-text-block[data-block-id="' + b.id + '"]');
    if (newEl) {
      startTextEditing(newEl, b, false);
    }
  }

  function buildTextBlockEl(b) {
    var box = document.createElement('div');
    box.className = 'ped-text-block ped-existing-text-block';
    box.dataset.blockId = b.id;

    var sx = Math.round(b.pdfX * state.scale);
    var sy = Math.round(b.pdfY * state.scale);
    var sw = Math.max(20, Math.round(b.pdfW * state.scale));
    var sh = Math.max(14, Math.round(b.pdfH * state.scale));
    var sFontSize = Math.max(8, Math.round(b.pdfFontSize * state.scale));

    box.style.left = sx + 'px';
    box.style.top = sy + 'px';
    box.style.minWidth = sw + 'px';
    box.style.width = 'max-content';
    box.style.maxWidth = 'calc(100% - ' + sx + 'px)';
    box.style.minHeight = sh + 'px';
    box.style.height = 'auto';

    if (b.isModified || !b.isOriginal) {
      box.classList.add('custom-text', 'edited');
    }

    var content = document.createElement('div');
    content.className = 'ped-text-content ped-et-content';
    content.contentEditable = 'false';
    content.style.fontSize = sFontSize + 'px';
    content.style.fontFamily = b.cssFamily || b.fontFamily || 'Arial, sans-serif';
    content.style.fontWeight = b.bold ? 'bold' : 'normal';
    content.style.fontStyle = b.italic ? 'italic' : 'normal';
    content.style.textAlign = b.align || 'left';

    if (b.isOriginal && !b.isModified) {
      content.style.color = 'transparent';
      content.innerText = b.text;
    } else {
      content.style.color = b.color || '#000000';
      if (b.runs && b.runs.length > 0) {
        content.innerHTML = runsToHtml(b.runs, b);
      } else {
        content.innerText = b.text || '';
      }
    }

    box.appendChild(content);
    attachTextBlockInteractions(box, b);
    return box;
  }

  function attachTextBlockInteractions(box, b) {
    var content = box.querySelector('.ped-text-content');

    attachResizeDots(box, b);

    box.addEventListener('mousedown', function(e) {
      if (e.target.classList.contains('resize-dot')) return;

      if (state.activeTool === 'highlight') {
        return;
      }

      if (box.classList.contains('editing')) {
        e.stopPropagation();
        return;
      }

      e.preventDefault();
      e.stopPropagation();

      var wasSelected = (state.selectedEl === box);
      var startX = e.clientX, startY = e.clientY;
      var origPdfX = b.pdfX;
      var origPdfY = b.pdfY;
      var isDragging = false;

      function onMouseMove(ev) {
        var dx = ev.clientX - startX, dy = ev.clientY - startY;
        if (!isDragging) {
          if (Math.hypot(dx, dy) < 4) return;
          isDragging = true;

          b.isModified = true;
          box.classList.add('custom-text', 'edited', 'dragging');
          if (content) {
            content.style.color = b.color || '#000000';
          }
          if (state.selectedEl !== box) {
            selectElement(box, b);
          }
          document.body.style.cursor = 'move';

          if (b.isOriginal) {
            drawOriginalTextMask(aCtx, b, state.scale);
          }
        }

        var newPdfX = origPdfX + (dx / state.scale);
        var newPdfY = origPdfY + (dy / state.scale);
        b.pdfX = Math.round(newPdfX * 10) / 10;
        b.pdfY = Math.round(newPdfY * 10) / 10;

        box.style.left = Math.round(b.pdfX * state.scale) + 'px';
        box.style.top = Math.round(b.pdfY * state.scale) + 'px';
      }

      function onMouseUp(ev) {
        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
        document.body.style.cursor = '';

        if (isDragging) {
          box.classList.remove('dragging');
          pushUndoSnapshot();
          return;
        }

        if (state.activeTool === 'text') {
          setTool(null);
        }

        if (state.activeTool === 'text-edit' || wasSelected) {
          startTextEditing(box, b, false);
        } else {
          selectElement(box, b);
          setStatus('Text selected. Drag to move, or click again / double-click to edit.');
        }
      }

      document.addEventListener('mousemove', onMouseMove);
      document.addEventListener('mouseup', onMouseUp);
    });

    box.addEventListener('dblclick', function(e) {
      if (state.activeTool === 'highlight') return;
      e.stopPropagation();
      e.preventDefault();
      startTextEditing(box, b, false);
    });

    if (content) {
      content.addEventListener('input', function() {
        b.text = content.innerText;
        b.runs = parseFormattingRuns(content, b);
      });

      content.addEventListener('paste', function(e) {
        e.preventDefault();
        var text = (e.clipboardData || window.clipboardData).getData('text/plain');
        document.execCommand('insertText', false, text);
      });

      content.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          e.preventDefault();
          deselectAll();
        }
        e.stopPropagation();
      });
    }
  }

  function redrawAnnotationsCanvas(p) {
    if (!p) p = state.currentPage;
    aCtx.clearRect(0, 0, annCanvas.width, annCanvas.height);

    // 1. Draw background white masks for any modified or deleted original text blocks
    var blocks = (state.doc.textBlocks && state.doc.textBlocks[p]) || [];
    blocks.forEach(function(b) {
      if (b.isOriginal && (b.isModified || b.isDeleted)) {
        drawOriginalTextMask(aCtx, b, state.scale);
      }
    });

    // 2. Draw canvas annotations (masks, drawings)
    var anns = (state.doc.annotations && state.doc.annotations[p]) || [];
    anns.forEach(function(a) {
      if (a.type === 'mask') {
        drawMask(aCtx, a);
      } else if (a.type === 'draw') {
        drawShape(aCtx, a);
      }
    });
  }

  function renderPageElements(p) {
    if (!p) p = state.currentPage;
    if (!state.pdfDoc) return;

    var curEditId = (state.activeEditBlock && state.activeEditBlock.id) || null;
    var selectedId = (state.selectedAnn && state.selectedAnn.id) || null;

    redrawAnnotationsCanvas(p);
    annOverlay.innerHTML = '';
    if (hlLayer) hlLayer.innerHTML = '';

    // Render annotations (highlights, shapes, images)
    var anns = (state.doc.annotations && state.doc.annotations[p]) || [];
    anns.forEach(function(a) {
      if (a.type === 'highlight') {
        restoreHighlightEl(a);
      } else if (a.type === 'shape') {
        var el = restoreShapeEl(a);
        if (selectedId === a.id) selectElement(el, a);
      } else if (a.type === 'image') {
        restoreImgEl(a);
      }
    });

    // Render all active canonical text blocks in annOverlay
    var blocks = (state.doc.textBlocks && state.doc.textBlocks[p]) || [];
    blocks.forEach(function(b) {
      if (b.isDeleted) return;
      var box = buildTextBlockEl(b);
      annOverlay.appendChild(box);

      if (curEditId === b.id) {
        startTextEditing(box, b, false);
      } else if (selectedId === b.id) {
        selectElement(box, b);
      }
    });
  }

  function applyHighlightFromSelection(color, opacity) {
    var p = state.currentPage;
    var sel = window.getSelection();
    if (!sel || sel.isCollapsed || !sel.rangeCount) return false;

    var range = sel.getRangeAt(0);
    var rects = range.getClientRects();
    if (!rects || rects.length === 0) return false;

    var overlayRect = annOverlay.getBoundingClientRect();
    var lines = [];

    for (var i = 0; i < rects.length; i++) {
      var r = rects[i];
      if (r.width < 1 || r.height < 1) continue;
      var lx = r.left - overlayRect.left;
      var ly = r.top - overlayRect.top;
      lines.push({
        pdfX: lx / state.scale,
        pdfY: ly / state.scale,
        pdfW: r.width / state.scale,
        pdfH: r.height / state.scale,
        x: Math.round(lx),
        y: Math.round(ly),
        w: Math.round(r.width),
        h: Math.round(r.height)
      });
    }

    if (lines.length === 0) return false;

    var hlAnn = {
      type: 'highlight',
      id: Date.now(),
      color: color || state.highlightColor || '#fef08a',
      opacity: opacity != null ? opacity : 0.85,
      lines: lines
    };

    if (!state.doc.annotations[p]) state.doc.annotations[p] = [];
    state.doc.annotations[p].push(hlAnn);
    pushUndoSnapshot();

    sel.removeAllRanges();
    restoreHighlightEl(hlAnn);

    var newWrap = annOverlay.querySelector('.highlight-wrap[data-ann-id="' + hlAnn.id + '"]');
    if (newWrap) selectElement(newWrap, hlAnn);
    return true;
  }

  // ── IMAGES & SIGNATURES (CLICK TO PLACE & RESIZE) ────────────
  function createImgAnnotation(src, x, y, w, h) {
    var a = {
      type: 'image', id: Date.now(), src: src,
      x: x, y: y, w: w, h: h
    };
    pushAnn(a);
    restoreImgEl(a);
  }

  function restoreImgEl(a) {
    var wrap = document.createElement('div');
    wrap.className = 'img-annotation';
    wrap.dataset.annId = a.id;
    wrap.style.left = a.x + 'px';
    wrap.style.top = a.y + 'px';
    wrap.style.width = a.w + 'px';
    wrap.style.height = a.h + 'px';

    var img = document.createElement('img');
    img.src = a.src;
    img.draggable = false;
    wrap.appendChild(img);

    attachResizeDots(wrap, a);
    attachDragMove(wrap, a);

    wrap.addEventListener('click', function(e) {
      e.stopPropagation();
      selectElement(wrap, a);
    });

    annOverlay.appendChild(wrap);
    selectElement(wrap, a);
  }

  // ── CANVAS & PAGE INTERACTION & PLACEMENT ─────────────────
  pageWrapper.addEventListener('mousedown', function(e) {
    var tool = state.activeTool;
    // Don't interfere if clicking on an annotation, text block, toolbar, floating tray, or modal
    if (e.target.closest('.ped-text-block, .ped-existing-text-block, .text-annotation, .shape-annotation, .img-annotation, .highlight-wrap, #ped-floating-tray, .ped-ctx-toolbar, #main-toolbar, .ped-modal, .ped-sidebar')) {
      return;
    }
    if (tool === 'text') {
      e.preventDefault();
      var pos = getOverlayPos(e);
      setTool(null);
      createNewTextBlock(pos.x / state.scale, pos.y / state.scale);
      return;
    }
    if (tool === 'place-image' && state.pendingImage) {
      e.preventDefault();
      var pos = getOverlayPos(e);
      var pImg = state.pendingImage;
      createImgAnnotation(pImg.src, Math.round(pos.x - pImg.w / 2), Math.round(pos.y - pImg.h / 2), pImg.w, pImg.h);
      state.pendingImage = null;
      setTool(null);
      setStatus('Image placed. Drag to move, corner dots to resize.');
      return;
    }
    if (tool === 'place-sign' && state.pendingSignature) {
      e.preventDefault();
      var pos = getOverlayPos(e);
      var sig = state.pendingSignature;
      var w = Math.min(220, annCanvas.width * 0.4);
      var h = Math.round(w * sig.h / sig.w);
      createImgAnnotation(sig.src, Math.round(pos.x - w / 2), Math.round(pos.y - h / 2), w, h);
      state.pendingSignature = null;
      setTool(null);
      setStatus('Signature placed. Drag to move, corner dots to resize.');
      return;
    }
    // Clicking on blank area of page deselects and commits any active text or element
    deselectAll();
  });

  $('canvas-viewport').addEventListener('mousedown', function(e) {
    if (e.target === $('canvas-viewport')) {
      deselectAll();
    }
  });

  document.addEventListener('mousedown', function(e) {
    if (state.selectedEl && !e.target.closest('.ped-text-block, .ped-existing-text-block, .text-annotation, .shape-annotation, .img-annotation, .highlight-wrap, #ped-floating-tray, .ped-ctx-toolbar, .ped-toolbar, #main-toolbar, .ped-modal, .ped-sidebar')) {
      deselectAll();
    }
  });

  function getHighlightLinesForBox(p, minX, maxX, minY, maxY) {
    var matching = [];
    var blocks = (state.doc.textBlocks && state.doc.textBlocks[p]) || [];

    blocks.forEach(function(b) {
      if (b.isDeleted) return;
      var lineX = b.pdfX * state.scale;
      var lineY = b.pdfY * state.scale;
      var lineW = b.pdfW * state.scale;
      var lineH = b.pdfH * state.scale;

      var top = Math.max(minY, lineY);
      var bottom = Math.min(maxY, lineY + lineH);
      if (bottom - top > Math.min(4, lineH * 0.25)) {
        var left = Math.max(minX, lineX);
        var right = Math.min(maxX, lineX + lineW);
        if (right - left > 4) {
          matching.push({
            pdfX: left / state.scale,
            pdfY: b.pdfY,
            pdfW: (right - left) / state.scale,
            pdfH: b.pdfH,
            x: Math.round(left),
            y: Math.round(lineY),
            w: Math.round(right - left),
            h: Math.round(lineH)
          });
        }
      }
    });

    if (matching.length === 0) {
      var rw = maxX - minX, rh = maxY - minY;
      if (rw > 5 && rh > 5) {
        matching.push({
          pdfX: minX / state.scale,
          pdfY: minY / state.scale,
          pdfW: rw / state.scale,
          pdfH: rh / state.scale,
          x: Math.round(minX),
          y: Math.round(minY),
          w: Math.round(rw),
          h: Math.round(rh)
        });
      }
    }
    return matching;
  }

  annCanvas.addEventListener('mousedown', function(e) {
    var tool = state.activeTool;
    var overlayPos = getOverlayPos(e);
    var canvasPos = getCanvasPos(e);

    if (!tool || tool === 'text-edit') {
      deselectAll();
      return;
    }
    e.preventDefault();
    e.stopPropagation();

    // 1. Add Textbox right at clicked position
    if (tool === 'text') {
      setTool(null);
      createNewTextBlock(overlayPos.x / state.scale, overlayPos.y / state.scale);
      return;
    }

    // 2. Place Image right at clicked position
    if (tool === 'place-image' && state.pendingImage) {
      var pImg = state.pendingImage;
      createImgAnnotation(pImg.src, Math.round(overlayPos.x - pImg.w / 2), Math.round(overlayPos.y - pImg.h / 2), pImg.w, pImg.h);
      state.pendingImage = null;
      setTool(null);
      setStatus('Image placed. Drag to move, corner dots to resize.');
      return;
    }

    // 3. Place Signature right at clicked position
    if (tool === 'place-sign' && state.pendingSignature) {
      var sig = state.pendingSignature;
      var w = Math.min(220, annCanvas.width * 0.4);
      var h = Math.round(w * sig.h / sig.w);
      createImgAnnotation(sig.src, Math.round(overlayPos.x - w / 2), Math.round(overlayPos.y - h / 2), w, h);
      state.pendingSignature = null;
      setTool(null);
      setStatus('Signature placed. Drag to move, corner dots to resize.');
      return;
    }

    // 4. Eraser
    if (tool === 'eraser') {
      state.isErasing = true;
      eraseAt(canvasPos.x, canvasPos.y);
      return;
    }

    // 5. Draw & Line
    if (tool === 'draw') {
      state.isDrawing = true;
      state.drawStart = canvasPos;
      state.freehandPts = [canvasPos];
    } else if (tool === 'line') {
      state.isDrawing = true;
      state.drawStart = canvasPos;
      state.drawStartOverlay = overlayPos;
    }
    if (tool === 'highlight') {
      state.isHighlighting = true;
      state.hlStart = canvasPos;
      state.hlMatchingLines = [];
    }
  });

  window.addEventListener('mousemove', function(e) {
    var tool = state.activeTool;
    var canvasPos = getCanvasPos(e);

    if (tool === 'eraser' && state.isErasing) {
      eraseAt(canvasPos.x, canvasPos.y);
      return;
    }

    if (!state.isDrawing && !state.isHighlighting) return;

    if (tool === 'draw') {
      state.freehandPts.push(canvasPos);
      aCtx.save();
      var pType = state.drawStrokeType || 'pen';
      var pColor = state.drawPenColor || $('ann-color').value || '#000000';
      var pWidth = state.drawPenWidth || parseInt($('ann-width').value) || 2;
      var lineW = pType === 'highlighter' ? Math.max(16, pWidth * 3) : (pType === 'marker' ? pWidth * 1.5 : pWidth);

      aCtx.strokeStyle = pColor;
      aCtx.lineWidth = lineW;
      aCtx.lineCap = (pType === 'marker' || pType === 'highlighter') ? 'square' : 'round';
      aCtx.lineJoin = 'round';
      aCtx.globalAlpha = pType === 'highlighter' ? 0.35 : (pType === 'marker' ? 0.85 : 1.0);

      var pts = state.freehandPts;
      if (pts.length > 1) {
        aCtx.beginPath();
        aCtx.moveTo(pts[pts.length - 2].x, pts[pts.length - 2].y);
        aCtx.lineTo(pts[pts.length - 1].x, pts[pts.length - 1].y);
        aCtx.stroke();
      }
      aCtx.restore();
    } else if (tool === 'line') {
      redrawAnnotationsCanvas(state.currentPage);
      previewShape(aCtx, state.drawStart.x, state.drawStart.y, canvasPos.x, canvasPos.y);
    } else if (tool === 'highlight' && state.isHighlighting) {
      var minX = Math.min(state.hlStart.x, canvasPos.x);
      var maxX = Math.max(state.hlStart.x, canvasPos.x);
      var minY = Math.min(state.hlStart.y, canvasPos.y);
      var maxY = Math.max(state.hlStart.y, canvasPos.y);

      state.hlMatchingLines = getHighlightLinesForBox(state.currentPage, minX, maxX, minY, maxY);

      if (hlLayer) {
        hlLayer.querySelectorAll('.ped-hl-preview').forEach(function(el) { el.remove(); });
        (state.hlMatchingLines || []).forEach(function(ln) {
          var lx = ln.pdfX != null ? Math.round(ln.pdfX * state.scale) : ln.x;
          var ly = ln.pdfY != null ? Math.round(ln.pdfY * state.scale) : ln.y;
          var lw = ln.pdfW != null ? Math.round(ln.pdfW * state.scale) : ln.w;
          var lh = ln.pdfH != null ? Math.round(ln.pdfH * state.scale) : ln.h;
          var prev = document.createElement('div');
          prev.className = 'ped-hl-bg-rect ped-hl-preview';
          prev.style.position = 'absolute';
          prev.style.left = lx + 'px';
          prev.style.top = ly + 'px';
          prev.style.width = lw + 'px';
          prev.style.height = lh + 'px';
          prev.style.backgroundColor = state.highlightColor || '#fef08a';
          prev.style.opacity = state.highlightOpacity || 0.85;
          prev.style.borderRadius = '2px';
          prev.style.pointerEvents = 'none';
          hlLayer.appendChild(prev);
        });
      }
    }
  });

  window.addEventListener('mouseup', function(e) {
    state.isErasing = false;
    var canvasPos = getCanvasPos(e);
    var overlayPos = getOverlayPos(e);
    var color = $('ann-color').value, width = parseInt($('ann-width').value) || 2;
    var fill = $('ann-fill-enable').checked, fillColor = $('ann-fill-color').value;
    var tool = state.activeTool;

    if (tool === 'highlight') {
      state.isHighlighting = false;
      if (hlLayer) {
        hlLayer.querySelectorAll('.ped-hl-preview').forEach(function(el) { el.remove(); });
      }
      var applied = applyHighlightFromSelection(state.highlightColor, state.highlightOpacity);
      if (applied) {
        state.hlMatchingLines = [];
        state.hlStart = null;
        return;
      }
      var lines = state.hlMatchingLines;
      if (!lines || lines.length === 0) {
        if (state.hlStart) {
          var minX = Math.min(state.hlStart.x, canvasPos.x);
          var maxX = Math.max(state.hlStart.x, canvasPos.x);
          var minY = Math.min(state.hlStart.y, canvasPos.y);
          var maxY = Math.max(state.hlStart.y, canvasPos.y);
          if (Math.hypot(maxX - minX, maxY - minY) > 5) {
            lines = getHighlightLinesForBox(state.currentPage, minX, maxX, minY, maxY);
          }
        }
      }
      if (lines && lines.length > 0) {
        var hlAnn = {
          type: 'highlight',
          id: Date.now(),
          color: state.highlightColor,
          opacity: state.highlightOpacity,
          lines: lines
        };
        pushAnn(hlAnn);
        renderPageElements(state.currentPage);
        var newWrap = annOverlay.querySelector('.highlight-wrap[data-ann-id="' + hlAnn.id + '"]');
        if (newWrap) selectElement(newWrap, hlAnn);
      } else {
        renderPageElements(state.currentPage);
      }
      state.hlMatchingLines = [];
      state.hlStart = null;
      return;
    }

    if (!state.isDrawing) return;
    state.isDrawing = false;

    if (tool === 'draw') {
      var pType = state.drawStrokeType || 'pen';
      var pColor = state.drawPenColor || color || '#000000';
      var pWidth = state.drawPenWidth || width || 2;
      pushAnn({
        type: 'draw',
        shape: 'freehand',
        strokeType: pType,
        pts: [...state.freehandPts],
        color: pColor,
        width: pWidth,
        alpha: pType === 'highlighter' ? 0.35 : (pType === 'marker' ? 0.85 : 1.0)
      });
      redrawAnnotations(state.currentPage);
    } else if (tool === 'line') {
      var sOverlay = state.drawStartOverlay || overlayPos;
      var minX = Math.min(sOverlay.x, overlayPos.x);
      var minY = Math.min(sOverlay.y, overlayPos.y);
      var maxX = Math.max(sOverlay.x, overlayPos.x);
      var maxY = Math.max(sOverlay.y, overlayPos.y);
      var w = Math.max(20, maxX - minX);
      var h = Math.max(20, maxY - minY);

      var shapeAnn = {
        type: 'shape',
        shape: state.activeShape || 'rect',
        id: Date.now(),
        x: minX,
        y: minY,
        w: w,
        h: h,
        x1: sOverlay.x,
        y1: sOverlay.y,
        x2: overlayPos.x,
        y2: overlayPos.y,
        color: $('shape-ctx-color') ? $('shape-ctx-color').value : color,
        width: $('shape-ctx-width') ? (parseInt($('shape-ctx-width').value) || width) : width,
        fill: $('shape-ctx-fill-enable') ? $('shape-ctx-fill-enable').checked : fill,
        fillColor: $('shape-ctx-fill-color') ? $('shape-ctx-fill-color').value : fillColor
      };
      pushAnn(shapeAnn);
      redrawAnnotations(state.currentPage);
      var newEl = annOverlay.querySelector('.shape-annotation[data-ann-id="' + shapeAnn.id + '"]');
      if (newEl) selectElement(newEl, shapeAnn);
      setTool(null);
    }
  });

  // ── ERASER FUNCTIONALITY (FIXED FOR THIN LINES) ─────────────
  function eraseAt(x, y) {
    var R = 28;
    var anns = state.pageAnns[state.currentPage] || [];
    var before = anns.length;

    state.pageAnns[state.currentPage] = anns.filter(function(a) {
      if (a.type === 'text' || a.type === 'edit-text') {
        return !(x >= a.x - 10 && x <= a.x + (a.w || 120) + 10 && y >= a.y - 10 && y <= a.y + (a.h || 30) + 10);
      }
      if (a.type === 'shape') {
        return !(x >= a.x - 10 && x <= a.x + a.w + 10 && y >= a.y - 10 && y <= a.y + a.h + 10);
      }
      if (a.type === 'image') {
        return !(x >= a.x - 5 && x <= a.x + a.w + 5 && y >= a.y - 5 && y <= a.y + a.h + 5);
      }
      if (a.type === 'draw' && a.shape === 'freehand') {
        if (!a.pts || a.pts.length < 2) return false;
        for (var i = 0; i < a.pts.length - 1; i++) {
          if (distToSegment(x, y, a.pts[i].x, a.pts[i].y, a.pts[i + 1].x, a.pts[i + 1].y) < R + (a.width || 2)) return false;
        }
        return true;
      }
      if (a.type === 'draw' && (a.shape === 'line' || a.shape === 'arrow')) {
        return distToSegment(x, y, a.x1, a.y1, a.x2, a.y2) > R + (a.width || 2);
      }
      if (a.type === 'draw' && a.shape === 'rect') {
        var d1 = distToSegment(x, y, a.x1, a.y1, a.x2, a.y1);
        var d2 = distToSegment(x, y, a.x2, a.y1, a.x2, a.y2);
        var d3 = distToSegment(x, y, a.x2, a.y2, a.x1, a.y2);
        var d4 = distToSegment(x, y, a.x1, a.y2, a.x1, a.y1);
        var inside = a.fill && (x >= Math.min(a.x1, a.x2) && x <= Math.max(a.x1, a.x2) && y >= Math.min(a.y1, a.y2) && y <= Math.max(a.y1, a.y2));
        return Math.min(d1, d2, d3, d4) > R && !inside;
      }
      if (a.type === 'draw' && a.shape === 'circle') {
        var cx = (a.x1 + a.x2) / 2, cy = (a.y1 + a.y2) / 2;
        var rx = Math.max(1, Math.abs(a.x2 - a.x1) / 2);
        var d = Math.abs(Math.hypot(x - cx, y - cy) - rx);
        return d > R;
      }
      if (a.type === 'highlight') {
        return !(x >= Math.min(a.x1, a.x2) - 5 && x <= Math.max(a.x1, a.x2) + 5 && y >= Math.min(a.y1, a.y2) - 5 && y <= Math.max(a.y1, a.y2) + 5);
      }
      return true;
    });

    if (state.pageAnns[state.currentPage].length !== before) {
      redrawAnnotations(state.currentPage);
      pushUndoSnapshot();
    }
  }

  // ── UNDO / REDO ──────────────────────────────────────────
  function pushAnn(a) {
    if (!state.doc.annotations[state.currentPage]) state.doc.annotations[state.currentPage] = [];
    state.doc.annotations[state.currentPage].push(a);
    pushUndoSnapshot();
  }

  function pushUndoSnapshot() {
    state.undoStack.push({
      page: state.currentPage,
      anns: JSON.parse(JSON.stringify(state.doc.annotations[state.currentPage] || [])),
      blocks: JSON.parse(JSON.stringify(state.doc.textBlocks[state.currentPage] || []))
    });
    state.redoStack = [];
    updateUndoRedoBtns();
  }

  function updateUndoRedoBtns() {
    $('tb-undo').disabled = state.undoStack.length === 0;
    $('tb-redo').disabled = state.redoStack.length === 0;
  }

  $('tb-undo').addEventListener('click', function() {
    if (!state.undoStack.length) return;
    var e = state.undoStack.pop();
    state.redoStack.push({
      page: e.page,
      anns: JSON.parse(JSON.stringify(state.doc.annotations[e.page] || [])),
      blocks: JSON.parse(JSON.stringify(state.doc.textBlocks[e.page] || []))
    });
    var prev = null;
    for (var i = state.undoStack.length - 1; i >= 0; i--) {
      if (state.undoStack[i].page === e.page) { prev = state.undoStack[i]; break; }
    }
    state.doc.annotations[e.page] = prev ? JSON.parse(JSON.stringify(prev.anns)) : [];
    if (prev && prev.blocks) {
      state.doc.textBlocks[e.page] = JSON.parse(JSON.stringify(prev.blocks));
    }
    if (e.page === state.currentPage) renderPageElements(state.currentPage);
    updateUndoRedoBtns();
  });

  $('tb-redo').addEventListener('click', function() {
    if (!state.redoStack.length) return;
    var e = state.redoStack.pop();
    state.undoStack.push({
      page: e.page,
      anns: JSON.parse(JSON.stringify(state.doc.annotations[e.page] || [])),
      blocks: JSON.parse(JSON.stringify(state.doc.textBlocks[e.page] || []))
    });
    state.doc.annotations[e.page] = JSON.parse(JSON.stringify(e.anns));
    if (e.blocks) {
      state.doc.textBlocks[e.page] = JSON.parse(JSON.stringify(e.blocks));
    }
    if (e.page === state.currentPage) renderPageElements(state.currentPage);
    updateUndoRedoBtns();
  });

  // ── TOOL ACTIVATION ──────────────────────────────────────
  function setTool(tool) {
    commitCurrentTextEdit();
    state.activeTool = tool;
    document.querySelectorAll('.ped-tool-btn').forEach(function(b) {
      b.classList.toggle('tool-active', b.dataset.tool === tool);
    });

    var cm = {
      text: 'crosshair', 'text-edit': 'default', 'place-image': 'crosshair', 'place-sign': 'crosshair',
      draw: 'crosshair', line: 'crosshair', highlight: 'text', eraser: 'cell'
    };
    annCanvas.style.cursor = cm[tool] || 'default';

    if (tool === 'highlight' || tool === 'text-edit' || !tool) {
      annCanvas.style.pointerEvents = 'none';
      pageWrapper.classList.toggle('tool-highlight-mode', tool === 'highlight');
    } else {
      annCanvas.style.pointerEvents = 'all';
      pageWrapper.classList.remove('tool-highlight-mode');
    }

    textCtxToolbar.classList.add('ped-hidden');
    drawCtxToolbar.classList.add('ped-hidden');
    shapeCtxToolbar.classList.add('ped-hidden');
    highlightCtxToolbar.classList.add('ped-hidden');

    if (tool === 'text') {
      deselectAll();
      textCtxToolbar.classList.remove('ped-hidden');
      syncToolbarToNewText();
      $('text-ctx-hint').textContent = 'Click anywhere on page to place text box';
      setStatus('Click anywhere on the PDF to place a text box');
    } else if (tool === 'text-edit') {
      textCtxToolbar.classList.remove('ped-hidden');
      $('text-ctx-hint').textContent = 'Click any text box to select or edit';
      setStatus('Click any text box to select or edit');
    } else if (tool === 'draw') {
      drawCtxToolbar.classList.remove('ped-hidden');
      setStatus('Draw tool active. Choose pen stroke type, width, and color in the tray above.');
    } else if (tool === 'line') {
      shapeCtxToolbar.classList.remove('ped-hidden');
      setStatus('Shape tool active. Drag on page to draw shape, then adjust color & fill.');
    } else if (tool === 'highlight') {
      deselectAll();
      highlightCtxToolbar.classList.remove('ped-hidden');
      $('hl-delete-btn').classList.add('ped-hidden');
      setStatus('Highlight tool active: Drag or select text to highlight');
    } else if (tool === 'place-image') {
      setStatus('Click anywhere on the PDF to place your image');
    } else if (tool === 'place-sign') {
      setStatus('Click anywhere on the PDF to place your signature');
    } else if (tool === 'eraser') {
      setStatus('Click or drag across lines and shapes to erase them');
      deselectAll();
    } else {
      if (!state.selectedEl) {
        deselectAll();
      }
    }
    renderPageElements(state.currentPage);
  }

