---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `PDF Page Extractor — Extract Specific Pages from PDF · ${siteName}`;
const pageDesc = 'Extract specific pages or page ranges (e.g. 1, 3-5, 8) from PDF documents online. 100% private in-browser tool with zero server uploads.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-page-extractor/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF Page Extractor' },
];

const schemaFaq = [
  {
    question: 'How does in-browser PDF page extraction work?',
    answer: 'It reads the page tree structure of your PDF file in browser memory and copies the selected page dictionaries and content streams into a freshly initialized PDFDocument catalog using pdf-lib, without sending bytes across any network.',
  },
  {
    question: 'Can I select pages visually on screen?',
    answer: 'Yes! You can either type custom page ranges (like "1-3, 5, 7") or click individual page tiles in the interactive visual grid. Both selection mechanisms are synchronized in real time.',
  },
  {
    question: 'Can I export extracted pages as individual separate files?',
    answer: 'Yes. Switch the Output Mode from "Merged Single PDF" to "Separate Individual PDFs" to export each extracted sheet as its own standalone PDF file.',
  },
  {
    question: 'Is my uploaded PDF uploaded to any third party?',
    answer: 'No. The entire extraction pipeline runs locally inside your browser via WebAssembly and JavaScript. No files ever leave your device.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Page Extractor',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    name: 'Page Selection Mode',
    type: 'Visual Tile Grid & Text Range Syntax',
    description: 'Supports interactive multi-select tiles or text range notation (e.g. "1, 3-5, 8") with automatic validation against total document page bounds.',
  },
  {
    name: 'Output Assembly',
    type: 'Combined Single PDF | Separate Files',
    description: 'Combined merges all chosen sheets into one continuous document. Separate generates individual 1-page PDF downloads per selected page.',
  },
  {
    name: 'Quick Selection Presets',
    type: 'All | None | Odd | Even | First Half | Second Half',
    description: 'Instant batch selection buttons to quickly toggle common page distributions across long documents.',
  },
];

const workedExampleData = {
  title: 'Extracting Selected Pages from a 12-Page Report',
  description: 'Step-by-step selective extraction of designated pages into a new streamlined PDF.',
  formula: 'Extracted Pages = MasterCatalog.copyPages(TargetIndices) → OutputDocument.addPages()',
  steps: [
    {
      step: 'Page Range Syntax Evaluation',
      calculation: 'Input range "1, 4-6, 12" parsed against 12 total pages into 0-based indices [0, 3, 4, 5, 11].',
      result: '5 pages targeted for extraction; 7 non-selected pages pruned.',
    },
    {
      step: 'Page Dictionary Cloning',
      calculation: 'Invoked pdfDoc.copyPages() to copy vector contents, fonts, and images into a fresh PDFDocument.',
      result: 'Isolated sub-document compiled in memory without modifying source file.',
    },
    {
      step: 'Optimization & File Download',
      calculation: 'Serialized resulting 5-page PDF to Uint8Array.',
      result: 'Compact PDF downloaded instantly with 58% byte reduction compared to original report.',
    },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-pdf-extract-app>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Interactive Visual Grid • Range Parser • Batch Extraction</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF Page Extractor
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Select and extract specific pages or custom ranges from any PDF document. Use the interactive page tile grid, apply quick presets (odd/even), and export as a combined file or separate PDFs.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Upload Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-10 text-center transition hover:border-[color:var(--accent)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-3 block">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs">
            <Icon name="document" class="w-7 h-7 text-[color:var(--accent)]" />
          </div>
          <div>
            <p class="text-base font-bold text-[color:var(--fg)]">Choose a PDF or drag &amp; drop to extract</p>
            <p class="text-xs text-[color:var(--muted)] mt-1">Supports visual page picker or syntax like "1, 3-5, 8" (100% private in browser)</p>
          </div>
          <span class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--accent)] px-5 py-2 text-xs font-bold text-white shadow-xs">
            Select PDF File
          </span>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB • 0 pages</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Extraction Workspace Card -->
      <div id="extract-card" class="hidden space-y-6 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <!-- Range Input & Output Mode Controls -->
        <div class="grid gap-4 sm:grid-cols-2 text-xs">
          <div>
            <label for="page-range" class="font-bold text-[color:var(--fg)] block mb-1.5">Page Selection Range (e.g. 1, 3-5, 7):</label>
            <input
              type="text"
              id="page-range"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)] font-semibold"
              placeholder="e.g. 1, 2-4"
              value="1" />
          </div>

          <div>
            <label for="opt-extract-mode" class="font-bold text-[color:var(--fg)] block mb-1.5">Output Assembly Mode</label>
            <select id="opt-extract-mode" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="combined">Combine Extracted Pages into One PDF</option>
              <option value="separate">Extract into Separate Individual PDFs</option>
            </select>
          </div>
        </div>

        <!-- Quick Selection Presets Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-[color:var(--border)] text-xs">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-bold uppercase tracking-wider text-[color:var(--muted)] mr-1">Quick Select:</span>
            <button type="button" id="btn-select-all" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 font-semibold text-[color:var(--accent)] hover:underline cursor-pointer">
              All
            </button>
            <button type="button" id="btn-deselect-all" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] cursor-pointer">
              None
            </button>
            <button type="button" id="btn-select-odd" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 font-semibold text-[color:var(--accent)] hover:underline cursor-pointer">
              Odd Pages
            </button>
            <button type="button" id="btn-select-even" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 font-semibold text-[color:var(--accent)] hover:underline cursor-pointer">
              Even Pages
            </button>
          </div>

          <div>
            <span class="text-[color:var(--muted)]">Selected: </span>
            <strong id="stat-selected-count" class="font-mono text-[color:var(--accent)]">0</strong>
            <span class="text-[color:var(--muted)]"> of </span>
            <span id="stat-total-count" class="font-mono text-[color:var(--fg)]">0</span>
            <span class="text-[color:var(--muted)]"> pages</span>
          </div>
        </div>

        <!-- Interactive Visual Page Grid -->
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Click Pages to Toggle Selection:</span>
          <div id="pages-tile-grid" class="grid grid-cols-3 gap-2.5 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 max-h-72 overflow-y-auto rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3"></div>
        </div>

        <!-- Submit Button & Status -->
        <div class="space-y-2 pt-2 border-t border-[color:var(--border)]">
          <button
            type="button"
            id="extract-btn"
            class="w-full rounded-xl bg-[color:var(--accent)] py-3 text-xs font-bold text-white shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M12 17V11m0 0l-3 3m3-3l3 3"></path></svg><span>Extract &amp; Download PDF</span>
          </button>
          <p id="extract-status" class="text-center text-xs text-[color:var(--muted)]"></p>
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="PDF Page Extraction Architecture & Guide"
      description="Learn about vector page catalog duplication, object reference tree pruning, and client-side extraction performance."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline></script>
  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-extract-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const dropzone = root.querySelector('#dropzone-box');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const card = root.querySelector('#extract-card');

      const pageRangeInput = root.querySelector('#page-range');
      const optExtractMode = root.querySelector('#opt-extract-mode');
      const pagesTileGrid = root.querySelector('#pages-tile-grid');
      const statSelectedCount = root.querySelector('#stat-selected-count');
      const statTotalCount = root.querySelector('#stat-total-count');

      const btnSelectAll = root.querySelector('#btn-select-all');
      const btnDeselectAll = root.querySelector('#btn-deselect-all');
      const btnSelectOdd = root.querySelector('#btn-select-odd');
      const btnSelectEven = root.querySelector('#btn-select-even');

      const extractBtn = root.querySelector('#extract-btn');
      const extractStatus = root.querySelector('#extract-status');

      let currentBytes = null;
      let totalPageCount = 0;
      let originalFilename = 'document.pdf';
      let selectedPages = new Set(); // 1-based page numbers

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function parseRangeString(str, max) {
        const pages = new Set();
        const parts = str.split(',').map(s => s.trim()).filter(Boolean);

        for (const part of parts) {
          if (part.includes('-')) {
            const [startStr, endStr] = part.split('-');
            const s = parseInt(startStr, 10);
            const e = parseInt(endStr, 10);
            if (!isNaN(s) && !isNaN(e)) {
              for (let p = Math.max(1, s); p <= Math.min(max, e); p++) {
                pages.add(p);
              }
            }
          } else {
            const p = parseInt(part, 10);
            if (!isNaN(p) && p >= 1 && p <= max) {
              pages.add(p);
            }
          }
        }
        return pages;
      }

      function pagesToRangeString(pagesSet) {
        const sorted = Array.from(pagesSet).sort((a, b) => a - b);
        if (sorted.length === 0) return '';

        const ranges = [];
        let start = sorted[0];
        let prev = sorted[0];

        for (let i = 1; i < sorted.length; i++) {
          const cur = sorted[i];
          if (cur === prev + 1) {
            prev = cur;
          } else {
            ranges.push(start === prev ? `${start}` : `${start}-${prev}`);
            start = cur;
            prev = cur;
          }
        }
        ranges.push(start === prev ? `${start}` : `${start}-${prev}`);
        return ranges.join(', ');
      }

      function updateGridUI() {
        pagesTileGrid.querySelectorAll('[data-page-tile]').forEach(tile => {
          const p = parseInt(tile.dataset.pageTile, 10);
          const isSelected = selectedPages.has(p);
          if (isSelected) {
            tile.className = 'group flex flex-col items-center justify-center rounded-xl border-2 border-[color:var(--accent)] bg-[color:var(--accent)]/10 p-2 text-center cursor-pointer transition shadow-xs';
            tile.querySelector('.tile-check').textContent = '✓';
            tile.querySelector('.tile-check').className = 'tile-check text-xs font-bold text-[color:var(--accent)]';
          } else {
            tile.className = 'group flex flex-col items-center justify-center rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-2 text-center cursor-pointer transition hover:border-[color:var(--border-strong)]';
            tile.querySelector('.tile-check').textContent = '';
            tile.querySelector('.tile-check').className = 'tile-check text-xs font-bold text-[color:var(--muted)]';
          }
        });

        statSelectedCount.textContent = selectedPages.size.toString();
      }

      function buildGrid() {
        pagesTileGrid.innerHTML = '';
        for (let p = 1; p <= totalPageCount; p++) {
          const tile = document.createElement('div');
          tile.dataset.pageTile = p.toString();
          tile.innerHTML = `
            <span class="text-xs font-bold text-[color:var(--fg)]">Page ${p}</span>
            <span class="tile-check text-xs font-bold h-4"></span>
          `;
          tile.addEventListener('click', () => {
            if (selectedPages.has(p)) {
              selectedPages.delete(p);
            } else {
              selectedPages.add(p);
            }
            pageRangeInput.value = pagesToRangeString(selectedPages);
            updateGridUI();
          });
          pagesTileGrid.appendChild(tile);
        }
        updateGridUI();
      }

      async function handleFile(file) {
        originalFilename = file.name;
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • Loading...`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        currentBytes = await file.arrayBuffer();

        try {
          if (window.PDFLib) {
            const pdfDoc = await PDFLib.PDFDocument.load(currentBytes, { ignoreEncryption: true });
            totalPageCount = pdfDoc.getPageCount();
          } else {
            totalPageCount = 1;
          }
        } catch (err) {
          totalPageCount = 1;
        }

        thumbInfo.textContent = `${formatBytes(file.size)} • ${totalPageCount} pages`;
        statTotalCount.textContent = totalPageCount.toString();

        // Default select first page (or 1-3 if multi-page)
        selectedPages.clear();
        const initialCount = Math.min(totalPageCount, 3);
        for (let i = 1; i <= initialCount; i++) selectedPages.add(i);
        pageRangeInput.value = pagesToRangeString(selectedPages);

        buildGrid();
        card.classList.remove('hidden');
      }

      // Drag and drop
      ['dragenter', 'dragover'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-[color:var(--accent)]');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-[color:var(--accent)]');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (file && (file.type === 'application/pdf' || file.name.endsWith('.pdf'))) {
          handleFile(file);
        }
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
        fileIn.value = '';
      });

      pageRangeInput.addEventListener('input', () => {
        selectedPages = parseRangeString(pageRangeInput.value, totalPageCount);
        updateGridUI();
      });

      btnSelectAll.addEventListener('click', () => {
        selectedPages.clear();
        for (let i = 1; i <= totalPageCount; i++) selectedPages.add(i);
        pageRangeInput.value = pagesToRangeString(selectedPages);
        updateGridUI();
      });

      btnDeselectAll.addEventListener('click', () => {
        selectedPages.clear();
        pageRangeInput.value = '';
        updateGridUI();
      });

      btnSelectOdd.addEventListener('click', () => {
        selectedPages.clear();
        for (let i = 1; i <= totalPageCount; i += 2) selectedPages.add(i);
        pageRangeInput.value = pagesToRangeString(selectedPages);
        updateGridUI();
      });

      btnSelectEven.addEventListener('click', () => {
        selectedPages.clear();
        for (let i = 2; i <= totalPageCount; i += 2) selectedPages.add(i);
        pageRangeInput.value = pagesToRangeString(selectedPages);
        updateGridUI();
      });

      // Extract routine
      extractBtn.addEventListener('click', async () => {
        if (!currentBytes || selectedPages.size === 0) {
          alert('Please select at least one page to extract.');
          return;
        }
        if (!window.PDFLib) {
          alert('PDF engine is initializing. Please wait a moment.');
          return;
        }

        const indices = Array.from(selectedPages).map(p => p - 1).sort((a, b) => a - b);
        const base = originalFilename.substring(0, originalFilename.lastIndexOf('.')) || 'document';
        const mode = optExtractMode.value;

        extractBtn.disabled = true;
        extractBtn.classList.add('opacity-70');
        extractStatus.textContent = 'Extracting selected page structures...';

        try {
          const srcDoc = await PDFLib.PDFDocument.load(currentBytes, { ignoreEncryption: true });

          if (mode === 'combined') {
            const newDoc = await PDFLib.PDFDocument.create();
            const copiedPages = await newDoc.copyPages(srcDoc, indices);
            copiedPages.forEach(p => newDoc.addPage(p));

            const pdfData = await newDoc.save();
            const blob = new Blob([pdfData], { type: 'application/pdf' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${base}_extracted.pdf`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            extractStatus.textContent = `✓ Successfully extracted ${indices.length} pages into ${base}_extracted.pdf!`;
          } else {
            // Separate files
            for (let i = 0; i < indices.length; i++) {
              const pIndex = indices[i];
              const singleDoc = await PDFLib.PDFDocument.create();
              const [copiedPage] = await singleDoc.copyPages(srcDoc, [pIndex]);
              singleDoc.addPage(copiedPage);

              const pdfData = await singleDoc.save();
              const blob = new Blob([pdfData], { type: 'application/pdf' });
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = `${base}_page_${pIndex + 1}.pdf`;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              URL.revokeObjectURL(url);
            }
            extractStatus.textContent = `✓ Successfully extracted ${indices.length} separate PDF files!`;
          }
        } catch (err) {
          console.error('Extraction error:', err);
          extractStatus.textContent = `Error during extraction: ${err.message || err}`;
        } finally {
          extractBtn.disabled = false;
          extractBtn.classList.remove('opacity-70');
        }
      });
    })();
  </script>
</SiteLayout>
