---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl } from '../../utils/site';

const pageTitle = `PDF Page Rotator — Rotate PDF Pages 90, 180, 270 Degrees Online · ${siteName}`;
const pageDesc = 'Free PDF page rotator tool. Rotate PDF pages permanently by 90, 180, or 270 degrees clockwise or counter-clockwise online for print-ready documents with 100% private in-browser processing.';
const canonicalUrl = toAbsoluteUrl('/pdf-tools/pdf-rotate/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'PDF Tools', href: toAbsoluteUrl('/pdf-tools/') },
  { label: 'PDF Rotate' },
];

const schemaFaq = [
  {
    question: 'How does PDF page rotation work in the browser?',
    answer: 'It updates the `/Rotate` attribute in the PDF document’s page dictionary objects (0, 90, 180, 270) in memory using pdf-lib, generating a permanently re-oriented PDF file without re-compressing or rasterizing vector text.',
  },
  {
    question: 'Can I rotate only odd or even pages?',
    answer: 'Yes! You can choose to rotate all pages, odd pages only, even pages only, or enter a custom range of specific page numbers (e.g. "1, 3-5").',
  },
  {
    question: 'Does rotating a PDF degrade its visual quality?',
    answer: 'No. The rotation modifies only the mathematical transformation matrix in the PDF page metadata. All embedded text fonts, vector graphics, and images remain at their original 100% native quality.',
  },
  {
    question: 'Is my document uploaded to any external server?',
    answer: 'No. All PDF binary manipulations execute 100% locally in your web browser memory. No files or information ever leave your device.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Page Rotator',
    url: canonicalUrl,
    applicationCategory: 'DocumentApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const parameterGuideData = [
  {
    name: 'Rotation Angle',
    type: '90° Clockwise | 180° Flip | 270° Counter-Clockwise',
    description: 'Degree increment applied to the target page transformation matrix. Positive values rotate clockwise.',
  },
  {
    name: 'Target Page Scope',
    type: 'All Pages | Odd Pages | Even Pages | Custom Range',
    description: 'Selects which subset of the document receives the rotation matrix adjustment, leaving the rest intact.',
  },
  {
    name: 'Output Filename',
    type: 'String (Default: "rotated-document.pdf")',
    description: 'Specifies the download filename for the newly oriented PDF document.',
  },
];

const workedExampleData = {
  title: 'Worked Example & Step-by-Step Walkthrough',
  description: 'A practical demonstration of rotating specific pages in an 8-page document.',
  formula: 'NewAngle = (CurrentAngle + RotationIncrement) mod 360°',
  steps: [
    {
      step: 'Step 1: Parse Document Catalog & Page Dictionaries',
      calculation: '8-page PDF loaded; Target Scope set to "Odd Pages" (Pages 1, 3, 5, 7); Angle = 90° CW.',
      result: 'Identified 4 odd pages for transformation matrix updates.',
    },
    {
      step: 'Step 2: Update Rotation Metadata',
      calculation: 'Updated `/Rotate` property on pages 1, 3, 5, 7 from 0° to 90°. Even pages (2, 4, 6, 8) unchanged at 0°.',
      result: 'Output PDF compiled and downloaded in ~400ms without quality loss.',
    },
  ],
};
---

<SiteLayout heroCompact={true} title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  
  <div slot="hero" class="site-hero-header">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Lossless Matrix Rotation • Selective Page Scope • Instant Download</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        PDF Page Rotator — Rotate PDF Pages Online Free
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Rotate sideways or upside-down PDF pages permanently by 90, 180, or 270 degrees in your browser to create print-ready PDF files. Choose all pages, odd/even pages, or custom ranges with lossless quality and 100% client-side privacy.
      </p>
    </header>
  </div>

  <article class="space-y-10 py-2" data-pdf-rotate-app>

    <div class="space-y-6">
      <!-- Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-10 text-center transition hover:border-[color:var(--accent)]">
        <input type="file" id="pdf-file" accept="application/pdf" class="hidden" />
        <label for="pdf-file" id="upload-prompt" class="cursor-pointer space-y-3 block">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] shadow-xs">
            <Icon name="document" class="w-7 h-7 text-[color:var(--accent)]" />
          </div>
          <div>
            <p class="text-base font-bold text-[color:var(--fg)]">Choose a PDF or drag &amp; drop to rotate</p>
            <p class="text-xs text-[color:var(--muted)] mt-1">Permanently rotates pages without quality loss (100% private in browser)</p>
          </div>
          <span class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--accent)] px-5 py-2 text-xs font-bold text-white shadow-xs">
            Select PDF File
          </span>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-red-500 font-black text-xs border border-red-500/20">
              PDF
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">document.pdf</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB • 0 pages</p>
            </div>
          </div>
          <label for="pdf-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change File
          </label>
        </div>
      </div>

      <!-- Settings & Download Card -->
      <div id="rotate-card" class="hidden space-y-6 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 text-xs">
          <div>
            <label for="rot-deg" class="font-bold text-[color:var(--fg)] block mb-1.5">Rotation Angle</label>
            <select id="rot-deg" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="90">90° Clockwise</option>
              <option value="180">180° (Upside Down)</option>
              <option value="270">270° (90° Counter-Clockwise)</option>
            </select>
          </div>

          <div>
            <label for="rot-scope" class="font-bold text-[color:var(--fg)] block mb-1.5">Target Pages</label>
            <select id="rot-scope" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
              <option value="all">All Pages in Document</option>
              <option value="odd">Odd Pages Only (1, 3, 5...)</option>
              <option value="even">Even Pages Only (2, 4, 6...)</option>
              <option value="custom">Custom Page Range</option>
            </select>
          </div>

          <div id="custom-range-box" class="hidden">
            <label for="custom-range-in" class="font-bold text-[color:var(--fg)] block mb-1.5">Page Range Specification</label>
            <input
              type="text"
              id="custom-range-in"
              placeholder="e.g. 1-3, 5"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)] font-semibold" />
          </div>
        </div>

        <!-- Visual Page Catalog & Live Interactive Rotator -->
        <div class="space-y-3 pt-2 border-t border-[color:var(--border)]">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Visual Page Catalog</span>
              <span id="rotate-page-count-badge" class="rounded-full bg-[color:var(--surface-strong)] px-2.5 py-0.5 font-mono text-[11px] font-bold text-[color:var(--accent)]">
                0 pages
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-1.5 text-xs">
              <button type="button" id="btn-rot-all-cw" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-[11px] font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition cursor-pointer">
                ↻ Rotate All +90°
              </button>
              <button type="button" id="btn-rot-all-ccw" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-[11px] font-semibold text-[color:var(--fg)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition cursor-pointer">
                ↺ Rotate All -90°
              </button>
              <button type="button" id="btn-rot-reset" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-[11px] font-semibold text-rose-500 hover:bg-rose-500/10 transition cursor-pointer">
                Reset (0°)
              </button>
            </div>
          </div>
          <p class="text-[11px] text-[color:var(--muted)]">
            Click on any page's rotate icon (<span class="text-[color:var(--accent)] font-bold">↻</span>) to rotate that page individually, or use the batch controls above.
          </p>

          <div id="rotate-tile-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 pt-1">
            <!-- Dynamic Page Tiles rendered by JS -->
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 pt-2 border-t border-[color:var(--border)] text-xs">
          <div>
            <label for="rot-filename" class="font-bold text-[color:var(--fg)] block mb-1">Output Filename</label>
            <input
              type="text"
              id="rot-filename"
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-mono"
              value="rotated-document.pdf" />
          </div>
        </div>

        <!-- Submit Button & Status -->
        <div class="space-y-2 pt-2 border-t border-[color:var(--border)]">
          <button
            type="button"
            id="rotate-btn"
            class="w-full rounded-xl bg-[color:var(--accent)] py-3 text-xs font-bold text-white shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg><span>Rotate &amp; Download PDF</span>
          </button>
          <p id="rotate-status" class="text-center text-xs text-[color:var(--muted)]"></p>
        </div>
      </div>
    </div>

    <!-- Full-Page Zoom Inspection Modal -->
    <div id="page-zoom-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="relative max-w-3xl w-full max-h-[92vh] bg-[color:var(--surface)] border border-[color:var(--border)] rounded-3xl p-5 shadow-2xl flex flex-col items-center">
        <div class="flex w-full items-center justify-between pb-3 border-b border-[color:var(--border)] mb-3">
          <h4 id="zoom-title" class="font-bold text-sm text-[color:var(--fg)]">Page Preview</h4>
          <button type="button" id="close-zoom-btn" class="rounded-xl bg-[color:var(--surface-strong)] text-[color:var(--fg)] px-3 py-1 text-xs font-bold hover:bg-[color:var(--border)] cursor-pointer">
            Close ✕
          </button>
        </div>
        <div class="overflow-auto max-h-[75vh] w-full flex items-center justify-center bg-slate-950/20 rounded-xl p-2">
          <img id="zoom-img" alt="Zoomed Page Preview" class="max-h-[72vh] max-w-full object-contain rounded-lg shadow-md transition-transform duration-200" />
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="PDF Rotation Geometry & Transformation Guide"
      description="Understand PDF page /Rotate dictionaries, coordinate matrix transformations, and selective page scope partitioning."
      parameters={parameterGuideData}
      workedExample={workedExampleData}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <svg class="w-4 h-4 text-[color:var(--muted)] group-open:rotate-180 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <!-- PDF.js & PDF-Lib CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline></script>
  <script is:inline>
    (function () {
      const root = document.querySelector('[data-pdf-rotate-app]');
      if (!root) return;

      const fileIn = root.querySelector('#pdf-file');
      const dropzone = root.querySelector('#dropzone-box');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const card = root.querySelector('#rotate-card');

      const rotDegSelect = root.querySelector('#rot-deg');
      const rotScopeSelect = root.querySelector('#rot-scope');
      const customRangeBox = root.querySelector('#custom-range-box');
      const customRangeIn = root.querySelector('#custom-range-in');
      const rotFilenameInput = root.querySelector('#rot-filename');

      const rotatePageCountBadge = root.querySelector('#rotate-page-count-badge');
      const rotateTileGrid = root.querySelector('#rotate-tile-grid');
      const btnRotAllCw = root.querySelector('#btn-rot-all-cw');
      const btnRotAllCcw = root.querySelector('#btn-rot-all-ccw');
      const btnRotReset = root.querySelector('#btn-rot-reset');

      const rotateBtn = root.querySelector('#rotate-btn');
      const rotateStatus = root.querySelector('#rotate-status');

      // Modal elements
      const zoomModal = root.querySelector('#page-zoom-modal');
      const zoomTitle = root.querySelector('#zoom-title');
      const zoomImg = root.querySelector('#zoom-img');
      const closeZoomBtn = root.querySelector('#close-zoom-btn');

      if (closeZoomBtn && zoomModal) {
        closeZoomBtn.addEventListener('click', () => zoomModal.classList.add('hidden'));
        zoomModal.addEventListener('click', (e) => {
          if (e.target === zoomModal) zoomModal.classList.add('hidden');
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !zoomModal.classList.contains('hidden')) {
            zoomModal.classList.add('hidden');
          }
        });
      }

      if (window.pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      let currentBytes = null;
      let totalPages = 0;
      let originalFilename = 'document.pdf';
      let currentPdfJsDoc = null;
      const pageThumbnails = {}; // p -> dataUrl
      // State: Map of pageNum (1-based) -> cumulative rotation degrees to apply (0, 90, 180, 270)
      const pageRotations = {};

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function parseCustomRange(str, max) {
        const pages = new Set();
        const parts = str.split(',').map(s => s.trim()).filter(Boolean);
        for (const part of parts) {
          if (part.includes('-')) {
            const [startStr, endStr] = part.split('-');
            const s = parseInt(startStr, 10);
            const e = parseInt(endStr, 10);
            if (!isNaN(s) && !isNaN(e)) {
              for (let p = Math.max(1, s); p <= Math.min(max, e); p++) pages.add(p);
            }
          } else {
            const p = parseInt(part, 10);
            if (!isNaN(p) && p >= 1 && p <= max) pages.add(p);
          }
        }
        return pages;
      }

      function updateTileRotationUI(p) {
        const tile = rotateTileGrid.querySelector(`[data-rotate-tile="${p}"]`);
        if (!tile) return;

        const deg = pageRotations[p] || 0;
        const img = tile.querySelector('.tile-thumb-img');
        const badge = tile.querySelector('.tile-rot-badge');

        if (img) {
          img.style.transform = `rotate(${deg}deg)`;
        }
        if (badge) {
          if (deg % 360 === 0) {
            badge.textContent = '0°';
            badge.className = 'tile-rot-badge rounded bg-[color:var(--surface-strong)] text-[color:var(--muted)] px-1.5 py-0.5 text-[10px] font-bold';
          } else {
            badge.textContent = `+${deg % 360}°`;
            badge.className = 'tile-rot-badge rounded bg-amber-500/15 text-amber-600 dark:text-amber-400 px-1.5 py-0.5 text-[10px] font-bold';
          }
        }
      }

      function applyBatchRotation(addAngle, scopeFilter) {
        let targets = new Set();
        if (scopeFilter === 'all') {
          for (let p = 1; p <= totalPages; p++) targets.add(p);
        } else if (scopeFilter === 'odd') {
          for (let p = 1; p <= totalPages; p += 2) targets.add(p);
        } else if (scopeFilter === 'even') {
          for (let p = 2; p <= totalPages; p += 2) targets.add(p);
        } else if (scopeFilter === 'custom') {
          targets = parseCustomRange(customRangeIn.value, totalPages);
        }

        targets.forEach(p => {
          pageRotations[p] = ((pageRotations[p] || 0) + addAngle + 360) % 360;
          updateTileRotationUI(p);
        });
      }

      async function openZoomModal(p) {
        if (!zoomModal || !zoomImg) return;
        const curRot = pageRotations[p] || 0;
        zoomTitle.textContent = `Page ${p} of ${totalPages} — Full Inspection (${curRot}° Rotation)`;
        zoomModal.classList.remove('hidden');
        zoomImg.style.transform = `rotate(${curRot}deg)`;

        if (currentPdfJsDoc) {
          try {
            const page = await currentPdfJsDoc.getPage(p);
            const unscaledViewport = page.getViewport({ scale: 1 });
            const targetW = Math.min(1200, window.innerWidth * 0.85);
            const scale = targetW / unscaledViewport.width;
            const viewport = page.getViewport({ scale: scale });

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');

            await page.render({ canvasContext: ctx, viewport: viewport }).promise;
            zoomImg.src = canvas.toDataURL('image/jpeg', 0.9);
          } catch (err) {
            console.error('Error rendering zoom page:', err);
            if (pageThumbnails[p]) zoomImg.src = pageThumbnails[p];
          }
        } else if (pageThumbnails[p]) {
          zoomImg.src = pageThumbnails[p];
        }
      }

      async function renderThumbnailsAsync() {
        if (!currentPdfJsDoc) return;

        for (let p = 1; p <= totalPages; p++) {
          try {
            const page = await currentPdfJsDoc.getPage(p);
            const unscaledViewport = page.getViewport({ scale: 1 });
            const targetWidth = 190;
            const scale = targetWidth / unscaledViewport.width;
            const viewport = page.getViewport({ scale: scale });

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');

            await page.render({ canvasContext: ctx, viewport: viewport }).promise;
            const thumbUrl = canvas.toDataURL('image/jpeg', 0.85);
            pageThumbnails[p] = thumbUrl;

            const tile = rotateTileGrid.querySelector(`[data-rotate-tile="${p}"]`);
            if (tile) {
              const loadingEl = tile.querySelector('.tile-loading');
              const imgEl = tile.querySelector('.tile-thumb-img');
              if (loadingEl) loadingEl.classList.add('hidden');
              if (imgEl) {
                imgEl.src = thumbUrl;
                imgEl.classList.remove('hidden');
              }
            }
          } catch (err) {
            console.error(`Error rendering thumb for page ${p}:`, err);
          }
        }
      }

      function buildGrid() {
        rotateTileGrid.innerHTML = '';
        rotatePageCountBadge.textContent = `${totalPages} pages`;

        for (let p = 1; p <= totalPages; p++) {
          const curRot = pageRotations[p] || 0;
          const thumbUrl = pageThumbnails[p];

          const tile = document.createElement('div');
          tile.dataset.rotateTile = p.toString();
          tile.className = 'group relative flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-2.5 shadow-xs transition hover:border-[color:var(--accent)] hover:shadow-md';

          tile.innerHTML = `
            <div class="flex w-full items-center justify-between text-[11px] font-bold text-[color:var(--muted)] pb-1.5 border-b border-[color:var(--border)]/60">
              <span class="rounded bg-[color:var(--surface-strong)] px-1.5 py-0.5 text-[color:var(--fg)]">Pg ${p}</span>
              <span class="tile-rot-badge rounded ${curRot % 360 === 0 ? 'bg-[color:var(--surface-strong)] text-[color:var(--muted)]' : 'bg-amber-500/15 text-amber-600 dark:text-amber-400'} px-1.5 py-0.5 text-[10px] font-bold">
                ${curRot % 360 === 0 ? '0°' : `+${curRot % 360}°`}
              </span>
            </div>

            <div class="relative my-2 flex aspect-3/4 w-full items-center justify-center overflow-hidden rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)]">
              <div class="tile-loading ${thumbUrl ? 'hidden' : 'flex'} absolute inset-0 items-center justify-center text-[10px] text-[color:var(--muted)] font-medium animate-pulse">
                Pg ${p}...
              </div>
              <img src="${thumbUrl || ''}" class="tile-thumb-img ${thumbUrl ? '' : 'hidden'} max-h-full max-w-full object-contain pointer-events-none rounded transition-transform duration-200" style="transform: rotate(${curRot}deg);" alt="Page ${p}" />

              <!-- Zoom Inspect Button -->
              <button type="button" data-zoom="${p}" class="absolute top-1.5 right-1.5 rounded-md bg-white/95 dark:bg-slate-800/95 p-1 text-[color:var(--fg)] hover:scale-110 shadow-xs transition cursor-pointer" title="Zoom inspect page ${p}">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </button>
            </div>

            <div class="flex items-center justify-between border-t border-[color:var(--border)] pt-1.5">
              <button type="button" data-rotate-single="${p}" class="w-full flex items-center justify-center gap-1.5 rounded-xl bg-[color:var(--surface-strong)] hover:bg-[color:var(--accent)] hover:text-white py-1.5 text-xs font-bold text-[color:var(--fg)] transition cursor-pointer" title="Rotate this page 90° clockwise">
                <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
                <span>+90°</span>
              </button>
            </div>
          `;

          // Handlers
          tile.querySelector('[data-zoom]').addEventListener('click', () => {
            openZoomModal(p);
          });

          tile.querySelector('[data-rotate-single]').addEventListener('click', () => {
            pageRotations[p] = ((pageRotations[p] || 0) + 90) % 360;
            updateTileRotationUI(p);
          });

          rotateTileGrid.appendChild(tile);
        }
      }

      async function handleFile(file) {
        originalFilename = file.name;
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • Reading structure...`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        currentBytes = await file.arrayBuffer();

        try {
          if (window.PDFLib) {
            const pdfDoc = await PDFLib.PDFDocument.load(currentBytes, { ignoreEncryption: true });
            totalPages = pdfDoc.getPageCount();
          } else {
            totalPages = 1;
          }
        } catch (err) {
          totalPages = 1;
        }

        thumbInfo.textContent = `${formatBytes(file.size)} • ${totalPages} pages`;
        customRangeIn.placeholder = `1-${totalPages}`;

        // Reset rotations
        for (let p = 1; p <= totalPages; p++) {
          pageRotations[p] = 0;
        }

        buildGrid();
        card.classList.remove('hidden');

        // Render visual thumbnails
        if (window.pdfjsLib) {
          try {
            currentPdfJsDoc = await pdfjsLib.getDocument({ data: currentBytes.slice(0) }).promise;
            renderThumbnailsAsync();
          } catch (err) {
            console.error('PDF.js failed to load document for thumbnails:', err);
          }
        }
      }

      // Quick batch buttons
      btnRotAllCw.addEventListener('click', () => {
        applyBatchRotation(90, 'all');
      });

      btnRotAllCcw.addEventListener('click', () => {
        applyBatchRotation(-90, 'all');
      });

      btnRotReset.addEventListener('click', () => {
        for (let p = 1; p <= totalPages; p++) {
          pageRotations[p] = 0;
          updateTileRotationUI(p);
        }
      });

      // Also listen to select dropdown changes to sync
      rotDegSelect.addEventListener('change', () => {
        const deg = parseInt(rotDegSelect.value, 10) || 0;
        const scope = rotScopeSelect.value;
        // Apply select value to target scope
        let targets = new Set();
        if (scope === 'all') {
          for (let p = 1; p <= totalPages; p++) targets.add(p);
        } else if (scope === 'odd') {
          for (let p = 1; p <= totalPages; p += 2) targets.add(p);
        } else if (scope === 'even') {
          for (let p = 2; p <= totalPages; p += 2) targets.add(p);
        } else if (scope === 'custom') {
          targets = parseCustomRange(customRangeIn.value, totalPages);
        }

        targets.forEach(p => {
          pageRotations[p] = deg % 360;
          updateTileRotationUI(p);
        });
      });

      rotScopeSelect.addEventListener('change', () => {
        customRangeBox.classList.toggle('hidden', rotScopeSelect.value !== 'custom');
      });

      // Drag and drop
      ['dragenter', 'dragover'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.add('border-[color:var(--accent)]');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-[color:var(--accent)]');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (file && (file.type === 'application/pdf' || file.name.endsWith('.pdf'))) {
          handleFile(file);
        }
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
        fileIn.value = '';
      });

      // Rotate action & export
      rotateBtn.addEventListener('click', async () => {
        if (!currentBytes) return;
        if (!window.PDFLib) {
          alert('PDF-Lib engine is still loading. Please wait a moment.');
          return;
        }

        rotateBtn.disabled = true;
        rotateBtn.classList.add('opacity-70');
        rotateStatus.textContent = 'Applying rotation transformations to PDF page tree...';

        try {
          const pdfDoc = await PDFLib.PDFDocument.load(currentBytes, { ignoreEncryption: true });
          const pages = pdfDoc.getPages();
          let rotatedCount = 0;

          for (let p = 1; p <= pages.length; p++) {
            const rot = pageRotations[p] || 0;
            if (rot !== 0) {
              const page = pages[p - 1];
              const currentAngle = page.getRotation().angle;
              page.setRotation(PDFLib.degrees(currentAngle + rot));
              rotatedCount++;
            }
          }

          const pdfBytes = await pdfDoc.save();
          const blob = new Blob([pdfBytes], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;

          let filename = rotFilenameInput.value.trim() || 'rotated-document.pdf';
          if (!filename.toLowerCase().endsWith('.pdf')) filename += '.pdf';
          a.download = filename;

          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);

          rotateStatus.innerHTML = `<span class="inline-flex items-center gap-1.5 text-emerald-500 font-semibold"><svg class="w-4 h-4 inline shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Successfully transformed ${rotatedCount > 0 ? rotatedCount : totalPages} pages in ${filename}!</span>`;
        } catch (err) {
          console.error('Rotation error:', err);
          rotateStatus.textContent = `Error during rotation: ${err.message || err}`;
        } finally {
          rotateBtn.disabled = false;
          rotateBtn.classList.remove('opacity-70');
        }
      });
    })();
  </script>
</SiteLayout>
