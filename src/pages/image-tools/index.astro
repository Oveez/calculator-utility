---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Image & Privacy Tools | EXIF Remover, Color Picker, Compressor · ${siteName}`;
const pageDesc = 'Free client-side image inspection, privacy, and optimization tools. View and remove EXIF GPS metadata, check dimensions and DPI, pick colors, extract dominant palettes, compress, and convert image formats locally.';
const canonicalUrl = toAbsoluteUrl('/image-tools/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Image Tools' },
];

const imageToolsList = [
  {
    slug: 'exif-viewer',
    title: 'EXIF Metadata Viewer',
    badge: 'Popular',
    metaDescription: 'Inspect camera settings, ISO, exposure, lens, and GPS coordinates embedded inside photo EXIF tags.',
    href: withBasePath('/image-tools/exif-viewer/'),
    icon: 'image',
  },
  {
    slug: 'exif-remover',
    title: 'EXIF & GPS Remover',
    badge: 'Privacy',
    metaDescription: 'Strip sensitive EXIF metadata, camera serial numbers, and GPS geotags before sharing photos online.',
    href: withBasePath('/image-tools/exif-remover/'),
    icon: 'image',
  },
  {
    slug: 'image-metadata-viewer',
    title: 'Image File Metadata Viewer',
    badge: 'Inspection',
    metaDescription: 'Inspect image file size, MIME type, dimensions, color depth, and resolution in your browser.',
    href: withBasePath('/image-tools/image-metadata-viewer/'),
    icon: 'image',
  },
  {
    slug: 'image-dimension-checker',
    title: 'Image Dimension Checker',
    badge: 'Dimensions',
    metaDescription: 'Check exact width, height, aspect ratio, and megapixels of images instantly with zero upload.',
    href: withBasePath('/image-tools/image-dimension-checker/'),
    icon: 'image',
  },
  {
    slug: 'image-dpi-checker',
    title: 'Image DPI / PPI Calculator',
    badge: 'Print',
    metaDescription: 'Calculate image print dimensions in inches and centimeters based on DPI / PPI resolution.',
    href: withBasePath('/image-tools/image-dpi-checker/'),
    icon: 'image',
  },
  {
    slug: 'image-aspect-ratio-checker',
    title: 'Image Aspect Ratio Checker',
    badge: 'Ratio',
    metaDescription: 'Calculate the simplified aspect ratio (16:9, 4:3, 1:1, 21:9) and scale dimensions proportionally.',
    href: withBasePath('/image-tools/image-aspect-ratio-checker/'),
    icon: 'image',
  },
  {
    slug: 'image-color-picker',
    title: 'Image Color Picker & Eyedropper',
    badge: 'Design',
    metaDescription: 'Pick exact pixel colors from uploaded images and get HEX, RGB, and HSL color values.',
    href: withBasePath('/image-tools/image-color-picker/'),
    icon: 'color',
  },
  {
    slug: 'dominant-color-extractor',
    title: 'Dominant Color Palette Extractor',
    badge: 'Design',
    metaDescription: 'Extract the top 5 dominant colors and color harmony palette from any photograph or graphic.',
    href: withBasePath('/image-tools/dominant-color-extractor/'),
    icon: 'color',
  },
  {
    slug: 'image-compressor',
    title: 'Client-Side Image Compressor',
    badge: 'Optimization',
    metaDescription: 'Compress JPEG, PNG, and WebP images locally using Canvas without sending files to an external server.',
    href: withBasePath('/image-tools/image-compressor/'),
    icon: 'image',
  },
  {
    slug: 'image-converter',
    title: 'Image Format Converter',
    badge: 'Converter',
    metaDescription: 'Convert images between PNG, JPEG, and WebP formats instantly with quality adjustment.',
    href: withBasePath('/image-tools/image-converter/'),
    icon: 'image',
  },
];

const schemaFaq = [
  {
    question: 'Are my personal photos uploaded to any server?',
    answer: 'No! All image processing, EXIF stripping, canvas resizing, color sampling, and conversion occur 100% locally inside your browser via HTML5 Canvas and Web APIs.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 sm:p-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1 text-xs font-bold text-[color:var(--fg)]">
        <span>100% Private Client-Side Canvas Engines</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl">
        Image &amp; Privacy Utilities
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--muted)] sm:text-base">
        Inspect image metadata, remove EXIF GPS location tags, pick colors, compress files, and convert image formats locally in your browser.
      </p>
    </header>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Directory</p>
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)]">10 In-Browser Image Engines</h2>
        </div>
        <span class="rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] px-2.5 py-1 text-xs font-bold text-[color:var(--fg)]">
          10 Tools
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {imageToolsList.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)]"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <ToolIcon slug={tool.slug} category="Image" size="md" />
                <span class="rounded-md bg-[color:var(--surface-strong)] border border-[color:var(--border)] px-2 py-0.5 text-[10px] font-bold text-[color:var(--muted)]">
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-base font-bold text-[color:var(--fg)] transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs leading-relaxed text-[color:var(--muted)]">
                {tool.metaDescription}
              </p>
            </div>
            <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[color:var(--fg)]">
              <span>Open Tool</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>
