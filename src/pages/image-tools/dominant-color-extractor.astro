---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Dominant Color Palette Extractor — Extract Colors from Image · ${siteName}`;
const pageDesc = 'Extract dominant color palettes, prominent color harmonies, and CSS variables from photos and illustrations online. Generates 3-12 swatches with HEX, RGB, and HSL copy.';
const canonicalUrl = toAbsoluteUrl('/image-tools/dominant-color-extractor/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Image Tools', href: toAbsoluteUrl('/image-tools/') },
  { label: 'Dominant Color Extractor' },
];

const schemaFaq = [
  {
    question: 'How are dominant colors sampled and clustered from an image?',
    answer: 'The tool draws the image onto an in-memory canvas and applies an adaptive color quantization algorithm (modified octree / median-cut clustering) to group nearby RGB pixels and identify the most statistically prevalent color centers.',
  },
  {
    question: 'Can I export the extracted palette directly to CSS?',
    answer: 'Yes. You can copy the palette as standard CSS Custom Properties (`--color-primary`, `--color-secondary`, etc.), JSON arrays, or download a high-resolution PNG color swatch strip.',
  },
  {
    question: 'What color harmony schemes are generated?',
    answer: 'The tool calculates Complementary (180° opposite), Analogous (adjacent ±30°), Triadic (120° equidistant), and Monochromatic tints and shades based on the primary dominant hue.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Dominant Color Extractor',
    url: canonicalUrl,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-palette-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Canvas Color Quantization Engine &bull; Zero Server Latency</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Dominant Color Palette Extractor
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Extract dominant color swatches, prominence percentages, and harmonic color palettes from any photograph or design graphic. Export palettes as CSS variables, JSON, or PNG swatches.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Upload Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="img-file" accept="image/*" class="hidden" />
        <label for="img-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="color" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Upload an image to extract color palette</p>
          <p class="text-xs text-[color:var(--muted)]">Supports JPG, PNG, WebP, SVG (100% private in-browser analysis)</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="h-14 w-14 rounded-xl bg-[color:var(--surface-strong)] overflow-hidden shrink-0 flex items-center justify-center border border-[color:var(--border)]">
              <img id="thumb-preview" alt="Thumbnail" class="max-h-full max-w-full object-cover" />
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">image.png</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)] font-mono">0 KB</p>
            </div>
          </div>
          <label for="img-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change Image
          </label>
        </div>
      </div>

      <!-- Palette Controls & Swatches Results -->
      <div id="palette-card" class="hidden space-y-6">
        <!-- Palette Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
          <div class="flex items-center gap-2">
            <label for="color-count-select" class="font-bold text-[color:var(--fg)]">Color Count:</label>
            <select id="color-count-select" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 text-xs text-[color:var(--fg)] font-semibold">
              <option value="3">3 Colors</option>
              <option value="5" selected>5 Colors (Standard)</option>
              <option value="8">8 Colors</option>
              <option value="12">12 Colors (Extended)</option>
            </select>
          </div>

          <!-- Export Actions -->
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" id="copy-css-btn" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 font-semibold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition">
              Copy CSS Vars
            </button>
            <button type="button" id="copy-json-btn" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-1.5 font-semibold text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition">
              Copy JSON
            </button>
            <button type="button" id="dl-png-btn" class="rounded-lg bg-[color:var(--fg)] px-3 py-1.5 font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90">
              Download Swatch PNG
            </button>
          </div>
        </div>

        <!-- Dominant Swatches Grid -->
        <div class="space-y-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Extracted Dominant Color Swatches</h2>
          <div id="swatches-container" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5"></div>
        </div>

        <!-- Harmonic Color Palettes -->
        <div class="space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 text-xs">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Calculated Color Harmonies (Based on Primary Hue)</h2>
          
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Complementary -->
            <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3.5 space-y-2">
              <span class="font-bold text-[color:var(--fg)] block">Complementary (180&deg;)</span>
              <div id="harmony-comp" class="grid grid-cols-2 gap-1.5 h-14 rounded-lg overflow-hidden"></div>
            </div>
            <!-- Analogous -->
            <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3.5 space-y-2">
              <span class="font-bold text-[color:var(--fg)] block">Analogous (&plusmn;30&deg;)</span>
              <div id="harmony-analog" class="grid grid-cols-3 gap-1.5 h-14 rounded-lg overflow-hidden"></div>
            </div>
            <!-- Triadic -->
            <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3.5 space-y-2">
              <span class="font-bold text-[color:var(--fg)] block">Triadic (120&deg;)</span>
              <div id="harmony-triad" class="grid grid-cols-3 gap-1.5 h-14 rounded-lg overflow-hidden"></div>
            </div>
            <!-- Monochromatic -->
            <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-3.5 space-y-2">
              <span class="font-bold text-[color:var(--fg)] block">Monochromatic</span>
              <div id="harmony-mono" class="grid grid-cols-4 gap-1.5 h-14 rounded-lg overflow-hidden"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="Color Extraction & Harmony Mathematical Principles"
      description="Details covering color quantization, pixel clustering algorithms, HSL trigonometric transformations, and WCAG contrast."
      parameters={[
        {
          name: "Quantization Sampling",
          type: "Adaptive Clustering",
          defaultValue: "Median-Cut",
          description: "Subdivides the 3D RGB color space into bounding cubes along the axis of highest variance, extracting representative median centroid colors.",
        },
        {
          name: "Color Harmonies",
          type: "Trigonometric HSL",
          defaultValue: "360° Color Wheel",
          description: "Calculates geometric angular relationships in HSL polar coordinates: Complementary (180°), Analogous (±30°), and Triadic (120°).",
        },
        {
          name: "Prominence Ratio",
          type: "Percentage (%)",
          defaultValue: "Relative Frequency",
          description: "Estimates the relative frequency of pixels mapped to each clustered centroid across the analyzed image.",
        },
      ]}
      workedExample={{
        title: "Extracting Dominant Brand Colors from a Product Photo",
        description: "Analyze an image of an ocean landscape to discover the dominant primary teal hue and its complementary warmth tone.",
        formula: "Quantize RGB Pixels -> Centroid Color: #10b981 (H: 160°, S: 84%, L: 39%)",
        steps: [
          {
            step: "Sample RGB Pixel Data",
            calculation: "Downsample image canvas to 120x120 pixels (14,400 color data points).",
            result: "Clustered into variance buckets",
          },
          {
            step: "Determine Primary Dominant Hue",
            calculation: "Dominant centroid RGB: (16, 185, 129) -> HEX: #10b981",
            result: "Primary Color: #10b981 (Teal)",
          },
          {
            step: "Calculate Complementary Harmony",
            calculation: "Rotate Hue by +180°: (160° + 180°) % 360° = 340° (Warm Rose)",
            result: "Complementary Color: #b91048",
          },
          {
            step: "Generate CSS Custom Properties",
            calculation: ":root { --color-primary: #10b981; --color-complementary: #b91048; }",
            result: "Ready for web design system inclusion",
          },
        ],
      }}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">&#9660;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-palette-app]');
      if (!root) return;

      const fileIn = root.querySelector('#img-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbPreview = root.querySelector('#thumb-preview');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const paletteCard = root.querySelector('#palette-card');

      const colorCountSelect = root.querySelector('#color-count-select');
      const swatchesContainer = root.querySelector('#swatches-container');
      const harmonyComp = root.querySelector('#harmony-comp');
      const harmonyAnalog = root.querySelector('#harmony-analog');
      const harmonyTriad = root.querySelector('#harmony-triad');
      const harmonyMono = root.querySelector('#harmony-mono');

      const copyCssBtn = root.querySelector('#copy-css-btn');
      const copyJsonBtn = root.querySelector('#copy-json-btn');
      const dlPngBtn = root.querySelector('#dl-png-btn');

      let loadedImg = null;
      let currentSwatches = [];

      function rgbToHex(r, g, b) {
        return '#' + [r, g, b].map(x => x.toString(16).padStart(2, '0')).join('');
      }

      function rgbToHsl(r, g, b) {
        r /= 255; g /= 255; b /= 255;
        const max = Math.max(r, g, b), min = Math.min(r, g, b);
        let h = 0, s = 0, l = (max + min) / 2;

        if (max !== min) {
          const d = max - min;
          s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
          switch (max) {
            case r: h = (g - b) / d + (g < b ? 6 : 0); break;
            case g: h = (b - r) / d + 2; break;
            case b: h = (r - g) / d + 4; break;
          }
          h /= 6;
        }
        return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
      }

      function hslToHex(h, s, l) {
        s /= 100;
        l /= 100;
        const c = (1 - Math.abs(2 * l - 1)) * s;
        const x = c * (1 - Math.abs((h / 60) % 2 - 1));
        const m = l - c / 2;
        let r = 0, g = 0, b = 0;

        if (h >= 0 && h < 60) { r = c; g = x; b = 0; }
        else if (h >= 60 && h < 120) { r = x; g = c; b = 0; }
        else if (h >= 120 && h < 180) { r = 0; g = c; b = x; }
        else if (h >= 180 && h < 240) { r = 0; g = x; b = c; }
        else if (h >= 240 && h < 300) { r = x; g = 0; b = c; }
        else if (h >= 300 && h < 360) { r = c; g = 0; b = x; }

        const rInt = Math.round((r + m) * 255);
        const gInt = Math.round((g + m) * 255);
        const bInt = Math.round((b + m) * 255);
        return rgbToHex(rInt, gInt, bInt);
      }

      function extractPalette() {
        if (!loadedImg) return;

        const count = parseInt(colorCountSelect.value, 10);
        const canvas = document.createElement('canvas');
        const sampleSize = 100;
        canvas.width = sampleSize;
        canvas.height = sampleSize;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(loadedImg, 0, 0, sampleSize, sampleSize);

        const imgData = ctx.getImageData(0, 0, sampleSize, sampleSize).data;
        const colorBuckets = {};

        // 4-bit color quantization to group similar colors
        for (let i = 0; i < imgData.length; i += 4) {
          const a = imgData[i + 3];
          if (a < 128) continue; // Ignore transparent pixels

          const r = Math.round(imgData[i] / 16) * 16;
          const g = Math.round(imgData[i + 1] / 16) * 16;
          const b = Math.round(imgData[i + 2] / 16) * 16;
          const key = `${r},${g},${b}`;

          colorBuckets[key] = (colorBuckets[key] || 0) + 1;
        }

        const sorted = Object.entries(colorBuckets).sort((a, b) => b[1] - a[1]);
        const totalSamples = sorted.reduce((acc, curr) => acc + curr[1], 0);

        currentSwatches = sorted.slice(0, count).map(([rgbStr, freq]) => {
          const [r, g, b] = rgbStr.split(',').map(Number);
          const hex = rgbToHex(r, g, b);
          const hsl = rgbToHsl(r, g, b);
          const pct = Math.round((freq / totalSamples) * 100);
          return { hex, r, g, b, hsl, pct };
        });

        renderSwatches();
        renderHarmonies();
      }

      function renderSwatches() {
        swatchesContainer.innerHTML = currentSwatches.map((c, idx) => `
          <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] overflow-hidden flex flex-col justify-between shadow-xs">
            <div class="h-24 w-full cursor-pointer relative group transition-transform" style="background-color: ${c.hex};" data-copy-hex="${c.hex}" title="Click to copy HEX">
              <span class="absolute bottom-2 right-2 rounded bg-black/60 px-1.5 py-0.5 text-[10px] font-mono font-bold text-white">${c.pct}%</span>
            </div>
            <div class="p-3 space-y-1 text-xs">
              <div class="flex items-center justify-between">
                <span class="font-mono font-extrabold text-[color:var(--fg)]">${c.hex.toUpperCase()}</span>
                <button type="button" data-copy-val="${c.hex}" class="text-[10px] font-bold text-[color:var(--primary)] hover:underline">Copy</button>
              </div>
              <p class="font-mono text-[10px] text-[color:var(--muted)]">rgb(${c.r}, ${c.g}, ${c.b})</p>
              <p class="font-mono text-[10px] text-[color:var(--muted)]">hsl(${c.hsl.h}&deg;, ${c.hsl.s}%, ${c.hsl.l}%)</p>
            </div>
          </div>
        `).join('');

        swatchesContainer.querySelectorAll('[data-copy-val], [data-copy-hex]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const val = btn.dataset.copyVal || btn.dataset.copyHex;
            navigator.clipboard.writeText(val);
            const orig = btn.textContent;
            if (btn.tagName === 'BUTTON') {
              btn.textContent = 'Copied!';
              setTimeout(() => btn.textContent = orig, 1500);
            }
          });
        });
      }

      function renderHarmonies() {
        if (!currentSwatches.length) return;
        const primaryHsl = currentSwatches[0].hsl;
        const h = primaryHsl.h, s = primaryHsl.s, l = primaryHsl.l;

        // Complementary: 0 and 180 deg
        const compHex = hslToHex((h + 180) % 360, s, l);
        harmonyComp.innerHTML = `
          <div style="background-color: ${currentSwatches[0].hex};" title="${currentSwatches[0].hex}"></div>
          <div style="background-color: ${compHex};" title="${compHex}"></div>
        `;

        // Analogous: -30, 0, +30 deg
        const an1 = hslToHex((h + 330) % 360, s, l);
        const an2 = hslToHex((h + 30) % 360, s, l);
        harmonyAnalog.innerHTML = `
          <div style="background-color: ${an1};" title="${an1}"></div>
          <div style="background-color: ${currentSwatches[0].hex};" title="${currentSwatches[0].hex}"></div>
          <div style="background-color: ${an2};" title="${an2}"></div>
        `;

        // Triadic: 0, 120, 240 deg
        const tr1 = hslToHex((h + 120) % 360, s, l);
        const tr2 = hslToHex((h + 240) % 360, s, l);
        harmonyTriad.innerHTML = `
          <div style="background-color: ${currentSwatches[0].hex};" title="${currentSwatches[0].hex}"></div>
          <div style="background-color: ${tr1};" title="${tr1}"></div>
          <div style="background-color: ${tr2};" title="${tr2}"></div>
        `;

        // Monochromatic: vary lightness 20%, 40%, 60%, 80%
        const m1 = hslToHex(h, s, 25);
        const m2 = hslToHex(h, s, 45);
        const m3 = hslToHex(h, s, 65);
        const m4 = hslToHex(h, s, 85);
        harmonyMono.innerHTML = `
          <div style="background-color: ${m1};" title="${m1}"></div>
          <div style="background-color: ${m2};" title="${m2}"></div>
          <div style="background-color: ${m3};" title="${m3}"></div>
          <div style="background-color: ${m4};" title="${m4}"></div>
        `;
      }

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (loadEvt) => {
          const img = new Image();
          img.onload = () => {
            loadedImg = img;
            thumbPreview.src = img.src;
            thumbName.textContent = file.name;
            thumbInfo.textContent = `${(file.size / 1024).toFixed(1)} KB &bull; ${img.naturalWidth} &times; ${img.naturalHeight} px`;

            uploadPrompt.classList.add('hidden');
            uploadPreviewBox.classList.remove('hidden');
            paletteCard.classList.remove('hidden');

            extractPalette();
          };
          img.src = loadEvt.target.result;
        };
        reader.readAsDataURL(file);
      });

      colorCountSelect.addEventListener('change', extractPalette);

      copyCssBtn.addEventListener('click', () => {
        if (!currentSwatches.length) return;
        const css = `:root {\n` + currentSwatches.map((c, i) => `  --color-${i + 1}: ${c.hex};`).join('\n') + `\n}`;
        navigator.clipboard.writeText(css);
        copyCssBtn.textContent = 'Copied!';
        setTimeout(() => copyCssBtn.textContent = 'Copy CSS Vars', 1500);
      });

      copyJsonBtn.addEventListener('click', () => {
        if (!currentSwatches.length) return;
        const json = JSON.stringify(currentSwatches.map(c => ({
          hex: c.hex,
          rgb: `rgb(${c.r}, ${c.g}, ${c.b})`,
          hsl: `hsl(${c.hsl.h}, ${c.hsl.s}%, ${c.hsl.l}%)`,
          prominence: `${c.pct}%`
        })), null, 2);
        navigator.clipboard.writeText(json);
        copyJsonBtn.textContent = 'Copied!';
        setTimeout(() => copyJsonBtn.textContent = 'Copy JSON', 1500);
      });

      dlPngBtn.addEventListener('click', () => {
        if (!currentSwatches.length) return;
        const swatchW = 120;
        const swatchH = 160;
        const canvas = document.createElement('canvas');
        canvas.width = currentSwatches.length * swatchW;
        canvas.height = swatchH;
        const ctx = canvas.getContext('2d');

        currentSwatches.forEach((c, idx) => {
          ctx.fillStyle = c.hex;
          ctx.fillRect(idx * swatchW, 0, swatchW, swatchH - 40);

          ctx.fillStyle = '#ffffff';
          ctx.fillRect(idx * swatchW, swatchH - 40, swatchW, 40);

          ctx.fillStyle = '#111827';
          ctx.font = 'bold 12px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(c.hex.toUpperCase(), idx * swatchW + swatchW / 2, swatchH - 16);
        });

        canvas.toBlob((blob) => {
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'palette-swatches.png';
          a.click();
          URL.revokeObjectURL(url);
        });
      });
    })();
  </script>
</SiteLayout>
