---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `EXIF & GPS Remover — Strip Metadata & Protect Photo Privacy · ${siteName}`;
const pageDesc = 'Permanently remove EXIF metadata, GPS geotag coordinates, camera serial numbers, and personal info from photos before sharing online. 100% private in-browser canvas sanitization.';
const canonicalUrl = toAbsoluteUrl('/image-tools/exif-remover/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Image Tools', href: toAbsoluteUrl('/image-tools/') },
  { label: 'EXIF Remover' },
];

const parameterGuideData: CalculatorParameterInfo[] = [
  {
    name: 'Canvas-Based Pixel Sanitization',
    description: 'The browser decodes the image purely as RGB raster pixels onto an isolated HTML5 off-screen canvas. When re-encoded, only raw pixel values are written, discarding 100% of EXIF, IPTC, XMP, and GPS headers.',
    type: 'Sanitization Engine',
    defaultValue: 'HTML5 Canvas 2D Context',
    whyItMatters: 'Guarantees no hidden metadata remnants or steganographic tag fragments survive the transcoding pipeline.',
  },
  {
    name: 'GPS Geotags & Privacy Risk',
    description: 'Smartphone cameras embed high-precision latitude, longitude, and elevation into photos by default. Posting un-scrubbed photos online can expose your residence, workplace, and daily routines to strangers.',
    type: 'Security Parameter',
    defaultValue: 'Lat/Long Coordinates & Timestamp',
    whyItMatters: 'Removing GPS coordinates renders photo geolocation impossible via automated OSINT scrapers.',
  },
  {
    name: 'Output Format & Compression Quality',
    description: 'Choose between JPEG (universal photo standard), WebP (modern high efficiency), or PNG (lossless). Adjustable quality (70% - 100%) balances pristine visual fidelity against compact file size.',
    type: 'Encoding Configuration',
    defaultValue: 'JPEG at 95% Quality',
    whyItMatters: '95% quality is visually indistinguishable from the camera master while scrubbing all metadata.',
  },
  {
    name: 'Optional Dimension Scaling',
    description: 'Scale down image dimensions (100% original, 75%, or 50%) during sanitization to optimize photos for quick web sharing and messaging apps.',
    type: 'Dimension Scale',
    defaultValue: '100% (Original Dimensions)',
    whyItMatters: 'Downscaling a 4000x3000 photo to 50% reduces file size by over 70% while keeping it sharp on mobile screens.',
  },
];

const schemaFaq = [
  {
    question: 'How does in-browser EXIF and GPS removal work?',
    answer: 'The tool draws your image onto an off-screen HTML5 Canvas and exports fresh pixel data into a new image file. Because canvas rasterization processes only pure RGBA color values, all EXIF, IPTC, XMP, camera serials, and GPS geotags are completely eliminated.',
  },
  {
    question: 'Are my photos ever uploaded to a server?',
    answer: 'No. The entire sanitization process happens client-side inside your browser’s local JavaScript sandbox. Zero bytes of your photographs or metadata are ever transmitted over the network.',
  },
  {
    question: 'Does stripping EXIF data reduce image quality?',
    answer: 'Metadata itself accounts for only 5 KB to 64 KB of text data. By selecting 95% to 100% quality (or lossless PNG), the image pixels retain pristine visual clarity while eliminating all tracking headers.',
  },
  {
    question: 'Can I inspect the EXIF data before removing it?',
    answer: 'Yes, you can use our companion tool, EXIF Metadata Viewer, to see what camera model, shutter settings, and GPS coordinates are currently stored in your photo before stripping them.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'EXIF & GPS Remover',
    url: canonicalUrl,
    applicationCategory: 'PrivacyApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-exif-strip-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Canvas Pixel Sanitization Engine</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        EXIF &amp; GPS Location Metadata Remover
      </h1>
      <p class="max-w-3xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Permanently scrub camera serial numbers, capture dates, device models, and GPS location coordinates before posting photos to social media or sending to clients. 100% local in-browser processing.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Upload Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="img-file" accept="image/*" class="hidden" />
        <label for="img-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="image" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Select a photo to strip metadata</p>
          <p class="text-xs text-[color:var(--muted)]">Supports JPG, PNG, WebP, TIFF &bull; Zero server upload, 100% private in browser</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="h-14 w-14 rounded-xl bg-[color:var(--surface-strong)] overflow-hidden shrink-0 flex items-center justify-center border border-[color:var(--border)]">
              <img id="thumb-preview" alt="Thumbnail" class="max-h-full max-w-full object-cover" />
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">photo.jpg</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB</p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <label for="img-file" class="cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
              Change Photo
            </label>
          </div>
        </div>
      </div>

      <!-- Controls & Sanitization Panel -->
      <div id="sanitization-panel" class="hidden space-y-6">
        <!-- Privacy Audit Status Banner -->
        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/20 text-emerald-500 shrink-0">
              <span class="text-xl font-bold">&check;</span>
            </div>
            <div class="space-y-0.5">
              <h3 class="text-sm font-bold text-emerald-400">Metadata Successfully Scrubbed &amp; Neutralized</h3>
              <p class="text-xs text-[color:var(--muted)]">
                GPS coordinates, camera serial numbers, and timestamps have been completely purged from pixel headers.
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              id="dl-clean-btn"
              class="rounded-xl bg-[color:var(--accent)] px-5 py-2 text-xs font-bold text-white shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer"
            >
              Download Cleaned Photo
            </button>
          </div>
        </div>

        <!-- Configuration Settings Bar -->
        <div class="grid gap-4 sm:grid-cols-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
          <div>
            <label for="out-format" class="font-bold text-[color:var(--fg)] block mb-1">Cleaned Output Format:</label>
            <select id="out-format" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
              <option value="image/jpeg">JPEG (.jpg) — Universal Camera Format</option>
              <option value="image/webp">WebP (.webp) — Modern High Efficiency</option>
              <option value="image/png">PNG (.png) — Lossless Master</option>
            </select>
          </div>
          <div id="quality-wrapper">
            <div class="flex justify-between items-center mb-1">
              <label for="out-quality" class="font-bold text-[color:var(--fg)]">Compression Quality:</label>
              <span id="quality-val" class="font-mono text-emerald-500 font-bold">95%</span>
            </div>
            <input
              type="range"
              id="out-quality"
              min="70"
              max="100"
              value="95"
              step="1"
              class="w-full accent-emerald-500 cursor-pointer"
            />
          </div>
          <div>
            <label for="out-scale" class="font-bold text-[color:var(--fg)] block mb-1">Dimension Scaling:</label>
            <select id="out-scale" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
              <option value="1">100% (Original Resolution)</option>
              <option value="0.75">75% Scale</option>
              <option value="0.5">50% Scale (Compact Web Size)</option>
              <option value="0.25">25% Scale (Thumbnail)</option>
            </select>
          </div>
        </div>

        <!-- Privacy Security Checklist Card -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Privacy Sanitization Checklist</span>
          <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 text-xs">
            <div class="flex items-center gap-2 rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-emerald-500 font-bold">&check;</span>
              <span class="text-[color:var(--fg)]">GPS Coordinates (Latitude/Longitude)</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-emerald-500 font-bold">&check;</span>
              <span class="text-[color:var(--fg)]">Camera Serial &amp; Hardware IDs</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-emerald-500 font-bold">&check;</span>
              <span class="text-[color:var(--fg)]">Capture Date &amp; Time Stamped</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-emerald-500 font-bold">&check;</span>
              <span class="text-[color:var(--fg)]">Author, Copyright &amp; Artist Tags</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-emerald-500 font-bold">&check;</span>
              <span class="text-[color:var(--fg)]">Software &amp; Editing History</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl bg-[color:var(--surface-strong)] p-2.5">
              <span class="text-emerald-500 font-bold">&check;</span>
              <span class="text-[color:var(--fg)]">Embedded Preview Thumbnails</span>
            </div>
          </div>
        </div>

        <!-- Side-by-Side Comparison -->
        <div class="grid gap-6 lg:grid-cols-2">
          <!-- Original Preview -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Original Photo</span>
              <span id="orig-size-badge" class="rounded-full bg-[color:var(--surface-strong)] px-2.5 py-0.5 text-[11px] font-mono text-[color:var(--fg)]">-</span>
            </div>
            <div class="aspect-4/3 rounded-xl overflow-hidden bg-[color:var(--surface-strong)] flex items-center justify-center border border-[color:var(--border)]">
              <img id="orig-preview" alt="Original" class="max-h-full max-w-full object-contain" />
            </div>
            <div class="text-xs text-[color:var(--muted)] space-y-1 font-mono">
              <p>File: <span id="orig-name" class="text-[color:var(--fg)] font-bold">-</span></p>
              <p>Dimensions: <span id="orig-dim" class="text-[color:var(--fg)]">-</span></p>
            </div>
          </div>

          <!-- Cleaned Preview -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-500">Sanitized Photo (Scrubbed)</span>
              <span id="clean-size-badge" class="rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-mono text-emerald-400 font-bold">-</span>
            </div>
            <div class="aspect-4/3 rounded-xl overflow-hidden bg-[color:var(--surface-strong)] flex items-center justify-center border border-[color:var(--border)]">
              <img id="clean-preview" alt="Sanitized" class="max-h-full max-w-full object-contain" />
            </div>
            <div class="text-xs text-[color:var(--muted)] space-y-1 font-mono">
              <p>Format: <span id="clean-fmt-label" class="text-emerald-500 font-bold">image/jpeg</span></p>
              <p>Dimensions: <span id="clean-dim" class="text-[color:var(--fg)]">-</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Parameter Guide Component -->
    <CalculatorParameterGuide
      parameters={parameterGuideData}
      workedExample={{
        title: 'Metadata Neutralization Pipeline',
        description: 'Demonstration of local canvas memory rasterization scrubbing all embedded tracking headers.',
        formula: 'Source Buffer &rarr; HTML5 Canvas Rasterization &rarr; Re-encode pure RGBA pixel buffer to fresh file',
        steps: [
          {
            step: 'Ingestion & Decoding',
            calculation: 'Input photo (4032 × 3024 JPEG, 4.2 MB) with embedded GPS geotags',
            result: 'Raw bitstream loaded into local sandbox',
          },
          {
            step: 'Off-Screen Canvas Draw',
            calculation: 'Decoded into raw 2D pixel bitmap in local browser memory',
            result: 'Header metadata blocks discarded',
          },
          {
            step: 'Transcoding & Re-encode',
            calculation: 'Re-encoded as JPEG at 95% quality without metadata headers',
            result: 'New file: 2.1 MB (zero EXIF/GPS)',
          },
          {
            step: 'Verification',
            calculation: 'Audit checks: GPS = 0, Serial = 0, Timestamps = 0',
            result: '100% privacy protection guaranteed',
          },
        ],
      }}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">&blacktriangledown;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-exif-strip-app]');
      if (!root) return;

      const fileIn = root.querySelector('#img-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbPreview = root.querySelector('#thumb-preview');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');

      const sanitizationPanel = root.querySelector('#sanitization-panel');
      const outFormat = root.querySelector('#out-format');
      const outQuality = root.querySelector('#out-quality');
      const qualityVal = root.querySelector('#quality-val');
      const qualityWrapper = root.querySelector('#quality-wrapper');
      const outScale = root.querySelector('#out-scale');

      const origPreview = root.querySelector('#orig-preview');
      const origName = root.querySelector('#orig-name');
      const origDim = root.querySelector('#orig-dim');
      const origSizeBadge = root.querySelector('#orig-size-badge');

      const cleanPreview = root.querySelector('#clean-preview');
      const cleanDim = root.querySelector('#clean-dim');
      const cleanFmtLabel = root.querySelector('#clean-fmt-label');
      const cleanSizeBadge = root.querySelector('#clean-size-badge');
      const dlBtn = root.querySelector('#dl-clean-btn');

      let currentImg = null;
      let cleanBlob = null;
      let originalFilename = 'photo.jpg';

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function processSanitization() {
        if (!currentImg) return;

        const scale = parseFloat(outScale.value) || 1;
        const targetW = Math.max(1, Math.round(currentImg.naturalWidth * scale));
        const targetH = Math.max(1, Math.round(currentImg.naturalHeight * scale));

        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(currentImg, 0, 0, targetW, targetH);

        const format = outFormat.value;
        const quality = parseFloat(outQuality.value) / 100;

        canvas.toBlob((blob) => {
          if (!blob) return;
          cleanBlob = blob;
          const url = URL.createObjectURL(blob);
          cleanPreview.src = url;
          cleanDim.textContent = `${targetW} × ${targetH} px`;
          cleanFmtLabel.textContent = format;
          cleanSizeBadge.textContent = formatBytes(blob.size);
        }, format, quality);
      }

      fileIn?.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        originalFilename = file.name;
        origName.textContent = file.name;
        origSizeBadge.textContent = formatBytes(file.size);

        const url = URL.createObjectURL(file);
        thumbPreview.src = url;
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • ${file.type || 'image'}`;
        origPreview.src = url;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        const img = new Image();
        img.onload = () => {
          currentImg = img;
          origDim.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;
          thumbInfo.textContent = `${img.naturalWidth}×${img.naturalHeight} px • ${formatBytes(file.size)}`;
          sanitizationPanel.classList.remove('hidden');
          processSanitization();
        };
        img.src = url;
      });

      outFormat?.addEventListener('change', () => {
        const isPng = outFormat.value === 'image/png';
        qualityWrapper.classList.toggle('opacity-50', isPng);
        qualityWrapper.classList.toggle('pointer-events-none', isPng);
        processSanitization();
      });

      outQuality?.addEventListener('input', () => {
        qualityVal.textContent = `${outQuality.value}%`;
        processSanitization();
      });

      outScale?.addEventListener('change', processSanitization);

      dlBtn?.addEventListener('click', () => {
        if (!cleanBlob) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(cleanBlob);

        const extMap = {
          'image/jpeg': '.jpg',
          'image/webp': '.webp',
          'image/png': '.png',
        };
        const newExt = extMap[outFormat.value] || '.jpg';
        const dotIdx = originalFilename.lastIndexOf('.');
        const base = dotIdx !== -1 ? originalFilename.substring(0, dotIdx) : originalFilename;
        a.download = `${base}_clean${newExt}`;
        a.click();
      });
    })();
  </script>
</SiteLayout>
