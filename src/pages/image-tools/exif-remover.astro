---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `EXIF & GPS Remover — Strip Metadata from Photos Online · ${siteName}`;
const pageDesc = 'Remove EXIF metadata, GPS location coordinates, camera serial numbers, and personal info from photos before sharing online. 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/image-tools/exif-remover/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Image Tools', href: toAbsoluteUrl('/image-tools/') },
  { label: 'EXIF Remover' },
];

const schemaFaq = [
  {
    question: 'How does in-browser EXIF removal work?',
    answer: 'The tool draws your image onto an off-screen HTML5 Canvas and exports fresh pixel data as a new JPEG/PNG image. Because the canvas renderer outputs only pure raw pixel data, all EXIF, IPTC, and GPS metadata headers are completely stripped.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'EXIF Remover',
    url: canonicalUrl,
    applicationCategory: 'PrivacyApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-exif-strip-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Canvas Pixel Sanitization</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        EXIF &amp; GPS Location Remover
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Strip camera serials, timestamps, and GPS geotags from photos before posting on social media or forums.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Upload Zone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="img-file" accept="image/*" class="hidden" />
        <label for="img-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="image" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Select a photo to strip metadata</p>
          <p class="text-xs text-[color:var(--muted)]">100% private in-browser canvas sanitization</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="h-14 w-14 rounded-xl bg-[color:var(--surface-strong)] overflow-hidden shrink-0 flex items-center justify-center border border-[color:var(--border)]">
              <img id="thumb-preview" alt="Thumbnail" class="max-h-full max-w-full object-cover" />
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">photo.jpg</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB</p>
            </div>
          </div>
          <label for="img-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change Photo
          </label>
        </div>
      </div>

      <!-- Action Card -->
      <div id="clean-card" class="hidden space-y-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold text-[color:var(--fg)]">Metadata Successfully Stripped</span>
          </div>
          <button
            type="button"
            id="dl-clean-btn"
            class="rounded-xl bg-[color:var(--fg)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer"
          >
            Download Cleaned Photo
          </button>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 text-xs text-[color:var(--muted)] rounded-xl bg-[color:var(--surface-strong)] p-4">
          <div>
            <p>Original File: <strong id="orig-name" class="text-[color:var(--fg)]">-</strong></p>
            <p>Original Size: <strong id="orig-size" class="text-[color:var(--fg)]">-</strong></p>
          </div>
          <div>
            <p>EXIF &amp; GPS Headers: <strong class="text-emerald-500 font-bold">100% Removed</strong></p>
            <p>Cleaned Format: <strong id="clean-fmt" class="text-[color:var(--fg)]">image/jpeg</strong></p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-exif-strip-app]');
      if (!root) return;

      const fileIn = root.querySelector('#img-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbPreview = root.querySelector('#thumb-preview');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const cleanCard = root.querySelector('#clean-card');
      const dlBtn = root.querySelector('#dl-clean-btn');
      const origName = root.querySelector('#orig-name');
      const origSize = root.querySelector('#orig-size');
      const cleanFmt = root.querySelector('#clean-fmt');

      let cleanBlobUrl = null;
      let originalFilename = 'photo.jpg';

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        originalFilename = file.name;
        origName.textContent = file.name;
        origSize.textContent = formatBytes(file.size);

        const url = URL.createObjectURL(file);
        thumbPreview.src = url;
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • ${file.type || 'image'}`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        const img = new Image();
        img.onload = () => {
          thumbInfo.textContent = `${img.naturalWidth}×${img.naturalHeight} px • ${formatBytes(file.size)}`;
          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth;
          canvas.height = img.naturalHeight;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0);

          canvas.toBlob((blob) => {
            if (cleanBlobUrl) URL.revokeObjectURL(cleanBlobUrl);
            cleanBlobUrl = URL.createObjectURL(blob);
            cleanCard.classList.remove('hidden');
          }, 'image/jpeg', 0.95);
        };
        img.src = url;
      });

      dlBtn.addEventListener('click', () => {
        if (!cleanBlobUrl) return;
        const a = document.createElement('a');
        a.href = cleanBlobUrl;
        const extIdx = originalFilename.lastIndexOf('.');
        const baseName = extIdx !== -1 ? originalFilename.substring(0, extIdx) : originalFilename;
        a.download = `${baseName}_clean.jpg`;
        a.click();
      });
    })();
  </script>
</SiteLayout>
