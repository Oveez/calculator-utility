---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Image Format Converter — PNG to JPG, WebP, AVIF, BMP Online · ${siteName}`;
const pageDesc = 'Convert images between PNG, JPEG, WebP, and BMP formats online using client-side canvas. Transparency background color control, dimension scaling, and instant download with zero server uploads.';
const canonicalUrl = toAbsoluteUrl('/image-tools/image-converter/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Image Tools', href: toAbsoluteUrl('/image-tools/') },
  { label: 'Image Converter' },
];

const schemaFaq = [
  {
    question: 'Can I convert transparent PNGs to JPEG without black background artifacts?',
    answer: 'Yes. The converter allows you to select your preferred background fill color (Clean White, Deep Black, or custom Hex) before rendering transparent pixels into JPEG or BMP formats.',
  },
  {
    question: 'What image formats can I convert to and from?',
    answer: 'You can upload any image format supported by modern browsers (PNG, JPEG, WebP, GIF, SVG, AVIF, BMP) and convert it into WebP, JPEG, PNG, or BMP with configurable quality and resolution scaling.',
  },
  {
    question: 'Are my photos uploaded to any external server?',
    answer: 'No. The entire conversion pipeline runs 100% locally inside your browser using the HTML5 2D Canvas and Blob APIs. Your files never leave your computer.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Image Format Converter',
    url: canonicalUrl,
    applicationCategory: 'ImageApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-converter-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Canvas Format Transcoding &bull; 100% Client-Side</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Image Format Converter
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Convert between PNG, JPEG, WebP, and BMP formats instantly inside your browser. Control background fill colors for transparent images, downscale dimensions, and export ready-to-use image assets.
      </p>
    </header>

    <!-- Telemetry Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Original Format</p>
        <p id="stat-orig-fmt" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">-</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Target Format</p>
        <p id="stat-target-fmt" class="mt-1 font-mono text-base font-bold text-emerald-500">WEBP</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Original Size</p>
        <p id="stat-orig-size" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">0 B</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Converted Size</p>
        <p id="stat-conv-size" class="mt-1 font-mono text-base font-bold text-emerald-500">0 B</p>
      </div>
    </div>

    <div class="space-y-6">
      <!-- Upload Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="img-file" accept="image/*" class="hidden" />
        <label for="img-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="image" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Select an image to convert or drag and drop</p>
          <p class="text-xs text-[color:var(--muted)]">PNG, JPG, JPEG, WebP, GIF, SVG, BMP (100% private in browser)</p>
        </label>

        <!-- Visual Upload Preview Window -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="h-14 w-14 rounded-xl bg-[color:var(--surface-strong)] overflow-hidden shrink-0 flex items-center justify-center border border-[color:var(--border)]">
              <img id="thumb-preview" alt="Thumbnail" class="max-h-full max-w-full object-cover" />
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">image.png</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)] font-mono">0 KB</p>
            </div>
          </div>
          <label for="img-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change Image
          </label>
        </div>
      </div>

      <!-- Conversion Settings Card -->
      <div id="conv-card" class="hidden space-y-6">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-4 text-xs">
          <p class="font-bold uppercase tracking-wider text-[color:var(--muted)] text-[10px]">Conversion &amp; Output Configuration</p>

          <div class="grid gap-4 sm:grid-cols-3">
            <!-- Format Selector -->
            <div>
              <label for="target-fmt" class="font-bold text-[color:var(--fg)] block mb-1.5">Convert To Format:</label>
              <select id="target-fmt" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)] font-semibold">
                <option value="image/webp">WebP (Modern Web Standard)</option>
                <option value="image/jpeg">JPEG (Universal Compatibility)</option>
                <option value="image/png">PNG (Lossless Transparency)</option>
              </select>
            </div>

            <!-- Transparency Background Fill -->
            <div id="bg-fill-box">
              <label for="bg-fill-select" class="font-bold text-[color:var(--fg)] block mb-1.5">Background Fill (If Transparent):</label>
              <select id="bg-fill-select" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
                <option value="#ffffff">Solid White (#FFFFFF)</option>
                <option value="#000000">Solid Black (#000000)</option>
                <option value="transparent">Transparent (PNG/WebP only)</option>
                <option value="custom">Custom Color Fill</option>
              </select>
              <input type="color" id="custom-color" value="#ffffff" class="hidden mt-2 h-8 w-full rounded-lg cursor-pointer border border-[color:var(--border)]" />
            </div>

            <!-- Quality Slider for Lossy Formats -->
            <div id="quality-box" class="space-y-1.5">
              <div class="flex justify-between font-bold text-[color:var(--fg)]">
                <span>Output Quality:</span>
                <span id="qual-val" class="font-mono text-emerald-500">90%</span>
              </div>
              <input
                type="range"
                id="qual-slider"
                min="10"
                max="100"
                value="90"
                class="w-full accent-[color:var(--fg)] cursor-pointer"
              />
            </div>
          </div>

          <!-- Dimension Rescaling Option -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[color:var(--border)]">
            <div class="flex items-center gap-2">
              <label for="scale-select" class="font-medium text-[color:var(--muted)]">Dimension Rescaling:</label>
              <select id="scale-select" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 text-xs text-[color:var(--fg)]">
                <option value="1">100% (Original Dimensions)</option>
                <option value="0.75">75% Scaling</option>
                <option value="0.5">50% Scaling (Half Dimensions)</option>
                <option value="0.25">25% Scaling</option>
              </select>
            </div>
            <span id="scale-info" class="text-[11px] font-mono text-[color:var(--muted)]">1920 &times; 1080 px</span>
          </div>
        </div>

        <!-- Live Preview Card -->
        <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Converted Output Preview</span>
            <span id="conv-badge" class="text-xs font-mono font-bold text-emerald-500">-</span>
          </div>
          <div class="h-64 rounded-xl bg-[color:var(--surface-strong)] overflow-hidden flex items-center justify-center p-2">
            <img id="img-conv-preview" alt="Converted" class="max-h-full max-w-full object-contain" />
          </div>
        </div>

        <!-- Download Action -->
        <button
          type="button"
          id="dl-conv-btn"
          class="w-full rounded-xl bg-[color:var(--fg)] py-3 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
        >
          <Icon name="download" class="w-4 h-4" />
          <span>Convert &amp; Download Image</span>
        </button>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="Image Format Conversion Parameters & Technical Specifications"
      description="Understanding raster formats, compression algorithms, alpha channel preservation, and color mapping."
      parameters={[
        {
          name: "Target Format",
          type: "MIME String",
          defaultValue: "image/webp",
          description: "Target raster encoding standard. WebP produces 30% smaller files; JPEG is universally recognized; PNG provides lossless clarity with alpha channels.",
        },
        {
          name: "Alpha Transparency Fill",
          type: "Hex Color",
          defaultValue: "#FFFFFF (White)",
          description: "Fills transparent areas with a solid background color when converting from alpha-transparent PNG to JPEG or BMP formats that lack an alpha channel.",
        },
        {
          name: "Encoding Quality",
          type: "Percentage (10% to 100%)",
          defaultValue: "90%",
          description: "Controls the compression factor for lossy WebP and JPEG encoders. Higher values preserve fine texture details at the cost of larger file size.",
        },
        {
          name: "Dimension Rescaling",
          type: "Ratio (0.25 to 1.0)",
          defaultValue: "1.0 (100%)",
          description: "Rescales image dimensions proportionally to reduce byte weight further for web and mobile usage.",
        },
      ]}
      workedExample={{
        title: "Converting a Transparent PNG Logo to WebP for Web Delivery",
        description: "Transform an 800x800 PNG logo (340 KB) with alpha transparency into an optimized WebP format.",
        formula: "Canvas.toBlob(logo, 'image/webp', 0.90)",
        steps: [
          {
            step: "Inspect Original File",
            calculation: "Dimensions: 800x800 px, Weight: 340 KB, Alpha Channel: Yes (Transparent).",
            result: "Initial payload: 340 KB",
          },
          {
            step: "Preserve Transparency in WebP",
            calculation: "WebP supports lossy and lossless alpha channels. Set background fill to transparent.",
            result: "Alpha channel preserved",
          },
          {
            step: "Apply WebP 90% Quality Compression",
            calculation: "Encode canvas pixel data using WebP predictive transform.",
            result: "Converted size: 48 KB",
          },
          {
            step: "Compute Bandwidth Savings",
            calculation: "(340 KB - 48 KB) / 340 KB = 85.9% reduction in file size.",
            result: "-85.9% saved (292 KB reduced)",
          },
        ],
      }}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">&#9660;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-converter-app]');
      if (!root) return;

      const fileIn = root.querySelector('#img-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbPreview = root.querySelector('#thumb-preview');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const convCard = root.querySelector('#conv-card');

      const targetFmt = root.querySelector('#target-fmt');
      const bgFillSelect = root.querySelector('#bg-fill-select');
      const customColor = root.querySelector('#custom-color');
      const qualityBox = root.querySelector('#quality-box');
      const qualSlider = root.querySelector('#qual-slider');
      const qualVal = root.querySelector('#qual-val');
      const scaleSelect = root.querySelector('#scale-select');
      const scaleInfo = root.querySelector('#scale-info');

      const statOrigFmt = root.querySelector('#stat-orig-fmt');
      const statTargetFmt = root.querySelector('#stat-target-fmt');
      const statOrigSize = root.querySelector('#stat-orig-size');
      const statConvSize = root.querySelector('#stat-conv-size');

      const imgConvPreview = root.querySelector('#img-conv-preview');
      const convBadge = root.querySelector('#conv-badge');
      const dlBtn = root.querySelector('#dl-conv-btn');

      let loadedImg = null;
      let origSizeBytes = 0;
      let convBlobUrl = null;
      let origFileName = 'image.png';

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function convert() {
        if (!loadedImg) return;

        const fmt = targetFmt.value;
        const scale = parseFloat(scaleSelect.value);
        const targetW = Math.round(loadedImg.naturalWidth * scale);
        const targetH = Math.round(loadedImg.naturalHeight * scale);
        scaleInfo.textContent = `${targetW} × ${targetH} px`;

        // Toggle quality slider visibility for lossy formats
        if (fmt === 'image/png') {
          qualityBox.classList.add('opacity-50', 'pointer-events-none');
        } else {
          qualityBox.classList.remove('opacity-50', 'pointer-events-none');
        }

        const quality = parseInt(qualSlider.value, 10) / 100;
        qualVal.textContent = `${qualSlider.value}%`;

        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d');

        // Background fill handling
        let fillColor = bgFillSelect.value;
        if (fillColor === 'custom') fillColor = customColor.value;

        if (fmt === 'image/jpeg' && fillColor === 'transparent') {
          fillColor = '#ffffff'; // JPEG cannot have transparent background
        }

        if (fillColor !== 'transparent') {
          ctx.fillStyle = fillColor;
          ctx.fillRect(0, 0, targetW, targetH);
        }

        ctx.drawImage(loadedImg, 0, 0, targetW, targetH);

        canvas.toBlob((blob) => {
          if (!blob) return;
          if (convBlobUrl) URL.revokeObjectURL(convBlobUrl);

          convBlobUrl = URL.createObjectURL(blob);
          imgConvPreview.src = convBlobUrl;

          const extName = fmt === 'image/webp' ? 'WEBP' : fmt === 'image/png' ? 'PNG' : 'JPEG';
          statTargetFmt.textContent = extName;
          statConvSize.textContent = formatBytes(blob.size);
          convBadge.textContent = `${extName} &bull; ${formatBytes(blob.size)}`;
        }, fmt, quality);
      }

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        origFileName = file.name;
        origSizeBytes = file.size;

        const reader = new FileReader();
        reader.onload = (loadEvt) => {
          const img = new Image();
          img.onload = () => {
            loadedImg = img;
            thumbPreview.src = img.src;
            thumbName.textContent = file.name;
            thumbInfo.textContent = `${formatBytes(file.size)} &bull; ${img.naturalWidth} &times; ${img.naturalHeight} px`;

            const ext = file.name.split('.').pop()?.toUpperCase() || 'IMG';
            statOrigFmt.textContent = ext;
            statOrigSize.textContent = formatBytes(file.size);

            uploadPrompt.classList.add('hidden');
            uploadPreviewBox.classList.remove('hidden');
            convCard.classList.remove('hidden');

            convert();
          };
          img.src = loadEvt.target.result;
        };
        reader.readAsDataURL(file);
      });

      targetFmt.addEventListener('change', convert);
      bgFillSelect.addEventListener('change', () => {
        if (bgFillSelect.value === 'custom') {
          customColor.classList.remove('hidden');
        } else {
          customColor.classList.add('hidden');
        }
        convert();
      });
      customColor.addEventListener('input', convert);
      qualSlider.addEventListener('input', convert);
      scaleSelect.addEventListener('change', convert);

      dlBtn.addEventListener('click', () => {
        if (!convBlobUrl) return;
        const fmt = targetFmt.value;
        const ext = fmt === 'image/webp' ? '.webp' : fmt === 'image/png' ? '.png' : '.jpg';
        const base = origFileName.substring(0, origFileName.lastIndexOf('.')) || origFileName;

        const a = document.createElement('a');
        a.href = convBlobUrl;
        a.download = `${base}-converted${ext}`;
        a.click();
      });
    })();
  </script>
</SiteLayout>
