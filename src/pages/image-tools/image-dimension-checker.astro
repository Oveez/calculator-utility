---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CalculatorParameterGuide from '../../components/calculator/CalculatorParameterGuide.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Image Dimension Checker — Exact Width, Height & Megapixels · ${siteName}`;
const pageDesc = 'Check image resolution, pixel width, pixel height, megapixels, and display standards online instantly. Fast, private in-browser image dimensions tool with zero uploads.';
const canonicalUrl = toAbsoluteUrl('/image-tools/image-dimension-checker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Image Tools', href: toAbsoluteUrl('/image-tools/') },
  { label: 'Image Dimension Checker' },
];

const schemaFaq = [
  {
    question: 'How does this tool check image dimensions?',
    answer: 'It uses HTML5 Image objects in JavaScript to read `naturalWidth` and `naturalHeight` directly from your chosen local file in milliseconds without uploading photos to external servers.',
  },
  {
    question: 'How is the megapixel count calculated from dimensions?',
    answer: 'Total Megapixels is calculated using the formula `(Width * Height) / 1,000,000`. For example, a 4000x3000 photo equals 12,000,000 pixels or 12.0 Megapixels.',
  },
  {
    question: 'What resolution is needed for sharp physical prints?',
    answer: 'For high-quality 300 DPI photo printing, divide pixel width and height by 300 to find maximum print dimensions in inches. For example, a 3000x2400 pixel image prints sharply up to 10x8 inches.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Image Dimension Checker',
    url: canonicalUrl,
    applicationCategory: 'ImageApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-dim-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Resolution &amp; Megapixel Inspector &bull; Zero Server Latency</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Image Dimension Checker
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Find out the exact pixel width, pixel height, aspect ratio, and megapixel count of any image. Compare against industry resolution standards (HD, 4K, 8K) and print size limits.
      </p>
    </header>

    <!-- Telemetry Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Dimensions</p>
        <p id="stat-dim" class="mt-1 font-mono text-base font-bold text-emerald-500">1920 &times; 1080</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Megapixels</p>
        <p id="stat-mp" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">2.07 MP</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Display Standard</p>
        <p id="stat-std" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">Full HD (1080p)</p>
      </div>
      <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Orientation</p>
        <p id="stat-orient" class="mt-1 font-mono text-base font-bold text-[color:var(--fg)]">Landscape</p>
      </div>
    </div>

    <div class="space-y-6">
      <!-- Upload Dropzone -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="img-file" accept="image/*" class="hidden" />
        <label for="img-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="image" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Drop an image here or click to upload</p>
          <p class="text-xs text-[color:var(--muted)]">Checks width, height &amp; megapixels locally (100% private in browser)</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="h-14 w-14 rounded-xl bg-[color:var(--surface-strong)] overflow-hidden shrink-0 flex items-center justify-center border border-[color:var(--border)]">
              <img id="thumb-preview" alt="Thumbnail" class="max-h-full max-w-full object-cover" />
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">image.png</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)] font-mono">0 KB</p>
            </div>
          </div>
          <label for="img-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change Image
          </label>
        </div>
      </div>

      <!-- Manual Input & Resolution Breakdown -->
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-4 text-xs">
          <p class="font-bold uppercase tracking-wider text-[color:var(--muted)] text-[10px]">Dimension Inputs</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="inp-w" class="font-bold text-[color:var(--fg)] block mb-1">Width (px):</label>
              <input
                type="number"
                id="inp-w"
                value="1920"
                min="1"
                class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)] font-semibold"
              />
            </div>
            <div>
              <label for="inp-h" class="font-bold text-[color:var(--fg)] block mb-1">Height (px):</label>
              <input
                type="number"
                id="inp-h"
                value="1080"
                min="1"
                class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)] font-semibold"
              />
            </div>
          </div>

          <div class="pt-2 border-t border-[color:var(--border)] space-y-2">
            <span class="text-[11px] font-bold text-[color:var(--muted)]">Presets:</span>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" data-dim="1280,720" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 text-[11px] hover:border-[color:var(--border-strong)]">HD 720p</button>
              <button type="button" data-dim="1920,1080" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 text-[11px] hover:border-[color:var(--border-strong)]">FHD 1080p</button>
              <button type="button" data-dim="2560,1440" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 text-[11px] hover:border-[color:var(--border-strong)]">2K 1440p</button>
              <button type="button" data-dim="3840,2160" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 text-[11px] hover:border-[color:var(--border-strong)]">4K UHD</button>
              <button type="button" data-dim="7680,4320" class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] px-2.5 py-1 text-[11px] hover:border-[color:var(--border-strong)]">8K UHD</button>
            </div>
          </div>
        </div>

        <!-- Calculated Specifications Grid -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 space-y-3 text-xs">
          <p class="font-bold uppercase tracking-wider text-[color:var(--muted)] text-[10px]">Calculated Specifications</p>
          <div class="grid grid-cols-2 gap-2 font-mono">
            <div class="rounded-xl bg-[color:var(--bg)] p-3">
              <span class="text-[10px] text-[color:var(--muted)] block">Total Pixels:</span>
              <strong id="spec-pixels" class="text-[color:var(--fg)] text-sm">2,073,600</strong>
            </div>
            <div class="rounded-xl bg-[color:var(--bg)] p-3">
              <span class="text-[10px] text-[color:var(--muted)] block">Aspect Ratio:</span>
              <strong id="spec-ratio" class="text-[color:var(--fg)] text-sm">16:9 (1.78)</strong>
            </div>
            <div class="rounded-xl bg-[color:var(--bg)] p-3">
              <span class="text-[10px] text-[color:var(--muted)] block">Max 300 DPI Print:</span>
              <strong id="spec-print-in" class="text-[color:var(--fg)] text-sm">6.4 &times; 3.6 in</strong>
            </div>
            <div class="rounded-xl bg-[color:var(--bg)] p-3">
              <span class="text-[10px] text-[color:var(--muted)] block">Max 300 DPI Metric:</span>
              <strong id="spec-print-cm" class="text-[color:var(--fg)] text-sm">16.3 &times; 9.1 cm</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Recommended Device & Media Matrix -->
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Recommended Media &amp; Display Suitability</h2>
        
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 text-xs">
          <div id="suit-web" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 space-y-1">
            <span class="font-bold text-[color:var(--fg)] block">Web &amp; Blog Images</span>
            <p class="text-[11px] text-[color:var(--muted)]">Optimal for hero banners and responsive article figures.</p>
          </div>

          <div id="suit-social" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 space-y-1">
            <span class="font-bold text-[color:var(--fg)] block">Social Media Posts</span>
            <p class="text-[11px] text-[color:var(--muted)]">High fidelity for Instagram, LinkedIn, and X timeline cards.</p>
          </div>

          <div id="suit-desktop" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 space-y-1">
            <span class="font-bold text-[color:var(--fg)] block">Desktop Display</span>
            <p class="text-[11px] text-[color:var(--muted)]">Full screen wallpaper fidelity across HD and Retina displays.</p>
          </div>

          <div id="suit-print" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 space-y-1">
            <span class="font-bold text-[color:var(--fg)] block">Physical Print Limit</span>
            <p id="print-limit-desc" class="text-[11px] text-[color:var(--muted)]">Up to 4x6" photo print without pixelation.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Parameter Guide & Worked Example -->
    <CalculatorParameterGuide
      title="Resolution Standards & Megapixel Formulas"
      description="Specifications for raster image arrays, display pixel grids, and print resolution density."
      parameters={[
        {
          name: "Megapixels (MP)",
          type: "Numeric Formula",
          defaultValue: "(W * H) / 1,000,000",
          description: "One megapixel represents exactly one million pixels. Digital camera sensors and smartphone cameras benchmark their capture resolution by megapixels.",
        },
        {
          name: "Full HD (1080p)",
          type: "Display Standard",
          defaultValue: "1920 × 1080 px",
          description: "High-definition video and monitor standard totaling 2.07 megapixels with a native 16:9 widescreen aspect ratio.",
        },
        {
          name: "4K UHD (2160p)",
          type: "Display Standard",
          defaultValue: "3840 × 2160 px",
          description: "Ultra-high definition standard totaling 8.29 megapixels, offering exactly 4 times the resolution of Full HD.",
        },
      ]}
      workedExample={{
        title: "Calculating Resolution & Print Density for a 48 MP Smartphone Photo",
        description: "Analyze an 8000x6000 pixel raw photograph to compute its megapixels, aspect ratio, and physical print size at 300 DPI.",
        formula: "Pixels = 8000 * 6000 = 48,000,000 -> 48.0 MP",
        steps: [
          {
            step: "Compute Total Pixels",
            calculation: "8000 * 6000 = 48,000,000 pixels.",
            result: "48,000,000 px",
          },
          {
            step: "Convert to Megapixels",
            calculation: "48,000,000 / 1,000,000 = 48.0 MP.",
            result: "48.0 Megapixels",
          },
          {
            step: "Compute Simplified Ratio",
            calculation: "8000 / 2000 = 4, 6000 / 2000 = 3 -> 4:3 ratio.",
            result: "4:3 Standard Photo Ratio",
          },
          {
            step: "Calculate Maximum 300 DPI Print",
            calculation: "8000 / 300 = 26.7 inches; 6000 / 300 = 20.0 inches.",
            result: "Prints up to 26.7 × 20.0 in (A2 poster size)",
          },
        ],
      }}
    />

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">&#9660;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-dim-app]');
      if (!root) return;

      const fileIn = root.querySelector('#img-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbPreview = root.querySelector('#thumb-preview');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');

      const inpW = root.querySelector('#inp-w');
      const inpH = root.querySelector('#inp-h');

      const statDim = root.querySelector('#stat-dim');
      const statMp = root.querySelector('#stat-mp');
      const statStd = root.querySelector('#stat-std');
      const statOrient = root.querySelector('#stat-orient');

      const specPixels = root.querySelector('#spec-pixels');
      const specRatio = root.querySelector('#spec-ratio');
      const specPrintIn = root.querySelector('#spec-print-in');
      const specPrintCm = root.querySelector('#spec-print-cm');
      const printLimitDesc = root.querySelector('#print-limit-desc');

      function gcd(a, b) {
        return b === 0 ? a : gcd(b, a % b);
      }

      function update() {
        const w = parseInt(inpW.value, 10) || 0;
        const h = parseInt(inpH.value, 10) || 0;

        if (w <= 0 || h <= 0) {
          statDim.textContent = '-';
          statMp.textContent = '0 MP';
          statStd.textContent = '-';
          statOrient.textContent = '-';
          return;
        }

        statDim.textContent = `${w} × ${h}`;
        const totalPixels = w * h;
        specPixels.textContent = totalPixels.toLocaleString();

        const mp = (totalPixels / 1000000).toFixed(2);
        statMp.textContent = `${mp} MP`;

        if (w > h) statOrient.textContent = 'Landscape';
        else if (h > w) statOrient.textContent = 'Portrait';
        else statOrient.textContent = 'Square';

        // Aspect ratio
        const div = gcd(w, h);
        const rw = w / div;
        const rh = h / div;
        const dec = (w / h).toFixed(2);
        specRatio.textContent = `${rw}:${rh} (${dec}:1)`;

        // Display Standard classification
        let std = 'Custom Resolution';
        if (w === 7680 && h === 4320) std = '8K UHD (4320p)';
        else if (w === 3840 && h === 2160) std = '4K UHD (2160p)';
        else if (w === 2560 && h === 1440) std = '2K QHD (1440p)';
        else if (w === 1920 && h === 1080) std = 'Full HD (1080p)';
        else if (w === 1280 && h === 720) std = 'HD (720p)';
        else if (totalPixels >= 33000000) std = '8K Class';
        else if (totalPixels >= 8000000) std = '4K Class';
        else if (totalPixels >= 3600000) std = '2K / QHD Class';
        else if (totalPixels >= 2000000) std = '1080p Class';
        else if (totalPixels >= 900000) std = '720p Class';
        statStd.textContent = std;

        // Print 300 DPI calculations
        const inW = (w / 300).toFixed(1);
        const inH = (h / 300).toFixed(1);
        specPrintIn.textContent = `${inW} × ${inH} in`;

        const cmW = (w / 300 * 2.54).toFixed(1);
        const cmH = (h / 300 * 2.54).toFixed(1);
        specPrintCm.textContent = `${cmW} × ${cmH} cm`;
        printLimitDesc.textContent = `Prints sharply up to ${inW} × ${inH} inches at 300 DPI.`;
      }

      inpW.addEventListener('input', update);
      inpH.addEventListener('input', update);

      root.querySelectorAll('[data-dim]').forEach(btn => {
        btn.addEventListener('click', () => {
          const [w, h] = btn.dataset.dim.split(',').map(Number);
          inpW.value = w;
          inpH.value = h;
          update();
        });
      });

      fileIn.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (loadEvt) => {
          const img = new Image();
          img.onload = () => {
            thumbPreview.src = img.src;
            thumbName.textContent = file.name;
            thumbInfo.textContent = `${(file.size / 1024).toFixed(1)} KB &bull; ${img.naturalWidth} &times; ${img.naturalHeight} px`;

            inpW.value = img.naturalWidth;
            inpH.value = img.naturalHeight;

            uploadPrompt.classList.add('hidden');
            uploadPreviewBox.classList.remove('hidden');

            update();
          };
          img.src = loadEvt.target.result;
        };
        reader.readAsDataURL(file);
      });

      update();
    })();
  </script>
</SiteLayout>
