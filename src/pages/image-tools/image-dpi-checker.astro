---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteName, toAbsoluteUrl, withBasePath } from '../../utils/site';

const pageTitle = `Image DPI & Print Size Calculator — Calculate PPI & Inches · ${siteName}`;
const pageDesc = 'Calculate physical print dimensions (inches & cm) from digital image pixel dimensions based on target DPI (72, 150, 300 DPI). 100% private in-browser tool.';
const canonicalUrl = toAbsoluteUrl('/image-tools/image-dpi-checker/');

const breadcrumbItems = [
  { label: 'Home', href: toAbsoluteUrl('/') },
  { label: 'Image Tools', href: toAbsoluteUrl('/image-tools/') },
  { label: 'Image DPI Calculator' },
];

const schemaFaq = [
  {
    question: 'What is the formula for calculating print dimensions from pixels and DPI?',
    answer: 'Print Width (inches) = Pixel Width / DPI. Print Width (cm) = (Pixel Width / DPI) * 2.54. High quality printing typically requires 300 DPI.',
  },
];

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Image DPI Calculator',
    url: canonicalUrl,
    applicationCategory: 'ImageApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    description: pageDesc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: schemaFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<SiteLayout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="space-y-10 py-2" data-dpi-app>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
              <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1 text-xs font-semibold text-[color:var(--muted)]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Print Dimension Calculator</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[color:var(--fg)]">
        Image DPI / PPI &amp; Print Size Calculator
      </h1>
      <p class="max-w-2xl text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
        Calculate physical print sizes in inches and centimeters for 72 screen, 150 draft, and 300 print DPI.
      </p>
    </header>

    <div class="space-y-6">
      <!-- Optional Dropzone for Image Auto-Detection -->
      <div id="dropzone-box" class="space-y-3 rounded-3xl border-2 border-dashed border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 text-center transition hover:border-[color:var(--border-strong)]">
        <input type="file" id="img-file" accept="image/*" class="hidden" />
        <label for="img-file" id="upload-prompt" class="cursor-pointer space-y-2 block">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[color:var(--surface-strong)] text-[color:var(--fg)]">
            <Icon name="image" class="w-6 h-6 text-[color:var(--accent)]" />
          </div>
          <p class="text-sm font-bold text-[color:var(--fg)]">Choose an image to auto-detect dimensions &amp; DPI</p>
          <p class="text-xs text-[color:var(--muted)]">Or manually type pixel values below (100% private in browser)</p>
        </label>

        <!-- Visual Upload Preview Box -->
        <div id="upload-preview-box" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="h-14 w-14 rounded-xl bg-[color:var(--surface-strong)] overflow-hidden shrink-0 flex items-center justify-center border border-[color:var(--border)]">
              <img id="thumb-preview" alt="Thumbnail" class="max-h-full max-w-full object-cover" />
            </div>
            <div class="min-w-0 space-y-0.5">
              <p id="thumb-name" class="text-xs sm:text-sm font-bold text-[color:var(--fg)] truncate">image.png</p>
              <p id="thumb-info" class="text-[11px] text-[color:var(--muted)]">0 KB</p>
            </div>
          </div>
          <label for="img-file" class="cursor-pointer shrink-0 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition">
            Change Image
          </label>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 text-xs">
        <div>
          <label for="px-w" class="font-bold text-[color:var(--fg)] block mb-1">Width (Pixels):</label>
          <input
            type="number"
            id="px-w"
            value="3000"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="px-h" class="font-bold text-[color:var(--fg)] block mb-1">Height (Pixels):</label>
          <input
            type="number"
            id="px-h"
            value="2000"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 font-mono text-[color:var(--fg)]"
          />
        </div>
        <div>
          <label for="target-dpi" class="font-bold text-[color:var(--fg)] block mb-1">Target DPI / PPI:</label>
          <select id="target-dpi" class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-[color:var(--fg)]">
            <option value="300">300 DPI (Magazine / Pro Print)</option>
            <option value="150">150 DPI (Newspaper / Posters)</option>
            <option value="72">72 DPI (Standard Web Screen)</option>
            <option value="96">96 DPI (Standard Windows Screen)</option>
          </select>
        </div>
      </div>

      <!-- Results Grid -->
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 space-y-2 text-center">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Print Size in Inches</span>
          <p id="res-in" class="text-3xl font-extrabold text-emerald-500">-</p>
        </div>
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 space-y-2 text-center">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Print Size in Centimeters</span>
          <p id="res-cm" class="text-3xl font-extrabold text-[color:var(--fg)]">-</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[color:var(--fg)]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {schemaFaq.map((faq) => (
          <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5">
            <summary class="cursor-pointer list-none font-semibold text-sm sm:text-base text-[color:var(--fg)] flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-xs text-[color:var(--muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-dpi-app]');
      if (!root) return;

      const fileIn = root.querySelector('#img-file');
      const uploadPrompt = root.querySelector('#upload-prompt');
      const uploadPreviewBox = root.querySelector('#upload-preview-box');
      const thumbPreview = root.querySelector('#thumb-preview');
      const thumbName = root.querySelector('#thumb-name');
      const thumbInfo = root.querySelector('#thumb-info');
      const pxW = root.querySelector('#px-w');
      const pxH = root.querySelector('#px-h');
      const targetDpi = root.querySelector('#target-dpi');
      const resIn = root.querySelector('#res-in');
      const resCm = root.querySelector('#res-cm');

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(2) + ' MB';
      }

      function calculate() {
        const w = parseFloat(pxW.value) || 0;
        const h = parseFloat(pxH.value) || 0;
        const dpi = parseFloat(targetDpi.value) || 300;

        const inW = (w / dpi).toFixed(2);
        const inH = (h / dpi).toFixed(2);

        const cmW = ((w / dpi) * 2.54).toFixed(2);
        const cmH = ((h / dpi) * 2.54).toFixed(2);

        resIn.textContent = `${inW}" × ${inH}"`;
        resCm.textContent = `${cmW} × ${cmH} cm`;
      }

      fileIn?.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const url = URL.createObjectURL(file);
        thumbPreview.src = url;
        thumbName.textContent = file.name;
        thumbInfo.textContent = `${formatBytes(file.size)} • ${file.type || 'image'}`;

        uploadPrompt.classList.add('hidden');
        uploadPreviewBox.classList.remove('hidden');

        const img = new Image();
        img.onload = () => {
          pxW.value = img.naturalWidth;
          pxH.value = img.naturalHeight;
          thumbInfo.textContent = `${img.naturalWidth}×${img.naturalHeight} px • ${formatBytes(file.size)}`;
          calculate();
        };
        img.src = url;
      });

      [pxW, pxH, targetDpi].forEach(el => el.addEventListener('input', calculate));
      calculate();
    })();
  </script>
</SiteLayout>
