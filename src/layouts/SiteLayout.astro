---
import SiteHeader from '../components/SiteHeader.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';
import { siteName, siteTagline, siteUrl, withBasePath } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
}

const {
  title = siteName,
  description = siteTagline,
  canonical,
  ogType = 'website',
} = Astro.props as Props;

const pageTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const logoUrl = new URL(withBasePath('/calculator.png'), siteUrl).toString();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "description": siteTagline,
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "logo": {
      "@type": "ImageObject",
      "url": logoUrl
    }
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/#calculators?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href={withBasePath('/calc.png')} />
    <link rel="apple-touch-icon" href={withBasePath('/calc.png')} />
    <link rel="manifest" href={withBasePath('/site.webmanifest')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={logoUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />
    <title>{pageTitle}</title>

    {/* Schema.org Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {/* Google Analytics & Search Console Integration */}
    <Analytics />

    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('calculator-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = savedTheme || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <script>
      import { initThemeToggle } from '../scripts/theme';
      initThemeToggle();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[color:var(--bg)] text-[color:var(--fg)] antialiased transition-colors duration-150">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-[color:var(--fg)] focus:px-4 focus:py-2 focus:text-xs focus:font-bold focus:text-[color:var(--bg)] focus:shadow-md"
      href="#content"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="content" class="flex-1 mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <!-- Clean, Professional Black & White Footer -->
    <footer class="mt-auto border-t border-[color:var(--border)] bg-[color:var(--surface)]">
      <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
          
          <!-- Column 1: Brand & About -->
          <div class="space-y-3 lg:col-span-1">
            <a class="flex items-center gap-2" href={withBasePath('/')}>
              <img
                src={withBasePath('/calc.png')}
                alt="Calculator Utility"
                class="h-6 w-6 rounded-md object-contain shrink-0"
                width="24"
                height="24"
              />
              <span class="text-sm font-bold tracking-tight text-[color:var(--fg)]">{siteName}</span>
            </a>
            <p class="text-xs leading-relaxed text-[color:var(--muted)]">
              Fast, privacy-first calculators, conversion tools, and professional resume builders running directly in your browser.
            </p>
          </div>

          <!-- Column 2: Career Tools -->
          <div class="space-y-2.5">
            <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Career Tools</p>
            <ul class="space-y-1.5 text-xs text-[color:var(--muted)]">
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/career-tools/cv-maker/')}>CV &amp; Resume Maker</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/career-tools/student-cv-maker/')}>Student CV Builder</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/career-tools/fresher-resume-maker/')}>Fresher Resume Maker</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/career-tools/ats-friendly-resume-guide/')}>ATS Resume Guide</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/career-tools/')}>All Career Tools</a></li>
            </ul>
          </div>

          <!-- Column 3: Tax & Finance -->
          <div class="space-y-2.5">
            <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Tax &amp; Finance</p>
            <ul class="space-y-1.5 text-xs text-[color:var(--muted)]">
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/tax-calculators/')}>Tax Calculators Hub</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/currency-converter/')}>Currency Converter</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/us-income-tax-calculator/')}>US Tax Calculator</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/uk-income-tax-calculator/')}>UK Salary Calculator</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/calculators/salary-calculator/')}>Salary Calculator</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/tax-calculators/vat-calculator/')}>Global VAT Calculator</a></li>
            </ul>
          </div>

          <!-- Column 4: Categories -->
          <div class="space-y-2.5">
            <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Categories</p>
            <ul class="space-y-1.5 text-xs text-[color:var(--muted)]">
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/#calculators?category=Finance')}>Finance &amp; Loans</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/#calculators?category=Health')}>Health &amp; Fitness</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/#calculators?category=Math')}>Math &amp; Numbers</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/#calculators?category=Education')}>Education &amp; Grades</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/#calculators?category=Text%20Tools')}>Text &amp; Words</a></li>
            </ul>
          </div>

          <!-- Column 5: Legal & Info -->
          <div class="space-y-2.5">
            <p class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Information</p>
            <ul class="space-y-1.5 text-xs text-[color:var(--muted)]">
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/about/')}>About</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/contact/')}>Contact Support</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/privacy/')}>Privacy Policy</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/terms/')}>Terms of Service</a></li>
              <li><a class="transition hover:text-[color:var(--fg)]" href={withBasePath('/disclaimer/')}>Disclaimer</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-8 border-t border-[color:var(--border)] pt-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[color:var(--muted)]">
          <p>© {new Date().getFullYear()} {siteName}. All rights reserved.</p>
          <p class="text-[11px]">Free, fast, and privacy-focused online utility tools.</p>
        </div>
      </div>
    </footer>

    {/* Cookie Consent Banner */}
    <CookieConsent />
  </body>
</html>
