---
import SiteHeader from '../components/SiteHeader.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';
import { siteName, siteTagline, siteUrl, withBasePath } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
}

const {
  title = siteName,
  description = siteTagline,
  canonical,
  ogType = 'website',
} = Astro.props as Props;

const pageTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "description": siteTagline,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/#calculators?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="manifest" href={withBasePath('/site.webmanifest')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>

    {/* Schema.org Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {/* Google Analytics & Search Console Integration */}
    <Analytics />

    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('calculator-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = savedTheme || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <script>
      import { initThemeToggle } from '../scripts/theme';

      initThemeToggle();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[color:var(--bg)] text-[color:var(--fg)] antialiased transition-colors duration-200">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-[color:var(--surface-strong)] focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-[color:var(--fg)] focus:shadow-[var(--shadow)]"
      href="#content"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="content" class="flex-1 mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="mt-auto border-t border-[color:var(--border)]/70 bg-[color:var(--surface)]/50 backdrop-blur-sm">
      <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-[color:var(--accent)] text-xs font-bold text-white shadow-sm">
                🧮
              </span>
              <span class="text-base font-semibold tracking-tight text-[color:var(--fg)]">{siteName}</span>
            </div>
            <p class="text-sm leading-6 text-[color:var(--muted)]">
              Fast, privacy-focused calculators that run 100% locally in your browser. No ads, no telemetry, no lag.
            </p>
          </div>

          <div class="space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--accent)]">Tax & Finance</p>
            <ul class="space-y-2 text-sm text-[color:var(--muted)]">
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/tax-calculators/')}>Tax Calculators Hub</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/currency-converter/')}>Currency Converter</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/us-income-tax-calculator/')}>US Tax Calculator</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/uk-income-tax-calculator/')}>UK Salary Calculator</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/canada-income-tax-calculator/')}>Canada Tax Calculator</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/tax-calculators/vat-calculator/')}>Global VAT Calculator</a></li>
            </ul>
          </div>

          <div class="space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--accent)]">Categories</p>
            <ul class="space-y-2 text-sm text-[color:var(--muted)]">
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/#calculators?category=Finance')}>Finance & Loans</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/#calculators?category=Converters')}>Converters & Currency</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/#calculators?category=Math')}>Math & Percentages</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/#calculators?category=Education')}>Education & GPA</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/#calculators?category=Health')}>Health & Fitness</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/#calculators?category=Date%20%26%20Time')}>Date & Time</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/#calculators?category=Text%20Tools')}>Text Tools</a></li>
            </ul>
          </div>

          <div class="space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--accent)]">Information</p>
            <ul class="space-y-2 text-sm text-[color:var(--muted)]">
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/about/')}>About This Project</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/contact/')}>Contact Support</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/privacy/')}>Privacy Policy</a></li>
              <li><a class="transition hover:text-[color:var(--accent)]" href={withBasePath('/terms/')}>Terms of Use</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 border-t border-[color:var(--border)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[color:var(--muted)]">
          <p>© {new Date().getFullYear()} {siteName}. 100% Client-side and Open Source.</p>
          <p>Built with Astro 7 & Tailwind CSS.</p>
        </div>
      </div>
    </footer>

    {/* Cookie Consent Banner */}
    <CookieConsent />
  </body>
</html>
