---
import SiteHeader from '../components/SiteHeader.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import MobileSearchModal from '../components/MobileSearchModal.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { siteName, siteTagline, siteUrl, withBasePath } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  heroLayout?: boolean;
  heroCompact?: boolean;
  showAds?: boolean;
}

const {
  title = siteName,
  description = siteTagline,
  canonical,
  ogType = 'website',
  heroLayout = false,
  heroCompact = false,
  showAds = true,
} = Astro.props as Props;

const pageTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
const canonicalUrl = canonical
  ? (canonical.startsWith('http://') || canonical.startsWith('https://') ? canonical : new URL(canonical, siteUrl).toString())
  : new URL(Astro.url.pathname, siteUrl).toString();
const logoUrl = new URL(withBasePath('/calculator.png'), siteUrl).toString();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "description": siteTagline,
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "logo": {
      "@type": "ImageObject",
      "url": logoUrl
    }
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/#calculators?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TS9777MY1R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-TS9777MY1R');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F4511E" />
    <link rel="icon" type="image/x-icon" href={withBasePath('/favicon.ico?v=4')} />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg?v=4')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBasePath('/calc.png?v=4')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBasePath('/apple-touch-icon.png?v=4')} />
    <link rel="manifest" href={withBasePath('/site.webmanifest?v=4')} />
    <!-- Google Fonts: Plus Jakarta Sans — Modern geometric SaaS typeface -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={logoUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />
    <title>{pageTitle}</title>

    {/* Schema.org Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {/* Google Analytics & Search Console Integration */}
    <Analytics />

    {/* Google AdSense Auto Ads */}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7945473545268589"
         crossorigin="anonymous"></script>
  </head>
  <body class="relative min-h-screen flex flex-col bg-white text-[color:var(--fg)] antialiased transition-colors duration-150">

    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-[color:var(--accent)] focus:px-4 focus:py-2 focus:text-xs focus:font-bold focus:text-white focus:shadow-md"
      href="#content"
    >
      Skip to content
    </a>

    <!-- Top Sticky Header -->
    <SiteHeader />

    <!-- Full-Width Top Banner (e.g. Homepage Hero Banner) -->
    {Astro.slots.has('top-banner') && (
      <slot name="top-banner" />
    )}

    <!-- Hero content preserved for homepage / category pages in a non-visible source without visible hero banner styling and layout -->
    {Astro.slots.has('hero') && (
      <div class="sr-only">
        <slot name="hero" />
      </div>
    )}

    <!-- Main Content Container -->
    <main
      id="content"
      class={`relative z-0 flex-1 mx-auto w-full max-w-6xl px-3 sm:px-6 lg:px-8 pb-10 ${heroLayout ? 'pt-0' : 'py-5 sm:py-8'}`}
    >
      <slot />
    </main>

    <!-- Clean, High-Contrast SaaS Dark Footer -->
    <Footer />

    <!-- Mobile Slide-out Drawer -->
    <MobileDrawer />

    <!-- Global / Mobile Quick Search Modal -->
    <MobileSearchModal />

    {/* Cookie Consent Banner */}
    <CookieConsent />
  </body>
</html>
