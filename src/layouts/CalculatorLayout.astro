---
import CalculatorEngine from '../components/CalculatorEngine.astro';
import SiteLayout from './SiteLayout.astro';
import type { BreadcrumbItem, CalculatorConfig, CalculatorFaqItem } from '../types/calculator';
import { siteName, toAbsoluteUrl } from '../utils/site';

interface Props {
  calculator: CalculatorConfig;
  breadcrumbs?: BreadcrumbItem[];
  faq?: CalculatorFaqItem[];
  canonical?: string;
}

const { calculator, breadcrumbs, faq = calculator.faq, canonical } = Astro.props as Props;
const breadcrumbItems =
  breadcrumbs ?? [
    { label: 'Home', href: toAbsoluteUrl('/') },
    { label: calculator.title },
  ];
const canonicalUrl = canonical ?? toAbsoluteUrl(`/calculators/${calculator.slug}/`);
const pageTitle = calculator.metaTitle ?? `${calculator.title} Calculator`;

const schemaGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: calculator.title,
    description: calculator.metaDescription,
    url: canonicalUrl,
    applicationCategory: calculator.category,
    operatingSystem: 'Web',
    publisher: {
      '@type': 'Organization',
      name: siteName,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems
      .filter((item): item is BreadcrumbItem & { href: string } => Boolean(item.href))
      .map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: item.href,
      })),
  },
  ...(faq.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map((entry) => ({
            '@type': 'Question',
            name: entry.question,
            acceptedAnswer: {
              '@type': 'Answer',
              text: entry.answer,
            },
          })),
        },
      ]
    : []),
];
---

<SiteLayout title={pageTitle} description={calculator.metaDescription} canonical={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <!-- 1. Breadcrumb / compact page context -->
  <nav aria-label="Breadcrumb" class="site-tool-breadcrumb mb-6 pt-1">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--muted)]">
      {breadcrumbItems.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && <span aria-hidden="true" class="opacity-50">/</span>}
          {item.href ? (
            <a class="transition hover:text-[color:var(--fg)]" href={item.href}>
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="font-semibold text-[color:var(--fg)]">
              {item.label}
            </span>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <!-- 2. ACTUAL TOOL UI (first major content users see) -->
  <div class="site-tool-engine-wrapper">
    <CalculatorEngine calculator={calculator} />
  </div>

  <!-- 3. Description Section Header -->
  <header class="space-y-3 mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--fg)]">
      {calculator.title}
    </h1>
    <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
      {calculator.metaDescription}
    </p>
  </header>

  <!-- 4. Existing supporting content -->
  <slot />
</SiteLayout>
