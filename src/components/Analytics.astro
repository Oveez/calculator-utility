---
interface Props {
  gaId?: string;
  gscVerification?: string;
}

const gscVerification = Astro.props.gscVerification ?? import.meta.env.PUBLIC_GSC_VERIFICATION ?? '';
---

{/* Google Search Console HTML Tag Verification */}
{gscVerification && (
  <meta name="google-site-verification" content={gscVerification} />
)}
