---
import { getToolIconConfig } from '../utils/toolIcons';

interface Props {
  slug?: string;
  url?: string;
  title?: string;
  category?: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  slug = '',
  url = '',
  title = '',
  category = '',
  class: className = '',
  size = 'md',
} = Astro.props as Props;

const config = getToolIconConfig(slug || url, title, category);

/**
 * Standard Grey Outline Icon System (FontAwesome / SVGRepo style):
 *   - Clean, neutral outline tile (slate-50 background, slate-200 border)
 *   - Standard grey icon (text-slate-500)
 *   - On hover / cursor placement: theme's solid orange background with existing grey icon stroke
 */
const sizeClasses = {
  sm: 'w-8 h-8 rounded-xl p-1.5',
  md: 'w-10 h-10 rounded-xl p-2',
  lg: 'w-12 h-12 rounded-2xl p-2.5',
}[size];

const svgSizes = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
}[size];
---

<div
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded-xl border border-slate-200/90 bg-slate-50 text-slate-500 hover:text-slate-600 hover:border-[color:var(--accent)] hover:bg-[color:var(--accent)] group-hover:text-slate-600 group-hover:border-[color:var(--accent)] group-hover:bg-[color:var(--accent)] transition-all duration-200 shadow-2xs',
    sizeClasses,
    className,
  ]}
>
  <svg
    class:list={[svgSizes, 'stroke-current transition-colors duration-200']}
    viewBox={config.viewBox || '0 0 24 24'}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={config.svgPath}
  />
</div>
