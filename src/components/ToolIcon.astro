---
import { getToolIconConfig } from '../utils/toolIcons';

interface Props {
  slug?: string;
  url?: string;
  title?: string;
  category?: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  slug = '',
  url = '',
  title = '',
  category = '',
  class: className = '',
  size = 'md',
} = Astro.props as Props;

const config = getToolIconConfig(slug || url, title, category);

/**
 * iLovePDF-style solid squircle tile:
 *   - Solid vibrant background (e.g. bg-rose-500)
 *   - White SVG icon (text-white) — bold 2.5 stroke
 *   - No border (border-transparent)
 *   - Slight drop shadow for depth
 *   - Scale-up on parent group hover
 */
const sizeClasses = {
  sm: 'w-8 h-8 rounded-xl p-1.5',
  md: 'w-10 h-10 rounded-xl p-2',
  lg: 'w-12 h-12 rounded-2xl p-2.5',
}[size];

const svgSizes = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
}[size];
---

<div
  class:list={[
    'inline-flex shrink-0 items-center justify-center transition-transform duration-150 ease-out group-hover:scale-110',
    config.badgeBg,
    config.iconColor,
    sizeClasses,
    className,
  ]}
  style="box-shadow: 0 2px 6px rgba(0,0,0,0.14), 0 1px 2px rgba(0,0,0,0.08);"
>
  <svg
    class:list={[svgSizes]}
    viewBox={config.viewBox || '0 0 24 24'}
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={config.svgPath}
  />
</div>
