---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { siteName, withBasePath } from '../utils/site';
import { allToolsIndex } from '../data/allToolsIndex';

// Standard category ordering for header navigation items
const navCategories = [
  { key: 'Developer', label: 'Dev Tools' },
  { key: 'PDF', label: 'PDF Tools' },
  { key: 'Image', label: 'Images' },
  { key: 'Text', label: 'Text Tools' },
  { key: 'Data', label: 'Data' },
  { key: 'Generators', label: 'Generators' },
  { key: 'Finance', label: 'Finance' },
  { key: 'Tax & Finance', label: 'Tax Tools' },
];

const headerCategoriesWithTools = navCategories.map((cat) => {
  const tools = allToolsIndex
    .filter((tool) => tool.category === cat.key)
    .sort((a, b) => a.title.localeCompare(b.title));
  return {
    key: cat.key,
    label: cat.label,
    tools,
  };
});
---

<header id="site-header-nav" class="border-b border-slate-200/80 bg-white shadow-xs text-slate-800">
  <div class="site-header-inner mx-auto w-full max-w-7xl px-4 py-[12px] sm:py-[14px] sm:px-6 lg:px-6 xl:px-8">
    <!-- Brand Logo (Left Column) - Default dark text logo for solid white header -->
    <div class="site-header-left flex items-center justify-start shrink-0">
      <a class="flex items-center transition-transform duration-200 hover:scale-[1.02]" href={withBasePath('/')} aria-label={`${siteName} Home`}>
        <BrandMark size="md" variant="default" />
      </a>
    </div>

    <!-- Desktop Navigation: Minimal text-only category headers with dropdown pane (Center Column) -->
    <nav class="site-header-center hidden lg:flex items-center justify-center gap-0.5 xl:gap-1.5 shrink-0" aria-label="Primary">
      {headerCategoriesWithTools.map((cat) => (
        <div class="nav-dropdown-item relative">
          <!-- Text-only category trigger button with chevron (Highlight with theme color, no boxy shape) -->
          <button
            type="button"
            class="nav-trigger-btn flex items-center gap-1 px-2 xl:px-2.5 py-2 text-[13px] xl:text-[14px] font-semibold text-slate-700 hover:text-[color:var(--accent)] transition-colors cursor-pointer select-none bg-transparent whitespace-nowrap"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span>{cat.label}</span>
            <svg class="chevron-icon w-3 h-3 stroke-current text-slate-400 opacity-80 transition-all duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Dropdown Pane Table matching screenshot: crisp white rounded card with shadow -->
          <div class="nav-dropdown-pane absolute top-full left-0 pt-2 z-50">
            <div class="dropdown-card w-64 max-h-[70vh] overflow-y-auto rounded-lg bg-white shadow-xl border border-gray-100 py-2.5">
              <div class="flex flex-col">
                {cat.tools.map((tool) => (
                  <a
                    href={withBasePath(tool.url)}
                    class="nav-tool-link block px-4 py-2 text-[13px] font-normal text-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[color:var(--accent)]"
                  >
                    {tool.title}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </nav>

    <!-- Header Actions (Right Column) -->
    <div class="site-header-right flex items-center gap-2 shrink-0 justify-end">
      <!-- Simple icon-only search button (Mobile view) -->
      <button
        type="button"
        data-trigger-search
        class="nav-action-icon flex sm:hidden h-10 w-10 items-center justify-center rounded-full text-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] cursor-pointer"
        aria-label="Search all tools"
      >
        <Icon name="search" class="h-5 w-5 stroke-[2]" />
      </button>

      <!-- Simple icon-only search button (Desktop & Tablet view) -->
      <button
        type="button"
        data-trigger-search
        class="nav-action-icon hidden sm:flex h-10 w-10 items-center justify-center rounded-full text-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] cursor-pointer shrink-0"
        aria-label="Search all tools"
      >
        <Icon name="search" class="h-5 w-5 stroke-[2]" />
      </button>

      <!-- Simple three-line hamburger button (Mobile & Tablet) -->
      <button
        type="button"
        data-trigger-drawer
        class="nav-action-icon flex h-10 w-10 lg:hidden items-center justify-center rounded-full text-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] cursor-pointer"
        aria-label="Open navigation drawer"
      >
        <svg class="h-5 w-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  @media (min-width: 640px) {
    .site-header-inner {
      padding-top: 14px;
      padding-bottom: 14px;
    }
  }
  @media (min-width: 1024px) {
    .site-header-inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.5rem;
    }
    .site-header-left {
      justify-self: start;
    }
    .site-header-center {
      justify-self: center;
      margin: 0 auto;
    }
    .site-header-right {
      justify-self: end;
    }
  }

  /* Keep dropdowns open only while the pointer is over the trigger or pane. */
  .nav-dropdown-pane {
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
    pointer-events: none;
  }

  .nav-dropdown-item:hover .nav-dropdown-pane {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-dropdown-item:hover .nav-trigger-btn {
    color: var(--accent);
  }

  .nav-dropdown-item:hover .chevron-icon {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .nav-action-icon:hover,
  .nav-action-icon:focus-visible {
    background-color: var(--accent);
    color: #fff !important;
    border-radius: 9999px !important;
  }

  .nav-action-icon:hover svg,
  .nav-action-icon:focus-visible svg {
    color: #fff !important;
    stroke: #fff !important;
  }

  /* Keep hamburger menu and search icon hover/focus cursor placing effect circular */
  .nav-action-icon,
  .nav-action-icon:focus-visible {
    border-radius: 9999px !important;
    overflow: hidden;
  }

  .nav-action-icon:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Keep tool labels legible and consistently accent-colored when highlighted. */
  .nav-tool-link:hover,
  .nav-tool-link:focus-visible {
    background-color: var(--accent-soft);
    color: var(--accent) !important;
  }

  /* Custom subtle scrollbar for long category lists */
  .dropdown-card::-webkit-scrollbar {
    width: 5px;
  }
  .dropdown-card::-webkit-scrollbar-track {
    background: #f8fafc;
  }
  .dropdown-card::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }
</style>
