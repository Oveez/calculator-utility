---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { siteName, withBasePath } from '../utils/site';

const navigationItems = [
  { href: withBasePath('/developer-tools/'), label: 'Dev Tools', icon: 'code', color: 'text-blue-500' },
  { href: withBasePath('/text-tools/'), label: 'Text Tools', icon: 'text', color: 'text-purple-500' },
  { href: withBasePath('/data-tools/'), label: 'Data', icon: 'converter', color: 'text-teal-500' },
  { href: withBasePath('/image-tools/'), label: 'Images', icon: 'image', color: 'text-emerald-500' },
  { href: withBasePath('/pdf-tools/'), label: 'PDF Tools', icon: 'document', color: 'text-rose-500' },
  { href: withBasePath('/generators/'), label: 'Generators', icon: 'dice', color: 'text-amber-500' },
  { href: withBasePath('/#calculators'), label: 'All Tools', icon: 'grid', color: 'text-[color:var(--muted)]' },
];
---

<header class="sticky top-0 z-40 border-b border-[color:var(--border)] bg-[color:var(--surface)]/95 backdrop-blur-md shadow-xs transition-colors">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand Logo + Site Name -->
    <a class="flex items-center gap-2.5 transition hover:opacity-90 shrink-0" href={withBasePath('/')} aria-label={`${siteName} Home`}>
      <BrandLogo class="h-9 w-9 shrink-0" />
      <div class="flex flex-col">
        <span class="text-sm sm:text-base font-bold tracking-tight text-[color:var(--fg)] leading-none">
          {siteName}
        </span>
        <span class="text-[10px] font-medium text-[color:var(--muted)] mt-0.5 hidden sm:inline">
          Online Calculators &amp; Utilities
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {navigationItems.map((item) => (
        <a
          class="group flex items-center gap-1.5 rounded-xl border border-transparent px-2.5 py-1.5 text-xs font-semibold text-[color:var(--muted)] transition-all duration-200 hover:bg-[color:var(--surface-strong)] hover:text-[color:var(--fg)] hover:border-[color:var(--border)]"
          href={item.href}
        >
          <Icon name={item.icon as any} class={`w-[18px] h-[18px] transition-transform duration-200 group-hover:scale-110 shrink-0 ${item.color}`} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Header Actions (Search + Theme Toggle + Mobile Menu Trigger) -->
    <div class="flex items-center gap-2">
      <!-- Quick Search Trigger Button -->
      <button
        type="button"
        data-trigger-search
        class="hidden sm:flex h-9 items-center gap-2 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-2.5 sm:px-3 text-xs text-[color:var(--muted)] hover:border-[color:var(--border-strong)] hover:shadow-sm hover:text-[color:var(--fg)] transition cursor-pointer"
        aria-label="Search all tools"
      >
        <Icon name="search" class="h-3.5 w-3.5 text-blue-500" />
        <span class="font-medium">Search 186+ tools...</span>
        <kbd class="hidden md:inline rounded-md border border-[color:var(--border)] bg-[color:var(--surface)] px-1.5 py-0.5 text-[10px] font-mono text-[color:var(--fg)] shadow-xs">/</kbd>
      </button>

      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Mobile Hamburger Button (Triggers slide-out Drawer) -->
      <button
        type="button"
        data-trigger-drawer
        class="flex h-9 w-9 md:hidden items-center justify-center rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)] transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current cursor-pointer"
        aria-label="Open navigation drawer"
      >
        <svg class="h-4.5 w-4.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>