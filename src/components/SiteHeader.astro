---
import ThemeToggle from './ThemeToggle.astro';
import { siteName, withBasePath } from '../utils/site';

const navigationItems = [
  { href: withBasePath('/'), label: 'Home' },
  { href: withBasePath('/developer-tools/'), label: 'Dev Tools' },
  { href: withBasePath('/text-tools/'), label: 'Text Tools' },
  { href: withBasePath('/data-tools/'), label: 'Data & CSV' },
  { href: withBasePath('/image-tools/'), label: 'Images' },
  { href: withBasePath('/pdf-tools/'), label: 'PDF Tools' },
  { href: withBasePath('/color-tools/'), label: 'Colors' },
  { href: withBasePath('/generators/'), label: 'Generators' },
  { href: withBasePath('/#calculators'), label: 'All Tools' },
];
---

<header class="sticky top-0 z-40 border-b border-[color:var(--border)] bg-[color:var(--bg)]/85 backdrop-blur-lg shadow-xs transition-colors">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand Logo + Site Name -->
    <a class="flex items-center gap-2.5 transition hover:opacity-90 shrink-0" href={withBasePath('/')} aria-label={`${siteName} Home`}>
      <img
        src={withBasePath('/calc.png')}
        alt="Calculator Utility Icon"
        class="h-8 w-8 rounded-lg object-contain shrink-0"
        width="32"
        height="32"
        loading="eager"
      />
      <div class="flex flex-col">
        <span class="text-sm sm:text-base font-bold tracking-tight text-[color:var(--fg)] leading-none">
          {siteName}
        </span>
        <span class="text-[10px] font-medium text-[color:var(--muted)] mt-0.5 hidden sm:inline">
          Online Calculators &amp; Utilities
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {navigationItems.map((item) => (
        <a
          class="rounded-lg px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] transition hover:bg-[color:var(--surface-strong)] hover:text-[color:var(--fg)]"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Search + Theme Toggle + Mobile Menu Trigger) -->
    <div class="flex items-center gap-2">
      <!-- Quick Search Trigger Button (Desktop & Tablet only; mobile uses the dedicated Bottom Nav search button) -->
      <button
        type="button"
        data-trigger-search
        class="hidden sm:flex h-9 items-center gap-2 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 sm:px-3 text-xs text-[color:var(--muted)] hover:border-[color:var(--accent)] hover:shadow-[0_0_14px_var(--accent-glow)] hover:text-[color:var(--fg)] transition cursor-pointer"
        aria-label="Search all tools"
      >
        <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="font-medium">Search 186+ tools...</span>
        <kbd class="hidden md:inline rounded-md border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-1.5 py-0.5 text-[10px] font-mono text-[color:var(--muted)]">/</kbd>
      </button>

      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Mobile Hamburger Button (Triggers slide-out Drawer) -->
      <button
        type="button"
        data-trigger-drawer
        class="flex h-9 w-9 md:hidden items-center justify-center rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--fg)] hover:border-[color:var(--border-strong)] transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]"
        aria-label="Open navigation drawer"
      >
        <svg class="h-4.5 w-4.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>
