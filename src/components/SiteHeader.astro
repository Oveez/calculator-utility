---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { siteName, withBasePath } from '../utils/site';

const navigationItems = [
  { href: withBasePath('/developer-tools/'), label: 'Dev Tools', icon: 'code', bg: 'bg-blue-600' },
  { href: withBasePath('/text-tools/'), label: 'Text Tools', icon: 'text', bg: 'bg-purple-600' },
  { href: withBasePath('/data-tools/'), label: 'Data', icon: 'converter', bg: 'bg-teal-600' },
  { href: withBasePath('/image-tools/'), label: 'Images', icon: 'image', bg: 'bg-emerald-600' },
  { href: withBasePath('/pdf-tools/'), label: 'PDF Tools', icon: 'document', bg: 'bg-rose-600' },
  { href: withBasePath('/generators/'), label: 'Generators', icon: 'dice', bg: 'bg-amber-600' },
  { href: withBasePath('/#calculators'), label: 'All Categories', icon: 'grid', bg: 'bg-indigo-600' },
];

const currentPath = Astro.url.pathname;

function isNavActive(href: string): boolean {
  const [targetPath, targetHash] = href.split('#');
  if (targetHash) {
    return false; // Handled on client for hash matching
  }
  if (!targetPath || targetPath === withBasePath('/')) {
    return currentPath === withBasePath('/') || currentPath === '/';
  }
  return currentPath.startsWith(targetPath);
}
---

<header class="sticky top-0 z-40 border-b border-slate-800 bg-[#0F172A] shadow-md transition-colors text-white">
  <div class="site-header-inner mx-auto w-full max-w-7xl px-4 py-[11px] sm:py-[13px] sm:px-6 lg:px-6 xl:px-8">
    <!-- Brand Logo + Site Name (Left Column) -->
    <div class="site-header-left flex items-center justify-start shrink-0">
      <a class="flex items-center transition-transform duration-200 hover:scale-[1.02]" href={withBasePath('/')} aria-label={`${siteName} Home`}>
        <BrandMark size="md" variant="light" />
      </a>
    </div>

    <!-- Desktop Navigation (Center Column - Mathematically Centered & Non-Overlapping) -->
    <nav class="site-header-center hidden xl:flex items-center justify-center gap-1 xl:gap-1.5 shrink-0" aria-label="Primary">
      {navigationItems.map((item) => {
        const isActive = isNavActive(item.href);
        return (
          <a
            class:list={[
              'group flex items-center gap-1.5 rounded-xl px-2 py-2 xl:px-2.5 text-xs font-semibold transition-all duration-200 whitespace-nowrap',
              isActive
                ? 'active bg-[color:var(--tab-surface-hover)] text-[color:var(--tab-text-hover)] font-bold shadow-xs'
                : 'text-slate-200 hover:bg-slate-800 hover:text-white',
            ]}
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class={`flex h-7 w-7 items-center justify-center rounded-lg ${item.bg} text-white shadow-xs transition-transform duration-200 group-hover:scale-110 shrink-0`}>
              <Icon name={item.icon as any} class="w-3.5 h-3.5 text-white" />
            </span>
            <span class="tracking-tight">{item.label}</span>
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Right Column) -->
    <div class="site-header-right flex items-center gap-2 shrink-0 justify-end">
      <!-- Quick Search Trigger Button (Mobile view: contains only search icon, bright white) -->
      <button
        type="button"
        data-trigger-search
        class="flex sm:hidden h-10 w-10 items-center justify-center rounded-xl border border-slate-700/80 bg-slate-800/90 text-white hover:border-slate-500 hover:bg-slate-700 transition cursor-pointer shadow-xs"
        aria-label="Search all tools"
      >
        <Icon name="search" class="h-5 w-5 text-white stroke-[2.2]" />
      </button>

      <!-- Quick Search Trigger Button (Desktop & Tablet view) -->
      <button
        type="button"
        data-trigger-search
        class="hidden sm:flex h-10 items-center gap-2 rounded-xl border border-slate-700/80 bg-slate-800/90 px-2.5 sm:px-3 text-xs text-slate-300 hover:border-slate-600 hover:bg-slate-800 hover:text-white transition cursor-pointer whitespace-nowrap shrink-0 shadow-xs"
        aria-label="Search all tools"
      >
        <span class="flex h-5.5 w-5.5 items-center justify-center rounded-md bg-blue-600 text-white shadow-2xs shrink-0">
          <Icon name="search" class="h-3 w-3 text-white" />
        </span>
        <span class="font-medium text-xs whitespace-nowrap text-slate-200">Search..</span>
        <kbd class="hidden xl:inline rounded-md border border-slate-700 bg-slate-900 px-1.5 py-0.5 text-[10px] font-mono text-slate-300 shadow-xs">/</kbd>
      </button>

      <!-- Theme Toggle (Compact segmented switch) -->
      <ThemeToggle />

      <!-- Mobile & Tablet Hamburger Button (Triggers slide-out Drawer) -->
      <button
        type="button"
        data-trigger-drawer
        class="flex h-10 w-10 xl:hidden items-center justify-center rounded-xl border border-slate-700/80 bg-slate-800/90 text-white hover:border-slate-500 hover:bg-slate-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 cursor-pointer shadow-xs"
        aria-label="Open navigation drawer"
      >
        <svg class="h-5 w-5 stroke-white" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 11px;
    padding-bottom: 11px;
  }
  @media (min-width: 640px) {
    .site-header-inner {
      padding-top: 13px;
      padding-bottom: 13px;
    }
  }
  @media (min-width: 1280px) {
    .site-header-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1rem;
    }
    .site-header-left {
      justify-self: start;
    }
    .site-header-center {
      justify-self: center;
      margin: 0 auto;
      transform: translateX(-10px);
    }
    .site-header-right {
      justify-self: end;
    }
  }

  /* Current Active Tab Style — Exactly matches cursor hover effect */
  nav[aria-label="Primary"] a.active,
  nav[aria-label="Primary"] a[aria-current="page"] {
    background-color: var(--tab-surface-hover) !important;
    border-color: var(--tab-border-hover) !important;
    box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.08) !important;
    color: var(--tab-text-hover) !important;
    font-weight: 700 !important;
    transform: translateY(-1px);
  }
</style>

<script is:inline>
  (function() {
    function updateActiveHeaderNav() {
      const currentPath = window.location.pathname;
      const currentHash = window.location.hash;
      const links = document.querySelectorAll('nav[aria-label="Primary"] a');
      links.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const [rawPath, rawHash] = href.split('#');
        let isActive = false;
        if (rawHash && currentHash === '#' + rawHash) {
          isActive = true;
        } else if (rawPath && rawPath !== '/' && currentPath.startsWith(rawPath)) {
          isActive = true;
        } else if ((!rawPath || rawPath === '/') && (currentPath === '/' || currentPath === '')) {
          if (!currentHash || !rawHash || currentHash === '#' + rawHash) {
            isActive = true;
          }
        }
        if (isActive) {
          link.classList.add('active');
          link.setAttribute('aria-current', 'page');
        } else {
          link.classList.remove('active');
          link.removeAttribute('aria-current');
        }
      });
    }
    updateActiveHeaderNav();
    window.addEventListener('hashchange', updateActiveHeaderNav);
  })();
</script>