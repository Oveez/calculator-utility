---
import ThemeToggle from './ThemeToggle.astro';
import { siteName, withBasePath } from '../utils/site';

const navigationItems = [
  { href: withBasePath('/'), label: 'Home' },
  { href: withBasePath('/career-tools/cv-maker/'), label: 'CV Maker' },
  { href: withBasePath('/career-tools/'), label: 'Career Tools' },
  { href: withBasePath('/tax-calculators/'), label: 'Tax & Salary' },
  { href: withBasePath('/currency-converter/'), label: 'Currency' },
  { href: withBasePath('/#calculators'), label: 'All Tools' },
  { href: withBasePath('/about/'), label: 'About' },
];
---

<header class="sticky top-0 z-40 border-b border-[color:var(--border)] bg-[color:var(--bg)]/90 backdrop-blur-md transition-colors">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand Logo + Site Name -->
    <a class="flex items-center gap-2.5 transition hover:opacity-85 shrink-0" href={withBasePath('/')} aria-label={`${siteName} Home`}>
      <img
        src={withBasePath('/calc.png')}
        alt="Calculator Utility Icon"
        class="h-8 w-8 rounded-lg object-contain shrink-0"
        width="32"
        height="32"
        loading="eager"
      />
      <div class="flex flex-col">
        <span class="text-sm sm:text-base font-bold tracking-tight text-[color:var(--fg)] leading-none">
          {siteName}
        </span>
        <span class="text-[10px] font-medium text-[color:var(--muted)] mt-0.5 hidden sm:inline">
          Online Calculators &amp; Utilities
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {navigationItems.map((item) => (
        <a
          class="rounded-lg px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] transition hover:bg-[color:var(--surface-strong)] hover:text-[color:var(--fg)]"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Mobile Hamburger + Theme Toggle) -->
    <div class="flex items-center gap-2.5">
      <div class="md:hidden">
        <details class="group relative">
          <summary
            class="flex h-9 w-9 items-center justify-center list-none cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--fg)] shadow-xs transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]"
            aria-label="Open menu"
            data-mobile-menu-btn
          >
            <!-- Hamburger Icon (displayed when closed) -->
            <svg class="h-4.5 w-4.5 block group-open:hidden stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <!-- Close Icon (displayed when open) -->
            <svg class="h-4.5 w-4.5 hidden group-open:block stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </summary>
          <nav
            class="absolute right-0 z-50 mt-2 w-56 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-2 shadow-lg"
            aria-label="Mobile primary"
          >
            {navigationItems.map((item) => (
              <a
                class="block rounded-xl px-3.5 py-2 text-xs font-semibold text-[color:var(--fg)] transition hover:bg-[color:var(--surface-strong)]"
                href={item.href}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </details>
      </div>

      <ThemeToggle />
    </div>
  </div>
</header>
