---
import Icon from './Icon.astro';
import { withBasePath } from '../utils/site';

const currentPath = Astro.url.pathname;
const isHome = currentPath === withBasePath('/') || currentPath === '/';
const isTax = currentPath.includes('/tax-calculators') || currentPath.includes('-income-tax-calculator');
const isDev = currentPath.includes('/developer-tools');
const isCv = currentPath.includes('/career-tools/cv-maker');
---

<!-- Fixed App-Style Bottom Navigation Bar (Mobile only) -->
<nav
  id="mobile-bottom-nav"
  class="fixed bottom-0 left-0 right-0 z-40 md:hidden border-t border-slate-800 bg-[#0F172A]/95 backdrop-blur-xl shadow-lg transition-colors"
  aria-label="Mobile Bottom Navigation"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
>
  <div class="grid grid-cols-5 items-center justify-around h-14 px-1">
    <!-- 1. Home Tab -->
    <a
      href={withBasePath('/')}
      class:list={[
        'bottom-nav-tab flex flex-col items-center justify-center gap-1 py-1 text-center transition-colors group',
        isHome ? 'text-[color:var(--accent)] font-bold' : 'text-slate-400 hover:text-[color:var(--accent)] font-medium',
      ]}
      aria-label="Home"
    >
      <span class:list={['flex h-7 w-7 items-center justify-center rounded-lg border border-slate-700/60 bg-slate-800/80 text-slate-400 group-hover:text-[color:var(--accent)] group-hover:border-[color:var(--accent)]/40 transition-colors shrink-0', isHome && 'text-[color:var(--accent)] border-[color:var(--accent)]/50 bg-[color:var(--accent)]/10 ring-1 ring-[color:var(--accent)]/30']}>
        <!-- Tool-Home icon: house silhouette with a wrench inside -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10.5L12 3l9 7.5" />
          <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-4h4v4h4a1 1 0 0 0 1-1V9.5" />
          <path d="M12 13a1.5 1.5 0 0 1 1.5 1.5c0 .28-.08.54-.2.77l1.45 1.45-.7.7-1.45-1.45c-.23.13-.49.2-.77.2A1.5 1.5 0 0 1 10.5 14.5 1.5 1.5 0 0 1 12 13z" stroke-width="1.5" />
        </svg>
      </span>
      <span class="text-[10px] tracking-tight">Home</span>
    </a>

    <!-- 2. Tax Suite Tab -->
    <a
      href={withBasePath('/tax-calculators/')}
      class:list={[
        'bottom-nav-tab flex flex-col items-center justify-center gap-1 py-1 text-center transition-colors group',
        isTax ? 'text-[color:var(--accent)] font-bold' : 'text-slate-400 hover:text-[color:var(--accent)] font-medium',
      ]}
      aria-label="Tax & Salary Suite"
    >
      <span class:list={['flex h-7 w-7 items-center justify-center rounded-lg border border-slate-700/60 bg-slate-800/80 text-slate-400 group-hover:text-[color:var(--accent)] group-hover:border-[color:var(--accent)]/40 transition-colors shrink-0', isTax && 'text-[color:var(--accent)] border-[color:var(--accent)]/50 bg-[color:var(--accent)]/10 ring-1 ring-[color:var(--accent)]/30']}>
        <Icon name="finance" class="w-4 h-4 stroke-current" />
      </span>
      <span class="text-[10px] tracking-tight">Tax Hub</span>
    </a>

    <!-- 3. Instant Search Tab -->
    <button
      type="button"
      data-trigger-search
      class="bottom-nav-tab flex flex-col items-center justify-center gap-1 py-1 text-center text-slate-400 hover:text-[color:var(--accent)] cursor-pointer transition-colors group"
      aria-label="Search 186 Tools"
    >
      <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-slate-700/60 bg-slate-800/80 text-slate-400 group-hover:text-[color:var(--accent)] group-hover:border-[color:var(--accent)]/40 transition-colors shrink-0">
        <Icon name="search" class="w-4 h-4 stroke-current" />
      </span>
      <span class="text-[10px] tracking-tight font-medium text-slate-300 group-hover:text-[color:var(--accent)]">Search</span>
    </button>

    <!-- 4. Developer Tools Tab -->
    <a
      href={withBasePath('/developer-tools/')}
      class:list={[
        'bottom-nav-tab flex flex-col items-center justify-center gap-1 py-1 text-center transition-colors group',
        isDev ? 'text-[color:var(--accent)] font-bold' : 'text-slate-400 hover:text-[color:var(--accent)] font-medium',
      ]}
      aria-label="Developer Tools"
    >
      <span class:list={['flex h-7 w-7 items-center justify-center rounded-lg border border-slate-700/60 bg-slate-800/80 text-slate-400 group-hover:text-[color:var(--accent)] group-hover:border-[color:var(--accent)]/40 transition-colors shrink-0', isDev && 'text-[color:var(--accent)] border-[color:var(--accent)]/50 bg-[color:var(--accent)]/10 ring-1 ring-[color:var(--accent)]/30']}>
        <Icon name="code" class="w-4 h-4 stroke-current" />
      </span>
      <span class="text-[10px] tracking-tight">Dev Tools</span>
    </a>

    <!-- 5. CV Maker Tab -->
    <a
      href={withBasePath('/career-tools/cv-maker/')}
      class:list={[
        'bottom-nav-tab flex flex-col items-center justify-center gap-1 py-1 text-center transition-colors group',
        isCv ? 'text-[color:var(--accent)] font-bold' : 'text-slate-400 hover:text-[color:var(--accent)] font-medium',
      ]}
      aria-label="CV Maker"
    >
      <span class:list={['flex h-7 w-7 items-center justify-center rounded-lg border border-slate-700/60 bg-slate-800/80 text-slate-400 group-hover:text-[color:var(--accent)] group-hover:border-[color:var(--accent)]/40 transition-colors shrink-0', isCv && 'text-[color:var(--accent)] border-[color:var(--accent)]/50 bg-[color:var(--accent)]/10 ring-1 ring-[color:var(--accent)]/30']}>
        <Icon name="career" class="w-4 h-4 stroke-current" />
      </span>
      <span class="text-[10px] tracking-tight">CV Maker</span>
    </a>
  </div>
</nav>

<style>
  #mobile-bottom-nav,
  #mobile-bottom-nav * {
    -webkit-tap-highlight-color: transparent !important;
  }
  .bottom-nav-tab {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    transform: none !important;
    outline: none !important;
  }
  .bottom-nav-tab:hover,
  .bottom-nav-tab:active,
  .bottom-nav-tab:focus {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    transform: none !important;
    outline: none !important;
  }
</style>
