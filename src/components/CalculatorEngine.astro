---
import type { CalculatorConfig, CalculatorDetailedResult } from '../types/calculator';
import CalculatorInputGrid from './calculator/CalculatorInputGrid.astro';
import CalculatorResultCard from './calculator/CalculatorResultCard.astro';
import GradeCalculatorApp from './calculator/GradeCalculatorApp.astro';
import GpaCalculatorApp from './calculator/GpaCalculatorApp.astro';
import CgpaCalculatorApp from './calculator/CgpaCalculatorApp.astro';
import Icon from './Icon.astro';

interface Props {
  calculator: CalculatorConfig;
}

const { calculator } = Astro.props as Props;
const isDedicatedEducationApp =
  calculator.slug === 'grade-calculator' ||
  calculator.slug === 'gpa-calculator' ||
  calculator.slug === 'cgpa-calculator';

const initialValues = !isDedicatedEducationApp
  ? Object.fromEntries(
      calculator.inputs.map((input) => [
        input.id,
        input.defaultValue !== undefined
          ? input.defaultValue
          : input.type === 'select'
            ? input.options?.[0]?.value ?? ''
            : input.type === 'text' || input.type === 'textarea' || input.type === 'date' || input.type === 'datetime-local'
              ? ''
              : 0,
      ]),
    )
  : {};

const formulaInitial = !isDedicatedEducationApp ? calculator.formula(initialValues) : null;
const initialResult = !isDedicatedEducationApp && formulaInitial
  ? typeof formulaInitial === 'object' && 'primary' in formulaInitial
    ? (formulaInitial as CalculatorDetailedResult).primary.formattedValue
    : calculator.resultFormat(formulaInitial)
  : '';
---

{calculator.slug === 'grade-calculator' ? (
  <GradeCalculatorApp calculator={calculator} />
) : calculator.slug === 'gpa-calculator' ? (
  <GpaCalculatorApp calculator={calculator} />
) : calculator.slug === 'cgpa-calculator' ? (
  <CgpaCalculatorApp calculator={calculator} />
) : (
  <div data-calculator-root data-calculator-slug={calculator.slug} class="space-y-6">
    <div class="grid gap-8 lg:grid-cols-[1.35fr_0.85fr]">
      <form
        class="space-y-5"
        novalidate
        data-calculator-form
      >
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[color:var(--accent)]">Live Calculator</p>
            <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-[color:var(--fg)]">Enter your values</h2>
          </div>
          <span class="inline-flex items-center gap-1.5 rounded-none bg-[color:var(--accent-soft)] px-2.5 py-1 text-[11px] font-bold text-[color:var(--accent)] border border-[color:var(--accent)]/30 shrink-0">
            <span class="h-1.5 w-1.5 rounded-none bg-[color:var(--accent)] animate-pulse"></span>
            Real-Time
          </span>
        </div>

        <CalculatorInputGrid inputs={calculator.inputs} initialValues={initialValues} />

        <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-[color:var(--border)]">
          <div class="flex flex-wrap items-center gap-3">
            <button
              class="btn-action-indigo inline-flex items-center justify-center gap-2 rounded-none px-6 py-2.5 text-sm font-bold shadow-sm transition active:scale-98 cursor-pointer"
              type="submit"
              data-calculator-submit
            >
              <Icon name="bolt" class="w-4 h-4" />
              <span>Calculate</span>
            </button>
            <button
              class="inline-flex items-center justify-center gap-2 rounded-none border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-4 py-2.5 text-sm font-semibold text-[color:var(--fg)] shadow-xs transition hover:bg-[color:var(--border)]/30 hover:border-[color:var(--border-strong)] active:scale-98 cursor-pointer"
              type="button"
              data-calculator-reset
            >
              <Icon name="refresh" class="w-3.5 h-3.5" />
              <span>Reset</span>
            </button>
          </div>
          <p class="text-xs font-medium text-[color:var(--muted)] flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[color:var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Auto-calculates on edit
          </p>
        </div>
      </form>

      <CalculatorResultCard
        initialResult={initialResult}
        category={calculator.category}
        inputsCount={calculator.inputs.length}
      />
    </div>

    <script>
      import { initCalculatorEngines } from '../scripts/calculator-engine';

      initCalculatorEngines();
    </script>
  </div>
)}
