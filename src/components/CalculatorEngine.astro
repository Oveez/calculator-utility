---
import type { CalculatorConfig } from '../types/calculator';

interface Props {
  calculator: CalculatorConfig;
}

const { calculator } = Astro.props as Props;
const initialValues = Object.fromEntries(
  calculator.inputs.map((input) => [
    input.id,
    input.defaultValue ?? (input.type === 'select' ? input.options?.[0]?.value ?? '' : input.type === 'text' || input.type === 'textarea' || input.type === 'date' || input.type === 'datetime-local' ? '' : input.min ?? 0),
  ]),
);
const initialResult = calculator.resultFormat(calculator.formula(initialValues));
---

<section
  class="overflow-hidden rounded-[2rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] shadow-[var(--shadow)] transition-all"
  data-calculator-root
  data-calculator-slug={calculator.slug}
>
  <div class="grid gap-8 xl:grid-cols-[1.35fr_0.85fr]">
    <form
      class="space-y-6 p-6 sm:p-8"
      novalidate
      data-calculator-form
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[color:var(--accent)]">Live calculator</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-[color:var(--fg)]">Enter your values</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {calculator.inputs.map((input) => (
          <label class:list={[
            'block space-y-2 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition hover:border-[color:var(--accent)]/40',
            (input.type === 'textarea' || (input.type === 'text' && !calculator.inputs.some(i => i.id !== input.id))) ? 'sm:col-span-2' : ''
          ]}>
            <span class="flex items-center justify-between gap-3 text-sm font-medium text-[color:var(--fg)]">
              <span>{input.label}</span>
              <div class="flex items-center gap-2">
                {input.type === 'range' && (
                  <span class="rounded-lg bg-[color:var(--accent-soft)] px-2 py-0.5 text-xs font-semibold text-[color:var(--accent)]" data-range-val={input.id}>
                    {initialValues[input.id]}
                  </span>
                )}
                {input.unit && <span class="text-xs font-medium text-[color:var(--muted)]">{input.unit}</span>}
              </div>
            </span>

            {input.type === 'textarea' ? (
              <textarea
                class="w-full resize-y rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base text-[color:var(--fg)] shadow-inner outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                name={input.id}
                rows={input.rows ?? 4}
                placeholder={input.placeholder ?? input.label}
                aria-label={input.label}
              >{initialValues[input.id]}</textarea>
            ) : input.type === 'select' && input.options ? (
              <select
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base text-[color:var(--fg)] shadow-inner outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                name={input.id}
                aria-label={input.label}
              >
                {input.options.map((option) => (
                  <option value={option.value} selected={String(initialValues[input.id]) === option.value}>
                    {option.label}
                  </option>
                ))}
              </select>
            ) : input.type === 'range' ? (
              <input
                class="w-full accent-[color:var(--accent)] cursor-pointer py-2"
                type="range"
                name={input.id}
                min={input.min ?? 0}
                max={input.max ?? 100}
                step={input.step ?? 1}
                value={initialValues[input.id]}
                aria-label={input.label}
              />
            ) : (
              <input
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] px-4 py-3 text-base text-[color:var(--fg)] shadow-inner outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                type={input.type === 'date' ? 'date' : input.type === 'datetime-local' ? 'datetime-local' : input.type === 'number' ? 'number' : 'text'}
                name={input.id}
                min={input.type === 'text' || input.type === 'date' || input.type === 'datetime-local' ? undefined : input.min}
                max={input.type === 'text' || input.type === 'date' || input.type === 'datetime-local' ? undefined : input.max}
                step={input.type === 'text' || input.type === 'date' || input.type === 'datetime-local' ? undefined : input.step ?? 'any'}
                placeholder={input.placeholder ?? input.label}
                value={initialValues[input.id]}
                aria-label={input.label}
              />
            )}
          </label>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <div class="flex flex-wrap items-center gap-3">
          <button
            class="inline-flex items-center justify-center rounded-full bg-[color:var(--accent)] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[color:var(--accent-strong)] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--bg)]"
            type="submit"
            data-calculator-submit
          >
            Calculate
          </button>
          <button
            class="inline-flex items-center justify-center rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-3 text-sm font-medium text-[color:var(--fg)] shadow-sm transition hover:border-[color:var(--accent)] hover:bg-[color:var(--surface-strong)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]"
            type="button"
            data-calculator-reset
          >
            ↺ Reset
          </button>
        </div>
        <p class="text-xs text-[color:var(--muted)]">Updates automatically as you type</p>
      </div>
    </form>

    <aside class="flex flex-col justify-between border-t border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 xl:border-l xl:border-t-0">
      <div class="space-y-6">
        <div>
          <div class="flex items-center justify-between gap-2">
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[color:var(--accent)]">Result</p>
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--fg)] shadow-xs transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]"
              data-copy-result
              aria-label="Copy result to clipboard"
            >
              <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              <span data-copy-text>Copy</span>
            </button>
          </div>

          <div class="mt-3 rounded-[1.75rem] border border-[color:var(--border)] bg-[color:var(--bg)] p-6 shadow-inner">
            <p class="text-xs font-medium uppercase tracking-wider text-[color:var(--muted)]">Calculated Output</p>
            <output
              class="mt-2 block break-words text-3xl font-bold tracking-tight text-[color:var(--fg)] sm:text-4xl"
              aria-live="polite"
              data-calculator-result
            >
              {initialResult}
            </output>
          </div>
        </div>

        <dl class="grid gap-3 rounded-[1.75rem] border border-[color:var(--border)] bg-[color:var(--bg)] p-5 text-sm text-[color:var(--muted)]">
          <div class="flex items-start justify-between gap-4">
            <dt class="font-medium text-[color:var(--fg)]">Category</dt>
            <dd class="rounded-full bg-[color:var(--surface)] px-2.5 py-0.5 text-xs font-semibold text-[color:var(--accent)] border border-[color:var(--border)]">
              {calculator.category}
            </dd>
          </div>
          <div class="flex items-start justify-between gap-4">
            <dt class="font-medium text-[color:var(--fg)]">Inputs</dt>
            <dd class="font-medium text-[color:var(--fg)]">{calculator.inputs.length} parameters</dd>
          </div>
        </dl>
      </div>

      <div class="mt-6 rounded-2xl border border-dashed border-[color:var(--border)] p-4 text-xs text-[color:var(--muted)]">
        <strong>Tip:</strong> You can bookmark or share this tool. All calculations run securely inside your browser.
      </div>
    </aside>
  </div>

  <script>
    import { initCalculatorEngines } from '../scripts/calculator-engine';

    initCalculatorEngines();
  </script>
</section>
