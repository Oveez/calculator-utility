---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = 'w-10 h-10', size = 40 } = Astro.props as Props;
import { withBasePath } from '../utils/site';
---

<img
  src={withBasePath('/logo.png')}
  alt="ToolsCastle"
  class={`${className} object-contain`}
  width={size}
  height={size}
  loading="eager"
  decoding="async"
/>

