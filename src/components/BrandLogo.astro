---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = 'w-9 h-9', size = 36 } = Astro.props as Props;
---

<svg xmlns="http://www.w3.org/2000/svg" class={className} width={size} height={size} viewBox="0 0 512 512" fill="none" aria-hidden="true">
  <defs>
    <!-- Background Gradient: Deep rich tech blue to vibrant royal blue -->
    <linearGradient id="bl-cu-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="50%" stop-color="#2563EB"/>
      <stop offset="100%" stop-color="#1D4ED8"/>
    </linearGradient>

    <!-- Screen Display Gradient: Soft frosted luminescent ice-blue -->
    <linearGradient id="bl-cu-screen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#DBEAFE"/>
    </linearGradient>

    <!-- Primary Equals Button Gradient -->
    <linearGradient id="bl-cu-action" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>
  </defs>

  <!-- Main Squircle Body: Full bleed with smooth rounded corners and pure transparent outer corners -->
  <rect width="512" height="512" rx="116" fill="url(#bl-cu-bg)"/>

  <!-- Screen Readout Section -->
  <g>
    <rect x="56" y="56" width="400" height="124" rx="32" fill="url(#bl-cu-screen)"/>
    <circle cx="102" cy="118" r="12" fill="#2563EB"/>
    <rect x="134" y="112" width="40" height="12" rx="6" fill="#93C5FD"/>
    <rect x="296" y="102" width="132" height="32" rx="10" fill="#1D4ED8"/>
  </g>

  <!-- Keypad Row 1 -->
  <!-- Top Left Key: (+) -->
  <rect x="56" y="214" width="184" height="118" rx="30" fill="#FFFFFF" fill-opacity="0.22"/>
  <path d="M148 251V295M126 273H170" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round"/>

  <!-- Top Right Key: (−) -->
  <rect x="272" y="214" width="184" height="118" rx="30" fill="#FFFFFF" fill-opacity="0.22"/>
  <path d="M342 273H386" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round"/>

  <!-- Keypad Row 2 -->
  <!-- Bottom Left Key: (×) -->
  <rect x="56" y="358" width="184" height="118" rx="30" fill="#FFFFFF" fill-opacity="0.22"/>
  <path d="M132 401L164 433M164 401L132 433" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round"/>

  <!-- Bottom Right Key: (= Execution / Solution Key) -->
  <rect x="272" y="358" width="184" height="118" rx="30" fill="url(#bl-cu-action)"/>
  <path d="M340 405H388M340 429H388" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round"/>
</svg>
