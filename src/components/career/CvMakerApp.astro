    references: 'Available upon request',
  };

  function initCvMaker() {
    const root = document.getElementById('cv-maker-root');
    if (!root) return;

    const defaultTemplateAttr = (root.getAttribute('data-default-template') || 'professional') as CvState['template'];

    let state: CvState = loadSavedState() || {
      template: defaultTemplateAttr,
      name: '',
      title: '',
      email: '',
      phone: '',
      location: '',
      linkedin: '',
      website: '',
      summary: '',
      education: [
        { id: 'edu-0', degree: '', institution: '', location: '', startYear: '', endYear: '', gpa: '' }
      ],
      experience: [
        { id: 'exp-0', title: '', company: '', location: '', startDate: '', endDate: '', bullets: '' }
      ],
      skills: [],
      projects: [],
      certifications: [],
      languages: [],
      awards: [],
      volunteer: [],
      interests: '',
      references: 'Available upon request',
    };

    if (defaultTemplateAttr && !localStorage.getItem(STORAGE_KEY)) {
      state.template = defaultTemplateAttr;
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {}
    }

    function loadSavedState(): CvState | null {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        return saved ? JSON.parse(saved) : null;
      } catch (e) {
        return null;
      }
    }

    // DOM Elements
    const inpName = document.getElementById('inp-name') as HTMLInputElement;
    const inpTitle = document.getElementById('inp-title') as HTMLInputElement;
    const inpEmail = document.getElementById('inp-email') as HTMLInputElement;
    const inpPhone = document.getElementById('inp-phone') as HTMLInputElement;
    const inpLocation = document.getElementById('inp-location') as HTMLInputElement;
    const inpLinkedin = document.getElementById('inp-linkedin') as HTMLInputElement;
    const inpWebsite = document.getElementById('inp-website') as HTMLInputElement;
    const inpSummary = document.getElementById('inp-summary') as HTMLTextAreaElement;
    const inpInterests = document.getElementById('inp-interests') as HTMLInputElement;
    const inpReferences = document.getElementById('inp-references') as HTMLInputElement;
    const cvPreviewDoc = document.getElementById('cv-preview-doc') as HTMLElement;
    const previewTemplateLabel = document.getElementById('preview-template-label') as HTMLElement;

    // Containers
    const eduContainer = document.getElementById('edu-container') as HTMLElement;
    const expContainer = document.getElementById('exp-container') as HTMLElement;
    const skillsBadgeContainer = document.getElementById('skills-badge-container') as HTMLElement;
    const projContainer = document.getElementById('proj-container') as HTMLElement;
    const certContainer = document.getElementById('cert-container') as HTMLElement;
    const langContainer = document.getElementById('lang-container') as HTMLElement;
    const awardContainer = document.getElementById('award-container') as HTMLElement;
    const volContainer = document.getElementById('vol-container') as HTMLElement;

    function syncFormInputs() {
      if (inpName) inpName.value = state.name || '';
      if (inpTitle) inpTitle.value = state.title || '';
      if (inpEmail) inpEmail.value = state.email || '';
      if (inpPhone) inpPhone.value = state.phone || '';
      if (inpLocation) inpLocation.value = state.location || '';
      if (inpLinkedin) inpLinkedin.value = state.linkedin || '';
      if (inpWebsite) inpWebsite.value = state.website || '';
      if (inpSummary) inpSummary.value = state.summary || '';
      if (inpInterests) inpInterests.value = state.interests || '';
      if (inpReferences) inpReferences.value = state.references || '';

      document.querySelectorAll('.cv-template-btn').forEach((btn) => {
        const t = btn.getAttribute('data-template-btn');
        if (t === state.template) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      if (previewTemplateLabel) {
        if (state.template === 'professional') previewTemplateLabel.textContent = 'Professional (Harvard Standard)';
        else if (state.template === 'modern') previewTemplateLabel.textContent = 'Modern (Tech & Consulting)';
        else previewTemplateLabel.textContent = 'Student & Fresher (Academic)';
      }

      renderEducationRows();
      renderExperienceRows();
      renderSkillBadges();
      renderProjectRows();
      renderCertRows();
      renderLangRows();
      renderAwardRows();
      renderVolRows();
      renderLivePreview();
    }

    // Dynamic Row Renderers
    function renderEducationRows() {
      if (!eduContainer) return;
      eduContainer.innerHTML = '';
      state.education.forEach((edu, idx) => {
        const el = document.createElement('div');
        el.className = 'rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-3 relative shadow-sm';
        el.innerHTML = `
          <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-2">
            <span class="text-xs font-bold text-[color:var(--fg)]">Degree / Program #${idx + 1}</span>
            ${state.education.length > 1 ? `<button type="button" data-del-edu="${edu.id}" class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline">Remove</button>` : ''}
          </div>
          <div class="space-y-2.5">
            <div>
              <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Degree Title</label>
              <input type="text" data-edu-field="degree" data-id="${edu.id}" placeholder="e.g. Bachelor of Science in Computer Science" value="${escapeHtml(edu.degree)}" class="cv-input text-xs" />
            </div>
            <div class="grid gap-2.5 sm:grid-cols-2">
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">University / Institution</label>
                <input type="text" data-edu-field="institution" data-id="${edu.id}" placeholder="e.g. UC Berkeley" value="${escapeHtml(edu.institution)}" class="cv-input text-xs" />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Location (City, State)</label>
                <input type="text" data-edu-field="location" data-id="${edu.id}" placeholder="e.g. Berkeley, CA" value="${escapeHtml(edu.location)}" class="cv-input text-xs" />
              </div>
            </div>
            <div class="grid gap-2.5 sm:grid-cols-3">
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Start Year</label>
                <input type="text" data-edu-field="startYear" data-id="${edu.id}" placeholder="2016" value="${escapeHtml(edu.startYear)}" class="cv-input text-xs" />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Graduation Year</label>
                <input type="text" data-edu-field="endYear" data-id="${edu.id}" placeholder="2020" value="${escapeHtml(edu.endYear)}" class="cv-input text-xs" />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">GPA / Honors (Optional)</label>
                <input type="text" data-edu-field="gpa" data-id="${edu.id}" placeholder="e.g. 3.85 / 4.0" value="${escapeHtml(edu.gpa)}" class="cv-input text-xs" />
              </div>
            </div>
          </div>
        `;
        eduContainer.appendChild(el);
      });
    }

    function renderExperienceRows() {
      if (!expContainer) return;
      expContainer.innerHTML = '';
      state.experience.forEach((exp, idx) => {
        const el = document.createElement('div');
        el.className = 'rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-3 relative shadow-sm';
        el.innerHTML = `
          <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-2">
            <span class="text-xs font-bold text-[color:var(--fg)]">Position #${idx + 1}</span>
            ${state.experience.length > 1 ? `<button type="button" data-del-exp="${exp.id}" class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline">Remove</button>` : ''}
          </div>
          <div class="space-y-2.5">
            <div class="grid gap-2.5 sm:grid-cols-2">
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Job Title</label>
                <input type="text" data-exp-field="title" data-id="${exp.id}" placeholder="e.g. Senior Software Engineer" value="${escapeHtml(exp.title)}" class="cv-input text-xs" />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Company Name</label>
                <input type="text" data-exp-field="company" data-id="${exp.id}" placeholder="e.g. CloudScale Technologies" value="${escapeHtml(exp.company)}" class="cv-input text-xs" />
              </div>
            </div>
            <div class="grid gap-2.5 sm:grid-cols-3">
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Location</label>
                <input type="text" data-exp-field="location" data-id="${exp.id}" placeholder="e.g. San Francisco, CA" value="${escapeHtml(exp.location)}" class="cv-input text-xs" />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Start Date</label>
                <input type="text" data-exp-field="startDate" data-id="${exp.id}" placeholder="e.g. 2022" value="${escapeHtml(exp.startDate)}" class="cv-input text-xs" />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">End Date</label>
                <input type="text" data-exp-field="endDate" data-id="${exp.id}" placeholder="e.g. Present" value="${escapeHtml(exp.endDate)}" class="cv-input text-xs" />
              </div>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-[color:var(--fg)] mb-1">Responsibilities &amp; Achievements (Enter each bullet point on a new line)</label>
              <textarea rows="4" data-exp-field="bullets" data-id="${exp.id}" placeholder="• Spearheaded architectural migration reducing load times by 48%.\n• Engineered real-time data streaming pipeline with 99.99% uptime.\n• Mentored 5 junior engineers through code reviews." class="cv-input text-xs leading-relaxed font-sans">${escapeHtml(exp.bullets)}</textarea>
            </div>
          </div>
        `;
        expContainer.appendChild(el);
      });
    }

    function renderSkillBadges() {
      if (!skillsBadgeContainer) return;
      skillsBadgeContainer.innerHTML = '';
      if (state.skills.length === 0) {
        skillsBadgeContainer.innerHTML = '<span class="text-xs text-[color:var(--muted)] italic p-1">No skills added. Type above to add skills.</span>';
        return;
      }
      state.skills.forEach((skill, idx) => {
        const badge = document.createElement('span');
        badge.className = 'inline-flex items-center gap-1.5 rounded-lg bg-[color:var(--surface)] px-2.5 py-1 text-xs font-semibold text-[color:var(--fg)] border border-[color:var(--border)] shadow-xs';
        badge.innerHTML = `
          <span>${escapeHtml(skill)}</span>
          <button type="button" data-del-skill="${idx}" class="text-[color:var(--muted)] hover:text-rose-500 font-bold ml-0.5">×</button>
        `;
        skillsBadgeContainer.appendChild(badge);
      });
    }

    function renderProjectRows() {
      if (!projContainer) return;
      projContainer.innerHTML = '';
      state.projects.forEach((proj, idx) => {
        const el = document.createElement('div');
        el.className = 'rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2.5 shadow-sm';
        el.innerHTML = `
          <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-2">
            <span class="text-xs font-bold text-[color:var(--fg)]">Project #${idx + 1}</span>
            <button type="button" data-del-proj="${proj.id}" class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline">Remove</button>
          </div>
          <div class="grid gap-2 sm:grid-cols-2">
            <input type="text" data-proj-field="name" data-id="${proj.id}" placeholder="Project Title (e.g. OmniCalc Engine)" value="${escapeHtml(proj.name)}" class="cv-input text-xs" />
            <input type="text" data-proj-field="linkOrRole" data-id="${proj.id}" placeholder="Role / Link (e.g. github.com/alex/omnicalc)" value="${escapeHtml(proj.linkOrRole)}" class="cv-input text-xs" />
          </div>
          <textarea rows="2" data-proj-field="description" data-id="${proj.id}" placeholder="Key problem solved, architectural methodology, and measurable outcome..." class="cv-input text-xs leading-relaxed">${escapeHtml(proj.description)}</textarea>
          <input type="text" data-proj-field="tech" data-id="${proj.id}" placeholder="Technologies used (e.g. TypeScript, React, Docker, AWS)" value="${escapeHtml(proj.tech)}" class="cv-input text-xs" />
        `;
        projContainer.appendChild(el);
      });
    }

    function renderCertRows() {
      if (!certContainer) return;
      certContainer.innerHTML = '';
      state.certifications.forEach((cert) => {
        const el = document.createElement('div');
        el.className = 'flex items-center gap-2';
        el.innerHTML = `
          <input type="text" data-cert-field="name" data-id="${cert.id}" placeholder="Certificate Name" value="${escapeHtml(cert.name)}" class="cv-input text-xs flex-1" />
          <input type="text" data-cert-field="issuer" data-id="${cert.id}" placeholder="Issuer (e.g. AWS)" value="${escapeHtml(cert.issuer)}" class="cv-input text-xs w-1/3" />
          <input type="text" data-cert-field="year" data-id="${cert.id}" placeholder="Year" value="${escapeHtml(cert.year)}" class="cv-input text-xs w-20" />
          <button type="button" data-del-cert="${cert.id}" class="text-rose-500 font-bold px-2 text-sm">×</button>
        `;
        certContainer.appendChild(el);
      });
    }

    function renderLangRows() {
      if (!langContainer) return;
      langContainer.innerHTML = '';
      state.languages.forEach((lang) => {
        const el = document.createElement('div');
        el.className = 'flex items-center gap-2';
        el.innerHTML = `
          <input type="text" data-lang-field="name" data-id="${lang.id}" placeholder="Language (e.g. English)" value="${escapeHtml(lang.name)}" class="cv-input text-xs flex-1" />
          <input type="text" data-lang-field="level" data-id="${lang.id}" placeholder="Proficiency (e.g. Native, Fluent)" value="${escapeHtml(lang.level)}" class="cv-input text-xs w-1/2" />
          <button type="button" data-del-lang="${lang.id}" class="text-rose-500 font-bold px-2 text-sm">×</button>
        `;
        langContainer.appendChild(el);
      });
    }

    function renderAwardRows() {
      if (!awardContainer) return;
      awardContainer.innerHTML = '';
      state.awards.forEach((award) => {
        const el = document.createElement('div');
        el.className = 'flex items-center gap-2';
        el.innerHTML = `
          <input type="text" data-award-field="title" data-id="${award.id}" placeholder="Award Title" value="${escapeHtml(award.title)}" class="cv-input text-xs flex-1" />
          <input type="text" data-award-field="issuer" data-id="${award.id}" placeholder="Issuer" value="${escapeHtml(award.issuer)}" class="cv-input text-xs w-1/3" />
          <input type="text" data-award-field="year" data-id="${award.id}" placeholder="Year" value="${escapeHtml(award.year)}" class="cv-input text-xs w-20" />
          <button type="button" data-del-award="${award.id}" class="text-rose-500 font-bold px-2 text-sm">×</button>
        `;
        awardContainer.appendChild(el);
      });
    }

    function renderVolRows() {
      if (!volContainer) return;
      volContainer.innerHTML = '';
      state.volunteer.forEach((vol) => {
        const el = document.createElement('div');
        el.className = 'space-y-1.5 rounded-xl border border-[color:var(--border)] p-3 bg-[color:var(--surface)]';
        el.innerHTML = `
          <div class="flex items-center justify-between gap-2">
            <input type="text" data-vol-field="role" data-id="${vol.id}" placeholder="Role / Title" value="${escapeHtml(vol.role)}" class="cv-input text-xs flex-1" />
            <input type="text" data-vol-field="organization" data-id="${vol.id}" placeholder="Organization" value="${escapeHtml(vol.organization)}" class="cv-input text-xs w-1/3" />
            <button type="button" data-del-vol="${vol.id}" class="text-rose-500 font-bold px-2 text-sm">×</button>
          </div>
          <input type="text" data-vol-field="details" data-id="${vol.id}" placeholder="Contributions..." value="${escapeHtml(vol.details)}" class="cv-input text-xs w-full" />
        `;
        volContainer.appendChild(el);
      });
    }

    // Helper: Convert raw textarea lines to semantic <ul><li>
    function parseBulletPoints(text: string): string {
      if (!text || !text.trim()) return '';
      const lines = text
        .split('\n')
        .map((l) => l.trim().replace(/^[•\-\*]\s*/, ''))
        .filter(Boolean);
      if (lines.length === 0) return '';
      return `<ul>${lines.map((l) => `<li>${escapeHtml(l)}</li>`).join('')}</ul>`;
    }

    // MAIN REACTIVE PREVIEW RENDERER
    function renderLivePreview() {
      if (!cvPreviewDoc) return;

      cvPreviewDoc.className = `cv-sheet-paper mx-auto bg-white text-slate-900 shadow-2xl transition-all duration-150 template-${state.template}`;

      const name = state.name.trim() || 'YOUR NAME';
      const title = state.title.trim();
      const email = state.email.trim();
      const phone = state.phone.trim();
      const location = state.location.trim();
      const linkedin = state.linkedin.trim();
      const website = state.website.trim();
      const summary = state.summary.trim();

      // Clean typographic contact bar without unprofessional emojis
      const contactItems = [
        email ? escapeHtml(email) : '',
        phone ? escapeHtml(phone) : '',
        location ? escapeHtml(location) : '',
        linkedin ? escapeHtml(linkedin) : '',
        website ? escapeHtml(website) : '',
      ].filter(Boolean);

      const contactLineHtml = contactItems.length > 0 ? `<div class="cv-contact-line">${contactItems.join(' &nbsp;|&nbsp; ')}</div>` : '';

      // Header Block
      const headerHtml = `
        <div class="cv-header">
          <div class="cv-name">${escapeHtml(name)}</div>
          ${title ? `<div class="cv-title">${escapeHtml(title)}</div>` : ''}
          ${contactLineHtml}
        </div>
      `;

      // Summary Block
      let summaryHtml = '';
      if (summary) {
        summaryHtml = `
          <div class="cv-section-block">
            <div class="cv-section-title">Professional Summary</div>
            <p style="font-size: 9pt; color: #1f2937; line-height: 1.4;">${escapeHtml(summary)}</p>
          </div>
        `;
      }

      // Education Block
      const validEdu = state.education.filter((e) => e.degree.trim() || e.institution.trim());
      let eduHtml = '';
      if (validEdu.length > 0) {
        eduHtml = `
          <div class="cv-section-block">
            <div class="cv-section-title">Education</div>
            <div style="display: flex; flex-direction: column; gap: 6pt;">
              ${validEdu.map((edu) => {
                const dates = [edu.startYear, edu.endYear].filter(Boolean).join(' – ');
                const locationOrGpa = [edu.location, edu.gpa ? `GPA: ${edu.gpa}` : ''].filter(Boolean).join(' | ');
                return `
                  <div class="cv-item-node" style="break-inside: avoid;">
                    <div class="cv-entry-row">
                      <span class="cv-bold-title">${escapeHtml(edu.institution || 'University')}</span>
                      <span class="cv-date-location">${escapeHtml(dates)}</span>
                    </div>
                    <div class="cv-entry-row">
                      <span class="cv-sub-title">${escapeHtml(edu.degree || 'Degree')}</span>
                      ${locationOrGpa ? `<span style="font-size: 8.5pt; color: #374151;">${escapeHtml(locationOrGpa)}</span>` : ''}
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }

      // Experience Block
      const validExp = state.experience.filter((e) => e.title.trim() || e.company.trim());
      let expHtml = '';
      if (validExp.length > 0) {
        expHtml = `
          <div class="cv-section-block">
            <div class="cv-section-title">Work Experience</div>
            <div style="display: flex; flex-direction: column; gap: 7pt;">
              ${validExp.map((exp) => {
                const dates = [exp.startDate, exp.endDate].filter(Boolean).join(' – ');
                return `
                  <div class="cv-item-node" style="break-inside: avoid;">
                    <div class="cv-entry-row">
                      <span class="cv-bold-title">${escapeHtml(exp.company || 'Company')}</span>
                      <span class="cv-date-location">${escapeHtml(exp.location || '')}</span>
                    </div>
                    <div class="cv-entry-row" style="margin-bottom: 2pt;">
                      <span class="cv-sub-title">${escapeHtml(exp.title || 'Role')}</span>
                      <span class="cv-date-location" style="font-weight: normal; font-style: italic;">${escapeHtml(dates)}</span>
                    </div>
                    ${parseBulletPoints(exp.bullets)}
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }

      // Skills Block
      let skillsHtml = '';
      if (state.skills.length > 0) {
        if (state.template === 'modern') {
          skillsHtml = `
            <div class="cv-section-block">
              <div class="cv-section-title">Technical &amp; Professional Skills</div>
              <div>
                ${state.skills.map((s) => `<span class="cv-skill-pill">${escapeHtml(s)}</span>`).join('')}
              </div>
            </div>
          `;
        } else {
          skillsHtml = `
            <div class="cv-section-block">
              <div class="cv-section-title">Technical &amp; Core Skills</div>
              <p style="font-size: 9pt; color: #1f2937; line-height: 1.45;">
                ${state.skills.map((s) => `<strong>${escapeHtml(s)}</strong>`).join(' &nbsp;•&nbsp; ')}
              </p>
            </div>
          `;
        }
      }

      // Projects Block
      const validProj = state.projects.filter((p) => p.name.trim());
      let projHtml = '';
      if (validProj.length > 0) {
        projHtml = `
          <div class="cv-section-block">
            <div class="cv-section-title">Projects &amp; Technical Work</div>
            <div style="display: flex; flex-direction: column; gap: 6pt;">
              ${validProj.map((p) => `
                <div class="cv-item-node" style="break-inside: avoid;">
                  <div class="cv-entry-row">
                    <span class="cv-bold-title">${escapeHtml(p.name)}</span>
                    ${p.linkOrRole ? `<span class="cv-date-location" style="font-weight: 500;">${escapeHtml(p.linkOrRole)}</span>` : ''}
                  </div>
                  ${p.description ? `<p style="font-size: 9pt; color: #1f2937; margin-top: 1pt;">${escapeHtml(p.description)}</p>` : ''}
                  ${p.tech ? `<p style="font-size: 8.5pt; color: #4b5563; margin-top: 1pt;"><em>Technologies:</em> ${escapeHtml(p.tech)}</p>` : ''}
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }

      // Certifications & Languages
      const validCerts = state.certifications.filter((c) => c.name.trim());
      const validLangs = state.languages.filter((l) => l.name.trim());
      let certsAndLangsHtml = '';
      if (validCerts.length > 0 || validLangs.length > 0) {
        certsAndLangsHtml = `
          <div style="display: grid; grid-template-columns: ${validCerts.length > 0 && validLangs.length > 0 ? '1fr 1fr' : '1fr'}; gap: 12pt; margin-top: 2pt;">
            ${validCerts.length > 0 ? `
              <div class="cv-section-block">
                <div class="cv-section-title">Certifications</div>
                <ul>
                  ${validCerts.map((c) => `<li><strong>${escapeHtml(c.name)}</strong>${c.issuer ? ` – ${escapeHtml(c.issuer)}` : ''}${c.year ? ` (${escapeHtml(c.year)})` : ''}</li>`).join('')}
                </ul>
              </div>
            ` : ''}
            ${validLangs.length > 0 ? `
              <div class="cv-section-block">
                <div class="cv-section-title">Languages</div>
                <ul>
                  ${validLangs.map((l) => `<li><strong>${escapeHtml(l.name)}</strong>${l.level ? `: ${escapeHtml(l.level)}` : ''}</li>`).join('')}
                </ul>
              </div>
            ` : ''}
          </div>
        `;
      }

      // Awards & Volunteer
      const validAwards = state.awards.filter((a) => a.title.trim());
      const validVol = state.volunteer.filter((v) => v.role.trim() || v.organization.trim());
      let extrasHtml = '';
      if (validAwards.length > 0 || validVol.length > 0) {
        extrasHtml = `
          <div style="display: grid; grid-template-columns: ${validAwards.length > 0 && validVol.length > 0 ? '1fr 1fr' : '1fr'}; gap: 12pt; margin-top: 2pt;">
            ${validAwards.length > 0 ? `
              <div class="cv-section-block">
                <div class="cv-section-title">Honors &amp; Awards</div>
                <ul>
                  ${validAwards.map((a) => `<li><strong>${escapeHtml(a.title)}</strong>${a.issuer ? ` (${escapeHtml(a.issuer)})` : ''}${a.year ? ` – ${escapeHtml(a.year)}` : ''}</li>`).join('')}
                </ul>
              </div>
            ` : ''}
            ${validVol.length > 0 ? `
              <div class="cv-section-block">
                <div class="cv-section-title">Leadership &amp; Volunteer</div>
                <ul>
                  ${validVol.map((v) => `<li><strong>${escapeHtml(v.role)}</strong>${v.organization ? ` – ${escapeHtml(v.organization)}` : ''}${v.details ? `: ${escapeHtml(v.details)}` : ''}</li>`).join('')}
                </ul>
              </div>
            ` : ''}
          </div>
        `;
      }

      // Footer
      let footerHtml = '';
      if (state.interests.trim() || state.references.trim()) {
        footerHtml = `
          <div style="margin-top: 8pt; font-size: 8.5pt; color: #374151; border-top: 1px solid #e5e7eb; padding-top: 4pt;">
            ${state.interests.trim() ? `<div><strong>Activities &amp; Interests:</strong> ${escapeHtml(state.interests.trim())}</div>` : ''}
            ${state.references.trim() ? `<div><strong>References:</strong> ${escapeHtml(state.references.trim())}</div>` : ''}
          </div>
        `;
      }

      // Assemble Template Order
      if (state.template === 'student') {
        // Education & Projects First
        cvPreviewDoc.innerHTML = `
          ${headerHtml}
          ${summaryHtml}
          ${eduHtml}
          ${skillsHtml}
          ${projHtml}
          ${expHtml}
          ${certsAndLangsHtml}
          ${extrasHtml}
          ${footerHtml}
        `;
      } else {
        // Professional / Modern
        cvPreviewDoc.innerHTML = `
          ${headerHtml}
          ${summaryHtml}
          ${expHtml}
          ${skillsHtml}
          ${eduHtml}
          ${projHtml}
          ${certsAndLangsHtml}
          ${extrasHtml}
          ${footerHtml}
        `;
      }
    }

    function escapeHtml(str: string): string {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Input bindings
    const bindInput = (el: HTMLInputElement | HTMLTextAreaElement | null, key: keyof CvState) => {
      if (!el) return;
      el.addEventListener('input', () => {
        (state as any)[key] = el.value;
        saveState();
        renderLivePreview();
      });
    };

    bindInput(inpName, 'name');
    bindInput(inpTitle, 'title');
    bindInput(inpEmail, 'email');
    bindInput(inpPhone, 'phone');
    bindInput(inpLocation, 'location');
    bindInput(inpLinkedin, 'linkedin');
    bindInput(inpWebsite, 'website');
    bindInput(inpSummary, 'summary');
    bindInput(inpInterests, 'interests');
    bindInput(inpReferences, 'references');

    // =========================================================================
    // AI SUMMARY GENERATION HANDLER (ZERO EXPOSED SECRETS, RATE LIMITED)
    // =========================================================================
    const btnAiSummary = document.getElementById('btn-ai-summary') as HTMLButtonElement | null;
    const aiSummaryBtnText = document.getElementById('ai-summary-btn-text');
    const aiProposalCard = document.getElementById('ai-summary-proposal-card');
    const aiSummaryText = document.getElementById('ai-summary-text');
    const aiProviderBadge = document.getElementById('ai-provider-badge');
    const aiSummaryStatus = document.getElementById('ai-summary-status');
    const btnAiApply = document.getElementById('btn-ai-apply');
    const btnAiDismiss = document.getElementById('btn-ai-dismiss');

    let pendingAiSummary = '';

    const showAiStatus = (msg: string, isError = false) => {
      if (!aiSummaryStatus) return;
      aiSummaryStatus.textContent = msg;
      aiSummaryStatus.className = isError
        ? 'block text-xs rounded-xl p-3 border border-rose-500/20 bg-rose-500/5 text-rose-600 dark:text-rose-400'
        : 'block text-xs rounded-xl p-3 border border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--muted)]';
    };

    const hideAiStatus = () => {
      if (aiSummaryStatus) aiSummaryStatus.className = 'hidden';
    };

    btnAiSummary?.addEventListener('click', async () => {
      hideAiStatus();
      if (aiProposalCard) aiProposalCard.classList.add('hidden');

      // Check if candidate entered any career facts
      const hasFacts =
        state.title.trim().length > 0 ||
        state.skills.length > 0 ||
        state.experience.some((e) => e.title || e.company || e.bullets) ||
        state.education.some((ed) => ed.degree || ed.institution);

      if (!hasFacts) {
        showAiStatus(
          'Please enter your job title, education, skills, or work experience first so AI has factual information to write your summary.',
          true
        );
        return;
      }

      if (btnAiSummary) btnAiSummary.disabled = true;
      if (aiSummaryBtnText) aiSummaryBtnText.textContent = 'Generating with AI...';

      try {
        const payload = {
          title: state.title,
          skills: state.skills,
          education: state.education.map((e) => ({
            degree: e.degree,
            field: '',
            school: e.institution,
            year: e.endYear || e.startYear,
          })),
          experience: state.experience.map((e) => ({
            role: e.title,
            company: e.company,
            duration: [e.startDate, e.endDate].filter(Boolean).join(' - '),
            description: e.bullets,
          })),
          projects: state.projects.map((p) => ({
            title: p.name,
            tech: p.tech,
            description: p.description,
          })),
          existingSummary: state.summary,
        };

        const result = await generateProfessionalSummary(payload);

        if (result.success && result.summary) {
          pendingAiSummary = result.summary;
          if (aiSummaryText) aiSummaryText.textContent = result.summary;
          if (aiProviderBadge) aiProviderBadge.textContent = result.provider ? `(${result.provider})` : '';
          if (aiProposalCard) aiProposalCard.classList.remove('hidden');
        } else {
          showAiStatus(
            result.error || 'AI assistance is temporarily unavailable. You can continue writing your summary manually.',
            true
          );
        }
      } catch (err) {
        showAiStatus(
          'AI assistance is temporarily unavailable. You can continue writing your summary manually.',
          true
        );
      } finally {
        if (btnAiSummary) btnAiSummary.disabled = false;
        if (aiSummaryBtnText) aiSummaryBtnText.textContent = 'Improve with AI';
      }
    });

    btnAiApply?.addEventListener('click', () => {
      if (pendingAiSummary && inpSummary) {
        inpSummary.value = pendingAiSummary;
        state.summary = pendingAiSummary;
        saveState();
        renderLivePreview();
        if (aiProposalCard) aiProposalCard.classList.add('hidden');
        showAiStatus('AI Summary successfully applied to your CV!');
        setTimeout(hideAiStatus, 3000);
      }
    });

    btnAiDismiss?.addEventListener('click', () => {
      if (aiProposalCard) aiProposalCard.classList.add('hidden');
      hideAiStatus();
    });

    // Tab Navigation
    const tabButtons = document.querySelectorAll('.cv-tab-btn');
    const tabContents = document.querySelectorAll('.cv-tab-content');
    let currentTabIndex = 0;

    tabButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target');
        if (!targetId) return;
        currentTabIndex = idx;
        tabButtons.forEach((b) => b.classList.remove('active'));
        tabContents.forEach((c) => c.classList.add('hidden'));
        btn.classList.add('active');
        document.getElementById(targetId)?.classList.remove('hidden');
      });
    });

    document.getElementById('btn-prev-tab')?.addEventListener('click', () => {
      if (currentTabIndex > 0) (tabButtons[currentTabIndex - 1] as HTMLElement).click();
    });

    document.getElementById('btn-next-tab')?.addEventListener('click', () => {
      if (currentTabIndex < tabButtons.length - 1) (tabButtons[currentTabIndex + 1] as HTMLElement).click();
    });

    // Template Selector
    document.querySelectorAll('.cv-template-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.getAttribute('data-template-btn') as CvState['template'];
        if (t) {
          state.template = t;
          saveState();
          syncFormInputs();
        }
      });
    });

    // Dynamic Row Event Handlers
    // Education
    document.getElementById('btn-add-edu')?.addEventListener('click', () => {
      state.education.push({ id: `edu-${Date.now()}`, degree: '', institution: '', location: '', startYear: '', endYear: '', gpa: '' });
      saveState();
      renderEducationRows();
      renderLivePreview();
    });

    eduContainer?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const id = target.getAttribute('data-id');
      const field = target.getAttribute('data-edu-field') as keyof EducationItem;
      if (id && field) {
        const item = state.education.find((x) => x.id === id);
        if (item) { item[field] = target.value; saveState(); renderLivePreview(); }
      }
    });

