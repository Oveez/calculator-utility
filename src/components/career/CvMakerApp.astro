    // Helper: Ensure html2pdf is loaded with multiple fallbacks
    function loadHtml2PdfEngine(): Promise<any> {
      if ((window as any).html2pdf) {
        return Promise.resolve((window as any).html2pdf);
      }

      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = '/js/html2pdf.bundle.min.js';
        script.onload = () => {
          if ((window as any).html2pdf) resolve((window as any).html2pdf);
          else reject(new Error('html2pdf global not defined'));
        };
        script.onerror = () => {
          // CDN Fallback
          const cdnScript = document.createElement('script');
          cdnScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
          cdnScript.onload = () => {
            if ((window as any).html2pdf) resolve((window as any).html2pdf);
            else reject(new Error('html2pdf global not defined from CDN'));
          };
          cdnScript.onerror = () => reject(new Error('Could not load html2pdf from CDN'));
          document.head.appendChild(cdnScript);
        };
        document.head.appendChild(script);
      });
    }

    // =========================================================================
    // DIRECT CLIENT-SIDE PDF DOWNLOAD (NO PRINT DIALOG, NO DATE/URL HEADERS)
    // =========================================================================
    async function downloadPdfDirect() {
      if (!state.name.trim()) {
        alert('Please enter at least your Full Name before downloading your CV PDF.');
        (tabButtons[0] as HTMLElement)?.click();
        inpName?.focus();
        return;
      }

      const cvElement = document.getElementById('cv-preview-doc');
      if (!cvElement) return;

      const btn = document.getElementById('cv-download-pdf') as HTMLButtonElement;
      const btnLabel = document.getElementById('cv-btn-label');
      const btnIcon = document.getElementById('cv-btn-icon');

      if (btn) btn.disabled = true;
      if (btnLabel) btnLabel.textContent = 'Generating PDF...';
      if (btnIcon) btnIcon.style.opacity = '0.5';

      try {
        const html2pdf = await loadHtml2PdfEngine();
        const safeFileName = (state.name.trim() || 'Resume').replace(/[^a-zA-Z0-9_-]/g, '_');

        // Create an isolated container for crisp vector/canvas conversion with strictly bounded dimensions
        const clone = cvElement.cloneNode(true) as HTMLElement;
        clone.style.boxSizing = 'border-box';
        clone.style.boxShadow = 'none';
        clone.style.margin = '0';
        clone.style.width = '210mm';
        clone.style.maxWidth = '210mm';
        clone.style.minWidth = '210mm';
        clone.style.height = 'auto';
        clone.style.minHeight = 'auto';
        clone.style.maxHeight = 'none';
        clone.style.padding = '12mm 14mm';
        clone.style.background = '#ffffff';
        clone.style.transform = 'none';

        // Ensure all nested children obey border-box sizing
        const nestedNodes = clone.querySelectorAll<HTMLElement>('*');
        nestedNodes.forEach((node) => {
          node.style.boxSizing = 'border-box';
        });

        // Ensure last child element has no trailing bottom margin that causes overflow
        const lastChild = clone.lastElementChild as HTMLElement;
        if (lastChild) {
          lastChild.style.marginBottom = '0';
          lastChild.style.paddingBottom = '0';
        }

        const wrapper = document.createElement('div');
        wrapper.style.position = 'fixed';
        wrapper.style.left = '-9999px';
        wrapper.style.top = '0';
        wrapper.style.zIndex = '-1000';
        wrapper.style.boxSizing = 'border-box';
        wrapper.appendChild(clone);
        document.body.appendChild(wrapper);

        const opt = {
          margin: 0,
          filename: `${safeFileName}_CV.pdf`,
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: {
            scale: 2,
            useCORS: true,
            letterRendering: true,
            backgroundColor: '#ffffff',
            scrollY: 0,
            scrollX: 0,
            logging: false,
          },
          jsPDF: {
            unit: 'mm',
            format: 'a4',
            orientation: 'portrait',
          },
          pagebreak: { mode: ['css', 'legacy'] },
        };

        const worker = html2pdf().set(opt).from(clone);
        await worker.toPdf();
        const pdf = worker.prop?.pdf;

        if (pdf) {
          const canvas = worker.prop?.canvas as HTMLCanvasElement;
          if (canvas) {
            const pxPageHeight = Math.floor(canvas.width * (297 / 210));
            let totalPages = typeof pdf.getNumberOfPages === 'function'
              ? pdf.getNumberOfPages()
              : (pdf.internal?.getNumberOfPages ? pdf.internal.getNumberOfPages() : 1);

            while (totalPages > 1) {
              const pageIndex = totalPages - 1;
              const startY = pageIndex * pxPageHeight;
              const sliceHeight = Math.min(canvas.height - startY, pxPageHeight);

              // If slice height is tiny sub-pixel remainder (<= 25px out of ~2244px), trim it
              if (sliceHeight <= 25) {
                pdf.deletePage(totalPages);
                totalPages--;
                continue;
              }

              // Check if slice is completely blank/white
              const tempCanvas = document.createElement('canvas');
              tempCanvas.width = canvas.width;
              tempCanvas.height = sliceHeight;
              const tempCtx = tempCanvas.getContext('2d');
              if (tempCtx) {
                tempCtx.fillStyle = '#ffffff';
                tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
                tempCtx.drawImage(canvas, 0, startY, canvas.width, sliceHeight, 0, 0, canvas.width, sliceHeight);

                const imgData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height).data;
                let isBlank = true;
                for (let i = 0; i < imgData.length; i += 16) {
                  const r = imgData[i];
                  const g = imgData[i + 1];
                  const b = imgData[i + 2];
                  const a = imgData[i + 3];
                  if (a > 20 && (r < 240 || g < 240 || b < 240)) {
                    isBlank = false;
                    break;
                  }
                }

                if (isBlank) {
                  pdf.deletePage(totalPages);
                  totalPages--;
                } else {
                  break;
                }
              } else {
                break;
              }
            }
          }

          pdf.save(`${safeFileName}_CV.pdf`);
        } else {
          await worker.save();
        }

        wrapper.remove();
      } catch (err) {
        console.error('Direct PDF export error:', err);
        // Fallback: Isolated printable window with zero headers/footers
        triggerCleanPrintFallback();
      } finally {
        if (btn) btn.disabled = false;
        if (btnLabel) btnLabel.textContent = 'Download PDF';
        if (btnIcon) btnIcon.style.opacity = '1';
      }
    }

    function triggerCleanPrintFallback() {
      const cvElement = document.getElementById('cv-preview-doc');
      if (!cvElement) return;

      const printWindow = window.open('', '_blank');
      if (!printWindow) {
        window.print();
        return;
      }

      const templateClass = cvElement.className;
      const innerHtml = cvElement.innerHTML;

      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
          <head>
            <meta charset="utf-8" />
            <title></title>
            <style>
              @page {
                size: A4 portrait;
                margin: 0;
              }
              body {
                margin: 0;
                padding: 12mm 14mm;
                background: #ffffff;
                color: #111827;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
              }
              .cv-sheet-paper {
                width: 100% !important;
                max-width: 100% !important;
                min-width: 100% !important;
                height: auto !important;
                min-height: auto !important;
                max-height: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                margin: 0 !important;
                page-break-after: avoid !important;
                break-after: avoid !important;
              }
            </style>
          </head>
          <body>
            <div class="${templateClass}">
              ${innerHtml}
            </div>
            <script>
              window.onload = function() {
                window.focus();
                window.print();
                setTimeout(function() { window.close(); }, 500);
              };
            <\/script>
          </body>
        </html>
      `);
      printWindow.document.close();
    }

    document.getElementById('cv-download-pdf')?.addEventListener('click', downloadPdfDirect);
    document.getElementById('cv-mobile-btn-download')?.addEventListener('click', downloadPdfDirect);

    // =========================================================================
    // MOBILE APP-STYLE VIEW TOGGLE & RESPONSIVE A4 DOCUMENT SCALING
    // =========================================================================
    const mobileTabEdit = document.getElementById('cv-mobile-tab-edit');
    const mobileTabPreview = document.getElementById('cv-mobile-tab-preview');
    const editorColumn = document.getElementById('cv-editor-column');
    const previewColumn = document.getElementById('cv-preview-column');
    const scaleWrapper = document.getElementById('cv-scale-wrapper');
    const zoomFitBtn = document.getElementById('cv-zoom-fit');
    const zoom100Btn = document.getElementById('cv-zoom-100');
    const zoomLabel = document.getElementById('cv-zoom-level-label');

    let currentScaleMode: 'fit' | '100' = 'fit';

    function updateDocumentScale() {
      if (!cvPreviewDoc || !scaleWrapper) return;
      const isMobile = window.innerWidth < 1024;
      const docNaturalWidth = 794;
      const docNaturalHeight = 1123;

      if (currentScaleMode === '100' && !isMobile) {
        cvPreviewDoc.style.transform = 'none';
        scaleWrapper.style.height = `${docNaturalHeight}px`;
        if (zoomLabel) zoomLabel.textContent = '100%';
        return;
      }

      // Calculate available inner container width
      const viewportEl = scaleWrapper.closest('.cv-preview-viewport') as HTMLElement | null;
      const containerWidth = viewportEl?.clientWidth || scaleWrapper.parentElement?.clientWidth || window.innerWidth;
      const horizontalPadding = isMobile ? 24 : 40;
      const availableWidth = Math.max(containerWidth - horizontalPadding, 240);
      const scale = Math.min(1, availableWidth / docNaturalWidth);

      cvPreviewDoc.style.transform = `scale(${scale.toFixed(3)})`;
      cvPreviewDoc.style.transformOrigin = 'top center';
      
      // Set exact container height to match scaled A4 without excess blank length
      const scaledHeight = Math.ceil(docNaturalHeight * scale);
      scaleWrapper.style.height = `${scaledHeight + 4}px`;
      
      if (zoomLabel) zoomLabel.textContent = `${Math.round(scale * 100)}%`;
    }

    function setMobileMode(mode: 'edit' | 'preview') {
      if (!editorColumn || !previewColumn) return;
      if (mode === 'edit') {
        editorColumn.classList.remove('hidden');
        previewColumn.classList.add('hidden');
        previewColumn.classList.remove('block');
        mobileTabEdit?.classList.add('bg-[color:var(--fg)]', 'text-[color:var(--bg)]');
        mobileTabEdit?.classList.remove('text-[color:var(--muted)]');
        mobileTabPreview?.classList.remove('bg-[color:var(--fg)]', 'text-[color:var(--bg)]');
        mobileTabPreview?.classList.add('text-[color:var(--muted)]');
      } else {
        editorColumn.classList.add('hidden');
        previewColumn.classList.remove('hidden');
        previewColumn.classList.add('block');
        mobileTabPreview?.classList.add('bg-[color:var(--fg)]', 'text-[color:var(--bg)]');
        mobileTabPreview?.classList.remove('text-[color:var(--muted)]');
        mobileTabEdit?.classList.remove('bg-[color:var(--fg)]', 'text-[color:var(--bg)]');
        mobileTabEdit?.classList.add('text-[color:var(--muted)]');
        // Render & scale immediately upon switching to preview
        renderLivePreview();
        setTimeout(updateDocumentScale, 50);
      }
    }

    mobileTabEdit?.addEventListener('click', () => setMobileMode('edit'));
    mobileTabPreview?.addEventListener('click', () => setMobileMode('preview'));

    zoomFitBtn?.addEventListener('click', () => {
      currentScaleMode = 'fit';
      zoomFitBtn.classList.add('font-bold', 'text-[color:var(--fg)]');
      zoom100Btn?.classList.remove('font-bold', 'text-[color:var(--fg)]');
      updateDocumentScale();
    });

    zoom100Btn?.addEventListener('click', () => {
      currentScaleMode = '100';
      zoom100Btn.classList.add('font-bold', 'text-[color:var(--fg)]');
      zoomFitBtn?.classList.remove('font-bold', 'text-[color:var(--fg)]');
      updateDocumentScale();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        editorColumn?.classList.remove('hidden');
        previewColumn?.classList.remove('hidden');
      }
      updateDocumentScale();
    });

    syncFormInputs();
    setTimeout(updateDocumentScale, 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCvMaker);
  } else {
    initCvMaker();
  }
</script>
