---
import { withBasePath } from '../../utils/site';

interface Props {
  initialTemplate?: 'professional' | 'modern' | 'student';
}

const { initialTemplate = 'professional' } = Astro.props as Props;
---

<!-- Include local high-performance html2pdf bundle for instantaneous direct PDF generation -->
<script is:inline src={withBasePath('/js/html2pdf.bundle.min.js')}></script>

<div id="cv-maker-root" class="space-y-6 sm:space-y-8 w-full max-w-full min-w-0 overflow-x-hidden" data-default-template={initialTemplate}>
  <!-- Top Control Bar -->
  <div class="flex flex-col gap-4 sm:gap-5 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-4 sm:p-7 shadow-sm lg:flex-row lg:items-center lg:justify-between w-full max-w-full min-w-0">
    <div class="space-y-1.5 min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">
          Professional CV &amp; Resume Builder
        </h2>
        <span class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          ATS-Standard
        </span>
      </div>
      <p class="text-xs sm:text-sm text-[color:var(--muted)]">
        Create a clean, recruiter-approved resume formatted to Harvard and Wall Street standards.
      </p>
    </div>

    <!-- Template Selector & Actions -->
    <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2.5 w-full lg:w-auto min-w-0">
      <div class="grid grid-cols-3 sm:flex items-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-1 shadow-inner w-full sm:w-auto min-w-0">
        <button
          type="button"
          data-template-btn="professional"
          class="cv-template-btn active cursor-pointer rounded-xl px-2 sm:px-3.5 py-1.5 text-[11px] sm:text-xs font-semibold transition text-center truncate"
        >
          Professional
        </button>
        <button
          type="button"
          data-template-btn="modern"
          class="cv-template-btn cursor-pointer rounded-xl px-2 sm:px-3.5 py-1.5 text-[11px] sm:text-xs font-semibold transition text-center truncate"
        >
          Modern
        </button>
        <button
          type="button"
          data-template-btn="student"
          class="cv-template-btn cursor-pointer rounded-xl px-2 sm:px-3.5 py-1.5 text-[11px] sm:text-xs font-semibold transition text-center truncate"
        >
          Student
        </button>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <button
          type="button"
          id="cv-load-sample"
          class="flex-1 sm:flex-none cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] shadow-sm transition hover:bg-[color:var(--accent-soft)] hover:text-[color:var(--accent)] hover:border-[color:var(--accent)] text-center"
        >
          Sample Data
        </button>

        <button
          type="button"
          id="cv-clear-all"
          class="cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-2 text-xs font-semibold text-rose-600 dark:text-rose-400 shadow-sm transition hover:bg-rose-500/10 hover:border-rose-300 text-center"
        >
          Clear
        </button>

        <!-- The Single Direct Download PDF Button -->
        <button
          type="button"
          id="cv-download-pdf"
          class="flex-1 sm:flex-none inline-flex cursor-pointer items-center justify-center gap-1.5 rounded-xl bg-[color:var(--fg)] px-4 sm:px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]"
        >
          <span id="cv-btn-label">Download PDF</span>
          <svg id="cv-btn-icon" class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Mode Switcher Bar (Visible on mobile screens < 1024px) -->
  <div class="flex items-center justify-between gap-1.5 sm:gap-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-1.5 shadow-sm lg:hidden w-full max-w-full min-w-0">
    <button
      type="button"
      id="cv-mobile-tab-edit"
      class="flex-1 flex items-center justify-center gap-1.5 rounded-xl bg-[color:var(--fg)] text-[color:var(--bg)] py-2 text-xs font-bold transition shadow-xs cursor-pointer"
    >
      <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
      </svg>
      <span>Edit Details</span>
    </button>
    <button
      type="button"
      id="cv-mobile-tab-preview"
      class="flex-1 flex items-center justify-center gap-1.5 rounded-xl text-[color:var(--muted)] py-2 text-xs font-bold hover:text-[color:var(--fg)] transition cursor-pointer"
    >
      <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
      <span>Preview A4</span>
    </button>
    <button
      type="button"
      id="cv-mobile-btn-download"
      class="flex items-center justify-center gap-1.5 rounded-xl bg-emerald-600 text-white px-3 sm:px-3.5 py-2 text-xs font-bold shadow-xs hover:bg-emerald-700 transition cursor-pointer"
      title="Download PDF"
    >
      <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      <span>PDF</span>
    </button>
  </div>

  <!-- Main Workspace Grid: Form Editor (Left) & Real A4 Document Preview (Right) -->
  <div class="grid gap-6 lg:gap-8 lg:grid-cols-12 lg:items-start w-full max-w-full min-w-0">
    
    <!-- Left Column: Form Editor (5-6 cols on desktop, full width on mobile edit mode) -->
    <div id="cv-editor-column" class="space-y-6 w-full max-w-full min-w-0 overflow-hidden lg:col-span-6 xl:col-span-5">
      <form id="cv-form" class="space-y-5 w-full min-w-0" onsubmit="return false;">
        
        <!-- Step Navigation Tabs -->
        <div class="flex overflow-x-auto pb-1 gap-1 border-b border-[color:var(--border)] text-xs font-semibold no-scrollbar w-full max-w-full min-w-0">
          <button type="button" data-tab-target="sec-personal" class="cv-tab-btn active shrink-0 rounded-t-xl px-3 py-2 transition">Contact</button>
          <button type="button" data-tab-target="sec-summary" class="cv-tab-btn shrink-0 rounded-t-xl px-3 py-2 transition">Summary</button>
          <button type="button" data-tab-target="sec-education" class="cv-tab-btn shrink-0 rounded-t-xl px-3 py-2 transition">Education</button>
          <button type="button" data-tab-target="sec-experience" class="cv-tab-btn shrink-0 rounded-t-xl px-3 py-2 transition">Experience</button>
          <button type="button" data-tab-target="sec-skills" class="cv-tab-btn shrink-0 rounded-t-xl px-3 py-2 transition">Skills</button>
          <button type="button" data-tab-target="sec-projects" class="cv-tab-btn shrink-0 rounded-t-xl px-3 py-2 transition">Projects</button>
          <button type="button" data-tab-target="sec-extras" class="cv-tab-btn shrink-0 rounded-t-xl px-3 py-2 transition">More</button>
        </div>

        <!-- 1. PERSONAL / CONTACT SECTION -->
        <div id="sec-personal" class="cv-tab-content space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 shadow-sm">
          <div class="border-b border-[color:var(--border)] pb-3">
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Personal &amp; Contact Details</h3>
            <p class="text-xs text-[color:var(--muted)] mt-0.5">Enter your verified contact info. Do not include personal age, marital status, or full street addresses.</p>
          </div>

          <div class="space-y-3.5">
            <div>
              <label class="block text-xs font-bold text-[color:var(--fg)] mb-1.5">Full Name *</label>
              <input type="text" id="inp-name" required placeholder="e.g. Alexander J. Morgan" class="cv-input" />
            </div>

            <div>
              <label class="block text-xs font-bold text-[color:var(--fg)] mb-1.5">Professional Title</label>
              <input type="text" id="inp-title" placeholder="e.g. Senior Software Engineer / Financial Analyst" class="cv-input" />
            </div>

            <div class="grid gap-3.5 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-bold text-[color:var(--fg)] mb-1.5">Email Address *</label>
                <input type="email" id="inp-email" required placeholder="alex.morgan@example.com" class="cv-input" />
              </div>
              <div>
                <label class="block text-xs font-bold text-[color:var(--fg)] mb-1.5">Phone Number</label>
                <input type="tel" id="inp-phone" placeholder="+1 (555) 234-5678" class="cv-input" />
              </div>
            </div>

            <div class="grid gap-3.5 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-bold text-[color:var(--fg)] mb-1.5">Location (City, State/Country)</label>
                <input type="text" id="inp-location" placeholder="e.g. San Francisco, CA / London, UK" class="cv-input" />
              </div>
              <div>
                <label class="block text-xs font-bold text-[color:var(--fg)] mb-1.5">LinkedIn Profile URL</label>
                <input type="text" id="inp-linkedin" placeholder="linkedin.com/in/alexmorgan" class="cv-input" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-[color:var(--fg)] mb-1.5">Portfolio / GitHub Website</label>
              <input type="text" id="inp-website" placeholder="alexmorgan.dev / github.com/alex" class="cv-input" />
            </div>
          </div>
        </div>

        <!-- 2. PROFESSIONAL SUMMARY -->
        <div id="sec-summary" class="cv-tab-content hidden space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 shadow-sm">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-[color:var(--border)] pb-3">
            <div>
              <h3 class="text-sm font-bold text-[color:var(--fg)]">Professional Summary</h3>
              <p class="text-xs text-[color:var(--muted)] mt-0.5">2 to 4 concise sentences summarizing your background, strengths, and impact.</p>
            </div>
            <button
              type="button"
              id="btn-ai-summary"
              class="inline-flex cursor-pointer items-center justify-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1.5 text-xs font-bold text-[color:var(--fg)] shadow-xs transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)] shrink-0"
              title="Generate or improve summary using your CV facts"
            >
              <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              <span id="ai-summary-btn-text">Improve with AI</span>
            </button>
          </div>

          <!-- AI Proposal / Review Card -->
          <div id="ai-summary-proposal-card" class="hidden rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-3 shadow-xs transition-all">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[color:var(--fg)]">
                <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
                <span>AI Suggested Summary</span>
              </span>
              <span id="ai-provider-badge" class="text-[10px] font-mono text-[color:var(--muted)]"></span>
            </div>
            <p id="ai-summary-text" class="text-xs leading-relaxed text-[color:var(--fg)] italic bg-[color:var(--surface-strong)] p-3 rounded-xl border border-[color:var(--border)]"></p>
            <div class="flex items-center justify-end gap-2 pt-1">
              <button
                type="button"
                id="btn-ai-dismiss"
                class="cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] hover:bg-[color:var(--surface-strong)] transition"
              >
                Dismiss
              </button>
              <button
                type="button"
                id="btn-ai-apply"
                class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-[color:var(--fg)] px-3.5 py-1.5 text-xs font-bold text-[color:var(--bg)] shadow-xs transition hover:opacity-90"
              >
                <span>Apply to Summary</span>
              </button>
            </div>
          </div>

          <!-- AI Status / Notice Alert -->
          <div id="ai-summary-status" class="hidden text-xs rounded-xl p-3 border leading-relaxed"></div>

          <div>
            <textarea
              id="inp-summary"
              rows="6"
              placeholder="e.g. Results-driven software engineer with 6+ years of experience architecting high-performance web applications. Expert in TypeScript, React, and cloud deployments. Proven track record in boosting application performance by 40% and mentoring junior engineering talent."
              class="cv-input leading-relaxed"
            ></textarea>
            <p class="mt-2 text-[11px] text-[color:var(--muted)]">Harvard Tip: Start with your professional identity, state your core technical competency, and close with an impact metric.</p>
          </div>
        </div>

        <!-- 3. EDUCATION SECTION -->
        <div id="sec-education" class="cv-tab-content hidden space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-3">
            <div>
              <h3 class="text-sm font-bold text-[color:var(--fg)]">Education &amp; Degrees</h3>
              <p class="text-xs text-[color:var(--muted)] mt-0.5">List university degrees, college credentials, or academic programs.</p>
            </div>
            <button type="button" id="btn-add-edu" class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--accent)] hover:border-[color:var(--accent)] shadow-sm">
              <span>+ Add Degree</span>
            </button>
          </div>
          <div id="edu-container" class="space-y-4">
            <!-- Rendered Dynamic Education Cards -->
          </div>
        </div>

        <!-- 4. WORK EXPERIENCE SECTION -->
        <div id="sec-experience" class="cv-tab-content hidden space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-3">
            <div>
              <h3 class="text-sm font-bold text-[color:var(--fg)]">Work Experience</h3>
              <p class="text-xs text-[color:var(--muted)] mt-0.5">List roles in reverse chronological order with bullet points.</p>
            </div>
            <button type="button" id="btn-add-exp" class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--accent)] hover:border-[color:var(--accent)] shadow-sm">
              <span>+ Add Experience</span>
            </button>
          </div>
          <div id="exp-container" class="space-y-5">
            <!-- Rendered Dynamic Experience Cards -->
          </div>
        </div>

        <!-- 5. SKILLS SECTION -->
        <div id="sec-skills" class="cv-tab-content hidden space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 shadow-sm">
          <div class="border-b border-[color:var(--border)] pb-3">
            <h3 class="text-sm font-bold text-[color:var(--fg)]">Skills &amp; Competencies</h3>
            <p class="text-xs text-[color:var(--muted)] mt-0.5">Add hard skills, programming languages, tools, frameworks, and methodologies.</p>
          </div>
          <div class="space-y-3">
            <div class="flex gap-2">
              <input type="text" id="inp-skill-item" placeholder="e.g. TypeScript, React, SQL, Financial Modeling, Docker" class="cv-input flex-1" />
              <button type="button" id="btn-add-skill" class="shrink-0 rounded-xl bg-[color:var(--accent)] px-4 py-2.5 text-xs font-bold text-[color:var(--bg)] shadow-sm hover:bg-[color:var(--accent-strong)]">Add Skill</button>
            </div>
            <p class="text-[11px] text-[color:var(--muted)]">Tip: You can paste a comma-separated list of skills to add them all at once.</p>
            <div id="skills-badge-container" class="mt-3 flex flex-wrap gap-2 min-h-[40px] p-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)]">
              <!-- Skill Badges -->
            </div>
          </div>
        </div>

        <!-- 6. PROJECTS SECTION -->
        <div id="sec-projects" class="cv-tab-content hidden space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-3">
            <div>
              <h3 class="text-sm font-bold text-[color:var(--fg)]">Projects &amp; Portfolio</h3>
              <p class="text-xs text-[color:var(--muted)] mt-0.5">Showcase personal, academic, or open-source projects.</p>
            </div>
            <button type="button" id="btn-add-project" class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-bold text-[color:var(--accent)] hover:border-[color:var(--accent)] shadow-sm">
              <span>+ Add Project</span>
            </button>
          </div>
          <div id="proj-container" class="space-y-4">
            <!-- Rendered Dynamic Project Cards -->
          </div>
        </div>

        <!-- 7. EXTRA SECTIONS -->
        <div id="sec-extras" class="cv-tab-content hidden space-y-5 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 sm:p-6 shadow-sm">
          
          <!-- Certifications -->
          <div class="space-y-3 border-b border-[color:var(--border)] pb-4">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Certifications</h4>
              <button type="button" id="btn-add-cert" class="text-xs font-bold text-[color:var(--accent)] hover:underline">+ Add Certificate</button>
            </div>
            <div id="cert-container" class="space-y-2.5"></div>
          </div>

          <!-- Languages -->
          <div class="space-y-3 border-b border-[color:var(--border)] pb-4">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Languages</h4>
              <button type="button" id="btn-add-lang" class="text-xs font-bold text-[color:var(--accent)] hover:underline">+ Add Language</button>
            </div>
            <div id="lang-container" class="space-y-2.5"></div>
          </div>

          <!-- Awards / Honors -->
          <div class="space-y-3 border-b border-[color:var(--border)] pb-4">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Awards &amp; Honors</h4>
              <button type="button" id="btn-add-award" class="text-xs font-bold text-[color:var(--accent)] hover:underline">+ Add Award</button>
            </div>
            <div id="award-container" class="space-y-2.5"></div>
          </div>

          <!-- Volunteer -->
          <div class="space-y-3 border-b border-[color:var(--border)] pb-4">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">Volunteer Experience</h4>
              <button type="button" id="btn-add-vol" class="text-xs font-bold text-[color:var(--accent)] hover:underline">+ Add Volunteer</button>
            </div>
            <div id="vol-container" class="space-y-2.5"></div>
          </div>

          <!-- Interests -->
          <div class="space-y-2 border-b border-[color:var(--border)] pb-4">
            <label class="block text-xs font-bold text-[color:var(--fg)]">Interests / Activities</label>
            <input type="text" id="inp-interests" placeholder="e.g. Open-source development, Marathon running, Chess, Technical writing" class="cv-input" />
          </div>

          <!-- References -->
          <div class="space-y-2">
            <label class="block text-xs font-bold text-[color:var(--fg)]">References</label>
            <input type="text" id="inp-references" placeholder="e.g. Available upon request" class="cv-input" />
          </div>
        </div>

        <!-- Form Navigation Footer -->
        <div class="flex items-center justify-between pt-2">
          <button type="button" id="btn-prev-tab" class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-4 py-2 text-xs font-bold text-[color:var(--muted)] hover:text-[color:var(--fg)]">
            ← Previous
          </button>
          <button type="button" id="btn-next-tab" class="rounded-xl bg-[color:var(--accent)] px-5 py-2 text-xs font-bold text-[color:var(--bg)] shadow-sm hover:bg-[color:var(--accent-strong)]">
            Next Step →
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column: Live A4 Document Canvas Preview (6-7 cols on desktop, dedicated preview mode on mobile) -->
    <div id="cv-preview-column" class="hidden lg:block space-y-3 w-full max-w-full min-w-0 overflow-hidden lg:col-span-6 xl:col-span-7">
      <div class="flex items-center justify-between px-1">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">A4 Live Document Preview</span>
          <span id="preview-template-label" class="rounded-md bg-[color:var(--surface)] border border-[color:var(--border)] px-2 py-0.5 text-[11px] font-semibold text-[color:var(--fg)]">
            Professional (Harvard Standard)
          </span>
        </div>
        <span class="text-[11px] text-[color:var(--muted)]">Exact A4 (1:1.41)</span>
      </div>

      <!-- Outer Viewport Frame -->
