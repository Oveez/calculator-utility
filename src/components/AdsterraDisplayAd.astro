---
interface Props {
  format: 'skyscraper' | 'rectangle' | 'vertical' | 'leaderboard' | 'mobile-banner';
  class?: string;
}

const { format, class: className = '' } = Astro.props as Props;
const units = {
  skyscraper: { key: '1498c6c2265c1eb286c77895952e20c5', width: 160, height: 600, media: '(min-width: 1280px)' },
  rectangle: { key: '870b262b468b958c99d159ae5bafb473', width: 300, height: 250, media: 'all' },
  vertical: { key: 'e1a4b96b5bf2fa6b1efb3843ea4e2a01', width: 160, height: 300, media: '(min-width: 1280px)' },
  leaderboard: { key: '128ec5e03e4921d4d2751a9cc07d2808', width: 728, height: 90, media: '(min-width: 1024px)' },
  'mobile-banner': { key: '7972ace1d0daa4818b81871a83db36a8', width: 320, height: 50, media: '(max-width: 767px)' },
} as const;
const unit = units[format];
---

<aside
  class={`adsterra-slot adsterra-slot--${format} mx-auto max-w-full overflow-hidden ${className}`}
  aria-label="Advertisement"
  style={`--ad-width:${unit.width}px;--ad-height:${unit.height}px`}
>
  <span class="adsterra-label">Advertisement</span>
  <div class="adsterra-frame">
    <script is:inline define:vars={{ key: unit.key, width: unit.width, height: unit.height, media: unit.media }}>
      // The dashboard tags are parser-inserted scripts. This preserves that
      // execution behavior while only loading units intended for this viewport.
      if (window.matchMedia(media).matches) {
        window.atOptions = { key, format: 'iframe', height, width, params: {} };
        document.write('<scr' + 'ipt src="https://www.highrevenueformat.com/' + key + '/invoke.js"><\/scr' + 'ipt>');
      }
    </script>
  </div>
</aside>

<style>
  .adsterra-slot {
    box-sizing: border-box;
    width: min(var(--ad-width), 100%);
    min-height: calc(var(--ad-height) + 1.25rem);
    text-align: center;
  }
  .adsterra-label {
    display: block;
    height: 1.25rem;
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.25rem;
  }
  .adsterra-frame {
    width: 100%;
    min-height: var(--ad-height);
    overflow: hidden;
  }
  .adsterra-slot--mobile-banner { display: none; }

  @media (max-width: 1023px) {
    .adsterra-slot--leaderboard { display: none; }
  }

  @media (max-width: 1279px) {
    .adsterra-slot--skyscraper,
    .adsterra-slot--vertical { display: none; }
  }

  @media (max-width: 767px) {
    .adsterra-slot--mobile-banner { display: block; }
  }
</style>
