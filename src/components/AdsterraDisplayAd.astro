---
import AdsterraSkyscraper from './ads/AdsterraSkyscraper.astro';
import AdsterraRectangle from './ads/AdsterraRectangle.astro';
import AdsterraVertical from './ads/AdsterraVertical.astro';
import AdsterraLeaderboard from './ads/AdsterraLeaderboard.astro';
import AdsterraMobileBanner from './ads/AdsterraMobileBanner.astro';

interface Props {
  format: 'skyscraper' | 'rectangle' | 'vertical' | 'leaderboard' | 'mobile-banner';
  class?: string;
}

const { format, class: className = '' } = Astro.props as Props;
---

{format === 'skyscraper' && <AdsterraSkyscraper class={className} />}
{format === 'rectangle' && <AdsterraRectangle class={className} />}
{format === 'vertical' && <AdsterraVertical class={className} />}
{format === 'leaderboard' && <AdsterraLeaderboard class={className} />}
{format === 'mobile-banner' && <AdsterraMobileBanner class={className} />}
