---
/**
 * BrandMark — Toolscastle official logo component.
 * Uses official logo variants (dark text on white for light headers, transparent white text for dark surfaces).
 */
import { withBasePath } from '../utils/site';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showWordmark?: boolean;
  class?: string;
  variant?: 'default' | 'light';
}

const {
  size = 'md',
  showWordmark = true,
  class: extraClass = '',
  variant = 'default',
} = Astro.props;

const logoHeight = size === 'sm' ? 'h-7' : size === 'lg' ? 'h-11' : 'h-9 sm:h-10';
const iconSize = size === 'sm' ? 'w-7 h-7' : size === 'lg' ? 'w-10 h-10' : 'w-8 h-8 sm:w-9 sm:h-9';
const logoSrc = variant === 'light'
  ? withBasePath('/logo-footer-transparent.png')
  : withBasePath('/logo.png');
---

{showWordmark ? (
  <span class={`inline-flex items-center ${extraClass}`}>
    <img
      src={logoSrc}
      alt="ToolsCastle"
      class={`${logoHeight} w-auto object-contain rounded-sm`}
      loading="eager"
      decoding="async"
    />
  </span>
) : (
  <span class={`inline-flex items-center ${extraClass}`}>
    <img
      src={withBasePath('/calc.png')}
      alt="ToolsCastle Logo"
      class={`${iconSize} object-contain rounded-md`}
      loading="eager"
      decoding="async"
    />
  </span>
)}

