---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { siteName, withBasePath } from '../utils/site';
import { allToolsIndex } from '../data/allToolsIndex';
import { getCategoryIconConfig } from '../utils/toolIcons';

// Logical category ordering for the 186 tools directory
const categoryOrder = [
  'Finance',
  'Tax & Finance',
  'Education',
  'Academic',
  'Health',
  'Math',
  'Converters',
  'Time',
  'Text',
  'Data',
  'Developer',
  'Image',
  'PDF',
  'Color',
  'Generators',
  'Research',
  'Business',
  'Career',
  'Pricing',
  'Shipping',
  'URL',
];

const uniqueCategories = Array.from(new Set(allToolsIndex.map((t) => t.category))).sort((a, b) => {
  const ia = categoryOrder.indexOf(a);
  const ib = categoryOrder.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b);
});

const categoriesWithTools = uniqueCategories.map((category) => {
  const tools = allToolsIndex
    .filter((tool) => tool.category === category)
    .sort((a, b) => a.title.localeCompare(b.title));
  const iconConfig = getCategoryIconConfig(category);
  return {
    name: category,
    count: tools.length,
    iconConfig,
    tools,
  };
});
---

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-drawer-root"
  class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300 lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation Drawer"
>
  <!-- Backdrop Overlay -->
  <div
    id="mobile-drawer-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-xs transition-opacity duration-300"
  ></div>

  <!-- Drawer Shell -->
  <aside
    id="mobile-drawer-panel"
    class="relative flex h-full w-[84vw] max-w-sm flex-col border-r border-[color:var(--border)] bg-[color:var(--bg)] shadow-2xl transition-transform duration-300 -translate-x-full overflow-hidden"
  >
    <!-- Drawer Header (Solid White with dark logo for contrast) -->
    <div class="flex items-center justify-between border-b border-slate-200/90 p-4 bg-white text-slate-800">
      <a class="flex items-center gap-2.5" href={withBasePath('/')} id="drawer-brand-link" aria-label={`${siteName} Home`}>
        <BrandMark size="sm" variant="default" />
      </a>

      <button
        type="button"
        id="close-mobile-drawer"
        class="flex h-9 w-9 items-center justify-center text-slate-500 hover:text-[color:var(--accent)] transition-colors cursor-pointer bg-transparent border-0"
        aria-label="Close navigation drawer"
      >
        <Icon name="close" class="w-5 h-5 stroke-[2.2]" />
      </button>
    </div>

    <!-- Drawer Navigation: All Tool Categories Accordions -->
    <nav class="flex-1 overflow-y-auto p-3 space-y-2 no-scrollbar" aria-label="Mobile Drawer Navigation">
      <div class="space-y-1.5">
        <p class="px-2 text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Tool Categories</p>
        {categoriesWithTools.map((cat) => (
          <details class="drawer-group group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] overflow-hidden transition-colors">
            <summary class="flex cursor-pointer list-none items-center justify-between p-3 text-xs font-bold text-slate-800 select-none hover:bg-slate-50 transition">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200/80 bg-slate-50 text-slate-500 group-hover:text-slate-600 group-hover:border-[color:var(--accent)] group-hover:bg-[color:var(--accent)] transition-colors shrink-0 shadow-2xs">
                  <svg class="w-4 h-4 stroke-current transition-colors" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.iconConfig.svgPath} />
                </span>
                <span class="truncate">{cat.name}</span>
                <span class="text-[10px] font-medium text-[color:var(--muted)] shrink-0">({cat.count})</span>
              </div>
              <span class="text-[10px] text-[color:var(--muted)] group-open:rotate-180 transition-transform shrink-0 ml-2">▼</span>
            </summary>
            <div class="border-t border-[color:var(--border)] bg-slate-50/50 p-2 space-y-1">
              {cat.tools.map((tool) => (
                <a
                  href={withBasePath(tool.url)}
                  class="drawer-nav-item block rounded-xl px-3 py-1.5 text-xs font-medium text-slate-700 hover:text-slate-700 hover:bg-[color:var(--accent)] transition"
                >
                  {tool.title}
                </a>
              ))}
            </div>
          </details>
        ))}
      </div>

      <!-- Legal & Company Section -->
      <div class="pt-3 border-t border-[color:var(--border)] space-y-1 text-xs text-slate-600">
        <p class="px-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">Information</p>
        <a href={withBasePath('/about/')} class="drawer-nav-item block rounded-xl px-3 py-1.5 hover:text-slate-700 hover:bg-[color:var(--accent)] transition">About</a>
        <a href={withBasePath('/contact/')} class="drawer-nav-item block rounded-xl px-3 py-1.5 hover:text-slate-700 hover:bg-[color:var(--accent)] transition">Contact Support</a>
        <a href={withBasePath('/privacy/')} class="drawer-nav-item block rounded-xl px-3 py-1.5 hover:text-slate-700 hover:bg-[color:var(--accent)] transition">Privacy Policy</a>
        <a href={withBasePath('/terms/')} class="drawer-nav-item block rounded-xl px-3 py-1.5 hover:text-slate-700 hover:bg-[color:var(--accent)] transition">Terms of Service</a>
      </div>
    </nav>

    <!-- Drawer Footer / Safe Area -->
    <div class="border-t border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 text-center text-[11px] text-[color:var(--muted)]" style="padding-bottom: max(0.875rem, env(safe-area-inset-bottom));">
      <p>© {new Date().getFullYear()} {siteName}. All rights reserved.</p>
    </div>
  </aside>
</div>

<style>
  #close-mobile-drawer {
    background: transparent !important;
    border: none !important;
    color: #64748b !important;
    box-shadow: none !important;
  }
  #close-mobile-drawer:hover {
    background: transparent !important;
    border: none !important;
    color: var(--accent) !important;
  }
  #close-mobile-drawer svg {
    color: inherit !important;
    stroke: currentColor !important;
  }

  .drawer-nav-item {
    color: #334155 !important;
  }
  .drawer-nav-item:hover {
    color: #334155 !important;
    background-color: var(--accent) !important;
  }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById('mobile-drawer-root');
    if (!root) return;

    const panel = document.getElementById('mobile-drawer-panel');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const closeBtn = document.getElementById('close-mobile-drawer');

    function openDrawer() {
      root.classList.remove('pointer-events-none', 'opacity-0');
      root.classList.add('pointer-events-auto', 'opacity-100');
      if (panel) {
        panel.classList.remove('-translate-x-full');
        panel.classList.add('translate-x-0');
      }
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      root.classList.remove('pointer-events-auto', 'opacity-100');
      root.classList.add('pointer-events-none', 'opacity-0');
      if (panel) {
        panel.classList.remove('translate-x-0');
        panel.classList.add('-translate-x-full');
      }
      document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Event delegation: close drawer when any drawer nav item is clicked
    root.addEventListener('click', (e) => {
      const navItem = e.target.closest('.drawer-nav-item');
      if (navItem) {
        closeDrawer();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.classList.contains('pointer-events-none')) {
        closeDrawer();
      }
    });

    // Expose globally for header menu button
    window.openMobileDrawer = openDrawer;
    window.closeMobileDrawer = closeDrawer;

    // Attach trigger listeners
    document.querySelectorAll('[data-trigger-drawer]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openDrawer();
      });
    });
  })();
</script>