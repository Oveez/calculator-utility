---
import type { CalculatorChartConfig } from '../../types/calculator';

interface Props {
  chart?: CalculatorChartConfig;
  id?: string;
}

const { chart, id = 'calc-chart' } = Astro.props as Props;
---

<div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-sm" data-calculator-chart-root id={id}>
  <div class="flex items-center justify-between gap-3 mb-4">
    <h3 class="text-lg font-bold text-[color:var(--fg)]" data-chart-title>
      {chart?.title ?? 'Visual Breakdown'}
    </h3>
    <span class="rounded-full bg-[color:var(--surface)] px-2.5 py-0.5 text-xs font-semibold text-[color:var(--muted)] border border-[color:var(--border)]" data-chart-type-badge>
      {chart?.type ?? 'Chart'}
    </span>
  </div>

  <!-- SVG Chart Canvas Area -->
  <div class="relative flex items-center justify-center min-h-[220px] w-full" data-chart-canvas-container>
    <svg
      class="h-full w-full max-h-[260px] overflow-visible"
      viewBox="0 0 400 220"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="Calculator visual data representation"
      data-chart-svg
    >
      <title data-chart-accessible-title>{chart?.title ?? 'Chart representation'}</title>
      <!-- Chart primitives dynamically drawn or statically rendered -->
      <g data-chart-elements>
        <!-- Fallback placeholder when initially empty -->
        <text x="200" y="115" text-anchor="middle" fill="currentColor" class="text-xs fill-[color:var(--muted)]">
          Interactive visualization updates with calculation
        </text>
      </g>
    </svg>
  </div>

  <!-- Summary / Legend -->
  <div class="mt-4 border-t border-[color:var(--border)] pt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-[color:var(--muted)]" data-chart-legend>
    <span data-chart-summary>{chart?.summaryText ?? 'Real-time calculation visualization'}</span>
    <div class="flex flex-wrap items-center gap-3" data-chart-legend-items></div>
  </div>
</div>
