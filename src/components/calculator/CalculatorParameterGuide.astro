---
import type { CalculatorInput, CalculatorParameterInfo } from '../../types/calculator';
import Icon from '../Icon.astro';

interface WorkedExampleStep {
  step: string;
  calculation: string;
  result: string;
}

interface WorkedExample {
  title: string;
  description: string;
  formula?: string;
  steps: WorkedExampleStep[];
}

interface Props {
  title?: string;
  description?: string;
  parameters?: CalculatorParameterInfo[];
  inputs?: CalculatorInput[];
  workedExample?: WorkedExample;
}

const { title, description, parameters, inputs, workedExample } = Astro.props as Props;

// If parametersGuide array is provided, use it; otherwise fallback to inputs with helpText/labels
const guideItems: CalculatorParameterInfo[] = parameters ?? (inputs?.map((input) => ({
  id: input.id,
  name: input.label,
  description: input.helpText ?? `The ${input.label.toLowerCase()} parameter entered into the calculator.`,
  whyItMatters: `Determines the magnitude and accuracy of the resulting calculation.`,
  typicalRange: input.min !== undefined && input.max !== undefined ? `${input.min} to ${input.max}` : undefined,
  unit: input.unit,
})) ?? []);
---

{guideItems.length > 0 && (
  <section class="space-y-6 pt-6" data-parameter-guide>
    <div class="space-y-2">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">
        {title ?? "Understanding Your Inputs"}
      </h2>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
        {description ?? "Detailed breakdown of the variables used in this calculation, why they matter, and typical values to use."}
      </p>
    </div>

    <!-- Plain Editorial Content (line by line) -->
    <div class="space-y-6 divide-y divide-[color:var(--border)]/70">
      {guideItems.map((param, index) => (
        <article class:list={["space-y-2 max-w-4xl", index > 0 && "pt-6"]}>
          <div class="flex flex-wrap items-baseline gap-2">
            <h3 class="text-base sm:text-lg font-bold tracking-tight text-[color:var(--fg)]">
              {index + 1}. {param.name}
            </h3>
            {param.unit && (
              <span class="text-xs font-medium text-[color:var(--muted)]">
                ({param.unit})
              </span>
            )}
            {param.type && (
              <span class="text-xs font-mono text-[color:var(--muted)]">
                [{param.type}]
              </span>
            )}
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-[color:var(--fg)]/90">
            {param.description}
          </p>

          {param.whyItMatters && (
            <p class="text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
              <strong class="font-bold text-[color:var(--fg)]">Why it matters:</strong> {param.whyItMatters}
            </p>
          )}

          {(param.defaultValue || param.typicalRange) && (
            <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-xs sm:text-sm text-[color:var(--muted)]">
              {param.defaultValue && (
                <span>
                  <strong class="font-semibold text-[color:var(--fg)]">Default:</strong> {param.defaultValue}
                </span>
              )}
              {param.typicalRange && (
                <span>
                  <strong class="font-semibold text-[color:var(--fg)]">Typical range:</strong> {param.typicalRange}
                </span>
              )}
            </div>
          )}
        </article>
      ))}
    </div>

    {workedExample && (
      <div class="mt-8 pt-6 border-t border-[color:var(--border)] space-y-4 max-w-4xl">
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[color:var(--fg)]">
          {workedExample.title}
        </h3>
        <p class="text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
          {workedExample.description}
        </p>

        {workedExample.formula && (
          <div class="py-2 text-xs sm:text-sm">
            <span class="font-bold text-[color:var(--fg)]">Formula: </span>
            <code class="font-mono text-[color:var(--fg)] font-semibold">
              {workedExample.formula}
            </code>
          </div>
        )}

        <div class="space-y-2 pt-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] block">
            Step-by-Step Breakdown:
          </span>
          <ol class="list-decimal pl-5 space-y-2 text-sm sm:text-base text-[color:var(--muted)]">
            {workedExample.steps.map((step) => (
              <li class="leading-relaxed">
                <strong class="font-bold text-[color:var(--fg)]">{step.step}:</strong>{" "}
                <span>{step.calculation}</span> —{" "}
                <span class="font-bold text-[color:var(--fg)] font-mono">Result: {step.result}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    )}
  </section>
)}
