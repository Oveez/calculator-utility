---
import type { CalculatorInput, CalculatorParameterInfo } from '../../types/calculator';
import Icon from '../Icon.astro';

interface WorkedExampleStep {
  step: string;
  calculation: string;
  result: string;
}

interface WorkedExample {
  title: string;
  description: string;
  formula?: string;
  steps: WorkedExampleStep[];
}

interface Props {
  title?: string;
  description?: string;
  parameters?: CalculatorParameterInfo[];
  inputs?: CalculatorInput[];
  workedExample?: WorkedExample;
}

const { title, description, parameters, inputs, workedExample } = Astro.props as Props;

// If parametersGuide array is provided, use it; otherwise fallback to inputs with helpText/labels
const guideItems: CalculatorParameterInfo[] = parameters ?? (inputs?.map((input) => ({
  id: input.id,
  name: input.label,
  description: input.helpText ?? `The ${input.label.toLowerCase()} parameter entered into the calculator.`,
  whyItMatters: `Determines the magnitude and accuracy of the resulting calculation.`,
  typicalRange: input.min !== undefined && input.max !== undefined ? `${input.min} to ${input.max}` : undefined,
  unit: input.unit,
})) ?? []);
---

{guideItems.length > 0 && (
  <details
    open
    class="group rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 shadow-xs transition hover:border-[color:var(--border-strong)]"
    data-parameter-guide
  >
    <summary class="cursor-pointer list-none select-none">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[color:var(--accent)]">
              <Icon name="math" class="w-3.5 h-3.5" />
              <span>Parameter Guide</span>
            </span>
            <span class="text-xs font-semibold text-[color:var(--muted)]">
              • {guideItems.length} {guideItems.length === 1 ? 'Variable' : 'Variables'} Explained
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[color:var(--fg)]">
            {title ?? "Understanding Your Inputs"}
          </h2>
          <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
            {description ?? "Detailed breakdown of the variables used in this calculation, why they matter, and typical values to use."}
          </p>
        </div>

        <div class="shrink-0 self-start sm:self-center">
          <span class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-4 py-2 text-xs font-bold text-[color:var(--fg)] group-hover:border-[color:var(--border-strong)] group-hover:bg-[color:var(--surface)] transition shadow-2xs">
            <span class="group-open:hidden">Show Guide</span>
            <span class="hidden group-open:inline">Hide Guide</span>
            <svg class="h-4 w-4 text-[color:var(--muted)] transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </div>
      </div>
    </summary>

    <!-- Expanded Editorial Content (calculator.net readable standard) -->
    <div class="mt-8 pt-6 border-t border-[color:var(--border)] space-y-8">
      <div class="space-y-6 divide-y divide-[color:var(--border)]/70">
        {guideItems.map((param, index) => (
          <article class:list={["space-y-2.5 max-w-4xl", index > 0 && "pt-6"]}>
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-xs font-bold text-[color:var(--fg)]">
                {index + 1}
              </span>
              <h3 class="text-base sm:text-lg font-bold tracking-tight text-[color:var(--fg)]">
                {param.name}
              </h3>
              {param.unit && (
                <span class="rounded-md bg-[color:var(--surface-strong)] px-2.5 py-0.5 text-xs font-medium text-[color:var(--muted)] border border-[color:var(--border)]">
                  {param.unit}
                </span>
              )}
              {param.type && (
                <span class="rounded-md bg-[color:var(--surface-strong)] px-2.5 py-0.5 text-xs font-mono text-[color:var(--muted)] border border-[color:var(--border)]">
                  {param.type}
                </span>
              )}
            </div>

            <p class="text-sm sm:text-base leading-relaxed text-[color:var(--fg)]/90 dark:text-slate-300 pl-8">
              {param.description}
            </p>

            {param.whyItMatters && (
              <p class="text-sm sm:text-base leading-relaxed text-[color:var(--muted)] pl-8">
                <strong class="font-bold text-[color:var(--fg)]">Why it matters:</strong> {param.whyItMatters}
              </p>
            )}

            {(param.defaultValue || param.typicalRange) && (
              <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pl-8 pt-1 text-xs sm:text-sm text-[color:var(--muted)]">
                {param.defaultValue && (
                  <span class="inline-flex items-center gap-1.5">
                    <strong class="font-semibold text-[color:var(--fg)]">Default:</strong>
                    <code class="font-mono text-xs px-2 py-0.5 rounded bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
                      {param.defaultValue}
                    </code>
                  </span>
                )}
                {param.typicalRange && (
                  <span class="inline-flex items-center gap-1.5">
                    <strong class="font-semibold text-[color:var(--fg)]">Typical range:</strong>
                    <code class="font-mono text-xs px-2 py-0.5 rounded bg-[color:var(--surface-strong)] border border-[color:var(--border)] text-[color:var(--fg)]">
                      {param.typicalRange}
                    </code>
                  </span>
                )}
              </div>
            )}
          </article>
        ))}
      </div>

      {workedExample && (
        <div class="mt-8 pt-8 border-t border-[color:var(--border)] space-y-4 max-w-4xl">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--border)] bg-[color:var(--surface-strong)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[color:var(--accent)]">
              <Icon name="document" class="w-3.5 h-3.5" />
              <span>Worked Example Walkthrough</span>
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[color:var(--fg)]">
            {workedExample.title}
          </h3>
          <p class="text-sm sm:text-base leading-relaxed text-[color:var(--muted)]">
            {workedExample.description}
          </p>

          {workedExample.formula && (
            <div class="rounded-xl bg-[color:var(--surface-strong)] border border-[color:var(--border)] p-4">
              <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] block mb-1">
                Formula Reference
              </span>
              <code class="font-mono text-xs sm:text-sm text-[color:var(--fg)] font-semibold break-all">
                {workedExample.formula}
              </code>
            </div>
          )}

          <div class="space-y-3 pt-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] block">
              Step-by-Step Breakdown
            </span>
            <ol class="space-y-3">
              {workedExample.steps.map((step, sIdx) => (
                <li class="flex items-start gap-3.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface-strong)]/30 p-4">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[color:var(--accent)] text-white text-xs font-bold shadow-xs">
                    {sIdx + 1}
                  </span>
                  <div class="space-y-1 text-sm sm:text-base">
                    <strong class="font-bold text-[color:var(--fg)] block">{step.step}</strong>
                    <p class="text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">{step.calculation}</p>
                    <div class="text-xs sm:text-sm font-bold text-[color:var(--accent)] font-mono pt-1">
                      Result: {step.result}
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )}
    </div>
  </details>
)}
