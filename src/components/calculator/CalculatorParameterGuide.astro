---
import type { CalculatorInput, CalculatorParameterInfo } from '../../types/calculator';
import Icon from '../Icon.astro';

interface WorkedExampleStep {
  step: string;
  calculation: string;
  result: string;
}

interface WorkedExample {
  title: string;
  description: string;
  formula?: string;
  steps: WorkedExampleStep[];
}

interface Props {
  title?: string;
  description?: string;
  parameters?: CalculatorParameterInfo[];
  inputs?: CalculatorInput[];
  workedExample?: WorkedExample;
}

const { title, description, parameters, inputs, workedExample } = Astro.props as Props;

// If parametersGuide array is provided, use it; otherwise fallback to inputs with helpText/labels
const guideItems: CalculatorParameterInfo[] = parameters ?? (inputs?.map((input) => ({
  id: input.id,
  name: input.label,
  description: input.helpText ?? `The ${input.label.toLowerCase()} parameter entered into the calculator.`,
  whyItMatters: `Determines the magnitude and accuracy of the resulting calculation.`,
  typicalRange: input.min !== undefined && input.max !== undefined ? `${input.min} to ${input.max}` : undefined,
  unit: input.unit,
})) ?? []);
---

{guideItems.length > 0 && (
  <section class="space-y-6" data-parameter-guide>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-[color:var(--accent)] flex items-center gap-1.5">
        <Icon name="math" class="w-3.5 h-3.5" />
        <span>Parameter Guide</span>
      </p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-[color:var(--fg)]">
        {title ?? "Understanding Your Inputs"}
      </h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[color:var(--muted)]">
        {description ?? "Detailed breakdown of the variables used in this calculation, why they matter, and typical values to use."}
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {guideItems.map((param) => (
        <article class="flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 shadow-xs transition hover:border-[color:var(--accent)]/40 hover:shadow-[0_0_12px_var(--accent-glow)]">
          <div class="space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-base font-bold text-[color:var(--fg)]">{param.name}</h3>
              {param.unit && (
                <span class="rounded bg-[color:var(--surface)] px-2 py-0.5 text-xs font-semibold text-[color:var(--muted)] border border-[color:var(--border)]">
                  {param.unit}
                </span>
              )}
              {param.type && (
                <span class="rounded bg-[color:var(--surface)] px-2 py-0.5 text-[10px] font-mono text-[color:var(--muted)] border border-[color:var(--border)]">
                  {param.type}
                </span>
              )}
            </div>

            <p class="text-xs leading-relaxed text-[color:var(--muted)]">{param.description}</p>

            {param.defaultValue && (
              <p class="text-[11px] text-[color:var(--muted)]">
                Default: <strong class="font-mono text-[color:var(--fg)]">{param.defaultValue}</strong>
              </p>
            )}

            {param.whyItMatters && (
              <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 text-xs">
                <span class="font-bold text-[color:var(--fg)] block mb-1">Why it matters:</span>
                <span class="text-[color:var(--muted)] leading-normal">{param.whyItMatters}</span>
              </div>
            )}
          </div>

          {param.typicalRange && (
            <div class="mt-4 pt-3 border-t border-[color:var(--border)] flex items-center justify-between text-xs">
              <span class="text-[color:var(--muted)]">Typical range:</span>
              <span class="font-mono font-semibold text-[color:var(--fg)]">{param.typicalRange}</span>
            </div>
          )}
        </article>
      ))}
    </div>

    {workedExample && (
      <div class="mt-6 rounded-2xl border border-[color:var(--accent)]/20 bg-gradient-to-br from-[color:var(--surface)] to-[color:var(--surface-strong)] p-5 sm:p-6 space-y-4 shadow-sm">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--accent)] flex items-center gap-1.5">
            <Icon name="document" class="w-3 h-3" />
            <span>Worked Example</span>
          </span>
          <h3 class="text-lg font-bold text-[color:var(--fg)] mt-0.5">{workedExample.title}</h3>
          <p class="text-xs text-[color:var(--muted)] mt-1 leading-relaxed">{workedExample.description}</p>
        </div>

        {workedExample.formula && (
          <div class="rounded-xl bg-[color:var(--bg)] border border-[color:var(--border)] p-3">
            <span class="text-[10px] font-bold uppercase text-[color:var(--muted)] block mb-1">Formula Reference</span>
            <code class="font-mono text-xs text-[color:var(--accent-secondary)] font-semibold">{workedExample.formula}</code>
          </div>
        )}

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {workedExample.steps.map((step, sIdx) => (
            <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 space-y-1.5 text-xs">
              <span class="font-bold text-[color:var(--fg)] block">Step {sIdx + 1}: {step.step}</span>
              <p class="text-[11px] text-[color:var(--muted)] leading-relaxed">{step.calculation}</p>
              <div class="pt-1 border-t border-[color:var(--border)] text-[color:var(--accent)] font-semibold font-mono text-[11px]">
                {step.result}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
)}
