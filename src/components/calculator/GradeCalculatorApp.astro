---
import Icon from '../Icon.astro';
import { GRADING_STANDARDS, type GradingStandard } from '../../data/gradingStandards';
import type { CalculatorConfig } from '../../types/calculator';

interface Props {
  calculator: CalculatorConfig;
}

const { calculator } = Astro.props as Props;
---

<section
  class="overflow-hidden rounded-[2rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] shadow-[var(--shadow)] transition-all"
  data-grade-calculator-app
>
  <div class="grid gap-8 xl:grid-cols-[1.25fr_0.85fr]">
    <!-- Input Form Column -->
    <form class="space-y-6 p-6 sm:p-8" onsubmit="return false;" data-grade-form>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[color:var(--border)] pb-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-[color:var(--accent)]">Universal Academic Standard</p>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-[color:var(--fg)]">Test &amp; Exam Grade Calculator</h2>
        </div>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-1.5 text-xs font-medium text-[color:var(--fg)] transition hover:border-[color:var(--accent)] hover:bg-[color:var(--surface-strong)] cursor-pointer"
          data-reset-btn
        >
          <Icon name="refresh" class="w-3.5 h-3.5" />
          <span>Reset</span>
        </button>
      </div>

      <!-- Academic / Grading Standard Selector -->
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 sm:p-5 space-y-3">
        <div class="flex items-center justify-between">
          <label for="grade-standard-select" class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
            <span>Grading Standard / Academic System</span>
          </label>
          <span class="text-[11px] font-medium text-[color:var(--muted)]" data-standard-status-badge>Universal Math</span>
        </div>
        <select
          id="grade-standard-select"
          class="w-full cursor-pointer rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-sm font-medium text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
          data-standard-select
        >
          {GRADING_STANDARDS.map((std) => (
            <option value={std.id} selected={std.id === 'universal'}>
              {std.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] leading-relaxed text-[color:var(--muted)]" data-standard-desc>
          Pure mathematical calculation without enforcing letter grades or arbitrary GPA conversions.
        </p>

        <!-- Custom Standard Configuration Box (Hidden unless Custom is selected) -->
        <div class="hidden pt-3 border-t border-[color:var(--border)] space-y-3" data-custom-standard-box>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-[color:var(--fg)]">Custom Grade Scale Editor</span>
            <button
              type="button"
              class="text-xs font-bold text-[color:var(--accent)] hover:underline cursor-pointer"
              data-add-custom-band
            >
              + Add Grade Tier
            </button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="border-b border-[color:var(--border)] text-[color:var(--muted)]">
                  <th class="py-1.5 pr-2">Letter</th>
                  <th class="py-1.5 px-2">Min %</th>
                  <th class="py-1.5 px-2">Max %</th>
                  <th class="py-1.5 px-2">Grade Point</th>
                  <th class="py-1.5 px-2">Pass?</th>
                  <th class="py-1.5 pl-2 text-right">Action</th>
                </tr>
              </thead>
              <tbody data-custom-bands-tbody>
                <!-- Injected via JavaScript -->
              </tbody>
            </table>
          </div>
          <div class="hidden text-xs text-rose-500 font-medium bg-rose-500/10 border border-rose-500/20 p-2.5 rounded-xl" data-custom-validation-msg></div>
        </div>
      </div>

      <!-- Core Score Inputs Grid -->
      <div class="grid gap-4 sm:grid-cols-2">
        <!-- Marks Obtained -->
        <div class="flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition focus-within:border-[color:var(--accent)]">
          <div class="mb-2 flex items-center justify-between">
            <label for="grade-marks-obtained" class="text-xs font-semibold uppercase tracking-wider text-[color:var(--fg)]">
              Marks Obtained
            </label>
            <span class="rounded bg-[color:var(--surface-strong)] px-1.5 py-0.5 text-[11px] font-medium text-[color:var(--muted)] border border-[color:var(--border)]">
              marks
            </span>
          </div>
          <p class="mb-2 text-[11px] leading-tight text-[color:var(--muted)]">Actual score achieved on the test or exam</p>
          <input
            id="grade-marks-obtained"
            type="number"
            min="0"
            step="any"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-base font-semibold text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)]"
            placeholder="e.g. 80"
            data-marks-obtained
          />
        </div>

        <!-- Total Marks Available -->
        <div class="flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 transition focus-within:border-[color:var(--accent)]">
          <div class="mb-2 flex items-center justify-between">
            <label for="grade-total-marks" class="text-xs font-semibold uppercase tracking-wider text-[color:var(--fg)]">
              Total Marks Available
            </label>
            <span class="rounded bg-[color:var(--surface-strong)] px-1.5 py-0.5 text-[11px] font-medium text-[color:var(--muted)] border border-[color:var(--border)]">
              marks
            </span>
          </div>
          <p class="mb-2 text-[11px] leading-tight text-[color:var(--muted)]">Maximum possible points for this assessment</p>
          <input
            id="grade-total-marks"
            type="number"
            min="0.01"
            step="any"
            class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-base font-semibold text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)]"
            placeholder="e.g. 100"
            data-total-marks
          />
        </div>
      </div>

      <!-- Passing Cutoff -->
      <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
        <div class="flex items-center justify-between">
          <label for="grade-passing-mark" class="text-xs font-semibold uppercase tracking-wider text-[color:var(--fg)]">
            Passing Threshold
          </label>
          <span class="rounded bg-[color:var(--surface-strong)] px-1.5 py-0.5 text-[11px] font-medium text-[color:var(--muted)] border border-[color:var(--border)]">
            %
          </span>
        </div>
        <p class="text-[11px] leading-tight text-[color:var(--muted)]">
          Passing mark defined by your syllabus or institution (updates automatically with selected standard, but fully editable).
        </p>
        <input
          id="grade-passing-mark"
          type="number"
          min="0"
          max="100"
          step="any"
          class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2 text-sm font-semibold text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)]"
          placeholder="e.g. 40"
          data-passing-mark
        />
      </div>

      <!-- Optional Adjustments Accordion (Curve / Bonus / Penalty) -->
      <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4">
        <summary class="cursor-pointer list-none font-semibold text-xs uppercase tracking-wider text-[color:var(--muted)] hover:text-[color:var(--fg)] flex items-center justify-between">
          <span class="flex items-center gap-1.5">
            <Icon name="sparkles" class="w-4 h-4 text-[color:var(--accent)]" />
            <span>Optional Adjustments (Curve / Extra Credit / Penalties)</span>
          </span>
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 pt-2 border-t border-[color:var(--border)]">
          <div>
            <label for="grade-curve" class="block text-xs font-medium text-[color:var(--muted)]">Curve / Extra Credit Points</label>
            <input
              id="grade-curve"
              type="number"
              min="0"
              step="any"
              class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none"
              placeholder="0"
              data-curve-input
            />
            <span class="text-[10px] text-[color:var(--muted)]">Added directly to your obtained marks.</span>
          </div>
          <div>
            <label for="grade-penalty" class="block text-xs font-medium text-[color:var(--muted)]">Late Penalty / Deduction</label>
            <input
              id="grade-penalty"
              type="number"
              min="0"
              step="any"
              class="mt-1 w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-xs font-semibold text-[color:var(--fg)] outline-none"
              placeholder="0"
              data-penalty-input
            />
            <span class="text-[10px] text-[color:var(--muted)]">Subtracted for late submission or infractions.</span>
          </div>
        </div>
      </details>
    </form>

    <!-- Results Panel Column -->
    <div class="flex flex-col justify-between space-y-6 rounded-b-[2rem] xl:rounded-b-none xl:rounded-r-[2rem] border-t xl:border-t-0 xl:border-l border-[color:var(--border)] bg-[color:var(--surface)]/40 p-6 sm:p-8">
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Assessment Output</span>
          <button
            type="button"
            class="cursor-pointer text-xs font-semibold text-[color:var(--accent)] hover:underline flex items-center gap-1"
            data-copy-result-btn
          >
            <Icon name="document" class="w-3.5 h-3.5" />
            <span data-copy-text>Copy Results</span>
          </button>
        </div>

        <!-- Primary Percentage Box -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-center shadow-xs">
          <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--muted)]">Calculated Percentage</p>
          <p class="mt-2 text-5xl font-black tracking-tight text-[color:var(--fg)]" data-res-percent>
            —
          </p>
          <p class="mt-2 text-xs font-medium text-[color:var(--muted)]" data-res-subtext>
            Enter your marks obtained and total marks above
          </p>
        </div>

        <!-- Standard-Specific Conversion Card (Hidden if 'universal' or no standard) -->
        <div class="hidden space-y-3 rounded-2xl border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--accent-soft)] via-[color:var(--surface)] to-transparent p-5 shadow-xs" data-standard-conversion-card>
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[color:var(--accent)]">Academic Scale Conversion</span>
            <span class="text-[10px] rounded-full bg-[color:var(--surface)] px-2 py-0.5 border border-[color:var(--border)] text-[color:var(--fg)] font-medium" data-standard-tag>Standard</span>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center">
              <span class="block text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Letter Grade</span>
              <span class="mt-0.5 block text-2xl font-black text-[color:var(--fg)]" data-res-letter-grade>—</span>
            </div>
            <div class="rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-center" data-gpa-equiv-box>
              <span class="block text-[10px] font-bold uppercase tracking-wider text-[color:var(--muted)]">GPA Equivalent</span>
              <span class="mt-0.5 block text-2xl font-black text-[color:var(--fg)]" data-res-gpa-equiv>—</span>
            </div>
          </div>

          <div class="text-[11px] text-[color:var(--muted)] pt-1" data-standard-attribution>
            <!-- Injected via JS: e.g. "Based on: US Standard 4.0 Scale" -->
          </div>
        </div>

        <!-- Passing Status & Difference Card -->
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-[color:var(--fg)]">Passing Evaluation</span>
            <span class="rounded-full px-2.5 py-0.5 text-xs font-bold border" data-pass-badge>Pending</span>
          </div>
          <p class="text-xs font-medium text-[color:var(--muted)]" data-pass-difference-text>
            Enter marks to compare against the passing cutoff.
          </p>
        </div>

        <!-- Metric Details Breakdown -->
        <div class="space-y-2 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs">
          <div class="flex justify-between">
            <span class="text-[color:var(--muted)]">Marks Earned:</span>
            <span class="font-bold text-[color:var(--fg)]" data-detail-earned>—</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[color:var(--muted)]">Marks Remaining to Max:</span>
            <span class="font-bold text-[color:var(--fg)]" data-detail-remaining>—</span>
          </div>
          <div class="hidden justify-between border-t border-[color:var(--border)] pt-2" data-detail-curve-row>
            <span class="text-[color:var(--muted)]">Curve Bonus Applied:</span>
            <span class="font-bold text-[color:var(--accent)]" data-detail-curve>+0.0 pts</span>
          </div>
          <div class="hidden justify-between border-t border-[color:var(--border)] pt-2" data-detail-penalty-row>
            <span class="text-[color:var(--muted)]">Penalty Deducted:</span>
            <span class="font-bold text-rose-500" data-detail-penalty>-0.0 pts</span>
          </div>
        </div>
      </div>

      <p class="text-[11px] text-center text-[color:var(--muted)] pt-4 border-t border-[color:var(--border)]">
        Formula: <code class="font-mono text-[color:var(--fg)]">Percentage = (Earned Marks ÷ Total Marks) × 100</code>
      </p>
    </div>
  </div>

  <script>
    import { GRADING_STANDARDS, findStandardById, mapPercentageToGrade, validateCustomGradeBands, type GradeBand, type GradingStandard } from '../../data/gradingStandards';

    function initGradeCalculator() {
      const root = document.querySelector('[data-grade-calculator-app]');
      if (!root) return;

      const standardSelect = root.querySelector<HTMLSelectElement>('[data-standard-select]');
      const standardDesc = root.querySelector<HTMLElement>('[data-standard-desc]');
      const standardBadge = root.querySelector<HTMLElement>('[data-standard-status-badge]');
      const customBox = root.querySelector<HTMLElement>('[data-custom-standard-box]');
      const customBandsTbody = root.querySelector<HTMLTableSectionElement>('[data-custom-bands-tbody]');
      const addBandBtn = root.querySelector<HTMLButtonElement>('[data-add-custom-band]');
      const customValMsg = root.querySelector<HTMLElement>('[data-custom-validation-msg]');

      const inMarks = root.querySelector<HTMLInputElement>('[data-marks-obtained]');
      const inTotal = root.querySelector<HTMLInputElement>('[data-total-marks]');
      const inPass = root.querySelector<HTMLInputElement>('[data-passing-mark]');
      const inCurve = root.querySelector<HTMLInputElement>('[data-curve-input]');
      const inPenalty = root.querySelector<HTMLInputElement>('[data-penalty-input]');
      const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset-btn]');
      const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy-result-btn]');

      const resPercent = root.querySelector<HTMLElement>('[data-res-percent]');
      const resSubtext = root.querySelector<HTMLElement>('[data-res-subtext]');
      const convCard = root.querySelector<HTMLElement>('[data-standard-conversion-card]');
      const standardTag = root.querySelector<HTMLElement>('[data-standard-tag]');
      const resLetter = root.querySelector<HTMLElement>('[data-res-letter-grade]');
      const resGpaBox = root.querySelector<HTMLElement>('[data-gpa-equiv-box]');
      const resGpa = root.querySelector<HTMLElement>('[data-res-gpa-equiv]');
      const standardAttr = root.querySelector<HTMLElement>('[data-standard-attribution]');

      const passBadge = root.querySelector<HTMLElement>('[data-pass-badge]');
      const passDiffText = root.querySelector<HTMLElement>('[data-pass-difference-text]');
      const detEarned = root.querySelector<HTMLElement>('[data-detail-earned]');
      const detRemaining = root.querySelector<HTMLElement>('[data-detail-remaining]');
      const curveRow = root.querySelector<HTMLElement>('[data-detail-curve-row]');
      const detCurve = root.querySelector<HTMLElement>('[data-detail-curve]');
      const penaltyRow = root.querySelector<HTMLElement>('[data-detail-penalty-row]');
      const detPenalty = root.querySelector<HTMLElement>('[data-detail-penalty]');

      if (!standardSelect || !inMarks || !inTotal || !inPass) return;

      // Custom standard mutable state
      let customBands: GradeBand[] = [
        { letter: 'A+', gradePoint: 4.0, minPercent: 90, maxPercent: 100, isPassing: true },
        { letter: 'A', gradePoint: 3.75, minPercent: 85, maxPercent: 89.99, isPassing: true },
        { letter: 'A-', gradePoint: 3.5, minPercent: 80, maxPercent: 84.99, isPassing: true },
        { letter: 'B+', gradePoint: 3.25, minPercent: 75, maxPercent: 79.99, isPassing: true },
        { letter: 'B', gradePoint: 3.0, minPercent: 70, maxPercent: 74.99, isPassing: true },
        { letter: 'C', gradePoint: 2.0, minPercent: 60, maxPercent: 69.99, isPassing: true },
        { letter: 'D', gradePoint: 1.0, minPercent: 50, maxPercent: 59.99, isPassing: true },
        { letter: 'F', gradePoint: 0.0, minPercent: 0, maxPercent: 49.99, isPassing: false },
      ];

      function renderCustomBandsTable() {
        if (!customBandsTbody) return;
        customBandsTbody.innerHTML = customBands.map((band, idx) => `
          <tr class="border-b border-[color:var(--border)]">
            <td class="py-1 pr-2">
              <input type="text" value="${band.letter}" data-band-letter="${idx}" class="w-16 rounded border border-[color:var(--border)] bg-[color:var(--bg)] px-1.5 py-0.5 text-xs text-[color:var(--fg)] font-bold" />
            </td>
            <td class="py-1 px-2">
              <input type="number" value="${band.minPercent}" data-band-min="${idx}" class="w-14 rounded border border-[color:var(--border)] bg-[color:var(--bg)] px-1.5 py-0.5 text-xs text-[color:var(--fg)]" />
            </td>
            <td class="py-1 px-2">
              <input type="number" value="${band.maxPercent}" data-band-max="${idx}" class="w-14 rounded border border-[color:var(--border)] bg-[color:var(--bg)] px-1.5 py-0.5 text-xs text-[color:var(--fg)]" />
            </td>
            <td class="py-1 px-2">
              <input type="number" step="0.01" value="${band.gradePoint ?? 0}" data-band-point="${idx}" class="w-14 rounded border border-[color:var(--border)] bg-[color:var(--bg)] px-1.5 py-0.5 text-xs text-[color:var(--fg)]" />
            </td>
            <td class="py-1 px-2 text-center">
              <input type="checkbox" ${band.isPassing ? 'checked' : ''} data-band-pass="${idx}" class="cursor-pointer" />
            </td>
            <td class="py-1 pl-2 text-right">
              <button type="button" class="cursor-pointer text-rose-500 font-bold hover:text-rose-600" data-remove-band="${idx}">×</button>
            </td>
          </tr>
        `).join('');

        // Bind band row inputs
        customBandsTbody.querySelectorAll<HTMLInputElement>('[data-band-letter]').forEach((el) => {
          el.addEventListener('input', (e) => {
            const idx = parseInt((e.target as HTMLElement).dataset.bandLetter || '0', 10);
            if (customBands[idx]) customBands[idx].letter = el.value;
            calculate();
          });
        });
        customBandsTbody.querySelectorAll<HTMLInputElement>('[data-band-min]').forEach((el) => {
          el.addEventListener('input', (e) => {
            const idx = parseInt((e.target as HTMLElement).dataset.bandMin || '0', 10);
            if (customBands[idx]) customBands[idx].minPercent = parseFloat(el.value) || 0;
            calculate();
          });
        });
        customBandsTbody.querySelectorAll<HTMLInputElement>('[data-band-max]').forEach((el) => {
          el.addEventListener('input', (e) => {
            const idx = parseInt((e.target as HTMLElement).dataset.bandMax || '0', 10);
            if (customBands[idx]) customBands[idx].maxPercent = parseFloat(el.value) || 0;
            calculate();
          });
        });
        customBandsTbody.querySelectorAll<HTMLInputElement>('[data-band-point]').forEach((el) => {
          el.addEventListener('input', (e) => {
            const idx = parseInt((e.target as HTMLElement).dataset.bandPoint || '0', 10);
            if (customBands[idx]) customBands[idx].gradePoint = parseFloat(el.value) || 0;
            calculate();
          });
        });
        customBandsTbody.querySelectorAll<HTMLInputElement>('[data-band-pass]').forEach((el) => {
          el.addEventListener('change', (e) => {
            const idx = parseInt((e.target as HTMLElement).dataset.bandPass || '0', 10);
            if (customBands[idx]) customBands[idx].isPassing = el.checked;
            calculate();
          });
        });
        customBandsTbody.querySelectorAll<HTMLButtonElement>('[data-remove-band]').forEach((el) => {
          el.addEventListener('click', (e) => {
            const idx = parseInt((e.target as HTMLElement).dataset.removeBand || '0', 10);
            if (customBands.length > 1) {
              customBands.splice(idx, 1);
              renderCustomBandsTable();
              calculate();
            }
          });
        });
      }

      if (addBandBtn) {
        addBandBtn.addEventListener('click', () => {
          customBands.push({ letter: 'New', gradePoint: 0.0, minPercent: 0, maxPercent: 40, isPassing: false });
          renderCustomBandsTable();
          calculate();
        });
      }

      function getActiveStandard(): GradingStandard {
        const stdId = standardSelect ? standardSelect.value : 'universal';
        if (stdId === 'custom') {
          return {
            id: 'custom',
            name: 'Custom Academic Standard',
            shortName: 'Custom Standard',
            description: 'User-configured custom grading scale.',
            gpaScale: 4.0,
            hasPercentageMapping: true,
            hasGpaMapping: true,
            gradeBands: customBands,
            isCustom: true,
          };
        }
        return findStandardById(stdId);
      }

      function onStandardChange() {
        const standard = getActiveStandard();
        if (standardDesc) standardDesc.textContent = standard.description;
        if (standardBadge) {
          standardBadge.textContent = standard.id === 'universal' ? 'Universal Math' : standard.shortName;
        }

        if (customBox) {
          if (standard.id === 'custom') {
            customBox.classList.remove('hidden');
            renderCustomBandsTable();
          } else {
            customBox.classList.add('hidden');
          }
        }

        // Update default passing mark if not manually altered
        if (standard.passingCutoffPercent !== undefined && inPass) {
          inPass.value = String(standard.passingCutoffPercent);
        }

        calculate();
      }

      function calculate() {
        const standard = getActiveStandard();

        const rawMarks = inMarks.value.trim() !== '' ? parseFloat(inMarks.value) : NaN;
        const rawTotal = inTotal.value.trim() !== '' ? parseFloat(inTotal.value) : NaN;
        const curve = inCurve && inCurve.value.trim() !== '' ? Math.max(0, parseFloat(inCurve.value) || 0) : 0;
        const penalty = inPenalty && inPenalty.value.trim() !== '' ? Math.max(0, parseFloat(inPenalty.value) || 0) : 0;
        const passingCutoff = inPass.value.trim() !== '' ? parseFloat(inPass.value) : 50;

        // Custom validation checking
        if (standard.id === 'custom' && customValMsg) {
          const valRes = validateCustomGradeBands(customBands);
          if (!valRes.isValid) {
            customValMsg.textContent = valRes.errors[0] || 'Invalid band ranges';
            customValMsg.classList.remove('hidden');
          } else {
            customValMsg.classList.add('hidden');
          }
        }

        // Check if values entered
        if (isNaN(rawMarks) || isNaN(rawTotal) || rawTotal <= 0) {
          if (resPercent) resPercent.textContent = '—';
          if (resSubtext) resSubtext.textContent = isNaN(rawTotal) || rawTotal <= 0 && inTotal.value.trim() !== ''
            ? 'Total marks must be greater than 0'
            : 'Enter marks obtained and total marks above';
          if (convCard) convCard.classList.add('hidden');
          if (passBadge) {
            passBadge.className = 'rounded-full px-2.5 py-0.5 text-xs font-bold border border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--muted)]';
            passBadge.textContent = 'Pending';
          }
          if (passDiffText) passDiffText.textContent = 'Enter marks to compare against the passing cutoff.';
          if (detEarned) detEarned.textContent = '—';
          if (detRemaining) detRemaining.textContent = '—';
          if (curveRow) curveRow.classList.add('hidden');
          if (penaltyRow) penaltyRow.classList.add('hidden');
          return;
        }

        const effectiveMarks = Math.max(0, rawMarks + curve - penalty);
        const percent = (effectiveMarks / rawTotal) * 100;
        const marksRemaining = Math.max(0, rawTotal - effectiveMarks);

        // 1. Universal Output Display
        if (resPercent) resPercent.textContent = `${percent.toFixed(2)}%`;
        if (resSubtext) {
          let extraInfo = `${effectiveMarks.toFixed(1)} out of ${rawTotal.toFixed(1)} marks`;
          if (curve > 0 || penalty > 0) {
            extraInfo += ` (Raw: ${rawMarks.toFixed(1)}`;
            if (curve > 0) extraInfo += `, +${curve.toFixed(1)} curve`;
            if (penalty > 0) extraInfo += `, -${penalty.toFixed(1)} penalty`;
            extraInfo += ')';
          }
          resSubtext.textContent = extraInfo;
        }

        // 2. Passing Status Calculation
        const diff = percent - passingCutoff;
        const isPassing = percent >= passingCutoff;
        if (passBadge) {
          if (isPassing) {
            passBadge.className = 'rounded-full px-2.5 py-0.5 text-xs font-bold border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
            passBadge.textContent = 'Passed';
          } else {
            passBadge.className = 'rounded-full px-2.5 py-0.5 text-xs font-bold border border-rose-500/30 bg-rose-500/10 text-rose-600 dark:text-rose-400';
            passBadge.textContent = 'Below Passing';
          }
        }
        if (passDiffText) {
          const ptsDiff = Math.abs(diff).toFixed(2);
          if (isPassing) {
            passDiffText.textContent = `+${ptsDiff} percentage points above the ${passingCutoff.toFixed(1)}% passing cutoff.`;
          } else {
            passDiffText.textContent = `-${ptsDiff} percentage points below the ${passingCutoff.toFixed(1)}% passing cutoff.`;
          }
        }

        // 3. Detail breakdown
        if (detEarned) detEarned.textContent = `${effectiveMarks.toFixed(2)} pts`;
        if (detRemaining) detRemaining.textContent = `${marksRemaining.toFixed(2)} pts`;

        // Curve row: Only show if curve > 0
        if (curveRow && detCurve) {
          if (curve > 0) {
            curveRow.classList.remove('hidden');
            curveRow.classList.add('flex');
            detCurve.textContent = `+${curve.toFixed(2)} pts`;
          } else {
            curveRow.classList.add('hidden');
            curveRow.classList.remove('flex');
          }
        }

        // Penalty row: Only show if penalty > 0
        if (penaltyRow && detPenalty) {
          if (penalty > 0) {
            penaltyRow.classList.remove('hidden');
            penaltyRow.classList.add('flex');
            detPenalty.textContent = `-${penalty.toFixed(2)} pts`;
          } else {
            penaltyRow.classList.add('hidden');
            penaltyRow.classList.remove('flex');
          }
        }

        // 4. Standard-Specific Conversion
        if (standard.id === 'universal' || !standard.hasPercentageMapping) {
          // Universal: hide conversion card
          if (convCard) convCard.classList.add('hidden');
        } else {
          // Standard selected: evaluate letter grade & GPA equivalent
          if (convCard) convCard.classList.remove('hidden');
          if (standardTag) standardTag.textContent = standard.shortName;

          const matchedBand = mapPercentageToGrade(percent, standard);
          if (resLetter) {
            resLetter.textContent = matchedBand ? matchedBand.letter : '—';
          }

          if (resGpaBox && resGpa) {
            if (standard.gpaScale !== undefined && matchedBand && matchedBand.gradePoint !== undefined) {
              resGpaBox.classList.remove('hidden');
              resGpa.textContent = `${matchedBand.gradePoint.toFixed(2)} / ${standard.gpaScale.toFixed(2)}`;
            } else {
              resGpaBox.classList.add('hidden');
            }
          }

          if (standardAttr) {
            standardAttr.innerHTML = `Based on: <strong class="text-[color:var(--fg)]">${standard.name}</strong>${standard.officialSource ? ` (${standard.officialSource})` : ''}`;
          }
        }
      }

      // Event listeners
      standardSelect.addEventListener('change', onStandardChange);
      inMarks.addEventListener('input', calculate);
      inTotal.addEventListener('input', calculate);
      inPass.addEventListener('input', calculate);
      if (inCurve) inCurve.addEventListener('input', calculate);
      if (inPenalty) inPenalty.addEventListener('input', calculate);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          inMarks.value = '';
          inTotal.value = '';
          if (inCurve) inCurve.value = '';
          if (inPenalty) inPenalty.value = '';
          standardSelect.value = 'universal';
          onStandardChange();
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const standard = getActiveStandard();
          const percentStr = resPercent ? resPercent.textContent : '';
          const earned = inMarks.value;
          const total = inTotal.value;
          let summary = `Grade Assessment: ${percentStr} (${earned} / ${total} marks)`;
          if (standard.id !== 'universal') {
            const letter = resLetter ? resLetter.textContent : '';
            const gpa = resGpa ? resGpa.textContent : '';
            summary += `\nGrade: ${letter} ${gpa ? `(${gpa})` : ''}\nStandard: ${standard.name}`;
          }
          try {
            await navigator.clipboard.writeText(summary);
            const span = root.querySelector<HTMLElement>('[data-copy-text]');
            if (span) {
              const orig = span.textContent;
              span.textContent = 'Copied!';
              setTimeout(() => { span.textContent = orig; }, 2000);
            }
          } catch {}
        });
      }

      // Initial run
      onStandardChange();
    }

    initGradeCalculator();
  </script>
</section>
