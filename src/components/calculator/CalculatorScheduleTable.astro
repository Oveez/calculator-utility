---
import type { CalculatorTableConfig } from '../../types/calculator';

interface Props {
  table?: CalculatorTableConfig;
  id?: string;
}

const { table, id = 'calc-table' } = Astro.props as Props;
---

<div class="space-y-4 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-6 shadow-sm" data-calculator-table-root id={id}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h3 class="text-lg font-bold text-[color:var(--fg)]" data-table-title>
        {table?.title ?? 'Schedule & Breakdown'}
      </h3>
      <p class="text-xs text-[color:var(--muted)]">Scroll horizontally to view all columns on smaller screens.</p>
    </div>

    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--fg)] shadow-xs transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]"
      data-export-table-csv
    >
      <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      Export CSV
    </button>
  </div>

  <!-- Responsive Table Container with Horizontal Scroll Indicator -->
  <div class="relative overflow-x-auto rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] shadow-inner">
    <table class="w-full text-left text-xs text-[color:var(--fg)]" data-calculator-table>
      <thead class="sticky top-0 border-b border-[color:var(--border)] bg-[color:var(--surface)] text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">
        <tr data-table-header-row>
          {table?.headers ? (
            table.headers.map((header) => (
              <th scope="col" class="px-4 py-3 whitespace-nowrap">{header}</th>
            ))
          ) : (
            <th scope="col" class="px-4 py-3">Schedule Data</th>
          )}
        </tr>
      </thead>
      <tbody class="divide-y divide-[color:var(--border)] font-mono" data-table-body>
        {table?.rows ? (
          table.rows.slice(0, table.maxInitialRows ?? 10).map((row, rowIdx) => (
            <tr class="transition-colors hover:bg-[color:var(--surface)]/60">
              {row.map((cell) => (
                <td class="px-4 py-2.5 whitespace-nowrap">{cell}</td>
              ))}
            </tr>
          ))
        ) : (
          <tr>
            <td class="px-4 py-6 text-center text-[color:var(--muted)] font-sans" colspan="10">
              Schedule updates in real time with calculation
            </td>
          </tr>
        )}
      </tbody>
      <tfoot class="border-t-2 border-[color:var(--border)] bg-[color:var(--surface)] font-bold font-mono text-[color:var(--fg)]" data-table-foot>
        <!-- Dynamic summary row -->
      </tfoot>
    </table>
  </div>

  <!-- Pagination / Show All Toggle -->
  <div class="flex items-center justify-between pt-1 text-xs text-[color:var(--muted)]">
    <span data-table-rows-count>Showing initial rows</span>
    <button
      type="button"
      class="font-semibold text-[color:var(--accent)] hover:underline cursor-pointer"
      data-toggle-full-table
    >
      Show All Rows
    </button>
  </div>
</div>
