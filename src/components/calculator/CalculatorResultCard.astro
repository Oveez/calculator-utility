---
interface Props {
  initialResult: string;
  category: string;
  inputsCount: number;
}

const { initialResult, category, inputsCount } = Astro.props as Props;
---

<aside class="space-y-6" data-calculator-result-card>
  <div class="space-y-6">
    <!-- Primary Result Card -->
    <div>
      <div class="flex items-center justify-between gap-2">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[color:var(--accent)]" data-primary-label>Result</p>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-xs font-semibold text-[color:var(--fg)] shadow-none transition hover:border-[color:var(--border-strong)] hover:bg-[color:var(--surface-strong)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[color:var(--accent)] cursor-pointer"
          data-copy-result
          aria-label="Copy result to clipboard"
        >
          <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span data-copy-text>Copy</span>
        </button>
      </div>

      <div class="mt-3 rounded-none border border-[color:var(--border-strong)] bg-[color:var(--surface)] p-5 shadow-none transition-all relative overflow-hidden" data-result-box>
        <p class="text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]" data-primary-subtext>Calculated Output</p>
        <output
          class="mt-2 block break-words text-3xl sm:text-4xl font-black tracking-tight text-[color:var(--accent)] transition-all"
          aria-live="polite"
          data-calculator-result
        >
          {initialResult}
        </output>
      </div>
    </div>

    <!-- Secondary Metrics Grid (Populated dynamically when structured result returned) -->
    <div class="hidden space-y-2" data-secondary-results-container>
      <p class="text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Key Breakdown</p>
      <div class="grid grid-cols-2 gap-2.5" data-secondary-results-grid>
        <!-- Populated dynamically via JS -->
      </div>
    </div>

    <!-- Visual Breakdown Progress Meter (Populated dynamically for split/composition results) -->
    <div class="hidden space-y-2.5 rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5" data-breakdown-container>
      <div class="flex items-center justify-between text-xs font-semibold text-[color:var(--fg)]">
        <span>Composition Breakdown</span>
        <span class="text-[color:var(--muted)]" data-breakdown-summary></span>
      </div>
      <!-- Multi-segment visual bar -->
      <div class="flex h-3 w-full overflow-hidden rounded-none bg-[color:var(--surface-strong)] border border-[color:var(--border)]" data-breakdown-bar>
        <!-- Segments inserted dynamically -->
      </div>
      <!-- Legend -->
      <div class="grid grid-cols-2 gap-2 pt-1 text-xs" data-breakdown-legend>
        <!-- Legend items inserted dynamically -->
      </div>
    </div>

    <!-- Warnings / Smart Insights Callout -->
    <div class="hidden rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-3 text-xs text-[color:var(--fg)]" data-warnings-container>
      <div class="flex items-start gap-2">
        <svg class="h-4 w-4 shrink-0 mt-0.5 text-[color:var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="space-y-1" data-warnings-list></div>
      </div>
    </div>
  </div>
</aside>
