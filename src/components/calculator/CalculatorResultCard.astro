---
interface Props {
  initialResult: string;
  category: string;
  inputsCount: number;
}

const { initialResult, category, inputsCount } = Astro.props as Props;
---

<aside class="flex flex-col justify-between border-t border-[color:var(--border)] bg-[color:var(--surface)] p-6 sm:p-8 xl:border-l xl:border-t-0" data-calculator-result-card>
  <div class="space-y-6">
    <!-- Primary Result Card -->
    <div>
      <div class="flex items-center justify-between gap-2">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[color:var(--accent)]" data-primary-label>Result</p>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-xs font-semibold text-[color:var(--fg)] shadow-xs transition hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:bg-[color:var(--surface-strong)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] cursor-pointer"
          data-copy-result
          aria-label="Copy result to clipboard"
        >
          <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span data-copy-text>Copy</span>
        </button>
      </div>

      <div class="mt-3 rounded-[1.75rem] border border-[color:var(--accent)]/30 bg-gradient-to-br from-[color:var(--surface)] to-[color:var(--surface-strong)] p-6 shadow-sm transition-all relative overflow-hidden backdrop-blur-xs" data-result-box>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[color:var(--accent)]" data-primary-subtext>Calculated Output</p>
        <output
          class="mt-2 block break-words text-3xl font-extrabold tracking-tight text-[color:var(--fg)] sm:text-4xl transition-all"
          aria-live="polite"
          data-calculator-result
        >
          {initialResult}
        </output>
      </div>
    </div>

    <!-- Secondary Metrics Grid (Populated dynamically when structured result returned) -->
    <div class="hidden space-y-2" data-secondary-results-container>
      <p class="text-[11px] font-bold uppercase tracking-wider text-[color:var(--muted)]">Key Breakdown</p>
      <div class="grid grid-cols-2 gap-2.5" data-secondary-results-grid>
        <!-- Populated dynamically via JS -->
      </div>
    </div>

    <!-- Visual Breakdown Progress Meter (Populated dynamically for split/composition results) -->
    <div class="hidden space-y-2.5 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4" data-breakdown-container>
      <div class="flex items-center justify-between text-xs font-semibold text-[color:var(--fg)]">
        <span>Composition Breakdown</span>
        <span class="text-[color:var(--muted)]" data-breakdown-summary></span>
      </div>
      <!-- Multi-segment visual bar -->
      <div class="flex h-3 w-full overflow-hidden rounded-full bg-[color:var(--surface-strong)] border border-[color:var(--border)]" data-breakdown-bar>
        <!-- Segments inserted dynamically -->
      </div>
      <!-- Legend -->
      <div class="grid grid-cols-2 gap-2 pt-1 text-xs" data-breakdown-legend>
        <!-- Legend items inserted dynamically -->
      </div>
    </div>

    <!-- Warnings / Smart Insights Callout -->
    <div class="hidden rounded-2xl border border-amber-500/30 bg-amber-500/10 p-3.5 text-xs text-amber-700 dark:text-amber-300" data-warnings-container>
      <div class="flex items-start gap-2">
        <svg class="h-4 w-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="space-y-1" data-warnings-list></div>
      </div>
    </div>

    <!-- Tool Metadata / Summary -->
    <dl class="grid gap-2.5 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-4 text-xs text-[color:var(--muted)]">
      <div class="flex items-center justify-between gap-4">
        <dt class="font-medium text-[color:var(--fg)]">Category</dt>
        <dd class="rounded-full bg-[color:var(--surface)] px-2.5 py-0.5 font-semibold text-[color:var(--accent)] border border-[color:var(--border)]">
          {category}
        </dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="font-medium text-[color:var(--fg)]">Parameters</dt>
        <dd class="font-semibold text-[color:var(--fg)]">{inputsCount} active</dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="font-medium text-[color:var(--fg)]">Execution</dt>
        <dd class="font-semibold text-[color:var(--fg)]">Client-side / Instant</dd>
      </div>
    </dl>
  </div>

  <div class="mt-6 rounded-xl border border-dashed border-[color:var(--border)] p-3.5 text-[11px] text-[color:var(--muted)]">
    <strong>Security &amp; Privacy:</strong> All calculations run locally in your browser with zero server data storage.
  </div>
</aside>
