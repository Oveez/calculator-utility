---
import type { CalculatorInput, CalculatorInputTier } from '../../types/calculator';

interface Props {
  inputs: CalculatorInput[];
  initialValues: Record<string, number | string>;
}

const { inputs, initialValues } = Astro.props as Props;

// Partition inputs by tier
const basicInputs = inputs.filter((i) => !i.tier || i.tier === 'basic');
const advancedInputs = inputs.filter((i) => i.tier === 'advanced');
const extendedInputs = inputs.filter((i) => i.tier === 'extended');

function getColSpanClass(input: CalculatorInput, totalInTier: number): string {
  if (input.colSpan === 'full') return 'sm:col-span-2';
  if (input.colSpan === 'half') return 'sm:col-span-1';
  if (input.type === 'textarea') return 'sm:col-span-2';
  if (input.type === 'range') return 'sm:col-span-2';
  // If only 1 input in tier or explicit full
  if (totalInTier === 1) return 'sm:col-span-2';
  // Default to 1 col in 2-col grid
  return 'sm:col-span-1';
}
---

<div class="space-y-6" data-calculator-input-grid>
  <!-- Basic / Essential Parameters (Always Visible) -->
  <div class="grid gap-3.5 sm:grid-cols-2">
    {basicInputs.map((input) => (
      <div class:list={[
        'flex flex-col justify-between rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-3.5 sm:p-4 transition hover:border-[color:var(--glass-border-strong)] focus-within:border-[color:var(--accent)] focus-within:shadow-[0_0_12px_var(--accent-glow)]',
        getColSpanClass(input, basicInputs.length)
      ]}>
        <div class="mb-2 flex items-center justify-between gap-2">
          <label for={`calc-input-${input.id}`} class="text-xs font-semibold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-1.5">
            <span>{input.label}</span>
            {input.required && <span class="text-rose-500 font-bold" title="Required">*</span>}
          </label>
          <div class="flex items-center gap-2">
            {input.type === 'range' && (
              <span class="rounded-md bg-[color:var(--accent-soft)] px-2 py-0.5 text-xs font-mono font-bold text-[color:var(--accent)]" data-range-val={input.id}>
                {initialValues[input.id]}
              </span>
            )}
            {input.unit && (
              <span class="rounded bg-[color:var(--surface-strong)] px-1.5 py-0.5 text-[11px] font-medium text-[color:var(--muted)] border border-[color:var(--border)]">
                {input.unit}
              </span>
            )}
          </div>
        </div>

        {input.helpText && (
          <p class="mb-2 text-[11px] leading-tight text-[color:var(--muted)]">{input.helpText}</p>
        )}

        <!-- Input controls with prefix / suffix support -->
        <div class="relative flex items-center">
          {input.prefix && (
            <span class="pointer-events-none absolute left-3 text-sm font-semibold text-[color:var(--muted)]">
              {input.prefix}
            </span>
          )}

          {input.type === 'textarea' ? (
            <textarea
              id={`calc-input-${input.id}`}
              class="w-full resize-y rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-sm text-[color:var(--fg)] shadow-xs outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
              name={input.id}
              rows={input.rows ?? 3}
              placeholder={input.placeholder ?? input.label}
              aria-label={input.label}
            >{initialValues[input.id]}</textarea>
          ) : input.type === 'select' && input.options ? (
            <select
              id={`calc-input-${input.id}`}
              class="w-full cursor-pointer appearance-none rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-sm font-medium text-[color:var(--fg)] shadow-xs outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
              name={input.id}
              aria-label={input.label}
            >
              {input.options.map((option) => (
                <option value={option.value} selected={String(initialValues[input.id]) === option.value}>
                  {option.label}
                </option>
              ))}
            </select>
          ) : input.type === 'range' ? (
            <input
              id={`calc-input-${input.id}`}
              class="w-full accent-[color:var(--accent)] cursor-pointer py-1.5"
              type="range"
              name={input.id}
              min={input.min ?? 0}
              max={input.max ?? 100}
              step={input.step ?? 1}
              value={initialValues[input.id]}
              aria-label={input.label} />
          ) : (
            <input
              id={`calc-input-${input.id}`}
              class:list={[
                'w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] py-2.5 text-sm font-semibold text-[color:var(--fg)] shadow-xs outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]',
                input.prefix ? 'pl-8' : 'pl-3.5',
                input.suffix ? 'pr-12' : 'pr-3.5',
              ]}
              type={input.type === 'date' ? 'date' : input.type === 'datetime-local' ? 'datetime-local' : input.type === 'number' ? 'number' : 'text'}
              name={input.id}
              min={input.type === 'text' || input.type === 'date' || input.type === 'datetime-local' ? undefined : input.min}
              max={input.type === 'text' || input.type === 'date' || input.type === 'datetime-local' ? undefined : input.max}
              step={input.type === 'text' || input.type === 'date' || input.type === 'datetime-local' ? undefined : input.step ?? 'any'}
              placeholder={input.placeholder ?? (input.defaultValue !== undefined && input.defaultValue !== '' ? `e.g. ${input.defaultValue}` : input.label)}
              aria-label={input.label} />
          )}

          {input.suffix && (
            <span class="pointer-events-none absolute right-3 text-xs font-semibold text-[color:var(--muted)]">
              {input.suffix}
            </span>
          )}
        </div>

        <p class="hidden mt-1.5 text-[11px] font-medium text-rose-500" data-input-error={input.id}>
          {input.errorMessage ?? 'Invalid input'}
        </p>
      </div>
    ))}
  </div>

  <!-- Advanced Options (Collapsible Progressive Disclosure) -->
  {advancedInputs.length > 0 && (
    <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] transition-all">
      <summary class="flex cursor-pointer select-none items-center justify-between px-5 py-3.5 text-xs font-bold uppercase tracking-wider text-[color:var(--fg)] hover:text-[color:var(--accent)]">
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-[color:var(--accent)] transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
          Advanced Options
        </span>
        <span class="rounded-full bg-[color:var(--surface-strong)] px-2 py-0.5 text-[10px] font-medium text-[color:var(--muted)] border border-[color:var(--border)]">
          {advancedInputs.length} optional {advancedInputs.length === 1 ? 'parameter' : 'parameters'}
        </span>
      </summary>
      <div class="grid gap-3.5 border-t border-[color:var(--border)] p-4 sm:grid-cols-2">
        {advancedInputs.map((input) => (
          <div class:list={[
            'flex flex-col justify-between rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5 transition hover:border-[color:var(--glass-border-strong)] focus-within:border-[color:var(--accent)] focus-within:shadow-[0_0_12px_var(--accent-glow)]',
            getColSpanClass(input, advancedInputs.length)
          ]}>
            <div class="mb-2 flex items-center justify-between gap-2">
              <label for={`calc-input-${input.id}`} class="text-xs font-semibold uppercase tracking-wider text-[color:var(--fg)]">
                {input.label}
              </label>
              {input.unit && (
                <span class="rounded bg-[color:var(--surface)] px-1.5 py-0.5 text-[11px] font-medium text-[color:var(--muted)] border border-[color:var(--border)]">
                  {input.unit}
                </span>
              )}
            </div>

            {input.helpText && (
              <p class="mb-2 text-[11px] leading-tight text-[color:var(--muted)]">{input.helpText}</p>
            )}

            <div class="relative flex items-center">
              {input.prefix && (
                <span class="pointer-events-none absolute left-3 text-sm font-semibold text-[color:var(--muted)]">
                  {input.prefix}
                </span>
              )}

              {input.type === 'select' && input.options ? (
                <select
                  id={`calc-input-${input.id}`}
                  class="w-full cursor-pointer appearance-none rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3.5 py-2 text-sm font-medium text-[color:var(--fg)] shadow-xs outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]"
                  name={input.id}
                  aria-label={input.label}
                >
                  {input.options.map((option) => (
                    <option value={option.value} selected={String(initialValues[input.id]) === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              ) : (
                <input
                  id={`calc-input-${input.id}`}
                  class:list={[
                    'w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] py-2 text-sm font-semibold text-[color:var(--fg)] shadow-xs outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent-soft)]',
                    input.prefix ? 'pl-8' : 'pl-3.5',
                    input.suffix ? 'pr-12' : 'pr-3.5',
                  ]}
                  type={input.type === 'date' ? 'date' : input.type === 'datetime-local' ? 'datetime-local' : input.type === 'number' ? 'number' : 'text'}
                  name={input.id}
                  min={input.min}
                  max={input.max}
                  step={input.step ?? 'any'}
                  placeholder={input.placeholder ?? (input.defaultValue !== undefined && input.defaultValue !== '' ? `e.g. ${input.defaultValue}` : input.label)}
                  aria-label={input.label} />
              )}

              {input.suffix && (
                <span class="pointer-events-none absolute right-3 text-xs font-semibold text-[color:var(--muted)]">
                  {input.suffix}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </details>
  )}

  <!-- Extended Options (Optional Niche Settings) -->
  {extendedInputs.length > 0 && (
    <details class="group rounded-2xl border border-dashed border-[color:var(--border)] bg-[color:var(--surface)] transition-all">
      <summary class="flex cursor-pointer select-none items-center justify-between px-5 py-3 text-xs font-bold uppercase tracking-wider text-[color:var(--muted)] hover:text-[color:var(--fg)]">
        <span class="flex items-center gap-2">
          <svg class="h-3.5 w-3.5 text-[color:var(--muted)] transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
          Extended Assumptions & Adjustments
        </span>
        <span class="text-[10px] font-medium text-[color:var(--muted)]">
          {extendedInputs.length} additional
        </span>
      </summary>
      <div class="grid gap-3.5 border-t border-[color:var(--border)] p-4 sm:grid-cols-2">
        {extendedInputs.map((input) => (
          <div class:list={[
            'rounded-xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3.5',
            getColSpanClass(input, extendedInputs.length)
          ]}>
            <div class="mb-1.5 flex items-center justify-between">
              <label for={`calc-input-${input.id}`} class="text-xs font-semibold uppercase tracking-wider text-[color:var(--fg)]">
                {input.label}
              </label>
              {input.unit && <span class="text-[10px] text-[color:var(--muted)]">{input.unit}</span>}
            </div>
            <input
              id={`calc-input-${input.id}`}
              class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-2 text-sm font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              type={input.type === 'number' ? 'number' : 'text'}
              name={input.id}
              min={input.min}
              max={input.max}
              step={input.step ?? 'any'}
              placeholder={input.placeholder ?? (input.defaultValue !== undefined && input.defaultValue !== '' ? `e.g. ${input.defaultValue}` : input.label)} />
          </div>
        ))}
      </div>
    </details>
  )}
</div>
