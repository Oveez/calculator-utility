---
import Icon from '../Icon.astro';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-4 text-xs leading-relaxed text-[color:var(--muted)] ${className}`}>
  <div class="flex items-start gap-2.5">
    <div class="mt-0.5 shrink-0 text-[color:var(--fg)]">
      <Icon name="info" class="w-4 h-4" />
    </div>
    <p>
      <strong>Disclaimer:</strong> This calculator provides an estimate based on official tax brackets and assumptions. It is for informational purposes only and does not constitute tax, legal, or financial advice. Actual tax liability may vary depending on personal circumstances, regional rules, and deductions.
    </p>
  </div>
</div>
