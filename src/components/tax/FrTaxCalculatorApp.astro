---
import type { CountryTaxProfile } from '../../data/tax/types';
import { calculateFrTax } from '../../utils/tax/fr-engine';
import { formatCurrency, formatPercent } from '../../utils/tax/formatters';
import TaxDisclaimer from './TaxDisclaimer.astro';
import CalculatorParameterGuide from '../calculator/CalculatorParameterGuide.astro';
import Icon from '../Icon.astro';
import TaxYearSelector from './shared/TaxYearSelector.astro';
import TaxAllocationBar from './shared/TaxAllocationBar.astro';
import PaycheckFrequencyTable from './shared/PaycheckFrequencyTable.astro';
import TaxBreakdownTable from './shared/TaxBreakdownTable.astro';
import TaxBracketsTable from './shared/TaxBracketsTable.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';

interface Props {
  profile: CountryTaxProfile;
  initialIncome?: number;
}

const { profile, initialIncome = 0 } = Astro.props;

// Initial server-rendered baseline calculations for France
const initialResult = calculateFrTax({
  primaryW2Income: initialIncome,
  taxYear: profile.defaultTaxYear,
  filingStatus: 'single',
  numChildrenUnder17: 0,
}, profile);

const defaultYearData = profile.years[profile.defaultTaxYear];

const taxParameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'salaireBrut',
    name: 'Salaire Brut Annuel (Gross Salary)',
    description: 'Total annual gross compensation agreed before employee social security deductions or prélèvement à la source (income withholding tax).',
    whyItMatters: 'Baseline earnings used by URSSAF and the DGFiP to compute statutory deductions.',
    typicalRange: 'Any positive earnings',
    unit: 'EUR (€)',
  },
  {
    id: 'quotientFamilial',
    name: 'Quotient Familial & Parts Fiscales',
    description: 'The French family quotient splits household taxable income by parts (1 part for single, 2 for married/Pacs, +0.5 for 1st & 2nd child, +1.0 for each subsequent child).',
    whyItMatters: 'Lowers progressive tax exposure by dividing income before applying progressive tax brackets.',
    typicalRange: '1.0 to 4.0+ parts',
    unit: 'Parts',
  },
  {
    id: 'fraisPros',
    name: '10% Standard Deduction for Professional Expenses',
    description: 'Automatic 10% deduction on earned salary for work-related expenses (capped at €14,171), unless claiming actual expenses (frais réels).',
    whyItMatters: 'Reduces taxable earned income before the progressive tax scale is evaluated.',
    typicalRange: '10% (up to €14,171)',
    unit: '%',
  },
  {
    id: 'csgCrds',
    name: 'CSG & CRDS (9.7%)',
    description: 'General social contribution (CSG: 9.2%) and debt repayment (CRDS: 0.5%) applied to 98.25% of gross employment income.',
    whyItMatters: 'Funds the French social security and healthcare system.',
    typicalRange: '9.7% on 98.25% of gross',
    unit: '%',
  },
  {
    id: 'retraite',
    name: 'Statutory Pension Contributions (Retraite)',
    description: 'Employee basic pension (7.3% up to the PASS ceiling of €48,060) and complementary Agirc-Arrco pension (~5.0%).',
    whyItMatters: 'Entitles workers to standard French state pension and complementary retirement annuities.',
    typicalRange: '~12.3% employee share',
    unit: '%',
  },
  {
    id: 'pas',
    name: 'Prélèvement à la Source (PAS)',
    description: 'Pay-as-you-earn income withholding tax deducted monthly by employers based on your DGFiP tax rate.',
    whyItMatters: 'Ensures income tax is paid contemporaneously with earnings.',
    typicalRange: '0% to 45%',
    unit: '%',
  },
];
---

<div
  class="relative overflow-hidden rounded-[2.5rem] border border-[color:var(--border)] bg-[color:var(--surface-strong)] p-5 shadow-[var(--shadow)] sm:p-8 lg:p-10"
  data-tax-app
  data-country-id="fr"
  data-profile-json={JSON.stringify(profile)}
>
  <!-- Top Bar: Country Info & Mode Switcher -->
  <div class="flex flex-col gap-4 border-b border-[color:var(--border)] pb-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <span class="text-3xl sm:text-4xl select-none">{profile.flagEmoji}</span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)] sm:text-2xl">
            France Income Tax &amp; Salary Calculator (Brut en Net)
          </h2>
          <span class="inline-flex items-center rounded-full bg-cyan-500/10 px-2.5 py-0.5 text-xs font-semibold text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
            Official 2026 DGFiP Barème
          </span>
        </div>
        <p class="text-xs text-[color:var(--muted)]">
          Source: <a href={defaultYearData.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-[color:var(--accent)] hover:underline">{defaultYearData.officialSourceName}</a> • Verified {defaultYearData.lastVerifiedDate}
        </p>
      </div>
    </div>

    <!-- App Tabs & Tax Year -->
    <div class="flex flex-wrap items-center gap-2">
      <TaxYearSelector profile={profile} id="fr-tax-year-select" />

      <!-- Engine View Toggle -->
      <div class="flex items-center rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-1 text-xs font-semibold overflow-x-auto no-scrollbar max-w-full shrink-0">
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-xl px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active"
          data-engine-tab="advanced"
        >
          <Icon name="bolt" class="w-3.5 h-3.5" />
          <span>Detailed DGFiP Mode</span>
        </button>
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-xl px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5"
          data-engine-tab="quick"
        >
          <Icon name="calculator" class="w-3.5 h-3.5" />
          <span>Quick Salary</span>
        </button>
      </div>
    </div>
  </div>

  <!-- HERO DYNAMIC TAKE-HOME BANNER -->
  <div class="mt-6 rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 shadow-sm">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Salaire Net Après Impôt (Take-Home)</span>
          <span
            data-hero-badge
            class="inline-flex items-center gap-1 rounded-full bg-cyan-500/10 px-2.5 py-0.5 text-xs font-bold text-cyan-600 dark:text-cyan-400 border border-cyan-500/20"
          >
            Net à Payer
          </span>
        </div>
        <p class="mt-1 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl text-[color:var(--fg)]" data-hero-amount>
          {formatCurrency(initialResult.netAnnualTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
        </p>
        <p class="mt-1 text-xs text-[color:var(--muted)]" data-hero-subtext>
          {formatCurrency(initialResult.netMonthlyTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}/mois · {formatCurrency(initialResult.netWeeklyTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}/semaine
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 border-t border-[color:var(--border)]/60 pt-3 md:border-t-0 md:pt-0">
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Impôt sur le Revenu (IR)</p>
          <p class="text-base font-extrabold text-blue-500" data-hero-incometax>
            {formatCurrency(initialResult.regularIncomeTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Prélèvement à la source</p>
        </div>
        <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Cotisations Sociales</p>
          <p class="text-base font-extrabold text-amber-500" data-hero-social>
            {formatCurrency(initialResult.totalFicaTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">CSG/CRDS + Retraite</p>
        </div>
        <div class="col-span-2 sm:col-span-1 rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 flex flex-col justify-between">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Action</p>
          <button
            type="button"
            data-copy-summary-btn
            class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-[color:var(--surface)] px-2.5 py-1.5 text-xs font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
          >
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copier le Rapport Fiscal</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Reusable Income Allocation Bar -->
    <TaxAllocationBar />
  </div>

  <!-- CALCULATOR MAIN BODY -->
  <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- LEFT COLUMN: INPUT FORMS -->
    <div class="space-y-6">

      <!-- SECTION 1: Salaire Brut & Situation Familiale -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4 shadow-sm">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
          <Icon name="user" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>1. Salaire Brut &amp; Quotient Familial</span>
        </h3>

        <div class="space-y-4">
          <!-- Gross Salary -->
          <div>
            <div class="flex justify-between items-center text-xs">
              <label for="fr-gross-salary" class="font-bold text-[color:var(--fg)]">
                Salaire Annuel Brut (€ EUR)
              </label>
              <span class="text-[color:var(--muted)] font-mono">Brut Contractuel</span>
            </div>
            <div class="relative mt-1.5">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-bold text-[color:var(--muted)]">
                €
              </span>
              <input
                id="fr-gross-salary"
                type="number"
                min="0"
                step="1000"
                placeholder="e.g. 45,000"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-3 pl-8 pr-4 text-base font-black text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent)]/20"
                data-fr-salary
              />
            </div>
            <p class="mt-1 text-[11px] text-[color:var(--muted)]">
              Rémunération brute annuelle avant déduction des cotisations salariales.
            </p>
          </div>

          <!-- Situation Familiale (Filing Status) -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="fr-marital-status" class="block text-xs font-bold text-[color:var(--fg)]">
                Situation Matrimoniale
              </label>
              <select
                id="fr-marital-status"
                data-fr-status
                class="mt-1.5 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-2.5 px-3 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)] cursor-pointer"
              >
                <option value="single" selected>Célibataire (1 part)</option>
                <option value="married_joint">Marié(e) ou Pacsé(e) (2 parts)</option>
              </select>
            </div>

            <div>
              <label for="fr-children-count" class="block text-xs font-bold text-[color:var(--fg)]">
                Enfants à charge
              </label>
              <select
                id="fr-children-count"
                data-fr-children
                class="mt-1.5 w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-2.5 px-3 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)] cursor-pointer"
              >
                <option value="0" selected>0 enfant</option>
                <option value="1">1 enfant (+0.5 part)</option>
                <option value="2">2 enfants (+1.0 part)</option>
                <option value="3">3 enfants (+2.0 parts)</option>
                <option value="4">4 enfants (+3.0 parts)</option>
              </select>
            </div>
          </div>

          <!-- Calculated Parts Badge -->
          <div class="rounded-2xl border border-blue-500/20 bg-blue-500/5 p-3 flex justify-between items-center text-xs">
            <span class="text-[color:var(--muted)]">Nombre de parts de quotient familial :</span>
            <span class="font-extrabold text-blue-600 dark:text-blue-400" data-fr-parts-display>1.0 part</span>
          </div>
        </div>
      </div>

      <!-- SECTION 2: Déduction Professionnelle & Frais (Advanced Only) -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-4 shadow-sm" data-advanced-section>
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
            <Icon name="briefcase" class="w-4 h-4 text-emerald-500" />
            <span>2. Frais Professionnels (10% ou Réels)</span>
          </h3>
          <span class="text-[10px] font-bold text-emerald-600 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
            Abattement 10%
          </span>
        </div>

        <div class="space-y-4">
          <div>
            <div class="flex justify-between items-center text-xs">
              <label for="fr-custom-deductions" class="font-bold text-[color:var(--fg)]">
                Frais Réels Déductibles (€ EUR)
              </label>
              <span class="text-[color:var(--muted)]">Optionnel si supérieur à 10%</span>
            </div>
            <div class="relative mt-1.5">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-bold text-[color:var(--muted)]">
                €
              </span>
              <input
                id="fr-custom-deductions"
                type="number"
                min="0"
                step="500"
                placeholder="0"
                class="w-full rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] py-2.5 pl-8 pr-4 text-sm font-bold text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)]"
                data-fr-deductions
              />
            </div>
            <p class="mt-1 text-[11px] text-[color:var(--muted)]">
              Par défaut, l'abattement forfaitaire de 10% s'applique automatiquement (plafonné à 14 171 €).
            </p>
          </div>

          <!-- Social Security Rates Note -->
          <div class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--bg)] p-3 text-xs space-y-1">
            <p class="font-bold text-[color:var(--fg)]">Cotisations salariales obligatoires (2026) :</p>
            <div class="grid grid-cols-2 gap-2 text-[11px] text-[color:var(--muted)]">
              <div>CSG / CRDS: <strong class="text-[color:var(--fg)]">9.7%</strong> (base 98.25%)</div>
              <div>Retraite de Base: <strong class="text-[color:var(--fg)]">7.3%</strong> (PASS 48 060 €)</div>
              <div>Retraite Complémentaire: <strong class="text-[color:var(--fg)]">5.0%</strong> (Agirc-Arrco)</div>
              <div>Total Cotisations: <strong class="text-[color:var(--fg)]">~21.8%</strong></div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: RESULTS, PAYCHECK SCHEDULE & AUDIT TRAIL -->
    <div class="space-y-6">

      <!-- PAYCHECK FREQUENCY TABLE (Shared Primitive) -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 shadow-sm">
        <PaycheckFrequencyTable
          currencySymbol={profile.defaultCurrencySymbol}
          monthly={initialResult.netMonthlyTakeHome}
          biweekly={initialResult.netBiweeklyTakeHome}
          weekly={initialResult.netWeeklyTakeHome}
          daily={initialResult.netAnnualTakeHome / 260}
          hourly={initialResult.netHourlyTakeHome}
        />
      </div>

      <!-- AUDIT TRAIL / BREAKDOWN TABLE -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
            <Icon name="table" class="w-4 h-4 text-[color:var(--accent)]" />
            <span>DGFiP Décomposition de l'Impôt</span>
          </h3>
          <span class="text-xs font-mono font-bold text-[color:var(--accent)]" data-effective-rate>
            {formatPercent(initialResult.effectiveTotalTaxRate, 1)}
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40 font-medium">
            <span class="text-[color:var(--muted)]">Salaire Brut Annuel</span>
            <span class="font-bold text-[color:var(--fg)]" data-res-gross>
              {formatCurrency(initialResult.totalGrossIncome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Déduction 10% (Frais Professionnels)</span>
            <span class="font-bold text-emerald-500" data-res-prof-expenses>
              -{formatCurrency(initialResult.totalAdjustmentsToIncome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40 font-bold bg-[color:var(--bg)] px-2 rounded-lg">
            <span class="text-[color:var(--fg)]">Revenu Net Imposable</span>
            <span class="text-[color:var(--fg)]" data-res-taxable>
              {formatCurrency(initialResult.taxableIncome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Impôt sur le Revenu Net (IR)</span>
            <span class="font-bold text-blue-500" data-res-incometax>
              {formatCurrency(initialResult.regularIncomeTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">CSG / CRDS (9.7% sur 98.25%)</span>
            <span class="font-bold text-amber-500" data-res-csg>
              €0
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Retraite (Base + Complémentaire)</span>
            <span class="font-bold text-amber-600" data-res-pension>
              €0
            </span>
          </div>

          <div class="flex justify-between py-2 border-t-2 border-[color:var(--border)] text-sm font-extrabold">
            <span class="text-[color:var(--fg)]">Total Prélèvements Fiscaux &amp; Sociaux</span>
            <span class="text-red-500" data-res-total-taxes>
              {formatCurrency(initialResult.totalAllTaxes, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-2 rounded-xl bg-[color:var(--accent)]/10 px-3 text-sm font-black text-[color:var(--accent)]">
            <span>Salaire Net à Payer (Net Take-Home)</span>
            <span data-res-net-takehome>
              {formatCurrency(initialResult.netAnnualTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>
        </div>

        <div class="pt-2 flex justify-between text-xs text-[color:var(--muted)] border-t border-[color:var(--border)]/40">
          <span>Taux Marginal (TMI): <strong class="text-[color:var(--fg)]" data-marginal-rate>{formatPercent(initialResult.marginalFederalRate, 0)}</strong></span>
          <span>Taux Effectif Global: <strong class="text-[color:var(--fg)]" data-effective-tax-rate>{formatPercent(initialResult.effectiveTotalTaxRate, 1)}</strong></span>
        </div>
      </div>

      <!-- BARÈME PROGRESSIF BRACKETS TABLE (Shared Primitive) -->
      <div class="rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 shadow-sm">
        <TaxBracketsTable
          breakdown={initialResult.bracketBreakdown || []}
          currencySymbol={profile.defaultCurrencySymbol}
        />
      </div>

    </div>
  </div>

  <!-- Parameter Explanations -->
  <div class="mt-8 border-t border-[color:var(--border)] pt-8">
    <CalculatorParameterGuide parameters={taxParameterGuide} />
  </div>

  <!-- Disclaimer Footer -->
  <div class="mt-8">
    <TaxDisclaimer />
  </div>
</div>

<script>
  import { calculateFrTax } from '../../utils/tax/fr-engine';

  function setupFrTaxCalculator() {
    const apps = document.querySelectorAll('[data-tax-app][data-country-id="fr"]');

    apps.forEach((app) => {
      try {
        const profileJson = app.getAttribute('data-profile-json');
        if (!profileJson) return;
        const profile = JSON.parse(profileJson);

        // Controls
        const yearSelect = app.querySelector('[data-tax-year]') as HTMLSelectElement | null;
        const engineTabs = Array.from(app.querySelectorAll('[data-engine-tab]')) as HTMLElement[];
        const salaryInput = app.querySelector('[data-fr-salary]') as HTMLInputElement | null;
        const statusSelect = app.querySelector('[data-fr-status]') as HTMLSelectElement | null;
        const childrenSelect = app.querySelector('[data-fr-children]') as HTMLSelectElement | null;
        const deductionsInput = app.querySelector('[data-fr-deductions]') as HTMLInputElement | null;
        const partsDisplay = app.querySelector('[data-fr-parts-display]');

        // Mode State
        let currentMode: 'advanced' | 'quick' = 'advanced';

        // Hero Outputs
        const heroAmount = app.querySelector('[data-hero-amount]');
        const heroSubtext = app.querySelector('[data-hero-subtext]');
        const heroIncomeTax = app.querySelector('[data-hero-incometax]');
        const heroSocial = app.querySelector('[data-hero-social]');
        const marginalRateEl = app.querySelector('[data-marginal-rate]');
        const effectiveRateEl = app.querySelector('[data-effective-rate]');
        const effectiveTaxRateEl = app.querySelector('[data-effective-tax-rate]');

        // Allocation Bar
        const barTakehome = app.querySelector('[data-bar-takehome]') as HTMLElement | null;
        const barFedtax = app.querySelector('[data-bar-fedtax]') as HTMLElement | null;
        const barFica = app.querySelector('[data-bar-fica]') as HTMLElement | null;
        const barPretax = app.querySelector('[data-bar-pretax]') as HTMLElement | null;
        const allocationLabel = app.querySelector('[data-allocation-label]');

        // Paycheck Schedule
        const schedMonthly = app.querySelector('[data-sched-monthly]');
        const schedSemiMonthly = app.querySelector('[data-sched-semimonthly]');
        const schedBiweekly = app.querySelector('[data-sched-biweekly]');
        const schedWeekly = app.querySelector('[data-sched-weekly]');
        const schedDaily = app.querySelector('[data-sched-daily]');
        const schedHourly = app.querySelector('[data-sched-hourly]');

        // Audit Trail Elements
        const resGross = app.querySelector('[data-res-gross]');
        const resProfExpenses = app.querySelector('[data-res-prof-expenses]');
        const resTaxable = app.querySelector('[data-res-taxable]');
        const resIncomeTax = app.querySelector('[data-res-incometax]');
        const resCsg = app.querySelector('[data-res-csg]');
        const resPension = app.querySelector('[data-res-pension]');
        const resTotalTaxes = app.querySelector('[data-res-total-taxes]');
        const resNetTakeHome = app.querySelector('[data-res-net-takehome]');
        const bracketTbody = app.querySelector('[data-bracket-tbody]');
        const copySummaryBtn = app.querySelector('[data-copy-summary-btn]');

        function fmt(n: number): string {
          return '€' + Math.round(n).toLocaleString('fr-FR');
        }

        function calculate() {
          const selectedYear = yearSelect ? yearSelect.value : profile.defaultTaxYear;
          const yearData = profile.years[selectedYear] || profile.years[profile.defaultTaxYear];

          const gross = Math.max(0, parseFloat(salaryInput?.value || '0') || 0);
          const customDeductions = currentMode === 'advanced' ? Math.max(0, parseFloat(deductionsInput?.value || '0') || 0) : 0;
          const isMarried = statusSelect ? statusSelect.value === 'married_joint' : false;
          const children = childrenSelect ? parseInt(childrenSelect.value || '0', 10) : 0;

          const res = calculateFrTax({
            grossIncome: gross,
            taxYear: selectedYear,
            isMarried,
            numChildren: children,
            customDeductions,
          }, profile);

          const profDeduction = res.profDeduction;
          const parts = res.parts;
          const taxablePerPart = res.taxableIncomePerPart;
          const incomeTax = res.incomeTax;
          const csgCrds = res.csgCrds;
          const pensionBase = res.pensionBase;
          const pensionComp = res.pensionComp;
          const totalSocial = res.totalSocial;
          const totalAllTaxes = res.totalAllTaxes;
          const netTakeHome = res.netAnnualTakeHome;
          const effectiveTaxRate = res.effectiveTotalTaxRate;
          const marginalRate = res.marginalFederalRate;

          if (partsDisplay) {
            partsDisplay.textContent = `${parts.toFixed(1)} part${parts > 1 ? 's' : ''}`;
          }

          // Update Hero
          if (heroAmount) heroAmount.textContent = fmt(netTakeHome);
          if (heroSubtext) heroSubtext.textContent = `${fmt(netTakeHome / 12)}/mois · ${fmt(netTakeHome / 52)}/semaine`;
          if (heroIncomeTax) heroIncomeTax.textContent = fmt(incomeTax);
          if (heroSocial) heroSocial.textContent = fmt(totalSocial);
          if (effectiveRateEl) effectiveRateEl.textContent = `${effectiveTaxRate.toFixed(1)}%`;
          if (effectiveTaxRateEl) effectiveTaxRateEl.textContent = `${effectiveTaxRate.toFixed(1)}%`;
          if (marginalRateEl) marginalRateEl.textContent = `${marginalRate.toFixed(0)}%`;

          // Paycheck Schedule
          if (schedMonthly) schedMonthly.textContent = fmt(netTakeHome / 12);
          if (schedSemiMonthly) schedSemiMonthly.textContent = fmt(netTakeHome / 24);
          if (schedBiweekly) schedBiweekly.textContent = fmt(netTakeHome / 26);
          if (schedWeekly) schedWeekly.textContent = fmt(netTakeHome / 52);
          if (schedDaily) schedDaily.textContent = fmt(netTakeHome / 260);
          if (schedHourly) schedHourly.textContent = fmt(netTakeHome / 2080);

          // Audit Trail
          if (resGross) resGross.textContent = fmt(gross);
          if (resProfExpenses) resProfExpenses.textContent = `-${fmt(profDeduction)}`;
          if (resTaxable) resTaxable.textContent = fmt(taxablePerPart * parts);
          if (resIncomeTax) resIncomeTax.textContent = fmt(incomeTax);
          if (resCsg) resCsg.textContent = fmt(csgCrds);
          if (resPension) resPension.textContent = fmt(pensionBase + pensionComp);
          if (resTotalTaxes) resTotalTaxes.textContent = fmt(totalAllTaxes);
          if (resNetTakeHome) resNetTakeHome.textContent = fmt(netTakeHome);

          // Allocation Bar
          if (gross > 0) {
            const pctTakehome = Math.max(0, (netTakeHome / gross) * 100);
            const pctIncomeTax = Math.max(0, (incomeTax / gross) * 100);
            const pctSocial = Math.max(0, (totalSocial / gross) * 100);
            const pctProf = Math.max(0, (profDeduction / gross) * 100);

            if (barTakehome) barTakehome.style.width = `${pctTakehome}%`;
            if (barFedtax) barFedtax.style.width = `${pctIncomeTax}%`;
            if (barFica) barFica.style.width = `${pctSocial}%`;
            if (barPretax) barPretax.style.width = `${pctProf}%`;

            if (allocationLabel) {
              allocationLabel.textContent = `Net: ${pctTakehome.toFixed(1)}% · Impôt: ${pctIncomeTax.toFixed(1)}% · Cotisations: ${pctSocial.toFixed(1)}%`;
            }
          }

          // Bracket Table
          if (bracketTbody) {
            bracketTbody.innerHTML = res.bracketBreakdown
              .map(
                (row) => `
                <tr class="border-b border-[color:var(--border)]/40 hover:bg-[color:var(--bg)]/50 transition">
                  <td class="py-2 px-3 font-medium text-[color:var(--fg)]">${row.bracketRange}</td>
                  <td class="py-2 px-3 text-right font-mono text-[color:var(--muted)]">${row.ratePercent}</td>
                  <td class="py-2 px-3 text-right font-mono font-medium text-[color:var(--fg)]">${fmt(row.taxableInBracket)}</td>
                  <td class="py-2 px-3 text-right font-mono font-bold text-blue-500">${fmt(row.taxAmount)}</td>
                </tr>
              `
              )
              .join('');
          }
        }

        // Mode Switching
        engineTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const mode = tab.getAttribute('data-engine-tab') as 'advanced' | 'quick';
            if (!mode) return;
            currentMode = mode;

            engineTabs.forEach((t) => {
              if (t === tab) {
                t.className = 'shrink-0 min-w-max cursor-pointer rounded-xl px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active';
              } else {
                t.className = 'shrink-0 min-w-max cursor-pointer rounded-xl px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5';
              }
            });

            const advSections = app.querySelectorAll('[data-advanced-section]');
            advSections.forEach((sec) => {
              if (mode === 'quick') {
                sec.classList.add('hidden');
              } else {
                sec.classList.remove('hidden');
              }
            });

            calculate();
          });
        });

        // Event Listeners
        salaryInput?.addEventListener('input', calculate);
        statusSelect?.addEventListener('change', calculate);
        childrenSelect?.addEventListener('change', calculate);
        deductionsInput?.addEventListener('input', calculate);
        yearSelect?.addEventListener('change', calculate);

        // Copy Report
        copySummaryBtn?.addEventListener('click', () => {
          const gross = salaryInput?.value || '0';
          const net = heroAmount?.textContent || '€0';
          const tax = heroIncomeTax?.textContent || '€0';
          const soc = heroSocial?.textContent || '€0';
          const eff = effectiveRateEl?.textContent || '0%';
          const summary = `--- Calcul d'Impôt France (DGFiP 2026 Brut en Net) ---\nSalaire Brut: €${gross}\nNet à Payer: ${net}\nImpôt sur le Revenu (IR): ${tax}\nCotisations Sociales (CSG/CRDS + Retraite): ${soc}\nTaux Effectif: ${eff}\nCalculé via Toolscastle Tax Platform`;

          navigator.clipboard.writeText(summary).then(() => {
            const btnSpan = copySummaryBtn.querySelector('span');
            if (btnSpan) {
              const orig = btnSpan.textContent;
              btnSpan.textContent = 'Copié dans le presse-papiers !';
              setTimeout(() => {
                btnSpan.textContent = orig;
              }, 2000);
            }
          });
        });

        // Initialize
        calculate();
      } catch (err) {
        console.error('Error initializing FR tax calculator:', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFrTaxCalculator);
  } else {
    setupFrTaxCalculator();
  }
</script>

