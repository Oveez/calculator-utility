---
import type { CountryTaxProfile } from '../../data/tax/types';
import { calculateNoTax } from '../../utils/tax/no-engine';
import { formatCurrency, formatPercent } from '../../utils/tax/formatters';
import TaxDisclaimer from './TaxDisclaimer.astro';
import CalculatorParameterGuide from '../calculator/CalculatorParameterGuide.astro';
import Icon from '../Icon.astro';
import TaxYearSelector from './shared/TaxYearSelector.astro';
import TaxAllocationBar from './shared/TaxAllocationBar.astro';
import PaycheckFrequencyTable from './shared/PaycheckFrequencyTable.astro';
import TaxBreakdownTable from './shared/TaxBreakdownTable.astro';
import TaxBracketsTable from './shared/TaxBracketsTable.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';

interface Props {
  profile: CountryTaxProfile;
  initialIncome?: number;
}

const { profile, initialIncome = 0 } = Astro.props;

// Initial server-rendered baseline calculations for Norway
const initialResult = calculateNoTax(
  {
    primaryW2Income: initialIncome,
    taxYear: '2026',
    filingStatus: 'single',
  },
  profile
);

const defaultYearData = profile.years[profile.defaultTaxYear];

const taxParameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'bruttolonn',
    name: 'Bruttolønn (Annual Gross Salary)',
    description: 'Contractual pre-tax salary, wages, and taxable bonuses before Trygdeavgift or Skatteetaten withholding taxes.',
    whyItMatters: 'Serves as the foundation for National Insurance (Trygdeavgift) and Trinnskatt assessments.',
    typicalRange: 'Any positive earnings',
    unit: 'NOK (kr)',
  },
  {
    id: 'trygdeavgift',
    name: 'Trygdeavgift (National Insurance Contribution 7.6%)',
    description: 'Statutory 7.6% employee contribution deducted from gross wage earnings to fund Norwegian national healthcare and social welfare.',
    whyItMatters: 'Mandatory contribution withheld directly by employers at source.',
    typicalRange: '7.60% (standard wage earners)',
    unit: '%',
  },
  {
    id: 'personfradrag',
    name: 'Personfradrag (114,540 NOK Personal Allowance)',
    description: 'Statutory bottom personal tax exemption deducted from ordinary income before assessing the 22% base tax.',
    whyItMatters: 'Protects baseline living expenses from general income taxation.',
    typicalRange: '114,540 kr (2026 rate)',
    unit: 'NOK (kr)',
  },
  {
    id: 'alminneligInntekt',
    name: 'Skatt på Alminnelig Inntekt (22% General Income Tax)',
    description: 'Flat 22% combined municipal, county, and state tax applied to ordinary taxable net income after personal allowances.',
    whyItMatters: 'Central backbone of Norwegian direct income taxation.',
    typicalRange: '22.00% flat rate',
    unit: '%',
  },
  {
    id: 'trinnskatt',
    name: 'Trinnskatt (Progressive Bracket Tax Steps 1–5)',
    description: 'Progressive gross surtax ranging from 1.7% in Step 1 up to 17.8% in Step 5 for high earners exceeding indexed wage thresholds.',
    whyItMatters: 'Introduces strong progressivity for medium and higher income brackets.',
    typicalRange: '1.7% to 17.8% (above thresholds)',
    unit: '%',
  },
];
---

<div
  class="space-y-8"
  data-tax-app
  data-country-id="no"
  data-profile-json={JSON.stringify(profile)}
>
  <!-- Top Bar: Country Info & Mode Switcher -->
  <div class="flex flex-col gap-4 border-b border-[color:var(--border)] pb-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <span class="text-3xl sm:text-4xl select-none">{profile.flagEmoji}</span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)] sm:text-2xl">
            Norway Income Tax &amp; Net Salary Calculator
          </h2>
          <span class="inline-flex items-center rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-semibold text-[color:var(--accent)] border border-[color:var(--accent)]/30">
            Official 2026 Skatteetaten
          </span>
        </div>
        <p class="text-xs text-[color:var(--muted)]">
          Source: <a href={defaultYearData.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-[color:var(--accent)] hover:underline">{defaultYearData.officialSourceName}</a> • Verified {defaultYearData.lastVerifiedDate}
        </p>
      </div>
    </div>

    <!-- App Tabs & Tax Year -->
    <div class="flex flex-wrap items-center gap-2">
      <TaxYearSelector profile={profile} id="no-tax-year-select" />

      <!-- Engine View Toggle -->
      <div class="flex items-center rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-1 text-xs font-semibold overflow-x-auto no-scrollbar max-w-full shrink-0">
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active"
          data-engine-tab="advanced"
        >
          <Icon name="bolt" class="w-3.5 h-3.5" />
          <span>Detailed Skatt Mode</span>
        </button>
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5"
          data-engine-tab="quick"
        >
          <Icon name="calculator" class="w-3.5 h-3.5" />
          <span>Quick Salary</span>
        </button>
      </div>
    </div>
  </div>

  <!-- HERO DYNAMIC TAKE-HOME BANNER -->
  <div class="mt-6 border-b border-[color:var(--border)] pb-6 space-y-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Annual Net Take-Home (Netto Utbetalt Lønn)</span>
          <span
            data-hero-badge
            class="inline-flex items-center gap-1 rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-bold text-[color:var(--accent)] border border-[color:var(--accent)]/30"
          >
            Net Pay
          </span>
        </div>
        <p class="mt-1 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl text-[color:var(--fg)]" data-hero-amount>
          {formatCurrency(initialResult.netAnnualTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
        </p>
        <p class="mt-1 text-xs text-[color:var(--muted)]" data-hero-subtext>
          {formatCurrency(initialResult.netMonthlyTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}/month · {formatCurrency(initialResult.netWeeklyTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}/week
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 border-t border-[color:var(--border)]/60 pt-3 md:border-t-0 md:pt-0">
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Inntektsskatt (22% + Trinn)</p>
          <p class="text-base font-extrabold text-[color:var(--accent)]" data-hero-incometax>
            {formatCurrency(initialResult.regularIncomeTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">General &amp; Trinnskatt</p>
        </div>
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Trygdeavgift (7.6%)</p>
          <p class="text-base font-extrabold text-[color:var(--fg)]" data-hero-social>
            {formatCurrency(initialResult.totalFicaTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">National Insurance</p>
        </div>
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3 col-span-2 sm:col-span-1">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Effective Tax Rate</p>
          <p class="text-base font-extrabold text-[color:var(--accent)]" data-hero-effective-rate>
            {formatPercent(initialResult.effectiveTotalTaxRate, 1)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Combined tax burden</p>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN CALCULATOR WORKSPACE -->
  <div class="mt-8 grid gap-8 lg:grid-cols-12">
    <!-- LEFT PANE: INPUT CONTROLS -->
    <div class="space-y-6 lg:col-span-5">
      <!-- Income Input Card -->
      <div class="space-y-5">
        <div class="flex items-center justify-between border-b border-[color:var(--border)]/60 pb-3">
          <h3 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
            <Icon name="dollar-sign" class="w-4 h-4 text-[color:var(--accent)]" />
            <span>Salary &amp; Remuneration</span>
          </h3>
          <span class="text-xs font-semibold text-[color:var(--muted)]">NOK (kr)</span>
        </div>

        <div>
          <label for="no-salary-input" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--fg)] mb-1">
            Annual Gross Salary (Bruttolønn)
          </label>
          <div class="relative rounded-none shadow-inner">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 font-bold text-[color:var(--muted)]">
              kr
            </div>
            <input
              type="number"
              id="no-salary-input"
              min="0"
              step="1000"
              value={initialIncome || ''}
              placeholder="e.g. 600,000"
              class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-3.5 pl-10 pr-4 text-base font-bold text-[color:var(--fg)] transition focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20"
            />
          </div>
          <p class="mt-1.5 text-[11px] text-[color:var(--muted)]">
            Total annual earnings before Trygdeavgift and tax withholding.
          </p>
        </div>

        <!-- Filing / Tax Class Status -->
        <div data-advanced-section>
          <label for="no-filing-status" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--fg)] mb-1">
            Taxpayer Status (Skatteklasse)
          </label>
          <select
            id="no-filing-status"
            class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-3 px-4 text-sm font-semibold text-[color:var(--fg)] transition focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20"
          >
            <option value="single" selected>Single Taxpayer (Klasse 1 — Standard)</option>
            <option value="married_joint">Married Joint / Sole Earner</option>
          </select>
          <p class="mt-1.5 text-[11px] text-[color:var(--muted)]">
            Standard individual assessment applies to virtually all Norwegian taxpayers.
          </p>
        </div>

        <!-- Additional Deductions (Fradrag) -->
        <div data-advanced-section>
          <label for="no-extra-deductions" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--fg)] mb-1">
            Interest &amp; Special Deductions (Rentefradrag / Reise)
          </label>
          <div class="relative rounded-none shadow-inner">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 font-bold text-[color:var(--muted)]">
              kr
            </div>
            <input
              type="number"
              id="no-extra-deductions"
              min="0"
              step="1000"
              value="0"
              placeholder="e.g. Mortgage interest, BSU savings"
              class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-3 pl-10 pr-4 text-sm font-bold text-[color:var(--fg)] transition focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20"
            />
          </div>
          <p class="mt-1.5 text-[11px] text-[color:var(--muted)]">
            Mortgage interest deductions (22% tax relief) or commuting expense allowances.
          </p>
        </div>
      </div>

      <!-- Quick Action / Copy Summary Card -->
      <div class="py-4 border-b border-[color:var(--border)] flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-[color:var(--fg)]">Export Calculation</p>
          <p class="text-[11px] text-[color:var(--muted)]">Copy clean text breakdown to clipboard</p>
        </div>
        <button
          type="button"
          id="no-copy-summary-btn"
          class="inline-flex items-center gap-1.5 rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2 text-xs font-bold text-[color:var(--fg)] transition hover:bg-[color:var(--surface)] active:scale-95"
        >
          <Icon name="copy" class="w-3.5 h-3.5" />
          <span>Copy Summary</span>
        </button>
      </div>
    </div>

    <!-- RIGHT PANE: TAX BREAKDOWN & SCHEDULE -->
    <div class="space-y-6 lg:col-span-7">
      <!-- Visual Allocation Bar -->
      <TaxAllocationBar
        profile={profile}
        netPercentage={100}
        taxPercentage={0}
        socialPercentage={0}
        otherPercentage={0}
      />

      <!-- Paycheck Frequency Breakdown -->
      <PaycheckFrequencyTable
        profile={profile}
        annualTakeHome={initialResult.netAnnualTakeHome}
      />

      <!-- Line-Item Audit Trail -->
      <div>
        <h3 class="text-base font-bold text-[color:var(--fg)] mb-4 flex items-center gap-2">
          <Icon name="list" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>Skatteetaten Official Tax Breakdown</span>
        </h3>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Gross Remuneration (Bruttolønn)</span>
            <span class="font-mono font-bold text-[color:var(--fg)]" data-res-gross>0 kr</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Trygdeavgift (7.6% National Insurance)</span>
            <span class="font-mono font-bold text-[color:var(--fg)]" data-res-trygd>-0 kr</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Personal Exemption (Personfradrag 114,540 kr)</span>
            <span class="font-mono font-semibold text-[color:var(--accent)]" data-res-allowance>-114,540 kr</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Ordinary Taxable Base (Alminnelig inntekt)</span>
            <span class="font-mono font-semibold text-[color:var(--fg)]" data-res-alminnelig>0 kr</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">General Income Tax (22% flat)</span>
            <span class="font-mono font-bold text-[color:var(--accent)]" data-res-flat-tax>-0 kr</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Bracket Surtax (Trinnskatt Trinn 1–5)</span>
            <span class="font-mono font-bold text-[color:var(--accent)]" data-res-trinnskatt>-0 kr</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Total Taxes &amp; Trygdeavgift</span>
            <span class="font-mono font-bold text-[color:var(--fg)]" data-res-total-taxes>-0 kr</span>
          </div>
          <div class="flex justify-between py-2 border-t-2 border-[color:var(--border)] font-bold text-sm">
            <span class="text-[color:var(--fg)]">Net Annual Take-Home (Netto Lønn)</span>
            <span class="font-mono text-[color:var(--fg)]" data-res-net-takehome>0 kr</span>
          </div>
        </div>
      </div>

      <!-- Progressive Tax Brackets Table -->
      <div>
        <h3 class="text-base font-bold text-[color:var(--fg)] mb-3 flex items-center gap-2">
          <Icon name="bar-chart-2" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>2026 Norwegian Tax Scale (22% General + Trinnskatt)</span>
        </h3>
        <p class="text-xs text-[color:var(--muted)] mb-4">
          General tax (22%) applies to income over Personfradrag. Trinnskatt steps 1 to 5 apply progressively to high earnings.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="border-b border-[color:var(--border)] text-[color:var(--muted)]">
                <th class="py-2 px-3 text-left font-semibold">Tax Tier</th>
                <th class="py-2 px-3 text-right font-semibold">Total Rate</th>
                <th class="py-2 px-3 text-right font-semibold">Taxable Slice</th>
                <th class="py-2 px-3 text-right font-semibold">Tax in Tier</th>
              </tr>
            </thead>
            <tbody data-bracket-tbody>
              <!-- Filled dynamically by JavaScript -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- PARAMETER GUIDE & DISCLAIMER -->
  <div class="mt-12 space-y-8 border-t border-[color:var(--border)] pt-8">
    <CalculatorParameterGuide parameters={taxParameterGuide} />
    <TaxDisclaimer officialSourceName={defaultYearData.officialSourceName} officialSourceUrl={defaultYearData.officialSourceUrl} />
  </div>
</div>

<script>
  import { calculateNoTax } from '../../utils/tax/no-engine';

  function setupNoTaxCalculator() {
    const apps = document.querySelectorAll('[data-tax-app][data-country-id="no"]');

    apps.forEach((app) => {
      try {
        const salaryInput = app.querySelector('#no-salary-input') as HTMLInputElement | null;
        const filingStatusSelect = app.querySelector('#no-filing-status') as HTMLSelectElement | null;
        const extraDeductionsInput = app.querySelector('#no-extra-deductions') as HTMLInputElement | null;
        const yearSelect = app.querySelector('#no-tax-year-select') as HTMLSelectElement | null;
        const copySummaryBtn = app.querySelector('#no-copy-summary-btn') as HTMLButtonElement | null;

        // Hero Elements
        const heroAmount = app.querySelector('[data-hero-amount]');
        const heroSubtext = app.querySelector('[data-hero-subtext]');
        const heroIncomeTax = app.querySelector('[data-hero-incometax]');
        const heroSocial = app.querySelector('[data-hero-social]');
        const heroEffectiveRate = app.querySelector('[data-hero-effective-rate]');

        // Paycheck Schedule Elements
        const schedMonthly = app.querySelector('[data-sched-monthly]');
        const schedSemiMonthly = app.querySelector('[data-sched-semimonthly]');
        const schedBiweekly = app.querySelector('[data-sched-biweekly]');
        const schedWeekly = app.querySelector('[data-sched-weekly]');
        const schedDaily = app.querySelector('[data-sched-daily]');
        const schedHourly = app.querySelector('[data-sched-hourly]');

        // Audit Trail Elements
        const resGross = app.querySelector('[data-res-gross]');
        const resTrygd = app.querySelector('[data-res-trygd]');
        const resAllowance = app.querySelector('[data-res-allowance]');
        const resAlminnelig = app.querySelector('[data-res-alminnelig]');
        const resFlatTax = app.querySelector('[data-res-flat-tax]');
        const resTrinnskatt = app.querySelector('[data-res-trinnskatt]');
        const resTotalTaxes = app.querySelector('[data-res-total-taxes]');
        const resNetTakeHome = app.querySelector('[data-res-net-takehome]');

        // Visual Allocation Bar
        const barTakehome = app.querySelector('[data-bar-takehome]') as HTMLElement | null;
        const barFedtax = app.querySelector('[data-bar-fedtax]') as HTMLElement | null;
        const barFica = app.querySelector('[data-bar-fica]') as HTMLElement | null;
        const barPretax = app.querySelector('[data-bar-pretax]') as HTMLElement | null;
        const allocationLabel = app.querySelector('[data-allocation-label]');

        // Bracket Table Body
        const bracketTbody = app.querySelector('[data-bracket-tbody]');

        // Mode Switching
        const engineTabs = app.querySelectorAll('[data-engine-tab]');
        let currentMode: 'advanced' | 'quick' = 'advanced';

        const fmt = (n: number) => {
          return new Intl.NumberFormat('nb-NO', {
            style: 'currency',
            currency: 'NOK',
            maximumFractionDigits: 0,
          }).format(Math.round(n));
        };

        function calculate() {
          const selectedYear = (yearSelect ? yearSelect.value : '2026') as '2025' | '2026';
          const gross = Math.max(0, parseFloat(salaryInput?.value || '0') || 0);
          const extraDeductions = currentMode === 'advanced' ? Math.max(0, parseFloat(extraDeductionsInput?.value || '0') || 0) : 0;

          const res = calculateNoTax({
            grossIncome: gross,
            taxYear: selectedYear,
            customDeductions: extraDeductions,
          });

          // Update Hero
          if (heroAmount) heroAmount.textContent = fmt(res.netIncomeAnnual);
          if (heroSubtext) heroSubtext.textContent = `${fmt(res.netIncomeMonthly)}/month · ${fmt(res.netIncomeWeekly)}/week`;
          if (heroIncomeTax) heroIncomeTax.textContent = fmt(res.totalIncomeTax);
          if (heroSocial) heroSocial.textContent = fmt(res.totalSocialContributions);
          if (heroEffectiveRate) heroEffectiveRate.textContent = `${res.effectiveTotalDeductionRate.toFixed(1)}%`;

          // Paycheck Schedule
          if (schedMonthly) schedMonthly.textContent = fmt(res.netIncomeMonthly);
          if (schedSemiMonthly) schedSemiMonthly.textContent = fmt(res.netIncomeMonthly / 2);
          if (schedBiweekly) schedBiweekly.textContent = fmt(res.netIncomeBiweekly);
          if (schedWeekly) schedWeekly.textContent = fmt(res.netIncomeWeekly);
          if (schedDaily) schedDaily.textContent = fmt(res.netIncomeDaily);
          if (schedHourly) schedHourly.textContent = fmt(res.netIncomeHourly);

          // Audit Trail
          if (resGross) resGross.textContent = fmt(gross);
          if (resTrygd) resTrygd.textContent = `-${fmt(res.trygdeavgift)}`;
          if (resAllowance) resAllowance.textContent = `-${fmt(res.standardDeduction)}`;
          if (resAlminnelig) resAlminnelig.textContent = fmt(res.alminneligInntekt);
          if (resFlatTax) resFlatTax.textContent = `-${fmt(res.flatTax)}`;
          if (resTrinnskatt) resTrinnskatt.textContent = `-${fmt(res.trinnskatt)}`;
          if (resTotalTaxes) resTotalTaxes.textContent = `-${fmt(res.totalTaxAndDeductions)}`;
          if (resNetTakeHome) resNetTakeHome.textContent = fmt(res.netIncomeAnnual);

          // Visual Allocation Bar
          if (gross > 0) {
            const pctTakehome = Math.max(0, (res.netIncomeAnnual / gross) * 100);
            const pctTax = Math.max(0, (res.totalIncomeTax / gross) * 100);
            const pctSocial = Math.max(0, (res.totalSocialContributions / gross) * 100);
            const pctPretax = Math.max(0, (res.standardDeduction / gross) * 100);

            if (barTakehome) barTakehome.style.width = `${pctTakehome}%`;
            if (barFedtax) barFedtax.style.width = `${pctTax}%`;
            if (barFica) barFica.style.width = `${pctSocial}%`;
            if (barPretax) barPretax.style.width = `${pctPretax}%`;

            if (allocationLabel) {
              allocationLabel.textContent = `Net Pay: ${pctTakehome.toFixed(1)}% · Inntektsskatt: ${pctTax.toFixed(1)}% · Trygdeavgift: ${pctSocial.toFixed(1)}%`;
            }
          }

          // Bracket Table
          if (bracketTbody) {
            bracketTbody.innerHTML = res.bracketBreakdown
              .map(
                (row) => `
                <tr class="border-b border-[color:var(--border)]/40 hover:bg-[color:var(--bg)]/50 transition">
                  <td class="py-2 px-3 font-medium text-[color:var(--fg)]">${row.bracketRange}</td>
                  <td class="py-2 px-3 text-right font-mono text-[color:var(--muted)]">${row.ratePercent}</td>
                  <td class="py-2 px-3 text-right font-mono font-medium text-[color:var(--fg)]">${fmt(row.taxableInBracket)}</td>
                  <td class="py-2 px-3 text-right font-mono font-bold text-[color:var(--fg)]">${fmt(row.taxAmount)}</td>
                </tr>
              `
              )
              .join('');
          }
        }

        // Mode Switching
        engineTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const mode = tab.getAttribute('data-engine-tab') as 'advanced' | 'quick';
            if (!mode) return;
            currentMode = mode;

            engineTabs.forEach((t) => {
              if (t === tab) {
                t.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active';
              } else {
                t.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5';
              }
            });

            const advSections = app.querySelectorAll('[data-advanced-section]');
            advSections.forEach((sec) => {
              if (mode === 'quick') {
                sec.classList.add('hidden');
              } else {
                sec.classList.remove('hidden');
              }
            });

            calculate();
          });
        });

        // Event Listeners
        salaryInput?.addEventListener('input', calculate);
        filingStatusSelect?.addEventListener('change', calculate);
        extraDeductionsInput?.addEventListener('input', calculate);
        yearSelect?.addEventListener('change', calculate);

        // Copy Summary
        copySummaryBtn?.addEventListener('click', () => {
          const gross = salaryInput?.value || '0';
          const net = heroAmount?.textContent || '0 kr';
          const tax = heroIncomeTax?.textContent || '0 kr';
          const soc = heroSocial?.textContent || '0 kr';
          const eff = heroEffectiveRate?.textContent || '0%';
          const summary = `--- Norway Income Tax Summary (2026 Skatteetaten) ---\nGross Salary: ${gross} kr\nNet Take-Home: ${net}\nIncome Tax (22% + Trinnskatt): ${tax}\nTrygdeavgift (7.6%): ${soc}\nEffective Tax Rate: ${eff}\nCalculated via Toolscastle Tax Platform`;

          navigator.clipboard.writeText(summary).then(() => {
            const btnSpan = copySummaryBtn.querySelector('span');
            if (btnSpan) {
              const orig = btnSpan.textContent;
              btnSpan.textContent = 'Copied to clipboard!';
              setTimeout(() => {
                btnSpan.textContent = orig;
              }, 2000);
            }
          });
        });

        // Initial Calculation
        calculate();
      } catch (err) {
        console.error('Error initializing Norway tax calculator:', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNoTaxCalculator);
  } else {
    setupNoTaxCalculator();
  }
</script>

