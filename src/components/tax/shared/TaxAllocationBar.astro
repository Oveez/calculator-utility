---
interface Props {
  takeHomePercent?: number;
  fedTaxPercent?: number;
  ficaPercent?: number;
  stateTaxPercent?: number;
  preTaxPercent?: number;
  class?: string;
}

const {
  takeHomePercent = 75,
  fedTaxPercent = 12,
  ficaPercent = 7,
  stateTaxPercent = 4,
  preTaxPercent = 2,
  class: className = '',
} = Astro.props;
---

<div class={`mt-5 space-y-2 ${className}`}>
  <div class="flex items-center justify-between text-xs font-semibold text-[color:var(--muted)]">
    <span>Income Allocation Distribution</span>
    <span data-allocation-label>Take-Home: {takeHomePercent}% | Taxes: {100 - takeHomePercent}%</span>
  </div>
  <div class="flex h-3 w-full overflow-hidden rounded-full bg-[color:var(--border)]/50">
    <div
      class="bg-cyan-500 transition-all duration-300"
      style={`width: ${takeHomePercent}%`}
      title="Take-Home Pay"
      data-bar-takehome
    ></div>
    <div
      class="bg-blue-500 transition-all duration-300"
      style={`width: ${fedTaxPercent}%`}
      title="Federal Income Tax"
      data-bar-fedtax
    ></div>
    <div
      class="bg-indigo-500 transition-all duration-300"
      style={`width: ${ficaPercent}%`}
      title="FICA / Social Security"
      data-bar-fica
    ></div>
    <div
      class="bg-purple-500 transition-all duration-300"
      style={`width: ${stateTaxPercent}%`}
      title="State Income Tax"
      data-bar-statetax
    ></div>
    <div
      class="bg-amber-500 transition-all duration-300"
      style={`width: ${preTaxPercent}%`}
      title="Pre-Tax Deductions"
      data-bar-pretax
    ></div>
  </div>
  <div class="flex flex-wrap items-center gap-4 text-[11px] text-[color:var(--muted)] pt-1">
    <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-cyan-500"></span> Take-Home Pay</span>
    <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-blue-500"></span> Federal Income Tax</span>
    <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-indigo-500"></span> FICA &amp; Social Insurance</span>
    <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-purple-500"></span> State / Regional Tax</span>
    <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-amber-500"></span> Pre-Tax Savings</span>
  </div>
</div>

