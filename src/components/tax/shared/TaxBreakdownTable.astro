---
import { formatCurrency } from '../../../utils/tax/formatters';

interface Props {
  title?: string;
  currency?: string;
  currencySymbol?: string;
  totalGrossIncome?: number;
  totalAdjustments?: number;
  adjustedGrossIncome?: number;
  deductionAmount?: number;
  deductionLabel?: string;
  taxableIncome?: number;
  regularIncomeTax?: number;
  preferentialCapitalGainsTax?: number;
  totalTaxCredits?: number;
  netFederalIncomeTax?: number;
  totalFicaTax?: number;
  ficaLabel?: string;
  selfEmploymentTax?: number;
  stateIncomeTax?: number;
  stateTaxName?: string;
  totalAllTaxes?: number;
  totalPaymentsAndWithholdings?: number;
  federalRefundOrOwed?: number;
  class?: string;
}

const {
  title = 'Tax Return Audit Breakdown (Form 1040)',
  currency = 'USD',
  currencySymbol = '$',
  totalGrossIncome = 0,
  totalAdjustments = 0,
  adjustedGrossIncome = 0,
  deductionAmount = 0,
  deductionLabel = 'Deductions (Standard Claimed)',
  taxableIncome = 0,
  regularIncomeTax = 0,
  preferentialCapitalGainsTax = 0,
  totalTaxCredits = 0,
  netFederalIncomeTax = 0,
  totalFicaTax = 0,
  ficaLabel = 'FICA (Social Security & Medicare)',
  selfEmploymentTax = 0,
  stateIncomeTax = 0,
  stateTaxName = 'Regional / State Tax',
  totalAllTaxes = 0,
  totalPaymentsAndWithholdings = 0,
  federalRefundOrOwed = 0,
  class: className = '',
} = Astro.props;
---

<div class={`rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 sm:p-6 space-y-3 shadow-sm ${className}`}>
  <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-3">
    <h3 class="text-xs font-bold uppercase tracking-wider text-[color:var(--fg)]">
      {title}
    </h3>
    <span class="text-[11px] text-[color:var(--muted)]">Line Items</span>
  </div>

  <div class="space-y-2 text-xs">
    <div class="flex justify-between text-[color:var(--fg)]">
      <span>Total Gross Income</span>
      <span class="font-bold" data-res-gross>
        {formatCurrency(totalGrossIncome, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-[color:var(--muted)]">
      <span>Above-the-line Adjustments (401k/HSA/SE)</span>
      <span data-res-adjustments>
        -{formatCurrency(totalAdjustments, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between font-semibold text-[color:var(--fg)] border-t border-[color:var(--border)]/40 pt-1">
      <span>Adjusted Gross Income (AGI)</span>
      <span data-res-agi>
        {formatCurrency(adjustedGrossIncome, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-[color:var(--muted)]">
      <span data-res-deduction-label>{deductionLabel}</span>
      <span data-res-deduction>
        -{formatCurrency(deductionAmount, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between font-bold text-[color:var(--fg)] border-t border-[color:var(--border)]/40 pt-1">
      <span>Taxable Income Base</span>
      <span data-res-taxable>
        {formatCurrency(taxableIncome, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-rose-500">
      <span>Regular Federal Income Tax</span>
      <span data-res-regular-tax>
        {formatCurrency(regularIncomeTax, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-rose-500" data-res-capgains-wrap>
      <span>Preferential Capital Gains Tax</span>
      <span data-res-capgains-tax>
        {formatCurrency(preferentialCapitalGainsTax, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-cyan-500 dark:text-cyan-400 font-semibold" data-res-credits-wrap>
      <span>Tax Credits (Child &amp; Dependent)</span>
      <span data-res-credits>
        -{formatCurrency(totalTaxCredits, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between font-semibold text-rose-600 border-t border-[color:var(--border)]/40 pt-1">
      <span>Net Federal Income Tax</span>
      <span data-res-net-fed>
        {formatCurrency(netFederalIncomeTax, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-indigo-500">
      <span data-res-fica-label>{ficaLabel}</span>
      <span data-res-fica>
        {formatCurrency(totalFicaTax, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-purple-500" data-res-se-wrap>
      <span>Self-Employment Tax (SE)</span>
      <span data-res-se>
        {formatCurrency(selfEmploymentTax, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-purple-500">
      <span data-res-state-name>{stateTaxName}</span>
      <span data-res-state-tax>
        {formatCurrency(stateIncomeTax, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between font-black text-sm text-[color:var(--fg)] border-t border-[color:var(--border)] pt-2">
      <span>Total Taxes (Fed + FICA + State)</span>
      <span data-res-total-tax>
        {formatCurrency(totalAllTaxes, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between text-[color:var(--muted)]" data-adv-only>
      <span>Total Withholding &amp; Payments</span>
      <span data-res-withheld>
        {formatCurrency(totalPaymentsAndWithholdings, currency, currencySymbol)}
      </span>
    </div>
    <div class="flex justify-between font-extrabold text-sm border-t-2 border-[color:var(--border)] pt-2" data-res-refund-row>
      <span data-res-refund-label class="text-cyan-500 dark:text-cyan-400">Net Estimated Refund</span>
      <span data-res-refund-val class="text-cyan-500 dark:text-cyan-400 font-mono">
        +{formatCurrency(federalRefundOrOwed, currency, currencySymbol)}
      </span>
    </div>
  </div>
</div>

