---
import type { CountryTaxProfile } from '../../data/tax/types';
import { calculateItTax } from '../../utils/tax/it-engine';
import { formatCurrency, formatPercent } from '../../utils/tax/formatters';
import TaxDisclaimer from './TaxDisclaimer.astro';
import CalculatorParameterGuide from '../calculator/CalculatorParameterGuide.astro';
import Icon from '../Icon.astro';
import TaxYearSelector from './shared/TaxYearSelector.astro';
import TaxAllocationBar from './shared/TaxAllocationBar.astro';
import PaycheckFrequencyTable from './shared/PaycheckFrequencyTable.astro';
import TaxBreakdownTable from './shared/TaxBreakdownTable.astro';
import TaxBracketsTable from './shared/TaxBracketsTable.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';

interface Props {
  profile: CountryTaxProfile;
  initialIncome?: number;
}

const { profile, initialIncome = 0 } = Astro.props;

// Initial server-rendered baseline calculations for Italy
const initialResult = calculateItTax({
  grossIncome: initialIncome,
  taxYear: profile.defaultTaxYear,
});

const defaultYearData = profile.years[profile.defaultTaxYear];

const taxParameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'grossSalary',
    name: 'Reddito Lordo Annuo (RAL - Gross Salary)',
    description: 'Total agreed annual gross compensation (Retribuzione Annua Lorda) before INPS social security contributions or IRPEF income withholding.',
    whyItMatters: 'Baseline salary evaluated by the Agenzia delle Entrate and INPS on employee paystubs (busta paga).',
    typicalRange: 'Any positive earnings',
    unit: 'EUR (€)',
  },
  {
    id: 'scaglioniIrpef',
    name: 'Scaglioni IRPEF (National Income Tax Brackets)',
    description: 'Consolidated three-bracket progressive scale: 23% up to €28,000; 33% (or 35%) from €28,001 to €50,000; and 43% on income over €50,000.',
    whyItMatters: 'Applied to taxable income (Imponibile IRPEF) after deducting employee INPS contributions.',
    typicalRange: '23% to 43%',
    unit: '%',
  },
  {
    id: 'detrazioniLavoro',
    name: 'Detrazioni per Lavoro Dipendente',
    description: 'Statutory tax credits (maximum €1,955 for incomes up to €15,000, phasing down to €0 at €50,000) that directly reduce gross IRPEF liability.',
    whyItMatters: 'Protects low- and middle-income workers by reducing their net tax burden significantly.',
    typicalRange: '€0 to €1,955',
    unit: 'EUR (€)',
  },
  {
    id: 'inps',
    name: 'Contributi INPS a carico dipendente (9.19%)',
    description: 'Mandatory social security contributions (standard rate 9.19% for private sector commerce/industry employees) deducted directly from gross salary.',
    whyItMatters: 'Funds invalidity, old-age, and survivor pension entitlements (IVS). Fully tax-deductible from gross income.',
    typicalRange: '9.19%',
    unit: '%',
  },
  {
    id: 'addizionali',
    name: 'Addizionale Regionale e Comunale',
    description: 'Regional surcharges (typically 1.23% to 3.33% depending on region) and municipal surcharges (up to 0.80%) levied on Imponibile IRPEF.',
    whyItMatters: 'Finances local municipal and regional government healthcare and administrative services.',
    typicalRange: '~2.53% combined',
    unit: '%',
  },
];
---

<div
  class="space-y-8"
  data-tax-app
  data-country-id="it"
  data-profile-json={JSON.stringify(profile)}
>
  <!-- Top Bar: Country Info & Mode Switcher -->
  <div class="flex flex-col gap-4 border-b border-[color:var(--border)] pb-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <span class="text-3xl sm:text-4xl select-none">{profile.flagEmoji}</span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)] sm:text-2xl">
            Italy Income Tax &amp; Salary Calculator (Calcolo Stipendio Netto)
          </h2>
          <span class="inline-flex items-center rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-semibold text-[color:var(--accent)] border border-[color:var(--accent)]/30">
            Official 2026 Agenzia delle Entrate Data
          </span>
        </div>
        <p class="text-xs text-[color:var(--muted)]">
          Source: <a href={defaultYearData.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-[color:var(--accent)] hover:underline">{defaultYearData.officialSourceName}</a> • Verified {defaultYearData.lastVerifiedDate}
        </p>
      </div>
    </div>

    <!-- App Tabs & Tax Year -->
    <div class="flex flex-wrap items-center gap-2">
      <TaxYearSelector profile={profile} id="it-tax-year-select" />

      <!-- Engine View Toggle -->
      <div class="flex items-center rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-1 text-xs font-semibold overflow-x-auto no-scrollbar max-w-full shrink-0">
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active"
          data-engine-tab="advanced"
        >
          <Icon name="bolt" class="w-3.5 h-3.5" />
          <span>Detailed IRPEF Mode</span>
        </button>
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5"
          data-engine-tab="quick"
        >
          <Icon name="calculator" class="w-3.5 h-3.5" />
          <span>Quick Salary</span>
        </button>
      </div>
    </div>
  </div>

  <!-- HERO DYNAMIC TAKE-HOME BANNER -->
  <div class="mt-6 border-b border-[color:var(--border)] pb-6 space-y-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Stipendio Netto Annuo (Take-Home)</span>
          <span
            data-hero-badge
            class="inline-flex items-center gap-1 rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-bold text-[color:var(--accent)] border border-[color:var(--accent)]/30"
          >
            Netto in Busta Paga
          </span>
        </div>
        <p class="mt-1 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl text-[color:var(--fg)]" data-hero-amount>
          {formatCurrency(initialResult.netIncomeAnnual, profile.defaultCurrency, profile.defaultCurrencySymbol)}
        </p>
        <p class="mt-1 text-xs text-[color:var(--muted)]" data-hero-subtext>
          {formatCurrency(initialResult.netIncomeAnnual / 13, profile.defaultCurrency, profile.defaultCurrencySymbol)}/mese (13 mensilità) · {formatCurrency(initialResult.netIncomeWeekly, profile.defaultCurrency, profile.defaultCurrencySymbol)}/settimana
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 border-t border-[color:var(--border)]/60 pt-3 md:border-t-0 md:pt-0">
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">IRPEF Totale</p>
          <p class="text-base font-extrabold text-[color:var(--accent)]" data-hero-incometax>
            {formatCurrency(initialResult.totalIncomeTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Netta + Addizionali</p>
        </div>
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Contributi INPS (9.19%)</p>
          <p class="text-base font-extrabold text-[color:var(--fg)]" data-hero-social>
            {formatCurrency(initialResult.inpsContribution, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Fondo pensionistico</p>
        </div>
        <div class="col-span-2 sm:col-span-1 rounded-none border border-[color:var(--border)] bg-white p-3 flex flex-col justify-between">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Azione</p>
          <button
            type="button"
            data-copy-summary-btn
            class="inline-flex items-center justify-center gap-1.5 rounded-none bg-[color:var(--surface)] px-2.5 py-1.5 text-xs font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
          >
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copia Report Fiscale</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Reusable Income Allocation Bar -->
    <TaxAllocationBar />
  </div>

  <!-- CALCULATOR MAIN BODY -->
  <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- LEFT COLUMN: INPUT FORMS -->
    <div class="space-y-6">

      <!-- SECTION 1: Reddito Lordo & Regione -->
      <div class="space-y-4 border-b border-[color:var(--border)] pb-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
          <Icon name="user" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>1. Reddito Lordo &amp; Mensilità</span>
        </h3>

        <div class="space-y-4">
          <!-- Gross Salary -->
          <div>
            <div class="flex justify-between items-center text-xs">
              <label for="it-gross-salary" class="font-bold text-[color:var(--fg)]">
                Retribuzione Annua Lorda (RAL in € EUR)
              </label>
              <span class="text-[color:var(--muted)] font-mono">Busta Paga Lorda</span>
            </div>
            <div class="relative mt-1.5">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-bold text-[color:var(--muted)]">
                €
              </span>
              <input
                id="it-gross-salary"
                type="number"
                min="0"
                step="1000"
                placeholder="e.g. 35,000"
                class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-3 pl-8 pr-4 text-base font-black text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent)]/20"
                data-it-salary
              />
            </div>
            <p class="mt-1 text-[11px] text-[color:var(--muted)]">
              Reddito complessivo da lavoro dipendente prima dei contributi previdenziali e delle ritenute fiscali.
            </p>
          </div>

          <!-- Mensilità e Regione -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="it-mensilita" class="block text-xs font-bold text-[color:var(--fg)]">
                Numero di Mensilità
              </label>
              <select
                id="it-mensilita"
                data-it-mensilita
                class="mt-1.5 w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-2.5 px-3 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)] cursor-pointer"
              >
                <option value="13" selected>13 Mensilità (Standard CCNL)</option>
                <option value="12">12 Mensilità</option>
                <option value="14">14 Mensilità (es. Commercio)</option>
              </select>
            </div>

            <div>
              <label for="it-region" class="block text-xs font-bold text-[color:var(--fg)]">
                Regione di Residenza
              </label>
              <select
                id="it-region"
                data-it-region
                class="mt-1.5 w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-2.5 px-3 text-xs font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)] cursor-pointer"
              >
                <option value="default" selected>Media Nazionale (1.73%)</option>
                <option value="lombardia">Lombardia (1.23% - 1.73%)</option>
                <option value="lazio">Lazio (1.73% - 3.33%)</option>
                <option value="piemonte">Piemonte (1.62% - 3.32%)</option>
                <option value="campania">Campania (2.03%)</option>
                <option value="veneto">Veneto (1.23%)</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 2: Detrazioni e Contributi INPS (Advanced Only) -->
      <div class="space-y-4 border-b border-[color:var(--border)] pb-6" data-advanced-section>
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
            <Icon name="shield-check" class="w-4 h-4 text-[color:var(--accent)]" />
            <span>2. Detrazioni &amp; Previdenza INPS</span>
          </h3>
          <span class="text-[10px] font-bold text-[color:var(--accent)] bg-[color:var(--accent-soft)] px-2 py-0.5 rounded-none border border-[color:var(--accent)]/30">
            Detrazioni Lavoro
          </span>
        </div>

        <div class="space-y-3">
          <!-- Detrazione Lavoro Dipendente Card -->
          <div class="rounded-none border border-[color:var(--border)] bg-white p-4 space-y-2">
            <div class="flex justify-between items-center text-xs">
              <span class="font-bold text-[color:var(--fg)]">Detrazione Lavoro Dipendente Calcolata:</span>
              <span class="font-extrabold text-[color:var(--fg)]" data-it-detrazione-amount>€1,955</span>
            </div>
            <p class="text-[11px] text-[color:var(--muted)]">
              Calcolata automaticamente con formula a scalare ex art. 13 TUIR per redditi fino a 50.000 €.
            </p>
          </div>

          <!-- INPS and Surcharges Info Card -->
          <div class="rounded-none border border-[color:var(--border)] bg-white p-3 text-xs space-y-1">
            <p class="font-bold text-[color:var(--fg)]">Aliquote previdenziali e locali (2026):</p>
            <div class="grid grid-cols-2 gap-2 text-[11px] text-[color:var(--muted)]">
              <div>Contributi INPS: <strong class="text-[color:var(--fg)]">9.19%</strong> (deducibile)</div>
              <div>Addizionale Regionale: <strong class="text-[color:var(--fg)]">~1.73%</strong></div>
              <div>Addizionale Comunale: <strong class="text-[color:var(--fg)]">~0.80%</strong></div>
              <div>Totale Addizionali: <strong class="text-[color:var(--fg)]">~2.53%</strong></div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: RESULTS, PAYCHECK SCHEDULE & AUDIT TRAIL -->
    <div class="space-y-6">

      <!-- PAYCHECK FREQUENCY TABLE (Shared Primitive) -->
      <div>
        <PaycheckFrequencyTable
          currencySymbol={profile.defaultCurrencySymbol}
          monthly={initialResult.netIncomeAnnual / 13}
          biweekly={initialResult.netIncomeBiweekly}
          weekly={initialResult.netIncomeWeekly}
          daily={initialResult.netIncomeDaily}
          hourly={initialResult.netIncomeHourly}
        />
      </div>

      <!-- AUDIT TRAIL / BREAKDOWN TABLE -->
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-[color:var(--border)] pb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
            <Icon name="table" class="w-4 h-4 text-[color:var(--accent)]" />
            <span>Prospetto di Calcolo Busta Paga</span>
          </h3>
          <span class="text-xs font-mono font-bold text-[color:var(--accent)]" data-effective-rate>
            {formatPercent(initialResult.effectiveTotalDeductionRate, 1)}
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40 font-medium">
            <span class="text-[color:var(--muted)]">Retribuzione Annua Lorda (RAL)</span>
            <span class="font-bold text-[color:var(--fg)]" data-res-gross>
              {formatCurrency(initialResult.grossIncome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Min: Contributi INPS (9.19%)</span>
            <span class="font-bold text-[color:var(--fg)]" data-res-inps>
              -{formatCurrency(initialResult.inpsContribution, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40 font-bold bg-[color:var(--bg)] px-2 rounded-none">
            <span class="text-[color:var(--fg)]">Imponibile Fiscale IRPEF</span>
            <span class="text-[color:var(--fg)]" data-res-taxable>
              {formatCurrency(initialResult.taxableIncomeIrpef, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">IRPEF Lorda</span>
            <span class="font-bold text-[color:var(--accent)]" data-res-gross-irpef>
              {formatCurrency(initialResult.grossIrpef, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Min: Detrazione Lavoro Dipendente</span>
            <span class="font-bold text-[color:var(--accent)]" data-res-detrazione>
              -{formatCurrency(initialResult.employeeTaxCredit, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40 font-bold">
            <span class="text-[color:var(--fg)]">IRPEF Netta Nazionale</span>
            <span class="text-[color:var(--fg)]" data-res-net-irpef>
              {formatCurrency(initialResult.netIrpef, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Addizionale Regionale</span>
            <span class="font-bold text-[color:var(--fg)]" data-res-reg-tax>
              {formatCurrency(initialResult.regionalSurcharge, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-1.5 border-b border-[color:var(--border)]/40">
            <span class="text-[color:var(--muted)]">Addizionale Comunale</span>
            <span class="font-bold text-[color:var(--fg)]" data-res-com-tax>
              {formatCurrency(initialResult.municipalSurcharge, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-2 border-t-2 border-[color:var(--border)] text-sm font-extrabold">
            <span class="text-[color:var(--fg)]">Totale Trattenute Fiscali e Previdenziali</span>
            <span class="text-red-500" data-res-total-deductions>
              {formatCurrency(initialResult.totalTaxAndDeductions, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>

          <div class="flex justify-between py-2 rounded-none bg-[color:var(--accent)]/10 px-3 text-sm font-black text-[color:var(--accent)]">
            <span>Stipendio Netto Annuo</span>
            <span data-res-net-takehome>
              {formatCurrency(initialResult.netIncomeAnnual, profile.defaultCurrency, profile.defaultCurrencySymbol)}
            </span>
          </div>
        </div>

        <div class="pt-2 flex justify-between text-xs text-[color:var(--muted)] border-t border-[color:var(--border)]/40">
          <span>Aliquota Marginale IRPEF: <strong class="text-[color:var(--fg)]" data-marginal-rate>{formatPercent(initialResult.marginalTaxRate, 0)}</strong></span>
          <span>Pressione Fiscale Totale: <strong class="text-[color:var(--fg)]" data-effective-tax-rate>{formatPercent(initialResult.effectiveTotalDeductionRate, 1)}</strong></span>
        </div>
      </div>

      <!-- SCAGLIONI IRPEF BRACKETS TABLE (Shared Primitive) -->
      <div>
        <TaxBracketsTable
          breakdown={initialResult.bracketBreakdown || []}
          currencySymbol={profile.defaultCurrencySymbol}
        />
      </div>

    </div>
  </div>

  <!-- Parameter Explanations -->
  <div class="mt-8 border-t border-[color:var(--border)] pt-8">
    <CalculatorParameterGuide parameters={taxParameterGuide} />
  </div>

  <!-- Disclaimer Footer -->
  <div class="mt-8">
    <TaxDisclaimer />
  </div>
</div>

<script>
  import { calculateItTax } from '../../utils/tax/it-engine';

  function setupItTaxCalculator() {
    const apps = document.querySelectorAll('[data-tax-app][data-country-id="it"]');

    apps.forEach((app) => {
      try {
        const profileJson = app.getAttribute('data-profile-json');
        if (!profileJson) return;
        const profile = JSON.parse(profileJson);

        // Controls
        const yearSelect = app.querySelector('[data-tax-year]') as HTMLSelectElement | null;
        const engineTabs = Array.from(app.querySelectorAll('[data-engine-tab]')) as HTMLElement[];
        const salaryInput = app.querySelector('[data-it-salary]') as HTMLInputElement | null;
        const mensilitaSelect = app.querySelector('[data-it-mensilita]') as HTMLSelectElement | null;
        const regionSelect = app.querySelector('[data-it-region]') as HTMLSelectElement | null;
        const detrazioneDisplay = app.querySelector('[data-it-detrazione-amount]');

        // Mode State
        let currentMode: 'advanced' | 'quick' = 'advanced';

        // Hero Outputs
        const heroAmount = app.querySelector('[data-hero-amount]');
        const heroSubtext = app.querySelector('[data-hero-subtext]');
        const heroIncomeTax = app.querySelector('[data-hero-incometax]');
        const heroSocial = app.querySelector('[data-hero-social]');
        const marginalRateEl = app.querySelector('[data-marginal-rate]');
        const effectiveRateEl = app.querySelector('[data-effective-rate]');
        const effectiveTaxRateEl = app.querySelector('[data-effective-tax-rate]');

        // Allocation Bar
        const barTakehome = app.querySelector('[data-bar-takehome]') as HTMLElement | null;
        const barFedtax = app.querySelector('[data-bar-fedtax]') as HTMLElement | null;
        const barFica = app.querySelector('[data-bar-fica]') as HTMLElement | null;
        const barPretax = app.querySelector('[data-bar-pretax]') as HTMLElement | null;
        const allocationLabel = app.querySelector('[data-allocation-label]');

        // Paycheck Schedule
        const schedMonthly = app.querySelector('[data-sched-monthly]');
        const schedSemiMonthly = app.querySelector('[data-sched-semimonthly]');
        const schedBiweekly = app.querySelector('[data-sched-biweekly]');
        const schedWeekly = app.querySelector('[data-sched-weekly]');
        const schedDaily = app.querySelector('[data-sched-daily]');
        const schedHourly = app.querySelector('[data-sched-hourly]');

        // Audit Trail Elements
        const resGross = app.querySelector('[data-res-gross]');
        const resInps = app.querySelector('[data-res-inps]');
        const resTaxable = app.querySelector('[data-res-taxable]');
        const resGrossIrpef = app.querySelector('[data-res-gross-irpef]');
        const resDetrazione = app.querySelector('[data-res-detrazione]');
        const resNetIrpef = app.querySelector('[data-res-net-irpef]');
        const resRegTax = app.querySelector('[data-res-reg-tax]');
        const resComTax = app.querySelector('[data-res-com-tax]');
        const resTotalDeductions = app.querySelector('[data-res-total-deductions]');
        const resNetTakeHome = app.querySelector('[data-res-net-takehome]');
        const bracketTbody = app.querySelector('[data-bracket-tbody]');
        const copySummaryBtn = app.querySelector('[data-copy-summary-btn]');

        function fmt(n: number): string {
          return '€' + Math.round(n).toLocaleString('it-IT');
        }

        function calculate() {
          const selectedYear = yearSelect ? yearSelect.value : profile.defaultTaxYear;
          const mensilita = mensilitaSelect ? parseInt(mensilitaSelect.value || '13', 10) : 13;
          const gross = Math.max(0, parseFloat(salaryInput?.value || '0') || 0);

          const regCode = regionSelect ? regionSelect.value : undefined;
          const res = calculateItTax({
            grossIncome: gross,
            taxYear: selectedYear,
            regionCode: regCode,
          });

          const inps = res.inpsContribution;
          const taxableIrpef = res.taxableIncomeIrpef;
          const grossIrpef = res.grossIrpef;
          const detrazione = res.employeeTaxCredit;
          const netIrpef = res.netIrpef;
          const regionalSurcharge = res.regionalSurcharge;
          const municipalSurcharge = res.municipalSurcharge;
          const totalIncomeTax = res.totalIncomeTax;
          const totalDeductions = res.totalTaxAndDeductions;
          const netTakeHome = res.netIncomeAnnual;
          const effectiveDeductionRate = res.effectiveTotalDeductionRate;
          const marginalRate = res.marginalTaxRate;

          if (detrazioneDisplay) detrazioneDisplay.textContent = fmt(detrazione);

          // Update Hero
          if (heroAmount) heroAmount.textContent = fmt(netTakeHome);
          if (heroSubtext) {
            heroSubtext.textContent = `${fmt(netTakeHome / mensilita)}/mese (${mensilita} mensilità) · ${fmt(netTakeHome / 52)}/settimana`;
          }
          if (heroIncomeTax) heroIncomeTax.textContent = fmt(totalIncomeTax);
          if (heroSocial) heroSocial.textContent = fmt(inps);
          if (effectiveRateEl) effectiveRateEl.textContent = `${effectiveDeductionRate.toFixed(1)}%`;
          if (effectiveTaxRateEl) effectiveTaxRateEl.textContent = `${effectiveDeductionRate.toFixed(1)}%`;
          if (marginalRateEl) marginalRateEl.textContent = `${marginalRate.toFixed(0)}%`;

          // Paycheck Schedule
          if (schedMonthly) schedMonthly.textContent = fmt(netTakeHome / mensilita);
          if (schedSemiMonthly) schedSemiMonthly.textContent = fmt(netTakeHome / (mensilita * 2));
          if (schedBiweekly) schedBiweekly.textContent = fmt(netTakeHome / 26);
          if (schedWeekly) schedWeekly.textContent = fmt(netTakeHome / 52);
          if (schedDaily) schedDaily.textContent = fmt(netTakeHome / 260);
          if (schedHourly) schedHourly.textContent = fmt(netTakeHome / 2080);

          // Audit Trail
          if (resGross) resGross.textContent = fmt(gross);
          if (resInps) resInps.textContent = `-${fmt(inps)}`;
          if (resTaxable) resTaxable.textContent = fmt(taxableIrpef);
          if (resGrossIrpef) resGrossIrpef.textContent = fmt(grossIrpef);
          if (resDetrazione) resDetrazione.textContent = detrazione > 0 ? `-${fmt(detrazione)}` : '-€0';
          if (resNetIrpef) resNetIrpef.textContent = fmt(netIrpef);
          if (resRegTax) resRegTax.textContent = fmt(regionalSurcharge);
          if (resComTax) resComTax.textContent = fmt(municipalSurcharge);
          if (resTotalDeductions) resTotalDeductions.textContent = fmt(totalDeductions);
          if (resNetTakeHome) resNetTakeHome.textContent = fmt(netTakeHome);

          // Allocation Bar
          if (gross > 0) {
            const pctTakehome = Math.max(0, (netTakeHome / gross) * 100);
            const pctIrpef = Math.max(0, (totalIncomeTax / gross) * 100);
            const pctInps = Math.max(0, (inps / gross) * 100);

            if (barTakehome) barTakehome.style.width = `${pctTakehome}%`;
            if (barFedtax) barFedtax.style.width = `${pctIrpef}%`;
            if (barFica) barFica.style.width = `${pctInps}%`;
            if (barPretax) barPretax.style.width = `0%`;

            if (allocationLabel) {
              allocationLabel.textContent = `Netto: ${pctTakehome.toFixed(1)}% · IRPEF: ${pctIrpef.toFixed(1)}% · INPS: ${pctInps.toFixed(1)}%`;
            }
          }

          // Bracket Table
          if (bracketTbody) {
            bracketTbody.innerHTML = res.bracketBreakdown
              .map(
                (row) => `
                <tr class="border-b border-[color:var(--border)]/40 hover:bg-[color:var(--bg)]/50 transition">
                  <td class="py-2 px-3 font-medium text-[color:var(--fg)]">${row.bracketRange}</td>
                  <td class="py-2 px-3 text-right font-mono text-[color:var(--muted)]">${row.ratePercent}</td>
                  <td class="py-2 px-3 text-right font-mono font-medium text-[color:var(--fg)]">${fmt(row.taxableInBracket)}</td>
                  <td class="py-2 px-3 text-right font-mono font-bold text-[color:var(--fg)]">${fmt(row.taxAmount)}</td>
                </tr>
              `
              )
              .join('');
          }
        }

        // Mode Switching
        engineTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const mode = tab.getAttribute('data-engine-tab') as 'advanced' | 'quick';
            if (!mode) return;
            currentMode = mode;

            engineTabs.forEach((t) => {
              if (t === tab) {
                t.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active';
              } else {
                t.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5';
              }
            });

            const advSections = app.querySelectorAll('[data-advanced-section]');
            advSections.forEach((sec) => {
              if (mode === 'quick') {
                sec.classList.add('hidden');
              } else {
                sec.classList.remove('hidden');
              }
            });

            calculate();
          });
        });

        // Event Listeners
        salaryInput?.addEventListener('input', calculate);
        mensilitaSelect?.addEventListener('change', calculate);
        regionSelect?.addEventListener('change', calculate);
        yearSelect?.addEventListener('change', calculate);

        // Copy Report
        copySummaryBtn?.addEventListener('click', () => {
          const gross = salaryInput?.value || '0';
          const net = heroAmount?.textContent || '€0';
          const tax = heroIncomeTax?.textContent || '€0';
          const soc = heroSocial?.textContent || '€0';
          const eff = effectiveRateEl?.textContent || '0%';
          const summary = `--- Calcolo Stipendio Netto Italia (AdE 2026 IRPEF) ---\nRAL Lorda: €${gross}\nStipendio Netto Annuo: ${net}\nIRPEF & Addizionali: ${tax}\nContributi INPS (9.19%): ${soc}\nPressione Fiscale: ${eff}\nCalcolato tramite Toolscastle Tax Platform`;

          navigator.clipboard.writeText(summary).then(() => {
            const btnSpan = copySummaryBtn.querySelector('span');
            if (btnSpan) {
              const orig = btnSpan.textContent;
              btnSpan.textContent = 'Copiato negli appunti!';
              setTimeout(() => {
                btnSpan.textContent = orig;
              }, 2000);
            }
          });
        });

        // Initialize
        calculate();
      } catch (err) {
        console.error('Error initializing IT tax calculator:', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupItTaxCalculator);
  } else {
    setupItTaxCalculator();
  }
</script>

