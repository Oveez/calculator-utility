---
import type { CountryTaxProfile } from '../../data/tax/types';
import { calculateCaTax } from '../../utils/tax/ca-engine';
import { formatCurrency, formatPercent } from '../../utils/tax/formatters';
import TaxDisclaimer from './TaxDisclaimer.astro';
import CalculatorParameterGuide from '../calculator/CalculatorParameterGuide.astro';
import Icon from '../Icon.astro';
import TaxYearSelector from './shared/TaxYearSelector.astro';
import TaxAllocationBar from './shared/TaxAllocationBar.astro';
import PaycheckFrequencyTable from './shared/PaycheckFrequencyTable.astro';
import TaxBreakdownTable from './shared/TaxBreakdownTable.astro';
import TaxBracketsTable from './shared/TaxBracketsTable.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';

interface Props {
  profile: CountryTaxProfile;
  initialIncome?: number;
}

const { profile, initialIncome = 0 } = Astro.props;

// Initial server-rendered baseline calculations for Canada
const initialResult = calculateCaTax(profile, initialIncome, {
  taxYear: profile.defaultTaxYear,
  regionCode: 'on',
});

const defaultYearData = profile.years[profile.defaultTaxYear];

const taxParameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'grossSalary',
    name: 'Gross Annual Employment Income',
    description: 'Total annual earnings before tax, CPP/EI deductions, or RRSP contributions recorded on Box 14 of your T4 tax slip.',
    whyItMatters: 'The starting baseline from which federal and provincial taxable income is derived.',
    typicalRange: 'Any positive earnings',
    unit: 'CAD ($)',
  },
  {
    id: 'province',
    name: 'Province or Territory of Residence',
    description: 'Your province of residence on December 31 dictates your provincial tax brackets, rates, and provincial basic personal amounts.',
    whyItMatters: 'Provincial income tax varies significantly across Canada (e.g. Ontario, Alberta, BC, Quebec).',
    typicalRange: 'Provinces & Territories',
    unit: 'Province',
  },
  {
    id: 'bpa',
    name: 'Basic Personal Amount (BPA)',
    description: 'The federal Basic Personal Amount ($16,452 for 2026) is a non-refundable tax credit calculated at 14%, reducing federal tax payable.',
    whyItMatters: 'Ensures that lower earnings are protected from federal and provincial taxation.',
    typicalRange: '$16,452 Federal',
    unit: 'CAD ($)',
  },
  {
    id: 'cpp',
    name: 'Canada Pension Plan (CPP / QPP)',
    description: 'Employee contribution of 5.95% on pensionable earnings between $3,500 and $74,600 (maximum $4,230.45), plus CPP2 on higher earnings.',
    whyItMatters: 'Guarantees monthly retirement, survivor, and disability pensions through Service Canada.',
    typicalRange: '5.95% (up to $4,230.45)',
    unit: 'CAD ($)',
  },
  {
    id: 'ei',
    name: 'Employment Insurance (EI)',
    description: 'Employee contribution of 1.63% up to maximum insurable earnings of $68,900 (maximum $1,123.07 for 2026).',
    whyItMatters: 'Provides temporary financial relief during unemployment, parental leave, or sickness.',
    typicalRange: '1.63% (up to $1,123.07)',
    unit: 'CAD ($)',
  },
  {
    id: 'rrsp',
    name: 'RRSP Contributions (Pre-Tax Deduction)',
    description: 'Deductible contributions to your Registered Retirement Savings Plan (subject to your CRA notice of assessment contribution limit).',
    whyItMatters: 'Deductions directly reduce your net taxable income at your highest marginal bracket.',
    typicalRange: 'Up to 18% of prior year income',
    unit: 'CAD ($)',
  },
];
---

<div
  class="space-y-8"
  data-tax-app
  data-country-id="ca"
  data-profile-json={JSON.stringify(profile)}
>
  <!-- Top Bar: Country Info & Mode Switcher -->
  <div class="flex flex-col gap-4 border-b border-[color:var(--border)] pb-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <span class="text-3xl sm:text-4xl select-none">{profile.flagEmoji}</span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)] sm:text-2xl">
            Canada Income Tax &amp; CRA Salary Calculator
          </h2>
          <span class="inline-flex items-center rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-semibold text-[color:var(--accent)] border border-[color:var(--accent)]/30">
            Official 2026 CRA Data
          </span>
        </div>
        <p class="text-xs text-[color:var(--muted)]">
          Source: <a href={defaultYearData.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-[color:var(--accent)] hover:underline">{defaultYearData.officialSourceName}</a> • Verified {defaultYearData.lastVerifiedDate}
        </p>
      </div>
    </div>

    <!-- App Tabs & Tax Year -->
    <div class="flex flex-wrap items-center gap-2">
      <TaxYearSelector profile={profile} id="ca-tax-year-select" />

      <!-- Engine View Toggle -->
      <div class="flex items-center rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-1 text-xs font-semibold overflow-x-auto no-scrollbar max-w-full shrink-0">
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active"
          data-engine-tab="advanced"
        >
          <Icon name="bolt" class="w-3.5 h-3.5" />
          <span>Detailed CRA Mode</span>
        </button>
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5"
          data-engine-tab="quick"
        >
          <Icon name="calculator" class="w-3.5 h-3.5" />
          <span>Quick Salary</span>
        </button>
      </div>
    </div>
  </div>

  <!-- HERO DYNAMIC TAKE-HOME BANNER -->
  <div class="mt-6 border-b border-[color:var(--border)] pb-6 space-y-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Net Take-Home Pay</span>
          <span
            data-hero-badge
            class="inline-flex items-center gap-1 rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-bold text-[color:var(--accent)] border border-[color:var(--accent)]/30"
          >
            Estimated Take-Home
          </span>
        </div>
        <p class="mt-1 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl text-[color:var(--fg)]" data-hero-amount>
          {formatCurrency(initialResult.netIncomeAnnual, profile.defaultCurrency, profile.defaultCurrencySymbol)}
        </p>
        <p class="mt-1 text-xs text-[color:var(--muted)]" data-hero-subtext>
          {formatCurrency(initialResult.netIncomeMonthly, profile.defaultCurrency, profile.defaultCurrencySymbol)}/month · {formatCurrency(initialResult.netIncomeWeekly, profile.defaultCurrency, profile.defaultCurrencySymbol)}/week
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 border-t border-[color:var(--border)]/60 pt-3 md:border-t-0 md:pt-0">
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Federal Tax (CRA)</p>
          <p class="text-base font-extrabold text-[color:var(--accent)]blue>
            {formatCurrency(initialResult.nationalIncomeTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">After Federal BPA</p>
        </div>
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Provincial Tax</p>
          <p class="text-base font-extrabold text-[color:var(--accent)]purple>
            {formatCurrency(initialResult.regionalIncomeTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Based on Province</p>
        </div>
        <div class="col-span-2 sm:col-span-1 rounded-none border border-[color:var(--border)] bg-white p-3 flex flex-col justify-between">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Action</p>
          <button
            type="button"
            data-copy-summary-btn
            class="inline-flex items-center justify-center gap-1.5 rounded-none bg-[color:var(--surface)] px-2.5 py-1.5 text-xs font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
          >
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy Canada Tax Report</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Reusable Income Allocation Bar -->
    <TaxAllocationBar />
  </div>

  <!-- CALCULATOR MAIN BODY -->
  <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- LEFT COLUMN: INPUT FORMS -->
    <div class="space-y-6">

      <!-- SECTION 1: Earnings & Province -->
      <div class="space-y-4 border-b border-[color:var(--border)] pb-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
          <Icon name="user" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>1. Employment Income &amp; Province</span>
        </h3>

        <div class="space-y-4">
          <!-- Gross Salary -->
          <div>
            <div class="flex justify-between items-center text-xs">
              <label for="ca-gross-salary" class="font-bold text-[color:var(--fg)]">
                Annual Gross Employment Income ($ CAD)
              </label>
              <span class="text-[color:var(--muted)] font-mono">T4 Box 14</span>
            </div>
            <div class="relative mt-1.5">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-bold text-[color:var(--muted)]">
                $
              </span>
              <input
                id="ca-gross-salary"
                type="number"
                min="0"
                step="1000"
                placeholder="e.g. 100,000"
                class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-3 pl-8 pr-4 text-base font-black text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent)]/20"
                data-ca-salary />
            </div>
          </div>

          <!-- Province Selection -->
          <div>
            <label for="ca-province-select" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
              Province or Territory of Residence
            </label>
            <select
              id="ca-province-select"
              class="mt-1.5 w-full cursor-pointer rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-sm font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              data-ca-province
            >
              {defaultYearData.regions?.map((reg) => (
                <option value={reg.code} selected={reg.code === 'on'}>
                  {reg.name}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- SECTION 2: RRSP & Deductions (Detailed Mode) -->
      <div class="space-y-4 border-b border-[color:var(--border)] pb-6" data-adv-only>
        <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
          <Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>2. Registered Savings &amp; Tax Deductions</span>
        </h3>

        <div class="space-y-3">
          <div>
            <div class="flex justify-between items-center text-xs">
              <label for="ca-rrsp" class="font-medium text-[color:var(--fg)]">RRSP Annual Contribution ($)</label>
              <span class="text-[color:var(--muted)]">Pre-Tax Deduction</span>
            </div>
            <div class="relative mt-1">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-bold text-[color:var(--muted)]">$</span>
              <input
                id="ca-rrsp"
                type="number"
                min="0"
                step="500"
                placeholder="e.g. 10,000"
                class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-2 pl-7 pr-3 text-sm font-bold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
                data-ca-rrsp />
            </div>
            <p class="text-[10px] text-[color:var(--muted)] mt-1">
              Contributions reduce both federal and provincial taxable income dollar-for-dollar.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: RESULTS, PAYCHECK SCHEDULE & AUDIT TRAIL -->
    <div class="space-y-6">
      <!-- Reusable Paycheck Schedule Card -->
      <PaycheckFrequencyTable
        netAnnualTakeHome={initialResult.netIncomeAnnual}
        currency={profile.defaultCurrency}
        currencySymbol={profile.defaultCurrencySymbol}
      />

      <!-- Reusable Canada Audit Trail -->
      <TaxBreakdownTable
        title="Canada & Provincial Tax Audit Breakdown (2026)"
        currency={profile.defaultCurrency}
        currencySymbol={profile.defaultCurrencySymbol}
        totalGrossIncome={initialResult.grossIncome}
        totalAdjustments={0}
        adjustedGrossIncome={initialResult.grossIncome}
        deductionAmount={initialResult.standardDeduction}
        deductionLabel="Basic Personal Amount (BPA)"
        taxableIncome={initialResult.taxableIncome}
        regularIncomeTax={initialResult.nationalIncomeTax}
        netFederalIncomeTax={initialResult.nationalIncomeTax}
        totalFicaTax={initialResult.totalSocialContributions}
        ficaLabel="CPP & EI Payroll Contributions"
        stateIncomeTax={initialResult.regionalIncomeTax}
        stateTaxName="Provincial Income Tax"
        totalAllTaxes={initialResult.totalTaxAndDeductions}
        totalPaymentsAndWithholdings={0}
        federalRefundOrOwed={0}
      />

      <!-- Marginal Rates Summary Card -->
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-4 shadow-sm">
          <p class="text-xs font-medium text-[color:var(--muted)]">Combined Marginal Rate</p>
          <p class="mt-1 text-2xl font-bold text-[color:var(--accent)]" data-marginal-rate>
            {formatPercent(initialResult.marginalTaxRate, 1)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Federal + Provincial top slice</p>
        </div>

        <div class="rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-4 shadow-sm">
          <p class="text-xs font-medium text-[color:var(--muted)]">Effective Average Rate</p>
          <p class="mt-1 text-2xl font-bold text-[color:var(--fg)]" data-effective-rate>
            {formatPercent(initialResult.effectiveTotalDeductionRate, 1)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">All deductions / Gross salary</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Reusable Progressive Tax Bracket Table -->
  <TaxBracketsTable
    taxYear={profile.defaultTaxYear}
    brackets={initialResult.bracketBreakdown}
    currency={profile.defaultCurrency}
    currencySymbol={profile.defaultCurrencySymbol}
  />

  <!-- Step-by-Step Worked Calculation Example -->
  <section class="mt-8 space-y-4 border-b border-[color:var(--border)] pb-6">
    <h3 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
      <Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" />
      <span>Step-by-Step Worked Calculation Example (Ontario {defaultYearData.taxYear})</span>
    </h3>
    <div class="space-y-3 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
      <p>
        Here is how take-home pay is computed for an annual gross salary of <strong class="text-[color:var(--fg)] font-mono">$100,000 CAD</strong> in Ontario:
      </p>
      <ol class="list-decimal pl-5 space-y-2">
        <li>
          <strong class="text-[color:var(--fg)]">Apply Federal &amp; Provincial Basic Personal Amount:</strong><br />
          Federal BPA of $16,452 is subtracted, leaving a federal taxable base of <strong class="text-[color:var(--fg)] font-mono">$83,548</strong>.
        </li>
        <li>
          <strong class="text-[color:var(--fg)]">Calculate Federal Income Tax:</strong><br />
          14% on the first $58,523 ($8,193.22) + 20.5% on the remaining $25,025 ($5,130.13), totaling <strong class="text-[color:var(--fg)] font-bold">$13,323.35</strong>.
        </li>
        <li>
          <strong class="text-[color:var(--fg)]">Calculate Ontario Provincial Income Tax:</strong><br />
          5.05% on the first $53,891 ($2,721.50) + 9.15% on the remaining $29,657 ($2,713.62), totaling <strong class="text-[color:var(--fg)] font-bold">$5,435.11</strong>.
        </li>
        <li>
          <strong class="text-[color:var(--fg)]">Deduct Mandatory CPP &amp; EI:</strong><br />
          CPP contribution of 5.95% ($4,230.45) and EI premium of 1.63% ($1,123.07) total <strong class="text-[color:var(--fg)] font-bold">$5,353.52</strong>.
        </li>
        <li>
          <strong class="text-[color:var(--fg)]">Net Take-Home Pay:</strong><br />
          $100,000 − ($13,323.35 + $5,435.11 + $5,353.52) = <strong class="text-[color:var(--accent)] font-extrabold font-mono">$75,888.02</strong>/year ($6,324.00 per month).
        </li>
      </ol>
    </div>
  </section>

  <!-- Parameter Documentation Guide -->
  <div class="mt-8">
    <CalculatorParameterGuide parameters={taxParameterGuide} />
  </div>

  <!-- Statutory Assumptions & Official Source -->
  <footer class="mt-8 pt-6 border-t border-[color:var(--border)] text-xs text-[color:var(--muted)] space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-none bg-[color:var(--accent)]"></span>
        <span class="font-medium text-[color:var(--fg)]">Official Authority:</span>
        <a href={defaultYearData.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="text-[color:var(--accent)] hover:underline font-semibold">
          {defaultYearData.officialSourceName} ({defaultYearData.taxYear})
        </a>
      </div>
      <span>Last data audit: <time datetime={defaultYearData.lastVerifiedDate}>{defaultYearData.lastVerifiedDate}</time></span>
    </div>
    <ul class="list-disc pl-5 space-y-1 text-[11px]">
      {defaultYearData.assumptions.map((asm) => (
        <li>{asm}</li>
      ))}
    </ul>
    <TaxDisclaimer countryName={profile.name} taxYear={defaultYearData.taxYear} />
  </footer>
</div>

<script>
  import { calculateCaTax } from '../../utils/tax/ca-engine';

  function initCaTaxCalculator() {
    const apps = document.querySelectorAll('[data-tax-app][data-country-id="ca"]');

    apps.forEach((app) => {
      try {
        const profileJson = app.getAttribute('data-profile-json');
        if (!profileJson) return;
        const profile = JSON.parse(profileJson);

        // Controls
        const yearSelect = app.querySelector('[data-tax-year]') as HTMLSelectElement | null;
        const engineTabs = Array.from(app.querySelectorAll('[data-engine-tab]')) as HTMLElement[];
        const provinceSelect = app.querySelector('[data-ca-province]') as HTMLSelectElement | null;
        const salaryInput = app.querySelector('[data-ca-salary]') as HTMLInputElement | null;
        const rrspInput = app.querySelector('[data-ca-rrsp]') as HTMLInputElement | null;

        // Current mode state
        let currentMode: 'advanced' | 'quick' = 'advanced';

        // Dynamic Outputs
        const heroAmount = app.querySelector('[data-hero-amount]');
        const heroSubtext = app.querySelector('[data-hero-subtext]');
        const heroFedTax = app.querySelector('[data-hero-fedtax]');
        const heroProvTax = app.querySelector('[data-hero-provtax]');
        const heroEffectiveRate = app.querySelector('[data-hero-effective-rate]');
        const marginalRateEl = app.querySelector('[data-marginal-rate]');
        const effectiveRateEl = app.querySelector('[data-effective-rate]');

        // Allocation Bar
        const barTakehome = app.querySelector('[data-bar-takehome]') as HTMLElement | null;
        const barFedtax = app.querySelector('[data-bar-fedtax]') as HTMLElement | null;
        const barFica = app.querySelector('[data-bar-fica]') as HTMLElement | null;
        const barStatetax = app.querySelector('[data-bar-statetax]') as HTMLElement | null;
        const barPretax = app.querySelector('[data-bar-pretax]') as HTMLElement | null;
        const allocationLabel = app.querySelector('[data-allocation-label]');

        // Paycheck Schedule
        const schedMonthly = app.querySelector('[data-sched-monthly]');
        const schedSemiMonthly = app.querySelector('[data-sched-semimonthly]');
        const schedBiweekly = app.querySelector('[data-sched-biweekly]');
        const schedWeekly = app.querySelector('[data-sched-weekly]');
        const schedDaily = app.querySelector('[data-sched-daily]');
        const schedHourly = app.querySelector('[data-sched-hourly]');

        // Audit Trail Elements
        const resGross = app.querySelector('[data-res-gross]');
        const resAdjustments = app.querySelector('[data-res-adjustments]');
        const resAgi = app.querySelector('[data-res-agi]');
        const resDeduction = app.querySelector('[data-res-deduction]');
        const resTaxable = app.querySelector('[data-res-taxable]');
        const resRegularTax = app.querySelector('[data-res-regular-tax]');
        const resNetFed = app.querySelector('[data-res-net-fed]');
        const resFica = app.querySelector('[data-res-fica]');
        const resStateName = app.querySelector('[data-res-state-name]');
        const resStateTax = app.querySelector('[data-res-state-tax]');
        const resTotalTax = app.querySelector('[data-res-total-tax]');
        const bracketTbody = app.querySelector('[data-bracket-tbody]');
        const copySummaryBtn = app.querySelector('[data-copy-summary-btn]');

        function fmt(n: number): string {
          return '$' + Math.round(n).toLocaleString('en-US');
        }

        function calculate() {
          const selectedYear = yearSelect ? yearSelect.value : profile.defaultTaxYear;
          const province = provinceSelect ? provinceSelect.value : 'on';
          const gross = Math.max(0, parseFloat(salaryInput?.value || '0') || 0);
          const rrsp = currentMode === 'advanced' ? Math.max(0, parseFloat(rrspInput?.value || '0') || 0) : 0;

          const res = calculateCaTax(profile, gross, {
            taxYear: selectedYear,
            regionCode: province,
            customDeductions: rrsp,
          });

          // Update Hero UI
          if (heroAmount) heroAmount.textContent = fmt(res.netIncomeAnnual);
          if (heroSubtext) heroSubtext.textContent = `${fmt(res.netIncomeAnnual / 12)}/month · ${fmt(res.netIncomeAnnual / 52)}/week`;
          if (heroFedTax) heroFedTax.textContent = fmt(res.nationalIncomeTax);
          if (heroProvTax) heroProvTax.textContent = fmt(res.regionalIncomeTax);
          if (heroEffectiveRate) heroEffectiveRate.textContent = `${res.effectiveTotalDeductionRate.toFixed(1)}%`;
          if (effectiveRateEl) effectiveRateEl.textContent = `${res.effectiveTotalDeductionRate.toFixed(1)}%`;
          if (marginalRateEl) marginalRateEl.textContent = `${res.marginalTaxRate.toFixed(1)}%`;

          // Paycheck Schedule
          if (schedMonthly) schedMonthly.textContent = fmt(res.netIncomeMonthly);
          if (schedSemiMonthly) schedSemiMonthly.textContent = fmt(res.netIncomeAnnual / 24);
          if (schedBiweekly) schedBiweekly.textContent = fmt(res.netIncomeBiweekly);
          if (schedWeekly) schedWeekly.textContent = fmt(res.netIncomeWeekly);
          if (schedDaily) schedDaily.textContent = fmt(res.netIncomeDaily);
          if (schedHourly) schedHourly.textContent = fmt(res.netIncomeHourly);

          // Allocation Bar
          const denom = Math.max(gross, 1);
          const thPct = Math.min(100, Math.max(0, (res.netIncomeAnnual / denom) * 100));
          const fedPct = Math.min(100, Math.max(0, (res.nationalIncomeTax / denom) * 100));
          const provPct = Math.min(100, Math.max(0, (res.regionalIncomeTax / denom) * 100));
          const socPct = Math.min(100, Math.max(0, (res.totalSocialContributions / denom) * 100));
          const rrspPct = Math.min(100, Math.max(0, (rrsp / denom) * 100));

          if (barTakehome) barTakehome.style.width = `${thPct}%`;
          if (barFedtax) barFedtax.style.width = `${fedPct}%`;
          if (barStatetax) barStatetax.style.width = `${provPct}%`;
          if (barFica) barFica.style.width = `${socPct}%`;
          if (barPretax) barPretax.style.width = `${rrspPct}%`;
          if (allocationLabel) {
            allocationLabel.textContent = `Take-Home: ${thPct.toFixed(0)}% | Taxes & Deductions: ${((res.totalTaxAndDeductions / denom) * 100).toFixed(0)}%`;
          }

          // Audit Breakdown Values
          if (resGross) resGross.textContent = fmt(gross);
          if (resAdjustments) resAdjustments.textContent = `-${fmt(rrsp)}`;
          if (resAgi) resAgi.textContent = fmt(gross - rrsp);
          if (resDeduction) resDeduction.textContent = `-${fmt(res.standardDeduction)}`;
          if (resTaxable) resTaxable.textContent = fmt(res.taxableIncome);
          if (resRegularTax) resRegularTax.textContent = fmt(res.nationalIncomeTax);
          if (resNetFed) resNetFed.textContent = fmt(res.nationalIncomeTax);
          const reg = profile.years[selectedYear]?.regions?.find((r: any) => r.code === province);
          if (resStateName) resStateName.textContent = reg?.name || 'Provincial Tax';
          if (resStateTax) resStateTax.textContent = fmt(res.regionalIncomeTax);
          if (resFica) resFica.textContent = fmt(res.totalSocialContributions);
          if (resTotalTax) resTotalTax.textContent = fmt(res.totalTaxAndDeductions);

          // Bracket Table Render
          if (bracketTbody) {
            bracketTbody.innerHTML = res.bracketBreakdown
              .map(
                (row) => `
              <tr>
                <td class="px-4 py-2.5 font-mono">${row.bracketRange}</td>
                <td class="px-4 py-2.5 font-bold">${row.ratePercent}</td>
                <td class="px-4 py-2.5">${fmt(row.taxableInBracket)}</td>
                <td class="px-4 py-2.5 text-right font-mono font-bold text-[color:var(--fg)]">${fmt(row.taxAmount)}</td>
              </tr>
            `
              )
              .join('');
          }
        }

        // Mode Switching
        function switchMode(newMode: 'advanced' | 'quick') {
          currentMode = newMode;
          engineTabs.forEach((tab) => {
            const tabMode = tab.getAttribute('data-engine-tab');
            if (tabMode === newMode) {
              tab.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active';
            } else {
              tab.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5';
            }
          });

          const advOnlyElements = app.querySelectorAll('[data-adv-only]');
          advOnlyElements.forEach((el) => {
            if (newMode === 'quick') {
              (el as HTMLElement).style.display = 'none';
            } else {
              (el as HTMLElement).style.display = '';
            }
          });

          calculate();
        }

        engineTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const m = tab.getAttribute('data-engine-tab') as 'advanced' | 'quick';
            if (m) switchMode(m);
          });
        });

        const allInputs = app.querySelectorAll('input, select');
        allInputs.forEach((inp) => {
          inp.addEventListener('input', calculate);
          inp.addEventListener('change', calculate);
        });

        if (copySummaryBtn) {
          copySummaryBtn.addEventListener('click', async () => {
            const takeHome = heroAmount?.textContent || '$0';
            const gross = resGross?.textContent || '$0';
            const fedVal = heroFedTax?.textContent || '$0';
            const provVal = heroProvTax?.textContent || '$0';
            const year = yearSelect ? yearSelect.value : profile.defaultTaxYear;
            const provText = provinceSelect ? provinceSelect.options[provinceSelect.selectedIndex].text : 'Ontario';

            const summary = `Canada CRA Income Tax Estimate (${year}):\n` +
              `Province: ${provText}\n` +
              `Gross Income: ${gross}\n` +
              `Federal Tax: ${fedVal}\n` +
              `Provincial Tax: ${provVal}\n` +
              `Net Annual Take-Home: ${takeHome}\n` +
              `Calculated via Toolscastle Tax Platform`;

            try {
              await navigator.clipboard.writeText(summary);
              const originalHtml = copySummaryBtn.innerHTML;
              copySummaryBtn.innerHTML = `<span>Copied!</span>`;
              setTimeout(() => {
                copySummaryBtn.innerHTML = originalHtml;
              }, 2000);
            } catch (err) {
              console.error('Clipboard copy failed', err);
            }
          });
        }

        calculate();
      } catch (err) {
        console.error('Canada tax calculator initialization error:', err);
      }
    });
  }

  initCaTaxCalculator();
  document.addEventListener('astro:page-load', initCaTaxCalculator);
</script>

