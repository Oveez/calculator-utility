---
import type { CountryTaxProfile } from '../../data/tax/types';
import { calculateUkTax } from '../../utils/tax/uk-engine';
import { formatCurrency, formatPercent } from '../../utils/tax/formatters';
import TaxDisclaimer from './TaxDisclaimer.astro';
import CalculatorParameterGuide from '../calculator/CalculatorParameterGuide.astro';
import Icon from '../Icon.astro';
import TaxYearSelector from './shared/TaxYearSelector.astro';
import TaxAllocationBar from './shared/TaxAllocationBar.astro';
import PaycheckFrequencyTable from './shared/PaycheckFrequencyTable.astro';
import TaxBreakdownTable from './shared/TaxBreakdownTable.astro';
import TaxBracketsTable from './shared/TaxBracketsTable.astro';
import type { CalculatorParameterInfo } from '../../types/calculator';

interface Props {
  profile: CountryTaxProfile;
  initialIncome?: number;
}

const { profile, initialIncome = 0 } = Astro.props;

// Initial server-rendered baseline calculations for UK
const initialResult = calculateUkTax({
  grossIncome: initialIncome,
  taxYear: profile.defaultTaxYear,
  region: 'england_wales_ni',
}, profile);

const defaultYearData = profile.years[profile.defaultTaxYear];

const taxParameterGuide: CalculatorParameterInfo[] = [
  {
    id: 'grossSalary',
    name: 'Gross Annual Salary / Wages',
    description: 'Your total pre-tax earnings from employment before PAYE income tax, National Insurance, or workplace pension contributions.',
    whyItMatters: 'The starting baseline figure from which all statutory allowances and HMRC deductions are computed.',
    typicalRange: 'Any positive earnings',
    unit: 'GBP (£)',
  },
  {
    id: 'taxRegion',
    name: 'Tax Jurisdiction (England & Wales vs Scotland)',
    description: 'The Scottish Government sets devolved income tax bands and rates (Starter, Basic, Intermediate, Higher, Advanced, Top), while England, Wales, and Northern Ireland share standard HMRC bands.',
    whyItMatters: 'Scottish taxpayers pay different marginal rates on non-savings employment income.',
    typicalRange: 'England & Wales vs Scotland',
    unit: 'Region',
  },
  {
    id: 'personalAllowance',
    name: 'Personal Allowance (£12,570 standard)',
    description: 'The amount of income you can earn each year tax-free. Standard code is 1257L.',
    whyItMatters: 'If your adjusted net income exceeds £100,000, your Personal Allowance reduces by £1 for every £2 earned above £100k, reaching zero at £125,140.',
    typicalRange: '£0 – £12,570',
    unit: 'GBP (£)',
  },
  {
    id: 'nationalInsurance',
    name: 'National Insurance (Class 1 Employee NIC)',
    description: 'Mandatory social security contributions funding state pensions and NHS benefits. 8% between £12,570 and £50,270, plus 2% on earnings above £50,270.',
    whyItMatters: 'Qualifies you for the UK state pension and statutory social insurance benefits.',
    typicalRange: '8% / 2% bands',
    unit: '%',
  },
  {
    id: 'pensionRelief',
    name: 'Workplace Pension Contributions',
    description: 'Contributions made to your auto-enrolment workplace pension scheme, often via salary sacrifice which reduces taxable pay and NIC.',
    whyItMatters: 'Builds your retirement pot tax-efficiently by receiving income tax and National Insurance relief.',
    typicalRange: '0% – 15%+',
    unit: '%',
  },
  {
    id: 'studentLoan',
    name: 'Student Loan Repayment',
    description: 'Statutory repayments based on plan threshold (Plan 1: £24,990 @ 9%, Plan 2: £27,295 @ 9%, Plan 4: £31,395 @ 9%, Plan 5: £25,000 @ 9%, Postgraduate: £21,000 @ 6%).',
    whyItMatters: 'Automatically collected via PAYE when earnings exceed your specific plan repayment threshold.',
    typicalRange: '0% – 9% over threshold',
    unit: 'Plan',
  },
];
---

<div
  class="space-y-8"
  data-tax-app
  data-country-id="uk"
  data-profile-json={JSON.stringify(profile)}
>
  <!-- Top Bar: Country Info & Mode Switcher -->
  <div class="flex flex-col gap-4 border-b border-[color:var(--border)] pb-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <span class="text-3xl sm:text-4xl select-none">{profile.flagEmoji}</span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-xl font-bold tracking-tight text-[color:var(--fg)] sm:text-2xl">
            UK Income Tax &amp; Salary Calculator
          </h2>
          <span class="inline-flex items-center rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-semibold text-[color:var(--accent)] border border-[color:var(--accent)]/30">
            Official 2026/27 HMRC Data
          </span>
        </div>
        <p class="text-xs text-[color:var(--muted)]">
          Source: <a href={defaultYearData.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-[color:var(--accent)] hover:underline">{defaultYearData.officialSourceName}</a> • Verified {defaultYearData.lastVerifiedDate}
        </p>
      </div>
    </div>

    <!-- App Tabs & Tax Year -->
    <div class="flex flex-wrap items-center gap-2">
      <TaxYearSelector profile={profile} id="uk-tax-year-select" />

      <!-- Engine View Toggle: Quick Salary vs Detailed PAYE -->
      <div class="flex items-center rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-1 text-xs font-semibold overflow-x-auto no-scrollbar max-w-full shrink-0">
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active"
          data-engine-tab="advanced"
        >
          <Icon name="bolt" class="w-3.5 h-3.5" />
          <span>Detailed PAYE Mode</span>
        </button>
        <button
          type="button"
          class="shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5"
          data-engine-tab="quick"
        >
          <Icon name="calculator" class="w-3.5 h-3.5" />
          <span>Quick Salary</span>
        </button>
      </div>
    </div>
  </div>

  <!-- HERO DYNAMIC TAKE-HOME BANNER -->
  <div class="mt-6 border-b border-[color:var(--border)] pb-6 space-y-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">Net Take-Home Pay</span>
          <span
            data-hero-badge
            class="inline-flex items-center gap-1 rounded-none bg-[color:var(--accent-soft)] px-2.5 py-0.5 text-xs font-bold text-[color:var(--accent)] border border-[color:var(--accent)]/30"
          >
            Estimated Net Salary
          </span>
        </div>
        <p class="mt-1 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl text-[color:var(--fg)]" data-hero-amount>
          {formatCurrency(initialResult.netAnnualTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}
        </p>
        <p class="mt-1 text-xs text-[color:var(--muted)]" data-hero-subtext>
          {formatCurrency(initialResult.netMonthlyTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}/month · {formatCurrency(initialResult.netWeeklyTakeHome, profile.defaultCurrency, profile.defaultCurrencySymbol)}/week
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 border-t border-[color:var(--border)]/60 pt-3 md:border-t-0 md:pt-0">
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">PAYE Income Tax</p>
          <p class="text-base font-extrabold text-[color:var(--accent)]" data-hero-incometax>
            {formatCurrency(initialResult.netFederalIncomeTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Annual HMRC liability</p>
        </div>
        <div class="rounded-none border border-[color:var(--border)] bg-white p-3">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">National Insurance</p>
          <p class="text-base font-extrabold text-[color:var(--fg)]" data-hero-ni>
            {formatCurrency(initialResult.totalFicaTax, profile.defaultCurrency, profile.defaultCurrencySymbol)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Class 1 Employee</p>
        </div>
        <div class="col-span-2 sm:col-span-1 rounded-none border border-[color:var(--border)] bg-white p-3 flex flex-col justify-between">
          <p class="text-[11px] font-medium text-[color:var(--muted)]">Action</p>
          <button
            type="button"
            data-copy-summary-btn
            class="inline-flex items-center justify-center gap-1.5 rounded-none bg-[color:var(--surface)] px-2.5 py-1.5 text-xs font-bold text-[color:var(--fg)] border border-[color:var(--border)] hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] transition cursor-pointer"
          >
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span>Copy UK Tax Report</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Reusable Income Allocation Bar -->
    <TaxAllocationBar />
  </div>

  <!-- CALCULATOR MAIN BODY -->
  <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- LEFT COLUMN: INPUT FORMS -->
    <div class="space-y-6">

      <!-- SECTION 1: Salary & Region -->
      <div class="space-y-4 border-b border-[color:var(--border)] pb-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
          <Icon name="user" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>1. Employment Earnings &amp; Jurisdiction</span>
        </h3>

        <div class="space-y-4">
          <!-- Gross Salary -->
          <div>
            <div class="flex justify-between items-center text-xs">
              <label for="uk-gross-salary" class="font-bold text-[color:var(--fg)]">
                Gross Annual Salary (£)
              </label>
              <span class="text-[color:var(--muted)] font-mono">PAYE Gross</span>
            </div>
            <div class="relative mt-1.5">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-bold text-[color:var(--muted)]">
                £
              </span>
              <input
                id="uk-gross-salary"
                type="number"
                min="0"
                step="500"
                placeholder="e.g. 50,000"
                class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-3 pl-8 pr-4 text-base font-black text-[color:var(--fg)] outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color:var(--accent)]/20"
                data-uk-salary />
            </div>
          </div>

          <!-- Region Jurisdiction -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="uk-region-select" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Tax Jurisdiction
              </label>
              <select
                id="uk-region-select"
                class="mt-1.5 w-full cursor-pointer rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-sm font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
                data-uk-region
              >
                <option value="england_wales_ni" selected>England, Wales &amp; Northern Ireland</option>
                <option value="scotland">Scotland (Scottish Income Tax)</option>
              </select>
            </div>

            <div>
              <label for="uk-tax-code" class="block text-xs font-bold uppercase tracking-wider text-[color:var(--muted)]">
                Tax Code (Personal Allowance)
              </label>
              <input
                id="uk-tax-code"
                type="text"
                value="1257L"
                class="mt-1.5 w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3.5 py-2.5 text-sm font-semibold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
                data-uk-tax-code
              />
              <span class="text-[10px] text-[color:var(--muted)]">Default 1257L = £12,570 tax-free</span>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 2: Pension & Deductions (Detailed Mode) -->
      <div class="space-y-4 border-b border-[color:var(--border)] pb-6" data-adv-only>
        <h3 class="text-sm font-bold uppercase tracking-wider text-[color:var(--fg)] flex items-center gap-2">
          <Icon name="math" class="w-4 h-4 text-[color:var(--accent)]" />
          <span>2. Workplace Pension &amp; Student Loans</span>
        </h3>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <div class="flex justify-between items-center text-xs">
              <label for="uk-pension-rate" class="font-medium text-[color:var(--fg)]">Workplace Pension Contribution</label>
              <span class="text-[color:var(--muted)]">% of Salary</span>
            </div>
            <div class="relative mt-1">
              <input
                id="uk-pension-rate"
                type="number"
                min="0"
                max="100"
                step="0.5"
                placeholder="5"
                value="5"
                class="w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] py-2 px-3 text-sm font-bold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
                data-uk-pension />
            </div>
            <span class="text-[10px] text-[color:var(--muted)]">Auto-enrolment standard is 5% employee</span>
          </div>

          <div>
            <label for="uk-student-loan" class="block text-xs font-medium text-[color:var(--fg)]">
              Student Loan Repayment Plan
            </label>
            <select
              id="uk-student-loan"
              class="mt-1 w-full rounded-none border border-[color:var(--border)] bg-[color:var(--bg)] px-3 py-2 text-sm font-bold text-[color:var(--fg)] outline-none focus:border-[color:var(--accent)]"
              data-uk-student-loan
            >
              <option value="none" selected>No Student Loan</option>
              <option value="plan1">Plan 1 (Threshold £24,990 @ 9%)</option>
              <option value="plan2">Plan 2 (Threshold £27,295 @ 9%)</option>
              <option value="plan4">Plan 4 - Scotland (Threshold £31,395 @ 9%)</option>
              <option value="plan5">Plan 5 (Threshold £25,000 @ 9%)</option>
              <option value="postgrad">Postgraduate Loan (Threshold £21,000 @ 6%)</option>
            </select>
          </div>
        </div>

        <!-- Personal Allowance Taper Warning -->
        <div data-uk-taper-notice class="hidden rounded-none bg-slate-500/10 border border-[color:var(--border)] p-3 text-xs text-[color:var(--fg)]">
          <p class="font-bold flex items-center gap-1.5">
            <Icon name="bolt" class="w-3.5 h-3.5" />
            <span>Personal Allowance Tapering Active</span>
          </p>
          <p class="mt-0.5 text-[11px]">
            Earnings over £100,000 reduce your tax-free allowance by £1 for every £2 of income. This creates an effective 60% marginal tax rate between £100,000 and £125,140 in England &amp; Wales (67.5% in Scotland).
          </p>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: RESULTS, PAYCHECK SCHEDULE & AUDIT TRAIL -->
    <div class="space-y-6">
      <!-- Reusable Paycheck Schedule Card -->
      <PaycheckFrequencyTable
        netAnnualTakeHome={initialResult.netAnnualTakeHome}
        currency={profile.defaultCurrency}
        currencySymbol={profile.defaultCurrencySymbol}
      />

      <!-- Reusable UK PAYE Audit Trail -->
      <TaxBreakdownTable
        title="HMRC PAYE Audit Breakdown (2026/27)"
        currency={profile.defaultCurrency}
        currencySymbol={profile.defaultCurrencySymbol}
        totalGrossIncome={initialResult.totalGrossIncome}
        totalAdjustments={0}
        adjustedGrossIncome={initialResult.adjustedGrossIncome}
        deductionAmount={initialResult.standardDeductionAmount}
        deductionLabel="Tax-Free Personal Allowance"
        taxableIncome={initialResult.taxableIncome}
        regularIncomeTax={initialResult.regularIncomeTax}
        netFederalIncomeTax={initialResult.netFederalIncomeTax}
        totalFicaTax={initialResult.totalFicaTax}
        ficaLabel="Class 1 National Insurance"
        stateIncomeTax={0}
        stateTaxName="Devolved Surcharge"
        totalAllTaxes={initialResult.totalAllTaxes}
        totalPaymentsAndWithholdings={0}
        federalRefundOrOwed={0}
      />

      <!-- Marginal Rates Summary Card -->
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-4 shadow-sm">
          <p class="text-xs font-medium text-[color:var(--muted)]">Top Marginal Rate</p>
          <p class="mt-1 text-2xl font-bold text-[color:var(--accent)]" data-marginal-rate>
            {formatPercent(initialResult.marginalFederalRate, 1)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">On your next £ earned</p>
        </div>

        <div class="rounded-none border border-[color:var(--border)] bg-[color:var(--surface)] p-4 shadow-sm">
          <p class="text-xs font-medium text-[color:var(--muted)]">Effective Total Rate</p>
          <p class="mt-1 text-2xl font-bold text-[color:var(--fg)]" data-effective-rate>
            {formatPercent(initialResult.effectiveTotalTaxRate, 1)}
          </p>
          <p class="text-[10px] text-[color:var(--muted)]">Tax + NI / Gross Salary</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Reusable Progressive Tax Bracket Table -->
  <TaxBracketsTable
    taxYear={profile.defaultTaxYear}
    brackets={initialResult.bracketBreakdown || []}
    currency={profile.defaultCurrency}
    currencySymbol={profile.defaultCurrencySymbol}
  />

  <!-- Step-by-Step Worked Calculation Example -->
  <section class="mt-8 space-y-4 border-b border-[color:var(--border)] pb-6">
    <h3 class="text-base font-bold text-[color:var(--fg)] flex items-center gap-2">
      <Icon name="document" class="w-4 h-4 text-[color:var(--accent)]" />
      <span>Step-by-Step Worked PAYE Example ({defaultYearData.taxYear})</span>
    </h3>
    <div class="space-y-3 text-xs sm:text-sm text-[color:var(--muted)] leading-relaxed">
      <p>
        Here is how take-home pay is computed for an annual gross salary of <strong class="text-[color:var(--fg)] font-mono">£50,000</strong> in England &amp; Wales:
      </p>
      <ol class="list-decimal pl-5 space-y-2">
        <li>
          <strong class="text-[color:var(--fg)]">Apply Tax-Free Personal Allowance:</strong><br />
          The first <strong class="text-[color:var(--fg)] font-mono">£12,570</strong> is tax-free, leaving <strong class="text-[color:var(--fg)] font-mono">£37,430</strong> taxable income.
        </li>
        <li>
          <strong class="text-[color:var(--fg)]">Calculate PAYE Income Tax:</strong><br />
          The Basic Rate band (20%) covers the entire £37,430 of taxable income (£37,430 × 20% = <strong class="text-[color:var(--fg)] font-bold">£7,486.00</strong>).
        </li>
        <li>
          <strong class="text-[color:var(--fg)]">Calculate Class 1 National Insurance:</strong><br />
          Employee NI is charged at 8% on earnings between £12,570 and £50,270 (£37,430 × 8% = <strong class="text-[color:var(--fg)] font-bold">£2,994.40</strong>).
        </li>
        <li>
          <strong class="text-[color:var(--fg)]">Net Take-Home Pay:</strong><br />
          Subtracting total deductions (£10,480.40) from gross salary (£50,000) yields an annual take-home pay of <strong class="text-[color:var(--accent)] font-extrabold font-mono">£39,519.60</strong> (£3,293.30 per month).
        </li>
      </ol>
    </div>
  </section>

  <!-- Parameter Documentation Guide -->
  <div class="mt-8">
    <CalculatorParameterGuide parameters={taxParameterGuide} />
  </div>

  <!-- Statutory Assumptions & Official Source -->
  <footer class="mt-8 pt-6 border-t border-[color:var(--border)] text-xs text-[color:var(--muted)] space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-none bg-[color:var(--accent)]"></span>
        <span class="font-medium text-[color:var(--fg)]">Official Authority:</span>
        <a href={defaultYearData.officialSourceUrl} target="_blank" rel="noopener noreferrer" class="text-[color:var(--accent)] hover:underline font-semibold">
          {defaultYearData.officialSourceName} ({defaultYearData.taxYear})
        </a>
      </div>
      <span>Last data audit: <time datetime={defaultYearData.lastVerifiedDate}>{defaultYearData.lastVerifiedDate}</time></span>
    </div>
    <ul class="list-disc pl-5 space-y-1 text-[11px]">
      {defaultYearData.assumptions.map((asm) => (
        <li>{asm}</li>
      ))}
    </ul>
    <TaxDisclaimer countryName={profile.name} taxYear={defaultYearData.taxYear} />
  </footer>
</div>

<script>
  import { calculateUkTax } from '../../utils/tax/uk-engine';

  function initUkTaxCalculator() {
    const apps = document.querySelectorAll('[data-tax-app][data-country-id="uk"]');

    apps.forEach((app) => {
      try {
        const profileJson = app.getAttribute('data-profile-json');
        if (!profileJson) return;
        const profile = JSON.parse(profileJson);

        // Controls
        const yearSelect = app.querySelector('[data-tax-year]') as HTMLSelectElement | null;
        const engineTabs = Array.from(app.querySelectorAll('[data-engine-tab]')) as HTMLElement[];
        const regionSelect = app.querySelector('[data-uk-region]') as HTMLSelectElement | null;
        const salaryInput = app.querySelector('[data-uk-salary]') as HTMLInputElement | null;
        const pensionInput = app.querySelector('[data-uk-pension]') as HTMLInputElement | null;
        const studentLoanSelect = app.querySelector('[data-uk-student-loan]') as HTMLSelectElement | null;
        const taperNotice = app.querySelector('[data-uk-taper-notice]') as HTMLElement | null;

        // Current mode state
        let currentMode: 'advanced' | 'quick' = 'advanced';

        // Dynamic Outputs
        const heroAmount = app.querySelector('[data-hero-amount]');
        const heroSubtext = app.querySelector('[data-hero-subtext]');
        const heroIncomeTax = app.querySelector('[data-hero-incometax]');
        const heroNi = app.querySelector('[data-hero-ni]');
        const heroEffectiveRate = app.querySelector('[data-hero-effective-rate]');
        const marginalRateEl = app.querySelector('[data-marginal-rate]');
        const effectiveRateEl = app.querySelector('[data-effective-rate]');

        // Allocation Bar
        const barTakehome = app.querySelector('[data-bar-takehome]') as HTMLElement | null;
        const barFedtax = app.querySelector('[data-bar-fedtax]') as HTMLElement | null;
        const barFica = app.querySelector('[data-bar-fica]') as HTMLElement | null;
        const barPretax = app.querySelector('[data-bar-pretax]') as HTMLElement | null;
        const allocationLabel = app.querySelector('[data-allocation-label]');

        // Paycheck Schedule
        const schedMonthly = app.querySelector('[data-sched-monthly]');
        const schedSemiMonthly = app.querySelector('[data-sched-semimonthly]');
        const schedBiweekly = app.querySelector('[data-sched-biweekly]');
        const schedWeekly = app.querySelector('[data-sched-weekly]');
        const schedDaily = app.querySelector('[data-sched-daily]');
        const schedHourly = app.querySelector('[data-sched-hourly]');

        // Audit Trail Elements
        const resGross = app.querySelector('[data-res-gross]');
        const resAdjustments = app.querySelector('[data-res-adjustments]');
        const resAgi = app.querySelector('[data-res-agi]');
        const resDeduction = app.querySelector('[data-res-deduction]');
        const resDeductionLabel = app.querySelector('[data-res-deduction-label]');
        const resTaxable = app.querySelector('[data-res-taxable]');
        const resRegularTax = app.querySelector('[data-res-regular-tax]');
        const resNetFed = app.querySelector('[data-res-net-fed]');
        const resFica = app.querySelector('[data-res-fica]');
        const resTotalTax = app.querySelector('[data-res-total-tax]');
        const bracketTbody = app.querySelector('[data-bracket-tbody]');
        const copySummaryBtn = app.querySelector('[data-copy-summary-btn]');

        function fmt(n: number): string {
          return '£' + Math.round(n).toLocaleString('en-GB');
        }

        function calculate() {
          const selectedYear = yearSelect ? yearSelect.value : profile.defaultTaxYear;
          const region = regionSelect ? regionSelect.value : 'england_wales_ni';
          const gross = Math.max(0, parseFloat(salaryInput?.value || '0') || 0);
          const pensionPct = currentMode === 'advanced' ? Math.max(0, parseFloat(pensionInput?.value || '0') || 0) : 0;
          const plan = studentLoanSelect ? studentLoanSelect.value : 'none';

          const res = calculateUkTax({
            grossIncome: gross,
            taxYear: selectedYear,
            region,
            pensionPercent: pensionPct,
            studentLoanPlan: (currentMode === 'advanced' ? plan : 'none') as any,
          }, profile);

          if (taperNotice) {
            taperNotice.className = res.personalAllowance < 12570
              ? 'block rounded-none bg-slate-500/10 border border-[color:var(--border)] p-3 text-xs text-[color:var(--fg)]'
              : 'hidden';
          }

          // Update Hero UI
          if (heroAmount) heroAmount.textContent = fmt(res.netTakeHome);
          if (heroSubtext) heroSubtext.textContent = `${fmt(res.netTakeHome / 12)}/month · ${fmt(res.netTakeHome / 52)}/week`;
          if (heroIncomeTax) heroIncomeTax.textContent = fmt(res.incomeTax);
          if (heroNi) heroNi.textContent = fmt(res.nationalInsurance);
          if (heroEffectiveRate) heroEffectiveRate.textContent = `${res.effectiveTaxRate.toFixed(1)}%`;
          if (effectiveRateEl) effectiveRateEl.textContent = `${res.effectiveTaxRate.toFixed(1)}%`;
          if (marginalRateEl) marginalRateEl.textContent = `${res.marginalRate.toFixed(0)}%`;

          // Paycheck Schedule
          if (schedMonthly) schedMonthly.textContent = fmt(res.netTakeHome / 12);
          if (schedSemiMonthly) schedSemiMonthly.textContent = fmt(res.netTakeHome / 24);
          if (schedBiweekly) schedBiweekly.textContent = fmt(res.netTakeHome / 26);
          if (schedWeekly) schedWeekly.textContent = fmt(res.netTakeHome / 52);
          if (schedDaily) schedDaily.textContent = fmt(res.netTakeHome / 260);
          if (schedHourly) schedHourly.textContent = fmt(res.netTakeHome / 2080);

          // Allocation Bar
          const denom = Math.max(gross, 1);
          const thPct = Math.min(100, Math.max(0, (res.netTakeHome / denom) * 100));
          const taxPct = Math.min(100, Math.max(0, (res.incomeTax / denom) * 100));
          const niPct = Math.min(100, Math.max(0, (res.nationalInsurance / denom) * 100));
          const penPct = Math.min(100, Math.max(0, (res.pensionContribution / denom) * 100));

          if (barTakehome) barTakehome.style.width = `${thPct}%`;
          if (barFedtax) barFedtax.style.width = `${taxPct}%`;
          if (barFica) barFica.style.width = `${niPct}%`;
          if (barPretax) barPretax.style.width = `${penPct}%`;
          if (allocationLabel) {
            allocationLabel.textContent = `Take-Home: ${thPct.toFixed(0)}% | Tax & NI: ${((res.totalDeductions / denom) * 100).toFixed(0)}%`;
          }

          // Audit Breakdown Values
          if (resGross) resGross.textContent = fmt(gross);
          if (resAdjustments) resAdjustments.textContent = `-${fmt(res.pensionContribution)}`;
          if (resAgi) resAgi.textContent = fmt(res.adjustedGrossIncome);
          if (resDeduction) resDeduction.textContent = `-${fmt(res.personalAllowance)}`;
          if (resDeductionLabel) resDeductionLabel.textContent = res.personalAllowance < 12570 ? `Personal Allowance (Tapered)` : `Personal Allowance (Standard)`;
          if (resTaxable) resTaxable.textContent = fmt(res.taxableIncome);
          if (resRegularTax) resRegularTax.textContent = fmt(res.incomeTax);
          if (resNetFed) resNetFed.textContent = fmt(res.incomeTax);
          if (resFica) resFica.textContent = fmt(res.nationalInsurance);
          if (resTotalTax) resTotalTax.textContent = fmt(res.totalDeductions);

          // Bracket Table Render
          if (bracketTbody) {
            bracketTbody.innerHTML = res.bracketBreakdown
              .map(
                (row) => `
              <tr>
                <td class="px-4 py-2.5 font-mono">${row.bracketRange}</td>
                <td class="px-4 py-2.5 font-bold">${row.ratePercent}</td>
                <td class="px-4 py-2.5">${fmt(row.taxableInBracket)}</td>
                <td class="px-4 py-2.5 text-right font-mono font-bold text-[color:var(--fg)]">${fmt(row.taxAmount)}</td>
              </tr>
            `
              )
              .join('');
          }
        }

        // Mode Switching
        function switchMode(newMode: 'advanced' | 'quick') {
          currentMode = newMode;
          engineTabs.forEach((tab) => {
            const tabMode = tab.getAttribute('data-engine-tab');
            if (tabMode === newMode) {
              tab.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-bold transition inline-flex items-center gap-1.5 bg-[color:var(--accent)] text-white shadow-xs active';
            } else {
              tab.className = 'shrink-0 min-w-max cursor-pointer rounded-none px-3 py-1.5 text-xs font-semibold text-[color:var(--muted)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5';
            }
          });

          const advOnlyElements = app.querySelectorAll('[data-adv-only]');
          advOnlyElements.forEach((el) => {
            if (newMode === 'quick') {
              (el as HTMLElement).style.display = 'none';
            } else {
              (el as HTMLElement).style.display = '';
            }
          });

          calculate();
        }

        // Event Listeners
        engineTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const m = tab.getAttribute('data-engine-tab') as 'advanced' | 'quick';
            if (m) switchMode(m);
          });
        });

        const allInputs = app.querySelectorAll('input, select');
        allInputs.forEach((inp) => {
          inp.addEventListener('input', calculate);
          inp.addEventListener('change', calculate);
        });

        // Copy Summary Button
        if (copySummaryBtn) {
          copySummaryBtn.addEventListener('click', async () => {
            const takeHome = heroAmount?.textContent || '£0';
            const gross = resGross?.textContent || '£0';
            const incomeTaxVal = heroIncomeTax?.textContent || '£0';
            const niVal = heroNi?.textContent || '£0';
            const year = yearSelect ? yearSelect.value : profile.defaultTaxYear;

            const summary = `UK PAYE Salary & Tax Estimate (${year}):\n` +
              `Gross Salary: ${gross}\n` +
              `PAYE Income Tax: ${incomeTaxVal}\n` +
              `National Insurance: ${niVal}\n` +
              `Net Annual Take-Home: ${takeHome}\n` +
              `Calculated via Toolscastle Tax Platform`;

            try {
              await navigator.clipboard.writeText(summary);
              const originalHtml = copySummaryBtn.innerHTML;
              copySummaryBtn.innerHTML = `<span>Copied!</span>`;
              setTimeout(() => {
                copySummaryBtn.innerHTML = originalHtml;
              }, 2000);
            } catch (err) {
              console.error('Clipboard copy failed', err);
            }
          });
        }

        // Initial run
        calculate();
      } catch (err) {
        console.error('UK tax calculator initialization error:', err);
      }
    });
  }

  initUkTaxCalculator();
  document.addEventListener('astro:page-load', initUkTaxCalculator);
</script>

