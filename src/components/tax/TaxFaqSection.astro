---
interface Props {
  faqItems: { question: string; answer: string }[];
  countryName: string;
}

const { faqItems, countryName } = Astro.props;

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<section class="mt-12 space-y-6" aria-labelledby="faq-heading">
  <div class="space-y-1">
    <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--accent)]">Frequently Asked Questions</p>
    <h2 id="faq-heading" class="text-2xl font-bold tracking-tight text-[color:var(--fg)] sm:text-3xl">
      {countryName} Tax & Salary FAQs
    </h2>
  </div>

  <div class="space-y-4">
    {faqItems.map((item) => (
      <details class="group rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 transition-all open:bg-[color:var(--surface-strong)] open:shadow-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-[color:var(--fg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)]">
          <span class="pr-4 text-base">{item.question}</span>
          <span class="text-lg text-[color:var(--accent)] transition-transform duration-200 group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-[color:var(--muted)]">
          {item.answer}
        </p>
      </details>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />
</section>
