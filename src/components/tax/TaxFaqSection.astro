---
interface Props {
  faqItems: { question: string; answer: string }[];
  countryName: string;
}

const { faqItems, countryName } = Astro.props;

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<section class="mt-12 space-y-4" aria-labelledby="faq-heading">
  <div class="space-y-1">
    <h2 id="faq-heading" class="text-xl font-bold tracking-tight text-[color:var(--fg)] sm:text-2xl">
      {countryName} Tax & Salary FAQs
    </h2>
  </div>

  <div class="divide-y divide-[color:var(--border)]">
    {faqItems.map((item) => (
      <details class="group py-3.5">
        <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-sm sm:text-base text-[color:var(--fg)] focus-visible:outline-none">
          <span class="pr-4">{item.question}</span>
          <span class="text-sm text-[color:var(--muted)] group-open:rotate-45 transition-transform duration-150 shrink-0">+</span>
        </summary>
        <p class="mt-2 text-xs sm:text-sm leading-relaxed text-[color:var(--muted)]">
          {item.answer}
        </p>
      </details>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />
</section>
