<!-- CLIENT-SIDE HIGH-PRECISION TAX ENGINE SCRIPT -->
<script>
  (function () {
    const apps = Array.from(document.querySelectorAll('[data-tax-app]'));

    apps.forEach((app) => {
      try {
        const profileJson = app.getAttribute('data-profile-json');
        if (!profileJson) return;
        const profile = JSON.parse(profileJson);

        // Controls
        const yearSelect = app.querySelector('[data-tax-year]') as HTMLSelectElement | null;
        const engineTabs = Array.from(app.querySelectorAll('[data-engine-tab]')) as HTMLElement[];
        const statusSelect = app.querySelector('[data-adv-status]') as HTMLSelectElement | null;
        const regionSelect = app.querySelector('[data-adv-region]') as HTMLSelectElement | null;

        // Inputs
        const w2Input = app.querySelector('[data-adv-w2]') as HTMLInputElement | null;
        const spouseW2Input = app.querySelector('[data-adv-spouse-w2]') as HTMLInputElement | null;
        const spouseWrap = app.querySelector('[data-adv-spouse-wrap]') as HTMLElement | null;
        const spouseAgeWrap = app.querySelector('[data-adv-spouse-age-wrap]') as HTMLElement | null;
        const businessInput = app.querySelector('[data-adv-business]') as HTMLInputElement | null;
        const otherIncInput = app.querySelector('[data-adv-other-inc]') as HTMLInputElement | null;
        const qualifiedDivInput = app.querySelector('[data-adv-qualified-div]') as HTMLInputElement | null;
        const interestInput = app.querySelector('[data-adv-interest]') as HTMLInputElement | null;

        // Dependents & Age
        const kidsInput = app.querySelector('[data-adv-kids]') as HTMLInputElement | null;
        const otherDepsInput = app.querySelector('[data-adv-other-deps]') as HTMLInputElement | null;
        const taxpayer65Check = app.querySelector('[data-adv-taxpayer-65]') as HTMLInputElement | null;
        const spouse65Check = app.querySelector('[data-adv-spouse-65]') as HTMLInputElement | null;

        // Pre-tax deductions
        const ret401kInput = app.querySelector('[data-adv-401k]') as HTMLInputElement | null;
        const iraInput = app.querySelector('[data-adv-ira]') as HTMLInputElement | null;
        const hsaInput = app.querySelector('[data-adv-hsa]') as HTMLInputElement | null;
        const studentLoanInput = app.querySelector('[data-adv-student-loan]') as HTMLInputElement | null;

        // Itemized deductions
        const mortgageInput = app.querySelector('[data-adv-mortgage]') as HTMLInputElement | null;
        const saltInput = app.querySelector('[data-adv-salt]') as HTMLInputElement | null;
        const charityInput = app.querySelector('[data-adv-charity]') as HTMLInputElement | null;
        const medicalInput = app.querySelector('[data-adv-medical]') as HTMLInputElement | null;

        // Withholding
        const fedWithheldInput = app.querySelector('[data-adv-fed-withheld]') as HTMLInputElement | null;
        const stateWithheldInput = app.querySelector('[data-adv-state-withheld]') as HTMLInputElement | null;

        // Dynamic Outputs
        const heroBadge = app.querySelector('[data-hero-badge]');
        const heroAmount = app.querySelector('[data-hero-amount]');
        const heroSubtext = app.querySelector('[data-hero-subtext]');
        const heroTakehome = app.querySelector('[data-hero-takehome]');
        const heroEffectiveRate = app.querySelector('[data-hero-effective-rate]');
        const deductionBadge = app.querySelector('[data-deduction-badge]');

        // Allocation Bar
        const barTakehome = app.querySelector('[data-bar-takehome]') as HTMLElement | null;
        const barFedtax = app.querySelector('[data-bar-fedtax]') as HTMLElement | null;
        const barFica = app.querySelector('[data-bar-fica]') as HTMLElement | null;
        const barStatetax = app.querySelector('[data-bar-statetax]') as HTMLElement | null;
        const barPretax = app.querySelector('[data-bar-pretax]') as HTMLElement | null;
        const allocationLabel = app.querySelector('[data-allocation-label]');

        // Paycheck Schedule
        const schedMonthly = app.querySelector('[data-sched-monthly]');
        const schedSemiMonthly = app.querySelector('[data-sched-semimonthly]');
        const schedBiweekly = app.querySelector('[data-sched-biweekly]');
        const schedWeekly = app.querySelector('[data-sched-weekly]');
        const schedDaily = app.querySelector('[data-sched-daily]');
        const schedHourly = app.querySelector('[data-sched-hourly]');

        // Audit Trail Elements
        const resGross = app.querySelector('[data-res-gross]');
        const resAdjustments = app.querySelector('[data-res-adjustments]');
        const resAgi = app.querySelector('[data-res-agi]');
        const resDeductionLabel = app.querySelector('[data-res-deduction-label]');
        const resDeduction = app.querySelector('[data-res-deduction]');
        const resTaxable = app.querySelector('[data-res-taxable]');
        const resRegularTax = app.querySelector('[data-res-regular-tax]');
        const resCapGainsTax = app.querySelector('[data-res-capgains-tax]');
        const resCredits = app.querySelector('[data-res-credits]');
        const resNetFed = app.querySelector('[data-res-net-fed]');
        const resFica = app.querySelector('[data-res-fica]');
        const resSe = app.querySelector('[data-res-se]');
        const resStateName = app.querySelector('[data-res-state-name]');
        const resStateTax = app.querySelector('[data-res-state-tax]');
        const resTotalTax = app.querySelector('[data-res-total-tax]');
        const resWithheld = app.querySelector('[data-res-withheld]');
        const resRefundLabel = app.querySelector('[data-res-refund-label]');
        const resRefundVal = app.querySelector('[data-res-refund-val]');
        const marginalRateEl = app.querySelector('[data-marginal-rate]');
        const effectiveRateEl = app.querySelector('[data-effective-rate]');
        const bracketTbody = app.querySelector('[data-bracket-tbody]');
        const copySummaryBtn = app.querySelector('[data-copy-summary-btn]');

        function formatMoney(amount: number, currency?: string, symbol?: string): string {
          try {
            return new Intl.NumberFormat('en-US', {
              style: 'currency',
              currency: currency || 'USD',
              minimumFractionDigits: 0,
              maximumFractionDigits: 0,
            }).format(amount);
          } catch (e) {
            return (symbol || '$') + Math.round(amount).toLocaleString('en-US');
          }
        }

        function calculate() {
          const selectedYear = yearSelect ? yearSelect.value : profile.defaultTaxYear;
          const yearData = profile.years[selectedYear] || profile.years[profile.defaultTaxYear];
          const cur = yearData.currency;
          const sym = yearData.currencySymbol;
          const status = statusSelect ? statusSelect.value : 'single';

          const isJoint = status === 'married_joint' || status === 'qualifying_widow';
          if (spouseWrap) spouseWrap.className = isJoint ? 'block' : 'hidden';
          if (spouseAgeWrap) spouseAgeWrap.className = isJoint ? 'flex items-center gap-1.5 cursor-pointer' : 'hidden';

          const primaryW2 = Math.max(0, parseFloat(w2Input?.value || '0') || 0);
          const spouseW2 = isJoint ? Math.max(0, parseFloat(spouseW2Input?.value || '0') || 0) : 0;
          const businessNet = Math.max(0, parseFloat(businessInput?.value || '0') || 0);
          const otherInc = Math.max(0, parseFloat(otherIncInput?.value || '0') || 0);
          const qualifiedDiv = Math.max(0, parseFloat(qualifiedDivInput?.value || '0') || 0);
          const interest = Math.max(0, parseFloat(interestInput?.value || '0') || 0);

          const totalGrossIncome = primaryW2 + spouseW2 + businessNet + otherInc + qualifiedDiv + interest;

          // SE Tax
          let selfEmploymentTax = 0;
          let deductibleSE = 0;
          if (businessNet > 400) {
            const netSE = businessNet * 0.9235;
            const ssaCap = 184500;
            const remainingSSCap = Math.max(0, ssaCap - (primaryW2 + spouseW2));
            selfEmploymentTax = (0.124 * Math.min(netSE, remainingSSCap)) + (0.029 * netSE);
            deductibleSE = selfEmploymentTax * 0.5;
          }

          // Pre-tax deductions
          const ret401k = Math.max(0, parseFloat(ret401kInput?.value || '0') || 0);
          const tradIra = Math.max(0, parseFloat(iraInput?.value || '0') || 0);
          const hsa = Math.max(0, parseFloat(hsaInput?.value || '0') || 0);
          const studentLoan = Math.max(0, parseFloat(studentLoanInput?.value || '0') || 0);

          const totalAdjustments = deductibleSE + ret401k + tradIra + hsa + studentLoan;
          const agi = Math.max(0, totalGrossIncome - totalAdjustments);

          // Standard Deduction with bonuses
          const fsConfig = yearData.filingStatuses?.[status];
          let stdDeduction = fsConfig?.standardDeduction || yearData.standardDeduction || 16100;
          const seniorBonus = fsConfig?.seniorAdditionalDeduction || (isJoint ? 1600 : 2000);
          if (taxpayer65Check?.checked) stdDeduction += seniorBonus;
          if (isJoint && spouse65Check?.checked) stdDeduction += seniorBonus;

          // Itemized Deductions
          const mortgage = Math.max(0, parseFloat(mortgageInput?.value || '0') || 0);
          const salt = Math.min(10000, Math.max(0, parseFloat(saltInput?.value || '0') || 0));
          const charity = Math.max(0, parseFloat(charityInput?.value || '0') || 0);
          const medical = Math.max(0, (parseFloat(medicalInput?.value || '0') || 0) - (0.075 * agi));
          const totalItemized = mortgage + salt + charity + medical;

          // Auto Optimizer
          let deductionUsed = 'standard';
          let deductionAmount = stdDeduction;
          if (totalItemized > stdDeduction) {
            deductionUsed = 'itemized';
            deductionAmount = totalItemized;
          }

          const taxableIncome = Math.max(0, agi - deductionAmount);
          const preferentialTaxable = Math.min(taxableIncome, qualifiedDiv);
          const ordinaryTaxable = Math.max(0, taxableIncome - preferentialTaxable);

          // Progressive Bracket Calculation
          const brackets = fsConfig?.brackets || yearData.nationalBrackets;
          let regularIncomeTax = 0;
          let marginalRate = 0;
          const bracketBreakdown: any[] = [];

          for (let i = 0; i < brackets.length; i++) {
            const b = brackets[i];
            if (ordinaryTaxable > b.threshold) {
              const slice = b.upTo !== undefined ? Math.min(ordinaryTaxable, b.upTo) - b.threshold : ordinaryTaxable - b.threshold;
              const tax = slice * b.rate;
              regularIncomeTax += tax;
              if (slice > 0) marginalRate = b.rate * 100;
              const range = b.upTo !== undefined ? `${formatMoney(b.threshold, cur, sym)} – ${formatMoney(b.upTo, cur, sym)}` : `Over ${formatMoney(b.threshold, cur, sym)}`;
              bracketBreakdown.push({ range, rate: (b.rate * 100).toFixed(1) + '%', taxable: slice, tax });
            } else {
              const range = b.upTo !== undefined ? `${formatMoney(b.threshold, cur, sym)} – ${formatMoney(b.upTo, cur, sym)}` : `Over ${formatMoney(b.threshold, cur, sym)}`;
              bracketBreakdown.push({ range, rate: (b.rate * 100).toFixed(1) + '%', taxable: 0, tax: 0 });
            }
          }

          // Preferential Cap Gains Tax (0%, 15%, 20%)
          let preferentialTax = 0;
          if (preferentialTaxable > 0) {
            const capBrackets = fsConfig?.capitalGainsBrackets || [
              { threshold: 0, upTo: 49450, rate: 0.00 },
              { threshold: 49450, upTo: 540800, rate: 0.15 },
              { threshold: 540800, rate: 0.20 },
            ];
            const bottom = ordinaryTaxable;
            const top = ordinaryTaxable + preferentialTaxable;
            for (let i = 0; i < capBrackets.length; i++) {
              const b = capBrackets[i];
              const fl = b.threshold;
              const cl = b.upTo !== undefined ? b.upTo : Infinity;
              const start = Math.max(bottom, fl);
              const end = Math.min(top, cl);
              if (end > start) preferentialTax += (end - start) * b.rate;
            }
          }

          // Credits (CTC & Other)
          const numKids = Math.max(0, parseInt(kidsInput?.value || '0', 10) || 0);
          const numOther = Math.max(0, parseInt(otherDepsInput?.value || '0', 10) || 0);
          const ctcLimit = isJoint ? 400000 : 200000;
          let ctc = numKids * 2000;
          let odc = numOther * 500;
          if (agi > ctcLimit) {
            const chunks = Math.ceil((agi - ctcLimit) / 1000);
            const red = chunks * 50;
            ctc = Math.max(0, ctc - red);
            odc = Math.max(0, odc - Math.max(0, red - (numKids * 2000)));
          }
          const totalCredits = ctc + odc;
          const netFedIncomeTax = Math.max(0, (regularIncomeTax + preferentialTax) - totalCredits);

          // FICA
          const ssaCap = 184500;
          const ssTax = (Math.min(primaryW2, ssaCap) * 0.062) + (Math.min(spouseW2, ssaCap) * 0.062);
          const medTax = (primaryW2 + spouseW2) * 0.0145;
          const addlMedThreshold = isJoint ? 250000 : 200000;
          const addlMed = (primaryW2 + spouseW2 + businessNet) > addlMedThreshold ? ((primaryW2 + spouseW2 + businessNet) - addlMedThreshold) * 0.009 : 0;
          const totalFica = ssTax + medTax + addlMed;

          // State Tax
          let stateTax = 0;
          let stateName = 'State Income Tax';
          const regCode = regionSelect ? regionSelect.value : undefined;
          const reg = yearData.regions?.find((r: any) => r.code === regCode);
          if (reg) {
            stateName = reg.name;
            if (reg.flatRate !== undefined) stateTax = taxableIncome * reg.flatRate;
            else if (reg.additionalTaxRate !== undefined) stateTax = taxableIncome * reg.additionalTaxRate;
          }

          const totalAllTaxes = netFedIncomeTax + totalFica + selfEmploymentTax + stateTax;

          // Payments / Withholding & Refund/Owed
          const fedWithheld = Math.max(0, parseFloat(fedWithheldInput?.value || '0') || 0);
          const stateWithheld = Math.max(0, parseFloat(stateWithheldInput?.value || '0') || 0);
          const totalWithheld = fedWithheld + stateWithheld;

          const federal1040Due = netFedIncomeTax + selfEmploymentTax;
          const federalRefundOrOwed = fedWithheld - federal1040Due;
          const stateRefundOrOwed = stateWithheld - stateTax;
          const combinedRefundOrOwed = federalRefundOrOwed + stateRefundOrOwed;

          const netTakeHome = Math.max(0, totalGrossIncome - totalAllTaxes - (ret401k + tradIra + hsa));
          const effectiveRate = totalGrossIncome > 0 ? (totalAllTaxes / totalGrossIncome) * 100 : 0;

          // Update UI Elements
          if (heroAmount) {
            heroAmount.classList.remove('calc-result-updated');
            void (heroAmount as HTMLElement).offsetWidth;
            heroAmount.classList.add('calc-result-updated');
            if (federalRefundOrOwed >= 0) {
              heroAmount.textContent = '+' + formatMoney(federalRefundOrOwed, cur, sym);
              heroAmount.className = 'mt-1 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl text-cyan-500 dark:text-cyan-400';
              if (heroBadge) {
                heroBadge.textContent = 'Estimated Refund';
                heroBadge.className = 'inline-flex items-center rounded-full bg-cyan-500/10 px-2.5 py-0.5 text-xs font-bold text-cyan-600 dark:text-cyan-400 border border-cyan-500/20';
              }
              if (heroSubtext) heroSubtext.textContent = `You overpaid by ${formatMoney(federalRefundOrOwed, cur, sym)} in federal tax withholdings.`;
            } else {
              heroAmount.textContent = '-' + formatMoney(Math.abs(federalRefundOrOwed), cur, sym);
              heroAmount.className = 'mt-1 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl text-rose-500';
              if (heroBadge) {
                heroBadge.textContent = 'Balance Owed / Tax Due';
                heroBadge.className = 'inline-flex items-center rounded-full bg-rose-500/10 px-2.5 py-0.5 text-xs font-bold text-rose-600 dark:text-rose-400';
              }
              if (heroSubtext) heroSubtext.textContent = `You owe ${formatMoney(Math.abs(federalRefundOrOwed), cur, sym)} to the federal tax authority.`;
            }
          }

          if (heroTakehome) heroTakehome.textContent = formatMoney(netTakeHome, cur, sym);
          if (heroEffectiveRate) heroEffectiveRate.textContent = effectiveRate.toFixed(1) + '%';

          if (deductionBadge) {
            if (deductionUsed === 'itemized') {
              const diff = totalItemized - stdDeduction;
              deductionBadge.textContent = `✓ Itemizing Wins (+${formatMoney(diff, cur, sym)} extra deduction)`;
              deductionBadge.className = 'rounded-full bg-blue-500/10 px-2.5 py-0.5 text-xs font-bold text-blue-600 dark:text-blue-400';
            } else {
              deductionBadge.textContent = `✓ Standard Deduction (${formatMoney(stdDeduction, cur, sym)})`;
              deductionBadge.className = 'rounded-full bg-cyan-500/10 px-2.5 py-0.5 text-xs font-bold text-cyan-600 dark:text-cyan-400 border border-cyan-500/20';
            }
          }

          // Allocation Bar
          const pctTakeHome = totalGrossIncome > 0 ? (netTakeHome / totalGrossIncome) * 100 : 100;
          const pctFed = totalGrossIncome > 0 ? (netFedIncomeTax / totalGrossIncome) * 100 : 0;
          const pctFica = totalGrossIncome > 0 ? (totalFica / totalGrossIncome) * 100 : 0;
          const pctState = totalGrossIncome > 0 ? (stateTax / totalGrossIncome) * 100 : 0;
          const pctPreTax = totalGrossIncome > 0 ? ((ret401k + tradIra + hsa) / totalGrossIncome) * 100 : 0;

          if (barTakehome) barTakehome.style.width = `${pctTakeHome}%`;
          if (barFedtax) barFedtax.style.width = `${pctFed}%`;
          if (barFica) barFica.style.width = `${pctFica}%`;
          if (barStatetax) barStatetax.style.width = `${pctState}%`;
          if (barPretax) barPretax.style.width = `${pctPreTax}%`;
          if (allocationLabel) allocationLabel.textContent = `Take-Home: ${pctTakeHome.toFixed(0)}% | Total Taxes: ${effectiveRate.toFixed(0)}%`;

          // Paycheck Frequencies
          if (schedMonthly) schedMonthly.textContent = formatMoney(netTakeHome / 12, cur, sym);
          if (schedSemiMonthly) schedSemiMonthly.textContent = formatMoney(netTakeHome / 24, cur, sym);
          if (schedBiweekly) schedBiweekly.textContent = formatMoney(netTakeHome / 26, cur, sym);
          if (schedWeekly) schedWeekly.textContent = formatMoney(netTakeHome / 52, cur, sym);
          if (schedDaily) schedDaily.textContent = formatMoney(netTakeHome / 260, cur, sym);
          if (schedHourly) schedHourly.textContent = formatMoney(netTakeHome / 2080, cur, sym);

          // Audit Breakdown
          if (resGross) resGross.textContent = formatMoney(totalGrossIncome, cur, sym);
          if (resAdjustments) resAdjustments.textContent = '-' + formatMoney(totalAdjustments, cur, sym);
          if (resAgi) resAgi.textContent = formatMoney(agi, cur, sym);
          if (resDeductionLabel) resDeductionLabel.textContent = deductionUsed === 'itemized' ? 'Deductions (Itemized Claimed)' : 'Deductions (Standard Claimed)';
          if (resDeduction) resDeduction.textContent = '-' + formatMoney(deductionAmount, cur, sym);
          if (resTaxable) resTaxable.textContent = formatMoney(taxableIncome, cur, sym);
          if (resRegularTax) resRegularTax.textContent = formatMoney(regularIncomeTax, cur, sym);
          if (resCapGainsTax) resCapGainsTax.textContent = formatMoney(preferentialTax, cur, sym);
          if (resCredits) resCredits.textContent = '-' + formatMoney(totalCredits, cur, sym);
          if (resNetFed) resNetFed.textContent = formatMoney(netFedIncomeTax, cur, sym);
          if (resFica) resFica.textContent = formatMoney(totalFica, cur, sym);
          if (resSe) resSe.textContent = formatMoney(selfEmploymentTax, cur, sym);
          if (resStateName) resStateName.textContent = stateName.split('(')[0].trim() || 'State Tax';
          if (resStateTax) resStateTax.textContent = formatMoney(stateTax, cur, sym);
          if (resTotalTax) resTotalTax.textContent = formatMoney(totalAllTaxes, cur, sym);
          if (resWithheld) resWithheld.textContent = formatMoney(totalWithheld, cur, sym);

          if (resRefundLabel && resRefundVal) {
            if (federalRefundOrOwed >= 0) {
              resRefundLabel.textContent = 'Net Estimated Federal Refund';
              resRefundLabel.className = 'text-cyan-500 dark:text-cyan-400 font-bold';
              resRefundVal.textContent = '+' + formatMoney(federalRefundOrOwed, cur, sym);
              resRefundVal.className = 'text-cyan-500 dark:text-cyan-400 font-mono font-bold';
            } else {
              resRefundLabel.textContent = 'Estimated Federal Balance Owed';
              resRefundLabel.className = 'text-rose-500 font-bold';
              resRefundVal.textContent = '-' + formatMoney(Math.abs(federalRefundOrOwed), cur, sym);
              resRefundVal.className = 'text-rose-500 font-mono font-bold';
            }
          }

          if (marginalRateEl) marginalRateEl.textContent = marginalRate.toFixed(1) + '%';
          if (effectiveRateEl) effectiveRateEl.textContent = effectiveRate.toFixed(1) + '%';

          // Render Brackets Table
          if (bracketTbody) {
            bracketTbody.innerHTML = bracketBreakdown
              .map(
                (row: any) => `
                <tr class="transition hover:bg-[color:var(--surface-strong)]">
                  <td class="px-4 py-2.5 font-mono text-[color:var(--muted)]">${row.range}</td>
                  <td class="px-4 py-2.5 font-bold text-[color:var(--fg)]">${row.rate}</td>
                  <td class="px-4 py-2.5 text-[color:var(--muted)]">${formatMoney(row.taxable, cur, sym)}</td>
                  <td class="px-4 py-2.5 text-right font-mono font-bold text-rose-500">${formatMoney(row.tax, cur, sym)}</td>
                </tr>
              `
              )
              .join('');
          }
        }

        // Attach event listeners
        const inputs = [
          w2Input, spouseW2Input, businessInput, otherIncInput, qualifiedDivInput,
          interestInput, kidsInput, otherDepsInput, ret401kInput, iraInput,
          hsaInput, studentLoanInput, mortgageInput, saltInput, charityInput,
          medicalInput, fedWithheldInput, stateWithheldInput,
        ];

        inputs.forEach((inp) => inp?.addEventListener('input', calculate));
        [statusSelect, regionSelect, yearSelect].forEach((sel) => sel?.addEventListener('change', calculate));
        [taxpayer65Check, spouse65Check].forEach((chk) => chk?.addEventListener('change', calculate));

        // Copy Summary Handler
        if (copySummaryBtn) {
          copySummaryBtn.addEventListener('click', () => {
            const yr = yearSelect ? yearSelect.value : profile.defaultTaxYear;
            const gross = resGross?.textContent?.trim() || '';
            const agi = resAgi?.textContent?.trim() || '';
            const deduction = resDeduction?.textContent?.trim() || '';
            const taxable = resTaxable?.textContent?.trim() || '';
            const netFed = resNetFed?.textContent?.trim() || '';
            const fica = resFica?.textContent?.trim() || '';
            const state = resStateTax?.textContent?.trim() || '';
            const totalTax = resTotalTax?.textContent?.trim() || '';
            const withheld = resWithheld?.textContent?.trim() || '';
            const outcomeLabel = resRefundLabel?.textContent?.trim() || '';
            const outcomeVal = resRefundVal?.textContent?.trim() || '';
            const takeHome = heroTakehome?.textContent?.trim() || '';
            const effRate = effectiveRateEl?.textContent?.trim() || '';
            const margRate = marginalRateEl?.textContent?.trim() || '';

            const text = [
              `═══════════════════════════════════════════════════`,
              `  ${profile.name} Form 1040 Tax Return Summary (${yr})`,
              `═══════════════════════════════════════════════════`,
              `Total Gross Income:             ${gross}`,
              `Adjusted Gross Income (AGI):    ${agi}`,
              `Allowable Deductions:           ${deduction}`,
              `Taxable Income Base:            ${taxable}`,
              `───────────────────────────────────────────────────`,
              `Net Federal Income Tax:         ${netFed}`,
              `FICA (Social Security/Medicare): ${fica}`,
              `State / Regional Income Tax:    ${state}`,
              `Total Tax Liability:            ${totalTax}`,
              `───────────────────────────────────────────────────`,
              `Total Withholding & Payments:   ${withheld}`,
              `${outcomeLabel}: ${outcomeVal}`,
              `═══════════════════════════════════════════════════`,
              `Annual Net Take-Home Pay:       ${takeHome}`,
              `Effective Overall Tax Rate:     ${effRate}`,
              `Top Marginal Federal Rate:      ${margRate}`,
              `Statutory Authority:            ${profile.years[yr]?.officialSourceName || 'IRS'}`,
              `Verified Date:                  ${profile.years[yr]?.lastVerifiedDate || '2026-09-01'}`,
            ].join('\n');

            navigator.clipboard.writeText(text).then(() => {
              const orig = copySummaryBtn.textContent;
              copySummaryBtn.textContent = '✓ Copied!';
              setTimeout(() => { copySummaryBtn.textContent = orig; }, 2000);
            });
          });
        }

        // Engine Tabs Handler
        engineTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const mode = tab.getAttribute('data-engine-tab');
            engineTabs.forEach((t) => {
              if (t === tab) {
                t.className = 'cursor-pointer rounded-xl bg-[color:var(--accent)] px-3 py-1.5 text-[color:var(--accent-fg)] border border-[color:var(--accent)] shadow-[0_0_12px_var(--accent-glow)] transition inline-flex items-center gap-1.5';
              } else {
                t.className = 'cursor-pointer rounded-xl px-3 py-1.5 text-[color:var(--muted)] border border-transparent hover:border-[color:var(--accent)] hover:shadow-[0_0_12px_var(--accent-glow)] hover:text-[color:var(--fg)] transition inline-flex items-center gap-1.5';
              }
            });
            // If switched to quick, auto-fill fedWithheld and clear complex items
            if (mode === 'quick') {
              if (businessInput) businessInput.value = '0';
              if (otherIncInput) otherIncInput.value = '0';
              if (qualifiedDivInput) qualifiedDivInput.value = '0';
              if (interestInput) interestInput.value = '0';
              if (ret401kInput) ret401kInput.value = '0';
              if (mortgageInput) mortgageInput.value = '0';
              if (saltInput) saltInput.value = '0';
              if (charityInput) charityInput.value = '0';
              if (medicalInput) medicalInput.value = '0';
              calculate();
            }
          });
        });

        calculate();
      } catch (err) {
        console.error('Error initializing advanced tax calculator:', err);
      }
    });
  })();
</script>
