---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { siteName, withBasePath } from '../utils/site';

const currentYear = new Date().getFullYear();

const devTools = [
  { href: withBasePath('/developer-tools/base64-encoder-decoder/'), label: 'Base64 Encoder' },
  { href: withBasePath('/developer-tools/json-formatter/'), label: 'JSON Formatter' },
  { href: withBasePath('/developer-tools/jwt-decoder/'), label: 'JWT Decoder' },
  { href: withBasePath('/developer-tools/regex-tester/'), label: 'Regex Tester' },
  { href: withBasePath('/data-tools/csv-to-json/'), label: 'CSV to JSON' },
  { href: withBasePath('/url-tools/url-cleaner/'), label: 'URL Cleaner' },
];

const mediaTools = [
  { href: withBasePath('/pdf-tools/pdf-merger/'), label: 'PDF Merger' },
  { href: withBasePath('/image-tools/image-compressor/'), label: 'Image Compressor' },
  { href: withBasePath('/image-tools/exif-remover/'), label: 'EXIF Privacy Remover' },
  { href: withBasePath('/text-tools/text-diff-checker/'), label: 'Text Diff Checker' },
  { href: withBasePath('/text-tools/markdown-to-html/'), label: 'Markdown to HTML' },
  { href: withBasePath('/generators/password-generator/'), label: 'Password Generator' },
];

const studyCareerTools = [
  { href: withBasePath('/career-tools/cv-maker/'), label: 'ATS Resume Builder' },
  { href: withBasePath('/education-tools/assignment-cover-maker/'), label: 'Assignment Cover Maker' },
  { href: withBasePath('/academic-tools/semester-gpa-calculator/'), label: 'Semester GPA Calculator' },
  { href: withBasePath('/research-tools/sample-size-calculator/'), label: 'Sample Size Calculator' },
  { href: withBasePath('/uk-income-tax-calculator/'), label: 'UK Income Tax Calculator' },
  { href: withBasePath('/us-income-tax-calculator/'), label: 'US IRS Tax Calculator' },
];

const companyLinks = [
  { href: withBasePath('/about/'), label: 'About Us' },
  { href: withBasePath('/contact/'), label: 'Contact Support' },
  { href: withBasePath('/privacy/'), label: 'Privacy Policy' },
  { href: withBasePath('/terms/'), label: 'Terms of Service' },
  { href: withBasePath('/disclaimer/'), label: 'Legal Disclaimer' },
];
---

<footer class="mt-auto border-t border-gray-800 bg-[#18181B] text-gray-400 pb-20 sm:pb-12 lg:pb-0 transition-colors">
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      
      <!-- Column 1: Brand & Mission -->
      <div class="space-y-4 lg:col-span-1">
        <a class="flex items-center gap-2.5 transition-transform duration-200 hover:scale-[1.02]" href={withBasePath('/')} aria-label={`${siteName} Home`}>
          <BrandMark size="md" variant="light" />
        </a>
        <p class="text-xs leading-relaxed text-gray-400">
          Fast, privacy-first online tools, financial calculators, and browser developer utilities running locally on your device.
        </p>

        <!-- Social & Direct Channels -->
        <div class="flex items-center gap-2 pt-1 text-gray-400">
          <a
            href="https://github.com/Oveez/calculator-utility"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-800 bg-gray-800/80 hover:border-[color:var(--accent)]/40 hover:bg-gray-700 hover:text-[color:var(--accent)] transition group"
            aria-label="GitHub Repository"
          >
            <Icon name="github" class="w-4 h-4 text-gray-400 group-hover:text-[color:var(--accent)] transition-colors" />
          </a>
          <a
            href={withBasePath('/contact/')}
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-800 bg-gray-800/80 hover:border-[color:var(--accent)]/40 hover:bg-gray-700 hover:text-[color:var(--accent)] transition group"
            aria-label="Contact Support"
          >
            <Icon name="mail" class="w-4 h-4 text-gray-400 group-hover:text-[color:var(--accent)] transition-colors" />
          </a>
          <a
            href={withBasePath('/about/')}
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-800 bg-gray-800/80 hover:border-[color:var(--accent)]/40 hover:bg-gray-700 hover:text-[color:var(--accent)] transition group"
            aria-label="About ToolsCastle"
          >
            <Icon name="globe" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Column 2: Developer & Data -->
      <div class="space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-100">Developer &amp; Data</p>
        <ul class="space-y-2 text-xs">
          {devTools.map((link) => (
            <li>
              <a class="text-gray-400 hover:text-[color:var(--accent)] hover:underline transition-colors py-0.5 inline-block" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Media & Documents -->
      <div class="space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-100">Media &amp; Text</p>
        <ul class="space-y-2 text-xs">
          {mediaTools.map((link) => (
            <li>
              <a class="text-gray-400 hover:text-[color:var(--accent)] hover:underline transition-colors py-0.5 inline-block" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Academics & Career -->
      <div class="space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-100">Study &amp; Finance</p>
        <ul class="space-y-2 text-xs">
          {studyCareerTools.map((link) => (
            <li>
              <a class="text-gray-400 hover:text-[color:var(--accent)] hover:underline transition-colors py-0.5 inline-block" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 5: Company & Legal -->
      <div class="space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-100">Company &amp; Legal</p>
        <ul class="space-y-2 text-xs">
          {companyLinks.map((link) => (
            <li>
              <a class="text-gray-400 hover:text-[color:var(--accent)] hover:underline transition-colors py-0.5 inline-block" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 border-t border-gray-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <div class="flex items-center gap-2">
        <p>© {currentYear} {siteName}. All rights reserved.</p>
        <span class="hidden sm:inline text-gray-600">•</span>
        <span class="hidden sm:inline">Built for precision &amp; speed</span>
      </div>
    </div>
  </div>
</footer>
