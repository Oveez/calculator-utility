---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<aside
  class={`adsterra-slot adsterra-slot--rectangle mx-auto max-w-full overflow-hidden ${className}`}
  aria-label="Advertisement"
  style="--ad-width: 300px; --ad-height: 250px;"
>
  <span class="adsterra-label">Advertisement</span>
  <div class="adsterra-frame">
    <script is:inline>
      atOptions = {
        'key' : '870b262b468b958c99d159ae5bafb473',
        'format' : 'iframe',
        'height' : 250,
        'width' : 300,
        'params' : {}
      };
    </script>
    <script is:inline src="https://www.highrevenueformat.com/870b262b468b958c99d159ae5bafb473/invoke.js"></script>
  </div>
</aside>

<style>
  .adsterra-slot {
    box-sizing: border-box;
    width: min(var(--ad-width), 100%);
    min-height: calc(var(--ad-height) + 1.25rem);
    text-align: center;
  }
  .adsterra-label {
    display: block;
    height: 1.25rem;
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .adsterra-frame {
    width: 100%;
    min-height: var(--ad-height);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
</style>

