---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<aside class={`adsterra-native mx-auto max-w-full overflow-hidden ${className}`} aria-label="Sponsored Content">
  <span class="adsterra-label">Sponsored Content</span>
  <div class="adsterra-native-wrapper">
    <script
      is:inline
      async="async"
      data-cfasync="false"
      src="https://pl31859911.profitableratecpmnetwork.com/629bc705a7b59e4369aca4b34d42b8b8/invoke.js"
    ></script>
    <div id="container-629bc705a7b59e4369aca4b34d42b8b8"></div>
  </div>
</aside>

<style>
  .adsterra-native {
    min-height: 9rem;
    box-sizing: border-box;
    text-align: center;
  }
  .adsterra-label {
    display: block;
    height: 1.25rem;
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .adsterra-native-wrapper {
    width: 100%;
    min-height: 7.75rem;
    overflow: hidden;
  }
</style>

