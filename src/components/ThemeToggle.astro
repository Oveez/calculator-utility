---
---
<!-- Segmented Dual-Button Theme Switcher with Animated Spring Slider -->
<div
  class="theme-switch-wrapper relative inline-flex h-9 items-center rounded-xl p-0.5 border border-[color:var(--border)] bg-[color:var(--surface-strong)] transition-all select-none"
  role="radiogroup"
  aria-label="Select color theme"
>
  <!-- Animated sliding indicator pill -->
  <span
    class="theme-switch-slider pointer-events-none absolute top-0.5 bottom-0.5 rounded-lg bg-[color:var(--surface)] border border-[color:var(--border)] shadow-xs"
    aria-hidden="true"
  ></span>

  <!-- 1. Light Mode Button -->
  <button
    type="button"
    class="theme-switch-btn relative z-10 inline-flex h-7.5 items-center justify-center gap-1.5 rounded-lg px-2 sm:px-2.5 text-xs font-semibold cursor-pointer transition-all duration-200"
    data-set-theme="light"
    role="radio"
    aria-checked="true"
    aria-label="Switch to Light Theme"
    title="Light mode"
  >
    <svg class="theme-sun-icon h-3.5 w-3.5 stroke-current transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5" />
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </svg>
    <span class="theme-btn-label hidden sm:inline text-[11px]">Light</span>
  </button>

  <!-- 2. Dark Mode Button -->
  <button
    type="button"
    class="theme-switch-btn relative z-10 inline-flex h-7.5 items-center justify-center gap-1.5 rounded-lg px-2 sm:px-2.5 text-xs font-semibold cursor-pointer transition-all duration-200"
    data-set-theme="dark"
    role="radio"
    aria-checked="false"
    aria-label="Switch to Dark Theme"
    title="Dark mode"
  >
    <svg class="theme-moon-icon h-3.5 w-3.5 stroke-current transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
    <span class="theme-btn-label hidden sm:inline text-[11px]">Dark</span>
  </button>
</div>
