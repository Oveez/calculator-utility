<button
  type="button"
  class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] text-base font-semibold text-[color:var(--fg)] shadow-sm transition hover:-translate-y-0.5 hover:border-[color:var(--accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--bg)]"
  aria-label="Toggle dark mode"
  aria-pressed="false"
  data-theme-toggle
>
  <span aria-hidden="true" data-theme-icon>◐</span>
</button>
