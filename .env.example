# ==============================================================================
# Calculator Utility - Environment Variables Example
# Copy this file to .env or .env.local for local development, or configure these
# in your hosting dashboard (Cloudflare Pages, Vercel, Netlify).
# ==============================================================================

# Site Domain & Base Path
# Replace with your production domain (e.g., https://calculatorutility.tech or https://calculator-utility.pages.dev)
SITE_URL=https://calculatorutility.tech
BASE_PATH=/

# Google Analytics 4 (GA4) Measurement ID (Leave empty during initial setup)
# Format: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console Verification Meta Tag Token (Optional)
# Format: alphanumeric verification string provided by Google Search Console
PUBLIC_GSC_VERIFICATION=

# Google AdSense Publisher Client ID (Leave empty until approved by Google AdSense)
# Format: ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_CLIENT_ID=

# Optional AI Professional Summary Keys (Cloudflare Pages Function Secrets)
# Never commit real keys here. Configure as encrypted secrets in Cloudflare Pages dashboard:
# GROQ_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# GEMINI_API_KEY=
